{
  "name": "house-of-rose",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w packages/web",
    "dev:studio": "npm run dev -w packages/studio",
    "build:web": "npm run build -w packages/web",
    "build:studio": "npm run build -w packages/studio",
    "build": "npm run build -w packages/web && npm run build -w packages/studio"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
