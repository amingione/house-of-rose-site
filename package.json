{
  "name": "house-of-rose",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:web": "node scripts/run-with-env.mjs npm run dev -w packages/web",
    "dev:studio": "node scripts/run-with-env.mjs npm run dev -w packages/studio",
    "build:web": "node scripts/run-with-env.mjs npm run build -w packages/web",
    "build:studio": "node scripts/run-with-env.mjs npm run build -w packages/studio",
    "build": "npm run build:web && npm run build:studio",
    "lint": "npm run lint -w packages/web",
    "guard:drift": "node scripts/drift-guard.mjs",
    "verify:visibility": "node scripts/verify-visibility-plan.mjs",
    "sync:notion": "node scripts/run-with-env.mjs npm run sync:notion -w packages/studio",
    "sync:notion:dry": "node scripts/run-with-env.mjs npm run sync:notion -w packages/studio -- --dry",
    "indexnow": "node scripts/run-with-env.mjs node scripts/indexnow.mjs",
    "indexnow:dry": "node scripts/run-with-env.mjs node scripts/indexnow.mjs --dry",
    "content:visibility-plan": "node scripts/run-with-env.mjs node packages/studio/scripts/implement-visibility-plan.mjs",
    "content:visibility-plan:apply": "node scripts/run-with-env.mjs node packages/studio/scripts/implement-visibility-plan.mjs --apply",
    "content:rf-ipl": "node packages/studio/scripts/seed-rf-ipl-services.mjs --validate",
    "content:rf-ipl:apply": "node scripts/run-with-env.mjs node packages/studio/scripts/seed-rf-ipl-services.mjs --apply",
    "dev:visual": "node scripts/visual-editing/dev-visual.mjs",
    "shopify:validate": "node scripts/validate-shopify-theme.mjs packages/shopify-theme",
    "shopify:check": "shopify theme check --path packages/shopify-theme",
    "shopify:package": "shopify theme package --path packages/shopify-theme",
    "ve:check": "node scripts/visual-editing/check-coverage.mjs",
    "ve:sync": "node scripts/visual-editing/sync-page-routes.mjs",
    "ve:new": "node scripts/visual-editing/scaffold.mjs",
    "prepare": "node scripts/visual-editing/apply-patches.mjs && node scripts/visual-editing/extract-sanity-schema.mjs --soft && node scripts/visual-editing/install-git-hook.mjs",
    "order": "node scripts/checkout/order-cli.mjs",
    "google:catalog:migrate": "node scripts/run-with-env.mjs node packages/studio/scripts/migrate-google-catalog.mjs",
    "google:catalog:ledger": "node scripts/run-with-env.mjs node packages/studio/scripts/migrate-google-catalog.mjs --write-ledger",
    "google:gbp:export": "node scripts/run-with-env.mjs node scripts/google/export-gbp-services.mjs",
    "google:offline:csv": "node scripts/run-with-env.mjs node scripts/google/export-offline-conversions.mjs",
    "google:test": "node --import tsx --test scripts/google/*.test.ts",
    "dev:functions": "node scripts/run-with-env.mjs netlify dev --filter @house-of-rose/web"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@stackbit/cli": "^0.3.136",
    "@stackbit/cms-sanity": "^0.2.93",
    "@stackbit/types": "^2.1.15",
    "esbuild": "^0.28.1",
    "patch-package": "^8.0.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsx": "^4.21.0"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3"
  }
}
