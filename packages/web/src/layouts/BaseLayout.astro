---
import '@/styles/global.css';
import { sanityFetch } from '@/lib/sanity';
import { SITE_SETTINGS_QUERY, ALL_SERVICES_QUERY, type SiteSettings, type Service } from '@/lib/queries';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  preloadImage?: string;
}

const settings = await sanityFetch<SiteSettings>(SITE_SETTINGS_QUERY);
const services = await sanityFetch<Service[]>(ALL_SERVICES_QUERY);
const siteName = settings?.siteName ?? 'House of Rose';

const {
  title = siteName,
  description = settings?.description ?? 'Luxury spa services and wellness.',
  image,
  preloadImage,
} = Astro.props;

const ga4Id = import.meta.env.PUBLIC_GA4_ID;
const gscVerify = import.meta.env.PUBLIC_GSC_VERIFY;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pageTitle = (title === siteName || title.includes(siteName))
  ? title
  : `${title} | ${siteName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {gscVerify && <meta name="google-site-verification" content={gscVerify} />}
    <link rel="canonical" href={canonicalURL} />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={image ?? `${Astro.site}logos/house-of-rose-straight-logo-package/social/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="House of Rose" />
    <meta property="og:locale" content="en_US" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image ?? `${Astro.site}logos/house-of-rose-straight-logo-package/social/og.png`} />
    <script is:inline src="https://analytics.ahrefs.com/analytics.js" data-key="XdzOvGXmUENnBpyYIDhXOQ" async></script>
    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/logos/house-of-rose-monogram-logo-package/favicon/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/logos/house-of-rose-monogram-logo-package/favicon/16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/logos/house-of-rose-monogram-logo-package/favicon/32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/logos/house-of-rose-monogram-logo-package/favicon/48.png" />
    <link rel="apple-touch-icon" sizes="512x512" href="/logos/HofR-512/mono-circle.png" />
    <!-- Google tag (gtag.js) -->
    {ga4Id && (
      <Fragment>
        <script is:inline src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`} async></script>
        <script is:inline set:html={`window.dataLayer = window.dataLayer || [];function gtag(){dataLayer.push(arguments);}gtag('js', new Date());gtag('config', '${ga4Id}');`}></script>
      </Fragment>
    )}
    <!-- Additional head content from pages -->
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-gold focus:text-charcoal focus:text-sm focus:font-medium focus:rounded">
      Skip to main content
    </a>
    <Header currentPath={Astro.url.pathname} />

    <!-- Page content -->
    <main id="main-content">
      <slot />
    </main>

    <Footer services={services.map(s => ({ title: s.title, slug: s.slug }))} />
  </body>
</html>
