---
import '@/styles/global.css';
import { sanityFetch } from '@/lib/sanity';
import { SITE_SETTINGS_QUERY, ALL_SERVICES_QUERY, type SiteSettings, type Service } from '@/lib/queries';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  preloadImage?: string;
}

const settings = await sanityFetch<SiteSettings>(SITE_SETTINGS_QUERY);
const services = await sanityFetch<Service[]>(ALL_SERVICES_QUERY);
const siteName = settings?.siteName ?? 'House of Rose';

const {
  title = siteName,
  description = settings?.description ?? 'Luxury spa services and wellness.',
  image,
  preloadImage,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title === siteName ? siteName : `${title} | ${siteName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalURL} />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={image ?? `${Astro.site}/logos/house-of-rose-straight-logo-package/social/og.png`} />
    <meta property="og:type" content="website" />
    <script is:inline src="https://analytics.ahrefs.com/analytics.js" data-key="XdzOvGXmUENnBpyYIDhXOQ" async></script>
    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/logos/house-of-rose-monogram-logo-package/favicon/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/logos/house-of-rose-monogram-logo-package/favicon/16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/logos/house-of-rose-monogram-logo-package/favicon/32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/logos/house-of-rose-monogram-logo-package/favicon/48.png" />
    <link rel="apple-touch-icon" sizes="512x512" href="/logos/HofR-512/mono-circle.png" />
    <!-- Additional head content from pages -->
    <slot name="head" />
  </head>
  <body>
    <Header currentPath={Astro.url.pathname} />

    <!-- Page content -->
    <main>
      <slot />
    </main>

    <Footer services={services.map(s => ({ title: s.title, slug: s.slug }))} />
  </body>
</html>
