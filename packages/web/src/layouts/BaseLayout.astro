---
import '@/styles/global.css';
import '@polgubau/astro-reveal/styles';
import { sanityFetch } from '@/lib/sanity';
import { SITE_SETTINGS_QUERY, ALL_SERVICES_QUERY, type SiteSettings, type Service } from '@/lib/queries';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CartDrawer from '@/components/shop/CartDrawer.astro';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import LeadAnalytics from '@/components/LeadAnalytics.astro';
import ConsentBootstrap from '@/components/ConsentBootstrap.astro';
import ConsentManager from '@/components/ConsentManager.astro';
import GoogleTagManager from '@/components/GoogleTagManager.astro';
import { SEO } from 'astro-seo';
import { siteEntityGraph } from '@/lib/structuredData';
import { formatSeoTitle } from '@/lib/seo';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  preloadImage?: string;
  noindex?: boolean;
  nofollow?: boolean;
  chrome?: 'site' | 'landing';
}

const settings = await sanityFetch<SiteSettings>(SITE_SETTINGS_QUERY);
const services = await sanityFetch<Service[]>(ALL_SERVICES_QUERY);
const siteName = settings?.siteName ?? 'House of Rose Aesthetics';

const {
  title = siteName,
  description = settings?.description ?? 'Advanced aesthetics and wellness in Punta Gorda, FL — specializing in PRF and natural skin renewal.',
  image,
  imageAlt,
  preloadImage,
  noindex = false,
  nofollow = false,
  chrome = 'site',
} = Astro.props;

const gtmId = import.meta.env.PUBLIC_GTM_ID;
const gtmMeasurementPath = '/metrics/';
const gscVerify = import.meta.env.PUBLIC_GSC_VERIFY;
// Never fire on `astro dev` — keeps local testing out of live Events Manager data.
const metaPixelId = import.meta.env.DEV ? undefined : import.meta.env.PUBLIC_META_PIXEL_ID;

const siteURL = Astro.site ?? new URL('https://houseofrosefl.com/');
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const defaultOgImage = new URL('/logos/hr-monogram-2026/og.png', siteURL).toString();
const socialImage = image ? new URL(image, siteURL).toString() : defaultOgImage;
const socialImageAlt = imageAlt ?? `${siteName} in Punta Gorda, Florida`;
const pageTitle = formatSeoTitle(title, siteName);
const entityGraph = siteEntityGraph(
  {
    url: canonicalURL.toString(),
    name: pageTitle,
    description,
    image: socialImage,
    imageAlt: socialImageAlt,
    email: settings?.email,
  },
  siteURL.toString(),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {gscVerify && <meta name="google-site-verification" content={gscVerify} />}
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <SEO
      title={pageTitle}
      description={description}
      canonical={canonicalURL.toString()}
      noindex={noindex}
      nofollow={nofollow}
      robotsExtras="max-snippet:-1, max-image-preview:large, max-video-preview:-1"
      openGraph={{
        basic: {
          title: pageTitle,
          type: 'website',
          image: socialImage,
          url: canonicalURL.toString(),
        },
        optional: {
          description,
          locale: 'en_US',
          siteName,
        },
        image: {
          width: 1200,
          height: 630,
          alt: socialImageAlt,
        },
      }}
    />
    <SchemaMarkup item={entityGraph} />
    <ConsentBootstrap />
    <script
      is:inline
      set:html={`window.__horMeasurementConfig={ahrefsKey:'XdzOvGXmUENnBpyYIDhXOQ',metaPixelId:${JSON.stringify(metaPixelId ?? '')}};`}
    ></script>
    <GoogleTagManager containerId={gtmId} measurementPath={gtmMeasurementPath} />
    <!-- Favicons — generated from 512px transparent source -->
    <link rel="icon" type="image/x-icon" href="/logos/hr-monogram-2026/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/logos/hr-monogram-2026/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/logos/hr-monogram-2026/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/logos/hr-monogram-2026/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/logos/hr-monogram-2026/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/logos/hr-monogram-2026/apple-touch-icon.png" />
    <!-- Additional head content from pages -->
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-gold-metal focus:text-charcoal focus:text-sm focus:font-medium focus:rounded">
      Skip to main content
    </a>
    {chrome === 'site' && <Header currentPath={Astro.url.pathname} />}

    <!-- Page content -->
    <main id="main-content" class={chrome === 'site' ? 'transition-fade' : undefined}>
      <slot />
    </main>

    {chrome === 'site' && <Footer services={services.map(s => ({ title: s.title, slug: s.slug }))} />}

    <!-- Rendered once, outside <main>, so the cart survives swup navigation -->
    {chrome === 'site' && <CartDrawer />}

    <!-- Scroll-reveal init — zero JS shipped unless data-reveal attributes are present on the page -->
    <script>
      import '@polgubau/astro-reveal';
    </script>
    <LeadAnalytics />
    <ConsentManager />
  </body>
</html>
