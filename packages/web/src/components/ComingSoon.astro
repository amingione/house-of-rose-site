---
/**
 * Full-screen "Coming Soon" splash overlay.
 *
 * Rendered on top of every page (via BaseLayout) WITHOUT redirecting — the
 * real page still builds and exists underneath, the URL never changes.
 *
 * Toggle with the PUBLIC_COMING_SOON env var:
 *   PUBLIC_COMING_SOON=true   → overlay shows on all pages
 *   (unset / anything else)   → site is live, overlay hidden
 *
 * At launch, remove the env var (or set it to false) and rebuild — no code
 * changes needed.
 */
---

<div class="coming-soon" role="dialog" aria-label="House of Rose Aesthetics — coming soon" aria-modal="true">
  <div class="coming-soon__inner">
    <img
      class="coming-soon__logo"
      src="/logos/house-of-rose-monogram/hr-monogram-gold.svg"
      alt="House of Rose Aesthetics monogram"
      width="120"
      height="120"
    />

    <p class="coming-soon__eyebrow">Coming Soon to Punta Gorda</p>

    <h1 class="coming-soon__brand">House of Rose</h1>
    <p class="coming-soon__sub">Aesthetics</p>

    <p class="coming-soon__tagline">
      Advanced aesthetics &amp; wellness &mdash; where beauty blooms within.
    </p>
  </div>
</div>

<style>
  .coming-soon {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    text-align: center;
    color: #fff;
    background-color: #0a0806;
    background-image:
      linear-gradient(rgba(10, 8, 6, 0.78), rgba(10, 8, 6, 0.88)),
      url('/images/banner/HOR-where-beauty-blooms-within.webp');
    background-size: cover;
    background-position: center;
    overflow: hidden;
  }

  .coming-soon__inner {
    max-width: 36rem;
    animation: fade-up 1s ease-out both;
  }

  .coming-soon__logo {
    width: 120px;
    height: auto;
    margin: 0 auto 2rem;
  }

  .coming-soon__eyebrow {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.35em;
    font-size: 0.8rem;
    color: #C9A96E;
    margin: 0 0 1.5rem;
  }

  .coming-soon__brand {
    font-family: Cochin, Georgia, Cambria, 'Times New Roman', Times, serif;
    font-weight: 400;
    font-size: clamp(2.75rem, 9vw, 5rem);
    line-height: 1;
    margin: 0;
  }

  .coming-soon__sub {
    font-family: Cochin, Georgia, Cambria, 'Times New Roman', Times, serif;
    font-size: clamp(1.25rem, 4vw, 1.75rem);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #C9A96E;
    margin: 0.75rem 0 0;
  }

  .coming-soon__tagline {
    font-family: Georgia, Cambria, 'Times New Roman', Times, serif;
    font-style: italic;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.72);
    margin: 2.5rem auto 0;
    max-width: 28rem;
  }

  @keyframes fade-up {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .coming-soon__inner { animation: none; }
  }
</style>
