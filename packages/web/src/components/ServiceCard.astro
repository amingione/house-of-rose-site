---
/**
 * Service card component
 * Used on the homepage and services listing page
 */

import { urlFor } from '@/lib/sanity';
import type { SanityImage } from '@/lib/queries';
import {
  getServiceCardImage,
  getServiceCardImageAlt,
  serviceCardImageUsesContain,
} from '@/lib/imageFallbacks';
import { getServiceCardSummary } from '@/lib/serviceCardContent';

interface Props {
  title: string;
  slug: string;
  image?: SanityImage;
  variant?: 'grid' | 'row';
}

const { title, slug, image, variant = 'grid' } = Astro.props;
const rowImage = getServiceCardImage(slug);
const rowImageAlt = getServiceCardImageAlt(slug);
const containRowImage = serviceCardImageUsesContain(slug);
const cardSummary = getServiceCardSummary(slug);
// Services are owned by serviceCatalog.ts, so the Sanity `image` prop is only
// still populated by legacy callers. Fall back to the curated local asset for
// this slug so the grid variant shows the same photography as the row variant
// instead of rendering an image-less card.
const sanityImageSrc = image
  ? urlFor(image).width(640).height(480).fit('crop').format('webp').quality(80).url()
  : undefined;
const imageSrc = sanityImageSrc ?? rowImage;
const imageAlt = (image?.alt ?? (sanityImageSrc ? title : rowImageAlt)) || title;
const containImage = !sanityImageSrc && containRowImage;
// Always lead with the technical/industry-standard name — matches what people search for.
const headline = title;
---

{variant === 'grid' ? (
  <article class="service-card group">
    <a href={`/services/${slug}/`} class="block">
    {imageSrc && <div class="mb-4 aspect-square overflow-hidden bg-charcoal-lighter">
        <img
          src={imageSrc}
          alt={imageAlt}
          width={400}
          height={400}
          loading="lazy"
          decoding="async"
          class:list={[
            'h-full w-full transition-transform duration-500 group-hover:scale-105',
            containImage ? 'object-contain p-3' : 'object-cover',
          ]}
        />
      </div>}
    <span class="service-name">{headline}</span>
    {cardSummary && <p class="service-desc mt-1">{cardSummary}</p>}
    <span class="learn-more mt-4 inline-flex group-hover:text-gold">Learn about {title} →</span>
    </a>
  </article>
) : (
  <article class="service-row group border-b border-ivory/10 py-5">
    <div class:list={[
      'grid gap-y-2 sm:items-center',
      rowImage
        ? 'grid-cols-[76px_minmax(0,1fr)] gap-x-4 sm:grid-cols-[96px_minmax(0,1fr)_auto] sm:gap-x-6'
        : 'grid-cols-1 sm:grid-cols-[minmax(0,1fr)_auto] sm:gap-x-6',
    ]}>
      {rowImage && (
        <a
          href={`/services/${slug}/`}
          class="row-span-2 block h-[76px] w-[76px] overflow-hidden bg-charcoal-lighter sm:row-span-1 sm:h-24 sm:w-24"
          aria-label={`Review ${title}`}
        >
          <img
            src={rowImage}
            alt={rowImageAlt}
            width={192}
            height={192}
            loading="lazy"
            decoding="async"
            class:list={[
              'h-full w-full transition-transform duration-500 group-hover:scale-[1.03]',
              containRowImage ? 'object-contain p-2' : 'object-cover',
            ]}
          />
        </a>
      )}
      <div class="min-w-0">
        <h3 class="mb-1 font-serif text-[clamp(20px,2.4vw,27px)] leading-tight text-ink">
          <a href={`/services/${slug}/`} class="transition-colors hover:text-gold">{headline}</a>
        </h3>
        {cardSummary && <p class="max-w-[720px] text-[13px] leading-relaxed text-muted sm:text-sm">{cardSummary}</p>}
      </div>
      <div class:list={[
        'flex flex-wrap items-center gap-x-5 gap-y-1 sm:row-start-1 sm:flex-col sm:items-end sm:gap-1',
        rowImage ? 'col-start-2 sm:col-start-3' : 'col-start-1 sm:col-start-2',
      ]}>
        <a
          href={`/services/${slug}/`}
          class="inline-flex min-h-[44px] items-center text-[12px] font-semibold text-gold underline decoration-gold/40 underline-offset-4 transition-colors hover:text-ink"
        >
          Learn more
        </a>
      </div>
    </div>
  </article>
)}
