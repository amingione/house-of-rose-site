---
/**
 * Service card component
 * Used on the homepage and services listing page
 */

import { urlFor } from '@/lib/sanity';
import { sbObjectId, sbFieldPath } from '@/lib/visualEditing';
import type { SanityImage } from '@/lib/queries';
import { getCuratedServiceImage, getServiceFallbackImage } from '@/lib/imageFallbacks';
import type { BookingMode } from '@/lib/booking';
import BookingLink from '@/components/BookingLink.astro';
import { alignPublicChannelCopy } from '@/lib/publicCopy';

interface Props {
  title: string;
  slug: string;
  tagline?: string;
  image?: SanityImage;
  bookingMode?: BookingMode;
  bookingUrl?: string;
  variant?: 'grid' | 'row';
  number?: string;
  /**
   * Sanity _id of the service this card represents. When provided, the card is
   * wired for Visual Editor click-to-edit (rescopes to this document). Omit for
   * hardcoded/non-Sanity usage (e.g. the homepage) — annotations stay inert.
   */
  objectId?: string;
}

const { title, slug, tagline, image, bookingMode, bookingUrl, variant = 'grid', number, objectId } = Astro.props;
const curatedImage = getCuratedServiceImage(slug);
const imageSrc = curatedImage ?? (image
  ? urlFor(image).width(640).height(480).fit('crop').auto('format').quality(80).url()
  : getServiceFallbackImage(slug));
const displayTagline = tagline ? alignPublicChannelCopy(tagline) : undefined;
// Always lead with the technical/industry-standard name — matches what people search for.
const headline = title;
// Visual Editor annotations — only emitted when an objectId is supplied.
const objAttrs = objectId ? sbObjectId(objectId) : {};
const headlinePath = sbFieldPath('title');
const taglinePath = sbFieldPath('tagline');
const fp = (attrs: Record<string, string>) => (objectId ? attrs : {});
---

{variant === 'grid' ? (
  <article class="service-card group" {...objAttrs}>
    <a href={`/services/${slug}/`} class="block" aria-label={`Learn about ${title}`}>
    <div class="aspect-square overflow-hidden bg-charcoal-lighter mb-4">
        <img
          src={imageSrc}
          alt={curatedImage ? title : image?.alt ?? title}
          width={400}
          height={400}
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
      </div>
    <span class="service-name" {...fp(headlinePath)}>{headline}</span>
    {displayTagline && <p class="service-desc mt-1" {...fp(taglinePath)}>{displayTagline}</p>}
    <span class="learn-more group-hover:text-gold">Learn more</span>
    </a>
    <BookingLink
      slug={slug}
      bookingMode={bookingMode}
      bookingUrl={bookingUrl}
      location="service-card-grid"
      class="service-booking-link"
    />
  </article>
) : (
  <article class="service-row group grid grid-cols-[84px_1fr] sm:grid-cols-[112px_1fr_auto] items-center gap-5 py-6 border-b border-ink/10 px-1" {...objAttrs}>
    <a href={`/services/${slug}/`} class="block w-[84px] h-[84px] sm:w-28 sm:h-28 overflow-hidden bg-charcoal-lighter">
        <img
          src={imageSrc}
          alt={curatedImage ? title : image?.alt ?? title}
          width={224}
          height={224}
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover"
        />
      </a>
    <div class="flex-1">
      {number && <p class="text-muted text-xs mb-1">{number}</p>}
      <h3 class="font-serif text-[clamp(20px,2.4vw,28px)] text-ink mb-1" {...fp(headlinePath)}>
        <a href={`/services/${slug}/`} class="hover:text-gold transition-colors">{headline}</a>
      </h3>
      {displayTagline && <p class="text-muted text-sm leading-relaxed" {...fp(taglinePath)}>{displayTagline}</p>}
      <a href={`/services/${slug}/`} class="learn-more inline-flex">Learn about {title}</a>
    </div>
    <BookingLink
      slug={slug}
      bookingMode={bookingMode}
      bookingUrl={bookingUrl}
      location="service-card-row"
      class="service-booking-link col-span-2 sm:col-span-1"
    />
  </article>
)}
