---
/**
 * Service card component
 * Used on the homepage and services listing page
 */

import { urlFor } from '@/lib/sanity';
import { sbObjectId, sbFieldPath } from '@/lib/visualEditing';
import type { SanityImage } from '@/lib/queries';
import {
  getCuratedServiceImage,
  getCuratedServiceImageAlt,
  getServiceCardImage,
  getServiceCardImageAlt,
  getServiceFallbackImage,
  serviceCardImageUsesContain,
  serviceImageUsesContain,
} from '@/lib/imageFallbacks';
import type { BookingMode } from '@/lib/booking';
import BookingLink from '@/components/BookingLink.astro';
import { getServiceCardSummary } from '@/lib/serviceCardContent';

interface Props {
  title: string;
  slug: string;
  image?: SanityImage;
  bookingMode?: BookingMode;
  bookingUrl?: string;
  variant?: 'grid' | 'row';
  /**
   * Sanity _id of the service this card represents. When provided, the card is
   * wired for Visual Editor click-to-edit (rescopes to this document). Omit for
   * hardcoded/non-Sanity usage (e.g. the homepage) — annotations stay inert.
   */
  objectId?: string;
}

const { title, slug, image, bookingMode, bookingUrl, variant = 'grid', objectId } = Astro.props;
const curatedImage = getCuratedServiceImage(slug);
const curatedImageAlt = getCuratedServiceImageAlt(slug);
const containImage = serviceImageUsesContain(slug);
const rowImage = getServiceCardImage(slug);
const rowImageAlt = getServiceCardImageAlt(slug);
const containRowImage = serviceCardImageUsesContain(slug);
const cardSummary = getServiceCardSummary(slug);
const imageSrc = curatedImage ?? (image
  ? urlFor(image).width(640).height(480).fit('crop').format('webp').quality(80).url()
  : getServiceFallbackImage(slug));
// Always lead with the technical/industry-standard name — matches what people search for.
const headline = title;
// Visual Editor annotations — only emitted when an objectId is supplied.
const objAttrs = objectId ? sbObjectId(objectId) : {};
const headlinePath = sbFieldPath('title');
const fp = (attrs: Record<string, string>) => (objectId ? attrs : {});
---

{variant === 'grid' ? (
  <article class="service-card group" {...objAttrs}>
    <a href={`/services/${slug}/`} class="block">
    <div class:list={['aspect-square overflow-hidden bg-charcoal-lighter mb-4', containImage && 'p-8']}>
        <img
          src={imageSrc}
          alt={curatedImage ? curatedImageAlt : image?.alt ?? title}
          width={400}
          height={400}
          loading="lazy"
          decoding="async"
          class:list={[
            'w-full h-full group-hover:scale-105 transition-transform duration-500',
            containImage ? 'object-contain' : 'object-cover',
          ]}
        />
      </div>
    <span class="service-name" {...fp(headlinePath)}>{headline}</span>
    {cardSummary && <p class="service-desc mt-1">{cardSummary}</p>}
    </a>
    <BookingLink
      slug={slug}
      bookingMode={bookingMode}
      bookingUrl={bookingUrl}
      location="service-card-grid"
      class="service-booking-link"
      accessibleContext={title}
    />
  </article>
) : (
  <article class="service-row group border-b border-ivory/10 py-5" {...objAttrs}>
    <div class:list={[
      'grid gap-y-2 sm:items-center',
      rowImage
        ? 'grid-cols-[76px_minmax(0,1fr)] gap-x-4 sm:grid-cols-[96px_minmax(0,1fr)_auto] sm:gap-x-6'
        : 'grid-cols-1 sm:grid-cols-[minmax(0,1fr)_auto] sm:gap-x-6',
    ]}>
      {rowImage && (
        <a
          href={`/services/${slug}/`}
          class="row-span-2 block h-[76px] w-[76px] overflow-hidden bg-charcoal-lighter sm:row-span-1 sm:h-24 sm:w-24"
          aria-label={`Review ${title}`}
        >
          <img
            src={rowImage}
            alt={rowImageAlt}
            width={192}
            height={192}
            loading="lazy"
            decoding="async"
            class:list={[
              'h-full w-full transition-transform duration-500 group-hover:scale-[1.03]',
              containRowImage ? 'object-contain p-2' : 'object-cover',
            ]}
          />
        </a>
      )}
      <div class="min-w-0">
        <h3 class="mb-1 font-serif text-[clamp(20px,2.4vw,27px)] leading-tight text-ink" {...fp(headlinePath)}>
          <a href={`/services/${slug}/`} class="transition-colors hover:text-gold">{headline}</a>
        </h3>
        {cardSummary && <p class="max-w-[720px] text-[13px] leading-relaxed text-muted sm:text-sm">{cardSummary}</p>}
      </div>
      <div class:list={[
        'flex flex-wrap items-center gap-x-5 gap-y-1 sm:row-start-1 sm:flex-col sm:items-end sm:gap-1',
        rowImage ? 'col-start-2 sm:col-start-3' : 'col-start-1 sm:col-start-2',
      ]}>
        <BookingLink
          slug={slug}
          bookingMode={bookingMode}
          bookingUrl={bookingUrl}
          location="service-card-row"
          class="inline-flex min-h-[44px] items-center text-[12px] font-semibold text-ivory underline decoration-ivory/30 underline-offset-4 transition-colors hover:text-gold"
          accessibleContext={title}
        />
      </div>
    </div>
  </article>
)}
