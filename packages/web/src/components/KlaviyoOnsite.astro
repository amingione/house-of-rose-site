---
const enabled = !import.meta.env.DEV;
---

{enabled && (
  <script>
    import { getConsent } from '@/lib/measurement';

    interface KlaviyoWindow extends Window {
      _klOnsite?: unknown[];
      __horKlaviyoLoaded?: boolean;
    }

    const loadKlaviyo = (): void => {
      const consent = getConsent();
      if (consent.ad_personalization !== 'granted') return;

      const browser = window as KlaviyoWindow;
      if (browser.__horKlaviyoLoaded || document.getElementById('hor-klaviyo-onsite')) return;
      browser.__horKlaviyoLoaded = true;
      browser._klOnsite ??= [];

      const script = document.createElement('script');
      script.id = 'hor-klaviyo-onsite';
      script.src = 'https://static.klaviyo.com/onsite/js/T7jqwt/klaviyo.js?company_id=T7jqwt';
      script.async = true;
      document.head.append(script);
    };

    window.addEventListener('hor:consent-updated', loadKlaviyo);
    loadKlaviyo();
  </script>
)}
