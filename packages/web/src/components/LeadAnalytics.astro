---
// Attribution and conversion tracking intentionally avoid personally
// identifiable information.
---

<script>
  type Gtag = (command: 'event', eventName: string, params?: Record<string, string>) => void;
  type Fbq = (command: 'track', eventName: string, params?: Record<string, unknown>) => void;

  interface AnalyticsWindow extends Window {
    gtag?: Gtag;
    fbq?: Fbq;
    __horAnalyticsBound?: boolean;
  }

  const analyticsWindow = window as AnalyticsWindow;
  const attributionKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'] as const;

  const track = (eventName: string, params: Record<string, string> = {}): void => {
    analyticsWindow.gtag?.('event', eventName, params);
  };

  const trackMeta = (eventName: string, params?: Record<string, unknown>): void => {
    analyticsWindow.fbq?.('track', eventName, params);
  };

  const getStoredAttribution = (): Record<string, string> => {
    const params = new URLSearchParams(window.location.search);
    const values: Record<string, string> = {};

    for (const key of attributionKeys) {
      const incoming = params.get(key)?.trim();
      if (incoming) sessionStorage.setItem(`hor_${key}`, incoming);
      const stored = incoming ?? sessionStorage.getItem(`hor_${key}`) ?? '';
      if (stored) values[key] = stored;
    }

    if (!sessionStorage.getItem('hor_landing_page')) {
      sessionStorage.setItem('hor_landing_page', `${window.location.pathname}${window.location.search}`);
    }

    if (!sessionStorage.getItem('hor_referrer') && document.referrer) {
      sessionStorage.setItem('hor_referrer', document.referrer);
    }

    values['landing-page'] = sessionStorage.getItem('hor_landing_page') ?? window.location.pathname;
    values.referrer = sessionStorage.getItem('hor_referrer') ?? '';
    return values;
  };

  const attachAttribution = (): void => {
    const attribution = getStoredAttribution();
    const forms = document.querySelectorAll<HTMLFormElement>('form[action="/.netlify/functions/lead-submit"]');

    for (const form of forms) {
      for (const [name, value] of Object.entries(attribution)) {
        let input = form.querySelector<HTMLInputElement>(`input[name="${name}"]`);
        if (!input) {
          input = document.createElement('input');
          input.type = 'hidden';
          input.name = name;
          form.append(input);
        }
        input.value = value;
      }
    }
  };

  const bindClickTracking = (): void => {
    if (analyticsWindow.__horAnalyticsBound) return;
    analyticsWindow.__horAnalyticsBound = true;

    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[href]') : null;
      if (!target) return;

      const rawHref = target.getAttribute('href') ?? '';
      if (rawHref.startsWith('tel:')) {
        track('phone_click', { link_location: window.location.pathname });
        trackMeta('Contact');
      } else if (rawHref.startsWith('sms:')) {
        track('sms_click', { link_location: window.location.pathname });
        trackMeta('Contact');
      } else if (rawHref.startsWith('mailto:')) {
        trackMeta('Contact');
      } else {
        try {
          const destination = new URL(target.href);
          if (destination.hostname.endsWith('glossgenius.com')) {
            track('booking_click', { link_location: window.location.pathname });
            trackMeta('Schedule');
          }
        } catch {
          // Ignore non-URL links.
        }
      }
    });
  };

  const initialize = (): void => {
    attachAttribution();
    bindClickTracking();
  };

  document.addEventListener('astro:page-load', initialize);
  initialize();
</script>

