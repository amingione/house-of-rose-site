<script>
  import {
    attachAttributionToLeadForms,
    dispatchMeasurement,
    initializeConsentAwareVendors,
    trackPageView,
  } from '@/lib/measurement';

  const bindClickTracking = (): void => {
    if (document.documentElement.dataset.analyticsBound === 'true') return;
    document.documentElement.dataset.analyticsBound = 'true';

    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[href]') : null;
      if (!target) return;

      const rawHref = target.getAttribute('href') ?? '';
      if (rawHref.startsWith('tel:')) {
        const mode = target.dataset.bookingMode;
        dispatchMeasurement({
          event: 'phone_click',
          link_location: window.location.pathname,
          service_slug: target.dataset.bookingService || undefined,
          booking_mode: mode === 'phone' ? mode : undefined,
          cta_location: target.dataset.ctaLocation || undefined,
        });
      } else if (rawHref.startsWith('sms:')) {
        dispatchMeasurement({ event: 'sms_click', link_location: window.location.pathname });
      } else {
        try {
          const destination = new URL(target.href);
          if (target.hasAttribute('data-select-item')) {
            dispatchMeasurement({
              event: 'select_item',
              ecommerce: {
                currency: 'USD',
                value: Number(target.dataset.price ?? 0) / 100,
                items: [{
                  item_id: target.dataset.sku ?? target.dataset.productId ?? '',
                  item_name: target.dataset.title ?? '',
                  item_brand: target.dataset.brand || undefined,
                  item_category: target.dataset.category || undefined,
                  price: Number(target.dataset.price ?? 0) / 100,
                  quantity: 1,
                  item_list_id: 'shop',
                  item_list_name: 'House of Rose Shop',
                }],
              },
            });
          }
          if (destination.hostname.endsWith('glossgenius.com')) {
            const mode = target.dataset.bookingMode;
            dispatchMeasurement({
              event: 'booking_click',
              link_location: window.location.pathname,
              service_slug: target.dataset.bookingService || undefined,
              booking_mode:
                mode === 'direct' || mode === 'consultation' || mode === 'phone'
                  ? mode
                  : undefined,
              cta_location: target.dataset.ctaLocation || undefined,
            });
          }
        } catch {
          // Ignore non-URL links.
        }
      }
    });
  };

  const initialize = (): void => {
    initializeConsentAwareVendors();
    attachAttributionToLeadForms();
    bindClickTracking();
    trackPageView();
  };

  initialize();
</script>
