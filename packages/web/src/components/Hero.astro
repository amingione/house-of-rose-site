---
/**
 * Hero component with background image and overlay
 * Can be used for full-height heroes or smaller heroes
 */

import { sbFieldPath } from "@/lib/visualEditing";

interface Props {
	title: string;
	subtitle?: string;
	kicker?: string;
	description?: string;
	backgroundClass?: string;
	backgroundImage?: string;
	backgroundSrcset?: string;
	backgroundSizes?: string;
	backgroundWidth?: number;
	backgroundHeight?: number;
	imageAlt?: string;
	size?: "full" | "small";
	centerContent?: boolean;
	showCTA?: boolean;
	ctaPrimary?: { text: string; href: string };
	ctaSecondary?: { text: string; href: string };
	/**
	 * Optional Visual Editor field paths. When provided, the matching element
	 * emits `data-sb-field-path` (relative to an ancestor `data-sb-object-id`)
	 * so the hero copy is click-to-editable. Omitted by default → inert.
	 */
	titleField?: string;
	subtitleField?: string;
	kickerField?: string;
	descriptionField?: string;
}

const {
	title,
	subtitle,
	kicker,
	description,
	backgroundClass = "bg-charcoal",
	backgroundImage,
	backgroundSrcset,
	backgroundSizes,
	backgroundWidth = 1920,
	backgroundHeight = 1280,
	imageAlt = "",
	size = "full",
	centerContent = false,
	showCTA = false,
	ctaPrimary,
	ctaSecondary,
	titleField,
	subtitleField,
	kickerField,
	descriptionField,
} = Astro.props;

const sbAttr = (field?: string) => (field ? sbFieldPath(field) : {});

const sizeClasses =
	size === "full" ? "min-h-[min(780px,100svh)]" : "min-h-[460px]";

const titleLines = title.split("\n");
---

<section
	class={`on-dark hero-dark hero relative w-full ${sizeClasses} flex items-end overflow-hidden ${backgroundClass}`}
>
	{
		backgroundImage && (
			<div class="absolute inset-0">
				<img
					src={backgroundImage}
					alt={imageAlt}
					srcset={backgroundSrcset}
					sizes={backgroundSizes}
					class="w-full h-full object-cover"
					loading="eager"
					fetchpriority="high"
					decoding="sync"
					width={backgroundWidth}
					height={backgroundHeight}
				/>
			</div>
		)
	}
	<!-- Walnut scrim keeps copy readable while the real environment stays visible. -->
	<div
		class="overlay absolute inset-0 bg-gradient-to-t from-[rgba(43,33,28,0.9)] via-[rgba(43,33,28,0.58)] to-[rgba(43,33,28,0.5)]"
	>
	</div>

	<!-- Content -->
	<div
		class={`relative z-10 ${centerContent ? "max-w-[960px] text-center" : "max-w-[1280px]"} mx-auto px-6 w-full pt-28 ${size !== "full" ? "pb-12" : ""}`}
		style={size === "full"
			? "padding-bottom: clamp(44px,8vh,74px)"
			: undefined}
	>
		{
			kicker && (
				<span class="block text-[12px] font-semibold tracking-[0.12em] uppercase text-gold mb-3" {...sbAttr(kickerField)}>
					{kicker}
				</span>
			)
		}
		{
			subtitle && (
				<span class="block text-[12px] font-semibold tracking-[0.1em] uppercase text-gold mb-4" {...sbAttr(subtitleField)}>
					{subtitle}
				</span>
			)
		}
		<h1
		class="font-serif text-[clamp(42px,7vw,80px)] leading-[1.02] font-normal text-ivory mb-5"
			{...sbAttr(titleField)}
		>
			{
				titleLines.map((line) => (
					<span class="block">
						{line}
					</span>
				))
			}
		</h1>
		{
			description && (
				<p
					class={`text-muted-strong text-[clamp(16px,2vw,19px)] max-w-[620px] leading-[1.65] mb-9 ${centerContent ? "mx-auto" : ""}`}
					{...sbAttr(descriptionField)}
				>
					{description}
				</p>
			)
		}
		{
			showCTA && (ctaPrimary || ctaSecondary) && (
				<div
					class={`flex gap-3 flex-wrap ${centerContent ? "justify-center" : ""}`}
				>
					{ctaPrimary && (
						<a
							href={ctaPrimary.href}
							class="btn-gold"
							{...(ctaPrimary.href.startsWith("http") && {
								target: "_blank",
								rel: "noopener noreferrer",
							})}
						>
							{ctaPrimary.text}
						</a>
					)}
					{ctaSecondary && (
						<a
							href={ctaSecondary.href}
							class="btn-outline-white"
							{...(ctaSecondary.href.startsWith("http") && {
								target: "_blank",
								rel: "noopener noreferrer",
							})}
						>
							{ctaSecondary.text}
						</a>
					)}
				</div>
			)
		}
		<slot />
	</div>
</section>
