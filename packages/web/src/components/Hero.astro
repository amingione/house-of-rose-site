---
/**
 * Hero component with background image and overlay
 * Can be used for full-height heroes or smaller heroes
 */

interface Props {
  title: string;
  subtitle?: string;
  kicker?: string;
  description?: string;
  backgroundClass?: string;
  backgroundImage?: string;
  size?: 'full' | 'small';
  showCTA?: boolean;
  ctaPrimary?: { text: string; href: string };
  ctaSecondary?: { text: string; href: string };
}

const {
  title,
  subtitle,
  kicker,
  description,
  backgroundClass = 'bg-charcoal',
  backgroundImage,
  size = 'full',
  showCTA = false,
  ctaPrimary,
  ctaSecondary,
} = Astro.props;

const sizeClasses = size === 'full' ? 'h-screen min-h-[560px]' : 'h-[55vh] min-h-[360px]';
const contentClasses = size === 'full' ? 'clamp(44px,8vh,74px)' : '12';
---

<section
  class={`hero relative w-full ${sizeClasses} flex items-end ${backgroundClass}`}
  style={backgroundImage ? `background-image: url(${backgroundImage}); background-size: cover; background-position: center;` : ''}
>
  <!-- Gradient overlay -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-black/10"></div>

  <!-- Content -->
  <div class={`relative z-10 max-w-[1280px] mx-auto px-6 pb-${contentClasses} w-full`}>
    {kicker && <span class="kicker">{kicker}</span>}
    {subtitle && (
      <span class="block text-[10px] tracking-[0.4em] uppercase text-gold mb-3">
        {subtitle}
      </span>
    )}
    <h1 class="font-serif text-[clamp(36px,8vw,84px)] leading-tight font-normal text-white mb-4">
      {title}
    </h1>
    {description && (
      <p class="text-white/75 text-base max-w-[430px] leading-relaxed mb-9">
        {description}
      </p>
    )}
    {showCTA && (ctaPrimary || ctaSecondary) && (
      <div class="flex gap-3 flex-wrap">
        {ctaPrimary && (
          <a
            href={ctaPrimary.href}
            class="btn-gold"
            {...(ctaPrimary.href.startsWith('http') && {
              target: '_blank',
              rel: 'noopener noreferrer'
            })}
          >
            {ctaPrimary.text}
          </a>
        )}
        {ctaSecondary && (
          <a
            href={ctaSecondary.href}
            class="btn-outline-white"
            {...(ctaSecondary.href.startsWith('http') && {
              target: '_blank',
              rel: 'noopener noreferrer'
            })}
          >
            {ctaSecondary.text}
          </a>
        )}
      </div>
    )}
    <slot />
  </div>
</section>
