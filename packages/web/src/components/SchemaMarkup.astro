---
import type { JsonLd } from '@/lib/structuredData';

interface Props {
  item: JsonLd;
  space?: string | number;
}

const { item, space } = Astro.props;
// JSON-LD script contents are raw text: HTML entities such as `&amp;` are not
// decoded there and would change names, URLs, and answer text seen by crawlers.
// Escape only characters that could terminate or disrupt the script element.
const serializedItem = JSON.stringify(item, null, space)
  .replace(/</g, '\\u003c')
  .replace(/\u2028/g, '\\u2028')
  .replace(/\u2029/g, '\\u2029');
---

<script is:inline type="application/ld+json" set:html={serializedItem} />
