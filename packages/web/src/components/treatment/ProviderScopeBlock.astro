---
import { sbFieldPath, sbObjectField } from '@/lib/visualEditing';
import {
  performedByLabel,
  verifiedProviderIdentity,
  type TreatmentProviderAttribution,
  type TreatmentProviderScope,
} from '@/lib/treatmentQueries';

interface Props {
  providerScope: TreatmentProviderScope;
  provider?: TreatmentProviderAttribution;
  treatmentName: string;
}

const { providerScope, provider, treatmentName } = Astro.props;

/**
 * Two statutory requirements are met here, not one.
 *
 * 1. § 456.072(1)(t) — wherever a practitioner is named, the LICENSE TYPE must
 *    appear. "Injector", "Provider", and "Skin Specialist" satisfy nothing.
 *    `performedByLabel` returns RN / licensed esthetician for that reason.
 *
 * 2. The medical director attribution line is canonical and fixed. It lives in
 *    CLAUDE.md and is deliberately not editable per-service — a typo in a licence
 *    number is a § 456.072 problem, not a copy problem.
 *
 * Never imply the medical director performs treatments, is on site, or holds a
 * dermatology specialty. R. 64B8-11.001(2)(a) and (2)(k) are violated by
 * implication alone; his NPI taxonomy is Surgery.
 */
const MEDICAL_DIRECTOR = 'Medical Director: Joshua Shaw, MD · FL Lic. ME136232';

const verifiedIdentity = verifiedProviderIdentity(provider, providerScope.performedBy);
const namedProvider = verifiedIdentity?.publicName;
const providerLabel = namedProvider ?? performedByLabel(providerScope.performedBy);
const providerNameAnnotation = provider && namedProvider === provider.publicName?.trim()
  ? sbObjectField(provider._id, 'publicName')
  : {};
const profilePath = namedProvider && verifiedIdentity?.profileSlug
  ? `/about/providers/${verifiedIdentity.profileSlug}/`
  : undefined;
const optimizedProfileImages: Readonly<Record<string, string>> = {
  amber: '/images/providers/amber-profile-1122.webp',
  brandy: '/images/providers/brandy-profile-1122.webp',
  diana: '/images/providers/diana-profile-1122.webp',
};
const providerImagePath = verifiedIdentity?.profileSlug
  ? optimizedProfileImages[verifiedIdentity.profileSlug] ?? provider?.profileImagePath
  : provider?.profileImagePath;
const scopeSuffix = providerScope.medicalDirection
  ? ' under written physician protocol and medical direction.'
  : '.';
---

<div>
  <span class="kicker">Provider</span>
  <h2 class="font-serif text-[clamp(25px,3.6vw,36px)] text-ink mt-2 mb-5">
    Who provides {treatmentName}.
  </h2>

  <p
    class="text-ink text-[17px] leading-[1.7] mb-7"
    {...(!namedProvider ? sbFieldPath('providerScope.performedBy') : {})}
  >
    {profilePath ? (
      <a
        href={profilePath}
        class="underline decoration-gold-metal/50 underline-offset-4 hover:text-gold transition-colors"
        {...providerNameAnnotation}
      >
        {providerLabel}
      </a>
    ) : namedProvider ? (
      <span {...providerNameAnnotation}>{providerLabel}</span>
    ) : (
      providerLabel
    )}{scopeSuffix}
  </p>

  {providerScope.medicalDirection && (
    <p class="text-muted text-[13px] leading-relaxed mb-5">{MEDICAL_DIRECTOR}</p>
  )}
</div>

{providerImagePath && (
  <figure class="overflow-hidden border border-gold-metal/15 bg-charcoal-light">
    <img
      src={providerImagePath}
      alt={provider?.profileImageAlt ?? `${providerLabel} at House of Rose Aesthetics`}
      width="1122"
      height="1402"
      loading="lazy"
      decoding="async"
      class="aspect-[4/5] h-full w-full object-cover"
    />
  </figure>
)}
