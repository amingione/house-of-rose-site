---
import ServiceHero from '@/components/service-landing/ServiceHero.astro';
import ServiceQuickFacts from '@/components/service-landing/ServiceQuickFacts.astro';
import ServiceSectionNav from '@/components/service-landing/ServiceSectionNav.astro';
import ServiceIntro from '@/components/service-landing/ServiceIntro.astro';
import BenefitsGrid from '@/components/service-landing/BenefitsGrid.astro';
import TreatmentOptions from '@/components/service-landing/TreatmentOptions.astro';
import PersonalizedIV from '@/components/service-landing/PersonalizedIV.astro';
import TreatmentProcess from '@/components/service-landing/TreatmentProcess.astro';
import PhilosophySection from '@/components/service-landing/PhilosophySection.astro';
import BrandImageMoment from '@/components/service-landing/BrandImageMoment.astro';
import ClinicalTrust from '@/components/service-landing/ClinicalTrust.astro';
import ServiceFAQ from '@/components/service-landing/ServiceFAQ.astro';
import ServiceTestimonials from '@/components/service-landing/ServiceTestimonials.astro';
import LocalSEOSection from '@/components/service-landing/LocalSEOSection.astro';
import ServiceCTA from '@/components/service-landing/ServiceCTA.astro';
import MobileServiceCTA from '@/components/service-landing/MobileServiceCTA.astro';
import {
  IV_LANDING_FAQS,
  IV_LANDING_HERO_IMAGE,
  IV_LANDING_HERO_IMAGE_ALT,
  IV_LANDING_OPTIONS,
  IV_LANDING_POINTS,
  IV_LANDING_QUICK_FACTS,
  IV_LANDING_STEPS,
  IV_LANDING_TESTIMONIALS,
} from '@/lib/ivHydrationLanding';

---

<div class="iv-page overflow-x-clip bg-[#1C1E22] pb-[calc(78px+env(safe-area-inset-bottom))] lg:pb-0">
  <ServiceHero image={IV_LANDING_HERO_IMAGE} imageAlt={IV_LANDING_HERO_IMAGE_ALT} />
  <ServiceQuickFacts facts={IV_LANDING_QUICK_FACTS} />
  <ServiceSectionNav />
  <ServiceIntro
    id="overview"
    eyebrow="IV therapy at House of Rose"
    heading="What IV hydration involves."
    paragraphs={[
      'IV means the fluid is delivered through a vein rather than taken by mouth. What matters is the current formulation, the person receiving it, and whether the appointment is appropriate for you.',
      'House of Rose offers six named IV appointments. You do not need to interpret those names as a diagnosis or choose ingredients on your own. Diana Morrison, RN reviews relevant health information and the current option before an infusion proceeds.',
      'IV hydration does not replace medical care. It is one service among the treatments offered at House of Rose.',
    ]}
  />
  <BenefitsGrid items={IV_LANDING_POINTS} />
  <TreatmentOptions options={IV_LANDING_OPTIONS} />
  <PersonalizedIV />
  <TreatmentProcess steps={IV_LANDING_STEPS} />
  <PhilosophySection />
  <BrandImageMoment />
  <section class="bg-[#1C1E22] px-5 py-[clamp(80px,10vw,148px)] text-[#F1EDE5] sm:px-10 lg:px-16" aria-labelledby="iv-candidacy-title">
    <div class="mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[0.82fr_1.18fr] lg:gap-24">
      <div>
        <p class="iv-eyebrow">Who IV hydration may be for</p>
        <h2 id="iv-candidacy-title" class="mt-6 max-w-[660px] font-serif text-[clamp(42px,5.7vw,76px)] leading-[0.97] tracking-[-0.025em]">Candidacy is reviewed individually.</h2>
      </div>
      <div class="max-w-[700px] self-end">
        <p class="text-[17px] leading-[1.8] text-[#D0CCC4]">IV hydration may be worth discussing if you are seeking additional hydration support, are reviewing options around travel or a physically demanding period, or want to understand whether IV therapy belongs in a broader wellness routine.</p>
        <p class="mt-6 border-l border-[#8C6F3F] pl-5 text-[15px] leading-[1.75] text-[#BDB8B0]">Diana Morrison, RN reviews relevant health information and candidacy under written physician protocol before any appointment is booked.</p>
      </div>
    </div>
  </section>
  <ClinicalTrust />
  <ServiceFAQ faqs={IV_LANDING_FAQS} />
  <ServiceTestimonials testimonials={IV_LANDING_TESTIMONIALS} />
  <LocalSEOSection />
  <ServiceCTA />
  <MobileServiceCTA />
</div>

<style is:global>
  html:has(.iv-page) {
    scroll-behavior: smooth;
  }

  .iv-page {
    --iv-noir: #1c1e22;
    --iv-slate: #3a3f47;
    --iv-linen: #c8bba8;
    --iv-brass: #8c6f3f;
  }

  .iv-page .iv-eyebrow {
    color: var(--iv-linen);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.24em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .iv-page .iv-button-primary,
  .iv-page .iv-button-secondary {
    align-items: center;
    display: inline-flex;
    justify-content: center;
    min-height: 50px;
    padding: 14px 22px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.15em;
    line-height: 1.2;
    text-transform: uppercase;
    transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease;
  }

  .iv-page .iv-button-primary {
    border: 1px solid #f1ede5;
    background: #f1ede5;
    color: var(--iv-noir);
  }

  .iv-page .iv-button-primary:hover,
  .iv-page .iv-button-primary:focus-visible {
    border-color: #c8bba8;
    background: #c8bba8;
  }

  .iv-page .iv-button-secondary {
    border: 1px solid rgba(241, 237, 229, 0.34);
    color: #f1ede5;
  }

  .iv-page .iv-button-secondary:hover,
  .iv-page .iv-button-secondary:focus-visible {
    border-color: #f1ede5;
    background: rgba(241, 237, 229, 0.06);
  }

  .iv-page a:focus-visible,
  .iv-page summary:focus-visible {
    outline: 2px solid #e7d6a8;
    outline-offset: 4px;
  }

  .iv-page details > summary::-webkit-details-marker {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .iv-page *,
    .iv-page *::before,
    .iv-page *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>
