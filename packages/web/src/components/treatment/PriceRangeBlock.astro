---
import type { TreatmentPriceRange } from '@/lib/treatmentQueries';
import BookingLink from '@/components/BookingLink.astro';
import type { BookingMode } from '@/lib/booking';

// House of Rose pricing is never public (binding 2026-08-20, see CLAUDE.md
// "Public website pricing is NEVER permitted"). This component intentionally
// never formats or renders `priceRange` as a dollar amount — even if a future
// caller passes one in — and shows a consultation/booking CTA instead. The
// `priceRange` prop is accepted only so existing callers keep type-checking;
// its value is not read for display.

interface Props {
  priceRange: TreatmentPriceRange;
  slug: string;
  bookingMode?: BookingMode;
  bookingUrl?: string;
}

const { slug, bookingMode, bookingUrl } = Astro.props;
---

<div>
  <span class="kicker">Price</span>
  <h2 class="font-serif text-[clamp(25px,3.6vw,36px)] text-ink mt-2 mb-5">
    What does it cost?
  </h2>

  <p class="text-muted text-[15px] leading-[1.8] mb-7 max-w-[54ch]">
    Contact House of Rose for current pricing.
  </p>

  <BookingLink
    slug={slug}
    bookingMode={bookingMode}
    bookingUrl={bookingUrl}
    location="treatment-price-block"
    class="inline-block text-[11px] font-medium tracking-[0.26em] uppercase text-gold border-b border-gold-metal/50 pb-1 transition-colors hover:text-ivory hover:border-ivory"
  />
</div>
