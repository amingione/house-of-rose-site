---
import { sbFieldPath, sbFieldPathParts } from '@/lib/visualEditing';
import type { TreatmentAftercare } from '@/lib/treatmentQueries';

interface Props {
  aftercare: TreatmentAftercare;
  treatmentName: string;
}

const { aftercare, treatmentName } = Astro.props;

const columns = [
  { key: 'firstDay' as const, label: 'First 24 Hours', items: aftercare.firstDay },
  { key: 'firstWeek' as const, label: 'First Week', items: aftercare.firstWeek },
  { key: 'avoid' as const, label: 'Avoid', items: aftercare.avoid },
  { key: 'ongoing' as const, label: 'Ongoing', items: aftercare.ongoing },
].filter((column) => column.items && column.items.length > 0);
---

<div>
  <span class="kicker">Aftercare</span>
  <h2 class="font-serif text-[clamp(25px,3.6vw,36px)] text-ink mt-2 mb-5">
    How do you care for skin after {treatmentName}?
  </h2>

  {aftercare.intro && (
    <p class="text-muted text-[15px] leading-[1.8] mb-8 max-w-[62ch]" {...sbFieldPath('aftercare.intro')}>
      {aftercare.intro}
    </p>
  )}

  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-9">
    {columns.map((column) => (
      <div>
        <h3 class="text-[11px] font-medium tracking-[0.22em] uppercase text-gold mb-4">
          {column.label}
        </h3>
        <ul class="space-y-2.5">
          {column.items!.map((item, i) => (
            <li class="flex gap-3 text-muted text-[14px] leading-relaxed">
              <span class="text-gold mt-0.5 shrink-0" aria-hidden="true">
                {column.key === 'avoid' ? '—' : '✦'}
              </span>
              <span {...sbFieldPathParts(`aftercare.${column.key}`, i)}>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</div>
