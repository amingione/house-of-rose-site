---
import type { ServiceEducationContent } from '@/lib/serviceEducation';
import type { ServiceConcern } from '@/lib/serviceCatalog';

interface Props {
  content: ServiceEducationContent;
  serviceTitle: string;
  concerns?: readonly ServiceConcern[];
}

const { content, serviceTitle, concerns = [] } = Astro.props;
const supportingParagraphs = content.paragraphs.slice(1);
---

<section id="treatment-guide" class="border-t border-gold-metal/10 bg-charcoal px-6 py-[clamp(56px,8vw,96px)]">
  <div class="mx-auto max-w-[1180px]">
    {supportingParagraphs.length > 0 && <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-24">
      <div>
        <span class="kicker">What it is</span>
        <h2 class="mt-3 max-w-[560px] font-serif text-[clamp(32px,5vw,50px)] leading-[1.08] text-ink">
          {content.heading}
        </h2>
      </div>
      <div class="space-y-5 text-[17px] leading-[1.75] text-muted-strong">
        {supportingParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        {content.links && content.links.length > 0 && (
          <div class="flex flex-wrap gap-x-8 gap-y-3 pt-3 text-[14px]">
            {content.links.map((link) => (
              <a href={link.href} class="learn-more hover:text-gold">{link.label}</a>
            ))}
          </div>
        )}
      </div>
    </div>}

    {(content.benefits?.length || concerns.length > 0) && (
      <div class:list={['grid gap-8 border-y border-gold-metal/15 py-10 lg:grid-cols-2 lg:gap-16', supportingParagraphs.length > 0 && 'mt-14']}>
        <div>
          <span class="block text-[11px] uppercase tracking-[0.28em] text-gold">Benefits</span>
          <h3 class="mt-3 font-serif text-[clamp(27px,4vw,38px)] text-ink">Why people consider {serviceTitle}.</h3>
          <ul class="mt-7 space-y-4">
            {content.benefits?.map((benefit) => (
              <li class="flex gap-4 text-[15px] leading-[1.7] text-muted-strong"><span class="mt-[0.65em] h-1.5 w-1.5 shrink-0 rounded-full bg-gold" aria-hidden="true"></span>{benefit}</li>
            ))}
          </ul>
        </div>
        {concerns.length > 0 && (
          <div>
            <h3 class="font-serif text-[clamp(27px,4vw,38px)] text-ink">What it may help with.</h3>
            <div class="mt-7 grid gap-x-8 border-t border-gold-metal/15 sm:grid-cols-2">
              {concerns.map((concern) => (
                <a href={`/concerns/${concern.slug}/`} class="flex min-h-12 items-center justify-between border-b border-gold-metal/15 py-3 text-[14px] text-muted-strong transition-colors hover:text-gold">{concern.title}<span aria-hidden="true">→</span></a>
              ))}
            </div>
          </div>
        )}
      </div>
    )}

    {content.treatmentSteps && content.treatmentSteps.length > 0 && (
      <div class="mt-14">
        <span class="block text-[11px] uppercase tracking-[0.28em] text-gold">What the treatment consists of</span>
        <h3 class="mt-3 max-w-[720px] font-serif text-[clamp(27px,4vw,38px)] text-ink">What happens during {serviceTitle}.</h3>
        <div class="mt-8 grid gap-px bg-gold-metal/15 md:grid-cols-3">
          {content.treatmentSteps.map((step, index) => (
            <article class="bg-charcoal-light p-7 sm:p-9">
              <span class="text-[12px] tracking-[0.2em] text-gold">0{index + 1}</span>
              <h4 class="mt-4 font-serif text-[24px] text-ink">{step.title}</h4>
              <p class="mt-4 text-[15px] leading-[1.75] text-muted">{step.text}</p>
            </article>
          ))}
        </div>
      </div>
    )}

    {content.distinctions && content.distinctions.length > 0 && (
      <div class="mt-14">
        <span class="block text-[11px] uppercase tracking-[0.28em] text-gold">Treatment details</span>
        <div class="mt-6 grid gap-px bg-gold-metal/15 sm:grid-cols-2">
          {content.distinctions.map((distinction) => (
            <article class="bg-charcoal-light p-7 sm:p-9">
              <h3 class="font-serif text-[24px] text-ink">{distinction.label}</h3>
              <p class="mt-4 text-[15px] leading-[1.75] text-muted">{distinction.text}</p>
            </article>
          ))}
        </div>
      </div>
    )}

    {content.sessionGuidance && (
      <div class="mt-14 grid gap-6 border border-gold-metal/20 bg-charcoal-light p-8 md:grid-cols-[0.65fr_1.35fr] md:p-10">
        <div>
          <span class="block text-[11px] uppercase tracking-[0.28em] text-gold">How many treatments?</span>
          <h3 class="mt-3 font-serif text-[28px] text-ink">Treatment frequency.</h3>
        </div>
        <p class="text-[16px] leading-[1.8] text-muted-strong">{content.sessionGuidance}</p>
      </div>
    )}

    {content.pairings && content.pairings.length > 0 && (
      <div class="mt-14">
        <span class="block text-[11px] uppercase tracking-[0.28em] text-gold">Related treatments</span>
        <h3 class="mt-3 max-w-[760px] font-serif text-[clamp(27px,4vw,38px)] text-ink">When another approach addresses a different concern.</h3>
        <div class:list={['mt-8 grid gap-px bg-gold-metal/15', content.pairings.length > 1 ? 'sm:grid-cols-2' : 'max-w-[760px]']}>
          {content.pairings.map((pairing) => (
            <article class="bg-charcoal-light p-7 sm:p-9">
              <h4 class="font-serif text-[24px] text-ink">{pairing.title}</h4>
              <p class="mt-4 text-[15px] leading-[1.75] text-muted">{pairing.text}</p>
              {pairing.href && <a href={pairing.href} class="learn-more mt-5 inline-block hover:text-gold">Read about {pairing.title}</a>}
            </article>
          ))}
        </div>
      </div>
    )}

    <div class="mt-14 border-y border-gold-metal/15 py-10">
      <span class="block text-[11px] uppercase tracking-[0.28em] text-gold">Prepare and recover</span>
      <h3 class="mt-3 font-serif text-[clamp(27px,4vw,38px)] text-ink">Download the care guides.</h3>
      <p class="mt-4 max-w-[760px] text-[15px] leading-[1.75] text-muted">Use the treatment-specific section in each guide, then follow the instructions provided for your appointment.</p>
      <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a href="/downloads/treatment-care/house-of-rose-pre-care-guide.pdf" download class="btn-gold">Download pre-care guide</a>
        <a href="/downloads/treatment-care/house-of-rose-aftercare-guide.pdf" download class="btn-outline-gold">Download aftercare guide</a>
      </div>
    </div>

    {content.faqs && content.faqs.length > 0 && (
      <div class="mt-14 border-t border-gold-metal/20 pt-10">
        <span class="block text-[11px] uppercase tracking-[0.28em] text-gold">Questions</span>
        <h3 class="mt-3 font-serif text-[clamp(27px,4vw,38px)] text-ink">{content.faqHeading ?? `Common questions about ${serviceTitle}.`}</h3>
        <div class="mt-8 border-y border-gold-metal/15">
          {content.faqs.map((faq) => (
            <details class="group border-b border-gold-metal/10 last:border-b-0">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-left font-serif text-[20px] text-ink">
                {faq.question}
                <span class="text-gold transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="max-w-[780px] pb-7 text-[15px] leading-[1.75] text-muted">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
