---
import { VERIFIED_IV_MENU } from '@/lib/ivHydrationFacts';

const formatPrice = (price: number): string => `$${price.toLocaleString('en-US')}`;
---

<section class="bg-charcoal-light px-6 py-[clamp(48px,7vw,80px)] border-t border-gold-metal/10">
  <div class="mx-auto max-w-[960px]">
    <span class="kicker">Current menu</span>
    <h2 class="mt-2 font-serif text-[clamp(26px,4vw,38px)] text-ink">IV hydration options</h2>
    <p class="mt-4 max-w-[620px] text-[15px] leading-relaxed text-muted">
      The current IV drip menu, with appointment length and price for each base option.
    </p>

    <div class="mt-9 overflow-x-auto border-y border-gold-metal/20">
      <table class="w-full min-w-[520px] border-collapse text-left">
        <caption class="sr-only">Current IV hydration options, duration, and price</caption>
        <thead>
          <tr class="border-b border-gold-metal/20 text-[11px] uppercase tracking-[0.16em] text-muted">
            <th scope="col" class="px-4 py-4 font-medium">IV option</th>
            <th scope="col" class="px-4 py-4 font-medium">Appointment</th>
            <th scope="col" class="px-4 py-4 text-right font-medium">Price</th>
          </tr>
        </thead>
        <tbody>
          {VERIFIED_IV_MENU.map((item) => (
            <tr class="border-b border-gold-metal/10 last:border-b-0">
              <th scope="row" class="px-4 py-5 font-serif text-[19px] font-normal text-ink">
                {item.name}
              </th>
              <td class="px-4 py-5 text-[14px] text-muted">{item.durationMinutes} minutes</td>
              <td class="px-4 py-5 text-right text-[15px] font-medium text-ink">
                {formatPrice(item.price)}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
