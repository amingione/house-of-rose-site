---
import {
  IV_HYDRATION_CATEGORY_OVERVIEW,
  IV_HYDRATION_EDUCATION,
  IV_HYDRATION_FAQS,
  VERIFIED_IV_MENU,
} from '@/lib/ivHydrationFacts';

// House of Rose pricing is never public (binding 2026-08-20, see CLAUDE.md) —
// this table intentionally shows appointment name and duration only.
---

<section class="bg-charcoal-light px-6 py-[clamp(48px,7vw,80px)] border-t border-gold-metal/10">
  <div class="mx-auto max-w-[960px]">
    <div data-iv-category-overview class="mb-12 border-b border-gold-metal/20 pb-10">
      <span class="kicker">What IV means</span>
      <h2 class="mt-2 max-w-[720px] font-serif text-[clamp(26px,4vw,38px)] text-ink">
        {IV_HYDRATION_CATEGORY_OVERVIEW.heading}
      </h2>
      <div class="mt-5 grid gap-4 text-[15px] leading-relaxed text-muted md:grid-cols-2 md:gap-10">
        <p>{IV_HYDRATION_CATEGORY_OVERVIEW.lead}</p>
        <p>{IV_HYDRATION_CATEGORY_OVERVIEW.detail}</p>
      </div>
    </div>

    <span class="kicker">Times and prices</span>
    <h2 class="mt-2 font-serif text-[clamp(26px,4vw,38px)] text-ink">Six base IV appointments</h2>
    <p class="mt-4 max-w-[620px] text-[15px] leading-relaxed text-muted">
      {IV_HYDRATION_EDUCATION.shorterOption} {IV_HYDRATION_EDUCATION.longerOptions}
    </p>

    <div
      class="mt-9 overflow-x-auto border-y border-gold-metal/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold"
      tabindex="0"
    >
      <table class="w-full min-w-[520px] border-collapse text-left">
        <caption class="sr-only">IV hydration options and duration</caption>
        <thead>
          <tr class="border-b border-gold-metal/20 text-[11px] uppercase tracking-[0.16em] text-muted">
            <th scope="col" class="px-4 py-4 font-medium">IV option</th>
            <th scope="col" class="px-4 py-4 text-right font-medium">Appointment</th>
          </tr>
        </thead>
        <tbody>
          {VERIFIED_IV_MENU.map((item) => (
            <tr class="border-b border-gold-metal/10 last:border-b-0">
              <th scope="row" class="px-4 py-5 font-serif text-[19px] font-normal text-ink">
                {item.name}
              </th>
              <td class="px-4 py-5 text-right text-[14px] text-muted">{item.durationMinutes} minutes</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="mt-4 text-[13px] leading-relaxed text-muted">Ask about current pricing when you book.</p>
    </div>

    <div class="mt-14 border-t border-gold-metal/20 pt-10">
      <span class="kicker">Questions</span>
      <h2 class="mt-2 font-serif text-[clamp(26px,4vw,38px)] text-ink">
        Names, timing, ingredients, and who provides the service.
      </h2>
      <div class="mt-7 divide-y divide-gold-metal/15 border-y border-gold-metal/15">
        {IV_HYDRATION_FAQS.map((item) => (
          <details class="group py-5">
            <summary class="flex min-h-[44px] cursor-pointer list-none items-center justify-between gap-5 font-serif text-[19px] text-ink">
              {item.question}
              <span aria-hidden="true" class="text-gold transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="max-w-[760px] pb-2 pr-10 pt-3 text-[15px] leading-[1.75] text-muted">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
