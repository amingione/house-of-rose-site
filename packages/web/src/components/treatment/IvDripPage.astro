---
/**
 * One page per House of Rose IV bag. Client-facing only.
 * Content is typed in `@/lib/ivDripContent`; this component owns layout.
 */
import ServicePhoneLink from '@/components/service-landing/ServicePhoneLink.astro';
import ClinicalTrust from '@/components/service-landing/ClinicalTrust.astro';
import ServiceFAQ from '@/components/service-landing/ServiceFAQ.astro';
import LocalSEOSection from '@/components/service-landing/LocalSEOSection.astro';
import ServiceCTA from '@/components/service-landing/ServiceCTA.astro';
import MobileServiceCTA from '@/components/service-landing/MobileServiceCTA.astro';
import IvPageStyles from '@/components/service-landing/IvPageStyles.astro';
import { IV_LANDING_HERO_IMAGE } from '@/lib/ivHydrationLanding';
import {
  IV_DRIPS,
  IV_DRIP_BASE_PATH,
  IV_DRIP_STANDARD_NOTES,
  getIvDripOrThrow,
  ivDripPath,
  type IvDripContent,
} from '@/lib/ivDripContent';

interface Props {
  readonly drip: IvDripContent;
}

const { drip } = Astro.props;
const siblings = IV_DRIPS.filter((entry) => entry.slug !== drip.slug);
const alternatives = drip.alternatives.map((alt) => ({ ...alt, drip: getIvDripOrThrow(alt.slug) }));
const heroAlt = `The IV hydration suite at House of Rose Aesthetics where the ${drip.name} is provided`;
// Keep the ingredient grid free of empty cells: 2, 4 → two columns; 3, 5, 6 → three.
const ingredientGridClass = drip.ingredients.length % 3 === 0 || drip.ingredients.length >= 5
  ? 'sm:grid-cols-2 lg:grid-cols-3'
  : 'sm:grid-cols-2';
---

<div class="iv-page overflow-x-clip bg-[#1C1E22] pb-[calc(78px+env(safe-area-inset-bottom))] lg:pb-0">
  <!-- Hero -->
  <section class="relative overflow-hidden bg-[#1C1E22] pt-20 text-[#F1EDE5] lg:pt-24" aria-labelledby="iv-page-title">
    <div class="mx-auto grid min-h-[min(720px,calc(100vh-80px))] max-w-[1728px] grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(480px,0.9fr)]">
      <div class="relative z-10 flex flex-col justify-center px-5 py-12 sm:px-10 sm:py-16 lg:px-[clamp(56px,7vw,116px)] lg:py-24">
        <a href={`${IV_DRIP_BASE_PATH}/`} class="mb-7 inline-flex w-fit items-center gap-2 text-[11px] font-medium uppercase tracking-[0.24em] text-[#C8BBA8] transition-colors hover:text-white focus-visible:text-white sm:mb-9">
          <span aria-hidden="true">←</span> IV Hydration Therapy
        </a>
        <p class="text-[11px] font-medium uppercase tracking-[0.26em] text-[#9F9483]">
          {drip.durationMinutes}-minute IV · Punta Gorda, FL
        </p>
        <h1 id="iv-page-title" class="mt-6 max-w-[820px] font-serif text-[clamp(44px,7.4vw,104px)] leading-[0.93] tracking-[-0.035em]">
          {drip.name}
        </h1>
        <p class="mt-8 max-w-[600px] text-[18px] leading-[1.65] text-[#D8D3CB] sm:text-[20px]">{drip.tagline}</p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-5">
          <ServicePhoneLink
            location={`drip_${drip.slug}_hero`}
            label={`Book the ${drip.shortName} IV`}
            accessibleContext="call House of Rose Aesthetics"
            class="iv-button-primary"
          />
          <a href="#whats-in-it" class="iv-button-secondary">What's in the bag</a>
        </div>
        <p class="mt-8 max-w-[600px] border-l border-[#8C6F3F] pl-4 text-[12px] leading-[1.65] text-[#C8C3BB]">
          Provided by <a href="/about/providers/diana/" class="border-b border-[#8C6F3F] text-[#F1EDE5]">Diana Morrison, RN</a> under written physician protocol and medical direction. {IV_DRIP_STANDARD_NOTES.pricing}
        </p>
      </div>
      <figure class="relative min-h-[340px] overflow-hidden bg-[#26292E] sm:min-h-[480px] lg:min-h-full">
        <img
          src={IV_LANDING_HERO_IMAGE}
          alt={heroAlt}
          width="1400"
          height="875"
          fetchpriority="high"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover object-[60%_center]"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#1C1E22]/45 via-transparent to-transparent lg:bg-gradient-to-r lg:from-[#1C1E22]/35 lg:via-transparent lg:to-transparent" aria-hidden="true"></div>
      </figure>
    </div>
  </section>

  <!-- Section nav -->
  <nav aria-label={`${drip.name} page sections`} class="sticky top-20 z-30 hidden border-b border-white/10 bg-[#1C1E22]/95 text-[#F1EDE5] backdrop-blur lg:block">
    <div class="mx-auto flex max-w-[1440px] items-center justify-center gap-[clamp(24px,3.5vw,56px)] px-8 py-4 text-[11px] uppercase tracking-[0.18em] text-[#C5C1BA]">
      <a href="#what-it-is" class="transition-colors hover:text-white focus-visible:text-white">What it is</a>
      <a href="#whats-in-it" class="transition-colors hover:text-white focus-visible:text-white">In the bag</a>
      <a href="#helps-with" class="transition-colors hover:text-white focus-visible:text-white">Helps with</a>
      <a href="#experience" class="transition-colors hover:text-white focus-visible:text-white">The visit</a>
      <a href="#right-for-you" class="transition-colors hover:text-white focus-visible:text-white">Right for you?</a>
      <a href="#faq" class="transition-colors hover:text-white focus-visible:text-white">FAQ</a>
      <a href="#book-iv" class="text-[#D7C6A8] transition-colors hover:text-white focus-visible:text-white">Book</a>
    </div>
  </nav>

  <!-- 1. What it is -->
  <section id="what-it-is" class="scroll-mt-32 bg-[#1C1E22] px-5 py-[clamp(80px,10vw,148px)] text-[#F1EDE5] sm:px-10 lg:px-16" aria-labelledby="drip-what-title">
    <div class="mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:gap-24">
      <div>
        <p class="iv-eyebrow">What it is</p>
        <h2 id="drip-what-title" class="mt-6 max-w-[520px] font-serif text-[clamp(40px,5.4vw,72px)] leading-[0.97] tracking-[-0.025em]">The {drip.shortName} IV, explained.</h2>
      </div>
      <div class="max-w-[720px] space-y-6 text-[17px] leading-[1.8] text-[#D0CCC4]">
        {drip.whatItIs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <!-- 2. What's in the bag -->
  <section id="whats-in-it" class="scroll-mt-32 bg-[#F1EDE5] px-5 py-[clamp(80px,10vw,148px)] text-[#1C1E22] sm:px-10 lg:px-16" aria-labelledby="drip-ingredients-title">
    <div class="mx-auto max-w-[1320px]">
      <div class="grid gap-8 lg:grid-cols-[0.78fr_1.22fr] lg:items-end">
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.24em] text-[#6B6560]">What's in the bag</p>
          <h2 id="drip-ingredients-title" class="mt-6 max-w-[620px] font-serif text-[clamp(40px,5.6vw,76px)] leading-[0.95] tracking-[-0.03em]">
            {drip.ingredients.length} ingredients. Nothing hidden.
          </h2>
        </div>
        <p class="max-w-[560px] text-[16px] leading-[1.75] text-[#4B4D52] lg:justify-self-end">
          Every bag is prepared to the written physician protocol and reviewed by Diana Morrison, RN before it hangs. Ask her the exact amounts at your visit and she will tell you.
        </p>
      </div>
      <ol class:list={["mt-14 grid gap-px border border-[#1C1E22]/15 bg-[#1C1E22]/15 lg:mt-20", ingredientGridClass]}>
        {drip.ingredients.map((ingredient, index) => (
          <li class="bg-[#F1EDE5] p-7 sm:p-9">
            <span class="font-serif text-[15px] text-[#8C6F3F]">0{index + 1}</span>
            <h3 class="mt-4 font-serif text-[clamp(24px,2.4vw,32px)] leading-[1.1] tracking-[-0.01em]">{ingredient.name}</h3>
            <p class="mt-4 text-[15px] leading-[1.75] text-[#4B4D52]">{ingredient.role}</p>
          </li>
        ))}
      </ol>
      <p class="mt-8 max-w-[860px] text-[13px] leading-[1.7] text-[#6B6560]">{IV_DRIP_STANDARD_NOTES.compounding}</p>
    </div>
  </section>

  <!-- 3. Helps with -->
  <section id="helps-with" class="scroll-mt-32 bg-[#1C1E22] px-5 py-[clamp(80px,10vw,148px)] text-[#F1EDE5] sm:px-10 lg:px-16" aria-labelledby="drip-helps-title">
    <div class="mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:gap-24">
      <div>
        <p class="iv-eyebrow">What it helps with</p>
        <h2 id="drip-helps-title" class="mt-6 max-w-[520px] font-serif text-[clamp(40px,5.4vw,72px)] leading-[0.97] tracking-[-0.025em]">Why clients book it.</h2>
        <p class="mt-7 max-w-[420px] text-[15px] leading-[1.75] text-[#BCB8B0]">Real reasons, in clients' own terms. How you feel afterward varies from person to person.</p>
      </div>
      <ul class="max-w-[760px] border-t border-white/15">
        {drip.helpsWith.map((item) => (
          <li class="flex gap-5 border-b border-white/15 py-6 text-[18px] leading-[1.5] text-[#E6E1D8] sm:text-[21px]">
            <span aria-hidden="true" class="mt-[0.55em] h-px w-7 shrink-0 bg-[#8C6F3F]"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4. The visit -->
  <section id="experience" class="scroll-mt-32 bg-[#25282D] px-5 py-[clamp(80px,10vw,148px)] text-[#F1EDE5] sm:px-10 lg:px-16" aria-labelledby="drip-visit-title">
    <div class="mx-auto max-w-[1320px]">
      <p class="iv-eyebrow">What to expect</p>
      <h2 id="drip-visit-title" class="mt-6 max-w-[700px] font-serif text-[clamp(40px,5.4vw,72px)] leading-[0.97] tracking-[-0.025em]">About {drip.durationMinutes} minutes, start to finish.</h2>
      <ol class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
        {drip.expectations.map((step, index) => (
          <li class="border-t border-white/20 pt-6">
            <span class="font-serif text-[15px] text-[#C8BBA8]">Step {index + 1}</span>
            <h3 class="mt-4 font-serif text-[26px] leading-[1.15]">{step.title}</h3>
            <p class="mt-4 text-[15px] leading-[1.75] text-[#C8C4BC]">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 5. Right for you -->
  <section id="right-for-you" class="scroll-mt-32 bg-[#F1EDE5] px-5 py-[clamp(80px,10vw,148px)] text-[#1C1E22] sm:px-10 lg:px-16" aria-labelledby="drip-fit-title">
    <div class="mx-auto max-w-[1320px]">
      <p class="text-[11px] font-medium uppercase tracking-[0.24em] text-[#6B6560]">Is the {drip.shortName} IV right for you?</p>
      <h2 id="drip-fit-title" class="mt-6 max-w-[760px] font-serif text-[clamp(40px,5.6vw,76px)] leading-[0.95] tracking-[-0.03em]">A good fit, or a conversation first.</h2>
      <div class="mt-14 grid gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          <h3 class="font-serif text-[28px] leading-[1.1]">A good fit when</h3>
          <ul class="mt-6 border-t border-[#1C1E22]/15">
            {drip.goodFitWhen.map((item) => (
              <li class="flex gap-4 border-b border-[#1C1E22]/15 py-5 text-[16px] leading-[1.6] text-[#2E3035]">
                <span aria-hidden="true" class="mt-[0.35em] font-serif text-[#8C6F3F]">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="font-serif text-[28px] leading-[1.1]">Talk with Diana Morrison, RN first when</h3>
          <ul class="mt-6 border-t border-[#1C1E22]/15">
            {drip.talkFirstWhen.map((item) => (
              <li class="flex gap-4 border-b border-[#1C1E22]/15 py-5 text-[16px] leading-[1.6] text-[#2E3035]">
                <span aria-hidden="true" class="mt-[0.35em] font-serif text-[#8C6F3F]">→</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="mt-12 grid gap-6 border-t border-[#1C1E22]/15 pt-8 text-[14px] leading-[1.75] text-[#4B4D52] md:grid-cols-2 md:gap-12">
        <p>{IV_DRIP_STANDARD_NOTES.screening}</p>
        <p>{IV_DRIP_STANDARD_NOTES.notMedicalCare}</p>
      </div>
    </div>
  </section>

  <!-- 6. Consider instead -->
  <section class="bg-[#1C1E22] px-5 py-[clamp(80px,10vw,148px)] text-[#F1EDE5] sm:px-10 lg:px-16" aria-labelledby="drip-alternatives-title">
    <div class="mx-auto max-w-[1320px]">
      <p class="iv-eyebrow">Not quite it?</p>
      <h2 id="drip-alternatives-title" class="mt-6 max-w-[720px] font-serif text-[clamp(40px,5.4vw,72px)] leading-[0.97] tracking-[-0.025em]">Consider a different bag if…</h2>
      <ul class="mt-14 grid gap-px border border-white/15 bg-white/15 md:grid-cols-3">
        {alternatives.map(({ drip: other, when }) => (
          <li class="bg-[#1C1E22]">
            <a href={ivDripPath(other.slug)} class="group block h-full p-7 transition-colors hover:bg-[#25282D] focus-visible:bg-[#25282D] sm:p-9">
              <p class="text-[15px] leading-[1.6] text-[#C8C4BC]">…{when}</p>
              <p class="mt-6 font-serif text-[clamp(24px,2.4vw,32px)] leading-[1.1] text-[#F1EDE5] transition-colors group-hover:text-[#D6C6AE]">{other.name}</p>
              <p class="mt-3 text-[11px] uppercase tracking-[0.18em] text-[#9F9483]">{other.durationMinutes} minutes · Read more</p>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-[13px] text-[#AFAAA2]">
        All six: {siblings.map((other, index) => (
          <>
            <a href={ivDripPath(other.slug)} class="border-b border-[#8C6F3F] text-[#E3D8C8] hover:text-white">{other.shortName}</a>{index < siblings.length - 1 ? ' · ' : ''}
          </>
        ))} · <a href={`${IV_DRIP_BASE_PATH}/`} class="border-b border-[#8C6F3F] text-[#E3D8C8] hover:text-white">Which IV is right for me?</a>
      </p>
    </div>
  </section>

  <ClinicalTrust />
  <ServiceFAQ faqs={drip.faqs} />
  <LocalSEOSection />
  <ServiceCTA />
  <MobileServiceCTA />
</div>
<IvPageStyles />
