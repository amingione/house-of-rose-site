---
import { sanityFetch } from '@/lib/sanity';
import { NAV_COLLECTIONS_QUERY, type NavCollection } from '@/lib/queries';
import { sbFieldPath, sbObjectId } from '@/lib/visualEditing';
import { GLOSSGENIUS_SERVICES_URL } from '@/lib/booking';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const collections = (await sanityFetch<NavCollection[]>(NAV_COLLECTIONS_QUERY)) ?? [];
const navCollections = collections.filter((collection) => collection?.slug);
const isActive = (path: string) =>
  path === '/' ? currentPath === '/' : currentPath === path || currentPath.startsWith(`${path}/`);
const linkClass = (path: string) =>
  `nav-link ${isActive(path) ? 'nav-link-active' : ''}`;
---

<header id="header" class="fixed inset-x-0 top-0 z-50 border-b border-walnut/10 bg-bone/95 backdrop-blur-md">
  <div class="mx-auto flex h-20 max-w-[1440px] items-center gap-5 px-5 sm:px-8">
    <a href="/" class="brand-link shrink-0" aria-label="House of Rose Aesthetics home">
      <img
        src="/logos/house-of-rose-monogram/hr-logo-gold.webp"
        alt=""
        width="512"
        height="520"
        class="h-12 w-auto"
      />
    </a>

    <nav class="ml-auto hidden items-center gap-1 lg:flex" aria-label="Primary navigation">
      <a href="/" class={linkClass('/')}>Home</a>

      <details class="services-menu relative">
        <summary class:list={['nav-link cursor-pointer list-none', isActive('/services') && 'nav-link-active']}>
          Services
          <svg class="menu-caret" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
            <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <div class="services-panel absolute right-0 top-[calc(100%+14px)] w-[min(920px,calc(100vw-48px))] border border-walnut/15 bg-bone p-7 shadow-[0_24px_70px_rgba(58,43,36,0.18)]">
          <div class="mb-6 flex items-end justify-between gap-6 border-b border-walnut/10 pb-5">
            <div>
              <p class="kicker mb-2">Explore care</p>
              <p class="font-serif text-[26px] text-ink">Start with the service or concern you recognize.</p>
            </div>
            <a href="/services/" class="learn-more mt-0 whitespace-nowrap">View all services</a>
          </div>
          <div class="grid max-h-[62vh] grid-cols-2 gap-x-8 gap-y-7 overflow-y-auto pr-2 xl:grid-cols-3">
            {navCollections.map((collection) => (
              <section {...sbObjectId(collection._id)}>
                <h2 class="text-[13px] font-semibold text-ink" {...sbFieldPath('title')}>
                  <a href={`/services/collections/${collection.slug}/`} class="hover:text-gold">
                    {collection.title}
                  </a>
                </h2>
                {collection.services.length > 0 && (
                  <ul class="mt-3 space-y-2">
                    {collection.services.slice(0, 6).map((service) => (
                      <li {...sbObjectId(service._id)}>
                        <a
                          href={`/services/${service.slug}/`}
                          class="text-[13px] leading-snug text-muted hover:text-ink"
                          {...sbFieldPath('title')}
                        >
                          {service.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </section>
            ))}
          </div>
        </div>
      </details>

      <a href="/skin-analysis/" class={linkClass('/skin-analysis')}>Skin analysis</a>
      <a href="/shop/" class={linkClass('/shop')}>Shop</a>
      <a href="/experience/" class={linkClass('/experience')}>Experience</a>
      <a href="/contact/" class={linkClass('/contact')}>Contact</a>
      <a
        href={GLOSSGENIUS_SERVICES_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="nav-book"
        data-global-booking
        data-cta-location="header-global"
      >
        Book
      </a>
      <button data-open-cart class="cart-button" aria-label="Open cart">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 5h2l1.5 9h8L16 7H6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="8" cy="17" r="1.2" fill="currentColor" />
          <circle cx="14" cy="17" r="1.2" fill="currentColor" />
        </svg>
        <span data-cart-count class="cart-count hidden">0</span>
      </button>
    </nav>

    <div class="ml-auto flex items-center gap-1 lg:hidden">
      <a
        href={GLOSSGENIUS_SERVICES_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="nav-book px-4"
        data-global-booking
        data-cta-location="header-mobile-global"
      >
        Book
      </a>
      <button data-open-cart class="cart-button" aria-label="Open cart">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 5h2l1.5 9h8L16 7H6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="8" cy="17" r="1.2" fill="currentColor" />
          <circle cx="14" cy="17" r="1.2" fill="currentColor" />
        </svg>
        <span data-cart-count class="cart-count hidden">0</span>
      </button>
      <button
        id="mobile-menu-button"
        type="button"
        class="menu-button"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="mobile-navigation"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div id="mobile-navigation" class="mobile-navigation hidden border-t border-walnut/10 bg-bone lg:hidden">
    <nav class="max-h-[calc(100dvh-80px)] overflow-y-auto px-5 py-5" aria-label="Mobile navigation">
      <a href="/" class="mobile-nav-link">Home</a>
      <details class="mobile-services border-y border-walnut/10 py-1">
        <summary class="mobile-nav-link cursor-pointer list-none">
          Services
          <svg class="menu-caret" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
            <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <a href="/services/" class="mb-2 ml-4 flex min-h-11 items-center text-[13px] font-semibold text-gold">View all services</a>
        <div class="grid gap-5 pb-5 pl-4 sm:grid-cols-2">
          {navCollections.map((collection) => (
            <section {...sbObjectId(collection._id)}>
              <h2 class="text-[13px] font-semibold text-ink" {...sbFieldPath('title')}>
                <a href={`/services/collections/${collection.slug}/`}>{collection.title}</a>
              </h2>
              <ul class="mt-2 space-y-2">
                {collection.services.slice(0, 6).map((service) => (
                  <li {...sbObjectId(service._id)}>
                    <a href={`/services/${service.slug}/`} class="text-[13px] text-muted" {...sbFieldPath('title')}>
                      {service.title}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </details>
      <a href="/skin-analysis/" class="mobile-nav-link">Skin analysis</a>
      <a href="/shop/" class="mobile-nav-link">Shop</a>
      <a href="/experience/" class="mobile-nav-link">Experience</a>
      <a href="/contact/" class="mobile-nav-link">Contact</a>
      <a href="/consultation/" class="mobile-nav-link">Consultation</a>
    </nav>
  </div>
</header>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileNavigation = document.getElementById('mobile-navigation');
  const servicesMenus = document.querySelectorAll<HTMLDetailsElement>('.services-menu');

  const closeMobileNavigation = (): void => {
    mobileNavigation?.classList.add('hidden');
    menuButton?.setAttribute('aria-expanded', 'false');
    menuButton?.setAttribute('aria-label', 'Open navigation');
    document.documentElement.classList.remove('menu-is-open');
  };

  menuButton?.addEventListener('click', () => {
    const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
    if (isOpen) {
      closeMobileNavigation();
      return;
    }
    mobileNavigation?.classList.remove('hidden');
    menuButton.setAttribute('aria-expanded', 'true');
    menuButton.setAttribute('aria-label', 'Close navigation');
    document.documentElement.classList.add('menu-is-open');
  });

  mobileNavigation?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a')) closeMobileNavigation();
  });

  document.addEventListener('click', (event) => {
    for (const menu of servicesMenus) {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    closeMobileNavigation();
    for (const menu of servicesMenus) menu.open = false;
  });
</script>

<style>
  .nav-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 6px;
    padding: 0 10px;
    color: #3a2b24;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .nav-link:hover,
  .nav-link-active {
    color: #5f624d;
  }
  summary::-webkit-details-marker { display: none; }
  details[open] > summary .menu-caret { transform: rotate(180deg); }
  .menu-caret { transition: transform 160ms ease; }
  .nav-book {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid #5f624d;
    background: #5f624d;
    color: #f1ede5;
    padding-inline: 18px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.03em;
  }
  .nav-book:hover { background: #4f5241; }
  .cart-button,
  .menu-button {
    position: relative;
    display: inline-flex;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    color: #3a2b24;
  }
  .cart-count {
    position: absolute;
    right: 0;
    top: 0;
    min-width: 16px;
    height: 16px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #8a6a43;
    color: #f1ede5;
    padding-inline: 4px;
    font-size: 10px;
    font-weight: 700;
  }
  .menu-button { flex-direction: column; gap: 4px; }
  .menu-button span { width: 20px; height: 1.5px; background: currentColor; }
  .mobile-nav-link {
    display: flex;
    min-height: 50px;
    align-items: center;
    justify-content: space-between;
    color: #3a2b24;
    font-size: 15px;
    font-weight: 600;
  }
  :global(html.menu-is-open) { overflow: hidden; }
  @media (prefers-reduced-motion: reduce) {
    .menu-caret { transition: none; }
  }
</style>
