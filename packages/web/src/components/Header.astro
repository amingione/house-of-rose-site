---
import { sanityFetch } from '@/lib/sanity';
import { PUBLIC_PROVIDERS_QUERY, type PublicProviderProfile } from '@/lib/queries';
import { sbFieldPath, sbObjectId } from '@/lib/visualEditing';
import { resolvePublicProviderProfiles } from '@/lib/aboutFallbacks';
import { SHOP_ENABLED } from '@/lib/features';
import type { PublicSiteFacts } from '@/lib/publicSiteFacts';

interface Props {
  currentPath?: string;
  siteFacts: PublicSiteFacts;
}

const { currentPath = '/', siteFacts } = Astro.props;
const sanityProviders = await sanityFetch<PublicProviderProfile[]>(PUBLIC_PROVIDERS_QUERY);
const aboutProviders = resolvePublicProviderProfiles(sanityProviders);
const sanityProviderIds = new Set(sanityProviders.map((provider) => provider._id));
const isActive = (path: string) =>
  path === '/' ? currentPath === '/' : currentPath === path || currentPath.startsWith(`${path}/`);
const linkClass = (path: string) =>
  `nav-link ${isActive(path) ? 'nav-link-active' : ''}`;
---

<!-- Editorial chrome: hairline rule, centered serif wordmark, and uppercase
     letter-spaced navigation. Desktop remains 80px for existing sticky offsets;
     mobile uses the reference's tighter 64px shell. -->
<header id="header" class="fixed inset-x-0 top-0 z-50 bg-bone/95 shadow-[0_1px_0_0_var(--color-line)] backdrop-blur-md">
  <div class="relative mx-auto flex h-16 max-w-[1440px] items-center justify-center px-5 sm:h-20 sm:px-8">
    <div class="absolute left-5 flex items-center gap-4 sm:left-8 lg:gap-7">
      <button
        id="mobile-menu-button"
        type="button"
        class="menu-button inline-flex lg:hidden"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="mobile-navigation"
      >
        <span></span><span></span>
      </button>

      <nav class="hidden items-center gap-6 lg:flex" aria-label="Primary navigation">
        <a href="/services/" class={linkClass('/services')} aria-current={isActive('/services') ? 'page' : undefined}>Treatments</a>
        <a href="/skin-analysis/" class={linkClass('/skin-analysis')} aria-current={isActive('/skin-analysis') ? 'page' : undefined}>Skin analysis</a>
        {SHOP_ENABLED && <a href="/shop/" class={linkClass('/shop')} aria-current={isActive('/shop') ? 'page' : undefined}>Shop</a>}
        <details class="about-menu desktop-menu relative">
          <summary class:list={['nav-link cursor-pointer list-none', isActive('/about') && 'nav-link-active']}>
            About
            <svg class="menu-caret" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
              <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <div class="about-panel absolute left-0 top-[calc(100%+18px)] w-[420px] border border-line bg-paper p-7 shadow-[0_24px_70px_rgba(22,20,18,0.16)]">
            <a href="/about/" class="group block border-b border-line pb-5">
              <p class="text-kicker font-medium uppercase tracking-label text-gold">About</p>
              <p class="mt-2.5 font-display text-[22px] leading-none text-ink group-hover:text-gold">{siteFacts.shortName}</p>
            </a>
            <div class="grid grid-cols-[0.78fr_1.22fr] gap-7 pt-5">
              <a href="/about/hra/" class="group block">
                <p class="text-[12px] font-semibold text-ink group-hover:text-gold">The practice</p>
                <p class="mt-2 text-[12px] leading-relaxed text-muted">{siteFacts.shortName} in Punta Gorda.</p>
              </a>
              <section aria-label="Providers">
                <p class="text-[12px] font-semibold text-ink">
                  <a href="/about/providers/" class="hover:text-gold">Providers</a>
                </p>
                <ul class="mt-3 space-y-2.5">
                  {aboutProviders.map((provider) => (
                    <li {...(sanityProviderIds.has(provider._id) ? sbObjectId(provider._id) : {})}>
                      <a href={`/about/providers/${provider.slug}/`} class="text-[12px] leading-snug text-muted hover:text-ink" {...sbFieldPath('publicName')}>
                        {provider.publicName}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            </div>
          </div>
        </details>
      </nav>
    </div>

    <a href="/" class="brand-link flex flex-col items-center text-center" aria-label={`${siteFacts.siteName} home`}>
      <span class="font-display text-lg leading-none text-ink sm:text-2xl">{siteFacts.shortName}</span>
      <span class="mt-1.5 text-kicker font-medium uppercase tracking-label text-muted">Aesthetics</span>
    </a>

    <div class="absolute right-5 flex items-center gap-2 sm:right-8">
      {SHOP_ENABLED && (
        <button data-open-cart class="cart-button" aria-label="Open cart">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M3 5h2l1.5 9h8L16 7H6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="8" cy="17" r="1.2" fill="currentColor" />
            <circle cx="14" cy="17" r="1.2" fill="currentColor" />
          </svg>
          <span data-cart-count class="cart-count hidden">0</span>
        </button>
      )}
      <a href="/contact/" class="nav-book hidden sm:inline-flex">Get in touch</a>
      <a href="/contact/" class="nav-mobile-contact hidden min-[360px]:inline-flex sm:hidden">Contact</a>
    </div>
  </div>

  <div id="mobile-navigation" class="mobile-navigation absolute inset-x-0 top-full hidden h-[calc(100dvh-64px)] border-t border-line bg-bone sm:h-[calc(100dvh-80px)] lg:hidden" aria-label="Site navigation" aria-hidden="true">
    <nav class="flex h-full flex-col overflow-y-auto px-6 pb-8 pt-9 sm:px-8" aria-label="Mobile navigation">
      <a href="/" class:list={['mobile-nav-link border-t border-line', isActive('/') && 'mobile-nav-link-active']} aria-current={isActive('/') ? 'page' : undefined}>Home</a>
      <a href="/services/" class:list={['mobile-nav-link border-y border-line', isActive('/services') && 'mobile-nav-link-active']} aria-current={isActive('/services') ? 'page' : undefined}>Treatments</a>
      <a href="/skin-analysis/" class:list={['mobile-nav-link', isActive('/skin-analysis') && 'mobile-nav-link-active']} aria-current={isActive('/skin-analysis') ? 'page' : undefined}>Skin analysis</a>
      {SHOP_ENABLED && <a href="/shop/" class:list={['mobile-nav-link', isActive('/shop') && 'mobile-nav-link-active']} aria-current={isActive('/shop') ? 'page' : undefined}>Shop</a>}
      <details class="mobile-about border-y border-line">
        <summary class:list={['mobile-nav-link cursor-pointer list-none', isActive('/about') && 'mobile-nav-link-active']}>
          About
          <svg class="menu-caret" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
            <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <div class="pb-5 pl-4">
          <a href="/about/" class="flex min-h-11 items-center text-[13px] font-semibold text-gold">About House of Rose</a>
          <a href="/about/hra/" class="flex min-h-11 items-center text-[13px] font-semibold text-ink">The practice</a>
          <a href="/about/providers/" class="flex min-h-11 items-center text-[13px] font-semibold text-ink">Providers</a>
          <ul class="ml-4 border-l border-line pl-4">
            {aboutProviders.map((provider) => (
              <li {...(sanityProviderIds.has(provider._id) ? sbObjectId(provider._id) : {})}>
                <a href={`/about/providers/${provider.slug}/`} class="flex min-h-10 items-center text-[13px] leading-snug text-muted" {...sbFieldPath('publicName')}>
                  {provider.publicName}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </details>
      <a href="/consultation/" class:list={['mobile-nav-link border-y border-line', isActive('/consultation') && 'mobile-nav-link-active']} aria-current={isActive('/consultation') ? 'page' : undefined}>Consultation</a>
      <div class="mt-auto pt-10 text-[13px] leading-[1.7] text-muted">
        <p>{siteFacts.address}</p>
        <a href={`tel:${siteFacts.phone.replace(/[^\d+]/g, '')}`} class="mt-2 inline-flex text-ink underline decoration-line-strong underline-offset-4">{siteFacts.phone}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileNavigation = document.getElementById('mobile-navigation');
  const desktopMenus = document.querySelectorAll<HTMLDetailsElement>('.desktop-menu');
  const mobileMenus = document.querySelectorAll<HTMLDetailsElement>('#mobile-navigation details');
  const pageContent = document.getElementById('main-content');
  const pageFooter = document.querySelector<HTMLElement>('body > footer');
  let lastFocusedHeaderElement: HTMLElement | null = null;

  document.getElementById('header')?.addEventListener('focusin', (event) => {
    if (event.target instanceof HTMLElement) lastFocusedHeaderElement = event.target;
  });

  const setBackgroundInert = (inert: boolean): void => {
    if (pageContent) pageContent.inert = inert;
    if (pageFooter) pageFooter.inert = inert;
  };

  const visibleMobileControls = (): HTMLElement[] => Array.from(
    document.querySelectorAll<HTMLElement>(
      '#header a[href], #header button:not([disabled]), #header summary',
    ),
  ).filter((element) => element.getClientRects().length > 0 && element.getAttribute('aria-hidden') !== 'true');

  const closeMobileNavigation = (restoreFocus = false): void => {
    const wasOpen = menuButton?.getAttribute('aria-expanded') === 'true';
    mobileNavigation?.classList.add('hidden');
    mobileNavigation?.setAttribute('aria-hidden', 'true');
    menuButton?.setAttribute('aria-expanded', 'false');
    menuButton?.setAttribute('aria-label', 'Open navigation');
    document.documentElement.classList.remove('menu-is-open');
    setBackgroundInert(false);
    for (const menu of mobileMenus) menu.open = false;
    if (restoreFocus && wasOpen) menuButton?.focus();
  };

  menuButton?.addEventListener('click', () => {
    const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
    if (isOpen) {
      closeMobileNavigation();
      return;
    }
    mobileNavigation?.classList.remove('hidden');
    mobileNavigation?.setAttribute('aria-hidden', 'false');
    menuButton.setAttribute('aria-expanded', 'true');
    menuButton.setAttribute('aria-label', 'Close navigation');
    document.documentElement.classList.add('menu-is-open');
    setBackgroundInert(true);
    mobileNavigation?.querySelector<HTMLElement>('a[href], summary')?.focus();
  });

  mobileNavigation?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a')) closeMobileNavigation();
  });

  document.addEventListener('click', (event) => {
    for (const menu of desktopMenus) {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    }
  });

  for (const menu of desktopMenus) {
    menu.addEventListener('toggle', () => {
      if (!menu.open) return;
      for (const other of desktopMenus) {
        if (other !== menu) other.open = false;
      }
    });
  }

  for (const menu of mobileMenus) {
    menu.addEventListener('toggle', () => {
      if (!menu.open) return;
      for (const other of mobileMenus) {
        if (other !== menu) other.open = false;
      }
    });
  }

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Tab' && menuButton?.getAttribute('aria-expanded') === 'true') {
      const controls = visibleMobileControls();
      const first = controls.at(0);
      const last = controls.at(-1);
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
      return;
    }
    if (event.key !== 'Escape') return;
    const openDesktopMenu = Array.from(desktopMenus).find((menu) => menu.open);
    closeMobileNavigation(true);
    if (openDesktopMenu) {
      openDesktopMenu.open = false;
      openDesktopMenu.querySelector<HTMLElement>('summary')?.focus();
    }
  });

  window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
    const currentActiveElement = document.activeElement instanceof HTMLElement
      ? document.activeElement
      : null;
    const menuWasOpen = event.matches
      ? menuButton?.getAttribute('aria-expanded') === 'true'
      : Array.from(desktopMenus).some((menu) => menu.open);
    const activeElement = currentActiveElement === document.body && menuWasOpen
      ? lastFocusedHeaderElement
      : currentActiveElement;

    if (event.matches) {
      const focusWasInMobileNavigation = Boolean(
        activeElement && (mobileNavigation?.contains(activeElement) || activeElement === menuButton),
      );
      const focusedHref = activeElement instanceof HTMLAnchorElement
        ? activeElement.getAttribute('href')
        : null;
      const focusedMobileMenu = activeElement?.closest<HTMLDetailsElement>('#mobile-navigation details');

      closeMobileNavigation();

      if (focusWasInMobileNavigation) {
        const matchingLink = focusedHref
          ? Array.from(document.querySelectorAll<HTMLAnchorElement>('#header a[href]')).find(
            (link) => link.getAttribute('href') === focusedHref && link.getClientRects().length > 0,
          )
          : null;
        const matchingSummary = focusedMobileMenu?.classList.contains('mobile-about')
          ? document.querySelector<HTMLElement>('.about-menu > summary')
          : null;
        (matchingLink ?? matchingSummary ?? document.querySelector<HTMLElement>('.brand-link'))?.focus();
      }
      return;
    }

    const focusWasInDesktopMenu = Boolean(
      activeElement && Array.from(desktopMenus).some((menu) => menu.contains(activeElement)),
    );
    for (const menu of desktopMenus) menu.open = false;
    if (focusWasInDesktopMenu) menuButton?.focus();
  });
</script>

<style>
  /* Nav sits in the left cluster beside the monogram, so tracking is dialled
     back from the 0.28em label standard to 0.18em — at 0.28em the five items
     collide with the centred wordmark once Shop is enabled. */
  .nav-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 6px;
    color: var(--color-ink);
    font-size: var(--text-kicker);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    transition: color var(--duration-quick) var(--ease-out-soft),
      opacity var(--duration-quick) var(--ease-out-soft);
  }
  .nav-link:hover { opacity: 0.55; }
  .nav-link-active {
    color: var(--color-rose);
    box-shadow: inset 0 -1px var(--color-rose);
  }
  .nav-link-active:hover { opacity: 1; }
  summary::-webkit-details-marker { display: none; }
  details[open] > summary .menu-caret { transform: rotate(180deg); }
  .menu-caret { transition: transform 160ms ease; }

  /* The header action mirrors the reference's quiet ink block. Rose remains
     the state/accent color rather than competing with the centered wordmark. */
  .nav-book {
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-ink);
    background: var(--color-ink);
    color: var(--color-ivory);
    padding-inline: 20px;
    font-size: var(--text-kicker);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    transition: opacity var(--duration-quick) var(--ease-out-soft);
  }
  .nav-book:hover { opacity: 0.8; }

  .nav-mobile-contact {
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding-inline: 4px;
    color: var(--color-ink);
    font-size: var(--text-kicker);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .cart-button { display: inline-flex; }
  .cart-button,
  .menu-button {
    position: relative;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    color: var(--color-ink);
  }
  .menu-button { justify-content: flex-start; }
  .cart-count {
    position: absolute;
    right: 0;
    top: 0;
    min-width: 16px;
    height: 16px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-ivory);
    padding-inline: 4px;
    font-size: 10px;
    font-weight: 700;
  }
  .menu-button { flex-direction: column; gap: 6px; }
  .menu-button span {
    width: 24px;
    height: 1px;
    background: currentColor;
    transition: opacity 160ms ease, transform 160ms ease;
  }
  /* Uneven rules at rest — the hra-grok mark — snapping to an even X on open. */
  .menu-button span:last-child { width: 16px; }
  .menu-button[aria-expanded="true"] span:first-child { transform: translateY(3.5px) rotate(45deg); }
  .menu-button[aria-expanded="true"] span:last-child {
    width: 24px;
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .mobile-nav-link {
    display: flex;
    min-height: 64px;
    align-items: center;
    justify-content: space-between;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(2rem, 9vw, 3rem);
    letter-spacing: var(--tracking-display);
    line-height: 1;
    text-transform: uppercase;
  }
  .mobile-nav-link-active { color: var(--color-rose); }
  .mobile-sub-link {
    display: flex;
    min-height: 44px;
    align-items: center;
    color: var(--color-ink);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .mobile-provider-link {
    display: flex;
    min-height: 40px;
    align-items: center;
    color: var(--color-muted);
    font-size: 13px;
    line-height: 1.3;
  }
  :global(html.menu-is-open) { overflow: hidden; }
  @media (prefers-reduced-motion: reduce) {
    .menu-caret,
    .menu-button span { transition: none; }
  }
</style>
