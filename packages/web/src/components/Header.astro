---
import { sanityFetch } from '@/lib/sanity';
import { PUBLIC_PROVIDERS_QUERY, type PublicProviderProfile } from '@/lib/queries';
import { sbFieldPath, sbObjectId } from '@/lib/visualEditing';
import { resolvePublicProviderProfiles } from '@/lib/aboutFallbacks';
import { SHOP_ENABLED } from '@/lib/features';
import type { PublicSiteFacts } from '@/lib/publicSiteFacts';

interface Props {
  currentPath?: string;
  siteFacts: PublicSiteFacts;
}

const { currentPath = '/', siteFacts } = Astro.props;
const sanityProviders = await sanityFetch<PublicProviderProfile[]>(PUBLIC_PROVIDERS_QUERY);
const aboutProviders = resolvePublicProviderProfiles(sanityProviders);
const sanityProviderIds = new Set(sanityProviders.map((provider) => provider._id));
const isActive = (path: string) =>
  path === '/' ? currentPath === '/' : currentPath === path || currentPath.startsWith(`${path}/`);
const linkClass = (path: string) =>
  `nav-link ${isActive(path) ? 'nav-link-active' : ''}`;
---

<header id="header" class="fixed inset-x-0 top-0 z-50 border-b border-ivory/10 bg-soft-black/95 backdrop-blur-md">
  <div class="mx-auto flex h-20 max-w-[1440px] items-center gap-5 px-5 sm:px-8">
    <a href="/" class="brand-link shrink-0" aria-label={`${siteFacts.siteName} home`}>
      <img
        src="/logos/house-of-rose-monogram/hr-logo-gold.webp"
        alt=""
        width="512"
        height="520"
        class="h-12 w-auto"
      />
    </a>

    <nav class="ml-auto hidden items-center gap-1 lg:flex" aria-label="Primary navigation">
      <a href="/services/" class={linkClass('/services')} aria-current={isActive('/services') ? 'page' : undefined}>Treatments</a>

      <a href="/skin-analysis/" class={linkClass('/skin-analysis')} aria-current={isActive('/skin-analysis') ? 'page' : undefined}>Skin analysis</a>
      {SHOP_ENABLED && <a href="/shop/" class={linkClass('/shop')} aria-current={isActive('/shop') ? 'page' : undefined}>Shop</a>}
      <details class="about-menu desktop-menu relative">
        <summary class:list={['nav-link cursor-pointer list-none', isActive('/about') && 'nav-link-active']}>
          About
          <svg class="menu-caret" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
            <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <div class="about-panel absolute right-0 top-[calc(100%+14px)] w-[420px] border border-ivory/15 bg-bone p-7 shadow-[0_24px_70px_rgba(0,0,0,0.52)]">
          <a href="/about/" class="group block border-b border-ivory/10 pb-5">
            <p class="text-[12px] font-semibold uppercase tracking-[0.12em] text-gold">About</p>
            <p class="mt-2 font-serif text-[25px] text-ink group-hover:text-gold">{siteFacts.shortName}</p>
          </a>
          <div class="grid grid-cols-[0.78fr_1.22fr] gap-7 pt-5">
            <a href="/about/hra/" class="group block">
              <p class="text-[12px] font-semibold text-ink group-hover:text-gold">The practice</p>
              <p class="mt-2 text-[12px] leading-relaxed text-muted">{siteFacts.shortName} in Punta Gorda.</p>
            </a>
            <section aria-label="Providers">
              <p class="text-[12px] font-semibold text-ink">
                <a href="/about/providers/" class="hover:text-gold">Providers</a>
              </p>
              <ul class="mt-3 space-y-2.5">
                {aboutProviders.map((provider) => (
                  <li {...(sanityProviderIds.has(provider._id) ? sbObjectId(provider._id) : {})}>
                    <a href={`/about/providers/${provider.slug}/`} class="text-[12px] leading-snug text-muted hover:text-ink" {...sbFieldPath('publicName')}>
                      {provider.publicName}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          </div>
        </div>
      </details>
      <a href="/contact/" class={linkClass('/contact')} aria-current={isActive('/contact') ? 'page' : undefined}>Contact</a>
      <a href="/contact/" class="nav-book">Get in touch</a>
      {SHOP_ENABLED && (
        <button data-open-cart class="cart-button" aria-label="Open cart">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M3 5h2l1.5 9h8L16 7H6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="8" cy="17" r="1.2" fill="currentColor" />
            <circle cx="14" cy="17" r="1.2" fill="currentColor" />
          </svg>
          <span data-cart-count class="cart-count hidden">0</span>
        </button>
      )}
    </nav>

    <div class="ml-auto flex items-center gap-1 lg:hidden">
      <a href="/contact/" class="nav-book px-4">Contact</a>
      {SHOP_ENABLED && (
        <button data-open-cart class="cart-button" aria-label="Open cart">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M3 5h2l1.5 9h8L16 7H6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="8" cy="17" r="1.2" fill="currentColor" />
            <circle cx="14" cy="17" r="1.2" fill="currentColor" />
          </svg>
          <span data-cart-count class="cart-count hidden">0</span>
        </button>
      )}
      <button
        id="mobile-menu-button"
        type="button"
        class="menu-button"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="mobile-navigation"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div id="mobile-navigation" class="mobile-navigation hidden border-t border-ivory/10 bg-bone lg:hidden" aria-label="Site navigation" aria-hidden="true">
    <nav class="max-h-[calc(100dvh-80px)] overflow-y-auto px-5 py-5" aria-label="Mobile navigation">
      <a href="/" class:list={['mobile-nav-link', isActive('/') && 'mobile-nav-link-active']} aria-current={isActive('/') ? 'page' : undefined}>Home</a>
      <a href="/services/" class:list={['mobile-nav-link border-y border-ivory/10', isActive('/services') && 'mobile-nav-link-active']} aria-current={isActive('/services') ? 'page' : undefined}>Treatments</a>
      <a href="/skin-analysis/" class:list={['mobile-nav-link', isActive('/skin-analysis') && 'mobile-nav-link-active']} aria-current={isActive('/skin-analysis') ? 'page' : undefined}>Skin analysis</a>
      {SHOP_ENABLED && <a href="/shop/" class:list={['mobile-nav-link', isActive('/shop') && 'mobile-nav-link-active']} aria-current={isActive('/shop') ? 'page' : undefined}>Shop</a>}
      <details class="mobile-about border-b border-ivory/10 py-1">
        <summary class:list={['mobile-nav-link cursor-pointer list-none', isActive('/about') && 'mobile-nav-link-active']}>
          About
          <svg class="menu-caret" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
            <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <div class="pb-5 pl-4">
          <a href="/about/" class="flex min-h-11 items-center text-[13px] font-semibold text-gold">About index</a>
          <a href="/about/hra/" class="flex min-h-11 items-center text-[13px] font-semibold text-ink">The practice</a>
          <a href="/about/providers/" class="flex min-h-11 items-center text-[13px] font-semibold text-ink">Providers</a>
          <ul class="ml-4 border-l border-ivory/15 pl-4">
            {aboutProviders.map((provider) => (
              <li {...(sanityProviderIds.has(provider._id) ? sbObjectId(provider._id) : {})}>
                <a href={`/about/providers/${provider.slug}/`} class="flex min-h-10 items-center text-[13px] leading-snug text-muted" {...sbFieldPath('publicName')}>
                  {provider.publicName}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </details>
      <a href="/contact/" class:list={['mobile-nav-link', isActive('/contact') && 'mobile-nav-link-active']} aria-current={isActive('/contact') ? 'page' : undefined}>Contact</a>
      <a href="/consultation/" class:list={['mobile-nav-link', isActive('/consultation') && 'mobile-nav-link-active']} aria-current={isActive('/consultation') ? 'page' : undefined}>Consultation</a>
    </nav>
  </div>
</header>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileNavigation = document.getElementById('mobile-navigation');
  const desktopMenus = document.querySelectorAll<HTMLDetailsElement>('.desktop-menu');
  const mobileMenus = document.querySelectorAll<HTMLDetailsElement>('#mobile-navigation details');
  const pageContent = document.getElementById('main-content');
  const pageFooter = document.querySelector<HTMLElement>('body > footer');
  let lastFocusedHeaderElement: HTMLElement | null = null;

  document.getElementById('header')?.addEventListener('focusin', (event) => {
    if (event.target instanceof HTMLElement) lastFocusedHeaderElement = event.target;
  });

  const setBackgroundInert = (inert: boolean): void => {
    if (pageContent) pageContent.inert = inert;
    if (pageFooter) pageFooter.inert = inert;
  };

  const visibleMobileControls = (): HTMLElement[] => Array.from(
    document.querySelectorAll<HTMLElement>(
      '#header a[href], #header button:not([disabled]), #header summary',
    ),
  ).filter((element) => element.getClientRects().length > 0 && element.getAttribute('aria-hidden') !== 'true');

  const closeMobileNavigation = (restoreFocus = false): void => {
    const wasOpen = menuButton?.getAttribute('aria-expanded') === 'true';
    mobileNavigation?.classList.add('hidden');
    mobileNavigation?.setAttribute('aria-hidden', 'true');
    menuButton?.setAttribute('aria-expanded', 'false');
    menuButton?.setAttribute('aria-label', 'Open navigation');
    document.documentElement.classList.remove('menu-is-open');
    setBackgroundInert(false);
    for (const menu of mobileMenus) menu.open = false;
    if (restoreFocus && wasOpen) menuButton?.focus();
  };

  menuButton?.addEventListener('click', () => {
    const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
    if (isOpen) {
      closeMobileNavigation();
      return;
    }
    mobileNavigation?.classList.remove('hidden');
    mobileNavigation?.setAttribute('aria-hidden', 'false');
    menuButton.setAttribute('aria-expanded', 'true');
    menuButton.setAttribute('aria-label', 'Close navigation');
    document.documentElement.classList.add('menu-is-open');
    setBackgroundInert(true);
    mobileNavigation?.querySelector<HTMLElement>('a[href], summary')?.focus();
  });

  mobileNavigation?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a')) closeMobileNavigation();
  });

  document.addEventListener('click', (event) => {
    for (const menu of desktopMenus) {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    }
  });

  for (const menu of desktopMenus) {
    menu.addEventListener('toggle', () => {
      if (!menu.open) return;
      for (const other of desktopMenus) {
        if (other !== menu) other.open = false;
      }
    });
  }

  for (const menu of mobileMenus) {
    menu.addEventListener('toggle', () => {
      if (!menu.open) return;
      for (const other of mobileMenus) {
        if (other !== menu) other.open = false;
      }
    });
  }

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Tab' && menuButton?.getAttribute('aria-expanded') === 'true') {
      const controls = visibleMobileControls();
      const first = controls.at(0);
      const last = controls.at(-1);
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
      return;
    }
    if (event.key !== 'Escape') return;
    const openDesktopMenu = Array.from(desktopMenus).find((menu) => menu.open);
    closeMobileNavigation(true);
    if (openDesktopMenu) {
      openDesktopMenu.open = false;
      openDesktopMenu.querySelector<HTMLElement>('summary')?.focus();
    }
  });

  window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
    const currentActiveElement = document.activeElement instanceof HTMLElement
      ? document.activeElement
      : null;
    const menuWasOpen = event.matches
      ? menuButton?.getAttribute('aria-expanded') === 'true'
      : Array.from(desktopMenus).some((menu) => menu.open);
    const activeElement = currentActiveElement === document.body && menuWasOpen
      ? lastFocusedHeaderElement
      : currentActiveElement;

    if (event.matches) {
      const focusWasInMobileNavigation = Boolean(
        activeElement && (mobileNavigation?.contains(activeElement) || activeElement === menuButton),
      );
      const focusedHref = activeElement instanceof HTMLAnchorElement
        ? activeElement.getAttribute('href')
        : null;
      const focusedMobileMenu = activeElement?.closest<HTMLDetailsElement>('#mobile-navigation details');

      closeMobileNavigation();

      if (focusWasInMobileNavigation) {
        const matchingLink = focusedHref
          ? Array.from(document.querySelectorAll<HTMLAnchorElement>('#header a[href]')).find(
            (link) => link.getAttribute('href') === focusedHref && link.getClientRects().length > 0,
          )
          : null;
        const matchingSummary = focusedMobileMenu?.classList.contains('mobile-about')
          ? document.querySelector<HTMLElement>('.about-menu > summary')
          : null;
        (matchingLink ?? matchingSummary ?? document.querySelector<HTMLElement>('.brand-link'))?.focus();
      }
      return;
    }

    const focusWasInDesktopMenu = Boolean(
      activeElement && Array.from(desktopMenus).some((menu) => menu.contains(activeElement)),
    );
    for (const menu of desktopMenus) menu.open = false;
    if (focusWasInDesktopMenu) menuButton?.focus();
  });
</script>

<style>
  .nav-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 6px;
    padding: 0 10px;
    color: #f1ede5;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .nav-link:hover,
  .nav-link-active {
    color: #e2d3b2;
    box-shadow: inset 0 -1px #8a6a43;
  }
  summary::-webkit-details-marker { display: none; }
  details[open] > summary .menu-caret { transform: rotate(180deg); }
  .menu-caret { transition: transform 160ms ease; }
  .nav-book {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid #5f624d;
    background: #5f624d;
    color: #f1ede5;
    padding-inline: 18px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.03em;
  }
  .nav-book:hover { background: #4f5241; }
  .cart-button,
  .menu-button {
    position: relative;
    display: inline-flex;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    color: #f1ede5;
  }
  .cart-count {
    position: absolute;
    right: 0;
    top: 0;
    min-width: 16px;
    height: 16px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #8a6a43;
    color: #f1ede5;
    padding-inline: 4px;
    font-size: 10px;
    font-weight: 700;
  }
  .menu-button { flex-direction: column; gap: 4px; }
  .menu-button span {
    width: 20px;
    height: 1.5px;
    background: currentColor;
    transition: opacity 160ms ease, transform 160ms ease;
  }
  .menu-button[aria-expanded="true"] span:first-child { transform: translateY(5.5px) rotate(45deg); }
  .menu-button[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .menu-button[aria-expanded="true"] span:last-child { transform: translateY(-5.5px) rotate(-45deg); }
  .mobile-nav-link {
    display: flex;
    min-height: 50px;
    align-items: center;
    justify-content: space-between;
    color: #f1ede5;
    font-size: 15px;
    font-weight: 600;
  }
  .mobile-nav-link-active { color: #e2d3b2; }
  :global(html.menu-is-open) { overflow: hidden; }
  @media (prefers-reduced-motion: reduce) {
    .menu-caret,
    .menu-button span { transition: none; }
  }
</style>
