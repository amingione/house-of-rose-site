---
/**
 * Header component with sticky navigation
 * Matches the mockup's design with transparent-to-solid transition on scroll
 */

interface Props {
	currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const isActive = (path: string) =>
	currentPath === path || currentPath.startsWith(path + "/");
---

<header
	id="header"
	class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
	<div
		class="max-w-[1280px] mx-auto px-6 h-20 flex items-center justify-between"
	>
		<!-- Brand Logo -->
		<a href="/" class="brand-link flex items-center">
			<img
				src="/logos/house-of-rose-monogram/hr-logo-gold.webp"
				alt="House of Rose"
				class="h-14 md:h-16 w-auto transition-all duration-300"
				width="512"
				height="520"
			/>
		</a>

		<!-- Desktop Navigation -->
		<nav class="desktop-nav hidden md:flex items-center gap-6">
			<a
				href="/"
				class={`nav-link text-[11px] tracking-[0.2em] uppercase transition-colors duration-200 ${
					isActive("/")
						? "text-gold"
						: "text-white/90 hover:text-gold"
				}`}
			>
				Home
			</a>
			<a
				href="/services/"
				class={`nav-link text-[11px] tracking-[0.2em] uppercase transition-colors duration-200 ${
					isActive("/services")
						? "text-gold"
						: "text-white/90 hover:text-gold"
				}`}
			>
				Services
			</a>
			<a
				href="/memberships/"
				class={`nav-link text-[11px] tracking-[0.2em] uppercase transition-colors duration-200 ${
					isActive("/memberships")
						? "text-gold"
						: "text-white/90 hover:text-gold"
				}`}
			>
				Memberships
			</a>
			<a
				href="/plans/"
				class={`nav-link text-[11px] tracking-[0.2em] uppercase transition-colors duration-200 ${
					isActive("/plans")
						? "text-gold"
						: "text-white/90 hover:text-gold"
				}`}
			>
				Plans
			</a>
			<a
				href="/shop/"
				class={`nav-link text-[11px] tracking-[0.2em] uppercase transition-colors duration-200 ${
					isActive("/shop")
						? "text-gold"
						: "text-white/90 hover:text-gold"
				}`}
			>
				Shop
			</a>
			<a
				href="/experience/"
				class={`nav-link text-[11px] tracking-[0.2em] uppercase transition-colors duration-200 ${
					isActive("/experience")
						? "text-gold"
						: "text-white/90 hover:text-gold"
				}`}
			>
				Experience
			</a>
			<a
				href="/blog/"
				class={`nav-link text-[11px] tracking-[0.2em] uppercase transition-colors duration-200 ${
					isActive("/blog")
						? "text-gold"
						: "text-white/90 hover:text-gold"
				}`}
			>
				Journal
			</a>
			<a
				href="/contact/"
				class={`nav-link text-[11px] tracking-[0.2em] uppercase transition-colors duration-200 ${
					isActive("/contact")
						? "text-gold"
						: "text-white/90 hover:text-gold"
				}`}
			>
				Contact
			</a>
			<a
				href="/rent-a-room/"
				class={`nav-link text-[11px] tracking-[0.2em] uppercase transition-colors duration-200 ${
					isActive("/rent-a-room")
						? "text-gold"
						: "text-white/90 hover:text-gold"
				}`}
			>
				Rent a Suite
			</a>
			<a
				href="https://houseofrose.glossgenius.com/services"
				target="_blank"
				rel="noopener noreferrer"
				class="nav-cta text-[11px] tracking-[0.2em] uppercase px-5 py-2 border border-white/80 text-white transition-all duration-300 hover:bg-gold hover:border-gold hover:text-black"
			>
				Book Now
			</a>
		</nav>

		<!-- Mobile Menu Button -->
		<button
			id="mobile-menu-btn"
			class="md:hidden flex flex-col gap-1 p-1.5 min-w-[36px] min-h-[36px] items-center justify-center relative ml-auto"
			aria-label="Toggle menu"
		>
			<span
				class="menu-line block w-4 h-px bg-white transition-all duration-300"
			></span>
			<span
				class="menu-line block w-4 h-px bg-white transition-all duration-300"
			></span>
			<span
				class="menu-line block w-4 h-px bg-white transition-all duration-300"
			></span>
		</button>
	</div>

	<!-- Mobile Drawer -->
	<div
		id="mobile-drawer"
		class="hidden md:hidden bg-charcoal-light/98 border-t border-gold/10 py-6"
	>
		<nav class="flex flex-col items-center">
			<a
				href="/"
				class="mobile-nav-link text-[13px] tracking-[0.22em] uppercase text-white/75 py-3 w-full text-center min-h-[48px] flex items-center justify-center"
			>
				Home
			</a>
			<a
				href="/services/"
				class="mobile-nav-link text-[13px] tracking-[0.22em] uppercase text-white/75 py-3 w-full text-center min-h-[48px] flex items-center justify-center"
			>
				Services
			</a>
			<a
				href="/memberships/"
				class="mobile-nav-link text-[13px] tracking-[0.22em] uppercase text-white/75 py-3 w-full text-center min-h-[48px] flex items-center justify-center"
			>
				Memberships
			</a>
			<a
				href="/plans/"
				class="mobile-nav-link text-[13px] tracking-[0.22em] uppercase text-white/75 py-3 w-full text-center min-h-[48px] flex items-center justify-center"
			>
				Plans
			</a>
			<a
				href="/shop/"
				class="mobile-nav-link text-[13px] tracking-[0.22em] uppercase text-white/75 py-3 w-full text-center min-h-[48px] flex items-center justify-center"
			>
				Shop
			</a>
			<a
				href="/experience/"
				class="mobile-nav-link text-[13px] tracking-[0.22em] uppercase text-white/75 py-3 w-full text-center min-h-[48px] flex items-center justify-center"
			>
				Experience
			</a>
			<a
				href="/blog/"
				class="mobile-nav-link text-[13px] tracking-[0.22em] uppercase text-white/75 py-3 w-full text-center min-h-[48px] flex items-center justify-center"
			>
				Journal
			</a>
			<a
				href="/contact/"
				class="mobile-nav-link text-[13px] tracking-[0.22em] uppercase text-white/75 py-3 w-full text-center min-h-[48px] flex items-center justify-center"
			>
				Contact
			</a>
			<a
				href="/rent-a-room/"
				class="mobile-nav-link text-[13px] tracking-[0.22em] uppercase text-white/75 py-3 w-full text-center min-h-[48px] flex items-center justify-center"
			>
				Rent a Suite
			</a>
			<a
				href="https://houseofrose.glossgenius.com/services"
				target="_blank"
				rel="noopener noreferrer"
				class="mobile-cta text-[11px] tracking-[0.2em] uppercase px-6 py-3 border border-gold text-gold mt-1.5 min-h-[48px] inline-flex items-center"
			>
				Book Now
			</a>
		</nav>
	</div>
</header>

<script>
	// Sticky header behavior
	const header = document.getElementById("header");
	const mobileMenuBtn = document.getElementById("mobile-menu-btn");
	const mobileDrawer = document.getElementById("mobile-drawer");

	window.addEventListener("scroll", () => {
		const currentScroll = window.pageYOffset;

		if (currentScroll > 60) {
			header?.classList.add("stuck");
		} else {
			header?.classList.remove("stuck");
		}
	});

	// Mobile menu toggle
	mobileMenuBtn?.addEventListener("click", () => {
		const isOpen = mobileDrawer?.classList.contains("open");
		if (isOpen) {
			mobileDrawer?.classList.remove("open");
			mobileDrawer?.classList.add("hidden");
			mobileMenuBtn?.classList.remove("open");
		} else {
			mobileDrawer?.classList.remove("hidden");
			mobileDrawer?.classList.add("open");
			mobileMenuBtn?.classList.add("open");
		}
	});
</script>

<style>
	#header {
		background: transparent;
	}

	#header.stuck {
		@apply bg-charcoal/95 backdrop-blur-sm shadow-lg;
	}

	#header.stuck .brand-link img {
		@apply h-16 md:h-24;
	}

	#header.stuck .nav-link {
		@apply text-white/65;
		text-shadow: none;
	}

	#header.stuck .nav-link:hover {
		@apply text-gold;
	}

	#header.stuck .nav-cta {
		@apply border-gold text-gold;
		text-shadow: none;
	}

	#header.stuck .nav-cta:hover {
		@apply bg-gold text-black;
	}

	.nav-link {
		text-shadow: 0 1px 8px rgba(0, 0, 0, 0.65);
	}

	.nav-cta {
		text-shadow: 0 1px 5px rgba(0, 0, 0, 0.5);
	}

	#mobile-drawer.open {
		display: block;
	}

	/* Hamburger → X animation */
	#mobile-menu-btn {
		position: relative;
	}

	#mobile-menu-btn .menu-line {
		transform-origin: center;
	}

	#mobile-menu-btn.open .menu-line:nth-child(1) {
		transform: translateY(5px) rotate(45deg);
	}

	#mobile-menu-btn.open .menu-line:nth-child(2) {
		opacity: 0;
	}

	#mobile-menu-btn.open .menu-line:nth-child(3) {
		transform: translateY(-5px) rotate(-45deg);
	}
</style>
