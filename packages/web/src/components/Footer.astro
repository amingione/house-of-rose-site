---
import { SHOP_ENABLED } from '@/lib/features';
import type { PublicSiteFacts } from '@/lib/publicSiteFacts';
import { structuredTelephone } from '@/lib/structuredData';

interface Props {
  siteFacts: PublicSiteFacts;
}

const currentYear = new Date().getFullYear();
const { siteFacts } = Astro.props;
const phoneHref = `tel:${structuredTelephone(siteFacts)}`;
const addressMatch = siteFacts.address.match(/^(.+),\s*([^,]+),\s*([A-Z]{2}\s+\d{5}(?:-\d{4})?)$/i);
const addressLine1 = addressMatch?.[1] ?? siteFacts.address;
const addressLine2 = addressMatch ? `${addressMatch[2]}, ${addressMatch[3]}` : undefined;
---

<footer class="on-dark border-t border-ivory/10 bg-walnut px-6 pb-8 pt-[clamp(56px,8vw,88px)]">
  <div class="mx-auto max-w-[1280px]">
    <div class="grid gap-12 lg:grid-cols-[1.3fr_0.8fr_0.8fr_1fr] lg:gap-10">
      <div>
        <p class="font-serif text-[30px] leading-tight text-ivory">{siteFacts.siteName}</p>
        <p class="mt-3 text-[12px] font-semibold tracking-[0.1em] uppercase text-gold">Medical Aesthetics Practice</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/services/" class="btn-gold">Explore treatments</a>
          <a href="/contact/" class="btn-outline-white">Contact us</a>
        </div>
      </div>

      <nav aria-label="Practice">
        <h2 class="footer-heading">Practice</h2>
        <ul class="footer-list">
          <li><a href="/about/">About</a></li>
          <li><a href="/about/providers/">Providers</a></li>
          <li><a href="/services/">Services</a></li>
          <li><a href="/experience/">Experience</a></li>
          <li><a href="/results/">Results</a></li>
          <li><a href="/faq/">FAQ</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/support/">Client support</a></li>
          <li><a href="/rent-a-room/">Rent a suite</a></li>
        </ul>
      </nav>

      <nav aria-label="Explore">
        <h2 class="footer-heading">Explore</h2>
        <ul class="footer-list">
          <li><a href="/skin-analysis/">Skin analysis</a></li>
          <li><a href="/concerns/">Concerns</a></li>
          <li><a href="/compare/">Compare treatments</a></li>
          <li><a href="/cost/">Cost guides</a></li>
          <li><a href="/areas/">Areas we serve</a></li>
          <li><a href="/blog/">Journal</a></li>
          {SHOP_ENABLED && <li><a href="/shop/">Shop</a></li>}
          {SHOP_ENABLED && <li><a href="/shop/jane-iredale/">Jane Iredale</a></li>}
        </ul>
      </nav>

      <div>
        <h2 class="footer-heading">Visit</h2>
        <address class="text-[14px] not-italic leading-[1.8] text-muted">
          {addressLine1}{addressLine2 && <><br />{addressLine2}</>}<br />
          <a href={phoneHref} class="text-ivory hover:text-gold">{siteFacts.phone}</a>
        </address>
        <a href="/contact/" class="footer-visit-link">Directions and contact</a>
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-5 border-t border-ivory/10 pt-7 text-[12px] text-muted lg:flex-row lg:items-center lg:justify-between">
      <p>© {currentYear} House of Rose Aesthetics LLC. All rights reserved.</p>
      <nav aria-label="Legal" class="flex flex-wrap gap-x-5 gap-y-3">
        <a href="/privacy-policy/" class="hover:text-ivory">Privacy</a>
        <button id="privacy-choices" type="button" class="hover:text-ivory">Privacy choices</button>
        <a href="/terms-of-service/" class="hover:text-ivory">Terms</a>
        {SHOP_ENABLED && <a href="/shipping-policy/" class="hover:text-ivory">Shipping</a>}
        {SHOP_ENABLED && <a href="/return-policy/" class="hover:text-ivory">Returns</a>}
        <a href="/sitemap/" class="hover:text-ivory">Sitemap</a>
      </nav>
    </div>
  </div>
</footer>

<script>
  document.getElementById('privacy-choices')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('hor:open-consent'));
  });
</script>

<style>
  .footer-heading {
    margin-bottom: 18px;
    color: #f1ede5;
    font-family: "Avenir Next", Avenir, Arial, sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .footer-list { display: grid; gap: 11px; }
  .footer-list a {
    color: rgb(var(--hr-muted));
    font-size: 14px;
    line-height: 1.5;
  }
  .footer-list a:hover { color: #f1ede5; }
  .footer-visit-link {
    display: inline-flex;
    margin-top: 18px;
    min-height: 44px;
    align-items: center;
    color: #f1ede5;
    font-size: 13px;
    text-decoration: underline;
    text-decoration-color: rgb(138 106 67 / 0.75);
    text-underline-offset: 5px;
  }
  .footer-list a,
  .footer-visit-link,
  footer nav[aria-label="Legal"] a,
  #privacy-choices {
    transition: color 160ms ease, text-decoration-color 160ms ease;
  }
</style>
