---
import { SHOP_ENABLED } from '@/lib/features';
import { EVENTS_SITE, type PublicSiteFacts } from '@/lib/publicSiteFacts';
import { structuredTelephone } from '@/lib/structuredData';

interface Props {
  siteFacts: PublicSiteFacts;
}

const currentYear = new Date().getFullYear();
const { siteFacts } = Astro.props;
const phoneHref = `tel:${structuredTelephone(siteFacts)}`;
const addressMatch = siteFacts.address.match(/^(.+),\s*([^,]+),\s*([A-Z]{2}\s+\d{5}(?:-\d{4})?)$/i);
const addressLine1 = addressMatch?.[1] ?? siteFacts.address;
const addressLine2 = addressMatch ? `${addressMatch[2]}, ${addressMatch[3]}` : undefined;
---

<!-- Dark ink footer. `.on-dark` flips the accent/muted channels declared in
     global.css, so `text-gold` and `text-muted` stay legible here without
     hard-coding a second palette. -->
<footer class="on-dark bg-ink text-ivory">
  <div class="mx-auto grid max-w-[1280px] gap-12 px-5 py-[clamp(64px,9vw,96px)] sm:px-8 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-5">
      <p class="font-display text-4xl leading-display text-ivory sm:text-5xl">{siteFacts.shortName}</p>
      <p class="mt-4 text-kicker font-medium uppercase tracking-label text-gold">Medical Aesthetics Practice</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="/services/" class="btn-gold">Explore treatments</a>
        <a href="/contact/" class="btn-outline-white">Contact us</a>
      </div>
    </div>

    <nav aria-label="Practice" class="lg:col-span-2">
      <h2 class="footer-heading">Practice</h2>
      <ul class="footer-list">
        <li><a href="/about/">About</a></li>
        <li><a href="/about/providers/">Providers</a></li>
        <li><a href="/services/">Services</a></li>
        <li><a href="/experience/">Experience</a></li>
        <li><a href="/results/">Results</a></li>
        <li><a href="/faq/">FAQ</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/support/">Client support</a></li>
        <li><a href="/rent-a-room/">Rent a suite</a></li>
      </ul>
    </nav>

    <nav aria-label="Explore" class="lg:col-span-2">
      <h2 class="footer-heading">Explore</h2>
      <ul class="footer-list">
        <li><a href={EVENTS_SITE.url}>{EVENTS_SITE.name}</a></li>
        <li><a href="/skin-analysis/">Skin analysis</a></li>
        <li><a href="/concerns/">Concerns</a></li>
        <li><a href="/compare/">Compare treatments</a></li>
        <li><a href="/cost/">Cost guides</a></li>
        <li><a href="/areas/">Areas we serve</a></li>
        <li><a href="/blog/">Journal</a></li>
        {SHOP_ENABLED && <li><a href="/shop/">Shop</a></li>}
        {SHOP_ENABLED && <li><a href="/shop/jane-iredale/">Jane Iredale</a></li>}
      </ul>
    </nav>

    <div class="lg:col-span-3">
      <h2 class="footer-heading">Visit</h2>
      <address class="text-[14px] not-italic leading-body text-ivory/70">
        {addressLine1}{addressLine2 && <><br />{addressLine2}</>}<br />
        <a href={phoneHref} class="footer-link">{siteFacts.phone}</a>
      </address>
      <a href="/contact/" class="footer-visit-link">Directions and contact</a>
    </div>
  </div>

  <div class="border-t border-ivory/10">
    <div class="mx-auto flex max-w-[1280px] flex-col gap-4 px-5 py-6 text-[11px] uppercase tracking-wide text-ivory/60 sm:px-8 lg:flex-row lg:items-center lg:justify-between">
      <p>© {currentYear} House of Rose Aesthetics LLC. All rights reserved.</p>
      <nav aria-label="Legal" class="flex flex-wrap gap-x-5 gap-y-3">
        <a href="/privacy-policy/" class="hover:text-ivory">Privacy</a>
        <button id="privacy-choices" type="button" class="uppercase tracking-wide hover:text-ivory">Privacy choices</button>
        <a href="/terms-of-service/" class="hover:text-ivory">Terms</a>
        {SHOP_ENABLED && <a href="/shipping-policy/" class="hover:text-ivory">Shipping</a>}
        {SHOP_ENABLED && <a href="/return-policy/" class="hover:text-ivory">Returns</a>}
        <a href="/sitemap/" class="hover:text-ivory">Sitemap</a>
      </nav>
    </div>
  </div>
</footer>

<script>
  document.getElementById('privacy-choices')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('hor:open-consent'));
  });
</script>

<style>
  /* Column labels use the 0.28em label standard, at 60% ivory rather than the
     45% hra-grok uses — 45% over ink lands at 3.8:1 and fails AA at 11px. */
  .footer-heading {
    margin-bottom: 18px;
    color: rgb(244 239 232 / 0.6);
    font-family: var(--font-sans);
    font-size: var(--text-kicker);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  .footer-list { display: grid; gap: 12px; }
  .footer-list a,
  .footer-link {
    color: rgb(244 239 232 / 0.85);
    font-size: 14px;
    line-height: 1.5;
  }
  .footer-list a:hover,
  .footer-link:hover { opacity: 0.6; }
  .footer-visit-link {
    display: inline-flex;
    margin-top: 18px;
    min-height: 44px;
    align-items: center;
    color: rgb(244 239 232 / 0.85);
    font-size: 13px;
    text-decoration: underline;
    text-decoration-color: rgb(199 154 145 / 0.8);
    text-underline-offset: 5px;
  }
  .footer-visit-link:hover { text-decoration-color: rgb(199 154 145); }
  .footer-list a,
  .footer-link,
  .footer-visit-link,
  footer nav[aria-label="Legal"] a,
  #privacy-choices {
    transition: color 160ms ease, opacity 160ms ease, text-decoration-color 160ms ease;
  }
</style>
