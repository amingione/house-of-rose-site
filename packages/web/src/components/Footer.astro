---
interface Props {
	services?: Array<{ title: string; slug: string }>;
}

const { services = [] } = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer class="on-dark bg-walnut border-t border-gold-metal/20 py-11 px-6">
	<div class="max-w-[1280px] mx-auto">
		<!-- Top section -->
		<div class="flex justify-between flex-wrap gap-8 mb-8">
			<!-- Brand -->
			<div>
				<p
					class="font-serif text-gold tracking-[0.3em] text-[13px] uppercase"
				>
					House of Rose Aesthetics
				</p>
				<p
					class="text-muted text-[11px] font-medium tracking-[0.26em] uppercase mt-1"
				>
					Punta Gorda, FL
				</p>
			</div>

			<!-- Links -->
			<div class="grid w-full grid-cols-2 gap-x-6 text-[11px] sm:w-auto sm:grid-cols-3 sm:gap-x-8 lg:gap-x-10">
				<!-- Main Navigation -->
				<div class="flex flex-col gap-0.5">
					<a
						href="/"
						class="footer-link text-muted tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold"
					>
						Home
					</a>
					<a
						href="/services/"
						class="footer-link text-muted tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold"
					>
						Services
					</a>
					<a
						href="/experience/"
						class="footer-link text-muted tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold"
					>
						Experience
					</a>
					<a
						href="/services/professional-makeup/"
						class="footer-link text-muted tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold"
					>
						Professional Makeup
					</a>
					<a
						href="/packages/"
						class="footer-link text-muted tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold"
					>
						Packages
					</a>
					<a
						href="/shop/"
						class="footer-link text-muted tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold"
					>
						Shop
					</a>
					<a
						href="/blog/"
						class="footer-link text-muted tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold"
					>
						Journal
					</a>
					<a
						href="/contact/"
						class="footer-link text-muted tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold"
					>
						Contact
					</a>
					<a
						href="/rent-a-room/"
						class="footer-link text-muted tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold"
					>
						Rent a Suite
					</a>
					<a
						href="/privacy-policy/"
						class="footer-link text-muted tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold"
					>
						Privacy Policy
					</a>
					<a
						href="/terms-of-service/"
						class="footer-link text-muted tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold"
					>
						Terms of Service
					</a>
				</div>

					<!-- Resources / AEO hubs -->
					<div class="flex flex-col gap-0.5">
						<a href="/faq/" class="footer-link text-muted tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold">FAQ</a>
						<a href="/support/" class="footer-link text-muted tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold">Support</a>
						<a href="/services/microchanneling-microneedling/" class="footer-link text-muted tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold">Needling Guide</a>
						<a href="/skin-analysis/" class="footer-link text-muted tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold">AI Skin Analysis</a>
						<a href="/cost/" class="footer-link text-muted tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold">Pricing Guides</a>
						<a href="/compare/" class="footer-link text-muted tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold">Compare Treatments</a>
						<a href="/services/collections/" class="footer-link text-muted tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold">Collections</a>
						<a href="/areas/" class="footer-link text-muted tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold">Areas We Serve</a>
						<a href="/results/" class="footer-link text-muted tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold">Results</a>
						<a href="/sitemap/" class="footer-link text-muted tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold">Sitemap</a>
					</div>

					<!-- Service Links -->
				{
					services.length > 0 && (
						<div class="flex flex-col gap-0.5">
							{services.slice(0, 5).map((service) => (
								<a
									href={`/services/${service.slug}/`}
									class="footer-link text-muted tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold"
								>
									{service.title}
								</a>
							))}
						</div>
					)
				}
			</div>
		</div>

		<!-- Bottom section -->
		<div
			class="border-t border-ivory/10 pt-5 flex justify-between flex-wrap gap-1.5"
		>
			<p class="text-muted text-[11px] tracking-[0.16em]">
				© {currentYear} House of Rose LLC. All rights reserved.
			</p>
			<address
				class="not-italic text-muted text-[11px] tracking-[0.16em] text-right"
			>
				<span
					>525 E Olympia Ave, Unit 9 &mdash; Punta Gorda, FL 33950</span
				>
				<span class="mx-1.5 opacity-40">|</span>
				<a
					href="tel:+18449417673"
					class="hover:text-gold transition-colors">(844) 941-7673</a
				>
			</address>
		</div>
	</div>
</footer>
