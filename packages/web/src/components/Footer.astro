---
interface Props {
	services?: Array<{ title: string; slug: string }>;
}

const { services = [] } = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer class="bg-walnut border-t border-gold/20 py-11 px-6">
	<div class="max-w-[1280px] mx-auto">
		<!-- Top section -->
		<div class="flex justify-between flex-wrap gap-8 mb-8">
			<!-- Brand -->
			<div>
				<p
					class="font-serif text-gold tracking-[0.3em] text-[13px] uppercase"
				>
					House of Rose Aesthetics
				</p>
				<p
					class="text-ivory/45 text-[10px] tracking-[0.38em] uppercase mt-1"
				>
					Punta Gorda, FL
				</p>
			</div>

			<!-- Links -->
			<div class="flex gap-10 text-[11px]">
				<!-- Main Navigation -->
				<div class="flex flex-col gap-0.5">
					<a
						href="/"
						class="footer-link text-ivory/55 tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold"
					>
						Home
					</a>
					<a
						href="/services/"
						class="footer-link text-ivory/55 tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold"
					>
						Services
					</a>
					<a
						href="/rose-circle/"
						class="footer-link text-ivory/55 tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold"
					>
						The Rose Circle
					</a>
					<a
						href="/memberships/"
						class="footer-link text-ivory/55 tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold"
					>
						Memberships
					</a>
					<a
						href="/experience/"
						class="footer-link text-ivory/55 tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold"
					>
						Experience
					</a>
					<a
						href="/blog/"
						class="footer-link text-ivory/55 tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold"
					>
						Journal
					</a>
					<a
						href="/contact/"
						class="footer-link text-ivory/55 tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold"
					>
						Contact
					</a>
					<a
						href="/rent-a-room/"
						class="footer-link text-ivory/55 tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold"
					>
						Rent a Suite
					</a>
					<a
						href="/privacy-policy/"
						class="footer-link text-ivory/55 tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold"
					>
						Privacy Policy
					</a>
				</div>

					<!-- Resources / AEO hubs -->
					<div class="flex flex-col gap-0.5">
						<a href="/faq/" class="footer-link text-ivory/55 tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold">FAQ</a>
						<a href="/skin-analysis/" class="footer-link text-ivory/55 tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold">AI Skin Analysis</a>
						<a href="/areas/" class="footer-link text-ivory/55 tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold">Areas We Serve</a>
						<a href="/results/" class="footer-link text-ivory/55 tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold">Results</a>
						<a href="/sitemap/" class="footer-link text-ivory/55 tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold">Sitemap</a>
					</div>

					<!-- Service Links -->
				{
					services.length > 0 && (
						<div class="flex flex-col gap-0.5">
							{services.slice(0, 5).map((service) => (
								<a
									href={`/services/${service.slug}`}
									class="footer-link text-ivory/55 tracking-[0.16em] uppercase py-2 min-h-[44px] flex items-center transition-colors duration-200 hover:text-gold"
								>
									{service.title}
								</a>
							))}
						</div>
					)
				}
			</div>
		</div>

		<!-- Bottom section -->
		<div
			class="border-t border-ivory/10 pt-5 flex justify-between flex-wrap gap-1.5"
		>
			<p class="text-ivory/45 text-[10px] tracking-[0.16em]">
				© {currentYear} House of Rose LLC. All rights reserved.
			</p>
			<address
				class="not-italic text-ivory/45 text-[10px] tracking-[0.16em] text-right"
			>
				<span
					>525 E Olympia Ave, Unit 9 &mdash; Punta Gorda, FL 33950</span
				>
				<span class="mx-1.5 opacity-40">|</span>
				<a
					href="tel:+18449417673"
					class="hover:text-gold transition-colors">(844) 941-7673</a
				>
			</address>
		</div>
	</div>
</footer>
