---
import type { Service } from '@/lib/serviceCatalog';
import type { InModePageContent } from '@/lib/inmodeLandingContent';

interface Props {
  content: InModePageContent;
  service: Service;
}

const { content, service } = Astro.props;
const isHub = content.slug === 'inmode';
const navItems = [
  ...(content.pathways ? [{ href: '#treatments', label: 'Treatments' }] : []),
  ...(content.opening ? [{ href: '#technology', label: 'How it works' }] : []),
  ...(content.comparison ? [{ href: '#compare', label: 'Compare' }] : []),
  ...(content.results ? [{ href: '#results', label: 'Results' }] : []),
  ...(content.timeline ? [{ href: '#timeline', label: 'Timeline' }] : []),
  ...(content.decisions ? [{ href: '#compare', label: 'Choose a path' }] : []),
  { href: '#combinations', label: 'Combinations' },
  { href: '#faq', label: 'FAQ' },
];

const medicalDirector = 'Medical Director: Joshua Shaw, MD · FL Lic. ME136232';
---

<article class={`inmode-page inmode-${content.theme}`}>
  <header class="inmode-hero">
    <div class="inmode-hero__media">
      <img
        src={content.heroImage.src}
        alt={content.heroImage.alt}
        width={content.heroImage.width}
        height={content.heroImage.height}
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <div class="inmode-hero__veil"></div>
    <div class="inmode-shell inmode-hero__inner">
      <a href={isHub ? '/services/' : '/services/inmode/'} class="inmode-back">
        <span aria-hidden="true">←</span>{isHub ? 'All treatments' : 'InMode treatments'}
      </a>
      <div class="inmode-hero__copy">
        <p class="inmode-eyebrow">{content.eyebrow}</p>
        <h1>{content.title}</h1>
        <p class="inmode-dek">{content.dek}</p>
        <div class="inmode-actions">
          <a href={content.primaryCta.href} class="inmode-button inmode-button--primary">
            {content.primaryCta.label}<span aria-hidden="true">↗</span>
          </a>
          {content.secondaryCta && (
            <a href={content.secondaryCta.href} class="inmode-button inmode-button--ghost">
              {content.secondaryCta.label}<span aria-hidden="true">↓</span>
            </a>
          )}
        </div>
      </div>
      {content.heroNote && <p class="inmode-hero__note">{content.heroNote}</p>}
    </div>
  </header>

  {content.quickFacts && (
    <section class="inmode-facts" aria-label={`${service.title} at a glance`}>
      <div class="inmode-shell inmode-facts__grid">
        {content.quickFacts.map((fact) => (
          <div>
            <p>{fact.label}</p>
            <strong>{fact.value}</strong>
          </div>
        ))}
      </div>
    </section>
  )}

  <nav class="inmode-index" aria-label="On this page">
    <div class="inmode-shell inmode-index__track">
      <span>On this page</span>
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </div>
  </nav>

  {content.pathways && (
    <section id="treatments" class="inmode-section inmode-pathways">
      <div class="inmode-shell">
        <div class="inmode-heading inmode-heading--wide">
          <p class="inmode-eyebrow">What the treatment consists of · Structure · color · maintenance</p>
          <h2>Start with the job your skin needs done.</h2>
          <p>Morpheus8, Lumecca Peak, and Forma share a platform, not a purpose. The clearest treatment plan begins by separating texture and laxity from pigment and redness, then deciding whether maintenance belongs afterward.</p>
        </div>

        <div class="inmode-pathways__list">
          {content.pathways.map((pathway, index) => (
            <article class:list={['inmode-pathway', pathway.featured && 'inmode-pathway--featured']}>
              <div class="inmode-pathway__image">
                <img
                  src={pathway.image.src}
                  alt={pathway.image.alt}
                  width={pathway.image.width}
                  height={pathway.image.height}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </div>
              <div class="inmode-pathway__copy">
                <p class="inmode-pathway__role">{pathway.role}</p>
                <h3>{pathway.title}</h3>
                <p>{pathway.summary}</p>
                <ul>
                  {pathway.concerns.map((concern) => <li>{concern}</li>)}
                </ul>
                <a href={pathway.href}>{pathway.cta}<span aria-hidden="true">→</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {content.decisions && (
    <section id="compare" class="inmode-section inmode-decision">
      <div class="inmode-shell">
        <div class="inmode-heading">
          <p class="inmode-eyebrow">Which treatment do I need?</p>
          <h2>Match the visible concern to the modality.</h2>
          <p>This is a starting map, not a diagnosis. Consultation confirms whether the concern is appropriate for the treatment and whether skin type, sun history, timing, or health factors change the direction.</p>
        </div>
        <div class="inmode-decision__rows">
          {content.decisions.map((decision) => (
            <a href={decision.href} class="inmode-decision__row">
              <span class="inmode-decision__concern">{decision.concern}</span>
              <span class="inmode-decision__arrow" aria-hidden="true">→</span>
              <span class="inmode-decision__answer">
                <strong>{decision.treatment}</strong>
                <small>{decision.note}</small>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {content.opening && (
    <section id="technology" class="inmode-section inmode-technology">
      <div class="inmode-shell inmode-technology__grid">
        <div class="inmode-technology__copy">
          <div class="inmode-heading">
            <p class="inmode-eyebrow">What the treatment consists of · {content.opening.eyebrow}</p>
            <h2>{content.opening.title}</h2>
          </div>
          <div class="inmode-prose">
            {content.opening.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          {content.opening.points && (
            <dl class="inmode-principles">
              {content.opening.points.map((point) => (
                <div>
                  <dt>{point.title}</dt>
                  <dd>{point.text}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>
        {content.opening.deviceImage && (
          <figure class="inmode-device">
            <div class="inmode-device__halo"></div>
            <img
              src={content.opening.deviceImage.src}
              alt={content.opening.deviceImage.alt}
              width={content.opening.deviceImage.width}
              height={content.opening.deviceImage.height}
              loading="lazy"
              decoding="async"
            />
            {content.opening.deviceImage.credit && <figcaption>{content.opening.deviceImage.credit}</figcaption>}
          </figure>
        )}
      </div>
    </section>
  )}

  {content.concerns && (
    <section class="inmode-concerns" aria-labelledby={`${content.slug}-concerns-heading`}>
      <div class="inmode-shell inmode-concerns__grid">
        <div>
          <p class="inmode-eyebrow">Treatment focus</p>
          <h2 id={`${content.slug}-concerns-heading`}>What House of Rose considers {service.title} for.</h2>
        </div>
        <ul>
          {content.concerns.map((concern, index) => (
            <li><span>{String(index + 1).padStart(2, '0')}</span>{concern}</li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {content.comparison && (
    <section id="compare" class="inmode-section inmode-comparison">
      <div class="inmode-shell">
        <div class="inmode-heading inmode-heading--wide">
          <p class="inmode-eyebrow">{content.comparison.eyebrow}</p>
          <h2>{content.comparison.title}</h2>
          <p>{content.comparison.intro}</p>
        </div>
        <div class="inmode-comparison__grid">
          {content.comparison.columns.map((column) => (
            <article>
              <p>{column.subtitle}</p>
              <h3>{column.title}</h3>
              <ul>{column.points.map((point) => <li>{point}</li>)}</ul>
              {column.href && <a href={column.href}>Explore {column.title}<span aria-hidden="true">→</span></a>}
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {content.results && (
    <section id="results" class="inmode-section inmode-results">
      <div class="inmode-shell">
        <div class="inmode-heading inmode-heading--wide">
          <p class="inmode-eyebrow">{content.results.eyebrow}</p>
          <h2>{content.results.title}</h2>
          <p>{content.results.intro}</p>
        </div>
        <div class="inmode-results__stack">
          {content.results.images.map((result, index) => (
            <figure class:list={['inmode-result', index % 2 === 1 && 'inmode-result--offset']}>
              <img
                src={result.src}
                alt={result.alt}
                width={result.width}
                height={result.height}
                loading="lazy"
                decoding="async"
              />
              <figcaption>
                {result.context && <strong>{result.context}</strong>}
                {result.credit && <span>{result.credit}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
        <p class="inmode-results__disclaimer">{content.results.disclaimer}</p>
      </div>
    </section>
  )}

  {content.timeline && (
    <section id="timeline" class="inmode-section inmode-timeline">
      <div class="inmode-shell inmode-timeline__layout">
        <div class="inmode-heading inmode-timeline__intro">
          <p class="inmode-eyebrow">{content.timeline.eyebrow}</p>
          <h2>{content.timeline.title}</h2>
          <p>{content.timeline.intro}</p>
        </div>
        <ol>
          {content.timeline.steps.map((step, index) => (
            <li>
              <span class="inmode-timeline__number">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <p class="inmode-timeline__label">{step.label}</p>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {content.experience && (
    <section class="inmode-section inmode-experience">
      <div class="inmode-shell">
        <div class="inmode-heading inmode-heading--wide">
          <p class="inmode-eyebrow">{content.experience.eyebrow}</p>
          <h2>{content.experience.title}</h2>
          <p>{content.experience.intro}</p>
        </div>
        <div class="inmode-experience__grid">
          {content.experience.items.map((item) => (
            <article>
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {content.approach && (
    <section class="inmode-section inmode-approach">
      <div class="inmode-shell inmode-approach__grid">
        <div class="inmode-heading">
          <p class="inmode-eyebrow">{content.approach.eyebrow}</p>
          <h2>{content.approach.title}</h2>
          <div class="inmode-prose">
            {content.approach.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
        <div class="inmode-approach__panel">
          <p>What planning accounts for</p>
          <ul>{content.approach.points.map((point) => <li>{point}</li>)}</ul>
          <p class="inmode-medical-director">Treatments are provided under written physician protocol and medical direction.<br />{medicalDirector}</p>
        </div>
      </div>
    </section>
  )}

  {content.formaPlus && (
    <section class="inmode-section inmode-forma-plus">
      <div class="inmode-shell">
        <h2>{content.formaPlus.title}</h2>
        <div>
          <article><p>Forma</p><h3>Smaller treatment areas</h3><span>{content.formaPlus.forma}</span></article>
          <article><p>Forma Plus</p><h3>Larger treatment surface</h3><span>{content.formaPlus.plus}</span></article>
        </div>
      </div>
    </section>
  )}

  <section id="combinations" class="inmode-section inmode-combinations">
    <div class="inmode-shell">
      <div class="inmode-heading inmode-heading--wide">
        <p class="inmode-eyebrow">Combination treatment planning</p>
        <h2>{isHub ? 'Different layers can belong in one plan.' : 'A second modality should have a separate job.'}</h2>
        <p>Combination planning is about matching each concern to the right technology and sequencing treatment responsibly. It is not an instruction to perform every modality in the same appointment.</p>
      </div>
      <div class="inmode-combinations__grid">
        {content.combinations.map((combination) => (
          <article>
            <p>{combination.shorthand}</p>
            <h3>{combination.title}</h3>
            <span>{combination.text}</span>
            <div>
              {combination.links.map((link) => <a href={link.href}>{link.label}<span aria-hidden="true">→</span></a>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="faq" class="inmode-section inmode-faq">
    <div class="inmode-shell inmode-faq__layout">
      <div class="inmode-heading inmode-faq__intro">
        <p class="inmode-eyebrow">Frequently asked questions</p>
        <h2>Clear answers before the consultation.</h2>
        <p>These answers are general education. Your health history, skin, anatomy, and treatment area determine what is appropriate.</p>
      </div>
      <div class="inmode-faq__list">
        {content.faqs.map((faq, index) => (
          <details open={index === 0}>
            <summary><span>{faq.question}</span><span aria-hidden="true">+</span></summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="inmode-care" aria-labelledby={`${content.slug}-care-heading`}>
    <div class="inmode-shell inmode-care__grid">
      <div>
        <p class="inmode-eyebrow">Prepare and recover</p>
        <h2 id={`${content.slug}-care-heading`}>Keep the care instructions close.</h2>
      </div>
      <div>
        <p>Use the treatment-specific section in each guide. Instructions provided for your individual treatment and settings always take priority.</p>
        <div class="inmode-actions">
          <a href="/downloads/treatment-care/house-of-rose-pre-care-guide.pdf" download class="inmode-button inmode-button--primary">Download pre-care guide<span aria-hidden="true">↓</span></a>
          <a href="/downloads/treatment-care/house-of-rose-aftercare-guide.pdf" download class="inmode-button inmode-button--ghost">Download aftercare guide<span aria-hidden="true">↓</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="inmode-sources" aria-labelledby={`${content.slug}-sources`}>
    <div class="inmode-shell">
      <h2 id={`${content.slug}-sources`}>Sources</h2>
      <p>Manufacturer examples do not predict an individual result.</p>
      <ul>
        {content.sourceLinks.map((link) => (
          <li><a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}>{link.label}<span aria-hidden="true">↗</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="inmode-booking">
    <div class="inmode-shell inmode-booking__inner">
      <p class="inmode-eyebrow">House of Rose Aesthetics · Punta Gorda</p>
      <h2>Bring the concern. We’ll help identify the right treatment path.</h2>
      <p>Start with a consultation for Morpheus8, Lumecca Peak, Forma, or a combination plan. House of Rose can explain current pricing during that conversation.</p>
      <div class="inmode-actions">
        <a href="/consultation/" class="inmode-button inmode-button--primary">Book a consultation<span aria-hidden="true">↗</span></a>
        <a href="/contact/" class="inmode-button inmode-button--ghost">Contact House of Rose<span aria-hidden="true">→</span></a>
      </div>
      <p class="inmode-booking__address">525 E Olympia Ave, Unit 9 · Punta Gorda, FL 33950 · (941) 400-0165</p>
      <p class="inmode-medical-director">{medicalDirector}</p>
    </div>
  </section>

  <div class="inmode-mobile-cta" role="region" aria-label="Consultation booking">
    <span>{isHub ? 'Compare the three treatments' : service.title}</span>
    <a href="/consultation/">Book a consultation</a>
  </div>
</article>

<style>
  .inmode-page {
    --accent: #a98c63;
    --accent-soft: rgba(169, 140, 99, 0.15);
    --surface: #0b0b0a;
    --surface-raised: #14110f;
    --ink: #f1ede5;
    --muted: #c9c0b3;
    background: var(--surface);
    color: var(--ink);
  }

  .inmode-complexion { --accent: #b88262; --accent-soft: rgba(184, 130, 98, 0.16); }
  .inmode-maintain { --accent: #8d907c; --accent-soft: rgba(141, 144, 124, 0.16); }
  .inmode-remodel { --accent: #a98c63; --accent-soft: rgba(169, 140, 99, 0.16); }

  .inmode-shell { width: min(100% - 40px, 1280px); margin-inline: auto; }
  .inmode-section { padding-block: clamp(72px, 10vw, 144px); scroll-margin-top: 118px; }
  .inmode-eyebrow { margin: 0 0 18px; color: var(--accent); font-size: 11px; font-weight: 700; letter-spacing: .16em; line-height: 1.4; text-transform: uppercase; }
  .inmode-heading { max-width: 720px; }
  .inmode-heading--wide { max-width: 920px; }
  .inmode-heading h2 { margin: 0; font-family: Baskerville, "Libre Baskerville", Georgia, serif; font-size: clamp(38px, 6vw, 72px); font-weight: 400; letter-spacing: -.025em; line-height: .98; }
  .inmode-heading > p:last-child { max-width: 760px; margin: 28px 0 0; color: var(--muted); font-size: 16px; line-height: 1.8; }
  .inmode-prose { margin-top: 30px; }
  .inmode-prose p { margin: 0 0 20px; color: var(--muted); font-size: 16px; line-height: 1.85; }

  .inmode-hero { position: relative; display: grid; min-height: min(900px, 100svh); overflow: hidden; padding-top: 80px; background: #090807; }
  .inmode-hero__media, .inmode-hero__veil { position: absolute; inset: 0; }
  .inmode-hero__media { left: 42%; }
  .inmode-hero__media img { width: 100%; height: 100%; object-fit: cover; object-position: center; filter: saturate(.78) contrast(1.03); }
  .inmode-hero__veil { background: linear-gradient(90deg, #090807 0%, rgba(9,8,7,.98) 35%, rgba(9,8,7,.62) 62%, rgba(9,8,7,.18) 100%), linear-gradient(0deg, rgba(9,8,7,.72), transparent 42%); }
  .inmode-complexion .inmode-hero__veil { background: linear-gradient(90deg, #110c09 0%, rgba(17,12,9,.98) 35%, rgba(17,12,9,.58) 64%, rgba(17,12,9,.12) 100%), linear-gradient(0deg, rgba(9,8,7,.7), transparent 42%); }
  .inmode-hero__inner { position: relative; z-index: 1; display: flex; flex-direction: column; justify-content: center; padding-block: clamp(80px, 13vw, 160px) 54px; }
  .inmode-back { position: absolute; top: 30px; left: 0; display: inline-flex; gap: 10px; color: rgba(241,237,229,.72); font-size: 12px; font-weight: 600; text-decoration: none; }
  .inmode-back:hover { color: var(--ink); }
  .inmode-hero__copy { max-width: 760px; }
  .inmode-hero h1 { max-width: 840px; margin: 0; font-family: Baskerville, "Libre Baskerville", Georgia, serif; font-size: clamp(52px, 8vw, 112px); font-weight: 400; letter-spacing: -.045em; line-height: .86; text-wrap: balance; }
  .inmode-dek { max-width: 680px; margin: 32px 0 0; color: var(--muted); font-size: clamp(16px, 1.7vw, 20px); line-height: 1.7; }
  .inmode-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
  .inmode-button { display: inline-flex; min-height: 50px; align-items: center; justify-content: center; gap: 18px; padding: 13px 22px; border: 1px solid rgba(241,237,229,.3); color: var(--ink); font-size: 13px; font-weight: 700; text-decoration: none; transition: background .2s ease, border-color .2s ease, color .2s ease; }
  .inmode-button--primary { border-color: var(--accent); background: var(--accent); color: #0b0b0a; }
  .inmode-button--primary:hover { background: #d7c6aa; border-color: #d7c6aa; }
  .inmode-button--ghost:hover { border-color: var(--ink); background: var(--ink); color: #0b0b0a; }
  .inmode-hero__note { align-self: flex-end; max-width: 390px; margin: 60px 0 0; padding-left: 18px; border-left: 1px solid var(--accent); color: rgba(241,237,229,.7); font-size: 12px; letter-spacing: .04em; line-height: 1.65; }

  .inmode-facts { border-block: 1px solid rgba(241,237,229,.12); background: #100e0d; }
  .inmode-facts__grid { display: grid; grid-template-columns: repeat(3, 1fr); }
  .inmode-facts__grid > div { min-height: 128px; padding: 30px clamp(20px, 4vw, 52px); border-right: 1px solid rgba(241,237,229,.12); }
  .inmode-facts__grid > div:last-child { border-right: 0; }
  .inmode-facts p { margin: 0 0 8px; color: var(--accent); font-size: 10px; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; }
  .inmode-facts strong { display: block; max-width: 280px; font-family: Baskerville, "Libre Baskerville", Georgia, serif; font-size: clamp(19px, 2vw, 28px); font-weight: 400; line-height: 1.2; }

  .inmode-index { position: sticky; z-index: 20; top: 80px; overflow: hidden; border-bottom: 1px solid rgba(241,237,229,.1); background: rgba(11,11,10,.94); backdrop-filter: blur(16px); }
  .inmode-index__track { display: flex; gap: 22px; overflow-x: auto; padding-block: 14px; scrollbar-width: none; }
  .inmode-index__track::-webkit-scrollbar { display: none; }
  .inmode-index span { flex: 0 0 auto; color: var(--accent); font-size: 10px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .inmode-index a { flex: 0 0 auto; color: rgba(241,237,229,.72); font-size: 12px; text-decoration: none; }
  .inmode-index a:hover { color: var(--ink); }

  .inmode-pathways { background: #0b0b0a; }
  .inmode-pathways__list { display: grid; gap: 26px; margin-top: 70px; }
  .inmode-pathway { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(320px, .75fr); min-height: 500px; overflow: hidden; border: 1px solid rgba(241,237,229,.12); background: var(--surface-raised); }
  .inmode-pathway:nth-child(even) { grid-template-columns: minmax(320px, .75fr) minmax(0, 1.25fr); }
  .inmode-pathway:nth-child(even) .inmode-pathway__image { order: 2; }
  .inmode-pathway--featured { min-height: 620px; border-color: rgba(169,140,99,.48); }
  .inmode-pathway__image { overflow: hidden; background: #191512; }
  .inmode-pathway__image img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s cubic-bezier(.2,.7,.2,1); }
  .inmode-pathway:hover .inmode-pathway__image img { transform: scale(1.025); }
  .inmode-pathway__copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(34px, 6vw, 76px); }
  .inmode-pathway__role { margin: 0 0 18px; color: var(--accent); font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .inmode-pathway h3 { margin: 0; font-size: clamp(38px, 5vw, 68px); line-height: .95; }
  .inmode-pathway__copy > p:not(.inmode-pathway__role) { margin: 24px 0 0; color: var(--muted); font-size: 15px; line-height: 1.75; }
