---
import ProductCard from './ProductCard.astro';
import type { Product } from '@/lib/queries';

interface Props {
  products: Product[];
}

const { products } = Astro.props;
const featured = products.filter((p) => p.isFeatured);
---

{featured.length > 0 && (
  <section class="bg-charcoal py-[clamp(40px,6vw,72px)] px-6 border-t border-gold-metal/10" aria-label="Top sellers">
    <div class="max-w-[1280px] mx-auto">
      <div class="max-w-[700px] mb-10">
        <span class="kicker">Top Sellers</span>
        <p class="text-muted text-[15px] leading-[1.75] mt-3">
          What the front desk restocks the most — the pieces that keep earning their shelf space.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-px bg-gold-metal/10">
        {featured.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    </div>
  </section>
)}
