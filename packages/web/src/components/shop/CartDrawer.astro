---
/**
 * Slide-in cart. Rendered once in BaseLayout so it survives swup navigation and
 * every page can open it.
 *
 * The markup is static; nanostores drives the contents. Prices shown here are the
 * display snapshot from the store — the server recomputes the real total at checkout
 * (see netlify/functions/_lib/cart.ts).
 */
---

<div
  id="cart-drawer"
  class="fixed inset-0 z-[60] hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cart-heading"
>
  <!-- Scrim -->
  <div id="cart-scrim" class="absolute inset-0 bg-walnut/50 opacity-0 transition-opacity duration-300"></div>

  <!-- Panel -->
  <aside
    id="cart-panel"
    class="absolute right-0 top-0 h-full w-full max-w-[420px] bg-ivory shadow-2xl flex flex-col translate-x-full transition-transform duration-300"
  >
    <header class="flex items-center justify-between px-6 py-5 border-b border-gold-metal/30">
      <h2 id="cart-heading" class="font-serif text-[22px] text-ink">Your Cart</h2>
      <button
        id="cart-close"
        class="text-ink min-w-[44px] min-h-[44px] flex items-center justify-center -mr-3"
        aria-label="Close cart"
      >
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M1 1l16 16M17 1L1 17" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </button>
    </header>

    <div id="cart-empty" class="flex-1 flex flex-col items-center justify-center px-6 text-center gap-4">
      <p class="text-muted text-[15px]">Your cart is empty.</p>
      <a href="/shop/" class="btn-outline-gold">Browse the Shop</a>
    </div>

    <ul id="cart-lines" class="flex-1 overflow-y-auto px-6 py-4 hidden"></ul>

    <footer id="cart-footer" class="border-t border-gold-metal/30 px-6 py-5 hidden">
      <div class="flex items-baseline justify-between mb-1">
        <span class="text-ink text-[15px] font-medium">Subtotal</span>
        <span id="cart-subtotal" class="text-ink font-serif text-[20px]">$0.00</span>
      </div>
      <p class="text-muted text-[12px] mb-4">Shipping calculated at checkout.</p>
      <a href="/checkout/" class="btn-gold w-full">Checkout</a>
    </footer>
  </aside>
</div>

<script>
  import {
    cartItems,
    cartOpen,
    cartSubtotal,
    setQuantity,
    removeItem,
    addItem,
    formatPrice,
    type CartItem,
  } from '@/stores/cart';
  import { dispatchMeasurement } from '@/lib/measurement';

  /**
   * The drawer lives OUTSIDE <main>, so swup never replaces it — its listeners and
   * store subscriptions must be attached exactly once. The add-to-cart buttons DO live
   * inside <main> and are replaced on every navigation, so they rebind each time.
   *
   * Conflating the two is what made `qty-up` increment twice (two delegated click
   * listeners on the same persistent <ul>).
   */
  let drawerBound = false;

  function bindDrawer(): void {
    if (drawerBound) return;
    const drawer = document.getElementById('cart-drawer');
    const scrim = document.getElementById('cart-scrim');
    const panel = document.getElementById('cart-panel');
    const lines = document.getElementById('cart-lines');
    const empty = document.getElementById('cart-empty');
    const footer = document.getElementById('cart-footer');
    const subtotalEl = document.getElementById('cart-subtotal');
    if (!drawer || !scrim || !panel || !lines || !empty || !footer || !subtotalEl) return;

    // ── Open / close ──
    const setOpen = (open: boolean): void => {
      if (open) {
        drawer.classList.remove('hidden');
        // next frame so the transition actually runs
        requestAnimationFrame(() => {
          scrim.classList.replace('opacity-0', 'opacity-100');
          panel.classList.remove('translate-x-full');
        });
        document.body.style.overflow = 'hidden';
        const items = cartItems.get();
        if (items.length) {
          dispatchMeasurement({
            event: 'view_cart',
            ecommerce: {
              currency: 'USD',
              value: cartSubtotal.get() / 100,
              items: items.map((item) => ({
                item_id: item.sku ?? item.productId,
                item_name: item.title,
                price: item.unitPrice / 100,
                quantity: item.quantity,
              })),
            },
          });
        }
      } else {
        scrim.classList.replace('opacity-100', 'opacity-0');
        panel.classList.add('translate-x-full');
        document.body.style.overflow = '';
        window.setTimeout(() => drawer.classList.add('hidden'), 300);
      }
    };

    cartOpen.subscribe(setOpen);
    scrim.addEventListener('click', () => cartOpen.set(false));
    document.getElementById('cart-close')?.addEventListener('click', () => cartOpen.set(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && cartOpen.get()) cartOpen.set(false);
    });

    // ── Render ──
    const renderLine = (item: CartItem): string => `
      <li class="flex gap-4 py-4 border-b border-gold-metal/20 last:border-0" data-id="${item.productId}">
        ${
          item.image
            ? `<img src="${item.image}" alt="" width="72" height="72" class="w-[72px] h-[72px] object-cover bg-breath shrink-0" />`
            : `<div class="w-[72px] h-[72px] bg-breath shrink-0"></div>`
        }
        <div class="flex-1 min-w-0">
          <a href="/shop/${item.slug}/" class="block font-serif text-[16px] text-ink leading-snug hover:text-gold">${item.title}</a>
          ${item.size ? `<p class="text-muted text-[12px] mt-0.5">${item.size}</p>` : ''}
          <div class="flex items-center gap-3 mt-2">
            <div class="flex items-center border border-gold-metal/40">
              <button class="qty-down min-w-[32px] min-h-[32px] text-ink" aria-label="Decrease quantity">−</button>
              <span class="qty px-2 text-ink text-[14px] tabular-nums">${item.quantity}</span>
              <button class="qty-up min-w-[32px] min-h-[32px] text-ink" aria-label="Increase quantity">+</button>
            </div>
            <button class="remove text-muted text-[12px] underline min-h-[32px]">Remove</button>
          </div>
        </div>
        <p class="text-ink text-[14px] tabular-nums">${formatPrice(item.unitPrice * item.quantity)}</p>
      </li>`;

    const render = (items: readonly CartItem[]): void => {
      const hasItems = items.length > 0;
      lines.classList.toggle('hidden', !hasItems);
      footer.classList.toggle('hidden', !hasItems);
      empty.classList.toggle('hidden', hasItems);
      lines.innerHTML = items.map(renderLine).join('');
      subtotalEl.textContent = formatPrice(cartSubtotal.get());

      // Header badge. Derived here rather than from a `computed` store: computed
      // stores are lazy and weren't firing for the badge, leaving it stuck at 0.
      const count = items.reduce((n, i) => n + i.quantity, 0);
      document.querySelectorAll<HTMLElement>('[data-cart-count]').forEach((el) => {
        el.textContent = String(count);
        el.classList.toggle('hidden', count === 0);
        el.classList.toggle('flex', count > 0);
      });
    };

    cartItems.subscribe(render);

    // Event delegation — lines are re-rendered on every change.
    lines.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const row = target.closest<HTMLElement>('[data-id]');
      const id = row?.dataset.id;
      if (!id) return;

      const current = cartItems.get().find((i) => i.productId === id)?.quantity ?? 1;
      const item = cartItems.get().find((candidate) => candidate.productId === id);
      if (target.closest('.qty-up')) setQuantity(id, current + 1);
      else if (target.closest('.qty-down')) {
        setQuantity(id, current - 1);
        if (item) {
          dispatchMeasurement({
            event: 'remove_from_cart',
            ecommerce: {
              currency: 'USD',
              value: item.unitPrice / 100,
              items: [{
                item_id: item.sku ?? item.productId,
                item_name: item.title,
                price: item.unitPrice / 100,
                quantity: 1,
              }],
            },
          });
        }
      } else if (target.closest('.remove')) {
        removeItem(id);
        if (item) {
          dispatchMeasurement({
            event: 'remove_from_cart',
            ecommerce: {
              currency: 'USD',
              value: (item.unitPrice * item.quantity) / 100,
              items: [{
                item_id: item.sku ?? item.productId,
                item_name: item.title,
                price: item.unitPrice / 100,
                quantity: item.quantity,
              }],
            },
          });
        }
      }
    });

    drawerBound = true;
  }

  /** Buttons live inside <main> — swup swaps them out, so rebind after every nav. */
  function bindButtons(): void {
    document.querySelectorAll<HTMLButtonElement>('[data-add-to-cart]').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', () => {
        addItem({
          productId: btn.dataset.productId ?? '',
          sku: btn.dataset.sku ?? btn.dataset.productId ?? '',
          title: btn.dataset.title ?? '',
          slug: btn.dataset.slug ?? '',
          unitPrice: Number(btn.dataset.price ?? 0),
          image: btn.dataset.image || undefined,
          size: btn.dataset.size || undefined,
        });
        dispatchMeasurement({
          event: 'add_to_cart',
          ecommerce: {
            currency: 'USD',
            value: Number(btn.dataset.price ?? 0) / 100,
            items: [
              {
                item_id: btn.dataset.sku ?? btn.dataset.productId ?? '',
                item_name: btn.dataset.title ?? '',
                price: Number(btn.dataset.price ?? 0) / 100,
                quantity: 1,
              },
            ],
          },
        });
      });
    });

    document.querySelectorAll<HTMLElement>('[data-open-cart]').forEach((el) => {
      if (el.dataset.bound) return;
      el.dataset.bound = '1';
      el.addEventListener('click', (e) => {
        e.preventDefault();
        cartOpen.set(true);
      });
    });
  }

  function init(): void {
    bindDrawer();
    bindButtons();
  }

  init();
  document.addEventListener('swup:enable', init);
  document.addEventListener('swup:contentReplaced', init);
</script>
