---
import type { ServiceFaq } from '@/lib/ivHydrationLanding';

interface Props {
  readonly faqs: readonly ServiceFaq[];
}

const { faqs } = Astro.props;
---

<section id="faq" class="scroll-mt-32 bg-[#1C1E22] px-5 py-[clamp(84px,10vw,150px)] text-[#F1EDE5] sm:px-10 lg:px-16" aria-labelledby="iv-faq-title">
  <div class="mx-auto grid max-w-[1320px] gap-12 lg:grid-cols-[0.62fr_1.38fr] lg:gap-20">
    <div>
      <p class="iv-eyebrow">Questions, answered</p>
      <h2 id="iv-faq-title" class="mt-6 font-serif text-[clamp(48px,6vw,78px)] leading-[0.95] tracking-[-0.03em]">IV hydration,<br />plainly put.</h2>
      <p class="mt-7 max-w-[400px] text-[15px] leading-[1.75] text-[#BCB8B0]">For questions specific to your health or medications, speak with Diana Morrison, RN.</p>
    </div>
    <div class="border-t border-white/15">
      {faqs.map((faq, index) => (
        <details class="group border-b border-white/15">
          <summary class="grid cursor-pointer list-none grid-cols-[42px_1fr_26px] items-start gap-3 py-7 text-left sm:grid-cols-[54px_1fr_30px] sm:py-8">
            <span class="pt-1 font-serif text-[14px] text-[#A99F91]">{String(index + 1).padStart(2, '0')}</span>
            <span class="font-serif text-[21px] leading-[1.25] sm:text-[25px]">{faq.question}</span>
            <span class="relative mt-2 block h-4 w-4" aria-hidden="true">
              <span class="absolute left-0 top-1/2 h-px w-4 bg-[#C8BBA8]"></span>
              <span class="absolute left-1/2 top-0 h-4 w-px bg-[#C8BBA8] transition-transform duration-200 group-open:rotate-90 group-open:opacity-0"></span>
            </span>
          </summary>
          <p class="pb-8 pl-[57px] pr-7 text-[15px] leading-[1.78] text-[#C8C4BC] sm:pl-[70px] sm:pr-12">{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
