---
import ServicePhoneLink from '@/components/service-landing/ServicePhoneLink.astro';
import type { TreatmentOption } from '@/lib/ivHydrationLanding';

interface Props {
  readonly options: readonly TreatmentOption[];
}

const { options } = Astro.props;
---

<section id="iv-options" class="scroll-mt-32 bg-[#1C1E22] px-5 py-[clamp(84px,10vw,150px)] text-[#F1EDE5] sm:px-10 lg:px-16" aria-labelledby="iv-options-title">
  <div class="mx-auto max-w-[1320px]">
    <div class="grid gap-8 lg:grid-cols-[0.78fr_1.22fr] lg:items-end">
      <div>
        <p class="iv-eyebrow">Current IV options</p>
        <h2 id="iv-options-title" class="mt-6 max-w-[630px] font-serif text-[clamp(44px,6.4vw,86px)] leading-[0.95] tracking-[-0.03em]">
          Six ways to begin the conversation.
        </h2>
      </div>
      <p class="max-w-[590px] text-[16px] leading-[1.75] text-[#C9C5BE] lg:justify-self-end">
        Six bags, each built for a different reason to walk in. Open any of them for what is in the bag, what it helps with, what the visit is like, and who should talk with Diana Morrison, RN first.
      </p>
    </div>

    <ol class="mt-14 border-t border-white/15 lg:mt-20">
      {options.map((option, index) => (
        <li class="group relative grid grid-cols-[42px_1fr] gap-x-4 border-b border-white/15 py-7 transition-colors hover:bg-white/[0.03] focus-within:bg-white/[0.03] sm:grid-cols-[60px_1fr_auto] sm:items-center sm:gap-x-7 sm:py-9 lg:grid-cols-[84px_1fr_180px_170px] lg:py-10">
          <span class="font-serif text-[16px] text-[#9F9483] sm:text-[18px]">0{index + 1}</span>
          <div>
            <h3 class="font-serif text-[clamp(27px,3.2vw,48px)] leading-[1.05] transition-colors group-hover:text-[#D6C6AE]">
              <a href={option.href} class="after:absolute after:inset-0 focus-visible:outline-none">{option.name}</a>
            </h3>
            <p class="mt-3 max-w-[560px] text-[15px] leading-[1.6] text-[#B9B4AC]">{option.summary} <span class="whitespace-nowrap text-[#D6C6AE] underline decoration-[#8C6F3F] underline-offset-4 group-hover:text-white">Read about this IV <span aria-hidden="true">→</span></span></p>
          </div>
          <p class="col-start-2 mt-3 text-[11px] uppercase tracking-[0.18em] text-[#AAA59D] sm:col-start-3 sm:mt-0 lg:col-start-auto">
            {option.duration}
          </p>
          <ServicePhoneLink
            location={`service_iv_option_${index + 1}`}
            label="Book this IV"
            accessibleContext={option.name}
            class="relative z-10 col-start-2 mt-5 w-fit border-b border-[#8C6F3F] pb-1 text-[11px] font-medium uppercase tracking-[0.16em] text-[#E3D8C8] transition-colors hover:border-white hover:text-white focus-visible:border-white focus-visible:text-white sm:col-start-3 sm:row-start-2 sm:mt-2 lg:col-start-auto lg:row-start-auto lg:mt-0 lg:justify-self-end"
          />
        </li>
      ))}
    </ol>
    <p class="mt-7 text-[13px] leading-[1.7] text-[#AFAAA2]">Ask about current pricing when you call. Add-ons including vitamin C, B12, biotin, magnesium, glutathione, and NAD+ can be discussed at your visit.</p>
  </div>
</section>
