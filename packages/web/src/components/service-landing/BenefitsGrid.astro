---
import type { EditorialPoint } from '@/lib/ivHydrationLanding';

interface Props {
  readonly items: readonly EditorialPoint[];
}

const { items } = Astro.props;
---

<section class="bg-[#25282D] px-5 py-[clamp(74px,9vw,128px)] text-[#F1EDE5] sm:px-10 lg:px-16" aria-labelledby="why-iv-title">
  <div class="mx-auto max-w-[1440px]">
    <div class="grid gap-7 border-b border-white/10 pb-9 md:grid-cols-[0.7fr_1.3fr] md:items-end">
      <p class="iv-eyebrow">Why IV hydration</p>
      <h2 id="why-iv-title" class="max-w-[820px] font-serif text-[clamp(38px,5.2vw,70px)] leading-[1.02] tracking-[-0.02em]">
        What IV hydration involves.
      </h2>
    </div>
    <div class="grid md:grid-cols-2 xl:grid-cols-5">
      {items.map((item, index) => (
        <article class:list={[
          'border-b border-white/10 py-8 md:min-h-[250px] md:px-7 md:py-10 xl:border-b-0 xl:px-8',
          index % 2 === 1 ? 'md:border-l' : '',
          index > 1 ? 'md:border-t xl:border-t-0' : '',
          index > 0 ? 'xl:border-l xl:border-white/10' : '',
        ]}>
          <p class="font-serif text-[18px] text-[#C8BBA8]">0{index + 1}</p>
          <h3 class="mt-8 font-serif text-[26px] leading-tight">{item.title}</h3>
          <p class="mt-4 text-[14px] leading-[1.7] text-[#C7C3BC]">{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
