---
interface Props {
  readonly id?: string;
  readonly eyebrow: string;
  readonly heading: string;
  readonly paragraphs: readonly string[];
}

const { id, eyebrow, heading, paragraphs } = Astro.props;
---

<section id={id} class="scroll-mt-32 bg-[#1C1E22] px-5 py-[clamp(80px,10vw,150px)] text-[#F1EDE5] sm:px-10 lg:px-16">
  <div class="mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-[clamp(70px,10vw,170px)]">
    <div>
      <p class="iv-eyebrow">{eyebrow}</p>
      <h2 class="mt-6 max-w-[570px] font-serif text-[clamp(42px,6vw,78px)] leading-[0.98] tracking-[-0.025em]">
        {heading}
      </h2>
    </div>
    <div class="max-w-[670px] self-end lg:pt-20">
      {paragraphs.map((paragraph, index) => (
        <p class:list={[
          'text-[17px] leading-[1.8] text-[#D3CFC7] sm:text-[18px]',
          index > 0 ? 'mt-6' : '',
        ]}>{paragraph}</p>
      ))}
    </div>
  </div>
</section>
