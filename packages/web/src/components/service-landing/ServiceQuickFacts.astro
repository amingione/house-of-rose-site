---
import type { ServiceQuickFact } from '@/lib/ivHydrationLanding';

interface Props {
  readonly facts: readonly ServiceQuickFact[];
}

const { facts } = Astro.props;
---

<section aria-label="IV hydration appointment facts" class="border-y border-white/10 bg-[#15171A] text-[#F1EDE5]">
  <dl class="mx-auto grid max-w-[1728px] grid-cols-2 lg:grid-cols-4">
    {facts.map((fact, index) => (
      <div class:list={[
        'min-w-0 px-5 py-5 sm:px-8 sm:py-6 lg:px-10',
        index % 2 === 1 ? 'border-l border-white/10' : '',
        index >= 2 ? 'border-t border-white/10 lg:border-t-0' : '',
        index > 0 ? 'lg:border-l lg:border-white/10' : '',
      ]}>
        <dt class="text-[10px] uppercase tracking-[0.22em] text-[#9D9992]">{fact.label}</dt>
        <dd class="mt-2 text-[13px] leading-snug text-[#F1EDE5] sm:text-[14px]">{fact.value}</dd>
      </div>
    ))}
  </dl>
</section>
