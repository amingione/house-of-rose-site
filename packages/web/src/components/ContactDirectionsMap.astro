---
import 'mapbox-gl/dist/mapbox-gl.css';
import { sbFieldPath } from '@/lib/visualEditing';

interface Props {
  ctaText?: string;
}

const { ctaText = 'Get Directions' } = Astro.props;
const accessToken = import.meta.env.PUBLIC_MAPBOX_ACCESS_TOKEN?.trim();
---

<div class="directions-shell" data-directions-map data-mapbox-token={accessToken}>
  <div class="directions-controls">
    <div>
      <label class="directions-label" for="directions-search-host">Starting address</label>
      <div id="directions-search-host" class="search-host" data-directions-search></div>
      <p class="directions-help">Choose an address to see driving time and distance to House of Rose.</p>
    </div>

    <button type="button" class="location-button" data-use-location>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="3"></circle>
        <path d="M12 2v3M12 19v3M2 12h3M19 12h3"></path>
        <circle cx="12" cy="12" r="7"></circle>
      </svg>
      Use my location
    </button>
  </div>

  <div class="route-status" data-route-status role="status" aria-live="polite">
    <span>525 E Olympia Ave, Unit 9 · Punta Gorda, FL 33950</span>
  </div>

  <div class="map-frame">
    {accessToken ? (
      <div
        class="map-canvas"
        data-map-canvas
        role="region"
        aria-label="Interactive map showing House of Rose Aesthetics in Punta Gorda"
      ></div>
    ) : (
      <div class="map-fallback" role="status">
        <p>The interactive map is temporarily unavailable.</p>
        <p>Use one of the direction links below to plan your visit.</p>
      </div>
    )}
  </div>

  <div class="directions-actions">
    <a
      href="https://www.google.com/maps/dir/?api=1&destination=525%20E%20Olympia%20Ave%20Unit%209%2C%20Punta%20Gorda%2C%20FL%2033950&travelmode=driving"
      target="_blank"
      rel="noopener noreferrer"
      class="btn-outline-gold"
      data-google-directions
      {...sbFieldPath('mapCtaText')}
    >
      {ctaText}
    </a>
    <a
      href="https://maps.apple.com/?daddr=525%20E%20Olympia%20Ave%20Unit%209%2C%20Punta%20Gorda%2C%20FL%2033950&dirflg=d"
      target="_blank"
      rel="noopener noreferrer"
      class="text-link"
      data-apple-directions
    >
      Open in Apple Maps
    </a>
  </div>
</div>

<script>
  import type { Feature, LineString } from 'geojson';
  import type { GeoJSONSource, Marker } from 'mapbox-gl';

  const DESTINATION: [number, number] = [-82.0454, 26.9298];
  const DESTINATION_ADDRESS = '525 E Olympia Ave, Unit 9, Punta Gorda, FL 33950';
  const ROUTE_SOURCE_ID = 'house-of-rose-route';
  const ROUTE_LAYER_ID = 'house-of-rose-route-line';
  const initializedRoots = new WeakSet<HTMLElement>();
  const observedRoots = new WeakSet<HTMLElement>();

  interface DirectionsRoute {
    distance: number;
    duration: number;
    geometry: LineString;
  }

  interface DirectionsResponse {
    code?: string;
    message?: string;
    routes?: DirectionsRoute[];
  }

  const formatDistance = (meters: number): string => {
    const miles = meters / 1609.344;
    return `${miles < 10 ? miles.toFixed(1) : Math.round(miles)} mi`;
  };

  const formatDuration = (seconds: number): string => {
    const totalMinutes = Math.max(1, Math.round(seconds / 60));
    if (totalMinutes < 60) return `${totalMinutes} min`;

    const hours = Math.floor(totalMinutes / 60);
    const minutes = totalMinutes % 60;
    return minutes > 0 ? `${hours} hr ${minutes} min` : `${hours} hr`;
  };

  const updateExternalLinks = (
    root: HTMLElement,
    origin?: [number, number],
  ): void => {
    const originQuery = origin ? `${origin[1]},${origin[0]}` : undefined;
    const google = root.querySelector<HTMLAnchorElement>('[data-google-directions]');
    const apple = root.querySelector<HTMLAnchorElement>('[data-apple-directions]');

    if (google) {
      const url = new URL('https://www.google.com/maps/dir/');
      url.searchParams.set('api', '1');
      if (originQuery) url.searchParams.set('origin', originQuery);
      url.searchParams.set('destination', DESTINATION_ADDRESS);
      url.searchParams.set('travelmode', 'driving');
      google.href = url.toString();
    }

    if (apple) {
      const url = new URL('https://maps.apple.com/');
      if (originQuery) url.searchParams.set('saddr', originQuery);
      url.searchParams.set('daddr', DESTINATION_ADDRESS);
      url.searchParams.set('dirflg', 'd');
      apple.href = url.toString();
    }
  };

  async function initDirectionsMap(root: HTMLElement): Promise<void> {
    if (initializedRoots.has(root)) return;

    initializedRoots.add(root);
    const accessToken = root.dataset.mapboxToken?.trim();
    const mapContainer = root.querySelector<HTMLElement>('[data-map-canvas]');
    const searchHost = root.querySelector<HTMLElement>('[data-directions-search]');
    const locationButton = root.querySelector<HTMLButtonElement>('[data-use-location]');
    const status = root.querySelector<HTMLElement>('[data-route-status]');

    if (!accessToken || !mapContainer || !searchHost || !status) {
      if (locationButton) locationButton.hidden = true;
      return;
    }

    const [{ default: mapboxgl }, { MapboxSearchBox }] = await Promise.all([
      import('mapbox-gl'),
      import('@mapbox/search-js-web'),
    ]);

    mapboxgl.accessToken = accessToken;

    const map = new mapboxgl.Map({
      container: mapContainer,
      style: 'mapbox://styles/mapbox/light-v11',
      center: DESTINATION,
      zoom: 14.6,
      cooperativeGestures: true,
      attributionControl: false,
    });

    map.addControl(new mapboxgl.NavigationControl({ showCompass: false }), 'top-right');
    map.addControl(new mapboxgl.FullscreenControl(), 'top-right');
    map.addControl(new mapboxgl.AttributionControl({ compact: true }), 'bottom-right');

    const popup = new mapboxgl.Popup({ offset: 24, closeButton: false }).setHTML(
      '<strong>House of Rose Aesthetics</strong><br>525 E Olympia Ave, Unit 9<br>Punta Gorda, FL 33950',
    );

    new mapboxgl.Marker({ color: '#3F4D3A' })
      .setLngLat(DESTINATION)
      .setPopup(popup)
      .addTo(map);

    const searchBox = new MapboxSearchBox();
    searchBox.accessToken = accessToken;
    searchBox.placeholder = 'Enter your starting address';
    searchBox.options = {
      language: 'en',
      country: 'US',
      proximity: DESTINATION,
      types: new Set(['address', 'street', 'place', 'locality']),
      limit: 6,
    };
    searchBox.componentOptions = { allowReverse: false };
    searchBox.theme = {
      variables: {
        unit: '15px',
        colorText: '#14110F',
        colorPrimary: '#3F4D3A',
        colorSecondary: '#5E5548',
        colorBackground: '#F8F4EC',
        colorBackgroundHover: '#EADFCB',
        colorBackgroundActive: '#EADBC2',
        border: '1px solid rgba(20, 17, 15, 0.2)',
        borderRadius: '0',
        boxShadow: '0 12px 30px rgba(20, 17, 15, 0.14)',
        fontFamily: 'system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
        lineHeight: '1.45',
      },
    };
    // Search JS extends HTMLElement at runtime, but its narrow event overloads make
    // TypeScript reject it as a generic Node. Keep the boundary cast local.
    searchHost.appendChild(searchBox as unknown as HTMLElement);

    const syncSearchComboboxState = (): void => {
      const combobox = searchHost.querySelector<HTMLInputElement>('[role="combobox"]');
      if (!combobox) return;

      const controlledId = combobox.getAttribute('aria-controls');
      const results = controlledId ? document.getElementById(controlledId) : null;
      const resultsContainer = results?.closest<HTMLElement>('[aria-hidden]');
      const resultsAreVisible = Boolean(
        results
        && results.getClientRects().length > 0
        && resultsContainer?.getAttribute('aria-hidden') !== 'true',
      );
      if (!combobox.hasAttribute('aria-expanded')) {
        combobox.setAttribute('aria-expanded', resultsAreVisible ? 'true' : 'false');
      }

      if (resultsContainer?.getAttribute('aria-hidden') === 'true') {
        resultsContainer.querySelectorAll<HTMLElement>('[tabindex="0"]').forEach((element) => {
          element.tabIndex = -1;
        });
      }
    };
    syncSearchComboboxState();

    // Mapbox manages the open state, but its initial render omits the combobox
    // attribute and closed results can retain a tabbable option. Repair both when
    // a runtime render drops the required state.
    const searchAccessibilityObserver = new MutationObserver(syncSearchComboboxState);
    searchAccessibilityObserver.observe(searchHost, {
      attributes: true,
      attributeFilter: ['aria-expanded', 'aria-hidden', 'tabindex'],
      childList: true,
      subtree: true,
    });

    let originMarker: Marker | undefined;
    let routeRequest: AbortController | undefined;

    const mapReady = new Promise<void>((resolve) => {
      if (map.loaded()) {
        resolve();
        return;
      }
      map.once('load', () => resolve());
    });

    const setStatus = (message: string, state: 'idle' | 'loading' | 'success' | 'error'): void => {
      status.textContent = message;
      status.dataset.state = state;
    };

    const drawRoute = async (
      origin: [number, number],
      originLabel: string,
    ): Promise<void> => {
      routeRequest?.abort();
      routeRequest = new AbortController();
      setStatus(`Calculating the drive from ${originLabel}…`, 'loading');
      locationButton?.setAttribute('aria-busy', 'true');

      try {
        const coordinates = `${origin[0]},${origin[1]};${DESTINATION[0]},${DESTINATION[1]}`;
        const url = new URL(`https://api.mapbox.com/directions/v5/mapbox/driving/${coordinates}`);
        url.searchParams.set('alternatives', 'false');
        url.searchParams.set('geometries', 'geojson');
        url.searchParams.set('overview', 'full');
        url.searchParams.set('steps', 'false');
        url.searchParams.set('access_token', accessToken);

        const response = await fetch(url, { signal: routeRequest.signal });
        if (!response.ok) throw new Error(`Directions request failed (${response.status})`);

        const result = (await response.json()) as DirectionsResponse;
        const route = result.routes?.[0];
        if (!route) throw new Error(result.message ?? 'No driving route was found.');

        await mapReady;

        const routeFeature: Feature<LineString> = {
          type: 'Feature',
          properties: {},
          geometry: route.geometry,
        };

        const existingSource = map.getSource(ROUTE_SOURCE_ID) as GeoJSONSource | undefined;
        if (existingSource) {
          existingSource.setData(routeFeature);
        } else {
          map.addSource(ROUTE_SOURCE_ID, { type: 'geojson', data: routeFeature });
          map.addLayer({
            id: ROUTE_LAYER_ID,
            type: 'line',
            source: ROUTE_SOURCE_ID,
            layout: { 'line-cap': 'round', 'line-join': 'round' },
            paint: {
              'line-color': '#7A5C2A',
              'line-width': 5,
              'line-opacity': 0.9,
            },
          });
        }

        originMarker?.remove();
        originMarker = new mapboxgl.Marker({ color: '#7A5C2A', scale: 0.8 })
          .setLngLat(origin)
          .addTo(map);

        const bounds = new mapboxgl.LngLatBounds(origin, origin).extend(DESTINATION);
        map.fitBounds(bounds, {
          padding: { top: 72, right: 72, bottom: 72, left: 72 },
          maxZoom: 14,
          duration: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 900,
        });

        updateExternalLinks(root, origin);
        setStatus(
          `${formatDuration(route.duration)} drive · ${formatDistance(route.distance)} from ${originLabel}`,
          'success',
        );
      } catch (error) {
        if (error instanceof DOMException && error.name === 'AbortError') return;
        setStatus(
          'We could not calculate that route. Try another address or open directions below.',
          'error',
        );
      } finally {
        locationButton?.removeAttribute('aria-busy');
      }
    };

    searchBox.addEventListener('retrieve', (event) => {
      const feature = event.detail.features[0];
      if (!feature) return;

      const [longitude, latitude] = feature.geometry.coordinates;
      if (!Number.isFinite(longitude) || !Number.isFinite(latitude)) return;

      const label = feature.properties.full_address
        || feature.properties.name
        || 'your starting point';
      void drawRoute([longitude, latitude], label);
    });

    searchBox.addEventListener('clear', () => {
      routeRequest?.abort();
      originMarker?.remove();
      originMarker = undefined;
      if (map.getLayer(ROUTE_LAYER_ID)) map.removeLayer(ROUTE_LAYER_ID);
      if (map.getSource(ROUTE_SOURCE_ID)) map.removeSource(ROUTE_SOURCE_ID);
      const resetView = { center: DESTINATION, zoom: 14.6 } as const;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        map.jumpTo(resetView);
      } else {
        map.flyTo(resetView);
      }
      updateExternalLinks(root);
      setStatus(DESTINATION_ADDRESS, 'idle');
    });

    locationButton?.addEventListener('click', () => {
      if (!navigator.geolocation) {
        setStatus('Location services are not available in this browser.', 'error');
        return;
      }

      setStatus('Finding your current location…', 'loading');
      locationButton.setAttribute('aria-busy', 'true');
      navigator.geolocation.getCurrentPosition(
        (position) => {
          const origin: [number, number] = [position.coords.longitude, position.coords.latitude];
          searchBox.value = 'Current location';
          void drawRoute(origin, 'your current location');
        },
        () => {
          locationButton.removeAttribute('aria-busy');
          setStatus(
            'We could not access your location. Enter a starting address instead.',
            'error',
          );
        },
        { enableHighAccuracy: false, timeout: 8000, maximumAge: 300000 },
      );
    });

    document.addEventListener(
      'astro:before-swap',
      () => {
        searchAccessibilityObserver.disconnect();
        routeRequest?.abort();
        map.remove();
      },
      { once: true },
    );
  }

  function scheduleDirectionsMap(): void {
    const root = document.querySelector<HTMLElement>('[data-directions-map]');
    if (!root || observedRoots.has(root)) return;

    observedRoots.add(root);
    if (!('IntersectionObserver' in window)) {
      void initDirectionsMap(root);
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        void initDirectionsMap(root);
      },
      { rootMargin: '500px 0px' },
    );
    observer.observe(root);
  }

  scheduleDirectionsMap();
</script>

<style>
  .directions-shell {
    @apply max-w-[960px] mx-auto;
  }

  .directions-controls {
    @apply grid grid-cols-1 md:grid-cols-[1fr_auto] gap-4 md:items-end mb-4;
  }

  .directions-label {
    @apply block text-gold text-[11px] font-medium tracking-[0.26em] uppercase mb-2;
  }

  .search-host {
    @apply min-h-[52px] relative z-10;
  }

  .search-host :global(mapbox-search-box) {
    display: block;
    width: 100%;
  }

  .search-host :global(mapbox-search-box button[aria-label='Clear']) {
    min-width: 24px;
    min-height: 24px;
  }

  .directions-help {
    @apply text-muted text-[12px] mt-2;
  }

  .location-button {
    @apply inline-flex items-center justify-center gap-2 min-h-[52px] px-5 border border-gold text-gold text-[12px] font-medium tracking-[0.14em] uppercase transition-colors hover:bg-gold-metal hover:border-gold-metal hover:text-ink;
  }

  .location-button svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .location-button[aria-busy='true'] {
    @apply opacity-60 cursor-wait;
  }

  .route-status {
    @apply min-h-[44px] flex items-center px-4 mb-4 bg-breath border border-ink/10 text-muted text-[13px];
  }

  .route-status[data-state='success'] {
    @apply border-green-sage/50 text-green-sage;
  }

  .route-status[data-state='error'] {
    color: #f87171;
    border-color: rgb(248 113 113 / 0.45);
  }

  .map-frame {
    @apply relative overflow-hidden bg-charcoal-lighter border border-gold-metal/25;
    height: clamp(360px, 55vw, 560px);
  }

  .map-canvas {
    width: 100%;
    height: 100%;
  }

  .map-fallback {
    @apply h-full min-h-[360px] flex flex-col items-center justify-center gap-2 px-6 text-center text-muted text-[14px];
  }

  .directions-actions {
    @apply flex flex-col sm:flex-row items-center justify-center gap-5 mt-8;
  }

  .text-link {
    @apply text-gold text-[12px] font-medium tracking-[0.14em] uppercase underline-offset-4 hover:underline;
  }

  :global(.mapboxgl-popup-content) {
    background: #f8f4ec;
    color: #14110f;
    border: 1px solid rgb(201 162 75 / 0.35);
    border-radius: 0;
    box-shadow: 0 12px 30px rgb(20 17 15 / 0.18);
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 13px;
    line-height: 1.5;
    padding: 12px 14px;
  }

  :global(.mapboxgl-popup-tip) {
    border-top-color: #f8f4ec !important;
  }

  :global(.mapboxgl-ctrl-group) {
    border-radius: 0;
    box-shadow: 0 4px 16px rgb(20 17 15 / 0.16);
  }

  @media (max-width: 639px) {
    .location-button,
    .directions-actions :global(a) {
      width: 100%;
    }
  }
</style>
