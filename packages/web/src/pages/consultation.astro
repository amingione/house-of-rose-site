---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import type { FAQ } from '@/lib/queries';
import {
  LOCAL_BUSINESS,
  breadcrumbList,
  faqPage,
  service as serviceJsonLd,
} from '@/lib/structuredData';

const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonicalURL = new URL(Astro.url.pathname, site);
const heroImage = '/images/welcome-house-of-rose.webp';
const socialImage = new URL(heroImage, site).toString();
const phoneDisplay = '(844) 941-7673';
const phoneHref = `tel:${LOCAL_BUSINESS.telephone}`;
const addressLine = `${LOCAL_BUSINESS.streetAddress}, ${LOCAL_BUSINESS.addressLocality}, ${LOCAL_BUSINESS.addressRegion} ${LOCAL_BUSINESS.postalCode}`;
const pageDescription =
  'Talk through skin, injectable, and wellness options with House of Rose in Punta Gorda, then choose a next step that fits your goals.';

const faqs: FAQ[] = [
  {
    question: 'Do I need to know which treatment to book?',
    answer:
      'No. Tell us what you would like to improve, maintain, or understand better. House of Rose will help you identify an appropriate starting point based on your goals, relevant history, timing, recovery preferences, and candidacy.',
  },
  {
    question: 'What happens during an aesthetics consultation?',
    answer:
      'Your consultation begins with a conversation about your goals and priorities. We review the options that may fit, explain what each approach involves, and identify the next step. Final recommendations, treatment combinations, and candidacy are confirmed by the appropriate licensed provider.',
  },
  {
    question: 'What happens during an AI skin analysis?',
    answer:
      'House of Rose uses non-invasive, AI-assisted imaging to give you a closer look at texture, hydration, pores, pigmentation, fine lines, and visible sun exposure. We review the images with you and explain how they may relate to your skin goals.',
  },
  {
    question: 'What can I ask about?',
    answer:
      'You can ask about AI skin analysis, facials, peels, Botox or Daxxify, dermal fillers, PRF, procell Microchanneling, microneedling, Morpheus8, Forma, Lumecca Peak, IV hydration, or provider-guided weight management. You can also select “Help me choose” on the form.',
  },
  {
    question: 'Do you take walk-ins?',
    answer:
      `Yes. Walk-ins are welcome for waxing and facials. Other services may be available when the schedule allows. Appointments are recommended to guarantee a time; call ${phoneDisplay} to check availability.`,
  },
];

const serviceSchema = serviceJsonLd(
  {
    name: 'Aesthetics Consultation in Punta Gorda',
    description:
      'Advanced aesthetics and wellness consultations at House of Rose Aesthetics in Punta Gorda, Florida.',
    url: canonicalURL.toString(),
    image: socialImage,
    serviceType: 'Advanced aesthetics and wellness consultation',
  },
  site,
);

const breadcrumbSchema = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'Consultation', item: canonicalURL.toString() },
]);

const faqSchema = faqPage(faqs);

const startingPoints = [
  {
    eyebrow: 'A closer look at your skin',
    title: 'AI skin analysis',
    description:
      'See texture, hydration, pores, pigmentation, fine lines, and visible sun exposure more clearly before deciding what to book.',
    href: '/skin-analysis/',
    linkLabel: 'Explore AI skin analysis',
  },
  {
    eyebrow: 'Balanced, provider-guided care',
    title: 'Injectables',
    description:
      'Explore Botox, Daxxify, dermal fillers, or injectable PRF through a consultation centered on balance and natural-looking goals.',
    href: '#consultation',
    linkLabel: 'Ask about injectables',
  },
  {
    eyebrow: 'Skin renewal + technology',
    title: 'Advanced skin treatments',
    description:
      'Compare regenerative and technology-led options such as PRF, procell, microneedling, Morpheus8, Forma, and Lumecca Peak.',
    href: '#consultation',
    linkLabel: 'Ask about advanced skin care',
  },
  {
    eyebrow: 'Support from within',
    title: 'Wellness',
    description:
      'Start a conversation about IV hydration or provider-guided weight management, including screening and follow-up.',
    href: '#consultation',
    linkLabel: 'Ask about wellness',
  },
] as const;

const consultationSteps = [
  {
    title: 'Tell us your goal',
    description:
      'Start with what you want to improve, maintain, or better understand. You do not need to name a treatment.',
  },
  {
    title: 'Review the right options',
    description:
      'We consider your priorities, relevant history, timing, recovery preferences, and candidacy.',
  },
  {
    title: 'Leave with a next step',
    description:
      'You receive clear guidance on the most appropriate starting point, without pressure to choose everything at once.',
  },
] as const;
---

<BaseLayout
  title="Aesthetics Consultation | Punta Gorda, FL"
  description={pageDescription}
  image={socialImage}
  imageAlt="House of Rose Aesthetics welcome area in Punta Gorda, Florida"
  preloadImage={heroImage}
  chrome="landing"
>
  <SchemaMarkup item={serviceSchema} slot="head" />
  <SchemaMarkup item={breadcrumbSchema} slot="head" />
  {faqSchema && <SchemaMarkup item={faqSchema} slot="head" />}

  <header class="border-b border-gold-metal/25 bg-breath">
    <div
      class="mx-auto flex h-[76px] max-w-[1280px] items-center justify-between gap-5 px-5 sm:h-[88px] sm:px-8"
    >
      <a href="/" aria-label="House of Rose Aesthetics home">
        <img
          src="/logos/house-of-rose-monogram/hr-logo-gold.webp"
          alt="House of Rose Aesthetics"
          width="512"
          height="520"
          class="h-12 w-auto sm:h-14"
        />
      </a>
      <div class="flex items-center gap-5 text-[13px] sm:gap-7 sm:text-[15px]">
        <a href={phoneHref} class="border-b border-gold pb-1 font-serif text-ink hover:text-gold">
          Call <span class="hidden sm:inline">{phoneDisplay}</span><span class="sm:hidden">us</span>
        </a>
      </div>
    </div>
  </header>

  <div class="bg-breath pb-20 text-ink md:pb-0">
    <section class="border-b border-gold-metal/30">
      <div class="mx-auto grid max-w-[1440px] lg:min-h-[680px] lg:grid-cols-[0.95fr_1.05fr]">
        <div class="order-2 flex items-center px-5 py-12 sm:px-8 sm:py-16 lg:order-1 lg:py-20 lg:pl-[clamp(48px,6vw,96px)] lg:pr-12">
          <div class="max-w-[620px]">
            <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-gold sm:text-[12px]">
              Advanced aesthetics &amp; wellness · Punta Gorda
            </p>
            <h1 class="mt-5 font-display text-[clamp(48px,5.6vw,76px)] leading-[0.98] tracking-[-0.025em]">
              Get clear on your options.
            </h1>
            <p class="mt-7 max-w-[560px] text-[17px] leading-[1.75] text-muted-strong sm:text-[18px]">
              You do not need to arrive knowing which treatment to book. Tell us
              what you want to improve, and we will talk through the options that
              fit your goals, timing, recovery preferences, and candidacy.
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a href="#consultation" class="btn-gold sm:min-w-[250px]">
                Request a consultation
              </a>
              <a href={phoneHref} class="btn-outline-gold sm:min-w-[190px]">
                Call {phoneDisplay}
              </a>
            </div>
            <ul class="mt-8 grid gap-3 text-[13px] leading-relaxed text-muted-strong sm:grid-cols-3">
              <li class="flex items-start gap-2">
                <span class="mt-1 text-gold" aria-hidden="true">◆</span>
                Clear guidance
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-1 text-gold" aria-hidden="true">◆</span>
                Licensed-provider review
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-1 text-gold" aria-hidden="true">◆</span>
                Walk-ins welcome
              </li>
            </ul>
            <p class="mt-7 flex items-start gap-2 text-[12px] leading-relaxed text-muted sm:text-[13px]">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-gold" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 21s7-6.1 7-12a7 7 0 1 0-14 0c0 5.9 7 12 7 12Z" stroke="currentColor" stroke-width="1.6"/>
                <circle cx="12" cy="9" r="2.35" stroke="currentColor" stroke-width="1.6"/>
              </svg>
              <span>{addressLine} · Monday–Friday, 9 AM–5 PM</span>
            </p>
          </div>
        </div>

        <div class="hero-media relative order-1 min-h-[38svh] overflow-hidden bg-walnut sm:min-h-[46svh] lg:order-2 lg:min-h-full">
          <img
            src={heroImage}
            alt="House of Rose Aesthetics studio lounge in Punta Gorda"
            width="1920"
            height="1440"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="absolute inset-0 h-full w-full object-cover object-center"
          />
          <div class="absolute bottom-5 left-5 right-5 border border-ivory/35 bg-walnut/80 px-5 py-4 text-ivory backdrop-blur-sm sm:bottom-8 sm:left-8 sm:right-auto sm:max-w-[360px] sm:px-6">
            <p class="text-[10px] font-semibold uppercase tracking-[0.22em] text-gold">
              Not sure where to start?
            </p>
            <p class="mt-2 font-serif text-[20px] leading-snug">
              AI-assisted skin analysis can help you understand what your skin is showing.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="consultation" class="scroll-mt-4 bg-walnut px-5 py-[clamp(56px,7vw,88px)] sm:px-8">
      <div class="mx-auto grid max-w-[1180px] gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:gap-16">
        <div class="on-dark lg:pt-5">
          <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-gold">
            Your next step
          </p>
          <h2 id="consultation-heading" class="mt-4 font-display text-[clamp(40px,5vw,62px)] leading-[1.02] text-ivory">
            Request your consultation
          </h2>
          <p class="mt-6 max-w-[440px] text-[15px] leading-[1.8] text-muted">
            Share the best way to reach you and what you would like to explore.
            Our team will follow up to help coordinate the right appointment.
          </p>
          <div class="mt-8 border-t border-gold-metal/40 pt-7">
            <p class="font-serif text-[20px] text-ivory">Prefer to talk now?</p>
            <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-[14px]">
              <a href={phoneHref} class="border-b border-gold text-ivory hover:text-gold">
                Call {phoneDisplay}
              </a>
            </div>
          </div>
        </div>

        <form
          name="general-consultation"
          method="POST"
          action="/.netlify/functions/lead-submit"
          data-netlify="true"
          aria-labelledby="consultation-heading"
          class="form-card bg-breath p-6 sm:p-8 lg:p-10"
        >
          <input type="hidden" name="form-name" value="general-consultation" />
          <input type="hidden" name="source-page" value="/consultation/" />
          <p class="hidden" aria-hidden="true">
            <label>Do not fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="consultation-name" class="mb-2 block text-[13px] font-medium text-ink">
                Name
              </label>
              <input
                id="consultation-name"
                name="name"
                type="text"
                required
                autocomplete="name"
                placeholder="Your name"
                class="landing-input"
              />
            </div>
            <div>
              <label for="consultation-email" class="mb-2 block text-[13px] font-medium text-ink">
                Email
              </label>
              <input
                id="consultation-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                inputmode="email"
                placeholder="you@example.com"
                class="landing-input"
              />
            </div>
            <div>
              <label for="consultation-phone" class="mb-2 block text-[13px] font-medium text-ink">
                Phone
              </label>
              <input
                id="consultation-phone"
                name="phone"
                type="tel"
                required
                autocomplete="tel"
                inputmode="tel"
                placeholder="(555) 555-5555"
                class="landing-input"
              />
            </div>
            <div>
              <label for="consultation-service" class="mb-2 block text-[13px] font-medium text-ink">
                What would you like to explore?
              </label>
              <select id="consultation-service" name="service-interest" required class="landing-input">
                <option value="Help me choose the right starting point">Help me choose</option>
                <option value="AI skin analysis">AI Skin Analysis</option>
                <option value="Botox, Daxxify, fillers, or injectable PRF">Botox, Daxxify, Fillers, or PRF</option>
                <option value="PRF, procell, or microneedling">PRF, procell, or Microneedling</option>
                <option value="Morpheus8, Forma, or Lumecca Peak">Morpheus8, Forma, or Lumecca Peak</option>
                <option value="Facials or chemical peels">Facials or Chemical Peels</option>
                <option value="IV hydration">IV Hydration</option>
                <option value="Provider-guided weight management">Provider-Guided Weight Management</option>
              </select>
            </div>
          </div>

          <button type="submit" class="btn-gold mt-6 w-full">
            Request my consultation
          </button>
          <div class="mt-5 grid gap-2 border-t border-gold-metal/35 pt-5 text-[12px] leading-[1.6] text-muted sm:grid-cols-2">
            <p>Appointments are recommended to reserve your preferred time.</p>
            <p class="sm:text-right">
              Your information is used only to respond to your request.
              <a href="/privacy-policy/" class="border-b border-gold text-ink hover:text-gold">
                Privacy Policy
              </a>
            </p>
          </div>
        </form>
      </div>
    </section>

    <section class="border-b border-gold-metal/30 px-5 py-[clamp(64px,8vw,104px)] sm:px-8">
      <div class="mx-auto max-w-[1180px]">
        <div class="mx-auto max-w-[760px] text-center">
          <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-gold">
            What happens next
          </p>
          <h2 class="mt-4 font-display text-[clamp(38px,5vw,58px)] leading-[1.04]">
            The right questions make the options easier to understand
          </h2>
        </div>
        <ol class="mt-12 grid gap-8 md:grid-cols-3 md:gap-0 md:divide-x md:divide-gold-metal/40">
          {
            consultationSteps.map((step, index) => (
              <li class="md:px-9 first:pl-0 last:pr-0">
                <p class="font-display text-[34px] leading-none text-gold">
                  {String(index + 1).padStart(2, '0')}
                </p>
                <h3 class="mt-5 font-serif text-[24px] leading-tight">{step.title}</h3>
                <p class="mt-4 text-[14px] leading-[1.75] text-muted-strong">{step.description}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="px-5 py-[clamp(64px,8vw,108px)] sm:px-8">
      <div class="mx-auto max-w-[1180px]">
        <div class="max-w-[760px]">
          <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-gold">
            Choose a starting point—or let us help
          </p>
          <h2 class="mt-4 font-display text-[clamp(38px,5vw,60px)] leading-[1.04]">
            Start with your goal. We can help with the treatment name.
          </h2>
          <p class="mt-6 text-[16px] leading-[1.8] text-muted-strong">
            House of Rose offers advanced skin, injectable, and wellness
            services in one Punta Gorda studio. The consultation helps you sort
            through those choices and focus on what is relevant to you.
          </p>
        </div>

        <div class="mt-12 grid gap-px overflow-hidden border border-gold-metal/45 bg-gold-metal/45 lg:grid-cols-2">
          {
            startingPoints.map((point) => (
              <article class="flex min-h-[300px] flex-col bg-breath p-7 sm:p-9">
                <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-gold">
                  {point.eyebrow}
                </p>
                <h3 class="mt-4 font-serif text-[28px] leading-tight">{point.title}</h3>
                <p class="mt-5 text-[14px] leading-[1.75] text-muted-strong">
                  {point.description}
                </p>
                <a href={point.href} class="mt-auto inline-flex min-h-11 items-end pt-7 text-[12px] font-semibold uppercase tracking-[0.16em] text-gold hover:text-ink">
                  {point.linkLabel}
                  <span class="ml-2" aria-hidden="true">→</span>
                </a>
              </article>
            ))
          }
        </div>

        <p class="mx-auto mt-8 max-w-[880px] text-center text-[13px] leading-[1.75] text-muted">
          Not every client is a candidate for every service. Final treatment
          combinations and candidacy are confirmed by the appropriate licensed
          provider based on contraindications and local regulations. Outcomes
          are individual and depend on your skin, candidacy, and consistency.
        </p>
      </div>
    </section>

    <section class="grid border-y border-gold-metal/30 bg-breath lg:grid-cols-[1.04fr_0.96fr]">
      <div class="min-h-[380px] overflow-hidden lg:min-h-[590px]">
        <img
          src="/images/hor-skin-studio.webp"
          alt="A treatment room at House of Rose Aesthetics in Punta Gorda"
          width="1448"
          height="1086"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>
      <div class="flex items-center px-5 py-14 sm:px-10 lg:px-[clamp(48px,6vw,88px)] lg:py-20">
        <div class="max-w-[520px]">
          <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-gold">
            The House of Rose approach
          </p>
          <h2 class="mt-4 font-display text-[clamp(40px,5vw,60px)] leading-[1.04]">
            A real conversation before any recommendation
          </h2>
          <div class="my-7 h-px w-32 bg-gold-metal"></div>
          <ul class="space-y-5 text-[15px] leading-[1.75] text-muted-strong">
            <li class="flex gap-3">
              <span class="text-gold" aria-hidden="true">◆</span>
              Recommendations that account for your priorities, timing, and comfort with recovery.
            </li>
            <li class="flex gap-3">
              <span class="text-gold" aria-hidden="true">◆</span>
              An honest comparison when more than one treatment could fit.
            </li>
            <li class="flex gap-3">
              <span class="text-gold" aria-hidden="true">◆</span>
              Clear expectations and a practical next step.
            </li>
          </ul>
          <a href="#consultation" class="btn-gold mt-8">Request a consultation</a>
        </div>
      </div>
    </section>

    <section class="px-5 py-[clamp(64px,8vw,108px)] sm:px-8">
      <div class="mx-auto grid max-w-[1180px] gap-12 lg:grid-cols-[0.72fr_1.28fr] lg:gap-20">
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-gold">
            Before you request
          </p>
          <h2 class="mt-4 font-display text-[clamp(40px,5vw,62px)] leading-[1.03]">
            Consultation questions, answered
          </h2>
        </div>
        <div class="border-t border-gold-metal/50">
          {
            faqs.map((faq, index) => (
              <details class="faq-row group border-b border-gold-metal/50" open={index === 0}>
                <summary class="flex min-h-[72px] cursor-pointer list-none items-center gap-4 py-5 font-serif text-[19px] leading-snug sm:text-[21px]">
                  <svg class="h-5 w-5 shrink-0 text-gold transition-transform duration-200 group-open:rotate-45" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path d="M10 3v14M3 10h14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                  </svg>
                  <span>{faq.question}</span>
                </summary>
                <p class="pb-7 pl-9 text-[15px] leading-[1.8] text-muted-strong">
                  {faq.answer}
                </p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="on-dark bg-walnut px-5 py-[clamp(56px,7vw,84px)] text-center sm:px-8">
      <div class="mx-auto max-w-[760px]">
        <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-gold">
          Ready when you are
        </p>
        <h2 class="mt-4 font-display text-[clamp(40px,5vw,62px)] leading-[1.03] text-ivory">
          Tell us what you are considering
        </h2>
        <p class="mx-auto mt-5 max-w-[620px] text-[15px] leading-[1.8] text-muted">
          Share what you would like to explore. We will help you narrow the
          options and coordinate a time.
        </p>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <a href="#consultation" class="btn-gold sm:min-w-[250px]">
            Request a consultation
          </a>
          <a href="https://houseofrose.glossgenius.com/services" target="_blank" rel="noopener noreferrer" class="btn-outline-white sm:min-w-[190px]">
            View Services
          </a>
        </div>
      </div>
    </section>
  </div>

  <footer class="on-dark bg-walnut px-5 py-10 sm:px-8">
    <div class="mx-auto grid max-w-[1180px] gap-8 border-t border-gold-metal/35 pt-9 md:grid-cols-[0.75fr_1fr_auto] md:items-center">
      <div>
        <p class="font-display text-[25px] tracking-[0.08em] text-gold">
          House of Rose
        </p>
        <p class="mt-1 text-[10px] uppercase tracking-[0.28em] text-muted">
          Aesthetics
        </p>
      </div>
      <address class="not-italic text-[12px] leading-[1.8] text-muted">
        {addressLine}<br />
        <a href={phoneHref} class="hover:text-gold">{phoneDisplay}</a>
      </address>
      <nav aria-label="Legal" class="flex gap-5 text-[12px] text-muted md:flex-col md:gap-2">
        <a href="/privacy-policy/" class="hover:text-gold">Privacy Policy</a>
        <a href="/terms-of-service/" class="hover:text-gold">Terms</a>
      </nav>
    </div>
  </footer>

  <div class="fixed inset-x-0 bottom-0 z-40 border-t border-gold-metal/40 bg-breath p-3 md:hidden">
    <a href="#consultation" class="btn-gold w-full shadow-lg">
      Request a consultation
    </a>
  </div>
</BaseLayout>

<style>
  .hero-media::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 28%;
    pointer-events: none;
    background: linear-gradient(to top, rgba(20, 17, 15, 0.38), transparent);
  }

  .form-card {
    box-shadow: 0 28px 70px rgba(10, 8, 7, 0.22);
  }

  .landing-input {
    width: 100%;
    min-height: 52px;
    border: 1px solid rgba(122, 92, 42, 0.48);
    background: rgba(255, 255, 255, 0.68);
    padding: 0.8rem 0.95rem;
    color: #14110f;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 0.9375rem;
    line-height: 1.4;
    transition: border-color 160ms ease, box-shadow 160ms ease, background-color 160ms ease;
  }

  .landing-input::placeholder {
    color: #6d6458;
    opacity: 1;
  }

  .landing-input:focus-visible {
    border-color: #7a5c2a;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(122, 92, 42, 0.16);
    outline: none;
  }

  .faq-row summary::-webkit-details-marker {
    display: none;
  }

  @media (min-width: 1024px) {
    .hero-media::after {
      inset: 0 auto 0 0;
      width: 16%;
      height: 100%;
