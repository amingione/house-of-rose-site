---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import type { FAQ } from '@/lib/queries';
import {
  breadcrumbList,
  faqPage,
  service as serviceJsonLd,
} from '@/lib/structuredData';

const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonicalURL = new URL(Astro.url.pathname, site);
const servicesBookingUrl = 'https://houseofrose.glossgenius.com/services';
const heroImage = '/images/hor-lounge.webp';
const socialImage = new URL(heroImage, site).toString();
const pageDescription =
  'Explore regenerative skin treatments, advanced modalities, facials, IV hydration and weight management at House of Rose Aesthetics in Punta Gorda.';

const faqs: FAQ[] = [
  {
    question: 'What does House of Rose Aesthetics specialize in?',
    answer:
      'House of Rose specializes in advanced regenerative skin treatments, with PRF and Procell Therapies at the center of our approach. We use multiple modalities—including Morpheus8, Forma, Lumecca Peak, SkinPen microneedling, and Glo2 oxygenation—to build a targeted plan around the visible result you want rather than selling one treatment to everyone.',
  },
  {
    question: 'Do I need to know which treatment to request?',
    answer:
      'No. Begin with the result or concern: firmness, texture, scarring, stretch marks, pigment, redness, hydration, glow, maintenance, or wellness support. Your provider reviews your goals, skin, health history, recovery preferences, and candidacy before recommending the appropriate modality or sequence.',
  },
  {
    question: 'What is regenerative skin renewal?',
    answer:
      'At House of Rose, regenerative skin renewal refers to provider-selected treatments that support the skin’s own renewal response and improve the appearance of texture, firmness, fine lines, or selected scars over time. Options may include PRF, Procell Microchanneling, SkinPen microneedling, or Morpheus8. The right treatment depends on the concern and candidacy.',
  },
  {
    question: 'Which advanced skin technologies do you offer?',
    answer:
      'Our advanced skin options include Morpheus8 RF Microneedling for the face and selected body areas, Forma RF Facial, Lumecca Peak IPL Photofacial, Procell Microchanneling, SkinPen microneedling, PRF, and the Glo2Facial’s exfoliation, infusion, and oxygenation steps. Each technology addresses a different layer or visible concern.',
  },
  {
    question: 'Do you also offer facials, chemical peels, and maintenance care?',
    answer:
      'Yes. House of Rose offers skin treatments for correction, preparation, hydration, event-ready glow, and ongoing maintenance. Depending on your goals, that may include customized facials, Glo2Facial, BioRePeel, dermaplaning, chemical exfoliation, professional home care, or maintenance visits between advanced treatments.',
  },
  {
    question: 'What is available in the IV Hydration Therapy Lounge?',
    answer:
      'The IV Hydration Therapy Lounge offers RN-administered hydration and wellness infusions after service-specific screening. Available options support goals such as straightforward hydration, post-activity recovery, travel or morning-after replenishment, and from-within wellness. Infusions support wellness and are not presented as treatment for a diagnosed condition.',
  },
  {
    question: 'Do you offer weight-management solutions?',
    answer:
      'Yes. House of Rose offers medically supervised, provider-guided weight management with candidacy screening and ongoing follow-up. Individual response varies, and the program is designed to work alongside nutrition, hydration, movement, and appropriate medical guidance.',
  },
  {
    question: 'Do you take walk-ins?',
    answer:
      'Yes. Walk-ins are welcome for facials, and other services may be available when the schedule allows. Appointments are recommended for advanced skin, IV hydration, and weight-management services so the appropriate time and provider can be reserved. Call or text (844) 941-7673 to check availability.',
  },
];

const schemaDescription =
  'Advanced aesthetics and wellness consultations in Punta Gorda for regenerative skin treatments, facials, IV hydration, and provider-guided weight management.';

const serviceSchema = serviceJsonLd(
  {
    name: 'Advanced Aesthetics and Wellness Consultation in Punta Gorda',
    description: schemaDescription,
    url: canonicalURL.toString(),
    image: socialImage,
    serviceType: 'Advanced aesthetics and wellness consultation',
  },
  site,
);

const breadcrumbSchema = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'Consultation', item: canonicalURL.toString() },
]);

const faqSchema = faqPage(faqs);

const proofPoints = [
  {
    title: 'Regenerative focus',
    description:
      'PRF and Procell Therapies anchor a skin-renewal approach designed around your visible goals.',
    icon: 'depth',
  },
  {
    title: 'Multiple modalities',
    description:
      'Morpheus8, Forma, Lumecca Peak, microneedling, and oxygenation are selected by concern—not trend.',
    icon: 'cartridge',
  },
  {
    title: 'Skin + wellness',
    description:
      'Advanced skin care, maintenance, IV hydration, and weight support come together in one studio.',
    icon: 'aftercare',
  },
] as const;

const servicePillars = [
  {
    name: 'Regenerative Skin Renewal',
    fit: 'PRF + Procell Therapies',
    outcome:
      'For clients focused on healthier-looking texture, visible firmness, collagen support, selected scars, and long-term skin quality.',
    options:
      'Topical and injectable PRF pathways, Procell Microchanneling, SkinPen microneedling, and provider-selected combinations.',
  },
  {
    name: 'Advanced Technology',
    fit: 'Targeted face + body modalities',
    outcome:
      'For the appearance of laxity, fine lines, uneven texture, enlarged-looking pores, pigment, redness, scars, or stretch marks.',
    options:
      'Morpheus8 RF Microneedling, Forma RF Facial, Lumecca Peak IPL, SkinPen, Procell, and Glo2 oxygenation.',
  },
  {
    name: 'Skin Treatments & Maintenance',
    fit: 'Correction, glow + consistent upkeep',
    outcome:
      'For hydration, smoother-looking surface texture, event-ready radiance, acne support, and maintaining progress between advanced treatments.',
    options:
      'Customized facials, Glo2Facial, BioRePeel and chemical exfoliation, dermaplaning, and professional home care.',
  },
  {
    name: 'Wellness & Weight Support',
    fit: 'Restoration from within',
    outcome:
      'For clients seeking hydration and wellness support or a medically supervised approach to weight management.',
    options:
      'The IV Hydration Therapy Lounge and provider-guided weight management with screening and ongoing follow-up.',
  },
] as const;

const outcomePaths = [
  {
    name: 'Firm, smooth & refine',
    fit: 'Regenerative + collagen-induction options',
    description:
      'PRF, Procell, SkinPen, and Morpheus8 give the provider different ways to address visible texture, mild laxity, selected scars, stretch marks, and overall skin quality.',
  },
  {
    name: 'Clarify tone & restore radiance',
    fit: 'Light, peel + oxygenation options',
    description:
      'Lumecca Peak, BioRePeel, Glo2 oxygenation, and professional skin care can be sequenced around visible pigment, redness, dullness, and uneven-looking tone.',
  },
  {
    name: 'Maintain what you build',
    fit: 'Facials + long-term skin support',
    description:
      'Forma, customized facials, chemical exfoliation, dermaplaning, and matched home care create a realistic maintenance rhythm between corrective treatments.',
  },
] as const;

const process = [
  {
    title: 'Start with the result',
    description:
      'Tell us what you want to improve or maintain. We review the visible concern, priorities, health history, timing, and recovery preferences.',
  },
  {
    title: 'Select the modalities',
    description:
      'Your provider explains which regenerative, energy-based, facial, peel, wellness, or maintenance options fit—and which ones do not.',
  },
  {
    title: 'Sequence the plan',
    description:
      'Correction, recovery, follow-up, and maintenance are placed in a sensible order so every visit has a clear purpose.',
  },
] as const;
---

<BaseLayout
  title="Aesthetics & Wellness Punta Gorda, FL"
  description={pageDescription}
  image={socialImage}
  imageAlt="House of Rose Aesthetics studio lounge in Punta Gorda, Florida"
  preloadImage={heroImage}
  chrome="landing"
>
  <SchemaMarkup item={serviceSchema} slot="head" />
  <SchemaMarkup item={breadcrumbSchema} slot="head" />
  {faqSchema && <SchemaMarkup item={faqSchema} slot="head" />}

  <header class="landing-header border-b border-gold-metal/25 bg-breath">
    <div
      class="mx-auto flex h-[76px] max-w-[1280px] items-center justify-between gap-5 px-5 sm:h-[88px] sm:px-8"
    >
      <img
        src="/logos/house-of-rose-monogram/hr-logo-gold.webp"
        alt="House of Rose Aesthetics"
        width="512"
        height="520"
        class="h-12 w-auto sm:h-14"
      />
      <a
        href="tel:+18449417673"
        class="inline-flex min-h-12 items-center border-b border-gold pb-1 font-serif text-[16px] text-ink transition-colors hover:text-gold sm:text-[18px]"
      >
        Call <span class="ml-1 hidden sm:inline">(844) 941-7673</span><span class="ml-1 sm:hidden">Us</span>
      </a>
    </div>
  </header>

  <div class="landing-page bg-breath pb-20 text-ink md:pb-0">
    <section class="hero-grid border-b border-gold-metal/30">
      <div
        class="mx-auto grid min-h-[calc(100svh-76px)] max-w-[1440px] items-stretch sm:min-h-[680px] lg:min-h-[720px] lg:grid-cols-[0.91fr_1.09fr]"
      >
        <div
          class="order-2 flex items-center px-5 py-12 sm:px-8 sm:py-16 lg:order-1 lg:py-20 lg:pl-[clamp(48px,6vw,96px)] lg:pr-8"
        >
          <div class="max-w-[590px]">
            <p class="mb-5 text-[11px] font-semibold uppercase tracking-[0.24em] text-gold sm:text-[12px]">
              House of Rose Aesthetics · Punta Gorda, Florida
            </p>
            <h1
              class="font-display text-[clamp(46px,5.4vw,72px)] leading-[0.98] tracking-[-0.025em] text-ink"
            >
              Regenerative skin, made personal
            </h1>
            <div class="my-7 flex items-center gap-3" aria-hidden="true">
              <span class="h-px w-20 bg-gold-metal"></span>
              <svg class="h-5 w-5 text-gold" viewBox="0 0 24 24" fill="none">
                <path d="M12 2.75c1.1 2.35 1.65 4.05 1.65 5.1 0 1.1-.73 2.05-1.65 2.05s-1.65-.95-1.65-2.05c0-1.05.55-2.75 1.65-5.1Z" stroke="currentColor" stroke-width="1.2"/>
                <path d="M21.25 12c-2.35 1.1-4.05 1.65-5.1 1.65-1.1 0-2.05-.73-2.05-1.65s.95-1.65 2.05-1.65c1.05 0 2.75.55 5.1 1.65Z" stroke="currentColor" stroke-width="1.2"/>
                <path d="M12 21.25c-1.1-2.35-1.65-4.05-1.65-5.1 0-1.1.73-2.05 1.65-2.05s1.65.95 1.65 2.05c0 1.05-.55 2.75-1.65 5.1Z" stroke="currentColor" stroke-width="1.2"/>
                <path d="M2.75 12c2.35-1.1 4.05-1.65 5.1-1.65 1.1 0 2.05.73 2.05 1.65s-.95 1.65-2.05 1.65c-1.05 0-2.75-.55-5.1-1.65Z" stroke="currentColor" stroke-width="1.2"/>
              </svg>
              <span class="h-px w-20 bg-gold-metal"></span>
            </div>
            <p class="max-w-[540px] text-[17px] leading-[1.75] text-muted-strong sm:text-[18px]">
              House of Rose specializes in regenerative skin treatments
              including PRF and Procell Therapies. We combine the right
              modalities—from Morpheus8, Forma, Lumecca Peak, microneedling,
              and Glo2 oxygenation to facials, chemical peels, IV hydration,
              and provider-guided weight management—to build a plan around the
              result you want.
            </p>
            <div class="mt-8 hidden max-w-[470px] flex-col gap-3 sm:flex sm:flex-row">
              <a href="#consultation" class="btn-gold w-full">Begin Your Consultation</a>
              <a
                href={servicesBookingUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-outline-gold w-full"
              >
                View Services &amp; Book
              </a>
            </div>
            <p class="mt-6 flex items-start gap-2 text-[12px] leading-relaxed text-muted sm:text-[13px]">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-gold" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 21s7-6.1 7-12a7 7 0 1 0-14 0c0 5.9 7 12 7 12Z" stroke="currentColor" stroke-width="1.6"/>
                <circle cx="12" cy="9" r="2.35" stroke="currentColor" stroke-width="1.6"/>
              </svg>
              <span>525 E Olympia Ave, Unit 9 · Monday–Friday, 9 AM–5 PM</span>
            </p>
          </div>
        </div>
        <div class="hero-media relative order-1 min-h-[34svh] overflow-hidden bg-walnut sm:min-h-[42svh] lg:order-2 lg:min-h-full">
          <img
            src={heroImage}
            alt="House of Rose Aesthetics studio lounge in Punta Gorda"
            width="1920"
            height="1440"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="absolute inset-0 h-full w-full object-cover object-center"
          />
        </div>
      </div>
    </section>

    <section class="border-b border-gold-metal/30 bg-breath px-5 py-14 sm:px-8 sm:py-16">
      <div class="mx-auto max-w-[1180px]">
        <h2 class="text-center font-display text-[clamp(34px,4.8vw,54px)] leading-tight">
          One studio. A more complete way to care for you.
        </h2>
        <div class="mx-auto mt-9 grid max-w-[1050px] divide-y divide-gold-metal/35 md:grid-cols-3 md:divide-x md:divide-y-0">
          {
            proofPoints.map((point) => (
              <div class="flex gap-4 py-6 md:px-8 md:py-3 first:pl-0 last:pr-0">
                <div class="mt-0.5 flex h-11 w-11 shrink-0 items-center justify-center text-gold" aria-hidden="true">
                  {point.icon === 'depth' && (
                    <svg viewBox="0 0 48 48" class="h-10 w-10" fill="none">
                      <path d="M5 14h27l7 10-7 10H5" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M12 18v3m7-3v3m7-3v3M12 27v3m7-3v3m7-3v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  )}
                  {point.icon === 'cartridge' && (
                    <svg viewBox="0 0 48 48" class="h-10 w-10" fill="none">
                      <path d="M16 6h16v9l4 4v22H12V19l4-4V6Z" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M17 24h14M17 29h14M19 11h10M18 41h12v3H18z" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                  )}
                  {point.icon === 'aftercare' && (
                    <svg viewBox="0 0 48 48" class="h-10 w-10" fill="none">
                      <path d="M10 5h19l9 9v29H10V5Z" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M29 5v10h9M17 23h14M17 29h14M17 35h9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  )}
                </div>
                <div>
                  <h3 class="font-serif text-[19px] leading-snug">{point.title}</h3>
                  <p class="mt-2 text-[13px] leading-[1.65] text-muted">{point.description}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bg-breath px-5 py-[clamp(64px,8vw,108px)] sm:px-8">
      <div class="mx-auto max-w-[1180px]">
        <div class="max-w-[760px]">
          <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-gold">
            What we offer
          </p>
          <h2 class="mt-4 font-display text-[clamp(38px,5vw,60px)] leading-[1.05]">
            A complete path from correction to maintenance
          </h2>
          <div class="my-7 h-px w-32 bg-gold-metal"></div>
          <p class="text-[16px] leading-[1.8] text-muted-strong">
            Our regenerative skin focus is supported by advanced technology,
            professional skin care, and wellness services. That gives us room
            to address what you want to change now, then create a practical
            rhythm for maintaining your results.
          </p>
        </div>

        <div class="mt-12 grid gap-px overflow-hidden border border-gold-metal/45 bg-gold-metal/45 lg:grid-cols-2">
          {
            servicePillars.map((option, index) => (
              <article class="bg-breath p-7 sm:p-9">
                <p class="font-display text-[30px] leading-none text-gold">
                  {String(index + 1).padStart(2, '0')}
                </p>
                <h3 class="mt-5 font-serif text-[25px] leading-tight">{option.name}</h3>
                <p class="mt-3 text-[11px] font-semibold uppercase tracking-[0.17em] text-gold">
                  {option.fit}
                </p>
                <p class="mt-6 text-[13px] leading-[1.75] text-muted">
                  <strong class="font-medium text-ink">Designed around:</strong>{' '}
                  {option.outcome}
                </p>
                <p class="mt-4 border-t border-gold-metal/35 pt-4 text-[13px] leading-[1.75] text-muted">
                  {option.options}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="on-dark bg-walnut px-5 py-[clamp(64px,7vw,92px)] sm:px-8">
      <div class="mx-auto max-w-[1180px]">
        <h2 class="text-center font-display text-[clamp(38px,5vw,58px)] leading-tight text-ivory">
          The plan is built around the result—not a single machine
        </h2>
        <div class="mx-auto mt-10 grid max-w-[1100px] gap-9 md:grid-cols-3 md:gap-0 md:divide-x md:divide-gold-metal/50">
          {
            process.map((step, index) => (
              <div class="md:px-9 first:pl-0 last:pr-0">
                <h3 class="flex items-baseline gap-3 text-ivory">
                  <span class="font-display text-[32px] text-gold">{String(index + 1).padStart(2, '0')}</span>
                  <span class="font-serif text-[22px]">{step.title}</span>
                </h3>
                <p class="mt-4 text-[14px] leading-[1.75] text-muted">{step.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="border-b border-gold-metal/30 bg-breath px-5 py-[clamp(64px,8vw,108px)] sm:px-8">
      <div class="mx-auto max-w-[1180px]">
        <div class="mx-auto max-w-[760px] text-center">
          <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-gold">
            Targeted by concern
          </p>
          <h2 class="mt-4 font-display text-[clamp(38px,5vw,58px)] leading-[1.05]">
            Different goals call for different pathways
          </h2>
          <p class="mt-6 text-[16px] leading-[1.8] text-muted-strong">
            Thoughtful care is not about stacking every available service. It
            is about selecting and sequencing the modalities that make sense
            for your visible concern, timing, recovery preferences, and
            candidacy.
          </p>
        </div>
        <div class="mt-12 grid gap-6 lg:grid-cols-3">
          {
            outcomePaths.map((option) => (
              <article class="border border-gold-metal/45 bg-white/30 p-7 sm:p-8">
                <h3 class="font-serif text-[24px] leading-tight">{option.name}</h3>
                <p class="mt-3 text-[11px] font-semibold uppercase tracking-[0.17em] text-gold">
                  {option.fit}
                </p>
                <p class="mt-5 text-[14px] leading-[1.75] text-muted-strong">
                  {option.description}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="grid bg-breath lg:grid-cols-[1.15fr_0.85fr]">
      <div class="min-h-[430px] overflow-hidden lg:min-h-[620px]">
        <img
          src="/images/hor-skin-studio.webp"
          alt="A treatment room at House of Rose Aesthetics in Punta Gorda"
          width="1448"
          height="1086"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>
      <div class="flex items-center px-5 py-14 sm:px-10 lg:px-[clamp(48px,6vw,88px)] lg:py-20">
        <div class="max-w-[520px]">
          <h2 class="font-display text-[clamp(40px,5vw,60px)] leading-[1.04]">
            Skin health is only one part of the picture
          </h2>
          <div class="my-7 h-px w-32 bg-gold-metal"></div>
          <p class="text-[15px] leading-[1.8] text-muted-strong">
            The IV Hydration Therapy Lounge extends our approach to
            from-within hydration and wellness support. Provider-guided weight
            management adds screening, follow-up, and an individualized plan,
            while our skin team supports correction, preparation, and
            long-term maintenance.
          </p>
          <p class="mt-5 text-[14px] leading-[1.75] text-muted">
            Not every client is a candidate for every service. Final treatment
            combinations and candidacy are confirmed by your licensed provider
            based on contraindications and local regulations. Outcomes are
            individual and depend on your skin, candidacy, and consistency.
          </p>
          <a href="#consultation" class="btn-gold mt-8">Begin Your Consultation</a>
        </div>
      </div>
    </section>

    <section class="border-y border-gold-metal/30 bg-breath px-5 py-[clamp(64px,8vw,108px)] sm:px-8">
      <div class="mx-auto grid max-w-[1180px] gap-12 lg:grid-cols-[0.72fr_1.28fr] lg:gap-20">
        <h2 class="font-display text-[clamp(40px,5vw,62px)] leading-[1.03]">
          House of Rose questions, answered.
        </h2>
        <div class="border-t border-gold-metal/50">
          {
            faqs.map((faq, index) => (
              <details class="faq-row group border-b border-gold-metal/50" open={index === 0}>
                <summary class="flex min-h-[72px] cursor-pointer list-none items-center gap-4 py-5 font-serif text-[19px] leading-snug sm:text-[21px]">
                  <svg class="h-5 w-5 shrink-0 text-gold transition-transform duration-200 group-open:rotate-45" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path d="M10 3v14M3 10h14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                  </svg>
                  <span>{faq.question}</span>
                </summary>
                <p class="pb-7 pl-9 text-[15px] leading-[1.8] text-muted-strong">
                  {faq.answer}
                </p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section id="consultation" class="scroll-mt-4 bg-breath px-5 py-[clamp(64px,8vw,108px)] sm:px-8">
      <div class="mx-auto grid max-w-[1180px] gap-12 lg:grid-cols-[0.82fr_1.18fr] lg:gap-20">
        <div class="lg:pt-5">
          <h2 class="max-w-[520px] font-display text-[clamp(42px,5vw,64px)] leading-[1.03]">
            Tell us what you want to change
          </h2>
          <div class="my-7 h-px w-32 bg-gold-metal"></div>
          <p class="max-w-[500px] text-[16px] leading-[1.8] text-muted-strong">
            You do not have to choose a device, facial, infusion, or program on
            your own. Send a simple consultation request and our team will help
            you choose a time, review your priorities, and identify the best
            starting point.
          </p>
          <p class="mt-8 flex items-start gap-4 text-[15px] leading-relaxed text-muted-strong">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-gold text-gold" aria-hidden="true">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none">
                <path d="M7.5 3.8 10 8 7.8 9.7a15.4 15.4 0 0 0 6.5 6.5L16 14l4.2 2.5v3.1c0 .8-.6 1.4-1.4 1.4C10 21 3 14 3 5.2c0-.8.6-1.4 1.4-1.4h3.1Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span>
              Prefer a direct conversation?<br />
              Call or text
              <a href="tel:+18449417673" class="border-b border-gold text-ink hover:text-gold">(844) 941-7673</a>.
            </span>
          </p>
          <p class="mt-5 text-[14px] leading-relaxed text-muted-strong">
            Ready to choose a service?
            <a
              href={servicesBookingUrl}
              target="_blank"
