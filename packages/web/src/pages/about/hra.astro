---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import { sanityFetch } from '@/lib/sanity';
import { ABOUT_PAGE_QUERY, type AboutPageContent } from '@/lib/queries';
import { ABOUT_PAGE_FALLBACK } from '@/lib/aboutFallbacks';
import { breadcrumbList, webPage } from '@/lib/structuredData';
import { sbFieldPath, sbFieldPathParts, sbObjectId } from '@/lib/visualEditing';

const content = await sanityFetch<AboutPageContent | null>(ABOUT_PAGE_QUERY);
const heading = content?.hraHeading ?? ABOUT_PAGE_FALLBACK.hraHeading;
const intro = content?.hraIntro ?? ABOUT_PAGE_FALLBACK.hraIntro;
const paragraphs = content?.hraParagraphs?.length ? content.hraParagraphs : ABOUT_PAGE_FALLBACK.hraParagraphs;
const imageUrl = content?.hraImageUrl ?? ABOUT_PAGE_FALLBACK.hraImageUrl;
const imageAlt = content?.hraImageAlt ?? ABOUT_PAGE_FALLBACK.hraImageAlt;
const title = content?.hraSeo?.metaTitle ?? ABOUT_PAGE_FALLBACK.hraSeo?.metaTitle;
const description = content?.hraSeo?.metaDescription ?? ABOUT_PAGE_FALLBACK.hraSeo?.metaDescription;

const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonical = new URL(Astro.url.pathname, site).toString();
const breadcrumb = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'About', item: new URL('/about/', site).toString() },
  { name: 'House of Rose Aesthetics', item: canonical },
]);
const pageSchema = webPage({ name: heading, description: description ?? intro, url: canonical }, site);
---

<BaseLayout
  title={title}
  description={description}
  image={imageUrl}
  imageAlt={imageAlt}
  preloadImage={imageUrl}
>
  <SchemaMarkup item={pageSchema} slot="head" />
  <SchemaMarkup item={breadcrumb} slot="head" />

  <div {...(content?._id ? sbObjectId(content._id) : {})}>
    <section class="grid min-h-[680px] pt-20 lg:grid-cols-2">
      <div class="flex items-center px-6 py-[clamp(64px,9vw,112px)] sm:px-10 lg:px-[clamp(56px,7vw,108px)]">
        <div class="max-w-[650px]">
          <p class="kicker">Medical Aesthetics Practice</p>
          <h1 class="font-serif text-[clamp(42px,6vw,72px)] leading-[0.98] text-ink" {...sbFieldPath('hraHeading')}>
            {heading}
          </h1>
          <p class="mt-8 text-[18px] leading-[1.8] text-muted-strong" {...sbFieldPath('hraIntro')}>
            {intro}
          </p>
          <p class="mt-8 text-[12px] font-semibold uppercase tracking-[0.12em] text-gold">
            Medical Aesthetics. Thoughtfully Practiced.
          </p>
        </div>
      </div>
      <div class="min-h-[440px] bg-limestone lg:min-h-full">
        <img src={imageUrl} alt={imageAlt} width="1400" height="1000" class="h-full w-full object-cover" fetchpriority="high" />
      </div>
    </section>

    <section class="border-y border-walnut/10 bg-breath px-6 py-[clamp(64px,9vw,112px)]">
      <div class="mx-auto grid max-w-[1120px] gap-12 lg:grid-cols-[0.62fr_1.38fr] lg:gap-20">
        <div>
          <p class="kicker">How the practice works</p>
          <h2 class="font-serif text-[clamp(30px,4vw,44px)] leading-tight text-ink">A plan before a procedure.</h2>
        </div>
        <div class="space-y-6 text-[16px] leading-[1.85] text-muted">
          {paragraphs.map((paragraph, index) => (
            <p {...sbFieldPathParts('hraParagraphs', index)}>{paragraph}</p>
          ))}
        </div>
      </div>
    </section>

    <section class="px-6 py-[clamp(56px,8vw,96px)]">
      <div class="mx-auto max-w-[1120px]">
        <div class="grid gap-px bg-walnut/15 md:grid-cols-3">
          <article class="bg-bone p-8">
            <p class="text-[12px] font-semibold uppercase tracking-[0.12em] text-gold">01</p>
            <h2 class="mt-4 font-serif text-[25px] text-ink">Assessment before recommendation</h2>
            <p class="mt-4 text-[14px] leading-[1.8] text-muted">Goals, history, timing, and candidacy guide the next conversation.</p>
          </article>
          <article class="bg-bone p-8">
            <p class="text-[12px] font-semibold uppercase tracking-[0.12em] text-gold">02</p>
            <h2 class="mt-4 font-serif text-[25px] text-ink">Clear expectations</h2>
            <p class="mt-4 text-[14px] leading-[1.8] text-muted">Preparation, downtime, aftercare, and follow-up are explained when they matter.</p>
          </article>
          <article class="bg-bone p-8">
            <p class="text-[12px] font-semibold uppercase tracking-[0.12em] text-gold">03</p>
            <h2 class="mt-4 font-serif text-[25px] text-ink">Continuity over trends</h2>
            <p class="mt-4 text-[14px] leading-[1.8] text-muted">Recommendations are considered in the context of a longer-term plan.</p>
          </article>
        </div>

        <div class="mt-12 flex flex-wrap items-center justify-between gap-6 border-t border-walnut/15 pt-8">
          <p class="text-[13px] font-semibold tracking-[0.03em] text-muted-strong">
            Medical Director: Joshua Shaw, MD · FL Lic. ME136232
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/about/providers/" class="btn-outline-gold">Meet the providers</a>
            <a href="/experience/" class="btn-gold">What to expect</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
