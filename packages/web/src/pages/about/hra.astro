---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import { sanityFetch } from '@/lib/sanity';
import { ABOUT_PAGE_QUERY, type AboutPageContent } from '@/lib/queries';
import { ABOUT_PAGE_FALLBACK } from '@/lib/aboutFallbacks';
import { breadcrumbList } from '@/lib/structuredData';
import { sbFieldPath, sbObjectId } from '@/lib/visualEditing';

const content = await sanityFetch<AboutPageContent | null>(ABOUT_PAGE_QUERY);
// Working voice reset: copy stays local until Amber approves it for Sanity.
const heading = ABOUT_PAGE_FALLBACK.hraHeading;
const intro = ABOUT_PAGE_FALLBACK.hraIntro;
const imageUrl = content?.hraImageUrl ?? ABOUT_PAGE_FALLBACK.hraImageUrl;
const imageAlt = content?.hraImageAlt ?? ABOUT_PAGE_FALLBACK.hraImageAlt;
const title = ABOUT_PAGE_FALLBACK.hraSeo?.metaTitle;
const description = ABOUT_PAGE_FALLBACK.hraSeo?.metaDescription;

const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonical = new URL(Astro.url.pathname, site).toString();
const breadcrumb = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'About', item: new URL('/about/', site).toString() },
  { name: 'House of Rose Aesthetics', item: canonical },
]);
---

<BaseLayout
  title={title}
  description={description}
  image={imageUrl}
  imageAlt={imageAlt}
  preloadImage={imageUrl}
>
  <SchemaMarkup item={breadcrumb} slot="head" />

  <div {...(content?._id ? sbObjectId(content._id) : {})}>
    <section class="grid min-h-[680px] pt-20 lg:grid-cols-2">
      <div class="flex items-center px-6 py-[clamp(64px,9vw,112px)] sm:px-10 lg:px-[clamp(56px,7vw,108px)]">
        <div class="max-w-[650px]">
          <p class="kicker">Medical Aesthetics Practice</p>
          <h1 class="font-serif text-[clamp(42px,6vw,72px)] leading-[0.98] text-ink">
            {heading}
          </h1>
          <p class="mt-8 text-[18px] leading-[1.8] text-muted-strong">
            {intro}
          </p>
        </div>
      </div>
      <div class="min-h-[440px] bg-limestone lg:min-h-full">
        <img
          src={imageUrl}
          alt={imageAlt}
          width="1400"
          height="1000"
          class="h-full w-full object-cover"
          fetchpriority="high"
          {...(content?._id ? sbFieldPath('hraImage') : {})}
        />
      </div>
    </section>

    <section class="border-y border-walnut/10 bg-breath px-6 py-[clamp(64px,9vw,112px)]">
      <div class="mx-auto grid max-w-[1120px] gap-12 lg:grid-cols-[0.62fr_1.38fr] lg:gap-20">
        <div>
          <p class="kicker">The practice</p>
          <h2 class="font-serif text-[clamp(30px,4vw,44px)] leading-tight text-ink">One location. Distinct service categories.</h2>
        </div>
        <p class="text-[16px] leading-[1.85] text-muted">
          House of Rose offers skin treatments, injectables, IV hydration, provider-guided weight management, facials, waxing, makeup, and permanent jewelry in Punta Gorda.
        </p>
      </div>
    </section>

    <section class="px-6 py-[clamp(56px,8vw,96px)]">
      <div class="mx-auto max-w-[1120px]">
        <div class="grid gap-px bg-walnut/15 md:grid-cols-2">
          <article class="bg-bone p-8 sm:p-10">
            <h2 class="font-serif text-[27px] text-ink">Medical services</h2>
            <p class="mt-5 max-w-[470px] text-[15px] leading-[1.8] text-muted">
              Medical services include injectables, IV hydration, weight management, and medically directed skin treatments.
            </p>
          </article>
          <article class="bg-bone p-8 sm:p-10">
            <h2 class="font-serif text-[27px] text-ink">Skin and non-medical services</h2>
            <p class="mt-5 max-w-[470px] text-[15px] leading-[1.8] text-muted">
              Licensed estheticians provide facial, skin, and waxing services. Makeup artistry and permanent jewelry are offered as separate non-medical services.
            </p>
          </article>
        </div>

        <div class="mt-12 flex flex-wrap items-center justify-between gap-6 border-t border-walnut/15 pt-8">
          <p class="text-[13px] font-semibold tracking-[0.03em] text-muted-strong">
            Medical Director: Joshua Shaw, MD · FL Lic. ME136232
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/about/providers/" class="btn-outline-gold">Meet the providers</a>
            <a href="/experience/" class="btn-gold">See the practice</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
