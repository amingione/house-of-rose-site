---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import { sanityFetch, urlFor } from '@/lib/sanity';
import { PUBLIC_PROVIDERS_QUERY, type PublicProviderProfile } from '@/lib/queries';
import {
  getProviderProfileVoiceOverlay,
  PROVIDER_PROFILE_FALLBACKS,
  resolvePublicProviderProfiles,
} from '@/lib/aboutFallbacks';
import { breadcrumbList, personProfile } from '@/lib/structuredData';
import { sbFieldPath, sbFieldPathParts, sbObjectId } from '@/lib/visualEditing';

export async function getStaticPaths() {
  const sanityProviders = await sanityFetch<PublicProviderProfile[]>(PUBLIC_PROVIDERS_QUERY);
  const providers = resolvePublicProviderProfiles(sanityProviders);
  const sanityProviderSlugs = new Set(sanityProviders.map((profile) => profile.slug));
  return providers.map((profile) => ({
    params: { slug: profile.slug },
    props: { profile, sanityBacked: sanityProviderSlugs.has(profile.slug) },
  }));
}

interface Props {
  profile: PublicProviderProfile;
  sanityBacked: boolean;
}

const { profile, sanityBacked } = Astro.props;
const voiceOverlay = getProviderProfileVoiceOverlay(profile.slug);
const verifiedFallback = PROVIDER_PROFILE_FALLBACKS.find((candidate) => candidate.slug === profile.slug);
const summary = voiceOverlay?.summary ?? profile.summary;
const biography = voiceOverlay?.biography ?? profile.biography;
const serviceFocus = verifiedFallback?.serviceFocus ?? profile.serviceFocus;
const publicImageAlt = verifiedFallback?.imageAlt ?? profile.imageAlt;
const summaryAttrs = voiceOverlay ? {} : sbFieldPath('summary');
const biographyAttrs = (index: number) => voiceOverlay ? {} : sbFieldPathParts('biography', index);
const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonical = new URL(Astro.url.pathname, site).toString();
const title = verifiedFallback?.seo?.metaTitle ?? profile.seo?.metaTitle ?? `${profile.publicName} | House of Rose Aesthetics`;
const description = voiceOverlay?.metaDescription ?? profile.seo?.metaDescription ?? summary;
const isSanityProfileImage = profile.imageUrl?.startsWith('https://cdn.sanity.io/images/') ?? false;
const profileImage = (width: number, height: number): string | undefined =>
  profile.imageUrl && isSanityProfileImage
    ? urlFor(profile.imageUrl).width(width).height(height).fit('crop').format('webp').quality(82).url()
    : profile.imageUrl;
const detailImage = profileImage(980, 1225);
const detailImageSrcset = profile.imageUrl && isSanityProfileImage
  ? `${profileImage(560, 700)} 560w, ${profileImage(800, 1000)} 800w, ${detailImage} 980w`
  : undefined;
const socialImage = profile.imageUrl && isSanityProfileImage
  ? urlFor(profile.imageUrl).width(1200).height(630).fit('crop').format('webp').quality(82).url()
  : profile.imageUrl;
const absoluteImage = socialImage ? new URL(socialImage, site).toString() : undefined;
const serviceFocusLinks: Readonly<Record<string, string>> = {
  Neuromodulators: '/services/injectables/',
  'Dermal fillers': '/services/dermal-fillers/',
  'Injectable PRF': '/services/prf-injections/',
  'PRF Bio-Filler': '/services/prf-injections/',
  'IV hydration': '/services/iv-hydration-therapy/',
  'GLP-1 weight management': '/services/glp-1-weight-management/',
  'Microneedling with the Procell Therapies device': '/services/microneedling/',
  'Topical PRF': '/services/microneedling/',
  Glo2Facial: '/services/glo2facial/',
  Dermaplaning: '/services/dermaplaning/',
  'BioRePeel add-on': '/services/biorepeel/',
  Facials: '/services/#skin-health-corrective-care',
  BioRePeel: '/services/biorepeel/',
  'Facial waxing': '/services/facial-waxing/',
};
interface ProviderClosingLink {
  readonly href: string;
  readonly label: string;
}

interface ProviderClosing {
  readonly heading: string;
  readonly body: string;
  readonly links: readonly ProviderClosingLink[];
}

const providerClosings: Readonly<Record<string, ProviderClosing>> = {
  diana: {
    heading: 'Medical treatments with Diana Morrison, RN.',
    body: 'She provides neurotoxins, dermal fillers, injectable PRF, IV hydration, and GLP-1 weight management. Each treatment page explains its purpose and the concerns it may address.',
    links: [
      { href: '/services/injectables-bio-fillers/', label: 'Injectables & Bio-Fillers' },
      { href: '/services/iv-hydration-therapy/', label: 'IV Hydration' },
      { href: '/services/glp-1-weight-management/', label: 'Weight Management' },
    ],
  },
  amber: {
    heading: 'Looking for a skin service with Amber Mingione, Licensed Esthetician?',
    body: 'Her current work includes Procell Microneedling, topical PRF, Glo2Facial, dermaplaning, and BioRePeel as an eligible add-on.',
    links: [
      { href: '/services/microneedling/', label: 'Microneedling' },
      { href: '/services/glo2facial/', label: 'Glo2Facial' },
      { href: '/services/dermaplaning/', label: 'Dermaplaning' },
    ],
  },
  brandy: {
    heading: 'Looking for facial care or waxing with Brandy, Licensed Esthetician?',
    body: 'She provides facials, BioRePeel, and facial waxing for the brows, upper lip, and chin. Contact House of Rose if you want help deciding which facial fits what you are noticing.',
    links: [
      { href: '/services/biorepeel/', label: 'BioRePeel' },
      { href: '/services/facial-waxing/', label: 'Facial Waxing' },
      { href: '/contact/', label: 'Ask about facials' },
    ],
  },
  aundrea: {
    heading: 'Looking for bridal, event, or everyday makeup?',
    body: 'Aundrea provides makeup for weddings, events, photo shoots, and everyday wear. Include the date and occasion when you contact House of Rose.',
    links: [
      { href: '/services/bridal-makeup/', label: 'Bridal Makeup' },
      { href: '/services/event-makeup/', label: 'Event Makeup' },
      { href: '/contact/', label: 'Ask about makeup' },
    ],
  },
};
const providerClosing = providerClosings[profile.slug] ?? {
  heading: `Explore treatments with ${profile.publicName}.`,
  body: 'Read the treatment pages for the services this provider offers, or contact House of Rose with what you want to change.',
  links: [
    { href: '/services/', label: 'View current services' },
    { href: '/contact/', label: 'Ask House of Rose' },
  ],
};
const breadcrumb = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'About', item: new URL('/about/', site).toString() },
  { name: 'Providers', item: new URL('/about/providers/', site).toString() },
  { name: profile.publicName, item: canonical },
]);
const personSchema = personProfile(
  {
    name: profile.publicName,
    jobTitle: profile.publicRole,
    url: canonical,
    image: absoluteImage,
    description: summary,
    knowsAbout: serviceFocus,
    sameAs: profile.digitalCardPath ? [new URL(profile.digitalCardPath, site).toString()] : undefined,
  },
  site,
);
---

<BaseLayout
  title={title}
  description={description}
  image={socialImage}
  imageAlt={publicImageAlt}
  preloadImage={detailImage}
  preloadImageSrcset={detailImageSrcset}
  preloadImageSizes="(max-width: 1023px) 100vw, 47vw"
  structuredPageType="ProfilePage"
  structuredPageMainEntityId={`${canonical}#person`}
>
  <SchemaMarkup item={personSchema} slot="head" />
  <SchemaMarkup item={breadcrumb} slot="head" />

  <div {...(sanityBacked ? sbObjectId(profile._id) : {})}>
    <section class="grid min-h-[680px] pt-20 lg:grid-cols-[0.94fr_1.06fr]">
      {profile.imageUrl ? (
        <div class="min-h-[460px] bg-limestone lg:min-h-full">
          <img
            src={detailImage}
            srcset={detailImageSrcset}
            sizes="(max-width: 1023px) 100vw, 47vw"
            alt={publicImageAlt ?? profile.publicName}
            width="980"
            height="1225"
            class="h-full w-full object-cover object-top"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            {...(sanityBacked ? sbFieldPath('profileImage') : {})}
          />
        </div>
      ) : (
        <div class="on-dark flex min-h-[460px] items-center justify-center bg-walnut px-10 lg:min-h-full">
          <div class="text-center">
            <img src="/logos/house-of-rose-monogram/hr-logo-gold.webp" alt="" width="136" height="138" class="mx-auto h-28 w-auto opacity-90" />
            <p class="mt-8 text-[12px] font-semibold uppercase tracking-[0.16em] text-gold">House of Rose Aesthetics</p>
          </div>
        </div>
      )}

      <div class="flex items-center px-6 py-[clamp(64px,9vw,112px)] sm:px-10 lg:px-[clamp(56px,7vw,108px)]">
        <div class="max-w-[650px]">
          <p class="text-[12px] font-semibold uppercase tracking-[0.12em] text-gold" {...(verifiedFallback ? {} : sbFieldPath('publicRole'))}>
            {profile.publicRole}
          </p>
          <h1 class="mt-5 font-serif text-[clamp(42px,6vw,70px)] leading-[1.02] text-ink" {...(verifiedFallback ? {} : sbFieldPath('publicName'))}>
            {profile.publicName}
          </h1>
          <p class="mt-7 text-[17px] leading-[1.8] text-muted-strong" {...summaryAttrs}>
            {summary}
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="/about/providers/" class="btn-gold">Meet the full team</a>
            {profile.digitalCardPath && <a href={profile.digitalCardPath} class="btn-outline-gold">Open digital card</a>}
          </div>
        </div>
      </div>
    </section>

    <section class="border-y border-walnut/10 bg-breath px-6 py-[clamp(64px,9vw,112px)]">
      <div class="mx-auto grid max-w-[1120px] gap-12 lg:grid-cols-[1.25fr_0.75fr] lg:gap-20">
        <article>
          <p class="kicker">Profile</p>
          <h2 class="font-serif text-[clamp(30px,4vw,44px)] text-ink">Meet {profile.publicName}</h2>
          <div class="mt-7 space-y-6 text-[16px] leading-[1.85] text-muted">
            {biography.map((paragraph, index) => (
              <p {...biographyAttrs(index)}>{paragraph}</p>
            ))}
          </div>
        </article>

        <aside class="border-t border-walnut/20 pt-7">
          <h2 class="text-[12px] font-semibold uppercase tracking-[0.12em] text-gold">Service focus</h2>
          <ul class="mt-5 divide-y divide-walnut/10 border-b border-walnut/10">
            {serviceFocus.map((focus, index) => (
              <li class="py-4 text-[15px] text-muted-strong" {...(verifiedFallback ? {} : sbFieldPathParts('serviceFocus', index))}>
                {serviceFocusLinks[focus] ? (
                  <a href={serviceFocusLinks[focus]} class="underline decoration-walnut/25 underline-offset-4 transition-colors hover:text-gold">
                    {focus}
                  </a>
                ) : focus}
              </li>
            ))}
          </ul>
          {profile.slug === 'aundrea' && (
            <p class="mt-6 text-[13px] leading-[1.7] text-muted">Makeup artistry is a non-medical service.</p>
          )}
          {profile.medicallyDirected && (
            <p class="mt-7 border-t border-walnut/10 pt-6 text-[13px] font-semibold leading-[1.7] text-muted-strong">
              Medical Director: Joshua Shaw, MD · FL Lic. ME136232
            </p>
          )}
        </aside>
      </div>
    </section>

    <section data-provider-closing class="px-6 py-[clamp(52px,7vw,80px)]">
      <div class="mx-auto flex max-w-[960px] flex-col items-center text-center">
        <h2 class="font-serif text-[clamp(28px,4vw,42px)] text-ink">{providerClosing.heading}</h2>
        <p class="mt-5 max-w-[620px] text-[15px] leading-[1.75] text-muted">
          {providerClosing.body}
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          {providerClosing.links.map((link, index) => (
            <a href={link.href} class={index === 0 ? 'btn-gold' : 'btn-outline-gold'}>{link.label}</a>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
