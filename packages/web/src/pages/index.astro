---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { GLOSSGENIUS_SERVICES_URL } from '@/lib/booking';
import { BUSINESS_URLS, LOCAL_BUSINESS } from '@/lib/structuredData';
import SkinAnalysisHero from '@/components/home/SkinAnalysisHero.astro';
import { VERIFIED_IV_MENU } from '@/lib/ivHydrationFacts';
import { PERMANENT_JEWELRY_EDUCATION } from '@/lib/permanentJewelryEducation';
import { SKIN_RENEWAL_SERVICE_EDUCATION } from '@/lib/skinRenewalServiceEducation';
import { WAXING_SERVICE_EDUCATION } from '@/lib/waxingServiceEducation';
import { WEIGHT_MANAGEMENT_EDUCATION } from '@/lib/weightManagementEducation';

const phoneDisplay = '(844) 941-7673';
const phoneHref = `tel:${LOCAL_BUSINESS.telephone}`;
const localVisitText = 'Open Monday through Friday, 9 AM–5 PM.';
const [topicalPrf, underEyePrf, bioFillerPrf] = SKIN_RENEWAL_SERVICE_EDUCATION.prf.menu.items;
const hydrationIv = VERIFIED_IV_MENU[0];
const fortyFiveMinuteIvPrices = VERIFIED_IV_MENU.slice(1).map(({ price }) => price);

const broaderPracticeServices = [
  {
    label: 'IV hydration',
    title: `${VERIFIED_IV_MENU.length} options, with the details visible`,
    body: `${hydrationIv.name} is ${hydrationIv.durationMinutes} minutes at $${hydrationIv.price}. The other five appointments are 45 minutes and range from $${Math.min(...fortyFiveMinuteIvPrices)} to $${Math.max(...fortyFiveMinuteIvPrices)}. Diana Morrison, RN provides IV hydration under medical direction.`,
    href: '/services/iv-hydration-therapy/',
    cta: 'See the IV menu',
  },
  {
    label: 'Weight management',
    title: 'A conversation before a program',
    body: `The ${WEIGHT_MANAGEMENT_EDUCATION.consultation.durationMinutes}-minute GLP-1 consultation with Diana Morrison, RN is $${WEIGHT_MANAGEMENT_EDUCATION.consultation.priceUsd}. Medication and ongoing program costs are confirmed directly with the practice.`,
    href: '/services/glp-1-weight-management/',
    cta: 'Read about the consultation',
  },
  {
    label: 'Waxing',
    title: 'Facial and body appointments by area',
    body: `Waxing is booked by area across ${WAXING_SERVICE_EDUCATION.waxing.menu.items.length} appointments. Four cover the chin, upper lip, and brows; seven cover underarms, bikini line, chest, back, full leg, partial leg, and full arm.`,
    href: '/services/waxing/',
    cta: 'See all 11 appointments',
  },
  {
    label: 'Permanent jewelry',
    title: 'Fitted in person and closed without a clasp',
    body: `Aundrea Pedigo, Licensed Esthetician fits the chain and joins its ends by welding. The ${PERMANENT_JEWELRY_EDUCATION.menu.durationMinutes}-minute non-medical appointment is $${PERMANENT_JEWELRY_EDUCATION.menu.priceUsd}; the chain can be cut when removal is needed.`,
    href: '/services/permanent-jewelry/',
    cta: 'Read about permanent jewelry',
  },
] as const;

// Working voice reset: body copy stays local until the owner approves it for Sanity.
// This prevents the previous CMS-authored cadence from leaking back into the preview.
const treatmentCategories = [
  {
    label: 'Skin',
    title: 'Texture, pores, and uneven color are different questions',
    body: 'Maybe makeup catches on roughness, pores seem more visible, or a patch of uneven color keeps drawing your eye. Facials, peels, microneedling, and light-based treatments each work differently.',
    href: '/services/collections/facials/',
    cta: 'Explore skin treatments',
  },
  {
    label: 'Injectables',
    title: 'Notice what changes when your face moves',
    body: 'A line that appears when you frown or squint is a different concern from lost fullness in the lips, cheeks, or folds. Botox and Daxxify address movement; hyaluronic-acid fillers add selected volume.',
    href: '/services/injectables-bio-fillers/',
    cta: 'Explore injectables',
  },
  {
    label: 'Skin analysis',
    title: 'See more than ordinary light reveals',
    body: 'Multi-spectrum imaging adds another view of visible pigment, texture, pores, and sun exposure. The photographs are reviewed with you as a baseline; they do not make a diagnosis.',
    href: '/skin-analysis/',
    cta: 'See how skin analysis works',
  },
] as const;

---

<BaseLayout
  title="House of Rose | Medical Aesthetics in Punta Gorda"
  description="Explore skin treatments, injectables, facials, body services, IV hydration, and provider-guided weight management at House of Rose in Punta Gorda."
  preloadImage="/images/hero/treatment-scan-poster.webp"
  preloadImageSizes="100vw"
>
  <div>
    <SkinAnalysisHero
      title={'Good skin is a reflection\nof good judgment.'}
      description={'In aesthetics, knowing what to do matters. Knowing what not to do matters more.'}
      location="Punta Gorda, Florida"
      primaryCta="Book an appointment"
      secondaryCta="Explore services"
    />

    <section class="bg-bone px-6 py-[clamp(72px,9vw,120px)]">
      <div class="mx-auto grid max-w-[1240px] gap-12 lg:grid-cols-[0.84fr_1.16fr] lg:gap-24">
        <div>
          <span class="kicker">House of Rose</span>
          <h2 class="max-w-[570px] font-serif text-[clamp(40px,5.5vw,64px)] leading-[1.02] tracking-[-0.02em] text-ink">
            You do not need to arrive knowing the treatment name.
          </h2>
        </div>
        <div class="max-w-[680px] lg:pt-12">
          <p class="font-serif text-[clamp(25px,3vw,34px)] leading-[1.25] text-ink">
            Some clients know exactly what they want. Others only know what has changed. We can work from either.
          </p>
          <p class="mt-7 text-[17px] leading-[1.8] text-muted">
            Tell us how your skin feels, where a shadow keeps appearing, which line has changed, or which service you have already researched.
          </p>
          <p class="mt-5 text-[17px] leading-[1.8] text-muted">
            House of Rose is a four-person practice in a real Punta Gorda storefront. The menu moves from medically directed injectables and IV hydration to esthetic skin care, waxing, makeup artistry, and permanent jewelry, and the provider pages name the work each person currently does.
          </p>
          <p class="mt-5 text-[17px] leading-[1.8] text-muted">
            If you already recognize the service, you can book it directly when online booking is available. If the concern is clearer than the treatment name, describe what you notice and we will explain the relevant appointments.
          </p>
          <div class="mt-9 flex flex-wrap gap-x-7 gap-y-3 border-t border-walnut/15 pt-7 text-[13px] font-semibold">
            <a href="/about/hra/" class="text-ink underline decoration-ink/30 underline-offset-4 hover:text-gold">Learn about the practice</a>
            <a href="/about/providers/" class="text-ink underline decoration-ink/30 underline-offset-4 hover:text-gold">Meet the providers</a>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-breath px-6 py-[clamp(72px,9vw,120px)]">
      <div class="mx-auto max-w-[1240px]">
        <div class="border-b border-walnut/15 pb-10">
          <span class="kicker">Skin, movement, and imaging</span>
          <h2 class="max-w-[850px] font-serif text-[clamp(36px,5vw,58px)] leading-[1.02] tracking-[-0.02em] text-ink">
            What do you keep noticing?
          </h2>
          <p class="mt-6 max-w-[760px] text-[17px] leading-[1.8] text-muted">
            The useful detail may be roughness in certain light, a patch of uneven color, a line that appears when you smile, or a change in fullness. Those observations lead to different questions and different appointments.
          </p>
        </div>

        <div class="mt-8 grid border border-walnut/15 lg:grid-cols-3">
          {treatmentCategories.map((category, index) => (
            <a
              href={category.href}
              class:list={[
                'group flex min-h-[330px] flex-col justify-between p-7 transition-colors sm:p-9',
                index === 0
                  ? 'bg-olive text-ivory hover:bg-green-deep'
                  : 'border-t border-walnut/15 bg-bone hover:bg-limestone/35 lg:border-l lg:border-t-0',
              ]}
              data-cta-location={`homepage-category-${category.label.toLowerCase().replaceAll(' ', '-')}`}
            >
              <div>
                <p class:list={['text-[11px] font-semibold uppercase tracking-[0.14em]', index === 0 ? 'text-ivory/90' : 'text-gold']}>
                  {category.label}
                </p>
                <h3 class:list={['mt-5 max-w-[320px] font-serif text-[31px] leading-[1.08]', index === 0 ? 'text-ivory' : 'text-ink']}>
                  {category.title}
                </h3>
                <p class:list={['mt-5 max-w-[340px] text-[15px] leading-[1.7]', index === 0 ? 'text-ivory/90' : 'text-muted']}>
                  {category.body}
                </p>
              </div>
              <span class:list={['mt-8 inline-flex items-center gap-3 text-[13px] font-semibold', index === 0 ? 'text-ivory' : 'text-ink']}>
                {category.cta} <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </span>
            </a>
          ))}
        </div>
        <div class="mt-8 flex flex-wrap items-center justify-between gap-5 border-t border-walnut/15 pt-7">
          <p class="max-w-[680px] text-[14px] leading-[1.7] text-muted">
            The complete menu also includes body services, IV hydration, provider-guided weight management, waxing, makeup, and permanent jewelry.
          </p>
          <a href="/services/" class="learn-more mt-0">Browse the complete menu <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="bg-bone px-6 py-[clamp(72px,9vw,120px)]">
      <div class="mx-auto max-w-[1240px]">
        <div class="grid gap-10 border-b border-walnut/15 pb-11 lg:grid-cols-[0.82fr_1.18fr] lg:gap-24">
          <div>
            <span class="kicker">More reasons to visit</span>
            <h2 class="max-w-[610px] font-serif text-[clamp(38px,5.5vw,60px)] leading-[1.02] tracking-[-0.02em] text-ink">
              One address. Several very different appointments.
            </h2>
          </div>
          <div class="max-w-[690px] lg:pt-8">
            <p class="font-serif text-[clamp(23px,3vw,32px)] leading-[1.25] text-ink">
              A skin appointment, an IV, a brow wax, and a fitted piece of jewelry are four very different reasons to walk through the same door.
            </p>
            <p class="mt-6 text-[16px] leading-[1.8] text-muted">
              The person behind the appointment, the time it takes, and the price should not be a mystery. These four visits sit beyond the skin and injectable starting points above.
            </p>
          </div>
        </div>

        <div class="grid border-b border-walnut/15 md:grid-cols-2">
          {broaderPracticeServices.map((service, index) => (
            <article
              class:list={[
                'flex min-h-[315px] flex-col justify-between py-9 md:p-10',
                index > 0 ? 'border-t border-walnut/15' : '',
                index % 2 === 1 ? 'md:border-l md:border-walnut/15' : '',
                index > 1 ? 'md:border-t' : 'md:border-t-0',
              ]}
            >
              <div>
                <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-gold">{service.label}</p>
                <h3 class="mt-5 max-w-[480px] font-serif text-[30px] leading-[1.08] text-ink">{service.title}</h3>
                <p class="mt-5 max-w-[500px] text-[15px] leading-[1.75] text-muted">{service.body}</p>
              </div>
              <a href={service.href} class="mt-8 inline-flex text-[13px] font-semibold text-ink underline decoration-ink/30 underline-offset-4 hover:text-gold">
                {service.cta}
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="on-dark bg-walnut px-6 py-[clamp(72px,9vw,120px)]">
      <div class="mx-auto max-w-[1240px]">
        <div class="grid gap-10 border-b border-ivory/20 pb-12 lg:grid-cols-[0.82fr_1.18fr] lg:gap-24">
          <div>
            <span class="kicker">Platelet-rich fibrin</span>
            <h2 class="max-w-[570px] font-serif text-[clamp(38px,5.5vw,60px)] leading-[1.02] tracking-[-0.02em] text-ivory">
              PRF is used topically or by injection.
            </h2>
          </div>
          <div class="max-w-[690px] lg:pt-8">
            <p class="font-serif text-[clamp(23px,3vw,32px)] leading-[1.25] text-ivory">
              PRF is a platelet concentrate prepared from a small sample of your own blood. The way it is used changes what the appointment is for.
            </p>
            <p class="mt-6 text-[16px] leading-[1.8] text-ivory/72">
              At House of Rose, topical PRF is used with microneedling, while under-eye PRF and PRF Bio-Filler are injectable appointments provided by Diana Morrison, RN.
            </p>
          </div>
        </div>

        <div class="grid divide-y divide-ivory/15 lg:grid-cols-3 lg:divide-x lg:divide-y-0">
          <article class="py-9 lg:pr-9">
            <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-gold">With microneedling</p>
            <h3 class="mt-5 font-serif text-[29px] leading-[1.1] text-ivory">Topical PRF with microneedling</h3>
            <p class="mt-5 text-[15px] leading-[1.75] text-ivory/72">
              PRF is applied to the skin surface during an eligible microneedling service. It is not injected.
            </p>
            <p class="mt-4 text-[13px] font-semibold leading-[1.65] text-ivory/90">
              {topicalPrf.durationMinutes} minutes · ${topicalPrf.priceUsd}
            </p>
            <a href="/services/microneedling/" class="mt-6 inline-flex text-[13px] font-semibold text-ivory underline decoration-ivory/35 underline-offset-4 hover:text-gold">
              Microneedling with topical PRF
            </a>
          </article>
          <article class="py-9 lg:px-9">
            <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-gold">Under-eye appointment</p>
            <h3 class="mt-5 font-serif text-[29px] leading-[1.1] text-ivory">Injectable PRF</h3>
            <p class="mt-5 text-[15px] leading-[1.75] text-ivory/72">
              Diana Morrison, RN provides the under-eye PRF appointment under medical direction.
            </p>
            <p class="mt-4 text-[13px] font-semibold leading-[1.65] text-ivory/90">
              ${underEyePrf.priceUsd} · Call to confirm the appointment length
            </p>
            <a href="/services/prf-under-eyes/" class="mt-6 inline-flex text-[13px] font-semibold text-ivory underline decoration-ivory/35 underline-offset-4 hover:text-gold">
              Read about PRF under eyes
            </a>
          </article>
          <article class="py-9 lg:pl-9">
            <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-gold">Bio-Filler appointment</p>
            <h3 class="mt-5 font-serif text-[29px] leading-[1.1] text-ivory">PRF Bio-Filler</h3>
            <p class="mt-5 text-[15px] leading-[1.75] text-ivory/72">
              Diana Morrison, RN provides PRF Bio-Filler as an injectable appointment under medical direction.
            </p>
            <p class="mt-4 text-[13px] font-semibold leading-[1.65] text-ivory/90">
              {bioFillerPrf.durationMinutes} minutes · ${bioFillerPrf.priceUsd}
            </p>
            <a href="/services/prf-injections/" class="mt-6 inline-flex text-[13px] font-semibold text-ivory underline decoration-ivory/35 underline-offset-4 hover:text-gold">
              Injectable PRF appointments
            </a>
          </article>
        </div>

        <div class="grid gap-7 border-t border-ivory/20 pt-8 lg:grid-cols-[1fr_auto] lg:items-end">
          <div class="max-w-[780px]">
            <h3 class="font-serif text-[25px] text-ivory">PRF and dermal filler use different materials.</h3>
            <p class="mt-3 text-[15px] leading-[1.75] text-ivory/72">
              PRF is an autologous platelet concentrate. Hyaluronic-acid dermal filler is a manufactured injectable gel. The material, preparation, and purpose of the appointment all differ.
            </p>
          </div>
          <div class="flex flex-wrap gap-x-7 gap-y-3 text-[13px] font-semibold">
            <a href="/services/prf/" class="text-ivory underline decoration-ivory/35 underline-offset-4 hover:text-gold">
              Explore PRF
            </a>
            <a href="/services/dermal-fillers/" class="text-ivory underline decoration-ivory/35 underline-offset-4 hover:text-gold">
              Dermal Fillers
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-bone px-6 py-[clamp(72px,9vw,120px)]">
      <div class="mx-auto grid max-w-[1240px] items-center gap-12 lg:grid-cols-[1.08fr_0.92fr] lg:gap-20">
        <figure class="relative aspect-[4/3] overflow-hidden bg-limestone">
          <img
            src="/images/optimized/actual-welcome-1400.webp"
            srcset="/images/optimized/actual-welcome-800.webp 800w, /images/optimized/actual-welcome-1400.webp 1400w"
            sizes="(max-width: 1023px) 100vw, 52vw"
            alt="The welcome hallway inside House of Rose Aesthetics"
            width="1400"
            height="1050"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover"
          />
        </figure>

        <div>
          <span class="kicker">The detail matters</span>
          <h2 class="font-serif text-[clamp(36px,5vw,56px)] leading-[1.03] tracking-[-0.02em] text-ink">
            Bring us the thing you keep seeing in the mirror.
          </h2>
          <div class="mt-7 max-w-[650px] space-y-5 text-[17px] leading-[1.75] text-muted">
            <p>
              An under-eye shadow can come from pigment, thin skin, hollowing, or a combination. Facial lines may reflect movement, volume, texture, or all three. Two concerns that look similar in a photograph may point toward different services.
            </p>
            <p>
              Point to it in the mirror, bring the photograph where it shows up, or simply describe when you notice it most. You do not need to name it before you ask about it; we can explain the relevant House of Rose services in plain language.
            </p>
          </div>

          <div class="mt-9 flex flex-wrap gap-x-7 gap-y-3 border-t border-walnut/15 pt-7 text-[13px] font-semibold">
            <a href="/concerns/" class="text-ink underline decoration-ink/30 underline-offset-4 hover:text-gold">Explore concerns</a>
            <a href="/compare/" class="text-ink underline decoration-ink/30 underline-offset-4 hover:text-gold">Compare options</a>
            <a href="/skin-analysis/" class="text-ink underline decoration-ink/30 underline-offset-4 hover:text-gold">Skin Analysis</a>
          </div>
        </div>
      </div>
    </section>

    <section class="on-dark bg-green-deep px-6 py-[clamp(72px,9vw,120px)]">
      <div class="mx-auto grid max-w-[1240px] gap-12 lg:grid-cols-[0.82fr_1.18fr] lg:items-center lg:gap-20">
        <div class="max-w-[560px]">
          <span class="kicker">The people</span>
          <h2 class="font-serif text-[clamp(40px,5.5vw,62px)] leading-[1.02] tracking-[-0.02em] text-ivory">
            Who you trust with your face matters.
          </h2>
          <p class="mt-7 text-[17px] leading-[1.8] text-ivory/78">
            Know who provides your appointment before you book it. Diana Morrison, RN provides injectables, IV hydration, and provider-guided weight management. Amber Mingione, Licensed Esthetician provides Microneedling with the Procell Therapies device, Glo2Facial, dermaplaning, and BioRePeel add-ons. Brandy, Licensed Esthetician, and Aundrea Pedigo, Licensed Esthetician, round out the team with facials, waxing, makeup artistry, and permanent jewelry.
          </p>
          <div class="mt-7 grid gap-3 border-t border-ivory/20 pt-6 text-[13px] leading-[1.6]">
            <a href="/about/providers/brandy/" class="group flex items-baseline justify-between gap-5 text-ivory hover:text-gold">
              <span>
                <strong class="font-semibold">Brandy, Licensed Esthetician</strong><br />
                <span class="text-ivory/80 group-hover:text-gold">Facials · Standalone BioRePeel · Facial waxing</span>
              </span>
              <span aria-hidden="true">→</span>
            </a>
            <a href="/about/providers/aundrea/" class="group flex items-baseline justify-between gap-5 text-ivory hover:text-gold">
              <span>
                <strong class="font-semibold">Aundrea Pedigo, Licensed Esthetician</strong><br />
                <span class="text-ivory/80 group-hover:text-gold">Makeup artistry · Permanent jewelry</span>
              </span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
          <p class="mt-7 border-t border-ivory/20 pt-6 text-[14px] leading-[1.75] text-ivory/72">
            Medical direction and the person providing your appointment are different roles. Joshua Shaw, MD provides medical direction and protocol supervision; he does not perform treatment appointments at House of Rose. The practitioner named for the service is the person associated with your appointment.
          </p>
          <p class="mt-7 border-t border-ivory/20 pt-6 text-[13px] font-semibold tracking-[0.02em] text-ivory">
            Medical Director: Joshua Shaw, MD · FL Lic. ME136232
          </p>
          <a href="/about/providers/" class="btn-outline-white mt-9">Meet the House of Rose team</a>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <a href="/about/providers/diana/" class="group block border border-ivory/20 bg-ink/15 p-3">
            <div class="aspect-[4/5] overflow-hidden bg-ink/20">
              <img
                src="/images/providers/diana-profile-1122.webp"
                alt="Diana Morrison, RN, at House of Rose Aesthetics"
                width="1122"
                height="1402"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.02]"
              />
            </div>
            <div class="px-2 pb-2 pt-5">
              <h3 class="font-serif text-[25px] text-ivory">Diana Morrison, RN</h3>
              <p class="mt-2 text-[12px] uppercase tracking-[0.12em] text-ivory/95">Registered Nurse</p>
            </div>
          </a>

          <a href="/about/providers/amber/" class="group block border border-ivory/20 bg-ink/15 p-3 sm:translate-y-10">
            <div class="aspect-[4/5] overflow-hidden bg-ink/20">
              <img
                src="/images/providers/amber-profile-1122.webp"
                alt="Amber Mingione, Licensed Esthetician, at House of Rose Aesthetics"
                width="1122"
                height="1402"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.02]"
              />
            </div>
            <div class="px-2 pb-2 pt-5">
              <h3 class="font-serif text-[25px] text-ivory">Amber Mingione, Licensed Esthetician</h3>
              <p class="mt-2 text-[12px] uppercase tracking-[0.12em] text-ivory/95">Licensed Esthetician</p>
            </div>
          </a>
        </div>
      </div>
    </section>

    <section class="bg-breath px-6 py-[clamp(72px,9vw,120px)]">
      <div class="mx-auto max-w-[1240px]">
        <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
          <div>
            <span class="kicker">The practice</span>
            <h2 class="max-w-[690px] font-serif text-[clamp(36px,5vw,56px)] leading-[1.03] tracking-[-0.02em] text-ink">
              Inside House of Rose.
            </h2>
          </div>
          <div class="max-w-[590px] text-[16px] leading-[1.75] text-muted">
            <p>
              These are the actual treatment rooms and storefront at 525 E Olympia Avenue in Punta Gorda.
            </p>
          </div>
        </div>

        <div class="mt-12 grid gap-5 lg:grid-cols-[0.82fr_1.18fr]">
          <figure>
            <div class="relative aspect-[3/4] overflow-hidden bg-limestone">
              <img
                src="/images/optimized/house-of-rose-storefront-1000.webp"
                srcset="/images/optimized/house-of-rose-storefront-700.webp 700w, /images/optimized/house-of-rose-storefront-1000.webp 1000w"
                sizes="(max-width: 1023px) 100vw, 42vw"
                alt="The House of Rose Aesthetics storefront at 525 E Olympia Avenue in Punta Gorda"
                width="1000"
                height="1333"
                loading="lazy"
                decoding="async"
