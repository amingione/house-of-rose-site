---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { BUSINESS_URLS, LOCAL_BUSINESS } from '@/lib/structuredData';
import { sanityFetch } from '@/lib/sanity';
import { PUBLIC_PROVIDERS_QUERY, type PublicProviderProfile } from '@/lib/queries';
import { resolvePublicProviderProfiles } from '@/lib/aboutFallbacks';
import { sbFieldPath, sbObjectId } from '@/lib/visualEditing';
import TreatmentComparisonMedia from '@/components/home/TreatmentComparisonMedia.astro';

const phoneDisplay = '(941) 400-0165';
const phoneHref = `tel:${LOCAL_BUSINESS.telephone}`;

const sanityProviders = await sanityFetch<PublicProviderProfile[]>(PUBLIC_PROVIDERS_QUERY);
const providers = resolvePublicProviderProfiles(sanityProviders);
const sanityProviderIds = new Set(sanityProviders.map((provider) => provider._id));

// The treatment rail alternates image and text row by row, so each entry needs
// its own in-budget asset — the 200 KB public-image ceiling rules out the 1400px
// Morpheus8 room render (205 KB), which is why that row uses the 800px variant.
const treatmentRail = [
  {
    kicker: 'Skin',
    title: 'Skin Rejuvenation',
    lede: 'Facials, peels, dermaplaning, microchanneling, microneedling, and advanced skin treatments selected around your skin and goals.',
    href: '/services/collections/facials/',
    image: '/images/optimized/dermaplaning-1400.webp',
    imageSrcset: '/images/optimized/dermaplaning-800.webp 800w, /images/optimized/dermaplaning-1400.webp 1400w',
    imageAlt: 'Dermaplaning at House of Rose Aesthetics in Punta Gorda',
    ctaLocation: 'homepage-category-skin',
  },
  {
    kicker: 'Injectables + PRF',
    title: 'Injectables + Regenerative Aesthetics',
    lede: 'Neuromodulators, dermal fillers, and PRF treatments with individualized planning and appropriate provider oversight.',
    href: '/services/injectables-bio-fillers/',
    image: '/images/editorial/home/injectables-consultation.webp',
    imageAlt: 'An injectable consultation, mapping the treatment areas on a client’s face',
    ctaLocation: 'homepage-category-injectables-and-prf',
  },
  {
    kicker: 'Technology',
    title: 'Advanced Technology',
    lede: 'Morpheus8, Lumecca Peak IPL, Forma, and other technology-based treatments for a range of face and body concerns.',
    href: '/services/inmode/',
    image: '/images/inmode/morpheus8-burst-device.webp',
    imageAlt: 'The Morpheus8 Burst radiofrequency microneedling handpiece',
    contain: true,
    ctaLocation: 'homepage-category-technology',
  },
  {
    kicker: 'Wellness',
    title: 'IV + Wellness',
    lede: 'IV hydration and medically guided weight-management services with evaluation and follow-up built into the process.',
    href: '/services/iv-hydration-therapy/',
    // Amber's pick — keep this photo. Only the source file changed: the 1.5 MB
    // original blew the 200 KB public-image budget, so these are optimized
    // renditions of the same shot. Do not swap the photo.
    image: '/images/optimized/hofr-med-spa5-1400.webp',
    imageSrcset: '/images/optimized/hofr-med-spa5-800.webp 800w, /images/optimized/hofr-med-spa5-1400.webp 1400w',
    imageAlt: 'The IV Hydration Therapy suite at House of Rose Aesthetics in Punta Gorda',
    ctaLocation: 'homepage-category-wellness',
  },
] as const;
---

<BaseLayout
  title="House of Rose Aesthetics | Medical Aesthetics in Punta Gorda"
  description="A medical aesthetics practice in Punta Gorda, Florida — skin treatments, injectables, regenerative aesthetics, advanced technology, IV, and wellness."
  preloadImage="/images/hero/treatment-scan-poster.webp"
>
  <!-- Hero — split field: type on the ivory half, photography full-bleed on the
       other. `pt-16 sm:pt-20` clears the fixed header at both of its heights. -->
  <section class="relative grid grid-cols-2 pt-16 sm:pt-20 lg:min-h-[100svh]">
    <div class="flex min-w-0 flex-col justify-center px-3 py-8 sm:px-6 md:px-10 lg:px-16">
      <p class="rise text-[0.5rem] font-medium uppercase leading-[1.4] tracking-[0.18em] text-rose sm:text-[0.625rem] sm:tracking-[0.22em] md:text-kicker md:tracking-label">
        Punta Gorda, Florida
      </p>
      <h1 class="rise rise-2 mt-3 font-display text-[clamp(2rem,10vw,3.25rem)] leading-display tracking-[0.04em] text-ink sm:mt-4 sm:tracking-[0.06em] md:mt-6 md:text-display md:tracking-display">
        House<br />of Rose
      </h1>
      <p class="rise rise-3 mt-2 text-[0.5rem] font-medium uppercase leading-[1.4] tracking-[0.14em] text-muted sm:text-[0.625rem] sm:tracking-wide md:mt-4 md:text-kicker">
        Aesthetics
      </p>
      <p class="rise rise-4 mt-4 max-w-xl text-xs leading-[1.55] text-ink sm:text-sm md:mt-8 md:text-lede md:leading-body">
        A medical aesthetics practice offering advanced skin treatments, injectables,
        regenerative aesthetics, technology-based treatments, IV hydration, and medically
        guided weight management.
      </p>
      <div class="rise rise-4 mt-5 flex flex-col items-stretch gap-2 sm:mt-6 md:mt-10 md:flex-row md:flex-wrap md:items-center md:gap-3">
        <a
          href={BUSINESS_URLS.services}
          target="_blank"
          rel="noopener noreferrer"
          class="hero-action"
          data-cta-location="homepage-hero"
        >
          Request a visit
        </a>
        <a href="/services/" class="hero-action-quiet">Read the treatments</a>
      </div>
    </div>
    <TreatmentComparisonMedia />
  </section>

  <!-- The work — kicker in the narrow column, statement and body in the wide one. -->
  <section class="border-t border-line">
    <div class="mx-auto grid max-w-[1280px] gap-12 px-5 py-20 sm:px-8 lg:grid-cols-12 lg:gap-16 lg:py-28">
      <p class="text-kicker font-medium uppercase tracking-label text-rose lg:col-span-3">
        The practice
      </p>
      <div class="lg:col-span-9">
        <h2 class="max-w-3xl font-display text-display-sm leading-display text-ink">
          A more considered way to approach aesthetics.
        </h2>
        <div class="mt-10 grid gap-8 sm:grid-cols-2">
          <p class="text-body leading-body text-muted">
            House of Rose brings <a href="/services/collections/facials/" class="font-medium text-ink underline decoration-rose/45 underline-offset-4 hover:text-rose">skin care</a>, <a href="/services/injectables-bio-fillers/" class="font-medium text-ink underline decoration-rose/45 underline-offset-4 hover:text-rose">injectables</a>, regenerative treatments, <a href="/services/inmode/" class="font-medium text-ink underline decoration-rose/45 underline-offset-4 hover:text-rose">advanced
            technology</a>, and <a href="/services/iv-hydration-therapy/" class="font-medium text-ink underline decoration-rose/45 underline-offset-4 hover:text-rose">wellness services</a> together in one Punta Gorda practice —
            designed around consultation, treatment, and follow-through rather than a
            high-volume spa experience.
          </p>
          <p class="text-body leading-body text-muted">
            Start with the <a href="/services/" class="font-medium text-ink underline decoration-rose/45 underline-offset-4 hover:text-rose">service</a> you already know you want, or explore the category that
            best matches your goals. If you would rather talk it through first, that is what
            a <a href="/consultation/" class="font-medium text-ink underline decoration-rose/45 underline-offset-4 hover:text-rose">consultation</a> is for.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Treatments rail — full-bleed alternating rows, image and text swapping sides. -->
  <section class="border-t border-line">
    <div class="mx-auto max-w-[1280px] px-5 py-16 sm:px-8 lg:py-20">
      <div class="flex items-end justify-between gap-6">
        <div>
          <p class="text-kicker font-medium uppercase tracking-label text-rose">Treatments</p>
          <h2 class="mt-3 font-display text-display-sm leading-display text-ink">
            Treatments that define the practice.
          </h2>
        </div>
        <a href="/services/" class="rail-link hidden sm:inline-flex">All treatments</a>
      </div>
    </div>

    <ul class="border-t border-line">
      {treatmentRail.map((item, index) => (
        <li class="border-b border-line">
          <a
            href={item.href}
            class="group mx-auto grid max-w-[1280px] items-stretch sm:grid-cols-12"
            data-cta-location={item.ctaLocation}
          >
            <div
              class:list={[
                'relative min-h-72 min-w-0 overflow-hidden sm:col-span-5 sm:min-h-96',
                index % 2 === 1 && 'sm:order-2',
                'contain' in item && item.contain && 'bg-breath',
              ]}
            >
              <img
                src={item.image}
                srcset={'imageSrcset' in item ? item.imageSrcset : undefined}
                sizes={'imageSrcset' in item ? '(max-width: 639px) 100vw, 42vw' : undefined}
                alt={item.imageAlt}
                width="1400"
                height="1050"
                loading="lazy"
                decoding="async"
                class:list={[
                  'absolute inset-0 h-full w-full transition-transform duration-slow ease-out-soft group-hover:scale-[1.03]',
                  'contain' in item && item.contain ? 'object-contain p-10 sm:p-14' : 'object-cover',
                ]}
              />
            </div>
            <div
              class:list={[
                'flex min-w-0 flex-col justify-center px-5 py-10 sm:col-span-7 sm:px-12 lg:px-16',
                index % 2 === 1 && 'sm:order-1',
              ]}
            >
              <p class="text-kicker font-medium uppercase tracking-label text-rose">
                {item.kicker}
              </p>
              <h3 class="mt-3 font-display text-4xl leading-display text-ink sm:text-5xl">
                {item.title}
              </h3>
              <p class="mt-4 max-w-md text-body leading-body text-muted">{item.lede}</p>
              <span class="mt-6 inline-flex min-h-11 items-center text-kicker font-medium uppercase tracking-label text-ink">
                Read more
                <span class="ml-2 transition-transform duration-fast group-hover:translate-x-1" aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Skin analysis — the dark full-bleed interruption in the page rhythm. -->
  <section class="on-dark relative min-h-[70vh] overflow-hidden">
    <img
      src="/images/editorial/home/skin-analysis-consultation.webp"
      alt=""
      width="1448"
      height="1086"
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-ink/70"></div>
    <div class="relative mx-auto flex min-h-[70vh] max-w-4xl flex-col items-center justify-center px-6 py-24 text-center">
      <p class="text-kicker font-medium uppercase tracking-label text-ivory/70">
        Advanced skin analysis
      </p>
      <h2 class="mt-6 font-display text-display-sm leading-display text-ivory">
        Better treatment planning starts with better information.
      </h2>
      <p class="mt-8 max-w-2xl text-body leading-body text-ivory/75">
        Multi-spectrum skin imaging gives us an additional view of visible texture, pores,
        pigmentation, fine lines, and sun exposure. The images are reviewed with you as a
        baseline and used alongside your concerns and goals when discussing treatment options.
      </p>
      <a href="/skin-analysis/" class="rail-link mt-10 text-ivory decoration-ivory/40">
        Explore skin analysis
      </a>
    </div>
  </section>

  <!-- The house — statement on the left, the people as divided rows on the right. -->
  <section class="border-t border-line bg-paper">
    <div class="mx-auto grid max-w-[1280px] gap-12 px-5 py-20 sm:px-8 lg:grid-cols-12 lg:gap-16 lg:py-28">
      <div class="lg:col-span-5">
        <p class="text-kicker font-medium uppercase tracking-label text-rose">The team</p>
        <h2 class="mt-4 font-display text-display-sm leading-display text-ink">
          Experience matters.
        </h2>
        <p class="mt-6 max-w-md text-body leading-body text-muted">
          House of Rose brings together medical and esthetic providers with clearly defined
          roles across injectables, skin treatments, IV hydration, weight management, facials,
          waxing, and makeup.
        </p>
        <p class="mt-6 max-w-md text-[14px] leading-body text-muted">
          Medical Director: Joshua Shaw, MD · FL Lic. ME136232
        </p>
        <a href="/about/providers/" class="rail-link mt-8">Meet the House of Rose team</a>
      </div>
      <ul class="divide-y divide-line border-b border-t border-line lg:col-span-7">
        {providers.map((provider) => (
          <li
            class="grid gap-2 py-6 sm:grid-cols-5 sm:gap-6"
            {...(sanityProviderIds.has(provider._id) ? sbObjectId(provider._id) : {})}
          >
            <div class="sm:col-span-2">
              <a href={`/about/providers/${provider.slug}/`} class="font-display text-xl text-ink hover:text-gold" {...sbFieldPath('publicName')}>
                {provider.displayName ?? provider.publicName}
              </a>
              <p class="mt-1 text-kicker uppercase tracking-label text-muted" {...sbFieldPath('publicRole')}>
                {provider.publicRole}
              </p>
            </div>
            <p class="text-sm leading-body text-muted sm:col-span-3" {...sbFieldPath('summary')}>
              {provider.summary}
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Visit — photography and an ink panel, split down the middle. -->
  <section class="grid lg:grid-cols-2">
    <div class="relative min-h-[60vh]">
      <img
        src="/images/optimized/house-of-rose-storefront-1000.webp"
        srcset="/images/optimized/house-of-rose-storefront-700.webp 700w, /images/optimized/house-of-rose-storefront-1000.webp 1000w"
        sizes="(max-width: 1023px) 100vw, 50vw"
        alt="House of Rose Aesthetics storefront at 525 E Olympia Avenue in Punta Gorda"
        width="1000"
        height="1333"
        loading="lazy"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover"
      />
    </div>
    <div class="on-dark flex flex-col justify-center bg-ink px-6 py-16 text-ivory sm:px-12 lg:px-16">
      <p class="text-kicker font-medium uppercase tracking-label text-ivory/55">Visit</p>
      <h2 class="mt-4 font-display text-display-sm leading-display text-ivory">
        525 E Olympia Avenue, Unit 9.
      </h2>
      <p class="mt-6 max-w-md text-body leading-body text-ivory/75">
        Open Monday through Friday, 9 AM–5 PM. Call {phoneDisplay}, or send a message
        and we will find a time.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a href="/contact/" class="hero-action-invert" data-cta-location="homepage-final-inquiry">
          Request a visit
        </a>
        <a href={phoneHref} class="rail-link text-ivory decoration-ivory/30" data-cta-location="homepage-final-call">
          {phoneDisplay}
        </a>
      </div>
      <a
        href={BUSINESS_URLS.map}
        target="_blank"
        rel="noopener noreferrer"
        class="rail-link mt-6 self-start text-ivory/75 decoration-ivory/25"
      >
        Get directions
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* Square, letter-spaced page actions — the same geometry as the header CTA. */
  .hero-action,
  .hero-action-invert {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding-inline: 28px;
    font-size: var(--text-kicker);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    transition: opacity var(--duration-quick) var(--ease-out-soft);
  }
  .hero-action {
    background: var(--color-ink);
    color: var(--color-ivory);
  }
  .hero-action-invert {
    background: var(--color-ivory);
    color: var(--color-ink);
  }
  .hero-action:hover,
  .hero-action-invert:hover { opacity: 0.8; }

  .hero-action-quiet,
  .rail-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--color-ink);
    font-size: var(--text-kicker);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-color: var(--color-stone);
    text-underline-offset: 4px;
    transition: opacity var(--duration-quick) var(--ease-out-soft);
  }
  .hero-action-quiet { padding-inline: 20px; }
  .hero-action-quiet:hover,
  .rail-link:hover { opacity: 0.6; }

  @media (max-width: 639px) {
    .rail-link.hidden { display: none; }
  }

  @media (max-width: 767px) {
    .hero-action,
    .hero-action-invert {
      min-height: 40px;
      padding-inline: 10px;
      font-size: 0.5rem;
      letter-spacing: 0.18em;
    }

    .hero-action-quiet {
      min-height: 36px;
      padding-inline: 4px;
      font-size: 0.5rem;
      letter-spacing: 0.18em;
    }
  }
</style>
