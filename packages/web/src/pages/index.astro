---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/Hero.astro";
import { sanityFetch } from "@/lib/sanity";
import { sbObjectId, sbFieldPath, sbFieldPathParts } from "@/lib/visualEditing";
import { HOMEPAGE_QUERY, type HomePage } from "@/lib/queries";

// Public contact + services links (the GlossGenius URL is a menu, not the primary booking CTA)
const SERVICES_MENU_URL = "https://houseofrose.glossgenius.com/services";
const SKIN_ANALYSIS_URL = "/skin-analysis/";
const SHOP_URL = "/shop/";

// ─── Home content from Sanity (singleton) ──────────────────────────────────────
// Falls back to the original copy if a field is empty, so there's no regression.
const hp = (await sanityFetch<HomePage | null>(HOMEPAGE_QUERY)) ?? ({} as HomePage);
const oid = hp._id ? sbObjectId(hp._id) : {};

// Homepage service groups (four clear starting points, not a treatment dump)
const FALLBACK_SERVICE_GROUPS = [
	{
		name: "Regenerative Skin Treatments",
		description:
			"procell microchanneling, topical PRF needling, BioRePeel, and other advanced options for the visible texture and tone concerns you want to address.",
		imagePath: "/images/editorial/home/regenerative-skin-treatments.webp",
	},
	{
		name: "Injectables & Structural Enhancements",
		description:
			"Neurotoxins, dermal fillers, PRF under-eye options, and EZ Gel bio-filler approached with balance and a natural-looking result in mind.",
		imagePath: "/images/editorial/home/injectables-consultation.webp",
	},
	{
		name: "Skin Health & Corrective Care",
		description:
			"Face Reality acne care, Glo2Facials, dermaplaning, LED therapy, and straightforward guidance based on what your skin is showing today.",
		imagePath: "/images/editorial/home/skin-health-analysis.webp",
	},
	{
		name: "Wellness & Performance Support",
		description:
			"IV hydration, provider-guided weight management, permanent jewelry, and services that round out your care at House of Rose.",
		imagePath: "/images/editorial/home/wellness-iv-hydration.webp",
	},
];
const serviceGroups = hp.serviceGroups?.length
	? hp.serviceGroups.map((group, index) => ({
		...group,
		imagePath: FALLBACK_SERVICE_GROUPS[index]?.imagePath ?? FALLBACK_SERVICE_GROUPS[0].imagePath,
	}))
	: FALLBACK_SERVICE_GROUPS;

// Each homepage pillar deep-links to its grouped section on /services/ (anchors
// defined in services/index.astro SERVICE_GROUP_SECTIONS). Keyed by a normalized
// name so Sanity copy tweaks ("Advanced" vs "Regenerative") still resolve.
const GROUP_ANCHORS: Record<string, string> = {
	"advanced skin treatments": "/services/#advanced-skin-treatments",
	"regenerative skin treatments": "/services/#advanced-skin-treatments",
	"injectables & structural enhancements": "/services/#injectables-structural-enhancements",
	"skin health & corrective care": "/services/#skin-health-corrective-care",
	"wellness & performance support": "/services/#wellness-performance-support",
};
const groupHref = (name: string): string =>
	GROUP_ANCHORS[name.trim().toLowerCase()] ?? "/services/";
const alignPublicChannelCopy = (value: string): string =>
	value
		.replace(/call\s*(?:or|\/)\s*text/gi, "call")
		.replace(/book (?:your visit )?online/gi, "review the current services menu");
const servicesMenuCta = /book|schedule/i.test(hp.scanCtaSecondaryText ?? "")
	? "View Services"
	: (hp.scanCtaSecondaryText ?? "View Services");

---

<BaseLayout
	title={hp.seoTitle ?? "House of Rose Aesthetics | Advanced Aesthetics & Wellness in Punta Gorda, FL"}
	description={hp.seoDescription ?? "Explore advanced aesthetics, injectables, facials, wellness services, and professional skincare at House of Rose in Punta Gorda, Florida."}
	preloadImage="/images/banner/HOR-where-beauty-blooms-within.webp"
>
	<div {...oid}>
	<!-- ── SECTION 1 · HERO ─────────────────────────────────────────── -->
	<Hero
		title={hp.heroTitle ?? "HOUSE OF ROSE\nAESTHETICS"}
		subtitle={hp.heroSubtitle ?? "PUNTA GORDA, FL"}
		kicker={hp.heroKicker ?? "Refined Aesthetics. Natural Results"}
		description={hp.heroDescription ?? "Thoughtful treatments for your skin, features, and overall wellness—chosen around your goals and what makes sense for you. We focus on natural-looking results and long-term skin health."}
		size="full"
		centerContent={true}
		showCTA={true}
		ctaPrimary={{ text: hp.heroCtaPrimaryText ?? "Book Your Skin Analysis", href: SKIN_ANALYSIS_URL }}
		ctaSecondary={{ text: hp.heroCtaSecondaryText ?? "Explore Services", href: "/services/" }}
		backgroundImage="/images/banner/HOR-where-beauty-blooms-within.webp"
		titleField="heroTitle"
		subtitleField="heroSubtitle"
		kickerField="heroKicker"
		descriptionField="heroDescription"
	/>

	<!-- ── SECTION 2 · INTRO / BRAND POSITIONING ───────────────────── -->
	<section class="bg-charcoal grid grid-cols-1 md:grid-cols-2">
		<div class="p-[clamp(38px,6vw,76px)] flex flex-col justify-center">
			<span class="kicker" {...sbFieldPath("aboutKicker")}>{hp.aboutKicker ?? "About House of Rose"}</span>
			<h2
				class="font-serif text-[clamp(24px,3.4vw,38px)] text-ink leading-tight mt-2 mb-6"
				{...sbFieldPath("aboutHeading")}
			>
				{hp.aboutHeading ?? "Care that starts with listening."}
			</h2>
			<p
				class="text-muted text-[15px] leading-[1.75] max-w-[560px] mb-4"
				{...sbFieldPath("aboutPara1")}
			>
				{hp.aboutPara1 ?? "House of Rose is for people who want to understand their options, ask questions, and never feel rushed through a treatment."}
			</p>
			<p
				class="text-muted text-[15px] leading-[1.75] max-w-[560px] mb-4"
				{...sbFieldPath("aboutPara2")}
			>
				{hp.aboutPara2 ?? "We look at your goals, your skin, and your comfort level before recommending a next step. AI-assisted imaging can add useful detail, while a real conversation keeps the plan grounded in what matters to you."}
			</p>
			<p class="text-muted text-[15px] leading-[1.75] max-w-[560px]" {...sbFieldPath("aboutPara3")}>
				{hp.aboutPara3 ?? "That might mean one focused service or a plan that changes over time. Either way, you'll know what we're recommending and why."}
			</p>
		</div>
		<div class="relative min-h-[340px] bg-charcoal-lighter">
			<img
				src="/images/welcome-house-of-rose.webp"
				alt="The House of Rose Aesthetics lounge in Punta Gorda, Florida"
				loading="lazy"
				class="w-full h-full object-cover"
				width="1400"
				height="933"
			/>
		</div>
	</section>

	<!-- ── SECTION 3 · SIGNATURE APPROACH (full-bleed) ─────────────── -->
	<section
		class="on-dark relative py-[clamp(72px,11vw,150px)] px-6 bg-cover bg-center"
		style="background-image: url('/images/hor-skin-studio.webp');"
	>
		<!-- Warm walnut gradient scrim. Inline style (can't be Tailwind-purged / always renders).
		     Every stop tuned so ivory text ≥ AAA and the gold.300 kicker ≥ AA even over a
		     pure-white photo pixel (worst case). Top 0.86 keeps the kicker legible; the photo
		     still reads as a faint warm texture at ~10-14%. -->
		<div
			class="absolute inset-0"
			style="background:linear-gradient(180deg,rgba(44,31,22,0.86) 0%,rgba(44,31,22,0.92) 50%,rgba(44,31,22,0.88) 100%);"
		></div>
		<div class="relative z-10 max-w-[760px] mx-auto text-center">
			<span class="kicker text-gold" {...sbFieldPath("approachKicker")}>{hp.approachKicker ?? "Our Approach"}</span>
			<h2
				class="font-serif text-[clamp(24px,3.6vw,40px)] text-ivory leading-tight mt-2 mb-7"
				{...sbFieldPath("approachHeading")}
			>
				{hp.approachHeading ?? "Advanced care, with a clear reason behind it."}
			</h2>
			<p
				class="text-ivory text-[15px] leading-[1.8] max-w-[640px] mx-auto mb-4"
				{...sbFieldPath("approachPara1")}
			>
				{hp.approachPara1 ?? "Good treatment planning is less about chasing every new option and more about choosing the right service at the right time."}
			</p>
			<p
				class="text-ivory text-[15px] leading-[1.8] max-w-[640px] mx-auto mb-7"
				{...sbFieldPath("approachPara2")}
			>
				{hp.approachPara2 ?? "PRF, microchanneling, facials, injectables, and wellness services each have a place. We look at candidacy, recovery, and the result you want before deciding what belongs in your plan."}
			</p>
			<p
				class="font-serif text-ivory text-[clamp(17px,2vw,22px)] leading-[1.5] max-w-[560px] mx-auto"
				{...sbFieldPath("approachClosing")}
			>
				{hp.approachClosing ?? "You should leave feeling like yourself—just well cared for."}
			</p>
		</div>
	</section>

	<!-- ── SECTION 4 · SERVICES OVERVIEW ───────────────────────────── -->
	<section class="bg-charcoal py-[clamp(48px,7vw,96px)] px-6">
		<div class="max-w-[1280px] mx-auto">
			<div class="max-w-[640px] mb-12">
				<span class="kicker" {...sbFieldPath("servicesKicker")}>{hp.servicesKicker ?? "Services"}</span>
				<h2
					class="font-serif text-[clamp(24px,4vw,40px)] text-ink mt-2 mb-5"
					{...sbFieldPath("servicesHeading")}
				>
					{hp.servicesHeading ?? "Start with what you want to improve."}
				</h2>
				<p class="text-muted text-[15px] leading-[1.75]" {...sbFieldPath("servicesIntro")}>
					{hp.servicesIntro ?? "You don't need to know the name of every treatment before you begin. Explore the four areas below, then we'll help you narrow the options around your goals, candidacy, and preferred recovery time."}
				</p>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-gold-metal/10">
				{
					serviceGroups.map((group, i) => (
						<a href={groupHref(group.name)} class="group block bg-charcoal">
							<div class="aspect-[16/10] overflow-hidden bg-charcoal-lighter">
								<img
									src={group.imagePath}
									alt={group.name}
									loading="lazy"
									class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
									width="700"
									height="438"
								/>
							</div>
							<div class="p-7">
								<h3 class="font-serif text-[21px] text-ink mb-2.5" {...sbFieldPathParts("serviceGroups", i, "name")}>
									{group.name}
								</h3>
								<p class="text-muted text-[14px] leading-[1.7]" {...sbFieldPathParts("serviceGroups", i, "description")}>
									{group.description}
								</p>
							</div>
						</a>
					))
				}
			</div>

			<div class="mt-12">
				<a
					href="/services/"
					class="text-[11px] tracking-[0.2em] uppercase border-b border-gold text-gold pb-0.5 min-h-[44px] inline-flex items-end hover:opacity-75 transition-opacity"
					{...sbFieldPath("servicesCtaText")}
				>
					{hp.servicesCtaText ?? "View All Services"}
				</a>
			</div>
		</div>
	</section>

	<!-- ── SECTION 5 · AI SKIN SCANNER FEATURE ─────────────────────── -->
	<section class="bg-charcoal-light grid grid-cols-1 md:grid-cols-2">
		<div class="relative min-h-[340px] bg-charcoal order-2 md:order-1">
			<img
				src="/images/editorial/home/skin-analysis-consultation.webp"
				alt="A client reviewing her skin analysis with a House of Rose aesthetics provider"
				loading="lazy"
				class="w-full h-full object-cover"
				width="1448"
				height="1086"
			/>
		</div>
		<div
			class="p-[clamp(38px,6vw,76px)] flex flex-col justify-center order-1 md:order-2"
		>
			<span class="kicker" {...sbFieldPath("scanKicker")}>{hp.scanKicker ?? "AI-Assisted Skin Analysis"}</span>
			<h2
				class="font-serif text-[clamp(24px,3.4vw,38px)] text-ink leading-tight mt-2 mb-6"
				{...sbFieldPath("scanHeading")}
			>
				{hp.scanHeading ?? "See what your skin is showing us."}
			</h2>
			<p
				class="text-muted text-[15px] leading-[1.75] max-w-[560px] mb-4"
				{...sbFieldPath("scanPara1")}
			>
				{hp.scanPara1 ?? "If you're not sure where to start, an AI-assisted skin analysis can give us a closer look at texture, hydration, pores, pigmentation, fine lines, and visible sun exposure."}
			</p>
			<p
				class="text-muted text-[15px] leading-[1.75] max-w-[560px] mb-4"
				{...sbFieldPath("scanPara2")}
			>
				{hp.scanPara2 ?? "We'll review the images with you in plain language and connect what we see to the goals you share. You'll leave with a practical starting point and no pressure to book a treatment."}
			</p>
			<p
				class="text-ink/90 text-[15px] italic leading-[1.75] max-w-[560px] mb-7"
				{...sbFieldPath("scanQuote")}
			>
				{hp.scanQuote ?? "Bring your questions. We'll help you make sense of the options."}
			</p>
			<div class="flex gap-3 flex-wrap">
				<a href={SKIN_ANALYSIS_URL} class="btn-gold inline-flex" {...sbFieldPath("scanCtaPrimaryText")}
					>{hp.scanCtaPrimaryText ?? "See What to Expect"}</a
				>
				<a
					href={SERVICES_MENU_URL}
					target="_blank"
					rel="noopener noreferrer"
					class="btn-outline-gold inline-flex" {...sbFieldPath("scanCtaSecondaryText")}>{servicesMenuCta}</a
				>
			</div>
		</div>
	</section>

	<!-- ── SECTION 7 · PRODUCT / HOME CARE PREVIEW ─────────────────── -->
	<section class="bg-charcoal-light grid grid-cols-1 md:grid-cols-2">
		<div class="relative min-h-[340px] bg-charcoal order-2 md:order-1">
			<img
				src="/images/before-after/makeup/makeupbyxamber-jane-iredale-stephanie.png"
				alt="Before and after Jane Iredale makeup application at House of Rose Aesthetics"
				loading="lazy"
				class="w-full h-full object-contain"
				width="1536"
				height="1024"
			/>
		</div>
		<div
			class="p-[clamp(38px,6vw,76px)] flex flex-col justify-center order-1 md:order-2"
		>
			<span class="kicker" {...sbFieldPath("careKicker")}>{hp.careKicker ?? "Home Care"}</span>
			<h2
				class="font-serif text-[clamp(24px,3.4vw,38px)] text-ink leading-tight mt-2 mb-6"
				{...sbFieldPath("careHeading")}
			>
				{hp.careHeading ?? "Skincare that earns its place on your shelf."}
			</h2>
			<p
				class="text-muted text-[15px] leading-[1.75] max-w-[560px] mb-4"
				{...sbFieldPath("carePara1")}
			>
				{hp.carePara1 ?? "The products you use between visits matter. We carry post-treatment aftercare, acne support, mineral makeup, SPF, and professional skincare that can fit into a realistic home routine."}
			</p>
			<p
				class="text-muted text-[15px] leading-[1.75] max-w-[560px] mb-7"
				{...sbFieldPath("carePara2")}
			>
				{hp.carePara2 ?? "We'll help you sort through the options and explain what each recommendation is for, so you can spend less time guessing and more time using what works for your plan."}
			</p>
			<div>
				<a href={SHOP_URL} class="btn-outline-gold inline-flex" {...sbFieldPath("careCtaText")}
					>{hp.careCtaText ?? "Shop Skincare"}</a
				>
			</div>
		</div>
	</section>

	<!-- ── SECTION 8 · THE EXPERIENCE (full-bleed) ─────────────────── -->
	<section
		class="on-dark relative py-[clamp(72px,11vw,150px)] px-6 bg-cover bg-center"
		style="background-image: url('/images/hor-skin-studio.webp');"
	>
		<!-- Warm walnut gradient scrim — same AA-verified treatment as the "Our Approach"
		     section above (this band reuses hor-skin-studio.jpg). Inline style so it can't
		     be Tailwind-purged; every stop clears AA for ivory text + the gold.300 kicker
		     over a worst-case white photo pixel. -->
		<div
			class="absolute inset-0"
			style="background:linear-gradient(180deg,rgba(44,31,22,0.86) 0%,rgba(44,31,22,0.92) 50%,rgba(44,31,22,0.88) 100%);"
		></div>
		<div class="relative z-10 max-w-[720px] mx-auto text-center">
			<span class="kicker text-gold" {...sbFieldPath("expKicker")}>{hp.expKicker ?? "The Experience"}</span>
			<h2
				class="font-serif text-[clamp(24px,3.6vw,40px)] text-ivory leading-tight mt-2 mb-7"
				{...sbFieldPath("expHeading")}
			>
				{hp.expHeading ?? "Time to ask questions. Space to feel comfortable."}
			</h2>
			<p
				class="text-ivory text-[15px] leading-[1.8] max-w-[620px] mx-auto mb-4"
				{...sbFieldPath("expPara1")}
			>
				{hp.expPara1 ?? "We want your visit to feel calm and unhurried. There's time to talk through your goals, look closely at your skin, and understand why a treatment may—or may not—make sense for you."}
			</p>
			<p
				class="text-ivory text-[15px] leading-[1.8] max-w-[620px] mx-auto"
				{...sbFieldPath("expPara2")}
			>
				{hp.expPara2 ?? "Before you leave, you'll know what we did, what to expect next, and how to care for your skin at home."}
			</p>
		</div>
	</section>

	<!-- ── SECTION 9 · LOCAL / TRUST / CONTACT ─────────────────────── -->
	<section class="bg-charcoal py-[clamp(56px,8vw,104px)] px-6">
		<div class="max-w-[760px] mx-auto text-center">
			<span class="kicker" {...sbFieldPath("localKicker")}>{hp.localKicker ?? "Punta Gorda"}</span>
			<h2
				class="font-serif text-[clamp(26px,4vw,42px)] text-ink leading-tight mt-2 mb-7"
				{...sbFieldPath("localHeading")}
			>
				{hp.localHeading ?? "Advanced aesthetics, right here in Punta Gorda."}
			</h2>
			<p
				class="text-muted text-[15px] leading-[1.8] max-w-[600px] mx-auto mb-4"
				{...sbFieldPath("localPara1")}
			>
				{hp.localPara1 ?? "House of Rose welcomes clients from Punta Gorda, Charlotte County, and across Southwest Florida for advanced aesthetics, skin care, injectables, and wellness services."}
			</p>
			<p
				class="text-muted text-[15px] leading-[1.8] max-w-[600px] mx-auto mb-9"
				{...sbFieldPath("localPara2")}
			>
				{alignPublicChannelCopy(hp.localPara2 ?? "Know what you want? Review the current services menu. Still sorting through the options? Call or send us a message and we'll help you choose a sensible place to start.")}
			</p>
			<div class="flex gap-3 justify-center flex-wrap">
				<a
					href={SERVICES_MENU_URL}
					target="_blank"
					rel="noopener noreferrer"
					class="btn-gold">View Services</a
				>
				<a href="/contact/" class="btn-outline-gold">Contact Us</a>
			</div>
		</div>
	</section>

	<!-- ── SECTION 10 · FINAL CTA / FOOTER PREVIEW ─────────────────── -->
	<section
		class="relative py-[clamp(64px,9vw,120px)] px-6 bg-cover bg-center border-t border-gold-metal/10"
		style="background-image: url('/images/banner/background/hr-br-4.webp');"
	>
		<div class="absolute inset-0 bg-charcoal/88"></div>
		<div class="relative z-10 max-w-[640px] mx-auto text-center">
			<h2
				class="font-serif text-[clamp(28px,5vw,46px)] text-ink leading-tight mb-5"
				{...sbFieldPath("finalHeading")}
			>
				{hp.finalHeading ?? "Ready to talk through your options?"}
			</h2>
			<p
				class="text-muted text-[15px] max-w-[480px] mx-auto mb-9 leading-[1.8]"
				{...sbFieldPath("finalPara")}
			>
				{hp.finalPara ?? "Tell us what you're hoping to improve, and we'll help you find the next step that fits your goals."}
			</p>
			<a
				href="/consultation/"
				class="btn-gold"
				{...sbFieldPath("finalCtaText")}
			>
				{hp.finalCtaText ?? "Start Your Consultation"}
			</a>
			<p
				class="text-muted text-[11px] tracking-[0.26em] uppercase mt-9 leading-relaxed"
				set:html={(hp.finalAddressLine ?? "525 E Olympia Ave, Unit 9 · Punta Gorda, FL 33950\nMon–Fri 9AM–5PM · (844) 941-7673").replace(/\n/g, "<br />")}
				{...sbFieldPath("finalAddressLine")}
			/>
		</div>
	</section>
	</div>
</BaseLayout>
