---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import { sanityFetch } from '@/lib/sanity';
import { ALL_SERVICES_QUERY, type Service } from '@/lib/queries';

const services = await sanityFetch<Service[]>(ALL_SERVICES_QUERY);

// WebSite structured data with SearchAction
const websiteData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "House of Rose",
  "url": Astro.site?.toString(),
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": `${Astro.site}services?q={search_term_string}`
    },
    "query-input": "required name=search_term_string"
  }
};

// Organization structured data for SEO
const organizationData = {
  "@context": "https://schema.org",
  "@type": "HealthAndBeautyBusiness",
  "name": "House of Rose Luxury Spa & Wellness",
  "description": "House of Rose Luxury Spa & Wellness in Punta Gorda, FL. Microchanneling, IV hydration, injectables, hormone therapy, and GLP-1 programs in a private luxury setting.",
  "url": Astro.site?.toString(),
  "telephone": "+18449417673",
  "email": "book@houseofrosefl.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "525 E Olympia Ave, Unit 9",
    "addressLocality": "Punta Gorda",
    "addressRegion": "FL",
    "postalCode": "33982",
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "26.9298",
    "longitude": "-82.0454"
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    "opens": "09:00",
    "closes": "17:00"
  },
  "priceRange": "$$",
  "areaServed": {
    "@type": "GeoCircle",
    "geoMidpoint": {
      "@type": "GeoCoordinates",
      "latitude": "26.9298",
      "longitude": "-82.0454"
    },
    "geoRadius": "50000"
  },
  "sameAs": [
    "https://www.instagram.com/houseofrosefl",
    "https://www.facebook.com/houseofrosefl",
    "https://houseofrose.glossgenius.com/services"
  ],
  "hasMap": "https://maps.google.com/?q=525+E+Olympia+Ave+Unit+9+Punta+Gorda+FL+33982",
  "currenciesAccepted": "USD",
  "paymentAccepted": "Cash, Credit Card",
  "slogan": "Where beauty blooms within"
};
---

<BaseLayout
  title="House of Rose Luxury Spa & Wellness | Punta Gorda, FL"
  description="House of Rose Luxury Spa & Wellness in Punta Gorda, FL. Microchanneling, IV hydration, injectables, hormone therapy & GLP-1 treatments. Where beauty blooms within."
  preloadImage="/images/new-reception.png"
>
  <!-- Structured Data for SEO -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteData)} slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationData)} slot="head" />
  <!-- Hero -->
  <Hero
    title="House of Rose"
    subtitle="Where Beauty Blooms Within"
    kicker="Punta Gorda, Florida"
    description="A luxury spa & wellness sanctuary offering microchanneling, IV hydration, injectables, hormone therapy, and GLP-1 treatments."
    size="full"
    showCTA={true}
    ctaPrimary={{ text: 'Book a Service', href: 'https://houseofrose.glossgenius.com/services' }}
    ctaSecondary={{ text: 'Explore Services', href: '/services' }}
    backgroundImage="/images/new-reception.png"
  />

  <!-- The Standard -->
  <section class="bg-charcoal grid grid-cols-1 md:grid-cols-2">
    <div class="p-[clamp(38px,6vw,76px)]">
      <span class="kicker">The Standard</span>
      <h2 class="font-serif text-[clamp(22px,3vw,33px)] text-white leading-tight mb-5">
        Clinical precision.<br />Absolute discretion.
      </h2>
      <p class="text-[#777] text-[15px] leading-[1.7] max-w-[560px] mb-3">
        House of Rose was built on a single conviction: that spa and wellness should feel like a private luxury experience, not a clinical transaction. Every treatment is results-driven, every protocol personalized, every visit unhurried.
      </p>
      <p class="text-[#777] text-[15px] leading-[1.7] max-w-[560px]">
        We serve clients who expect more.
      </p>
    </div>
    <div class="relative min-h-[330px] bg-charcoal-lighter">
      <img
        src="/images/bg-injectables.jpg"
        alt="House of Rose treatment suite prepared for injectables"
        loading="lazy"
        class="w-full h-full object-cover"
        width="1400"
        height="933"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-charcoal/30 to-transparent"></div>
    </div>
  </section>

  <!-- The Philosophy -->
  <section
    class="relative py-[clamp(72px,10vw,148px)] px-6 bg-cover bg-center"
    style="background-image: url('/images/bg-hydration.jpg');"
  >
    <div class="absolute inset-0 bg-black/70"></div>
    <div class="relative z-10 max-w-[640px] mx-auto text-center">
      <span class="kicker">The Philosophy</span>
      <blockquote class="font-serif text-[clamp(18px,3vw,28px)] text-white leading-[1.6] italic font-normal mt-7">
        Beauty is not an outcome. It is the expression of a body in optimal health.
      </blockquote>
      <div class="w-11 h-px bg-gold mx-auto mt-7"></div>
    </div>
  </section>

  <!-- Services Grid -->
  {services.length > 0 && (
    <section class="bg-charcoal py-[clamp(44px,6vw,88px)] px-6">
      <div class="max-w-[1280px] mx-auto">
        <!-- Section Header -->
        <div class="flex justify-between items-end flex-wrap gap-3 mb-12">
          <div>
            <span class="kicker">What We Offer</span>
            <h2 class="font-serif text-[clamp(24px,4vw,36px)] text-white mt-1.5">
              Our Services
            </h2>
          </div>
          <a href="/services" class="text-[11px] tracking-[0.2em] uppercase border-b border-gold text-gold pb-0.5 min-h-[44px] inline-flex items-end hover:opacity-75 transition-opacity">
            View All
          </a>
        </div>

        <!-- Service Cards Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-gold/10">
          {services.slice(0, 6).map((service) => (
            <div class="bg-charcoal">
              <ServiceCard
                title={service.title}
                slug={service.slug}
                tagline={service.tagline}
                image={service.image}
                variant="grid"
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Split Section: Experience -->
  <section class="bg-charcoal-light grid grid-cols-1 md:grid-cols-2">
    <div class="relative min-h-[330px] bg-charcoal order-2 md:order-1">
      <img
        src="/images/bg-hero.jpg"
        alt="House of Rose luxury treatment room"
        loading="lazy"
        class="w-full h-full object-cover"
        width="800"
        height="600"
      />
    </div>
    <div class="p-[clamp(38px,6vw,76px)] order-1 md:order-2">
      <span class="kicker">What to Expect</span>
      <h2 class="font-serif text-[clamp(22px,3vw,33px)] text-white leading-tight mb-5">
        Built for those who expect more.
      </h2>
      <p class="text-[#777] text-[15px] leading-relaxed mb-3">
        Every treatment is an invitation to slow down, restore, and reconnect with yourself.
      </p>
      <p class="text-[#777] text-[15px] leading-relaxed">
        Discover what sets House of Rose apart.
      </p>
      <a href="/experience" class="btn-outline-gold mt-6 inline-flex">
        Our Experience
      </a>
    </div>
  </section>

  <!-- Contact CTA -->
  <section id="book" class="bg-charcoal-light py-[clamp(56px,8vw,88px)] px-6 border-t border-gold/10">
    <div class="max-w-[680px] mx-auto text-center">
      <span class="kicker">Reserve Your Experience</span>
      <h2 class="font-serif text-[clamp(28px,5vw,44px)] text-white leading-tight mb-4">
        Begin Your Transformation
      </h2>
      <p class="text-[#777] text-[15px] max-w-[450px] mx-auto mb-10 leading-relaxed">
        Every treatment begins with a private consultation. Reach out to schedule yours.
      </p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="tel:+18449417673" class="btn-outline-gold">
          (844) 941-7673
        </a>
        <a href="https://houseofrose.glossgenius.com/services" target="_blank" rel="noopener noreferrer" class="btn-gold">
          Book Online
        </a>
      </div>
      <p class="text-[#444] text-[10px] tracking-[0.26em] uppercase mt-8 leading-relaxed">
        525 E Olympia Ave, Unit 9<br />Punta Gorda, FL 33982
      </p>
    </div>
  </section>
</BaseLayout>
