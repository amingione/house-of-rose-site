---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import { sanityFetch, urlFor } from '@/lib/sanity';
import { ALL_SERVICES_QUERY, FEATURED_TESTIMONIALS_QUERY, type Service, type Testimonial } from '@/lib/queries';

const services = await sanityFetch<Service[]>(ALL_SERVICES_QUERY);
const testimonials = await sanityFetch<Testimonial[]>(FEATURED_TESTIMONIALS_QUERY);
const featuredTestimonial = testimonials?.[0];
---

<BaseLayout>
  <!-- Hero -->
  <Hero
    title="House of Rose"
    kicker="Luxury Spa & Wellness"
    description="A sanctuary for the senses. Elevate your well-being through ritual, touch, and intention."
    size="full"
    showCTA={true}
    ctaPrimary={{ text: 'Book a Service', href: '#book' }}
    ctaSecondary={{ text: 'Explore Services', href: '/services' }}
    backgroundClass="bg-charcoal"
  />

  <!-- Split Section: Feature Highlight -->
  <section class="bg-charcoal grid grid-cols-1 md:grid-cols-2">
    <div class="p-[clamp(38px,6vw,76px)]">
      <span class="kicker">Physician-Informed Care</span>
      <h2 class="font-serif text-[clamp(22px,3vw,33px)] text-white leading-tight mb-5">
        Beyond the treatment room.
      </h2>
      <p class="text-[#777] text-[15px] leading-relaxed mb-3">
        From the moment you book to the moment you leave, every detail has been considered.
      </p>
      <p class="text-[#777] text-[15px] leading-relaxed">
        House of Rose delivers clinical precision wrapped in genuine hospitality.
      </p>
      <a href="/experience" class="btn-outline-gold mt-6 inline-flex">
        Our Experience
      </a>
    </div>
    <div class="relative min-h-[330px] bg-charcoal-lighter"></div>
  </section>

  <!-- Quote/Testimonial Section -->
  {featuredTestimonial && (
    <section
      class="relative py-[clamp(72px,10vw,148px)] px-6"
      style={featuredTestimonial.backgroundImage ? `background-image: url(${urlFor(featuredTestimonial.backgroundImage).width(1920).height(1080).url()}); background-size: cover; background-position: center;` : ''}
    >
      <div class="absolute inset-0 bg-black/75"></div>
      <div class="relative z-10 max-w-[640px] mx-auto text-center">
        <blockquote class="font-serif text-[clamp(18px,3vw,28px)] text-white leading-relaxed italic font-normal">
          "{featuredTestimonial.quote}"
        </blockquote>
        {(featuredTestimonial.author || featuredTestimonial.role) && (
          <div class="mt-6 text-white/70 text-sm">
            {featuredTestimonial.author && <p>{featuredTestimonial.author}</p>}
            {featuredTestimonial.role && <p class="text-xs uppercase tracking-widest">{featuredTestimonial.role}</p>}
          </div>
        )}
        <div class="w-11 h-px bg-gold mx-auto mt-7"></div>
      </div>
    </section>
  )}

  <!-- Services Grid -->
  {services.length > 0 && (
    <section class="bg-charcoal py-[clamp(44px,6vw,88px)] px-6">
      <div class="max-w-[1280px] mx-auto">
        <!-- Section Header -->
        <div class="flex justify-between items-end flex-wrap gap-3 mb-12">
          <div>
            <span class="kicker">What We Offer</span>
            <h2 class="font-serif text-[clamp(24px,4vw,36px)] text-white mt-1.5">
              Our Services
            </h2>
          </div>
          <a href="/services" class="text-[11px] tracking-[0.2em] uppercase border-b border-gold text-gold pb-0.5 min-h-[44px] inline-flex items-end hover:opacity-75 transition-opacity">
            View All
          </a>
        </div>

        <!-- Service Cards Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-gold/10">
          {services.slice(0, 6).map((service) => (
            <div class="bg-charcoal">
              <ServiceCard
                title={service.title}
                slug={service.slug}
                tagline={service.tagline}
                image={service.image}
                variant="grid"
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Split Section: Experience -->
  <section class="bg-charcoal-light grid grid-cols-1 md:grid-cols-2">
    <div class="relative min-h-[330px] bg-charcoal order-2 md:order-1"></div>
    <div class="p-[clamp(38px,6vw,76px)] order-1 md:order-2">
      <span class="kicker">What to Expect</span>
      <h2 class="font-serif text-[clamp(22px,3vw,33px)] text-white leading-tight mb-5">
        Built for those who expect more.
      </h2>
      <p class="text-[#777] text-[15px] leading-relaxed mb-3">
        Every treatment is an invitation to slow down, restore, and reconnect with yourself.
      </p>
      <p class="text-[#777] text-[15px] leading-relaxed">
        Discover what sets House of Rose apart.
      </p>
      <a href="/experience" class="btn-outline-gold mt-6 inline-flex">
        Our Experience
      </a>
    </div>
  </section>

  <!-- Contact CTA -->
  <section id="book" class="bg-charcoal-light py-[clamp(56px,8vw,88px)] px-6 border-t border-gold/10">
    <div class="max-w-[680px] mx-auto text-center">
      <span class="kicker">Reserve Your Experience</span>
      <h2 class="font-serif text-[clamp(28px,5vw,44px)] text-white leading-tight mb-4">
        Begin Your Transformation
      </h2>
      <p class="text-[#777] text-[15px] max-w-[450px] mx-auto mb-10 leading-relaxed">
        Every treatment begins with a private consultation. Reach out to schedule yours.
      </p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="tel:+18449417673" class="btn-outline-gold">
          (844) 941-7673
        </a>
        <a href={`mailto:${import.meta.env.PUBLIC_BOOKING_EMAIL ?? 'book@houseofrosefl.com'}`} class="btn-gold">
          Email Us
        </a>
      </div>
      <p class="text-[#444] text-[10px] tracking-[0.26em] uppercase mt-8 leading-relaxed">
        525 E Olympia Ave, Unit 9<br />Punta Gorda, FL 33982
      </p>
    </div>
  </section>
</BaseLayout>
