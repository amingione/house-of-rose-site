---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/Hero.astro";

// Booking + internal links (single source of truth so they're easy to swap)
const BOOKING_URL = "https://houseofrose.glossgenius.com/services";
const SKIN_ANALYSIS_URL = "/skin-analysis";
const MEMBERSHIPS_URL = "/memberships";
const SHOP_URL = "/shop";

// Homepage service groups (curated 4-pillar model — not a treatment dump)
const serviceGroups = [
	{
		name: "Regenerative Skin Treatments",
		description:
			"ProCell microchanneling, PRF microneedling for face and body, BioRePeel, and advanced renewal treatments for texture, tone, collagen, scars, and stretch marks.",
		image: "/images/new-microchanneling.webp",
	},
	{
		name: "Injectables & Structural Enhancements",
		description:
			"Botox, dermal fillers, PRF under-eye rejuvenation, EZ Gel bio-filler, and PRF hair restoration — chosen with a careful, balanced approach.",
		image: "/images/new-injectables.webp",
	},
	{
		name: "Skin Health & Corrective Care",
		description:
			"Face Reality acne care, Glo2Facials, dermaplaning, LED therapy, and personalized skin guidance rooted in what your skin is showing today—not assumptions.",
		image: "/images/new-facials.png",
	},
	{
		name: "Wellness & Performance Support",
		description:
			"IV hydration, GLP-1 weight management, permanent jewelry, memberships, and select offerings that complement your aesthetic goals and overall care experience.",
		image: "/images/new-wellness.webp",
	},
];

// ─── Structured data ──────────────────────────────────────────────────────────
const websiteData = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: "House of Rose Aesthetics",
	alternateName: "House of Rose",
	url: Astro.site?.toString(),
	potentialAction: {
		"@type": "SearchAction",
		target: {
			"@type": "EntryPoint",
			urlTemplate: `${Astro.site}services?q={search_term_string}`,
		},
		"query-input": "required name=search_term_string",
	},
};

const organizationData = {
	"@context": "https://schema.org",
	"@type": "HealthAndBeautyBusiness",
	name: "House of Rose Aesthetics",
	alternateName: "House of Rose",
	description:
		"House of Rose Aesthetics in Punta Gorda, FL — advanced aesthetics and wellness. Regenerative treatments, injectables, facials, skin analysis, IV hydration, and curated skincare.",
	url: Astro.site?.toString(),
	telephone: "+18449417673",
	email: import.meta.env.PUBLIC_BOOKING_EMAIL,
	address: {
		"@type": "PostalAddress",
		streetAddress: "525 E Olympia Ave, Unit 9",
		addressLocality: "Punta Gorda",
		addressRegion: "FL",
		postalCode: "33950",
		addressCountry: "US",
	},
	geo: {
		"@type": "GeoCoordinates",
		latitude: "26.9298",
		longitude: "-82.0454",
	},
	openingHoursSpecification: {
		"@type": "OpeningHoursSpecification",
		dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
		opens: "9:00",
		closes: "17:00",
	},
	priceRange: "$$",
	areaServed: {
		"@type": "GeoCircle",
		geoMidpoint: {
			"@type": "GeoCoordinates",
			latitude: "26.9298",
			longitude: "-82.0454",
		},
		geoRadius: "50000",
	},
	sameAs: [
		"https://www.instagram.com/houseofrosefl",
		"https://www.facebook.com/houseofrosefl",
		"https://houseofrose.glossgenius.com/services",
	],
	hasMap: "https://maps.google.com/?q=525+E+Olympia+Ave+Unit+9+Punta+Gorda+FL+33950",
	currenciesAccepted: "USD",
	paymentAccepted: "Cash, Credit Card",
	slogan: "Where Beauty Blooms Within",
};
---

<BaseLayout
	title="House of Rose Aesthetics | Advanced Aesthetics & Wellness in Punta Gorda, FL"
	description="Personalized aesthetics, skin health, regenerative treatments, injectables, facials, wellness support, and curated skincare in Punta Gorda, Florida."
	preloadImage="/images/banner/HOR-where-beauty-blooms-within.webp"
>
	<script
		is:inline
		type="application/ld+json"
		set:html={JSON.stringify(websiteData)}
		slot="head"
	/>
	<script
		is:inline
		type="application/ld+json"
		set:html={JSON.stringify(organizationData)}
		slot="head"
	/>

	<!-- ── SECTION 1 · HERO ─────────────────────────────────────────── -->
	<Hero
		title="HOUSE OF ROSE\nAESTHETICS"
		subtitle="PUNTA GORDA, FL"
		kicker="Refined Aesthetics. Natural Results"
		description="Precision-driven treatments, regenerative techniques, and personalized care designed to enhance your natural features—not change them. Every treatment plan is intentional, every result is meant to look effortless, and every detail is built around long-term skin health."
		size="full"
		centerContent={true}
		showCTA={true}
		ctaPrimary={{ text: "Book Your Consultation", href: BOOKING_URL }}
		ctaSecondary={{ text: "Explore Treatments", href: "/services" }}
		backgroundImage="/images/banner/HOR-where-beauty-blooms-within.webp"
	/>

	<!-- ── SECTION 2 · INTRO / BRAND POSITIONING ───────────────────── -->
	<section class="bg-charcoal grid grid-cols-1 md:grid-cols-2">
		<div class="p-[clamp(38px,6vw,76px)] flex flex-col justify-center">
			<span class="kicker">About House of Rose</span>
			<h2
				class="font-serif text-[clamp(24px,3.4vw,38px)] text-ink leading-tight mt-2 mb-6"
			>
				A more considered approach to aesthetics.
			</h2>
			<p
				class="text-[#9a8c78] text-[15px] leading-[1.75] max-w-[560px] mb-4"
			>
				House of Rose Aesthetics was created for clients who expect
				more than a standard appointment or transactional treatment
				menu.
			</p>
			<p
				class="text-[#9a8c78] text-[15px] leading-[1.75] max-w-[560px] mb-4"
			>
				Our approach is intentional, results-focused, and built around
				long-term skin health. Every recommendation is made with
				precision—balancing advanced aesthetic treatments, regenerative
				techniques, and personalized care to deliver outcomes that feel
				refined, natural, and aligned with you.
			</p>
			<p class="text-[#9a8c78] text-[15px] leading-[1.75] max-w-[560px]">
				Rather than focusing on isolated services, we design cohesive
				treatment plans that evolve with your skin, your goals, and the
				results you want to maintain over time.
			</p>
		</div>
		<div class="relative min-h-[340px] bg-charcoal-lighter">
			<img
				src="/images/house-of-rose-lounge.webp"
				alt="The House of Rose Aesthetics lounge in Punta Gorda, Florida"
				loading="lazy"
				class="w-full h-full object-cover"
				width="1400"
				height="933"
			/>
		</div>
	</section>

	<!-- ── SECTION 3 · SIGNATURE APPROACH (full-bleed) ─────────────── -->
	<section
		class="relative py-[clamp(72px,11vw,150px)] px-6 bg-cover bg-center"
		style="background-image: url('/images/bg-skin.webp');"
	>
		<div class="absolute inset-0 bg-black/72"></div>
		<div class="relative z-10 max-w-[760px] mx-auto text-center">
			<span class="kicker">Our Approach</span>
			<h2
				class="font-serif text-[clamp(24px,3.6vw,40px)] text-ivory leading-tight mt-2 mb-7"
			>
				Where regenerative aesthetics meets precision care.
			</h2>
			<p
				class="text-ivory/75 text-[15px] leading-[1.8] max-w-[640px] mx-auto mb-4"
			>
				Our approach is centered on supporting the skin
				intelligently—from regeneration and correction to maintenance
				and long-term results.
			</p>
			<p
				class="text-ivory/75 text-[15px] leading-[1.8] max-w-[640px] mx-auto mb-7"
			>
				Signature treatments such as PRF are part of a broader
				philosophy: enhancing skin function, restoring balance, and
				creating visible improvements without overcorrection. Every
				treatment is selected with purpose, layered strategically, and
				tailored to how your skin responds over time.
			</p>
			<p
				class="font-serif text-ivory text-[clamp(17px,2vw,22px)] leading-[1.5] max-w-[560px] mx-auto"
			>
				This is not trend-driven aesthetics. This is structured,
				outcome-focused care designed to deliver results that feel
				effortless—and last.
			</p>
		</div>
	</section>

	<!-- ── SECTION 4 · SERVICES OVERVIEW ───────────────────────────── -->
	<section class="bg-charcoal py-[clamp(48px,7vw,96px)] px-6">
		<div class="max-w-[1280px] mx-auto">
			<div class="max-w-[640px] mb-12">
				<span class="kicker">Services</span>
				<h2
					class="font-serif text-[clamp(24px,4vw,40px)] text-ink mt-2 mb-5"
				>
					A curated menu of advanced treatments.
				</h2>
				<p class="text-[#9a8c78] text-[15px] leading-[1.75]">
					A curated selection of treatments designed to work
					together—not in isolation. Each service at House of Rose is
					carefully chosen to support real outcomes: improved skin
					quality, balanced features, and long-term maintenance through
					personalized treatment planning.
				</p>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-gold/10">
				{
					serviceGroups.map((group) => (
						<a href="/services" class="group block bg-charcoal">
							<div class="aspect-[16/10] overflow-hidden bg-charcoal-lighter">
								<img
									src={group.image}
									alt={group.name}
									loading="lazy"
									class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
									width="700"
									height="438"
								/>
							</div>
							<div class="p-7">
								<h3 class="font-serif text-[21px] text-ink mb-2.5">
									{group.name}
								</h3>
								<p class="text-[#777] text-[14px] leading-[1.7]">
									{group.description}
								</p>
							</div>
						</a>
					))
				}
			</div>

			<div class="mt-12">
				<a
					href="/services"
					class="text-[11px] tracking-[0.2em] uppercase border-b border-gold text-gold pb-0.5 min-h-[44px] inline-flex items-end hover:opacity-75 transition-opacity"
				>
					View All Services
				</a>
			</div>
		</div>
	</section>

	<!-- ── SECTION 5 · AI SKIN SCANNER FEATURE ─────────────────────── -->
	<section class="bg-charcoal-light grid grid-cols-1 md:grid-cols-2">
		<div class="relative min-h-[340px] bg-charcoal order-2 md:order-1">
			<img
				src="/images/new-consultation.png"
				alt="In-office skin analysis at House of Rose Aesthetics"
				loading="lazy"
				class="w-full h-full object-cover"
				width="1200"
				height="900"
			/>
		</div>
		<div
			class="p-[clamp(38px,6vw,76px)] flex flex-col justify-center order-1 md:order-2"
		>
			<span class="kicker">Skin Analysis</span>
			<h2
				class="font-serif text-[clamp(24px,3.4vw,38px)] text-ink leading-tight mt-2 mb-6"
			>
				See your skin with more clarity.
			</h2>
			<p
				class="text-[#9a8c78] text-[15px] leading-[1.75] max-w-[560px] mb-4"
			>
				Our advanced skin analysis technology allows us to look beyond
				surface-level concerns and evaluate your skin with greater
				precision.
			</p>
			<p
				class="text-[#9a8c78] text-[15px] leading-[1.75] max-w-[560px] mb-4"
			>
				By analyzing key markers of skin health, we're able to create a
				treatment plan that is guided by real data—not assumptions—
				resulting in more targeted treatments, more efficient progress,
				and better long-term outcomes.
			</p>
			<p
				class="text-ink/90 text-[15px] italic leading-[1.75] max-w-[560px] mb-7"
			>
				It's where every truly personalized plan begins.
			</p>
			<div>
				<a href={SKIN_ANALYSIS_URL} class="btn-outline-gold inline-flex"
					>Learn About Skin Analysis</a
				>
			</div>
		</div>
	</section>

	<!-- ── SECTION 6 · MEMBERSHIPS / TREATMENT PLANS ───────────────── -->
	<section class="bg-charcoal grid grid-cols-1 md:grid-cols-2">
		<div class="p-[clamp(38px,6vw,76px)] flex flex-col justify-center">
			<span class="kicker">Memberships & Ongoing Care</span>
			<h2
				class="font-serif text-[clamp(24px,3.4vw,38px)] text-ink leading-tight mt-2 mb-6"
			>
				Care that continues beyond a single appointment.
			</h2>
			<p
				class="text-[#9a8c78] text-[15px] leading-[1.75] max-w-[560px] mb-4"
			>
				Results are built over time—and maintained with intention. Our
				membership options are designed for clients who want consistent
				care, structured treatment plans, and ongoing access to
				professional guidance.
			</p>
			<p
				class="text-[#9a8c78] text-[15px] leading-[1.75] max-w-[560px] mb-7"
			>
				Rather than booking sporadically, members benefit from a more
				connected approach that supports long-term results and
				simplifies decision-making. With preferred access, curated
				treatment pathways, and ongoing support, memberships are the
				most effective way to stay aligned with your skin goals
				year-round.
			</p>
			<div>
				<a href={MEMBERSHIPS_URL} class="btn-outline-gold inline-flex"
					>Explore Memberships</a
				>
			</div>
		</div>
		<div class="relative min-h-[340px] bg-charcoal-lighter">
			<img
				src="/images/house-of-rose-collection.webp"
				alt="House of Rose Aesthetics membership and ongoing care"
				loading="lazy"
				class="w-full h-full object-cover"
				width="1400"
				height="933"
			/>
		</div>
	</section>

	<!-- ── SECTION 7 · PRODUCT / HOME CARE PREVIEW ─────────────────── -->
	<section class="bg-charcoal-light grid grid-cols-1 md:grid-cols-2">
		<div class="relative min-h-[340px] bg-charcoal order-2 md:order-1">
			<img
				src="/images/house-of-rose-products.webp"
				alt="Curated professional skincare at House of Rose Aesthetics"
				loading="lazy"
				class="w-full h-full object-cover"
				width="1400"
				height="933"
			/>
		</div>
		<div
			class="p-[clamp(38px,6vw,76px)] flex flex-col justify-center order-1 md:order-2"
		>
			<span class="kicker">Curated Home Care</span>
			<h2
				class="font-serif text-[clamp(24px,3.4vw,38px)] text-ink leading-tight mt-2 mb-6"
			>
				Professional skincare, selected with purpose.
			</h2>
			<p
				class="text-[#9a8c78] text-[15px] leading-[1.75] max-w-[560px] mb-4"
			>
				Every product we carry is selected to support treatment outcomes
				and simplify your routine at home. From post-treatment aftercare
				to acne support, mineral makeup, SPF, and corrective skincare,
				our selection is built to work with your plan, not compete with
				it.
			</p>
			<p
				class="text-[#9a8c78] text-[15px] leading-[1.75] max-w-[560px] mb-7"
			>
				Rather than overwhelming you with options, we provide curated
				recommendations tailored to your skin, your treatments, and your
				long-term goals—so everything you use works together with
				intention.
			</p>
			<div>
				<a href={SHOP_URL} class="btn-outline-gold inline-flex"
					>Shop Skincare</a
				>
			</div>
		</div>
	</section>

	<!-- ── SECTION 8 · THE EXPERIENCE (full-bleed) ─────────────────── -->
	<section
		class="relative py-[clamp(72px,11vw,150px)] px-6 bg-cover bg-center"
		style="background-image: url('/images/house-of-rose-treatment-room.webp');"
	>
		<div class="absolute inset-0 bg-black/74"></div>
		<div class="relative z-10 max-w-[720px] mx-auto text-center">
			<span class="kicker">The Experience</span>
			<h2
				class="font-serif text-[clamp(24px,3.6vw,40px)] text-ivory leading-tight mt-2 mb-7"
			>
				Calm, personal, and thoughtfully paced.
			</h2>
			<p
				class="text-ivory/75 text-[15px] leading-[1.8] max-w-[620px] mx-auto mb-4"
			>
				Appointments at House of Rose are designed to feel calm,
				focused, and entirely personalized. We take the time to
				understand your goals, evaluate your skin with precision, and
				recommend treatments that are aligned—not excessive, not rushed,
				and never driven by trends.
			</p>
			<p
				class="text-ivory/75 text-[15px] leading-[1.8] max-w-[620px] mx-auto"
			>
				You'll leave with clarity—what was done, why it matters, and
				exactly how to maintain your results.
			</p>
		</div>
	</section>

	<!-- ── SECTION 9 · LOCAL / TRUST / CONTACT ─────────────────────── -->
	<section class="bg-charcoal py-[clamp(56px,8vw,104px)] px-6">
		<div class="max-w-[760px] mx-auto text-center">
			<span class="kicker">Punta Gorda</span>
			<h2
				class="font-serif text-[clamp(26px,4vw,42px)] text-ink leading-tight mt-2 mb-7"
			>
				A refined destination for aesthetics and wellness.
			</h2>
			<p
				class="text-[#9a8c78] text-[15px] leading-[1.8] max-w-[600px] mx-auto mb-4"
			>
				House of Rose Aesthetics serves clients in Punta Gorda and
				across Southwest Florida who are looking for a more thoughtful
				way to approach skin, beauty, and self-care.
			</p>
			<p
				class="text-[#9a8c78] text-[15px] leading-[1.8] max-w-[600px] mx-auto mb-9"
			>
				If you already know what you're looking for, you can book
				online. If you'd rather begin with a conversation, we're here to
				help you find the right starting point.
			</p>
			<div class="flex gap-3 justify-center flex-wrap">
				<a
					href={BOOKING_URL}
					target="_blank"
					rel="noopener noreferrer"
					class="btn-gold">Book Online</a
				>
				<a href="/contact" class="btn-outline-gold">Contact Us</a>
			</div>
		</div>
	</section>

	<!-- ── SECTION 10 · FINAL CTA / FOOTER PREVIEW ─────────────────── -->
	<section
		class="relative py-[clamp(64px,9vw,120px)] px-6 bg-cover bg-center border-t border-gold/10"
		style="background-image: url('/images/background-rose.webp');"
	>
		<div class="absolute inset-0 bg-charcoal/88"></div>
		<div class="relative z-10 max-w-[640px] mx-auto text-center">
			<h2
				class="font-serif text-[clamp(28px,5vw,46px)] text-ink leading-tight mb-5"
			>
				Refined results begin with the right plan.
			</h2>
			<p
				class="text-[#999] text-[15px] max-w-[480px] mx-auto mb-9 leading-[1.8]"
			>
				Advanced treatments, expert guidance, and a setting designed to
				feel elevated, calm, and intentional—so every step of your
				experience feels considered.
			</p>
			<a
				href={BOOKING_URL}
				target="_blank"
				rel="noopener noreferrer"
				class="btn-gold"
			>
				Start Your Consultation
			</a>
			<p
				class="text-[#7a6e5c] text-[10px] tracking-[0.26em] uppercase mt-9 leading-relaxed"
			>
				525 E Olympia Ave, Unit 9 · Punta Gorda, FL 33950<br />
				Mon–Fri 10AM–6PM · (844) 941-7673
			</p>
		</div>
	</section>
</BaseLayout>
