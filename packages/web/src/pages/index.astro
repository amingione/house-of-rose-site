---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sanityFetch } from '@/lib/sanity';
import { sbObjectId, sbFieldPath } from '@/lib/visualEditing';
import { HOMEPAGE_QUERY, type HomePage } from '@/lib/queries';
import { alignPublicChannelCopy } from '@/lib/publicCopy';
import { GLOSSGENIUS_SERVICES_URL } from '@/lib/booking';
import { BUSINESS_URLS, LOCAL_BUSINESS } from '@/lib/structuredData';

const hp = (await sanityFetch<HomePage | null>(HOMEPAGE_QUERY)) ?? ({} as HomePage);
const oid = hp._id ? sbObjectId(hp._id) : {};
const safe = (value: string | undefined, fallback: string): string =>
  alignPublicChannelCopy(value?.trim() || fallback);

const phoneDisplay = '(844) 941-7673';
const phoneHref = `tel:${LOCAL_BUSINESS.telephone}`;
const heroTitle = safe(hp.heroTitle, 'Medical Aesthetics.\nThoughtfully Practiced.');

const practiceStandards = [
  {
    title: 'Selection',
    body: 'Indication, candidacy, and the desired degree of change determine what belongs on the table.',
  },
  {
    title: 'Sequencing',
    body: 'Corrective work, maintenance, home care, and recovery need an order that makes sense together.',
  },
  {
    title: 'Expectations',
    body: 'Preparation, limitations, temporary downtime, and aftercare are discussed before they become surprises.',
  },
  {
    title: 'Continuity',
    body: 'Documentation, reassessment, and maintenance keep the work accountable over time.',
  },
] as const;
---

<BaseLayout
  title={hp.seoTitle ?? 'House of Rose | Medical Aesthetics in Punta Gorda'}
  description={hp.seoDescription ?? 'Explore skin treatments, injectables, facials, body treatments, IV hydration, wellness services, and professional skincare at House of Rose in Punta Gorda.'}
  preloadImage="/images/optimized/actual-reception-1400.webp"
  preloadImageSrcset="/images/optimized/actual-reception-800.webp 800w, /images/optimized/actual-reception-1400.webp 1400w"
  preloadImageSizes="100vw"
>
  <div {...oid}>
    <section class="on-dark relative isolate overflow-hidden bg-soft-black pt-20">
      <div class="relative min-h-[720px] sm:min-h-[740px] lg:h-[calc(100svh-80px)] lg:min-h-[680px] lg:max-h-[800px]">
        <img
          src="/images/optimized/actual-reception-1400.webp"
          srcset="/images/optimized/actual-reception-800.webp 800w, /images/optimized/actual-reception-1400.webp 1400w"
          sizes="100vw"
          alt="The reception area inside House of Rose Aesthetics in Punta Gorda"
          width="1400"
          height="1050"
          fetchpriority="high"
          decoding="sync"
          class="absolute inset-0 h-full w-full object-cover object-[38%_center] lg:object-[52%_center]"
        />
        <div class="home-hero-scrim absolute inset-0" aria-hidden="true"></div>

        <div class="relative mx-auto flex h-full min-h-[720px] max-w-[1440px] items-end px-6 pb-10 pt-16 sm:min-h-[740px] sm:px-10 sm:pb-12 lg:min-h-[680px] lg:px-[clamp(48px,6.5vw,96px)] lg:pb-14">
          <div class="w-full">
            <div class="max-w-[980px]">
              <div class="flex items-center gap-4">
                <span class="h-px w-10 bg-gold-metal sm:w-14" aria-hidden="true"></span>
                <span class="kicker mb-0 text-ivory" {...sbFieldPath('heroKicker')}>
                  {safe(hp.heroKicker, 'House of Rose Aesthetics')}
                </span>
              </div>

              <h1 class="mt-5 max-w-[960px] font-serif text-[clamp(46px,7vw,88px)] leading-[0.94] tracking-[-0.025em] text-ivory">
                {heroTitle.split('\n').map((line) => (
                  <span class="block">{line}</span>
                ))}
              </h1>

              <p class="mt-6 max-w-[680px] text-[15px] leading-[1.65] text-muted-strong sm:mt-7 sm:text-[clamp(16px,1.5vw,19px)] sm:leading-[1.7]" {...sbFieldPath('heroDescription')}>
                {safe(hp.heroDescription, 'Skin health, injectables, facial and body treatments, IV hydration, and wellness care—considered in the context of candidacy, timing, recovery, and the degree of change you actually want.')}
              </p>

              <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                <a href={GLOSSGENIUS_SERVICES_URL} target="_blank" rel="noopener noreferrer" class="btn-gold sm:min-w-[218px]" data-global-booking data-cta-location="homepage-hero">
                  {safe(hp.heroCtaPrimaryText, 'Book an appointment')}
                </a>
                <a href="/services/" class="btn-outline-white sm:min-w-[190px]" data-cta-location="homepage-hero-services">
                  {safe(hp.heroCtaSecondaryText, 'View services')}
                </a>
              </div>
            </div>

            <div class="mt-8 grid max-w-[900px] grid-cols-2 border-y border-ivory/30 text-[12px] sm:mt-10 sm:grid-cols-[1.15fr_1fr_auto] sm:items-stretch">
              <div class="py-4 pr-3 sm:pr-6">
                <p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-gold">Practice</p>
                <p class="mt-1.5 font-semibold text-ivory">Medical Aesthetics Practice</p>
              </div>
              <div class="border-l border-ivory/20 py-4 pl-3 sm:px-6">
                <p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-gold">Location</p>
                <p class="mt-1.5 font-semibold text-ivory" {...sbFieldPath('heroSubtitle')}>
                  {safe(hp.heroSubtitle, 'Punta Gorda, Florida')}
                </p>
              </div>
              <a href={phoneHref} class="group col-span-2 flex items-center justify-between gap-8 border-t border-ivory/20 py-4 font-semibold text-ivory sm:col-span-1 sm:border-l sm:border-t-0 sm:pl-6" data-cta-location="homepage-hero-call">
                Call {phoneDisplay}
                <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="bg-breath px-6 py-[clamp(72px,9vw,120px)]">
      <div class="mx-auto max-w-[1240px]">
        <div class="grid gap-8 border-b border-walnut/15 pb-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
          <div>
            <span class="kicker" {...sbFieldPath('servicesKicker')}>{safe(hp.servicesKicker, 'A considered range')}</span>
            <h2 class="max-w-[650px] font-serif text-[clamp(36px,5vw,58px)] leading-[1.02] tracking-[-0.02em] text-ink" {...sbFieldPath('servicesHeading')}>
              {safe(hp.servicesHeading, 'Different treatments. One standard of judgment.')}
            </h2>
          </div>
          <p class="max-w-[600px] text-[17px] leading-[1.75] text-muted" {...sbFieldPath('servicesIntro')}>
            {safe(hp.servicesIntro, 'Corrective work, maintenance care, and wellness services can belong in the same practice without being treated as interchangeable. Each has its own indication, obligations, and place in a longer view.')}
          </p>
        </div>

        <div class="mt-8 grid border border-walnut/15 lg:grid-cols-3">
          <a href="/services/" class="group flex min-h-[310px] flex-col justify-between bg-olive p-7 text-ivory transition-colors hover:bg-green-deep sm:p-9" data-cta-location="homepage-scope-services">
            <div>
              <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-ivory/75">Treatment menu</p>
              <h3 class="mt-5 max-w-[290px] font-serif text-[32px] leading-[1.08] text-ivory">See the full scope of the practice.</h3>
              <p class="mt-5 max-w-[320px] text-[15px] leading-[1.7] text-ivory/85">
                Review skin procedures, facials, injectables, body treatments, IV hydration, wellness care, and professional skincare.
              </p>
            </div>
            <span class="mt-8 inline-flex items-center gap-3 text-[13px] font-semibold">
              View all services <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
            </span>
          </a>

          <a href="/skin-analysis/" class="group flex min-h-[310px] flex-col justify-between border-t border-walnut/15 bg-bone p-7 transition-colors hover:bg-limestone/35 sm:p-9 lg:border-l lg:border-t-0">
            <div>
              <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-gold">Skin analysis</p>
              <h3 class="mt-5 max-w-[300px] font-serif text-[32px] leading-[1.08] text-ink" {...sbFieldPath('scanHeading')}>
                {safe(hp.scanHeading, 'A more detailed view of the skin.')}
              </h3>
              <p class="mt-5 max-w-[330px] text-[15px] leading-[1.7] text-muted" {...sbFieldPath('scanPara1')}>
                {safe(hp.scanPara1, 'Multi-spectrum imaging adds context around texture, hydration, pores, pigmentation, fine lines, and visible sun exposure before treatment is considered.')}
              </p>
            </div>
            <span class="mt-8 inline-flex items-center gap-3 text-[13px] font-semibold text-walnut">
              {safe(hp.scanCtaPrimaryText, 'Review skin analysis')} <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
            </span>
          </a>

          <a href="/consultation/" class="group flex min-h-[310px] flex-col justify-between border-t border-walnut/15 bg-bone p-7 transition-colors hover:bg-limestone/35 sm:p-9 lg:border-l lg:border-t-0" data-cta-location="homepage-scope-consultation">
            <div>
              <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-gold">Professional guidance</p>
              <h3 class="mt-5 max-w-[290px] font-serif text-[32px] leading-[1.08] text-ink">When the decision is not obvious.</h3>
              <p class="mt-5 max-w-[330px] text-[15px] leading-[1.7] text-muted">
                A consultation is useful when several approaches could apply, treatment order matters, or recovery time changes the decision.
              </p>
            </div>
            <span class="mt-8 inline-flex items-center gap-3 text-[13px] font-semibold text-walnut">
              Request guidance <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
            </span>
          </a>
        </div>
      </div>
    </section>

    <section class="bg-bone px-6 py-[clamp(72px,9vw,120px)]">
      <div class="mx-auto grid max-w-[1240px] items-center gap-12 lg:grid-cols-[1.08fr_0.92fr] lg:gap-20">
        <figure class="relative aspect-[4/3] overflow-hidden bg-limestone">
          <img
            src="/images/optimized/actual-welcome-1400.webp"
            srcset="/images/optimized/actual-welcome-800.webp 800w, /images/optimized/actual-welcome-1400.webp 1400w"
            sizes="(max-width: 1023px) 100vw, 52vw"
            alt="The welcome hallway inside House of Rose Aesthetics"
            width="1400"
            height="1050"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover"
          />
        </figure>

        <div>
          <span class="kicker" {...sbFieldPath('aboutKicker')}>{safe(hp.aboutKicker, 'House of Rose')}</span>
          <h2 class="font-serif text-[clamp(36px,5vw,56px)] leading-[1.03] tracking-[-0.02em] text-ink" {...sbFieldPath('aboutHeading')}>
            {safe(hp.aboutHeading, 'Independent by design. Accountable in practice.')}
          </h2>
          <div class="mt-7 max-w-[620px] space-y-5 text-[17px] leading-[1.75] text-muted">
            <p {...sbFieldPath('aboutPara1')}>
              {safe(hp.aboutPara1, 'House of Rose was designed for focused, personal care without the pace of a high-volume treatment floor. The rooms feel collected and residential; the work remains organized, documented, and clinically grounded.')}
            </p>
            <p {...sbFieldPath('aboutPara2')}>
              {safe(hp.aboutPara2, 'Recommendations come with a rationale. So do preparation, limitations, downtime, aftercare, and the point at which reassessment makes more sense than simply adding another procedure.')}
            </p>
          </div>

          <div class="mt-9 flex flex-wrap gap-x-7 gap-y-3 border-t border-walnut/15 pt-7 text-[13px] font-semibold">
            <a href="/experience/" class="text-walnut underline decoration-walnut/30 underline-offset-4 hover:text-olive">See the practice</a>
            <a href="/services/" class="text-walnut underline decoration-walnut/30 underline-offset-4 hover:text-olive">Review the work</a>
          </div>
        </div>
      </div>
    </section>

    <section class="on-dark bg-walnut px-6 py-[clamp(72px,9vw,120px)]">
      <div class="mx-auto max-w-[1240px]">
        <div class="grid gap-7 lg:grid-cols-[0.95fr_1.05fr] lg:items-end">
          <div>
            <span class="kicker" {...sbFieldPath('approachKicker')}>{safe(hp.approachKicker, 'What the standard requires')}</span>
            <h2 class="max-w-[660px] font-serif text-[clamp(38px,5vw,60px)] leading-[1.03] tracking-[-0.02em] text-ivory" {...sbFieldPath('approachHeading')}>
              {safe(hp.approachHeading, 'A recommendation should survive a harder question: why this, for you, now?')}
            </h2>
          </div>
          <p class="max-w-[590px] text-[17px] leading-[1.75] text-muted" {...sbFieldPath('approachPara1')}>
            {safe(hp.approachPara1, 'The answer may involve treatment history, candidacy, timing, tolerance for downtime, and the desired degree of change. A device name alone is not an answer.')}
          </p>
        </div>

        <ol class="mt-14 grid border-y border-ivory/20 md:grid-cols-4">
          {practiceStandards.map((step, index) => (
            <li class="relative min-h-[250px] border-b border-ivory/20 px-6 py-8 last:border-b-0 md:border-b-0 md:border-r md:last:border-r-0 lg:px-7">
              <p class="text-[11px] font-semibold tracking-[0.12em] text-gold">{String(index + 1).padStart(2, '0')}</p>
              <h3 class="mt-5 font-serif text-[27px] leading-tight text-ivory">{step.title}</h3>
              <p class="mt-4 max-w-[250px] text-[14px] leading-[1.7] text-muted">{step.body}</p>
            </li>
          ))}
        </ol>

        <p class="mt-10 max-w-[760px] font-serif text-[22px] leading-[1.55] text-ivory" {...sbFieldPath('approachClosing')}>
          {safe(hp.approachClosing, 'More treatment is not the standard. Better judgment is.')}
        </p>
      </div>
    </section>

    <section class="bg-breath px-6 py-[clamp(72px,9vw,120px)]">
      <div class="mx-auto max-w-[1240px]">
        <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
          <div>
            <span class="kicker" {...sbFieldPath('expKicker')}>{safe(hp.expKicker, 'Inside House of Rose')}</span>
            <h2 class="max-w-[690px] font-serif text-[clamp(36px,5vw,56px)] leading-[1.03] tracking-[-0.02em] text-ink" {...sbFieldPath('expHeading')}>
              {safe(hp.expHeading, 'The rooms are considered. The care has to be more than that.')}
            </h2>
          </div>
          <div class="max-w-[590px] space-y-4 text-[16px] leading-[1.75] text-muted">
            <p {...sbFieldPath('expPara1')}>
              {safe(hp.expPara1, 'A beautiful environment can make an appointment more comfortable; it cannot substitute for sound decisions, precise communication, or responsible follow-through.')}
            </p>
            <p {...sbFieldPath('expPara2')}>
              {safe(hp.expPara2, 'These are the actual House of Rose spaces—photographed as they are, because the practice should be recognizable before you walk through the door.')}
            </p>
          </div>
        </div>

        <div class="mt-12 grid gap-5 lg:grid-cols-[0.82fr_1.18fr]">
          <figure>
            <div class="relative aspect-[5/6] overflow-hidden bg-limestone">
              <img
                src="/images/optimized/actual-storefront-1000.webp"
                srcset="/images/optimized/actual-storefront-700.webp 700w, /images/optimized/actual-storefront-1000.webp 1000w"
                sizes="(max-width: 1023px) 100vw, 42vw"
                alt="The House of Rose Aesthetics storefront at 525 E Olympia Avenue in Punta Gorda"
                width="1000"
                height="1333"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover"
              />
            </div>
            <figcaption class="mt-4 flex items-baseline justify-between gap-4 border-t border-walnut/15 pt-3 text-[13px] text-muted">
              <span>The House of Rose storefront</span>
              <span class="font-semibold text-walnut">Unit 9</span>
            </figcaption>
          </figure>

          <figure class="lg:pt-20">
            <div class="relative aspect-[5/4] overflow-hidden bg-limestone">
              <img
                src="/images/optimized/actual-iv-suite-1400.webp"
                srcset="/images/optimized/actual-iv-suite-800.webp 800w, /images/optimized/actual-iv-suite-1400.webp 1400w"
                sizes="(max-width: 1023px) 100vw, 58vw"
                alt="The IV hydration suite inside House of Rose Aesthetics"
                width="1400"
                height="1120"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover"
              />
            </div>
            <figcaption class="mt-4 flex items-baseline justify-between gap-4 border-t border-walnut/15 pt-3 text-[13px] text-muted">
              <span>A treatment suite inside the practice</span>
              <a href="/experience/" class="font-semibold text-walnut underline decoration-walnut/30 underline-offset-4 hover:text-olive">Explore the experience</a>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="on-dark bg-walnut px-6 py-[clamp(72px,9vw,112px)]">
      <div class="mx-auto grid max-w-[1240px] gap-12 lg:grid-cols-[1.08fr_0.92fr] lg:items-center lg:gap-20">
        <div>
          <span class="kicker">Appointments &amp; inquiries</span>
          <h2 class="max-w-[700px] font-serif text-[clamp(40px,6vw,64px)] leading-[1.02] tracking-[-0.02em] text-ivory" {...sbFieldPath('finalHeading')}>
            {safe(hp.finalHeading, 'Book directly—or bring us the decision you are still working through.')}
          </h2>
          <p class="mt-6 max-w-[650px] text-[17px] leading-[1.75] text-muted" {...sbFieldPath('finalPara')}>
            {safe(hp.finalPara, 'Reserve a known service through the booking menu. If the choice depends on candidacy, timing, or competing priorities, send an inquiry or call us.')}
          </p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={GLOSSGENIUS_SERVICES_URL} target="_blank" rel="noopener noreferrer" class="btn-gold sm:min-w-[210px]" data-global-booking data-cta-location="homepage-final" {...sbFieldPath('finalCtaText')}>
              {safe(hp.finalCtaText, 'Book a service')}
            </a>
            <a href="/consultation/" class="btn-outline-white sm:min-w-[190px]" data-cta-location="homepage-final-inquiry">Send an inquiry</a>
          </div>
          <a href={phoneHref} class="mt-6 inline-flex items-center gap-3 text-[13px] font-semibold text-ivory underline decoration-ivory/35 underline-offset-4 hover:text-gold" data-cta-location="homepage-final-call">
            Call {phoneDisplay} <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="border border-ivory/25 p-7 sm:p-9">
          <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-gold" {...sbFieldPath('localKicker')}>
            {safe(hp.localKicker, 'Visit')}
          </p>
          <h3 class="mt-4 font-serif text-[32px] leading-tight text-ivory" {...sbFieldPath('localHeading')}>
            {safe(hp.localHeading, 'A focused practice in Southwest Florida.')}
          </h3>
          <p class="mt-5 text-[15px] leading-[1.7] text-muted" {...sbFieldPath('localPara1')}>
            {safe(hp.localPara1, 'Open Monday through Friday, 9 AM–5 PM. Walk-ins are welcome when the schedule allows; an appointment reserves your time.')}
          </p>
          <address class="mt-7 border-t border-ivory/20 pt-6 not-italic text-[14px] leading-[1.8] text-muted-strong">
            {LOCAL_BUSINESS.streetAddress}<br />
            {LOCAL_BUSINESS.addressLocality}, {LOCAL_BUSINESS.addressRegion} {LOCAL_BUSINESS.postalCode}
          </address>
          <div class="mt-6 flex flex-wrap gap-x-6 gap-y-3 text-[13px] font-semibold">
            <a href={BUSINESS_URLS.map} target="_blank" rel="noopener noreferrer" class="text-ivory underline decoration-ivory/35 underline-offset-4 hover:text-gold">Get directions</a>
            <a href="/contact/" class="text-ivory underline decoration-ivory/35 underline-offset-4 hover:text-gold">Contact the practice</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home-hero-scrim {
    background:
      linear-gradient(180deg, rgba(23, 22, 20, 0.28) 0%, rgba(23, 22, 20, 0.52) 42%, rgba(23, 22, 20, 0.92) 100%),
      linear-gradient(90deg, rgba(23, 22, 20, 0.7) 0%, rgba(23, 22, 20, 0.3) 100%);
  }

  @media (min-width: 1024px) {
    .home-hero-scrim {
      background:
        linear-gradient(180deg, rgba(23, 22, 20, 0.12) 45%, rgba(23, 22, 20, 0.62) 100%),
        linear-gradient(90deg, rgba(23, 22, 20, 0.96) 0%, rgba(23, 22, 20, 0.82) 35%, rgba(23, 22, 20, 0.34) 66%, rgba(23, 22, 20, 0.08) 100%);
    }
  }
</style>
