---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import { sanityFetch } from '@/lib/sanity';
import { sbObjectId, sbFieldPath, sbFieldPathParts } from '@/lib/visualEditing';
import {
  ALL_SERVICES_QUERY,
  HOMEPAGE_QUERY,
  type HomePage,
  type Service,
} from '@/lib/queries';
import { alignPublicChannelCopy } from '@/lib/publicCopy';

const hp = (await sanityFetch<HomePage | null>(HOMEPAGE_QUERY)) ?? ({} as HomePage);
const allServices = await sanityFetch<Service[]>(ALL_SERVICES_QUERY);
const oid = hp._id ? sbObjectId(hp._id) : {};
const safe = (value: string | undefined, fallback: string): string =>
  alignPublicChannelCopy(value?.trim() || fallback);

const FALLBACK_SERVICE_GROUPS = [
  {
    name: 'Skin Renewal & Device Treatments',
    description:
      'Explore microneedling, PRF, BioRePeel, radiofrequency, and IPL options by concern and recovery preference.',
    imagePath: '/images/editorial/home/regenerative-skin-treatments.webp',
  },
  {
    name: 'Injectables & Structural Enhancements',
    description:
      'Learn about neurotoxins, dermal fillers, PRF under-eye options, and EZ Gel through a consultation-led approach.',
    imagePath: '/images/editorial/home/injectables-consultation.webp',
  },
  {
    name: 'Skin Health & Corrective Care',
    description:
      'Start with Face Reality acne care, Glo2Facial, dermaplaning, and guidance based on what your skin is showing today.',
    imagePath: '/images/editorial/home/skin-health-analysis.webp',
  },
  {
    name: 'Wellness & Performance Support',
    description:
      'Review IV hydration and provider-guided weight-management services that may support a broader care plan.',
    imagePath: '/images/editorial/home/wellness-iv-hydration.webp',
  },
];

const serviceGroups = FALLBACK_SERVICE_GROUPS.map((fallback, index) => ({
  ...fallback,
  ...(hp.serviceGroups?.[index] ?? {}),
  imagePath: fallback.imagePath,
  name: safe(hp.serviceGroups?.[index]?.name, fallback.name),
  description: safe(hp.serviceGroups?.[index]?.description, fallback.description),
}));

const GROUP_ANCHORS: Record<string, string> = {
  'advanced skin treatments': '/services/#advanced-skin-treatments',
  'skin renewal & device treatments': '/services/#advanced-skin-treatments',
  'regenerative skin treatments': '/services/#advanced-skin-treatments',
  'injectables & structural enhancements': '/services/#injectables-structural-enhancements',
  'skin health & corrective care': '/services/#skin-health-corrective-care',
  'wellness & performance support': '/services/#wellness-performance-support',
};
const groupHref = (name: string): string =>
  GROUP_ANCHORS[name.trim().toLowerCase()] ?? '/services/';

const featuredOrder = [
  'glo2facial',
  'dermaplaning',
  'morpheus8',
  'lumecca-peak-ipl',
  'injectables',
  'face-reality-acne-program',
];
const servicesBySlug = new Map(allServices.map((service) => [service.slug, service]));
const featuredServices = featuredOrder
  .map((slug) => servicesBySlug.get(slug))
  .filter((service): service is Service => Boolean(service));

const careSteps = [
  {
    title: 'Consultation',
    body: 'Begin with your goals, timing, health history, and questions.',
  },
  {
    title: 'Assessment',
    body: 'Review candidacy, the treatment area, and what the service can reasonably address.',
  },
  {
    title: 'Treatment',
    body: 'Proceed with a plan selected for the service, area, and provider scope.',
  },
  {
    title: 'Aftercare',
    body: 'Leave with preparation, recovery, follow-up, and maintenance guidance.',
  },
];
---

<BaseLayout
  title={hp.seoTitle ?? 'House of Rose Aesthetics | Medical Aesthetics Punta Gorda'}
  description={hp.seoDescription ?? 'House of Rose Aesthetics is a Punta Gorda medical aesthetics practice offering individualized skin, injectable, facial, IV hydration, and wellness care.'}
  preloadImage="/images/optimized/hor-skin-studio-800.webp"
  preloadImageSrcset="/images/optimized/hor-skin-studio-800.webp 800w, /images/optimized/hor-skin-studio-1400.webp 1400w"
  preloadImageSizes="(max-width: 1023px) 100vw, 55vw"
>
  <div {...oid}>
    <section class="bg-bone pt-20">
      <div class="mx-auto grid max-w-[1440px] lg:min-h-[720px] lg:grid-cols-[minmax(0,0.92fr)_minmax(520px,1.08fr)]">
        <div class="flex flex-col justify-center px-6 py-14 sm:px-10 lg:px-[clamp(48px,7vw,104px)] lg:py-20">
          <span class="kicker" {...sbFieldPath('heroKicker')}>
            {safe(hp.heroKicker, 'Medical Aesthetics Practice')}
          </span>
          <h1 class="max-w-[700px] font-serif text-[clamp(46px,7vw,82px)] leading-[0.98] text-ink" {...sbFieldPath('heroTitle')}>
            {safe(hp.heroTitle, 'Medical Aesthetics.\nThoughtfully Practiced.').split('\n').map((line) => (
              <span class="block">{line}</span>
            ))}
          </h1>
          <p class="mt-7 max-w-[620px] text-[clamp(17px,2vw,20px)] leading-[1.7] text-muted-strong" {...sbFieldPath('heroDescription')}>
            {safe(hp.heroDescription, 'Individualized facial, body, skin, injectable, and wellness care planned through consultation, assessment, clinical judgment, and long-term follow-through.')}
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="/services/" class="btn-gold" {...sbFieldPath('heroCtaPrimaryText')}>
              {safe(hp.heroCtaPrimaryText, 'Explore services')}
            </a>
            <a href="/consultation/" class="btn-outline-gold" {...sbFieldPath('heroCtaSecondaryText')}>
              {safe(hp.heroCtaSecondaryText, 'Start with a consultation')}
            </a>
          </div>
          <p class="mt-8 text-[13px] font-medium text-muted" {...sbFieldPath('heroSubtitle')}>
            {safe(hp.heroSubtitle, 'Punta Gorda, Florida')}
          </p>
        </div>
        <figure class="relative min-h-[500px] overflow-hidden bg-limestone lg:min-h-full">
          <picture>
            <img
              src="/images/optimized/hor-skin-studio-1400.webp"
              srcset="/images/optimized/hor-skin-studio-800.webp 800w, /images/optimized/hor-skin-studio-1400.webp 1400w"
              sizes="(max-width: 1023px) 100vw, 55vw"
              alt="A House of Rose Aesthetics treatment room in Punta Gorda"
              width="1400"
              height="1050"
              fetchpriority="high"
              decoding="sync"
              class="absolute inset-0 h-full w-full object-cover"
            />
          </picture>
        </figure>
      </div>
    </section>

    <aside class="border-y border-walnut/10 bg-walnut px-6 py-5 text-ivory" aria-label="Practice details">
      <div class="mx-auto flex max-w-[1240px] flex-wrap justify-center gap-x-10 gap-y-2 text-center text-[13px] font-medium sm:justify-between sm:text-left">
        <span>525 E Olympia Ave, Unit 9 · Punta Gorda</span>
        <span>Serving Charlotte County and Southwest Florida</span>
        <span>Walk-ins welcome · Appointments recommended</span>
      </div>
    </aside>

    <section class="bg-bone px-6 py-[clamp(64px,9vw,112px)]">
      <div class="mx-auto grid max-w-[1240px] items-center gap-12 lg:grid-cols-[0.94fr_1.06fr] lg:gap-20">
        <figure class="relative aspect-[4/3] overflow-hidden bg-limestone">
          <picture>
            <source
              type="image/avif"
              srcset="/images/optimized/hor-lobby-800.avif 800w, /images/optimized/hor-lobby-1400.avif 1400w"
              sizes="(max-width: 1023px) 100vw, 48vw"
            />
            <img
              src="/images/optimized/hor-lobby-1400.webp"
              srcset="/images/optimized/hor-lobby-800.webp 800w, /images/optimized/hor-lobby-1400.webp 1400w"
              sizes="(max-width: 1023px) 100vw, 48vw"
              alt="The House of Rose Aesthetics reception area"
              width="1400"
              height="1050"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover"
            />
          </picture>
        </figure>
        <div>
          <span class="kicker" {...sbFieldPath('aboutKicker')}>{safe(hp.aboutKicker, 'About House of Rose Aesthetics')}</span>
          <h2 class="font-serif text-[clamp(34px,5vw,54px)] leading-[1.05] text-ink" {...sbFieldPath('aboutHeading')}>
            {safe(hp.aboutHeading, 'Medical aesthetics, thoughtfully practiced.')}
          </h2>
          <div class="mt-7 max-w-[650px] space-y-5 text-[17px] leading-[1.75] text-muted">
            <p {...sbFieldPath('aboutPara1')}>{safe(hp.aboutPara1, 'House of Rose Aesthetics is a medical aesthetics practice in Punta Gorda, Florida, built around individualized treatment planning and long-term care.')}</p>
            <p {...sbFieldPath('aboutPara2')}>{safe(hp.aboutPara2, 'Consultation and assessment guide the service, preparation, recovery, aftercare, and maintenance recommendations that belong in your plan.')}</p>
            <p {...sbFieldPath('aboutPara3')}>{safe(hp.aboutPara3, 'Located in Punta Gorda, House of Rose serves Charlotte County and Southwest Florida.')}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-breath px-6 py-[clamp(64px,9vw,112px)]">
      <div class="mx-auto max-w-[1280px]">
        <div class="max-w-[760px]">
          <span class="kicker" {...sbFieldPath('servicesKicker')}>{safe(hp.servicesKicker, 'Explore care')}</span>
          <h2 class="font-serif text-[clamp(34px,5vw,56px)] leading-[1.05] text-ink" {...sbFieldPath('servicesHeading')}>
            {safe(hp.servicesHeading, 'Start with what you want to understand.')}
          </h2>
          <p class="mt-6 text-[17px] leading-[1.75] text-muted" {...sbFieldPath('servicesIntro')}>
            {safe(hp.servicesIntro, 'Learn how each category is approached, then compare specific services, candidacy, and the next step for booking.')}
          </p>
        </div>
        <div class="mt-12 grid gap-5 md:grid-cols-2">
          {serviceGroups.map((group, index) => (
            <a href={groupHref(group.name)} class="group grid overflow-hidden border border-walnut/10 bg-bone sm:grid-cols-[180px_1fr]">
              <div class="min-h-[190px] overflow-hidden bg-limestone sm:min-h-full">
                <img
                  src={group.imagePath}
                  alt=""
                  width="700"
                  height="438"
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.025]"
                />
              </div>
              <div class="flex flex-col justify-center p-6 sm:p-7">
                <h3 class="font-serif text-[25px] leading-tight text-ink" {...sbFieldPathParts('serviceGroups', index, 'name')}>{group.name}</h3>
                <p class="mt-3 text-[14px] leading-[1.7] text-muted" {...sbFieldPathParts('serviceGroups', index, 'description')}>{group.description}</p>
                <span class="learn-more">Explore this category</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    {featuredServices.length > 0 && (
      <section class="bg-bone px-6 py-[clamp(64px,9vw,112px)]">
        <div class="mx-auto max-w-[1280px]">
          <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
            <div class="max-w-[700px]">
              <span class="kicker">Featured services</span>
              <h2 class="font-serif text-[clamp(34px,5vw,54px)] leading-[1.05] text-ink">Learn first. Book the exact next step.</h2>
            </div>
            <a href="/services/" class="btn-outline-gold">View all services</a>
          </div>
          <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {featuredServices.map((service) => (
              <ServiceCard
                title={service.title}
                slug={service.slug}
                tagline={service.tagline}
                bookingMode={service.bookingMode}
                bookingUrl={service.bookingUrl}
                objectId={service._id}
              />
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="on-dark bg-walnut px-6 py-[clamp(64px,9vw,112px)]">
      <div class="mx-auto max-w-[1240px]">
        <div class="max-w-[760px]">
          <span class="kicker" {...sbFieldPath('approachKicker')}>{safe(hp.approachKicker, 'How care is planned')}</span>
          <h2 class="font-serif text-[clamp(36px,5vw,58px)] leading-[1.05] text-ivory" {...sbFieldPath('approachHeading')}>
            {safe(hp.approachHeading, 'A clear plan before a procedure.')}
          </h2>
          <p class="mt-6 text-[17px] leading-[1.75] text-muted" {...sbFieldPath('approachPara1')}>
            {safe(hp.approachPara1, 'The right next step depends on the concern, treatment area, candidacy, timing, and recovery you can reasonably plan for.')}
          </p>
        </div>
        <ol class="care-plan-rail mt-14 grid gap-0 md:grid-cols-4">
          {careSteps.map((step, index) => (
            <li class="relative border-l border-ivory/25 px-6 pb-9 md:border-l-0 md:border-t md:pb-0 md:pt-8">
              <span class="absolute -left-[5px] top-1.5 h-2.5 w-2.5 rounded-full bg-gold-metal md:-top-[5px] md:left-6"></span>
              <p class="text-[12px] font-semibold tracking-[0.08em] text-gold">{String(index + 1).padStart(2, '0')}</p>
              <h3 class="mt-2 font-serif text-[26px] text-ivory">{step.title}</h3>
              <p class="mt-3 max-w-[260px] text-[14px] leading-[1.7] text-muted">{step.body}</p>
            </li>
          ))}
        </ol>
        <p class="mt-12 max-w-[720px] font-serif text-[22px] leading-[1.55] text-ivory" {...sbFieldPath('approachClosing')}>
          {safe(hp.approachClosing, 'The purpose is clarity: what is being considered, why it fits, and what comes afterward.')}
        </p>
      </div>
    </section>

    <section class="grid bg-limestone lg:grid-cols-2">
      <figure class="relative min-h-[440px] overflow-hidden bg-walnut lg:min-h-[680px]">
        <img
          src="/images/editorial/home/skin-analysis-consultation.webp"
          alt="A client reviewing a skin analysis with a House of Rose provider"
          width="1448"
          height="1086"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </figure>
      <div class="flex flex-col justify-center px-6 py-14 sm:px-10 lg:px-[clamp(48px,7vw,100px)] lg:py-20">
        <span class="kicker" {...sbFieldPath('scanKicker')}>{safe(hp.scanKicker, 'AI-assisted skin analysis')}</span>
        <h2 class="font-serif text-[clamp(34px,5vw,54px)] leading-[1.05] text-ink" {...sbFieldPath('scanHeading')}>
          {safe(hp.scanHeading, 'See what your skin is showing today.')}
        </h2>
        <p class="mt-6 text-[17px] leading-[1.75] text-muted-strong" {...sbFieldPath('scanPara1')}>
          {safe(hp.scanPara1, 'A skin analysis can support a closer look at visible texture, hydration, pores, pigmentation, fine lines, and sun exposure.')}
        </p>
        <p class="mt-4 text-[16px] leading-[1.75] text-muted" {...sbFieldPath('scanPara2')}>
          {safe(hp.scanPara2, 'We review the images in plain language and connect what we see to the goals you share. The analysis supports—not replaces—professional assessment and clinical judgment.')}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/skin-analysis/" class="btn-gold" {...sbFieldPath('scanCtaPrimaryText')}>{safe(hp.scanCtaPrimaryText, 'See what to expect')}</a>
          <a href="/consultation/" class="btn-outline-gold">Start a consultation</a>
        </div>
      </div>
    </section>

    <section class="bg-bone px-6 py-[clamp(64px,9vw,112px)]">
      <div class="mx-auto grid max-w-[1240px] gap-12 lg:grid-cols-[1fr_0.9fr] lg:items-center lg:gap-20">
        <div>
          <span class="kicker" {...sbFieldPath('expKicker')}>{safe(hp.expKicker, 'The experience')}</span>
          <h2 class="font-serif text-[clamp(34px,5vw,54px)] leading-[1.05] text-ink" {...sbFieldPath('expHeading')}>
            {safe(hp.expHeading, 'Time to ask questions. Space to understand the plan.')}
          </h2>
          <p class="mt-7 text-[17px] leading-[1.75] text-muted" {...sbFieldPath('expPara1')}>
            {safe(hp.expPara1, 'Appointments leave room to discuss your goals, evaluate the area being considered, and understand why a service may—or may not—make sense for you.')}
          </p>
          <p class="mt-4 text-[17px] leading-[1.75] text-muted" {...sbFieldPath('expPara2')}>
            {safe(hp.expPara2, 'Before you leave, you should understand what was done, what to expect next, and how to follow the aftercare plan.')}
          </p>
          <a href="/experience/" class="btn-outline-gold mt-8">See the practice experience</a>
        </div>
        <div class="border border-walnut/15 bg-breath p-8 sm:p-10">
          <span class="kicker" {...sbFieldPath('localKicker')}>{safe(hp.localKicker, 'Punta Gorda')}</span>
          <h2 class="font-serif text-[34px] leading-tight text-ink" {...sbFieldPath('localHeading')}>
            {safe(hp.localHeading, 'Medical aesthetics close to home.')}
          </h2>
          <p class="mt-5 text-[16px] leading-[1.75] text-muted" {...sbFieldPath('localPara1')}>
            {safe(hp.localPara1, 'House of Rose serves Punta Gorda, Port Charlotte, Charlotte Harbor, Babcock Ranch, Burnt Store Marina, Punta Gorda Isles, and the surrounding Southwest Florida area.')}
          </p>
          <address class="mt-7 not-italic text-[15px] leading-[1.8] text-muted-strong">
            525 E Olympia Ave, Unit 9<br />Punta Gorda, FL 33950<br />
            <a href="tel:+18449417673" class="font-semibold text-gold hover:text-walnut">(844) 941-7673</a>
          </address>
          <a href="/contact/" class="btn-gold mt-8">Contact House of Rose</a>
        </div>
      </div>
    </section>

    <section class="on-dark bg-walnut px-6 py-[clamp(64px,9vw,104px)] text-center">
      <div class="mx-auto max-w-[760px]">
        <span class="kicker">Your next step</span>
        <h2 class="font-serif text-[clamp(38px,6vw,62px)] leading-[1.04] text-ivory" {...sbFieldPath('finalHeading')}>
          {safe(hp.finalHeading, 'Begin with a clear conversation.')}
        </h2>
        <p class="mx-auto mt-6 max-w-[620px] text-[17px] leading-[1.75] text-muted" {...sbFieldPath('finalPara')}>
          {safe(hp.finalPara, 'Tell us what you are considering, and we will help you identify the service or consultation that makes sense to explore next.')}
        </p>
        <div class="mt-9 flex flex-wrap justify-center gap-3">
          <a href="/consultation/" class="btn-gold" {...sbFieldPath('finalCtaText')}>{safe(hp.finalCtaText, 'Start a consultation')}</a>
          <a href="/services/" class="btn-outline-white">Explore services</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
