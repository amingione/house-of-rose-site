---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import MembershipTiers from '@/components/MembershipTiers.astro';
import { sanityFetch } from '@/lib/sanity';
import { sbObjectId, sbFieldPath } from '@/lib/visualEditing';
import { PUBLIC_MEMBERSHIPS_QUERY, type Membership } from '@/lib/queries';

const BOOKING_URL = 'https://houseofrose.glossgenius.com/services';
const ROSE_CIRCLE_URL = '/rose-circle';

interface MembershipsPage {
  _id?: string;
  seoTitle?: string;
  seoDescription?: string;
  heroKicker?: string;
  heroTitle?: string;
  heroDescription?: string;
  heroCtaPrimaryText?: string;
  introKicker?: string;
  introHeading?: string;
  introBody?: string;
  rosePassKicker?: string;
  rosePassHeading?: string;
  rosePassBody?: string;
  ivHydrationKicker?: string;
  ivHydrationHeading?: string;
  ivHydrationBody?: string;
  basicFacialsKicker?: string;
  basicFacialsHeading?: string;
  basicFacialsBody?: string;
  advancedFacialsKicker?: string;
  advancedFacialsHeading?: string;
  advancedFacialsBody?: string;
  collagenBankKicker?: string;
  collagenBankHeading?: string;
  collagenBankBody?: string;
  finalKicker?: string;
  finalHeading?: string;
  finalBody?: string;
  finalCtaPrimaryText?: string;
  finalCtaSecondaryText?: string;
}

const MEMBERSHIPS_PAGE_QUERY = `*[_type == "membershipsPage"][0]{
  _id,
  seoTitle,
  seoDescription,
  heroKicker,
  heroTitle,
  heroDescription,
  heroCtaPrimaryText,
  introKicker,
  introHeading,
  introBody,
  rosePassKicker,
  rosePassHeading,
  rosePassBody,
  ivHydrationKicker,
  ivHydrationHeading,
  ivHydrationBody,
  basicFacialsKicker,
  basicFacialsHeading,
  basicFacialsBody,
  advancedFacialsKicker,
  advancedFacialsHeading,
  advancedFacialsBody,
  collagenBankKicker,
  collagenBankHeading,
  collagenBankBody,
  finalKicker,
  finalHeading,
  finalBody,
  finalCtaPrimaryText,
  finalCtaSecondaryText
}`;

const [data, allMemberships] = await Promise.all([
  sanityFetch<MembershipsPage | null>(MEMBERSHIPS_PAGE_QUERY).then((d) => d ?? ({} as MembershipsPage)),
  sanityFetch<Membership[]>(PUBLIC_MEMBERSHIPS_QUERY).then((d) => d ?? []),
]);

const FALLBACK_ROSE_PASS: Membership[] = [
  {
    _id: 'fallback-rose-pass',
    title: 'Rose Pass',
    slug: 'rose-pass',
    whatsIncluded: 'A monthly wax membership with preferred member access and predictable scheduling for the areas you maintain.',
    perks: 'Member-rate waxing, priority booking, and a steady cadence so upkeep never falls off track. Exact areas and pricing are confirmed at consultation.',
  },
];

const FALLBACK_IV_HYDRATION: Membership[] = [
  {
    _id: 'fallback-iv-hydration',
    title: 'IV Hydration Membership',
    slug: 'iv-hydration-membership',
    whatsIncluded: 'Recurring, provider-guided access to Hydration, Glow, Recovery, and Cellular IV drips at member rates.',
    perks: 'Consistent wellness support between skin-focused visits. Drip selection and cadence are confirmed at consultation and depend on candidacy.',
  },
];

const FALLBACK_BASIC_FACIALS: Membership[] = [
  {
    _id: 'fallback-basic-facials',
    title: 'Basic Facials Membership',
    slug: 'basic-facials-membership',
    whatsIncluded: 'A relaxing monthly facial without machines, invasive treatments, or chemical peels — simple, steady skin care.',
    perks: 'A calm, consistent touchpoint for maintenance between bigger treatments. Best for relaxation-focused care — ask your provider if Advanced Facials is a better fit.',
  },
];

const FALLBACK_ADVANCED_FACIALS: Membership[] = [
  {
    _id: 'fallback-advanced-facials',
    title: 'Advanced Facials Membership',
    slug: 'advanced-facials-membership',
    whatsIncluded: 'Corrective monthly facial care — dermaplaning, BioRePeel, chemical and body peels, Face Reality acne support, and oxygen infusion when appropriate.',
    perks: 'Includes AI skin analysis to track progress and adjust your plan. Customized after skin analysis and provider evaluation — candidacy confirmed at consultation.',
  },
];

const FALLBACK_COLLAGEN_BANK: Membership[] = [
  {
    _id: 'fallback-collagen-bank',
    title: 'Rose Collagen Bank',
    slug: 'rose-collagen-bank',
    whatsIncluded: 'Recurring collagen-supportive maintenance care for clients who have completed a Rose Regeneration Plan.',
    perks: 'Protects and extends your transformation results at member rates, with cadence set by your provider based on your plan.',
  },
];

const rosePassPlans = allMemberships.filter((m) => m.membershipGroup === 'rose-pass');
const ivHydrationPlans = allMemberships.filter((m) => m.membershipGroup === 'iv-hydration');
const basicFacialsPlans = allMemberships.filter((m) => m.membershipGroup === 'basic-facials');
const advancedFacialsPlans = allMemberships.filter((m) => m.membershipGroup === 'advanced-facials');
const collagenBankPlans = allMemberships.filter((m) => m.membershipGroup === 'collagen-bank');

const rosePass = rosePassPlans.length ? rosePassPlans : FALLBACK_ROSE_PASS;
const ivHydration = ivHydrationPlans.length ? ivHydrationPlans : FALLBACK_IV_HYDRATION;
const basicFacials = basicFacialsPlans.length ? basicFacialsPlans : FALLBACK_BASIC_FACIALS;
const advancedFacials = advancedFacialsPlans.length ? advancedFacialsPlans : FALLBACK_ADVANCED_FACIALS;
const collagenBank = collagenBankPlans.length ? collagenBankPlans : FALLBACK_COLLAGEN_BANK;
---

<BaseLayout
  title={data.seoTitle ?? 'Memberships | House of Rose Aesthetics, Punta Gorda FL'}
  description={data.seoDescription ?? 'Rose Pass wax membership, IV Hydration Membership, and the Rose Collagen Bank — recurring, member-rate care at House of Rose Aesthetics in Punta Gorda, FL. Pricing confirmed at consultation.'}
  preloadImage="/images/bg-hydration.webp"
>
  <div {...(data._id ? sbObjectId(data._id) : {})}>
    <Hero
      title={data.heroTitle ?? 'House of Rose Memberships'}
      kicker={data.heroKicker ?? 'Memberships'}
      description={data.heroDescription ?? 'Simple, recurring ways to stay connected to House of Rose between visits: the Rose Pass for waxing, IV Hydration Membership for wellness, and the Rose Collagen Bank for protecting your results. No discounts, no gimmicks — structured, member-rate care.'}
      size="small"
      showCTA={true}
      ctaPrimary={{ text: data.heroCtaPrimaryText ?? 'Explore The Rose Circle', href: ROSE_CIRCLE_URL }}
      backgroundImage="/images/bg-hydration.webp"
      titleField="heroTitle"
      kickerField="heroKicker"
      descriptionField="heroDescription"
    />

    <section class="bg-charcoal py-[clamp(48px,7vw,96px)] px-6">
      <div class="max-w-[860px] mx-auto text-center">
        <span class="kicker" {...sbFieldPath('introKicker')}>{data.introKicker ?? 'Care You Can Count On'}</span>
        <h2 class="font-serif text-[clamp(24px,3.6vw,40px)] text-ink leading-tight mt-2 mb-6" {...sbFieldPath('introHeading')}>
          {data.introHeading ?? 'Simple memberships for the care you already love.'}
        </h2>
        <p class="text-[#7a6e5c] text-[16px] leading-[1.85] max-w-[680px] mx-auto" {...sbFieldPath('introBody')}>
          {data.introBody ?? 'Each membership is a focused, recurring commitment to one part of your routine — waxing, IV wellness, facials, or collagen maintenance — at member rates, with no discount-club gimmicks. Want something more comprehensive? The Rose Circle builds a full plan around your whole complexion using the Rose Method.'}
        </p>
      </div>
    </section>

    <section class="bg-charcoal-light py-[clamp(48px,7vw,88px)] px-6 border-t border-gold/10" id="rose-pass">
      <div class="max-w-[1080px] mx-auto">
        <div class="max-w-[720px] mb-10">
          <span class="kicker" {...sbFieldPath('rosePassKicker')}>{data.rosePassKicker ?? 'Rose Pass'}</span>
          <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ink mt-2 mb-4" {...sbFieldPath('rosePassHeading')}>
            {data.rosePassHeading ?? 'Smooth, consistent upkeep on a predictable schedule.'}
          </h2>
          <p class="text-[#9a8c78] text-[15px] leading-[1.75]" {...sbFieldPath('rosePassBody')}>
            {data.rosePassBody ?? 'The Rose Pass is our monthly wax membership: preferred member access and steady scheduling so grooming stays effortless. Exact cadence and pricing are confirmed at consultation based on the areas you maintain.'}
          </p>
        </div>
        <MembershipTiers memberships={rosePass} bookingHref={BOOKING_URL} ctaText="Choose Your Pass" editable={rosePassPlans.length > 0} />
      </div>
    </section>

    <section class="bg-charcoal py-[clamp(48px,7vw,88px)] px-6 border-t border-gold/10" id="iv-hydration">
      <div class="max-w-[1080px] mx-auto">
        <div class="max-w-[720px] mb-10">
          <span class="kicker" {...sbFieldPath('ivHydrationKicker')}>{data.ivHydrationKicker ?? 'IV Hydration Membership'}</span>
          <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ink mt-2 mb-4" {...sbFieldPath('ivHydrationHeading')}>
            {data.ivHydrationHeading ?? 'Recurring wellness support at member rates.'}
          </h2>
          <p class="text-[#9a8c78] text-[15px] leading-[1.75]" {...sbFieldPath('ivHydrationBody')}>
            {data.ivHydrationBody ?? 'IV Hydration Membership plans give you provider-guided access to Hydration, Glow, Recovery, and Cellular drips on a recurring cadence, supporting energy, recovery, and skin health between visits. Your provider confirms the right plan and drip mix at consultation.'}
          </p>
        </div>
        <MembershipTiers memberships={ivHydration} bookingHref={BOOKING_URL} ctaText="Ask About This Plan" editable={ivHydrationPlans.length > 0} />
      </div>
    </section>

    <section class="bg-charcoal-light py-[clamp(48px,7vw,88px)] px-6 border-t border-gold/10" id="basic-facials">
      <div class="max-w-[1080px] mx-auto">
        <div class="max-w-[720px] mb-10">
          <span class="kicker" {...sbFieldPath('basicFacialsKicker')}>{data.basicFacialsKicker ?? 'Basic Facials'}</span>
          <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ink mt-2 mb-4" {...sbFieldPath('basicFacialsHeading')}>
            {data.basicFacialsHeading ?? 'Simple, relaxing skin care on a steady monthly rhythm.'}
          </h2>
          <p class="text-[#9a8c78] text-[15px] leading-[1.75]" {...sbFieldPath('basicFacialsBody')}>
            {data.basicFacialsBody ?? 'For clients who want calm, consistent care without machines or chemical peels — a steady touchpoint between bigger treatments.'}
          </p>
        </div>
        <MembershipTiers memberships={basicFacials} bookingHref={BOOKING_URL} ctaText="Get Started" editable={basicFacialsPlans.length > 0} />
      </div>
    </section>

    <section class="bg-charcoal py-[clamp(48px,7vw,88px)] px-6 border-t border-gold/10" id="advanced-facials">
      <div class="max-w-[1080px] mx-auto">
        <div class="max-w-[720px] mb-10">
          <span class="kicker" {...sbFieldPath('advancedFacialsKicker')}>{data.advancedFacialsKicker ?? 'Advanced Facials'}</span>
          <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ink mt-2 mb-4" {...sbFieldPath('advancedFacialsHeading')}>
            {data.advancedFacialsHeading ?? 'Corrective care for clients who need a real plan.'}
          </h2>
          <p class="text-[#9a8c78] text-[15px] leading-[1.75]" {...sbFieldPath('advancedFacialsBody')}>
            {data.advancedFacialsBody ?? 'Dermaplaning, BioRePeel, chemical and body peels, and Face Reality acne support — customized after skin analysis and confirmed at consultation.'}
          </p>
        </div>
        <MembershipTiers memberships={advancedFacials} bookingHref={BOOKING_URL} ctaText="Ask About Candidacy" editable={advancedFacialsPlans.length > 0} />
      </div>
    </section>

    <section class="bg-charcoal-light py-[clamp(48px,7vw,88px)] px-6 border-t border-gold/10" id="collagen-bank">
      <div class="max-w-[1080px] mx-auto">
        <div class="max-w-[720px] mb-10">
          <span class="kicker" {...sbFieldPath('collagenBankKicker')}>{data.collagenBankKicker ?? 'Rose Collagen Bank'}</span>
          <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ink mt-2 mb-4" {...sbFieldPath('collagenBankHeading')}>
            {data.collagenBankHeading ?? 'Protect the results your Regeneration Plan built.'}
          </h2>
          <p class="text-[#9a8c78] text-[15px] leading-[1.75]" {...sbFieldPath('collagenBankBody')}>
            {data.collagenBankBody ?? 'Once you’ve completed a Regeneration Plan (a multi-month treatment plan built with your provider — see The Rose Method), the Rose Collagen Bank is how you maintain it: recurring collagen-supportive care that protects your outcome and extends it over time, at member rates.'}
          </p>
        </div>
        <MembershipTiers memberships={collagenBank} bookingHref={BOOKING_URL} ctaText="Ask If You're a Fit" editable={collagenBankPlans.length > 0} />
      </div>
    </section>

    <section class="bg-walnut py-[clamp(48px,7vw,88px)] px-6 border-t border-gold/15">
      <div class="max-w-[820px] mx-auto text-center">
        <span class="kicker" {...sbFieldPath('finalKicker')}>{data.finalKicker ?? 'Ready to Join?'}</span>
        <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ivory mt-2 mb-4" {...sbFieldPath('finalHeading')}>
          {data.finalHeading ?? 'Talk to a provider about the right membership for you.'}
        </h2>
        <p class="text-ivory/70 text-[15px] max-w-[620px] mx-auto mb-8 leading-[1.85]" {...sbFieldPath('finalBody')}>
          {data.finalBody ?? 'Membership pricing and cadence are confirmed at consultation so your plan matches your actual routine and goals.'}
        </p>
        <div class="flex gap-3 justify-center flex-wrap">
          <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn-gold" {...sbFieldPath('finalCtaPrimaryText')}>{data.finalCtaPrimaryText ?? 'Schedule a Consultation'}</a>
          <a href={ROSE_CIRCLE_URL} class="btn-outline-white" {...sbFieldPath('finalCtaSecondaryText')}>{data.finalCtaSecondaryText ?? 'Explore The Rose Circle'}</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
