---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import { sanityFetch } from '@/lib/sanity';
import { sbObjectId, sbFieldPath, sbFieldPathParts } from '@/lib/visualEditing';

const BOOKING_URL = 'https://houseofrose.glossgenius.com/services';
const SKIN_ANALYSIS_URL = '/skin-analysis';
const METHOD_URL = '/plans';

interface RoseCircleLane {
  name: string;
  provider: string;
  description: string;
  includes: string[];
  note?: string;
}

interface PathwayStep {
  step: string;
  body: string;
}

interface MembershipsPage {
  _id?: string;
  seoTitle?: string;
  seoDescription?: string;
  heroKicker?: string;
  heroTitle?: string;
  heroDescription?: string;
  heroCtaPrimaryText?: string;
  heroCtaSecondaryText?: string;
  ideaKicker?: string;
  ideaHeading?: string;
  ideaBody?: string;
  commitmentKicker?: string;
  commitmentHeading?: string;
  commitmentBody?: string;
  lanesKicker?: string;
  lanesHeading?: string;
  lanesIntro?: string;
  lanes?: RoseCircleLane[];
  scannerKicker?: string;
  scannerHeading?: string;
  scannerBody?: string;
  scannerPoints?: string[];
  pathwayKicker?: string;
  pathwayHeading?: string;
  pathway?: PathwayStep[];
  teaserKicker?: string;
  teaserHeading?: string;
  teaserBody?: string;
  teaserCtaText?: string;
  finalKicker?: string;
  finalHeading?: string;
  finalBody?: string;
  finalCtaPrimaryText?: string;
  finalCtaSecondaryText?: string;
}

const MEMBERSHIPS_PAGE_QUERY = `*[_type == "membershipsPage"][0]{
  _id,
  seoTitle,
  seoDescription,
  heroKicker,
  heroTitle,
  heroDescription,
  heroCtaPrimaryText,
  heroCtaSecondaryText,
  ideaKicker,
  ideaHeading,
  ideaBody,
  commitmentKicker,
  commitmentHeading,
  commitmentBody,
  lanesKicker,
  lanesHeading,
  lanesIntro,
  lanes[]{ _key, name, provider, description, includes, note },
  scannerKicker,
  scannerHeading,
  scannerBody,
  scannerPoints,
  pathwayKicker,
  pathwayHeading,
  pathway[]{ _key, step, body },
  teaserKicker,
  teaserHeading,
  teaserBody,
  teaserCtaText,
  finalKicker,
  finalHeading,
  finalBody,
  finalCtaPrimaryText,
  finalCtaSecondaryText
}`;

const data = (await sanityFetch<MembershipsPage | null>(MEMBERSHIPS_PAGE_QUERY)) ?? ({} as MembershipsPage);

const FALLBACK_LANES: RoseCircleLane[] = [
  {
    name: 'IV Hydration',
    provider: 'Diana',
    description: 'A monthly wellness lane for hydration, recovery, and internal support inside the larger Rose Method rhythm.',
    includes: ['Provider-guided IV hydration cadence', 'Member-rate access to eligible drips and add-ons', 'Support for energy, recovery, and consistency between skin-focused visits'],
    note: 'Exact drip selection is confirmed at consultation and depends on candidacy.',
  },
  {
    name: 'Basic Facials',
    provider: 'Brandy',
    description: 'The feel-good facial lane for relaxation, comfort, and simple monthly skin care without machines, invasive treatments, or chemical peels.',
    includes: ['Relaxing monthly facial care', 'No machines, invasive treatments, or chemical peels', 'A steady touchpoint for clients who want calm, consistent care'],
    note: 'Best for relaxation-focused maintenance, not corrective advanced treatment.',
  },
  {
    name: 'Wax Pass',
    provider: 'Brooke',
    description: 'A monthly waxing lane for clients who want smooth, consistent upkeep with preferred member access and predictable scheduling.',
    includes: ['Monthly wax care matched to the client routine', 'Member-rate waxing access', 'A simple way to stay on track with regular grooming appointments'],
  },
  {
    name: 'Advanced Facials',
    provider: 'Amber',
    description: 'The corrective skin lane for clients who need a true plan: dermaplaning, BioRePeel, chemical and body peels, Face Reality, and oxygen infusion when appropriate.',
    includes: ['Dermaplaning, BioRePeel, and other chemical peels when appropriate', 'Body peel options for areas such as back, arms, and legs', 'Face Reality acne support and oxygen infusion options', 'AI skin analysis used to track progress and adjust the plan'],
    note: 'This lane is customized after skin analysis and provider evaluation.',
  },
];

const FALLBACK_SCANNER_POINTS = [
  'Create a visible baseline before the plan begins',
  'Compare progress over the 6-month commitment',
  'Help your provider adjust timing, services, and home care',
  'Tie treatment decisions to evidence instead of guesswork',
];

const FALLBACK_PATHWAY: PathwayStep[] = [
  { step: 'Skin Analysis', body: 'We begin with AI-assisted imaging and provider evaluation so the membership is based on your skin, not a preset menu.' },
  { step: 'Custom Plan', body: 'Your provider maps the right lane, cadence, and member-rate services for your goals and candidacy.' },
  { step: 'Six Months', body: 'The Rose Circle requires a 6-month minimum commitment because healthy visible change needs time to evolve.' },
];

const lanes = data.lanes?.length ? data.lanes : FALLBACK_LANES;
const scannerPoints = data.scannerPoints?.length ? data.scannerPoints : FALLBACK_SCANNER_POINTS;
const pathway = data.pathway?.length ? data.pathway : FALLBACK_PATHWAY;
const usingFallbackLanes = !data.lanes?.length;
const usingFallbackPathway = !data.pathway?.length;
---

<BaseLayout
  title={data.seoTitle ?? 'The Rose Circle Membership | House of Rose Aesthetics, Punta Gorda FL'}
  description={data.seoDescription ?? 'The Rose Circle is a 6-month guided membership path at House of Rose Aesthetics in Punta Gorda, FL. Each plan begins with skin analysis and provider evaluation before member-rate care is customized.'}
  preloadImage="/images/hor-lounge.jpg"
>
  <div {...(data._id ? sbObjectId(data._id) : {})}>
    <Hero
      title={data.heroTitle ?? 'The Rose Circle'}
      kicker={data.heroKicker ?? 'Membership - Guided Skin Planning'}
      description={data.heroDescription ?? 'A 6-month guided membership path built around your actual skin. We start with AI skin analysis and provider evaluation, then create a custom plan at member rates so your care has enough time to create healthy visible change.'}
      size="small"
      showCTA={true}
      ctaPrimary={{ text: data.heroCtaPrimaryText ?? 'Book Your Skin Analysis', href: SKIN_ANALYSIS_URL }}
      ctaSecondary={{ text: data.heroCtaSecondaryText ?? 'Schedule a Consultation', href: BOOKING_URL }}
      backgroundImage="/images/hor-lounge.jpg"
      titleField="heroTitle"
      kickerField="heroKicker"
      descriptionField="heroDescription"
    />

    <section class="bg-charcoal py-[clamp(48px,7vw,96px)] px-6">
      <div class="max-w-[860px] mx-auto text-center">
        <span class="kicker" {...sbFieldPath('ideaKicker')}>{data.ideaKicker ?? 'The Idea'}</span>
        <h2 class="font-serif text-[clamp(24px,3.6vw,40px)] text-ink leading-tight mt-2 mb-6" {...sbFieldPath('ideaHeading')}>
          {data.ideaHeading ?? 'This is not a preset package. It is a guided treatment plan.'}
        </h2>
        <p class="text-[#7a6e5c] text-[16px] leading-[1.85] max-w-[680px] mx-auto" {...sbFieldPath('ideaBody')}>
          {data.ideaBody ?? 'The Rose Circle applies The Rose Method to real life: skin analysis, provider judgment, a custom lane, and member-rate care over six months. The plan is built after we see and examine your skin because meaningful recommendations cannot be made from a menu.'}
        </p>
      </div>
    </section>

    <section class="bg-charcoal-light py-[clamp(48px,7vw,88px)] px-6 border-t border-gold/10">
      <div class="max-w-[1080px] mx-auto grid grid-cols-1 md:grid-cols-[0.9fr_1.1fr] gap-[clamp(32px,5vw,72px)] items-center">
        <div>
          <span class="kicker" {...sbFieldPath('commitmentKicker')}>{data.commitmentKicker ?? 'The Commitment'}</span>
          <h2 class="font-serif text-[clamp(24px,4vw,40px)] text-ink leading-tight mt-2 mb-5" {...sbFieldPath('commitmentHeading')}>
            {data.commitmentHeading ?? 'Six months, because real skin change needs time.'}
          </h2>
        </div>
        <p class="text-[#7a6e5c] text-[15px] leading-[1.85]" {...sbFieldPath('commitmentBody')}>
          {data.commitmentBody ?? 'A 6-month minimum commitment is required for Rose Circle members. Nothing rolls over because this is not a punch card or gimmick; it is a true working treatment plan at member rates. Six months gives your skin enough time for healthier change to evolve, for your provider to track progress, and for the plan to be adjusted intelligently as your skin responds.'}
        </p>
      </div>
    </section>

    <section class="bg-charcoal py-[clamp(48px,7vw,96px)] px-6" id="lanes">
      <div class="max-w-[1280px] mx-auto">
        <div class="max-w-[760px] mb-12">
          <span class="kicker" {...sbFieldPath('lanesKicker')}>{data.lanesKicker ?? 'Provider Lanes'}</span>
          <h2 class="font-serif text-[clamp(24px,4vw,40px)] text-ink mt-2 mb-4" {...sbFieldPath('lanesHeading')}>
            {data.lanesHeading ?? 'Your Rose Circle plan is built around the care you actually need.'}
          </h2>
          <p class="text-[#9a8c78] text-[15px] leading-[1.75]" {...sbFieldPath('lanesIntro')}>
            {data.lanesIntro ?? 'Each lane gives the provider a focused starting point. Your final cadence, services, and member-rate recommendations are confirmed only after skin analysis and consultation.'}
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-px bg-gold/15">
          {lanes.map((lane, i) => (
            <article class="flex flex-col bg-breath p-8">
              <span class="text-gold text-[10px] tracking-[0.3em] uppercase mb-3" {...(usingFallbackLanes ? {} : sbFieldPathParts('lanes', i, 'provider'))}>{lane.provider}</span>
              <h3 class="font-serif text-[26px] text-ink leading-tight mb-3" {...(usingFallbackLanes ? {} : sbFieldPathParts('lanes', i, 'name'))}>{lane.name}</h3>
              <p class="text-ink/75 text-[14px] leading-[1.65] mb-6" {...(usingFallbackLanes ? {} : sbFieldPathParts('lanes', i, 'description'))}>{lane.description}</p>
              <ul class="space-y-3 mb-8 flex-1">
                {lane.includes.map((item, bi) => (
                  <li class="flex gap-2.5 text-[#5f5446] text-[14px] leading-[1.55]">
                    <span class="text-gold mt-0.5">-</span>
                    <span {...(usingFallbackLanes ? {} : sbFieldPathParts('lanes', i, 'includes', bi))}>{item}</span>
                  </li>
                ))}
              </ul>
              {lane.note && <p class="text-[#9a8c78] text-[12px] italic mb-5" {...(usingFallbackLanes ? {} : sbFieldPathParts('lanes', i, 'note'))}>{lane.note}</p>}
              <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn-outline-gold w-full text-center">Schedule a Consultation</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-charcoal-light grid grid-cols-1 md:grid-cols-2 border-t border-gold/10">
      <div class="p-[clamp(38px,6vw,76px)] flex flex-col justify-center">
        <span class="kicker" {...sbFieldPath('scannerKicker')}>{data.scannerKicker ?? 'Progress Tracking'}</span>
        <h2 class="font-serif text-[clamp(24px,3.4vw,38px)] text-ink leading-tight mt-2 mb-6" {...sbFieldPath('scannerHeading')}>
          {data.scannerHeading ?? 'The AI skin scanner makes the plan measurable.'}
        </h2>
        <p class="text-[#9a8c78] text-[15px] leading-[1.75] max-w-[560px] mb-7" {...sbFieldPath('scannerBody')}>
          {data.scannerBody ?? 'Rose Circle members use AI-assisted skin analysis to establish a baseline, compare progress, and keep the plan honest. Your provider can see what is changing, what needs more time, and where the next treatment belongs.'}
        </p>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-gold/10 max-w-[620px]">
          {scannerPoints.map((point, i) => (
            <li class="bg-charcoal-light p-5 text-[#5f5446] text-[14px] leading-[1.55]" {...sbFieldPathParts('scannerPoints', i)}>{point}</li>
          ))}
        </ul>
      </div>
      <div class="relative min-h-[360px] bg-charcoal">
        <img src="/images/new-consultation.png" alt="AI skin analysis consultation at House of Rose Aesthetics" loading="lazy" class="w-full h-full object-cover" width="1200" height="900" />
      </div>
    </section>

    <section class="bg-charcoal py-[clamp(48px,7vw,88px)] px-6">
      <div class="max-w-[1080px] mx-auto">
        <div class="text-center max-w-[680px] mx-auto mb-14">
          <span class="kicker" {...sbFieldPath('pathwayKicker')}>{data.pathwayKicker ?? 'The Pathway'}</span>
          <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ink mt-2" {...sbFieldPath('pathwayHeading')}>{data.pathwayHeading ?? 'How you move through the Circle.'}</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
          {pathway.map((p, i) => (
            <div class="text-center">
              <p class="font-serif text-gold/40 text-[44px] mb-3">{String(i + 1).padStart(2, '0')}</p>
              <p class="text-ink text-[17px] font-serif mb-3" {...(usingFallbackPathway ? {} : sbFieldPathParts('pathway', i, 'step'))}>{p.step}</p>
              <p class="text-[#7a6e5c] text-[14px] leading-relaxed max-w-[310px] mx-auto" {...(usingFallbackPathway ? {} : sbFieldPathParts('pathway', i, 'body'))}>{p.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-walnut py-[clamp(48px,7vw,88px)] px-6">
      <div class="max-w-[820px] mx-auto text-center">
        <span class="kicker" {...sbFieldPath('teaserKicker')}>{data.teaserKicker ?? 'The Rose Method'}</span>
        <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ivory mt-2 mb-4" {...sbFieldPath('teaserHeading')}>{data.teaserHeading ?? 'The science behind the Circle.'}</h2>
        <p class="text-ivory/70 text-[15px] max-w-[620px] mx-auto mb-8 leading-[1.85]" {...sbFieldPath('teaserBody')}>
          {data.teaserBody ?? 'The Rose Method sequences care through analysis, preparation, correction, and maintenance. It is the reason Rose Circle memberships begin with examination instead of a preconfigured plan.'}
        </p>
        <a href={METHOD_URL} class="btn-outline-white" {...sbFieldPath('teaserCtaText')}>{data.teaserCtaText ?? 'Learn the Rose Method'}</a>
      </div>
    </section>

    <section class="bg-charcoal-light py-[clamp(56px,8vw,96px)] px-6 border-t border-gold/15">
      <div class="max-w-[660px] mx-auto text-center">
        <span class="kicker" {...sbFieldPath('finalKicker')}>{data.finalKicker ?? 'Begin With Evidence'}</span>
        <h2 class="font-serif text-[clamp(26px,4.5vw,42px)] text-ink leading-tight mt-2 mb-5" {...sbFieldPath('finalHeading')}>{data.finalHeading ?? 'Book the scan. Then we build the plan.'}</h2>
        <p class="text-[#7a6e5c] text-[15px] max-w-[500px] mx-auto mb-9 leading-[1.8]" {...sbFieldPath('finalBody')}>
          {data.finalBody ?? 'Your Rose Circle membership cannot be finalized from a public menu. We need to see your skin, talk through your goals, and choose the lane that gives your plan enough time to work.'}
        </p>
        <div class="flex gap-3 justify-center flex-wrap">
          <a href={SKIN_ANALYSIS_URL} class="btn-gold" {...sbFieldPath('finalCtaPrimaryText')}>{data.finalCtaPrimaryText ?? 'Book Your Skin Analysis'}</a>
          <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn-outline-gold" {...sbFieldPath('finalCtaSecondaryText')}>{data.finalCtaSecondaryText ?? 'Schedule a Consultation'}</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
