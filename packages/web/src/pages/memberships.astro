---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';

const BOOKING_URL = 'https://houseofrose.glossgenius.com/services';

// Lane-tiered membership architecture — providers run distinct lanes; memberships coexist.
// Source: vault 04-Membership/membership-brainstorm-comparison.md (Lily = Idea D inclusion model, Iris = Diana's program scoped to injectables, Hydrangea = wellness rider)

interface MembershipTier {
  name: string;
  price: string;
  summary: string;
  benefits: string[];
  value?: string;
  featured: boolean;
}

interface MembershipLane {
  id: string;
  kicker: string;
  name: string;
  intro: string;
  tiers: MembershipTier[];
  footnote: string;
}

const lanes: MembershipLane[] = [
  {
    id: 'lily',
    kicker: 'Advanced Aesthetics',
    name: 'The Lily Membership',
    intro:
      'Your monthly treatment, included. Lily is built around the 4–6 week cadence our regenerative protocols are designed for — choose your tier, and your treatment each month is simply part of it.',
    tiers: [
      {
        name: 'Lily Essentials',
        price: '149',
        summary: 'A standing monthly ritual for glow and maintenance.',
        benefits: [
          'One treatment monthly: Dermaplaning Facial, Clarity acne session, or Glo2Facial',
          '10% off additional services',
          'LED add-on at member rate',
          '15% off home-care products',
          'Priority booking & birthday treatment',
        ],
        value: 'Valued at up to $234/month',
        featured: false,
      },
      {
        name: 'Lily Signature',
        price: '299',
        summary: 'Monthly ProCell microchanneling — collagen, on schedule.',
        benefits: [
          'One treatment monthly: ProCell Face, ProCell MD, or BioRePeel + Dermaplane',
          '10% off additional services',
          'LED add-on at member rate',
          '15% off home-care products',
          'Priority booking & birthday treatment',
        ],
        value: 'Valued at up to $484/month',
        featured: true,
      },
      {
        name: 'Lily Regenerative',
        price: '499',
        summary: 'The Gilded Lily — our signature PRF protocol, monthly.',
        benefits: [
          'One PRF microchanneling treatment monthly ($650 value)',
          '10% off additional services',
          'LED add-on at member rate',
          '15% off home-care products',
          'Priority booking & birthday treatment',
        ],
        value: 'Valued at $685/month',
        featured: false,
      },
    ],
    footnote:
      'Missed months roll forward once. Seasonal residents may pause their membership at no charge — we are snowbird-friendly by design.',
  },
  {
    id: 'iris',
    kicker: 'Injectables',
    name: 'The Iris Membership',
    intro:
      'Banked credit toward injectable care — neurotoxins, dermal fillers, and PRF treatments — plus member pricing that rewards consistency.',
    tiers: [
      {
        name: 'Iris I',
        price: '99',
        summary: 'A simple way to begin banking toward your care.',
        benefits: [
          '$99 banked toward treatments each month',
          '10% off dermal fillers',
          'Member pricing on neurotoxins',
        ],
        featured: false,
      },
      {
        name: 'Iris II',
        price: '199',
        summary: 'For clients on a consistent, ongoing plan.',
        benefits: [
          '$199 banked toward treatments each month',
          '15% off dermal fillers',
          'Complimentary monthly B12 injection',
          'Member pricing on neurotoxins',
        ],
        featured: true,
      },
      {
        name: 'Iris III',
        price: '299',
        summary: 'Our most complete injectables membership.',
        benefits: [
          '$299 banked toward treatments each month',
          '20% off dermal fillers',
          'Priority scheduling',
          'Exclusive member events',
          'Preferred neurotoxin pricing',
        ],
        featured: false,
      },
    ],
    footnote:
      'Banked amounts apply toward injectable treatments; member pricing applies on top.',
  },
];

const rider = {
  name: 'The Hydrangea Wellness Add-On',
  price: '89',
  standalone: '109',
  benefits: [
    'One Hydration IV each month ($129 value)',
    '10% off all additional drips, NAD+ therapy, and vitamin shots',
    'Attachable to any Lily or Iris membership',
  ],
};
---

<BaseLayout
  title="Memberships in Punta Gorda, FL | House of Rose Aesthetics"
  description="Membership plans at House of Rose Aesthetics in Punta Gorda, FL. Bank toward your treatments each month and keep your results compounding with consistent, personalized care."
  preloadImage="/images/house-of-rose-collection.webp"
>
  <!-- ── HERO ─────────────────────────────────────────────────────── -->
  <Hero
    title="Care that continues beyond a single appointment."
    kicker="Memberships & Ongoing Care"
    description="Healthy skin is built over time, not in one visit. Our memberships are designed for clients who want consistency, preferred pricing, and a more connected approach to their care."
    size="small"
    showCTA={true}
    ctaPrimary={{ text: 'Become a Member', href: '/contact' }}
    ctaSecondary={{ text: 'Book a Treatment', href: BOOKING_URL }}
    backgroundImage="/images/house-of-rose-collection.webp"
  />

  <!-- ── THE IDEA: COLLAGEN BANKING ───────────────────────────────── -->
  <section class="bg-charcoal grid grid-cols-1 md:grid-cols-2">
    <div class="p-[clamp(38px,6vw,76px)] flex flex-col justify-center">
      <span class="kicker">The Idea</span>
      <h2 class="font-serif text-[clamp(24px,3.4vw,38px)] text-white leading-tight mt-2 mb-6">
        Collagen banking, on the right rhythm.
      </h2>
      <p class="text-[#888] text-[15px] leading-[1.75] max-w-[560px] mb-4">
        Because PRF and ProCell microchanneling are designed to be spaced four to six weeks apart, a monthly rhythm isn't just convenient—it's how results actually compound. Membership keeps you on that cadence.
      </p>
      <p class="text-[#888] text-[15px] leading-[1.75] max-w-[560px]">
        Our memberships are organized by lane: The Lily Membership for advanced aesthetics, The Iris Membership for injectable care, and the Hydrangea add-on for our IV Hydration Lounge. Hold more than one and you join the House Collective—priority booking across every provider, and first invitations to member events.
      </p>
    </div>
    <div class="relative min-h-[340px] bg-charcoal-lighter">
      <img
        src="/images/house-of-rose-collection.webp"
        alt="House of Rose Aesthetics membership and ongoing care in Punta Gorda, Florida"
        loading="lazy"
        class="w-full h-full object-cover"
        width="1400"
        height="933"
      />
    </div>
  </section>

  <!-- ── MEMBERSHIP LANES ─────────────────────────────────────────── -->
  {lanes.map((lane, laneIndex) => (
    <section class={laneIndex % 2 === 0 ? 'bg-charcoal-light py-[clamp(48px,7vw,96px)] px-6' : 'bg-charcoal py-[clamp(48px,7vw,96px)] px-6'} id={lane.id}>
      <div class="max-w-[1280px] mx-auto">
        <div class="max-w-[700px] mb-12">
          <span class="kicker">{lane.kicker}</span>
          <h2 class="font-serif text-[clamp(24px,4vw,40px)] text-white mt-2 mb-4">
            {lane.name}
          </h2>
          <p class="text-[#888] text-[15px] leading-[1.75]">{lane.intro}</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-gold/10">
          {lane.tiers.map((tier) => (
            <div class={`flex flex-col bg-charcoal p-8 ${tier.featured ? 'ring-1 ring-gold/40' : ''}`}>
              <h3 class="font-serif text-[22px] text-white mb-1">{tier.name}</h3>
              <p class="text-[#777] text-[13px] leading-[1.6] mb-5">{tier.summary}</p>
              <div class="flex items-baseline gap-1 mb-2">
                <span class="font-serif text-[40px] text-white leading-none">${tier.price}</span>
                <span class="text-[#777] text-[13px]">/ month</span>
              </div>
              {tier.value && (
                <p class="text-gold text-[11px] tracking-[0.18em] uppercase mb-6">{tier.value}</p>
              )}
              <ul class="space-y-3 mb-8 flex-1">
                {tier.benefits.map((b) => (
                  <li class="flex gap-2.5 text-[#bbb] text-[14px] leading-[1.55]">
                    <span class="text-gold mt-0.5">—</span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
              <a href="/contact" class={tier.featured ? 'btn-gold w-full text-center' : 'btn-outline-gold w-full text-center'}>
                Join {tier.name}
              </a>
            </div>
          ))}
        </div>

        <p class="text-[#555] text-[12px] leading-[1.7] mt-7 max-w-[760px]">
          {lane.footnote}
        </p>
      </div>
    </section>
  ))}

  <!-- ── HYDRANGEA WELLNESS RIDER ─────────────────────────────────── -->
  <section class="bg-charcoal-light py-[clamp(48px,7vw,80px)] px-6 border-t border-gold/10" id="hydrangea">
    <div class="max-w-[960px] mx-auto text-center">
      <span class="kicker">IV Hydration Lounge</span>
      <h2 class="font-serif text-[clamp(24px,4vw,36px)] text-white mt-2 mb-3">
        {rider.name}
      </h2>
      <p class="text-white/85 text-[15px] mb-2">
        <span class="font-serif text-[32px] text-white">${rider.price}</span>
        <span class="text-[#777] text-[13px]"> / month with any membership</span>
        <span class="text-gold mx-2">·</span>
        <span class="text-[#777] text-[13px]">${rider.standalone} / month standalone</span>
      </p>
      <ul class="inline-flex flex-col items-start gap-2.5 my-6 text-left">
        {rider.benefits.map((b) => (
          <li class="flex gap-2.5 text-[#bbb] text-[14px] leading-[1.55]">
            <span class="text-gold mt-0.5">—</span>
            <span>{b}</span>
          </li>
        ))}
      </ul>
      <div>
        <a href="/contact" class="btn-outline-gold">Add Hydrangea</a>
      </div>
    </div>
  </section>

  <!-- ── CTA ──────────────────────────────────────────────────────── -->
  <section class="bg-charcoal py-[clamp(56px,8vw,96px)] px-6 border-t border-gold/10">
    <div class="max-w-[640px] mx-auto text-center">
      <span class="kicker">Join</span>
      <h2 class="font-serif text-[clamp(26px,4.5vw,42px)] text-white leading-tight mt-2 mb-5">
        Stay consistent. See it compound.
      </h2>
      <p class="text-[#888] text-[15px] max-w-[460px] mx-auto mb-9 leading-[1.8]">
        Reach out to choose your membership and we'll get you set up. Not sure which fits? We'll help you decide based on your goals.
      </p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="/contact" class="btn-gold">Become a Member</a>
        <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn-outline-gold">Book a Treatment</a>
      </div>
    </div>
  </section>
</BaseLayout>
