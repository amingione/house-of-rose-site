---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sanityFetch } from '@/lib/sanity';
import { sbObjectId } from '@/lib/visualEditing';
import {
  ALL_COMPARISON_SLUGS_QUERY,
  COMPARISON_BY_SLUG_QUERY,
  type Comparison,
} from '@/lib/queries';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import { breadcrumbList, article, faqPage } from '@/lib/structuredData';
import {
  getPublicComparisonContent,
  isReviewedPublicComparisonSlug,
} from '@/lib/publicComparisonContent';
import { getComparisonServiceSlugs, getPublicServiceBySlug } from '@/lib/serviceCatalog';
import ContextualText from '@/components/ContextualText.astro';
import { contextualizeText, serviceContextualLink } from '@/lib/contextualLinks';

export async function getStaticPaths() {
  const slugs = await sanityFetch<{ slug: string }[]>(ALL_COMPARISON_SLUGS_QUERY);
  return slugs
    .filter(({ slug }) => isReviewedPublicComparisonSlug(slug))
    .map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const cmpData = await sanityFetch<Comparison>(COMPARISON_BY_SLUG_QUERY, { slug });
// Never `return Astro.redirect()` from a prerendered route (breaks the static build). Slugs
// come from getStaticPaths, so a miss is a data bug — fail loudly.
if (!cmpData) throw new Error(`[compare/[slug]] No comparison found in Sanity for slug "${slug}"`);
const localOptionSlugs = getComparisonServiceSlugs(cmpData.slug);
const cmp: Comparison = {
  ...cmpData,
  optionA: {
    ...cmpData.optionA,
    service: cmpData.optionA?.serviceSlug || localOptionSlugs[0]
      ? getPublicServiceBySlug(cmpData.optionA?.serviceSlug ?? localOptionSlugs[0])
      : undefined,
  },
  optionB: {
    ...cmpData.optionB,
    service: cmpData.optionB?.serviceSlug || localOptionSlugs[1]
      ? getPublicServiceBySlug(cmpData.optionB?.serviceSlug ?? localOptionSlugs[1])
      : undefined,
  },
};
const publicContent = getPublicComparisonContent(cmp.slug);
if (!publicContent) {
  throw new Error(`[compare/[slug]] Comparison "${cmp.slug}" has no reviewed public content`);
}
const publicTitle = publicContent.title;

const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonical = new URL(Astro.url.pathname, site).toString();

const breadcrumb = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'Compare', item: `${site}compare/` },
  { name: publicTitle, item: canonical },
]);
const a = cmp.optionA;
const b = cmp.optionB;
const comparisonServiceLinks = [a?.service, b?.service]
  .filter((service) => Boolean(service))
  .map((service) => serviceContextualLink(service!));
const usedServiceHrefs = new Set<string>();
const comparisonText = (text: string) => contextualizeText(text, comparisonServiceLinks, {
  currentPath: Astro.url.pathname,
  maxLinks: Math.max(0, 4 - usedServiceHrefs.size),
  usedHrefs: usedServiceHrefs,
});
const leadSegments = comparisonText(publicContent.lead);
const distinctionSegments = comparisonText(publicContent.distinction);
const sharedSegments = comparisonText(publicContent.shared);
const optionOverviewSegments = {
  optionA: publicContent.optionAOverview ? comparisonText(publicContent.optionAOverview) : [],
  optionB: publicContent.optionBOverview ? comparisonText(publicContent.optionBOverview) : [],
};
const sharedOptionService = a?.service && b?.service && a.service._id === b.service._id
  ? a.service
  : null;
const articleDescription = publicContent.metaDescription;
const articleSchema = article(
  { headline: publicTitle, description: articleDescription, url: canonical, dateModified: cmp._updatedAt },
  site,
);
const publicFaqs = publicContent.faqs ?? [];
const faqSchema = faqPage(publicFaqs);

const comparisonRows = publicContent.rows;
const pageTitle = `${publicTitle} | House of Rose`;
const pageDescription = articleDescription;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <SchemaMarkup item={breadcrumb} slot="head" />
  <SchemaMarkup item={articleSchema} slot="head" />
  {faqSchema && <SchemaMarkup item={faqSchema} slot="head" />}

  <div {...sbObjectId(cmp._id)}>
  <section class="bg-charcoal pt-32 pb-12 px-6">
    <div class="max-w-[960px] mx-auto">
      <span class="kicker">Comparison</span>
      <h1 class="font-serif text-[clamp(30px,5vw,52px)] text-ink leading-tight mt-3 mb-6">{publicTitle}</h1>
      <p class="text-ink/85 text-[17px] leading-relaxed max-w-[760px]">
        <ContextualText segments={leadSegments} />
        {' '}See <a href="/compare/" class="font-medium text-ink underline decoration-gold-metal/50 underline-offset-4 hover:text-gold">all treatment comparisons</a> for the other reviewed pairs.
      </p>
    </div>
  </section>

  <section class="bg-charcoal-light px-6 py-14">
      <div class="mx-auto grid max-w-[960px] gap-px bg-gold-metal/15 md:grid-cols-2">
        <article class="bg-charcoal p-8 sm:p-10">
          <span class="kicker">The main difference</span>
          <h2 class="mt-3 font-serif text-[clamp(24px,3vw,34px)] leading-tight text-ink">{publicContent.distinctionHeading}</h2>
          <p class="mt-5 text-[15px] leading-7 text-muted"><ContextualText segments={distinctionSegments} /></p>
        </article>
        <article class="bg-charcoal p-8 sm:p-10">
          <span class="kicker">What still matters</span>
          <h2 class="mt-3 font-serif text-[clamp(24px,3vw,34px)] leading-tight text-ink">{publicContent.sharedHeading}</h2>
          <p class="mt-5 text-[15px] leading-7 text-muted"><ContextualText segments={sharedSegments} /></p>
        </article>
      </div>
  </section>

  {(a || b) && (
    <section class="bg-charcoal-light py-14 px-6">
      <div class="max-w-[960px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-px bg-gold-metal/10">
        {([
          ['optionA', a, publicContent.optionALabel, publicContent.optionAOverview],
          ['optionB', b, publicContent.optionBLabel, publicContent.optionBOverview],
        ] as const).filter(([, opt]) => opt).map(([key, opt, label, overview]) => (
          <div class="bg-charcoal p-8">
            <h2 class="font-serif text-[24px] text-gold mb-3">{label}</h2>
            {overview && <p class="text-[14px] leading-6 text-muted"><ContextualText segments={optionOverviewSegments[key]} /></p>}
            {opt!.service && !sharedOptionService && (
              <a href={`/services/${opt!.service.slug}/`} class="learn-more mt-3 inline-flex">Learn about {opt!.service.title}</a>
            )}
          </div>
        ))}
      </div>
      {sharedOptionService && (
        <div class="mx-auto mt-8 flex max-w-[960px] flex-wrap items-center gap-4 border-t border-gold-metal/10 pt-7">
          <p class="mr-auto max-w-[520px] text-[14px] leading-6 text-muted">
            Both products are available through the {sharedOptionService.title} service.
          </p>
          <a href={`/services/${sharedOptionService.slug}/`} class="learn-more">Review {sharedOptionService.title}</a>
        </div>
      )}
    </section>
  )}

  {comparisonRows.length > 0 && (
    <section class="bg-charcoal py-14 px-6">
      <div
        class="mx-auto max-w-[960px] overflow-x-auto focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold"
        tabindex="0"
      >
        <h2 id="comparison-table-heading" class="sr-only">Side-by-side comparison</h2>
        <table class="w-full border-collapse text-left" aria-labelledby="comparison-table-heading">
          <thead>
            <tr class="border-b border-gold-metal/20">
              <th scope="col" class="py-4 pr-4 text-[11px] tracking-[0.2em] uppercase text-ink/75 font-normal"><span class="sr-only">Comparison point</span></th>
              <th scope="col" class="py-4 px-4 text-[13px] tracking-[0.08em] text-gold font-medium">{publicContent.optionALabel}</th>
              <th scope="col" class="py-4 px-4 text-[13px] tracking-[0.08em] text-gold font-medium">{publicContent.optionBLabel}</th>
            </tr>
          </thead>
          <tbody>
            {comparisonRows.map((row) => (
              <tr class="border-b border-ink/5">
                <th scope="row" class="py-4 pr-4 text-ink/70 text-[14px] font-medium">{row.attribute}</th>
                <td class="py-4 px-4 text-muted text-[14px]">{row.valueA}</td>
                <td class="py-4 px-4 text-muted text-[14px]">{row.valueB}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="mt-6 text-[12px] leading-relaxed text-muted">Individual outcomes vary.</p>
      </div>
    </section>
  )}

  {publicContent.sources && publicContent.sources.length > 0 && (
    <section class="border-t border-gold-metal/10 bg-charcoal-light px-6 py-14">
      <div class="mx-auto max-w-[960px]">
        <span class="kicker">Sources &amp; limits</span>
        <h2 class="mt-3 max-w-[720px] font-serif text-[clamp(26px,4vw,38px)] leading-tight text-ink">
          Where these numbers come from.
        </h2>
        <p class="mt-5 max-w-[760px] text-[15px] leading-7 text-muted">
          The duration figures come from separate studies with different products and study designs. They are not a dose-conversion table, a direct head-to-head trial, or a promise about an individual result.
        </p>
        <ul class="mt-9 divide-y divide-gold-metal/10 border-y border-gold-metal/10">
          {publicContent.sources.map((source) => (
            <li class="py-5">
              <a href={source.url} target="_blank" rel="noopener noreferrer" class="font-semibold text-ink underline decoration-gold-metal/50 underline-offset-4 hover:text-gold">
                {source.title}
              </a>
              <p class="mt-2 text-[13px] leading-6 text-muted">{source.note}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {publicFaqs.length > 0 && (
    <section class="border-t border-gold-metal/10 bg-charcoal px-6 py-14">
      <div class="mx-auto max-w-[960px]">
        <span class="kicker">Questions</span>
        <h2 class="mt-3 max-w-[720px] font-serif text-[clamp(26px,4vw,38px)] leading-tight text-ink">
          What people ask about these two options.
        </h2>
        <div class="mt-9 divide-y divide-gold-metal/10 border-y border-gold-metal/10">
          {publicFaqs.map((faq) => (
            <article class="py-6">
              <h3 class="font-serif text-[clamp(20px,3vw,26px)] leading-tight text-ink">{faq.question}</h3>
              <p class="mt-3 max-w-[780px] text-[14px] leading-7 text-muted">{faq.answer}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="bg-charcoal-light py-12 px-6 border-t border-gold-metal/10">
    <div class="max-w-[860px] mx-auto text-center">
      <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ink leading-tight mb-6">Ask a question about either service.</h2>
      <p class="text-muted text-[15px] max-w-[520px] mx-auto mb-8">Call or send the two treatment names to House of Rose.</p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="tel:+19414000165" class="btn-outline-ink">(941) 400-0165</a>
        <a href="/contact/" class="btn-gold">Contact House of Rose</a>
      </div>
    </div>
  </section>
  </div>
</BaseLayout>
