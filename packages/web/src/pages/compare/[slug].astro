---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sanityFetch } from '@/lib/sanity';
import { sbObjectId, sbFieldPath, sbFieldPathParts } from '@/lib/visualEditing';
import {
  ALL_COMPARISON_SLUGS_QUERY,
  COMPARISON_BY_SLUG_QUERY,
  type Comparison,
} from '@/lib/queries';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import BookingLink from '@/components/BookingLink.astro';
import { breadcrumbList, faqPage, article } from '@/lib/structuredData';
import { alignPublicContent } from '@/lib/publicCopy';

export async function getStaticPaths() {
  const slugs = await sanityFetch<{ slug: string }[]>(ALL_COMPARISON_SLUGS_QUERY);
  return slugs.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const cmpData = await sanityFetch<Comparison>(COMPARISON_BY_SLUG_QUERY, { slug });
// Never `return Astro.redirect()` from a prerendered route (breaks the static build). Slugs
// come from getStaticPaths, so a miss is a data bug — fail loudly.
if (!cmpData) throw new Error(`[compare/[slug]] No comparison found in Sanity for slug "${slug}"`);
const cmp = alignPublicContent(cmpData);

const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonical = new URL(Astro.url.pathname, site).toString();

const breadcrumb = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'Compare', item: `${site}compare/` },
  { name: cmp.title, item: canonical },
]);
const faq = faqPage(cmp.faqs ?? []);
const articleSchema = article(
  { headline: cmp.title, description: cmp.intro, url: canonical, dateModified: cmp._updatedAt },
  site,
);

const a = cmp.optionA;
const b = cmp.optionB;
const pageTitle = cmp.seo?.metaTitle ?? `${cmp.title} | House of Rose`;
const pageDescription = cmp.seo?.metaDescription ?? cmp.intro;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <SchemaMarkup item={breadcrumb} slot="head" />
  <SchemaMarkup item={articleSchema} slot="head" />
  {faq && <SchemaMarkup item={faq} slot="head" />}

  <div {...sbObjectId(cmp._id)}>
  <section class="bg-charcoal pt-32 pb-12 px-6">
    <div class="max-w-[960px] mx-auto">
      <span class="kicker">Comparison</span>
      <h1 class="font-serif text-[clamp(30px,5vw,52px)] text-ink leading-tight mt-3 mb-6" {...sbFieldPath('title')}>{cmp.title}</h1>
      <p class="text-ink/85 text-[17px] leading-relaxed" {...sbFieldPath('intro')}>{cmp.intro}</p>
    </div>
  </section>

  {(a || b) && (
    <section class="bg-charcoal-light py-14 px-6">
      <div class="max-w-[960px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-px bg-gold-metal/10">
        {([['optionA', a], ['optionB', b]] as const).filter(([, opt]) => opt).map(([key, opt]) => (
          <div class="bg-charcoal p-8">
            <h2 class="font-serif text-[24px] text-gold mb-3" {...sbFieldPath(`${key}.label`)}>{opt!.label}</h2>
            {opt!.summary && <p class="text-ink/80 text-[15px] leading-relaxed mb-4" {...sbFieldPath(`${key}.summary`)}>{opt!.summary}</p>}
            {opt!.bestFor && (
              <p class="text-muted text-[14px] leading-relaxed"><span class="text-ink/70">Best for:</span> <span {...sbFieldPath(`${key}.bestFor`)}>{opt!.bestFor}</span></p>
            )}
            {opt!.service && (
              <div class="mt-5 flex flex-wrap items-center gap-4">
                <a href={`/services/${opt!.service.slug}/`} class="learn-more">Learn about {opt!.service.title}</a>
                <BookingLink
                  slug={opt!.service.slug}
                  bookingMode={opt!.service.bookingMode}
                  bookingUrl={opt!.service.bookingUrl}
                  location="comparison_option"
                  class="service-booking-link"
                />
              </div>
            )}
          </div>
        ))}
      </div>
    </section>
  )}

  {cmp.rows && cmp.rows.length > 0 && (
    <section class="bg-charcoal py-14 px-6">
      <div class="max-w-[960px] mx-auto overflow-x-auto">
        <table class="w-full border-collapse text-left">
          <thead>
            <tr class="border-b border-gold-metal/20">
              <th class="py-4 pr-4 text-[11px] tracking-[0.2em] uppercase text-ink/75 font-normal"></th>
              <th class="py-4 px-4 text-[13px] tracking-[0.08em] text-gold font-medium">{a?.label ?? 'Option A'}</th>
              <th class="py-4 px-4 text-[13px] tracking-[0.08em] text-gold font-medium">{b?.label ?? 'Option B'}</th>
            </tr>
          </thead>
          <tbody>
            {cmp.rows.map((row, i) => (
              <tr class="border-b border-ink/5">
                <td class="py-4 pr-4 text-ink/70 text-[14px] font-medium" {...sbFieldPathParts('rows', i, 'attribute')}>{row.attribute}</td>
                <td class="py-4 px-4 text-muted text-[14px]" {...sbFieldPathParts('rows', i, 'valueA')}>{row.valueA}</td>
                <td class="py-4 px-4 text-muted text-[14px]" {...sbFieldPathParts('rows', i, 'valueB')}>{row.valueB}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {cmp.verdict && (
    <section class="bg-charcoal-light py-14 px-6">
      <div class="max-w-[860px] mx-auto">
        <span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-4">The Verdict</span>
        <p class="text-ink/85 text-[16px] leading-relaxed whitespace-pre-line" {...sbFieldPath('verdict')}>{cmp.verdict}</p>
      </div>
    </section>
  )}

  {cmp.faqs && cmp.faqs.length > 0 && (
    <section class="bg-charcoal py-14 px-6">
      <div class="max-w-[860px] mx-auto">
        <span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-8 text-center">Common Questions</span>
        <div class="space-y-6">
          {cmp.faqs.map((f, i) => (
            <div class="border-b border-ink/5 pb-6">
              <h2 class="text-ink text-[17px] font-medium mb-3" {...sbFieldPathParts('faqs', i, 'question')}>{f.question}</h2>
              <p class="text-muted text-[14px] leading-relaxed" {...sbFieldPathParts('faqs', i, 'answer')}>{f.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="bg-charcoal-light py-12 px-6 border-t border-gold-metal/10">
    <div class="max-w-[860px] mx-auto text-center">
      <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ink leading-tight mb-6">Not sure which is right for you?</h2>
      <p class="text-muted text-[15px] max-w-[440px] mx-auto mb-8">A consultation gives you space to review your goals, ask questions, and understand which options may be appropriate.</p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="tel:+18449417673" class="btn-outline-gold">(844) 941-7673</a>
        <a href="/consultation/" class="btn-gold">Request a Consultation</a>
      </div>
    </div>
  </section>
  </div>
</BaseLayout>
