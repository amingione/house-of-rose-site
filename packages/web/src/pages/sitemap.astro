---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sanityFetch } from '@/lib/sanity';
import {
  ALL_BLOG_POSTS_QUERY,
  ALL_CONCERNS_QUERY,
  ALL_COST_GUIDES_QUERY,
  ALL_COMPARISONS_QUERY,
  ALL_LOCAL_AREAS_QUERY,
  ALL_CASE_STUDIES_QUERY,
  ALL_TREATMENT_PACKAGES_QUERY,
  PUBLIC_PROVIDERS_QUERY,
  type BlogPost,
  type Concern,
  type CostGuide,
  type Comparison,
  type LocalArea,
  type CaseStudy,
  type TreatmentPackage,
  type PublicProviderProfile,
} from '@/lib/queries';
import { PUBLIC_SITEMAP_SERVICES, getPublicCollections } from '@/lib/serviceCatalog';
import { IV_DRIPS, ivDripPath } from '@/lib/ivDripContent';
import { getPublicServiceBySlug } from '@/lib/serviceCatalog';
import { resolvePublicProviderProfiles } from '@/lib/aboutFallbacks';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import { breadcrumbList } from '@/lib/structuredData';
import { SHOP_ENABLED } from '@/lib/features';
import {
  filterReviewedPublicComparisons,
  getPublicComparisonContent,
} from '@/lib/publicComparisonContent';
import { isReviewedPublicBlogSlug } from '@/lib/publicBlogContent';

interface SitemapLink {
  title: string;
  href: string;
  note?: string;
}

interface SitemapSection {
  title: string;
  links: SitemapLink[];
}

const [
  blogPosts,
  concerns,
  costGuides,
  comparisons,
  localAreas,
  caseStudies,
  packages,
  sanityProviders,
] = await Promise.all([
  sanityFetch<BlogPost[]>(ALL_BLOG_POSTS_QUERY),
  sanityFetch<Concern[]>(ALL_CONCERNS_QUERY),
  sanityFetch<CostGuide[]>(ALL_COST_GUIDES_QUERY),
  sanityFetch<Comparison[]>(ALL_COMPARISONS_QUERY),
  sanityFetch<LocalArea[]>(ALL_LOCAL_AREAS_QUERY),
  sanityFetch<CaseStudy[]>(ALL_CASE_STUDIES_QUERY),
  sanityFetch<TreatmentPackage[]>(ALL_TREATMENT_PACKAGES_QUERY),
  sanityFetch<PublicProviderProfile[]>(PUBLIC_PROVIDERS_QUERY),
]);
const services = [...PUBLIC_SITEMAP_SERVICES];
const collections = getPublicCollections();
const publicCaseStudies = caseStudies.map((study) => ({
  ...study,
  treatment: study.treatmentSlug ? getPublicServiceBySlug(study.treatmentSlug) : undefined,
}));
const providers = resolvePublicProviderProfiles(sanityProviders);
const publicComparisons = filterReviewedPublicComparisons(comparisons);
const publicBlogPosts = blogPosts.filter((post) => isReviewedPublicBlogSlug(post.slug));

const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonical = new URL(Astro.url.pathname, site).toString();

const breadcrumb = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'Sitemap', item: canonical },
]);

const corePages: SitemapLink[] = [
  { title: 'Home', href: '/' },
  { title: 'About', href: '/about/' },
  { title: 'House of Rose Aesthetics', href: '/about/hra/' },
  { title: 'Providers', href: '/about/providers/' },
  { title: 'Services', href: '/services/' },
  { title: 'Consultation', href: '/consultation/' },
  { title: 'Treatment Categories', href: '/services/collections/' },
  { title: 'Treatment Series & Packages', href: '/packages/' },
  { title: 'Advanced Skin Imaging & Analysis', href: '/skin-analysis/' },
  ...(SHOP_ENABLED
    ? [
        { title: 'Shop', href: '/shop/' },
        { title: 'Jane Iredale Products', href: '/shop/jane-iredale/' },
      ]
    : []),
  { title: 'Experience', href: '/experience/' },
  { title: 'Journal', href: '/blog/' },
  { title: 'FAQ', href: '/faq/' },
  { title: 'Support', href: '/support/' },
  { title: 'Areas We Serve', href: '/areas/' },
  ...(publicCaseStudies.length > 0 ? [{ title: 'Results', href: '/results/' }] : []),
  { title: 'Contact', href: '/contact/' },
  { title: 'Rent a Suite', href: '/rent-a-room/' },
];

const servicePages = services.flatMap((service) => [
  {
    title: service.title,
    href: `/services/${service.slug}/`,
    note: service.parentService?.title,
  },
  ...(service.slug === 'iv-hydration-therapy'
    ? IV_DRIPS.map((drip) => ({ title: drip.name, href: ivDripPath(drip.slug), note: 'IV Hydration Therapy' }))
    : []),
]);

const sectionData: SitemapSection[] = [
  { title: 'House of Rose', links: corePages },
  {
    title: 'The Team',
    links: providers.map((provider) => ({
      title: provider.publicName,
      href: `/about/providers/${provider.slug}/`,
      note: provider.publicRole,
    })),
  },
  {
    title: 'Treatments',
    links: servicePages,
  },
  {
    title: 'Treatment Categories',
    links: collections.map((collection) => ({
      title: collection.title,
      href: `/services/collections/${collection.slug}/`,
      note: 'Category',
    })),
  },
  {
    title: 'Concerns',
    links: concerns.map((concern) => ({
      title: concern.title,
      href: `/concerns/${concern.slug}/`,
    })),
  },
  {
    title: 'Packages',
    links: packages.map((pkg) => ({
      title: pkg.title,
      href: `/packages/${pkg.slug}/`,
    })),
  },
  {
    title: 'Treatment Cost',
    links: costGuides.map((guide) => ({
      title: guide.title,
      href: `/cost/${guide.slug}/`,
    })),
  },
  {
    title: 'Comparisons',
    links: publicComparisons.map((comparison) => ({
      title: getPublicComparisonContent(comparison.slug)!.title,
      href: `/compare/${comparison.slug}/`,
    })),
  },
  {
    title: 'Areas Served',
    links: localAreas.map((area) => ({
      title: area.city,
      href: `/areas/${area.slug}/`,
    })),
  },
  {
    title: 'Results',
    links: publicCaseStudies.map((study) => ({
      title: study.title,
      href: `/results/${study.slug}/`,
      note: study.treatment?.title,
    })),
  },
  {
    title: 'Treatment Journal',
    links: publicBlogPosts.map((post) => ({
      title: post.slug === 'is-morpheus8-safe'
        ? 'Is Morpheus8 Safe? What to Ask Before Treatment'
        : post.title,
      href: `/blog/${post.slug}/`,
    })),
  },
  {
    title: 'Policies & Help',
    links: [
      { title: 'Privacy Policy', href: '/privacy-policy/' },
      { title: 'Terms of Service', href: '/terms-of-service/' },
      { title: 'Shipping Policy', href: '/shipping-policy/' },
      { title: 'Return Policy', href: '/return-policy/' },
    ],
  },
].filter((section) => section.links.length > 0);
---

<BaseLayout
  title="Sitemap | House of Rose Aesthetics"
  description="Find House of Rose treatments, providers, programs, cost information, locations, policies, and contact details in Punta Gorda."
>
  <SchemaMarkup item={breadcrumb} slot="head" />

  <section class="bg-charcoal pt-32 pb-12 px-6">
    <div class="max-w-[1280px] mx-auto">
      <span class="kicker">Sitemap</span>
      <h1 class="font-serif text-[clamp(32px,5vw,54px)] text-ink leading-tight mt-3 mb-5">
        Explore House of Rose
      </h1>
      <p class="text-ink/75 text-[16px] leading-relaxed max-w-[680px]">
        Find treatments, providers, programs, cost information, locations, policies, and contact details.
      </p>
    </div>
  </section>

  <section class="bg-charcoal-light py-[clamp(48px,7vw,88px)] px-6">
    <div class="max-w-[1280px] mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-gold-metal/10">
      {sectionData.map((section) => (
        <section class="bg-charcoal p-7">
          <h2 class="font-serif text-[24px] text-ink mb-5">{section.title}</h2>
          <ul class="space-y-1.5">
            {section.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="group min-h-[38px] flex items-start justify-between gap-4 py-1.5 text-muted hover:text-gold transition-colors"
                >
                  <span class="text-[14px] leading-relaxed">{link.title}</span>
                  {link.note && (
                    <span class="text-muted text-[11px] tracking-[0.16em] uppercase leading-relaxed group-hover:text-gold">
                      {link.note}
                    </span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
