---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sanityFetch } from '@/lib/sanity';
import {
  ALL_SITEMAP_SERVICES_QUERY,
  ALL_BLOG_POSTS_QUERY,
  ALL_COLLECTIONS_QUERY,
  ALL_CONCERNS_QUERY,
  ALL_COST_GUIDES_QUERY,
  ALL_COMPARISONS_QUERY,
  ALL_LOCAL_AREAS_QUERY,
  ALL_CASE_STUDIES_QUERY,
  ALL_TREATMENT_PACKAGES_QUERY,
  PUBLIC_PROVIDERS_QUERY,
  type SitemapService,
  type BlogPost,
  type ServiceCollection,
  type Concern,
  type CostGuide,
  type Comparison,
  type LocalArea,
  type CaseStudy,
  type TreatmentPackage,
  type PublicProviderProfile,
} from '@/lib/queries';
import { PROVIDER_PROFILE_FALLBACKS } from '@/lib/aboutFallbacks';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import { breadcrumbList } from '@/lib/structuredData';

interface SitemapLink {
  title: string;
  href: string;
  note?: string;
}

interface SitemapSection {
  title: string;
  links: SitemapLink[];
}

const [
  services,
  blogPosts,
  collections,
  concerns,
  costGuides,
  comparisons,
  localAreas,
  caseStudies,
  packages,
  sanityProviders,
] = await Promise.all([
  sanityFetch<SitemapService[]>(ALL_SITEMAP_SERVICES_QUERY),
  sanityFetch<BlogPost[]>(ALL_BLOG_POSTS_QUERY),
  sanityFetch<ServiceCollection[]>(ALL_COLLECTIONS_QUERY),
  sanityFetch<Concern[]>(ALL_CONCERNS_QUERY),
  sanityFetch<CostGuide[]>(ALL_COST_GUIDES_QUERY),
  sanityFetch<Comparison[]>(ALL_COMPARISONS_QUERY),
  sanityFetch<LocalArea[]>(ALL_LOCAL_AREAS_QUERY),
  sanityFetch<CaseStudy[]>(ALL_CASE_STUDIES_QUERY),
  sanityFetch<TreatmentPackage[]>(ALL_TREATMENT_PACKAGES_QUERY),
  sanityFetch<PublicProviderProfile[]>(PUBLIC_PROVIDERS_QUERY),
]);
const providers = sanityProviders.length > 0 ? sanityProviders : PROVIDER_PROFILE_FALLBACKS;

const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonical = new URL(Astro.url.pathname, site).toString();

const breadcrumb = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'Sitemap', item: canonical },
]);

const corePages: SitemapLink[] = [
  { title: 'Home', href: '/' },
  { title: 'About', href: '/about/' },
  { title: 'House of Rose Aesthetics', href: '/about/hra/' },
  { title: 'Providers', href: '/about/providers/' },
  { title: 'Services', href: '/services/' },
  {
    title: 'Consultation',
    href: '/consultation/',
    note: 'Advanced aesthetics & wellness',
  },
  { title: 'Service Collections', href: '/services/collections/' },
  { title: 'Treatment Series & Packages', href: '/packages/' },
  { title: 'Advanced Skin Imaging & Analysis', href: '/skin-analysis/' },
  { title: 'Shop', href: '/shop/' },
  { title: 'Jane Iredale Products', href: '/shop/jane-iredale/' },
  { title: 'Experience', href: '/experience/' },
  { title: 'Journal', href: '/blog/' },
  { title: 'FAQ', href: '/faq/' },
  { title: 'Areas We Serve', href: '/areas/' },
  { title: 'Results', href: '/results/' },
  { title: 'Contact', href: '/contact/' },
  { title: 'Rent a Suite', href: '/rent-a-room/' },
];

const servicePages = services.map((service) => ({
  title: service.title,
  href: `/services/${service.slug}/`,
  note: service.parentService?.title,
}));

const sectionData: SitemapSection[] = [
  { title: 'Main Pages', links: corePages },
  {
    title: 'Provider Profiles',
    links: providers.map((provider) => ({
      title: provider.publicName,
      href: `/about/providers/${provider.slug}/`,
      note: provider.publicRole,
    })),
  },
  {
    title: 'Services',
    links: servicePages,
  },
  {
    title: 'Service Collections',
    links: collections.map((collection) => ({
      title: collection.title,
      href: `/services/collections/${collection.slug}/`,
    })),
  },
  {
    title: 'Concerns',
    links: concerns.map((concern) => ({
      title: concern.title,
      href: `/concerns/${concern.slug}/`,
    })),
  },
  {
    title: 'Packages',
    links: packages.map((pkg) => ({
      title: pkg.title,
      href: `/packages/${pkg.slug}/`,
    })),
  },
  {
    title: 'Cost Guides',
    links: costGuides.map((guide) => ({
      title: guide.title,
      href: `/cost/${guide.slug}/`,
    })),
  },
  {
    title: 'Comparisons',
    links: comparisons.map((comparison) => ({
      title: comparison.title,
      href: `/compare/${comparison.slug}/`,
    })),
  },
  {
    title: 'Areas',
    links: localAreas.map((area) => ({
      title: area.title,
      href: `/areas/${area.slug}/`,
    })),
  },
  {
    title: 'Results',
    links: caseStudies.map((study) => ({
      title: study.title,
      href: `/results/${study.slug}/`,
      note: study.treatment?.title,
    })),
  },
  {
    title: 'Journal Articles',
    links: blogPosts.map((post) => ({
      title: post.title,
      href: `/blog/${post.slug}/`,
    })),
  },
  {
    title: 'Site Utilities',
    links: [
      { title: 'HTML Sitemap', href: '/sitemap/' },
      { title: 'XML Sitemap', href: '/sitemap.xml' },
      { title: 'Privacy Policy', href: '/privacy-policy/' },
      { title: 'Terms of Service', href: '/terms-of-service/' },
      { title: 'Shipping Policy', href: '/shipping-policy/' },
      { title: 'Return Policy', href: '/return-policy/' },
    ],
  },
].filter((section) => section.links.length > 0);
---

<BaseLayout
  title="Sitemap | House of Rose Aesthetics"
  description="HTML sitemap for House of Rose Aesthetics in Punta Gorda, FL, with links to services, treatment packages, concerns, guides, locations, results, and site resources."
>
  <SchemaMarkup item={breadcrumb} slot="head" />

  <section class="bg-charcoal pt-32 pb-12 px-6">
    <div class="max-w-[1280px] mx-auto">
      <span class="kicker">Sitemap</span>
      <h1 class="font-serif text-[clamp(32px,5vw,54px)] text-ink leading-tight mt-3 mb-5">
        Explore House of Rose
      </h1>
      <p class="text-ink/75 text-[16px] leading-relaxed max-w-[680px]">
        A complete HTML index of public House of Rose pages for clients, search crawlers, and answer engines.
      </p>
    </div>
  </section>

  <section class="bg-charcoal-light py-[clamp(48px,7vw,88px)] px-6">
    <div class="max-w-[1280px] mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-gold-metal/10">
      {sectionData.map((section) => (
        <section class="bg-charcoal p-7">
          <h2 class="font-serif text-[24px] text-ink mb-5">{section.title}</h2>
          <ul class="space-y-1.5">
            {section.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="group min-h-[38px] flex items-start justify-between gap-4 py-1.5 text-muted hover:text-gold transition-colors"
                >
                  <span class="text-[14px] leading-relaxed">{link.title}</span>
                  {link.note && (
                    <span class="text-muted text-[11px] tracking-[0.16em] uppercase leading-relaxed group-hover:text-gold">
                      {link.note}
                    </span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
