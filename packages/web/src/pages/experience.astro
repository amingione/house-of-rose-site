---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import { sanityFetch, urlFor } from '@/lib/sanity';
import { sbObjectId, sbFieldPath } from '@/lib/visualEditing';
import { EXPERIENCE_CONTENT_QUERY, type ExperienceContent } from '@/lib/queries';

const experienceContent = await sanityFetch<ExperienceContent>(EXPERIENCE_CONTENT_QUERY);
const heroImage = '/images/optimized/actual-welcome-800.webp';
const heroImageSrcset = '/images/optimized/actual-welcome-800.webp 800w, /images/optimized/actual-welcome-1400.webp 1400w';
const storyImage = experienceContent?.storyImage;
const storyImageSrc = storyImage
  ? urlFor(storyImage).width(900).format('webp').quality(82).url()
  : '/images/optimized/actual-reception-1400-light.webp';
const storyImageWidth = storyImage ? 900 : 1400;
const storyImageHeight = storyImage
  ? Math.round(900 / storyImage.asset.metadata.dimensions.width * storyImage.asset.metadata.dimensions.height)
  : 1050;

---

<BaseLayout
  title="Inside House of Rose | Medical Aesthetics Practice"
  description="See the actual House of Rose spaces in Punta Gorda and review appointment, walk-in, and consultation information."
  preloadImage={heroImage}
  preloadImageSrcset={heroImageSrcset}
  preloadImageSizes="100vw"
>
  <!-- Hero -->
  <Hero
    title="Inside House of Rose."
    kicker="The practice"
    description="Actual rooms and practical appointment information from the Punta Gorda practice."
    size="small"
    backgroundImage={heroImage}
    backgroundSrcset={heroImageSrcset}
    backgroundSizes="100vw"
    backgroundWidth={1400}
    backgroundHeight={1050}
    imageAlt="The House of Rose Aesthetics reception and waiting area"
  />

  <!-- Story Section -->
  <section
    class="bg-charcoal grid grid-cols-1 md:grid-cols-2"
    {...(experienceContent?._id ? sbObjectId(experienceContent._id) : {})}
  >
    <div class="p-[clamp(38px,6vw,76px)]">
      <span class="kicker">The practice</span>
      <h2 class="font-serif text-[clamp(22px,3vw,33px)] text-ink leading-tight mb-5">
        525 E Olympia Avenue, Unit 9.
      </h2>
      <p class="text-muted text-[15px] leading-relaxed">
        The photographs show the reception and treatment spaces as they are.
      </p>
    </div>
    <div class="relative min-h-[330px] bg-charcoal-lighter">
      <img
        src={storyImageSrc}
        alt={storyImage?.alt ?? 'The reception and waiting area inside House of Rose Aesthetics'}
        class="w-full h-full object-cover"
        width={storyImageWidth}
        height={storyImageHeight}
        loading="lazy"
        {...(experienceContent?._id ? sbFieldPath('storyImage') : {})}
      />
    </div>
  </section>

  <!-- Appointment information -->
  <section class="bg-charcoal-light py-[clamp(56px,8vw,88px)] px-6">
    <div class="mx-auto max-w-[1120px]">
      <span class="kicker">Appointments</span>
      <h2 class="mt-2 font-serif text-[clamp(30px,4vw,44px)] text-ink">
        Before you arrive.
      </h2>
      <div class="mt-10 grid border-y border-walnut/15 md:grid-cols-2">
        <article class="py-8 md:pr-10">
          <h3 class="font-serif text-[26px] text-ink">Booking</h3>
          <p class="mt-4 max-w-[500px] text-[15px] leading-[1.75] text-muted">
              Appointments reserve a specific time. Call to ask about same-day availability for waxing and facials.
          </p>
        </article>
        <article class="border-t border-walnut/15 py-8 md:border-l md:border-t-0 md:pl-10">
          <h3 class="font-serif text-[26px] text-ink">Consultations</h3>
          <p class="mt-4 max-w-[500px] text-[15px] leading-[1.75] text-muted">
            Bring the treatment or concern you want to discuss, along with anything you do not want changed. Ask about options, limits, and recovery before deciding.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section id="book" class="bg-charcoal-light py-[clamp(56px,8vw,88px)] px-6 border-t border-gold-metal/10">
    <div class="max-w-[680px] mx-auto text-center">
      <span class="kicker">Visit House of Rose</span>
      <h2 class="font-serif text-[clamp(28px,5vw,44px)] text-ink leading-tight mb-4">
        Book online or call House of Rose.
      </h2>
      <p class="text-muted text-[15px] max-w-[450px] mx-auto mb-10 leading-relaxed">
        Call if you want to speak with the practice before choosing a time.
      </p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="tel:+18449417673" class="btn-outline-gold">
          (844) 941-7673
        </a>
        <a href="/services/" class="btn-gold">
          View services
        </a>
      </div>
      <p class="text-muted text-[11px] tracking-[0.26em] uppercase mt-8 leading-relaxed">
        525 E Olympia Ave, Unit 9<br />Punta Gorda, FL 33950
      </p>
    </div>
  </section>
</BaseLayout>
