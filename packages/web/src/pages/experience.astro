---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import { sanityFetch, urlFor } from '@/lib/sanity';
import { sbObjectId, sbFieldPath, sbFieldPathParts } from '@/lib/visualEditing';
import { EXPERIENCE_CONTENT_QUERY, type ExperienceContent } from '@/lib/queries';

const experienceContent = await sanityFetch<ExperienceContent>(EXPERIENCE_CONTENT_QUERY);
---

<BaseLayout
  title="The House of Rose Experience | Advanced Aesthetics, Punta Gorda FL"
  description={experienceContent?.heroSubtitle ?? "A private, unhurried experience for every visit. See what to expect at House of Rose — Punta Gorda's advanced aesthetics destination."}
  preloadImage="/images/hor-lounge.webp"
>
  <!-- Hero -->
  <Hero
    title={experienceContent?.heroTitle ?? "The Experience"}
    kicker="What to Expect"
    description={experienceContent?.heroSubtitle}
    size="small"
    backgroundImage="/images/hor-lounge.webp"
  />

  {experienceContent && (
  <div {...(experienceContent._id ? sbObjectId(experienceContent._id) : {})}>
  <!-- Story Section -->
    <section class="bg-charcoal grid grid-cols-1 md:grid-cols-2">
      <div class="p-[clamp(38px,6vw,76px)]">
        <span class="kicker">Our Story</span>
        <h2 class="font-serif text-[clamp(22px,3vw,33px)] text-ink leading-tight mb-5" {...sbFieldPath('storyHeading')}>
          {experienceContent.storyHeading ?? "Where Beauty Blooms Within."}
        </h2>
        {experienceContent.storyParagraph1 && (
          <p class="text-muted text-[15px] leading-relaxed mb-3" {...sbFieldPath('storyParagraph1')}>
            {experienceContent.storyParagraph1}
          </p>
        )}
        {experienceContent.storyParagraph2 && (
          <p class="text-muted text-[15px] leading-relaxed" {...sbFieldPath('storyParagraph2')}>
            {experienceContent.storyParagraph2}
          </p>
        )}
      </div>
      <div class="relative min-h-[330px] bg-charcoal-lighter">
        <img
          src={experienceContent?.storyImage ? urlFor(experienceContent.storyImage).width(800).height(600).fit('crop').url() : '/images/hor-exterior.webp'}
          alt={experienceContent?.storyImage?.alt ?? 'House of Rose reception desk'}
          class="w-full h-full object-cover"
          width="800"
          height="600"
          loading="lazy"
        />
      </div>
    </section>

  <!-- The House of Rose Standard -->
  {experienceContent.standards && experienceContent.standards.length > 0 && (
    <section class="bg-charcoal-light py-[clamp(56px,8vw,88px)] px-6">
      <div class="max-w-[960px] mx-auto text-center mb-16">
        <span class="kicker">Our Commitment</span>
        <h2 class="font-serif text-[32px] text-ink mt-2">
          The House of Rose Standard
        </h2>
      </div>

      <div class="max-w-[1120px] mx-auto grid grid-cols-1 md:grid-cols-3 gap-12">
        {experienceContent.standards.map((standard, i) => (
          <div class="text-center">
            <p class="text-ink text-[17px] font-medium mb-3 tracking-wide" {...sbFieldPathParts('standards', i, 'title')}>
              {standard.title}
            </p>
            <p class="text-muted text-[14px] leading-relaxed" {...sbFieldPathParts('standards', i, 'description')}>
              {standard.description}
            </p>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Your Guest Journey Timeline -->
  {experienceContent?.journeySteps && experienceContent.journeySteps.length > 0 && (
    <section class="bg-charcoal py-[clamp(56px,8vw,88px)] px-6">
      <div class="max-w-[960px] mx-auto text-center mb-16">
        <span class="kicker">Step by Step</span>
        <h2 class="font-serif text-[32px] text-ink mt-2">
          Your Guest Journey
        </h2>
      </div>

      <div class="max-w-[1120px] mx-auto">
        <div class="relative">
          <!-- Timeline Line - Desktop (centered) -->
          <div class="absolute left-1/2 top-0 bottom-0 w-px bg-gold-metal/20 transform -translate-x-1/2 hidden md:block"></div>

          <!-- Timeline Line - Mobile (left-aligned) -->
          <div class="absolute left-6 top-0 bottom-0 w-px bg-gold-metal/20 md:hidden"></div>

          <!-- Steps -->
          <div class="space-y-16">
            {experienceContent.journeySteps.map((step, index) => (
              <div class={`relative grid grid-cols-1 md:grid-cols-2 gap-8 items-center ${index % 2 === 0 ? '' : 'md:grid-flow-dense'}`}>
                {/* Content */}
                <div class={`pl-16 md:pl-0 ${index % 2 === 0 ? 'md:text-right md:pr-12' : 'md:col-start-2 md:pl-12'}`}>
                  <p class="text-gold text-[48px] font-serif mb-2">
                    {String(step.step).padStart(2, '0')}
                  </p>
                  <h3 class="text-ink text-[22px] font-medium mb-3 tracking-wide" {...sbFieldPathParts('journeySteps', index, 'title')}>
                    {step.title}
                  </h3>
                  <p class="text-muted text-[14px] leading-relaxed" {...sbFieldPathParts('journeySteps', index, 'description')}>
                    {step.description}
                  </p>
                </div>

                {/* Timeline Dot - Desktop (centered) */}
                <div class="hidden md:flex absolute left-1/2 top-0 transform -translate-x-1/2 w-3 h-3 bg-gold-metal rounded-full border-4 border-charcoal z-10"></div>

                {/* Timeline Dot - Mobile (left-aligned) */}
                <div class="flex md:hidden absolute left-6 top-0 transform -translate-x-1/2 w-3 h-3 bg-gold-metal rounded-full border-4 border-charcoal z-10"></div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}
  </div>
  )}

  <!-- Contact CTA -->
  <section id="book" class="bg-charcoal-light py-[clamp(56px,8vw,88px)] px-6 border-t border-gold-metal/10">
    <div class="max-w-[680px] mx-auto text-center">
      <span class="kicker">Reserve Your Experience</span>
      <h2 class="font-serif text-[clamp(28px,5vw,44px)] text-ink leading-tight mb-4">
        Begin Your Transformation
      </h2>
      <p class="text-muted text-[15px] max-w-[450px] mx-auto mb-10 leading-relaxed">
        Every treatment begins with a private consultation. Reach out to schedule yours.
      </p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="tel:+18449417673" class="btn-outline-gold">
          (844) 941-7673
        </a>
        <a href="https://houseofrose.glossgenius.com/services" target="_blank" rel="noopener noreferrer" class="btn-gold">
          Book Online
        </a>
      </div>
      <p class="text-muted text-[11px] tracking-[0.26em] uppercase mt-8 leading-relaxed">
        525 E Olympia Ave, Unit 9<br />Punta Gorda, FL 33950
      </p>
    </div>
  </section>
</BaseLayout>
