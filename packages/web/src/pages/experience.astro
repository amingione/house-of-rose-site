---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';

const heroImage = '/images/optimized/actual-welcome-800.webp';
const heroImageSrcset = '/images/optimized/actual-welcome-800.webp 800w, /images/optimized/actual-welcome-1400.webp 1400w';
---

<BaseLayout
  title="Inside the Practice"
  description="See the actual House of Rose storefront and rooms in Punta Gorda, meet the providers, and find booking and Unit 9 arrival information."
  preloadImage={heroImage}
  preloadImageSrcset={heroImageSrcset}
  preloadImageSizes="100vw"
>
  <!-- Hero -->
  <Hero
    title="Inside House of Rose."
    kicker="The practice"
    description="See the actual storefront, reception, and treatment rooms, meet the providers, and find practical details for booking and arrival."
    size="small"
    backgroundImage={heroImage}
    backgroundSrcset={heroImageSrcset}
    backgroundSizes="100vw"
    backgroundWidth={1400}
    backgroundHeight={1050}
    imageAlt="The House of Rose Aesthetics reception and waiting area"
  />

  <!-- Actual practice photography -->
  <section class="bg-charcoal px-6 py-[clamp(56px,8vw,96px)]">
    <div class="mx-auto max-w-[1280px]">
      <span class="kicker">The practice</span>
      <h2 class="mt-2 font-serif text-[clamp(30px,4vw,44px)] text-ink leading-tight">
        525 E Olympia Avenue, Unit 9.
      </h2>
      <p class="mt-5 max-w-[620px] text-muted text-[15px] leading-relaxed">
        The storefront, IV hydration suite, and treatment room shown here are the actual House of Rose spaces.
      </p>
      <div class="mt-10 grid gap-5 lg:grid-cols-[0.74fr_1.26fr]">
        <figure class="border border-gold-metal/15 bg-charcoal-light">
          <img
            src="/images/optimized/house-of-rose-storefront-700.webp"
            srcset="/images/optimized/house-of-rose-storefront-700.webp 700w, /images/optimized/house-of-rose-storefront-1000.webp 1000w"
            sizes="(max-width: 1023px) 100vw, 37vw"
            alt="The House of Rose Aesthetics storefront at 525 E Olympia Avenue in Punta Gorda"
            width="1000"
            height="1333"
            loading="lazy"
            decoding="async"
            class="aspect-[3/4] h-auto w-full object-cover"
          />
          <figcaption class="border-t border-gold-metal/15 px-5 py-4 text-[12px] tracking-[0.08em] text-muted">
            The storefront · Unit 9
          </figcaption>
        </figure>
        <div class="grid gap-5">
          <figure class="border border-gold-metal/15 bg-charcoal-light">
            <img
              src="/images/optimized/actual-iv-suite-800.webp"
              srcset="/images/optimized/actual-iv-suite-800.webp 800w, /images/optimized/actual-iv-suite-1400.webp 1400w"
              sizes="(max-width: 1023px) 100vw, 63vw"
              alt="The IV hydration suite inside House of Rose Aesthetics"
              width="1400"
              height="1120"
              loading="lazy"
              decoding="async"
              class="aspect-[5/4] h-auto w-full object-cover"
            />
            <figcaption class="border-t border-gold-metal/15 px-5 py-4 text-[12px] tracking-[0.08em] text-muted">
              The IV hydration suite
            </figcaption>
          </figure>
          <figure class="border border-gold-metal/15 bg-charcoal-light">
            <img
              src="/images/optimized/actual-facial-suite-800.webp"
              srcset="/images/optimized/actual-facial-suite-800.webp 800w, /images/optimized/actual-facial-suite-1400.webp 1400w"
              sizes="(max-width: 1023px) 100vw, 63vw"
              alt="A treatment room inside House of Rose Aesthetics"
              width="1400"
              height="1050"
              loading="lazy"
              decoding="async"
              class="aspect-[4/3] h-auto w-full object-cover"
            />
            <figcaption class="border-t border-gold-metal/15 px-5 py-4 text-[12px] tracking-[0.08em] text-muted">
              A treatment room
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- Decision support -->
  <section class="border-t border-gold-metal/10 bg-charcoal px-6 py-[clamp(56px,8vw,96px)]">
    <div class="mx-auto grid max-w-[1120px] gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
      <div>
        <span class="kicker">Inside the practice</span>
        <h2 class="mt-2 max-w-[520px] font-serif text-[clamp(30px,4vw,44px)] leading-tight text-ink">
          The rooms are real. Each treatment has a person behind it.
        </h2>
      </div>
      <div class="max-w-[620px]">
        <p class="text-[16px] leading-[1.8] text-muted-strong">
          House of Rose is one practice at one address. The photographs above show the storefront,
          reception, IV suite, and treatment room you will see here. Diana Morrison, RN provides
          injectables, IV hydration, and GLP-1 weight management. Amber Mingione, Licensed Esthetician provides
          Microneedling, Glo2Facial, dermaplaning, and BioRePeel add-ons.
        </p>
        <p class="mt-5 text-[15px] leading-[1.8] text-muted">
          Brandy, Licensed Esthetician provides facials, BioRePeel, and facial waxing.
          Aundrea Pedigo, Licensed Esthetician provides bridal, event, and everyday makeup. Contact
          House of Rose when you want help finding the relevant treatment or practitioner.
        </p>
        <div class="mt-8 flex flex-wrap gap-x-8 gap-y-4">
          <a href="/contact/" class="learn-more hover:text-gold">Contact House of Rose</a>
          <a href="/about/providers/" class="learn-more hover:text-gold">Review providers</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Visit information -->
  <section class="bg-charcoal-light py-[clamp(56px,8vw,88px)] px-6">
    <div class="mx-auto max-w-[1120px]">
      <span class="kicker">Your visit</span>
      <h2 class="mt-2 font-serif text-[clamp(30px,4vw,44px)] text-ink">
        Finding House of Rose.
      </h2>
      <p class="mt-5 max-w-[680px] text-[16px] leading-[1.8] text-muted-strong">
        House of Rose is in Unit 9 at 525 E Olympia Avenue. Look for the House of Rose Aesthetics sign; free parking is available outside the entrance.
      </p>
      <div class="mt-10 grid border-y border-walnut/15 lg:grid-cols-3">
        <article class="py-8 lg:pr-8">
          <h3 class="font-serif text-[26px] text-ink">Before you travel</h3>
          <p class="mt-4 max-w-[500px] text-[15px] leading-[1.75] text-muted">
            Call House of Rose if you need help with the entrance, parking, accessibility, or current availability.
          </p>
        </article>
        <article class="border-t border-walnut/15 py-8 lg:border-l lg:border-t-0 lg:px-8">
          <h3 class="font-serif text-[26px] text-ink">Before arriving without a reservation</h3>
          <p class="mt-4 max-w-[500px] text-[15px] leading-[1.75] text-muted">
            Read the <a href="/faq/" class="text-ink underline decoration-gold-metal/50 underline-offset-4 hover:text-gold">current walk-in policy</a>, or call <a href="tel:+19414000165" class="text-ink underline decoration-gold-metal/50 underline-offset-4 hover:text-gold">(941) 400-0165</a>
            for today’s availability before you travel.
          </p>
        </article>
        <article class="border-t border-walnut/15 py-8 lg:border-l lg:border-t-0 lg:pl-8">
          <h3 class="font-serif text-[26px] text-ink">When you are still comparing</h3>
          <p class="mt-4 max-w-[500px] text-[15px] leading-[1.75] text-muted">
            Send an inquiry or call with the concern or treatments you want to discuss. House of Rose can help identify the appropriate practitioner and options.
          </p>
        </article>
      </div>
      <aside class="mt-8 border border-gold-metal/15 bg-charcoal px-6 py-6 sm:px-8" aria-labelledby="finding-house-of-rose">
        <h3 id="finding-house-of-rose" class="font-serif text-[23px] text-ink">
          How will I know I am at the right entrance?
        </h3>
        <p class="mt-3 max-w-[760px] text-[14px] leading-[1.75] text-muted">
          Look for the House of Rose Aesthetics sign and Unit 9. The storefront photograph above shows the actual entrance at 525 E Olympia Avenue. Free parking is available; call <a href="tel:+19414000165" class="text-ink underline decoration-gold-metal/50 underline-offset-4 hover:text-gold">(941) 400-0165</a> if you have trouble locating the practice.
        </p>
      </aside>
    </div>
  </section>

  <!-- Contact CTA -->
  <section id="contact" class="bg-charcoal-light py-[clamp(56px,8vw,88px)] px-6 border-t border-gold-metal/10">
    <div class="max-w-[680px] mx-auto text-center">
      <span class="kicker">Visit House of Rose</span>
      <h2 class="font-serif text-[clamp(28px,5vw,44px)] text-ink leading-tight mb-4">
        Explore the treatments or contact House of Rose.
      </h2>
      <p class="text-muted text-[15px] max-w-[450px] mx-auto mb-10 leading-relaxed">
        Start with the change you are considering, or call if you want help finding the right place to begin.
      </p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="tel:+19414000165" class="btn-outline-gold">
          (941) 400-0165
        </a>
        <a href="/services/" class="btn-gold">
          View services
        </a>
      </div>
      <p class="text-muted text-[11px] tracking-[0.26em] uppercase mt-8 leading-relaxed">
        525 E Olympia Ave, Unit 9<br />Punta Gorda, FL 33950
      </p>
    </div>
  </section>
</BaseLayout>
