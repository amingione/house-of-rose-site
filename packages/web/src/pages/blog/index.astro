---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import { sanityFetch, urlFor } from '@/lib/sanity';
import { sbObjectId, sbFieldPath } from '@/lib/visualEditing';
import { ALL_BLOG_POSTS_QUERY, type BlogPost } from '@/lib/queries';
import { alignPublicContent } from '@/lib/publicCopy';
import { getPublicBlogTitle, isReviewedPublicBlogSlug } from '@/lib/publicBlogContent';
import { breadcrumbList, itemListPage } from '@/lib/structuredData';
import { getHeroBanner } from '@/lib/heroBanners';

const posts = alignPublicContent(await sanityFetch<BlogPost[]>(ALL_BLOG_POSTS_QUERY))
  .filter((post) => isReviewedPublicBlogSlug(post.slug));
const heroBanner = getHeroBanner('/blog/');
const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonical = new URL(Astro.url.pathname, site).toString();
const pageTitle = 'Treatment Journal | House of Rose Aesthetics';
const pageDescription = 'House of Rose treatment articles with primary sources, practical questions, and clearly stated limitations.';
const journalSchema = itemListPage(
  {
    name: 'House of Rose Treatment Journal',
    description: pageDescription,
    url: canonical,
    items: posts.map((post) => ({
      name: getPublicBlogTitle(post),
      url: new URL(`/blog/${post.slug}/`, site).toString(),
    })),
  },
  site,
);
const breadcrumb = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'Journal', item: canonical },
]);

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  });
}

---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  preloadImage={heroBanner.src}
  preloadImageSizes="100vw"
  structuredPageType="CollectionPage"
  structuredPageMainEntityId={`${canonical}#itemlist`}
>
  <SchemaMarkup item={journalSchema} slot="head" />
  <SchemaMarkup item={breadcrumb} slot="head" />

  <Hero
    title="Treatment questions, answered with sources."
    kicker="The Journal"
    description="Each article focuses on one treatment question, links the sources behind the answer, and makes the limits of that evidence easy to see."
    size="small"
    backgroundImage={heroBanner.src}
    backgroundSizes="100vw"
    backgroundWidth={924}
    backgroundHeight={610}
    backgroundPosition={heroBanner.position}
    imageAlt={heroBanner.alt}
  />

  <section class="bg-charcoal py-[clamp(48px,7vw,88px)] px-6">
    <div class="max-w-[1280px] mx-auto">
      <div data-journal-source-context class="mb-[clamp(48px,7vw,76px)] grid gap-8 border-y border-gold-metal/20 py-9 lg:grid-cols-[0.72fr_1.28fr] lg:gap-16">
        <div>
          <span class="kicker">Check the evidence</span>
          <h2 class="mt-3 font-serif text-[clamp(26px,4vw,40px)] leading-tight text-ink">
            You should be able to check the original for yourself.
          </h2>
        </div>
        <div class="space-y-4 text-[15px] leading-[1.8] text-muted">
          <p>
            The current Morpheus8 article links directly to the FDA safety communication and patient information it discusses. You can read the agency’s wording and the date of the safety communication—not only House of Rose’s summary.
          </p>
          <p>
            The article also separates a reported risk from a prediction about every procedure, then turns the source material into practical questions about the treatment area, practitioner, recovery, and follow-up.
          </p>
        </div>
      </div>

      <div class="mb-12 max-w-[720px] border-l border-gold-metal/35 pl-6">
        <span class="kicker">Current article</span>
        <h2 class="mt-3 font-serif text-[clamp(25px,4vw,38px)] leading-tight text-ink">
          Morpheus8 safety questions grounded in FDA information.
        </h2>
        <p class="mt-4 text-[15px] leading-[1.8] text-muted">
          The current article reviews FDA safety communications, the questions worth asking about the treatment area and device, and the limits of what an article can establish for one person.
        </p>
      </div>

      {posts.length === 0 ? (
        <div class="text-center py-24">
          <p class="text-muted text-[15px]">Posts coming soon.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-gold-metal/10">
          {posts.map((post) => (
            <article class="bg-charcoal group" {...sbObjectId(post._id)}>
              <a href={`/blog/${post.slug}/`} class="block">
                {post.featuredImage ? (
                  <div class="aspect-[4/3] overflow-hidden bg-charcoal-lighter">
                    <img
                      src={urlFor(post.featuredImage).width(600).height(450).fit('crop').url()}
                      alt={post.featuredImage.alt ?? getPublicBlogTitle(post)}
                      width={600}
                      height={450}
                      loading="lazy"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      {...sbFieldPath('featuredImage')}
                    />
                  </div>
                ) : null}

                <div class="p-6">
                  <div class="flex items-center gap-3 mb-3">
                    {post.category && (
                      <span class="text-gold text-[11px] tracking-[0.3em] uppercase" {...sbFieldPath('category')}>{post.category}</span>
                    )}
                    {post.estimatedReadingTime && post.estimatedReadingTime > 0 && (
                      <span class="text-muted text-[11px] tracking-[0.2em]">{post.estimatedReadingTime} min read</span>
                    )}
                  </div>

                  <h2
                    class="font-serif text-ink text-[20px] leading-snug mb-3 group-hover:text-gold transition-colors"
                    {...(post.slug === 'is-morpheus8-safe' ? {} : sbFieldPath('title'))}
                  >
                    {getPublicBlogTitle(post)}
                  </h2>

                  <div class="flex items-center justify-between">
                    <time class="text-muted text-[11px] tracking-[0.15em]" datetime={post.publishedAt}>
                      {formatDate(post.publishedAt)}
                    </time>
                    <span class="text-gold text-[11px] tracking-[0.2em] uppercase border-b border-gold pb-px group-hover:opacity-75 transition-opacity">
                      Read
                    </span>
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>
      )}

    </div>
  </section>

  <!-- CTA -->
  <section class="bg-charcoal-light py-16 px-6 border-t border-ink/5">
    <div class="max-w-[680px] mx-auto text-center">
      <span class="kicker">What the source cannot answer</span>
      <h2 class="font-serif text-[clamp(26px,4vw,38px)] text-ink mt-2 mb-4">
        An FDA safety communication is not a recommendation for your treatment plan.
      </h2>
      <p class="text-muted text-[15px] mb-8">
        The FDA communication identifies reported complications and advises patients what to ask before RF microneedling. It does not determine whether a particular treatment area, depth, or energy setting is appropriate for one person, and it cannot predict individual recovery. If you are considering Morpheus8, ask who would perform it, which area and settings are proposed, what recovery and follow-up may involve, and what alternatives exist before deciding.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/services/morpheus8/" class="btn-gold">Read Morpheus8 details</a>
        <a href="/contact/" class="btn-outline-gold">Ask House of Rose</a>
      </div>
    </div>
  </section>
</BaseLayout>
