---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import { sanityFetch, urlFor } from '@/lib/sanity';
import { sbObjectId, sbFieldPath } from '@/lib/visualEditing';
import { ALL_BLOG_POSTS_QUERY, type BlogPost } from '@/lib/queries';
import { DEFAULT_JOURNAL_IMAGE } from '@/lib/imageFallbacks';
import { alignPublicContent } from '@/lib/publicCopy';
import { getPublicBlogTitle } from '@/lib/publicBlogContent';

const posts = alignPublicContent(await sanityFetch<BlogPost[]>(ALL_BLOG_POSTS_QUERY));
const heroImage = '/images/optimized/actual-welcome-800.webp';
const heroImageSrcset = '/images/optimized/actual-welcome-800.webp 800w, /images/optimized/actual-welcome-1400.webp 1400w';

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  });
}

---

<BaseLayout
  title="Medical Aesthetics Journal | House of Rose Punta Gorda FL"
  description="Articles about microneedling, PRF, injectables, IV hydration, and treatment decisions from House of Rose Aesthetics in Punta Gorda."
  preloadImage={heroImage}
  preloadImageSrcset={heroImageSrcset}
  preloadImageSizes="100vw"
>
  <Hero
    title="Read before you decide."
    kicker="The Journal"
    description="Clear explanations of what different services do, where they differ, and what is worth asking before an appointment."
    size="small"
    backgroundImage={heroImage}
    backgroundSrcset={heroImageSrcset}
    backgroundSizes="100vw"
    backgroundWidth={1400}
    backgroundHeight={1050}
    imageAlt="The reception area inside House of Rose Aesthetics"
  />

  <section class="bg-charcoal py-[clamp(48px,7vw,88px)] px-6">
    <div class="max-w-[1280px] mx-auto">

      {posts.length === 0 ? (
        <div class="text-center py-24">
          <p class="text-muted text-[15px]">Posts coming soon.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-gold-metal/10">
          {posts.map((post) => (
            <article class="bg-charcoal group" {...sbObjectId(post._id)}>
              <a href={`/blog/${post.slug}/`} class="block">
                {post.featuredImage ? (
                  <div class="aspect-[4/3] overflow-hidden bg-charcoal-lighter">
                    <img
                      src={urlFor(post.featuredImage).width(600).height(450).fit('crop').url()}
                      alt={post.featuredImage.alt ?? getPublicBlogTitle(post)}
                      width={600}
                      height={450}
                      loading="lazy"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                  </div>
                ) : (
                  <div class="aspect-[4/3] overflow-hidden bg-charcoal-lighter">
                    <img src={DEFAULT_JOURNAL_IMAGE} alt={getPublicBlogTitle(post)} width={600} height={450} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                  </div>
                )}

                <div class="p-6">
                  <div class="flex items-center gap-3 mb-3">
                    {post.category && (
                      <span class="text-gold text-[11px] tracking-[0.3em] uppercase" {...sbFieldPath('category')}>{post.category}</span>
                    )}
                    {post.estimatedReadingTime && post.estimatedReadingTime > 0 && (
                      <span class="text-muted text-[11px] tracking-[0.2em]">{post.estimatedReadingTime} min read</span>
                    )}
                  </div>

                  <h2
                    class="font-serif text-ink text-[20px] leading-snug mb-3 group-hover:text-gold transition-colors"
                    {...(post.slug === 'is-morpheus8-safe' ? {} : sbFieldPath('title'))}
                  >
                    {getPublicBlogTitle(post)}
                  </h2>

                  <div class="flex items-center justify-between">
                    <time class="text-muted text-[11px] tracking-[0.15em]" datetime={post.publishedAt}>
                      {formatDate(post.publishedAt)}
                    </time>
                    <span class="text-gold text-[11px] tracking-[0.2em] uppercase border-b border-gold pb-px group-hover:opacity-75 transition-opacity">
                      Read
                    </span>
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>
      )}

    </div>
  </section>

  <!-- CTA -->
  <section class="bg-charcoal-light py-16 px-6 border-t border-ink/5">
    <div class="max-w-[680px] mx-auto text-center">
      <span class="kicker">Questions</span>
      <h2 class="font-serif text-[clamp(26px,4vw,38px)] text-ink mt-2 mb-4">
        Questions about an article?
      </h2>
      <p class="text-muted text-[15px] mb-8">
        Contact the practice with a question about a service.
      </p>
      <a href="/consultation/" class="btn-gold">
        Request a consultation
      </a>
    </div>
  </section>
</BaseLayout>
