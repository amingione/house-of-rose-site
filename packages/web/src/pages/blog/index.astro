---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import { sanityFetch, urlFor } from '@/lib/sanity';
import { ALL_BLOG_POSTS_QUERY, type BlogPost } from '@/lib/queries';

const posts = await sanityFetch<BlogPost[]>(ALL_BLOG_POSTS_QUERY);

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  });
}
---

<BaseLayout
  title="Wellness & Spa Blog | House of Rose Punta Gorda FL"
  description="Expert insights on microchanneling, IV hydration, hormone therapy, GLP-1 weight loss, and spa wellness from House of Rose — private med spa in Punta Gorda, FL."
>
  <Hero
    title="The Rose Journal"
    kicker="Insights & Education"
    description="Physician-informed perspectives on wellness, aesthetics, and living well in Southwest Florida."
    size="small"
    backgroundImage="/images/house-of-rose-lounge.webp"
  />

  <section class="bg-charcoal py-[clamp(48px,7vw,88px)] px-6">
    <div class="max-w-[1280px] mx-auto">

      {posts.length === 0 ? (
        <div class="text-center py-24">
          <p class="text-[#555] text-[15px]">Posts coming soon.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-gold/10">
          {posts.map((post) => (
            <article class="bg-charcoal group">
              <a href={`/blog/${post.slug}`} class="block">
                {post.featuredImage ? (
                  <div class="aspect-[4/3] overflow-hidden bg-charcoal-lighter">
                    <img
                      src={urlFor(post.featuredImage).width(600).height(450).fit('crop').url()}
                      alt={post.featuredImage.alt ?? post.title}
                      width={600}
                      height={450}
                      loading="lazy"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                  </div>
                ) : (
                  <div class="aspect-[4/3] bg-charcoal-lighter flex items-center justify-center">
                    <span class="font-serif text-[#333] text-[28px]">HofR</span>
                  </div>
                )}

                <div class="p-6">
                  <div class="flex items-center gap-3 mb-3">
                    {post.category && (
                      <span class="text-gold text-[10px] tracking-[0.3em] uppercase">{post.category}</span>
                    )}
                    {post.estimatedReadingTime && post.estimatedReadingTime > 0 && (
                      <span class="text-[#444] text-[10px] tracking-[0.2em]">{post.estimatedReadingTime} min read</span>
                    )}
                  </div>

                  <h2 class="font-serif text-white text-[20px] leading-snug mb-3 group-hover:text-gold transition-colors">
                    {post.title}
                  </h2>

                  {post.excerpt && (
                    <p class="text-[#666] text-[13px] leading-relaxed line-clamp-3 mb-4">
                      {post.excerpt}
                    </p>
                  )}

                  <div class="flex items-center justify-between">
                    <time class="text-[#444] text-[11px] tracking-[0.15em]" datetime={post.publishedAt}>
                      {formatDate(post.publishedAt)}
                    </time>
                    <span class="text-gold text-[11px] tracking-[0.2em] uppercase border-b border-gold pb-px group-hover:opacity-75 transition-opacity">
                      Read
                    </span>
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>
      )}

    </div>
  </section>

  <!-- CTA -->
  <section class="bg-charcoal-light py-16 px-6 border-t border-white/5">
    <div class="max-w-[680px] mx-auto text-center">
      <span class="kicker">Ready to Begin?</span>
      <h2 class="font-serif text-[clamp(26px,4vw,38px)] text-white mt-2 mb-4">
        Every treatment starts with a conversation.
      </h2>
      <p class="text-[#777] text-[15px] mb-8">
        Book a private consultation at House of Rose in Punta Gorda, FL.
      </p>
      <a href="https://houseofrose.glossgenius.com/services" target="_blank" rel="noopener noreferrer" class="btn-gold">
        Book a Consultation
      </a>
    </div>
  </section>
</BaseLayout>
