---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sanityFetch, urlFor } from '@/lib/sanity';
import { sbObjectId, sbFieldPath } from '@/lib/visualEditing';
import {
  ALL_BLOG_POST_SLUGS_QUERY,
  BLOG_POST_BY_SLUG_QUERY,
  type BlogPost,
} from '@/lib/queries';
import { toHTML } from '@portabletext/to-html';

export async function getStaticPaths() {
  const slugs = await sanityFetch<{ slug: string }[]>(ALL_BLOG_POST_SLUGS_QUERY);
  return slugs.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = await sanityFetch<BlogPost>(BLOG_POST_BY_SLUG_QUERY, { slug });

if (!post) {
  return Astro.redirect('/blog', 307);
}

const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonicalURL = new URL(Astro.url.pathname, site);
const pageTitle = post.seo?.metaTitle ?? `${post.title} | House of Rose`;
const pageDescription = post.seo?.metaDescription ?? post.excerpt ?? '';

const publishedDate = new Date(post.publishedAt).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

const bodyHTML = post.body
  ? toHTML(post.body, {
      components: {
        types: {
          image: ({ value }) => {
            const src = urlFor(value).width(960).url();
            const alt = value.alt ?? '';
            const caption = value.caption ?? '';
            return caption
              ? `<figure><img src="${src}" alt="${alt}" loading="lazy" /><figcaption>${caption}</figcaption></figure>`
              : `<img src="${src}" alt="${alt}" loading="lazy" />`;
          },
        },
        marks: {
          link: ({ children, value }) => {
            const rel = value.blank ? ' rel="noopener noreferrer"' : '';
            const target = value.blank ? ' target="_blank"' : '';
            return `<a href="${value.href}"${target}${rel}>${children}</a>`;
          },
        },
      },
    })
  : '';

// Schema.org BlogPosting
const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title,
  "description": pageDescription,
  "url": canonicalURL.toString(),
  "datePublished": post.publishedAt,
  "author": {
    "@type": "Organization",
    "name": "House of Rose",
    "url": site
  },
  "publisher": {
    "@type": "Organization",
    "name": "House of Rose",
    "url": site,
    "logo": {
      "@type": "ImageObject",
      "url": new URL('/logos/hr-monogram-2026/monogram-gold-512.png', site).toString()
    }
  },
  ...(post.featuredImage && {
    "image": urlFor(post.featuredImage).width(1200).height(630).fit('crop').url()
  }),
  ...(post.estimatedReadingTime && {
    "timeRequired": `PT${post.estimatedReadingTime}M`
  })
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": site },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": new URL('/blog', site).toString() },
    { "@type": "ListItem", "position": 3, "name": post.title, "item": canonicalURL.toString() }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={post.featuredImage ? urlFor(post.featuredImage).width(1200).height(630).fit('crop').url() : undefined}
  preloadImage={post.featuredImage ? urlFor(post.featuredImage).width(1920).height(1080).url() : undefined}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />

  <div {...sbObjectId(post._id)}>
  <!-- Hero -->
  <section
    class="relative w-full h-[50vh] min-h-[320px] flex items-end bg-charcoal"
    style={post.featuredImage
      ? `background-image: url(${urlFor(post.featuredImage).width(1920).height(1080).url()}); background-size: cover; background-position: center;`
      : ''}
  >
    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-black/10"></div>
    <div class="relative z-10 max-w-[800px] mx-auto px-6 pb-12 w-full">
      <a href="/blog" class="inline-flex items-center gap-2 text-ivory/70 text-[11px] tracking-[0.2em] uppercase mb-4 hover:text-gold transition-colors">
        <span class="text-lg">←</span> The Rose Journal
      </a>
      {post.category && (
        <span class="block text-gold text-[10px] tracking-[0.4em] uppercase mb-3" {...sbFieldPath('category')}>{post.category}</span>
      )}
      <h1 class="font-serif text-[clamp(28px,5vw,48px)] leading-tight font-normal text-ivory" {...sbFieldPath('title')}>
        {post.title}
      </h1>
      <div class="flex items-center gap-4 mt-4 text-ivory/50 text-[12px] tracking-[0.15em]">
        <time datetime={post.publishedAt}>{publishedDate}</time>
        {post.estimatedReadingTime && post.estimatedReadingTime > 0 && (
          <span>{post.estimatedReadingTime} min read</span>
        )}
      </div>
    </div>
  </section>

  <!-- Post Body -->
  <section class="bg-charcoal py-[clamp(48px,7vw,80px)] px-6">
    <div class="max-w-[800px] mx-auto">

      {post.excerpt && (
        <p class="text-[#999] text-[17px] leading-relaxed italic mb-10 border-l-2 border-gold/40 pl-5" {...sbFieldPath('excerpt')}>
          {post.excerpt}
        </p>
      )}

      {bodyHTML ? (
        <div
          {...sbFieldPath('body')}
          class="prose prose-invert prose-lg max-w-none
            prose-headings:font-serif prose-headings:font-normal prose-headings:text-ink
            prose-h2:text-[clamp(22px,3vw,30px)] prose-h2:mt-12 prose-h2:mb-4
            prose-h3:text-[clamp(18px,2.5vw,24px)] prose-h3:mt-8 prose-h3:mb-3
            prose-p:text-[#999] prose-p:text-[16px] prose-p:leading-[1.85]
            prose-a:text-gold prose-a:no-underline hover:prose-a:underline
            prose-strong:text-ink prose-strong:font-medium
            prose-blockquote:border-l-2 prose-blockquote:border-gold/40 prose-blockquote:text-[#9a8c78] prose-blockquote:not-italic
            prose-ul:text-[#999] prose-ol:text-[#999]
            prose-li:text-[15px] prose-li:leading-relaxed
            prose-img:rounded-none prose-img:my-10
            prose-figcaption:text-[#7a6e5c] prose-figcaption:text-center prose-figcaption:text-[12px] prose-figcaption:mt-2"
          set:html={bodyHTML}
        />
      ) : (
        <p class="text-[#7a6e5c] text-[15px]">Content coming soon.</p>
      )}

    </div>
  </section>

  <!-- Related Service CTA -->
  {post.relatedService && (
    <section class="bg-charcoal-light py-14 px-6 border-t border-ink/5">
      <div class="max-w-[680px] mx-auto text-center">
        <span class="kicker">Related Service</span>
        <h2 class="font-serif text-[clamp(24px,4vw,34px)] text-ink mt-2 mb-3">
          {post.relatedService.title}
        </h2>
        {post.relatedService.tagline && (
          <p class="text-[#777] text-[15px] mb-6">{post.relatedService.tagline}</p>
        )}
        <div class="flex gap-3 justify-center flex-wrap">
          <a href={`/services/${post.relatedService.slug}`} class="btn-outline-gold">
            Learn More
          </a>
          <a href="https://houseofrose.glossgenius.com/services" target="_blank" rel="noopener noreferrer" class="btn-gold">
            Book a Consultation
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- Default CTA if no related service -->
  {!post.relatedService && (
    <section class="bg-charcoal-light py-14 px-6 border-t border-ink/5">
      <div class="max-w-[680px] mx-auto text-center">
        <span class="kicker">House of Rose</span>
        <h2 class="font-serif text-[clamp(24px,4vw,34px)] text-ink mt-2 mb-4">
          Ready to begin your protocol?
        </h2>
        <p class="text-[#777] text-[15px] mb-8">
          Every treatment starts with a private consultation in Punta Gorda, FL.
        </p>
        <a href="https://houseofrose.glossgenius.com/services" target="_blank" rel="noopener noreferrer" class="btn-gold">
          Book Online
        </a>
      </div>
    </section>
  )}
  </div>
</BaseLayout>
