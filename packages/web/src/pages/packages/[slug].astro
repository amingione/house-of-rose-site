---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sanityFetch, urlFor } from '@/lib/sanity';
import {
  ALL_TREATMENT_PACKAGE_SLUGS_QUERY,
  TREATMENT_PACKAGE_BY_SLUG_QUERY,
  type TreatmentPackage,
} from '@/lib/queries';

export async function getStaticPaths() {
  const slugs = await sanityFetch<{ slug: string }[]>(ALL_TREATMENT_PACKAGE_SLUGS_QUERY);
  return slugs.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const pkg = await sanityFetch<TreatmentPackage>(TREATMENT_PACKAGE_BY_SLUG_QUERY, { slug });

if (!pkg) {
  return Astro.redirect('/packages', 307);
}

const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonicalURL = new URL(Astro.url.pathname, site);
const summary = pkg.outcome ?? pkg.whatsIncluded ?? '';
const services = pkg.servicesIncluded ?? [];
const price = pkg.foundingPrice ?? pkg.rackPrice;

// Structured data — model the package as a Service offered by the business.
const packageSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: pkg.title,
  description: summary,
  provider: {
    '@type': 'HealthAndBeautyBusiness',
    name: 'House of Rose Luxury Spa & Wellness',
    url: site,
    telephone: '+18449417673',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '525 E Olympia Ave, Ste 9',
      addressLocality: 'Punta Gorda',
      addressRegion: 'FL',
      postalCode: '33950',
      addressCountry: 'US',
    },
  },
  url: canonicalURL.toString(),
  ...(pkg.image && {
    image: urlFor(pkg.image).width(1200).height(630).fit('crop').url(),
  }),
  serviceType: 'Treatment package',
  ...(services.length > 0 && {
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: pkg.title,
      itemListElement: services.map((s) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: s.title },
      })),
    },
  }),
  areaServed: {
    '@type': 'GeoCircle',
    geoMidpoint: { '@type': 'GeoCoordinates', latitude: '26.9298', longitude: '-82.0454' },
    geoRadius: '50000',
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site },
    { '@type': 'ListItem', position: 2, name: 'Packages', item: new URL('/packages/', site).toString() },
    { '@type': 'ListItem', position: 3, name: pkg.title, item: canonicalURL.toString() },
  ],
};

const pageTitle = `${pkg.title} | Signature Package | House of Rose`;
const pageDescription = summary;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={pkg.image ? urlFor(pkg.image).width(1200).height(630).fit('crop').url() : undefined}
  preloadImage={pkg.image ? urlFor(pkg.image).width(1920).height(1080).url() : undefined}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(packageSchema)} slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />

  <!-- Hero -->
  <section
    class="hero relative w-full h-[55vh] min-h-[360px] flex items-end bg-charcoal"
    style={pkg.image ? `background-image: url(${urlFor(pkg.image).width(1920).height(1080).url()}); background-size: cover; background-position: center;` : ''}
  >
    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-black/10"></div>
    <div class="relative z-10 max-w-[1280px] mx-auto px-6 pb-12 w-full">
      <a href="/packages" class="inline-flex items-center gap-2 text-ivory/75 text-[11px] tracking-[0.2em] uppercase mb-4 hover:text-gold transition-colors">
        <span class="text-lg">←</span> All Packages
      </a>
      <span class="block text-[10px] tracking-[0.4em] uppercase text-gold mb-3">Signature Package</span>
      <h1 class="font-serif text-[clamp(32px,6vw,56px)] leading-tight font-normal text-ivory">
        {pkg.title}
      </h1>
      {summary && <p class="mt-4 text-ivory/75 text-[15px] max-w-[640px] leading-relaxed">{summary}</p>}
      {price && (
        <p class="mt-3 text-ivory/70 text-[13px] tracking-[0.18em] uppercase">{price}</p>
      )}
    </div>
  </section>

  <!-- What's Included -->
  {services.length > 0 && (
    <section class="bg-charcoal py-16 px-6 md:px-12 max-w-[1280px] mx-auto">
      <span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-8">What's Included</span>
      <div class="space-y-px bg-gold/10">
        {services.map((service, index) => (
          <div class="bg-charcoal p-7 flex gap-6">
            <span class="font-serif text-gold/30 text-[28px] leading-none">
              {String(index + 1).padStart(2, '0')}
            </span>
            <div>
              <a href={`/services/${service.slug}`} class="font-serif text-[20px] text-ink hover:text-gold transition-colors">
                {service.title}
              </a>
              {service.tagline && (
                <p class="text-[#9a8c78] text-[14px] leading-relaxed mt-2">{service.tagline}</p>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  {pkg.whatsIncluded && services.length === 0 && (
    <section class="bg-charcoal py-16 px-6 md:px-12 max-w-[960px] mx-auto">
      <span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-6">What's Included</span>
      <p class="text-ink/80 text-[15px] leading-relaxed whitespace-pre-line">{pkg.whatsIncluded}</p>
    </section>
  )}

  <!-- Cadence + Positioning -->
  {(pkg.cadence || pkg.positioning) && (
    <section class="bg-charcoal-light grid grid-cols-1 md:grid-cols-2 gap-12 py-16 px-6 md:px-12 max-w-[1280px] mx-auto">
      {pkg.cadence && (
        <div>
          <span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-4">Sequencing &amp; Cadence</span>
          <p class="text-ink/80 text-[15px] leading-relaxed">{pkg.cadence}</p>
        </div>
      )}
      {pkg.positioning && (
        <div>
          <span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-4">The Ritual</span>
          <p class="text-[#9a8c78] text-[15px] leading-relaxed italic">{pkg.positioning}</p>
        </div>
      )}
    </section>
  )}

  <!-- Booking CTA -->
  <section id="book" class="bg-charcoal py-[clamp(56px,8vw,88px)] px-6 border-t border-gold/10">
    <div class="max-w-[840px] mx-auto text-center">
      <span class="kicker">Reserve Your Experience</span>
      <h2 class="font-serif text-[clamp(28px,5vw,44px)] text-ink leading-tight mb-4">
        Ready to begin {pkg.title}?
      </h2>
      <p class="text-[#777] text-[15px] max-w-[460px] mx-auto mb-6 leading-relaxed">
        Start with a private consultation. We'll confirm your candidacy and tailor the ritual to your skin.
      </p>
      {pkg.candidacyNote && (
        <p class="text-[#7a6e5c] text-[11px] leading-relaxed max-w-[560px] mx-auto mb-10">{pkg.candidacyNote}</p>
      )}
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="tel:+18449417673" class="btn-outline-gold">
          (844) 941-7673
        </a>
        <a href="https://houseofrose.glossgenius.com/services" target="_blank" rel="noopener noreferrer" class="btn-gold">
          Book Online
        </a>
      </div>
      <p class="text-[#8a7c66] text-[10px] tracking-[0.26em] uppercase mt-8 leading-relaxed">
        525 E Olympia Ave, Ste 9<br />Punta Gorda, FL 33950
      </p>
    </div>
  </section>
</BaseLayout>
