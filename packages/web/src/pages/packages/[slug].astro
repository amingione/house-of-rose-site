---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import { sanityFetch, urlFor } from '@/lib/sanity';
import { DEFAULT_PACKAGE_IMAGE } from '@/lib/imageFallbacks';
import { sbObjectId, sbFieldPath } from '@/lib/visualEditing';
import {
  ALL_TREATMENT_PACKAGE_SLUGS_QUERY,
  TREATMENT_PACKAGE_BY_SLUG_QUERY,
  type TreatmentPackage,
} from '@/lib/queries';
import { service as serviceJsonLd, breadcrumbList } from '@/lib/structuredData';
import { FACE_REALITY_PROGRAM } from '@/lib/faceRealityEducation';
import { getPackageServiceSlugs, getPublicServiceRefs } from '@/lib/serviceCatalog';

export async function getStaticPaths() {
  const slugs = await sanityFetch<{ slug: string }[]>(ALL_TREATMENT_PACKAGE_SLUGS_QUERY);
  return slugs.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const packageData = await sanityFetch<TreatmentPackage>(TREATMENT_PACKAGE_BY_SLUG_QUERY, { slug });

// Never `return Astro.redirect()` from a prerendered route — it breaks the static build.
// Slugs come from getStaticPaths, so a miss is a data bug: fail loudly.
if (!packageData) {
  throw new Error(`[packages/[slug]] No treatment package found in Sanity for slug "${slug}"`);
}
const pkg: TreatmentPackage = {
  ...packageData,
  servicesIncluded: getPublicServiceRefs(
    packageData.serviceSlugs ?? getPackageServiceSlugs(packageData.slug),
  ),
};

const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonicalURL = new URL(Astro.url.pathname, site);
const services = pkg.servicesIncluded ?? [];
// House of Rose pricing is never public (binding 2026-08-20, see CLAUDE.md).
// This page names the package and its structure; current pricing is
// confirmed by phone or at booking, never rendered here.
const isFaceRealityProgram = pkg.slug === FACE_REALITY_PROGRAM.packageSlug;
const serviceNames = services.map((service) => service.title).join(', ');
const summary = isFaceRealityProgram
  ? `${FACE_REALITY_PROGRAM.summary} Ask about current pricing when you book.`
  : serviceNames
  ? `${pkg.title} includes ${serviceNames}.`
  : `${pkg.title} at House of Rose Aesthetics in Punta Gorda, Florida.`;
// Temporary voice-reset overlay: keep the factual duration without rendering
// the superseded marketing language stored on this live package.
const timing = pkg.slug === 'glo2facial-series-of-6'
  ? 'Several months.'
  : pkg.cadence;
const packageImage = pkg.image
  ? urlFor(pkg.image).width(1920).height(1080).fit('crop').url()
  : DEFAULT_PACKAGE_IMAGE;

// Structured data — model the package as a Service (with an OfferCatalog of included services).
const packageSchema = serviceJsonLd(
  {
    name: pkg.title,
    description: summary || undefined,
    url: canonicalURL.toString(),
    image: pkg.image ? urlFor(pkg.image).width(1200).height(630).fit('crop').url() : undefined,
    serviceType: 'Treatment package',
    catalog: services.length > 0 ? { name: pkg.title, items: services.map((s) => s.title) } : undefined,
  },
  site,
);

const breadcrumbSchema = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'Packages', item: new URL('/packages/', site).toString() },
  { name: pkg.title, item: canonicalURL.toString() },
]);

const pageTitle = isFaceRealityProgram
  ? 'Acne Bootcamp: 12-Week Face Reality Program'
  : `${pkg.title} | Treatment Package`;
const pageDescription = isFaceRealityProgram ? FACE_REALITY_PROGRAM.metaDescription : summary;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={packageImage}
  preloadImage={packageImage}
>
  <SchemaMarkup item={packageSchema} slot="head" />
  <SchemaMarkup item={breadcrumbSchema} slot="head" />

  <div {...sbObjectId(pkg._id)}>
  <!-- Hero -->
  <section
    class="on-dark hero-dark hero relative w-full h-[55vh] min-h-[360px] flex items-end bg-walnut"
    style={`background-image: url(${packageImage}); background-size: cover; background-position: center;`}
  >
    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-black/10"></div>
    <div class="relative z-10 max-w-[1280px] mx-auto px-6 pb-12 w-full">
      <a href="/packages/" class="inline-flex items-center gap-2 text-ivory/75 text-[11px] tracking-[0.2em] uppercase mb-4 hover:text-gold transition-colors">
        <span class="text-lg">←</span> All packages
      </a>
      <span class="block text-[11px] font-medium tracking-[0.26em] uppercase text-gold mb-3">Treatment package</span>
      <h1 class="font-serif text-[clamp(32px,6vw,56px)] leading-tight font-normal text-ivory" {...sbFieldPath('title')}>
        {pkg.title}
      </h1>
    </div>
  </section>

  {isFaceRealityProgram && (
    <section class="border-t border-gold-metal/10 bg-charcoal px-6 py-[clamp(52px,7vw,80px)] md:px-12">
      <div class="mx-auto grid max-w-[1120px] gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
        <div>
          <span class="kicker">The program</span>
          <h2 class="mt-3 font-serif text-[clamp(30px,5vw,46px)] leading-tight text-ink">
            What the program price represents.
          </h2>
          <p class="mt-5 max-w-[540px] text-[16px] leading-[1.75] text-muted-strong">
            {FACE_REALITY_PROGRAM.programOnly} The program price covers the complete 12-week program, not one visit. Ask about current pricing when you book.
          </p>
          <a href="/services/face-reality-acne-program/" class="learn-more mt-7 inline-block hover:text-gold">
            Consultation and program details
          </a>
        </div>
        <div class="border-y border-gold-metal/15">
          {FACE_REALITY_PROGRAM.packageDetails.map((detail) => (
            <p class="border-b border-gold-metal/10 py-6 text-[15px] leading-[1.7] text-muted last:border-b-0">
              {detail}
            </p>
          ))}
        </div>
      </div>

      <div class="mx-auto mt-12 grid max-w-[1120px] gap-px overflow-hidden border border-gold-metal/10 bg-gold-metal/10 md:grid-cols-2">
        <div class="bg-charcoal p-7 md:p-9">
          <h3 class="font-serif text-[24px] leading-tight text-ink">What the consultation covers.</h3>
          <p class="mt-4 text-[15px] leading-[1.75] text-muted">
            The 60-minute Acne Bootcamp Consultation can be booked directly. You and Amber Mingione, Licensed Esthetician, discuss what your skin is doing now, the home care purchased for the program, and whether you want to continue into the complete 12 weeks. Ask about current pricing when you book.
          </p>
        </div>
        <div class="bg-charcoal p-7 md:p-9">
          <h3 class="font-serif text-[24px] leading-tight text-ink">Who provides the program.</h3>
          <p class="mt-4 text-[15px] leading-[1.75] text-muted">
            Amber Mingione, Licensed Esthetician and Face Reality Certified Acne Specialist, provides the Face Reality program at House of Rose in Punta Gorda.
          </p>
          <a href="/about/providers/amber/" class="learn-more mt-5 inline-block hover:text-gold">
            Meet Amber Mingione, Licensed Esthetician
          </a>
        </div>
      </div>

      <aside data-face-reality-medical-boundary class="mx-auto mt-6 max-w-[1120px] border border-gold-metal/15 bg-charcoal-light px-7 py-8 md:px-9">
        <span class="kicker">When to seek medical care</span>
        <h3 class="mt-3 font-serif text-[clamp(24px,3.5vw,34px)] leading-tight text-ink">
          Some breakouts need medical evaluation first.
        </h3>
        <p class="mt-4 max-w-[780px] text-[15px] leading-[1.8] text-muted">
          {FACE_REALITY_PROGRAM.medicalBoundary}
        </p>
      </aside>
    </section>
  )}

  <!-- Included services -->
  {services.length > 0 && (
    <section class="bg-charcoal py-16 px-6 md:px-12 max-w-[1280px] mx-auto">
      <span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-8">Included services</span>
      <div class="space-y-px bg-gold-metal/10">
        {services.map((service, index) => (
          <div class="bg-charcoal p-7 flex gap-6" {...(service._id ? sbObjectId(service._id) : {})}>
            <span class="font-serif text-gold text-[28px] leading-none">
              {String(index + 1).padStart(2, '0')}
            </span>
            <div>
              <a href={`/services/${service.slug}/`} class="font-serif text-[20px] text-ink hover:text-gold transition-colors" {...(service._id ? sbFieldPath('title') : {})}>
                {service.title}
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Commitment -->
  {timing && (
    <section class="bg-charcoal-light py-16 px-6 md:px-12 max-w-[1280px] mx-auto">
      <div class="max-w-[640px]">
        <span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-4">Timing</span>
        <p class="text-ink/80 text-[15px] leading-relaxed" {...sbFieldPath('cadence')}>{timing}</p>
      </div>
    </section>
  )}

  <!-- Booking CTA -->
  <section id="book" class="bg-charcoal py-[clamp(56px,8vw,88px)] px-6 border-t border-gold-metal/10">
    <div class="max-w-[840px] mx-auto text-center">
      <span class="kicker">{isFaceRealityProgram ? 'First appointment' : 'Questions'}</span>
      <h2 class="font-serif text-[clamp(28px,5vw,44px)] text-ink leading-tight mb-4">
        {isFaceRealityProgram ? 'Begin with the Acne Bootcamp Consultation.' : `Ask about ${pkg.title}.`}
      </h2>
      <p class="text-muted text-[15px] max-w-[460px] mx-auto mb-6 leading-relaxed">
        {isFaceRealityProgram
          ? 'The directly bookable consultation lasts 60 minutes. If you continue, the complete 12-week program includes its in-studio visits; home-care products are purchased separately. Ask about current pricing when you book.'
          : 'Call us or request a consultation.'}
      </p>
      <p class="text-muted text-[11px] leading-relaxed max-w-[560px] mx-auto mb-10">
        {isFaceRealityProgram
          ? 'The program and its timing are confirmed after the consultation. Individual outcomes vary.'
          : 'Package availability and timing are confirmed when you contact the practice. Individual outcomes vary.'}
      </p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="tel:+19414000165" class="btn-outline-gold">
          (941) 400-0165
        </a>
        <a href={isFaceRealityProgram ? '/services/face-reality-acne-program/' : '/consultation/'} class="btn-gold">
          {isFaceRealityProgram ? 'See consultation booking' : 'Request a Consultation'}
        </a>
      </div>
      <p class="text-muted text-[11px] tracking-[0.26em] uppercase mt-8 leading-relaxed">
        525 E Olympia Ave, Unit 9<br />Punta Gorda, FL 33950
      </p>
    </div>
  </section>
  </div>
</BaseLayout>
