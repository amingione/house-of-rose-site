---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import TreatmentPackageCard from '@/components/TreatmentPackageCard.astro';
import { sanityFetch } from '@/lib/sanity';
import { ALL_TREATMENT_PACKAGES_QUERY, type TreatmentPackage } from '@/lib/queries';

// Visual Editor: inline click-to-edit is delegated to <TreatmentPackageCard>, which
// emits the sbObjectId / sbFieldPath annotations when passed `objectId={pkg._id}`.

const packages = await sanityFetch<TreatmentPackage[]>(ALL_TREATMENT_PACKAGES_QUERY);
const heroImage = '/images/optimized/actual-welcome-1400.webp';
---

<BaseLayout
  title="Treatment Packages in Punta Gorda, FL"
  description="Explore House of Rose's 12-week Face Reality Acne Bootcamp, including the visit schedule, complete program price, and where to read the full details."
  preloadImage={heroImage}
>
  <Hero
    title="Treatment Packages"
    kicker="House of Rose Aesthetics"
    description="When a service is built around more than one visit, the full schedule and price belong in the same place."
    size="small"
    backgroundImage={heroImage}
    imageAlt="A treatment room at House of Rose Aesthetics"
  />

  <section class="bg-charcoal py-[clamp(48px,7vw,88px)] px-6">
    <div class="max-w-[1280px] mx-auto">
      <div class="max-w-[700px] mb-12">
        <span class="kicker">The current program</span>
        <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ink mt-2 mb-4">
          Acne Bootcamp follows the skin across 12 weeks.
        </h2>
        <div class="space-y-4 text-muted text-[15px] leading-[1.75]">
          <p>
            Acne can look different from one visit to the next. House of Rose's Face Reality Acne Bootcamp keeps the consultation, in-studio appointments, and home-care review connected across a 12-week program instead of treating each visit as an unrelated facial.
          </p>
          <p>
            Visits take place every two weeks. The complete program is $899. The service page explains what is included and how the $99 consultation fits alongside the full program.
          </p>
          <a href="/services/face-reality-acne-program/" class="learn-more inline-flex items-center gap-1">
            Read about the Face Reality Acne Program <span>→</span>
          </a>
        </div>
      </div>

      {packages.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {packages.map((pkg) => (
            <TreatmentPackageCard pkg={pkg} objectId={pkg._id} />
          ))}
        </div>
      ) : (
        <p class="text-muted text-[14px]">No treatment packages are currently published.</p>
      )}
    </div>
  </section>

  <!-- Booking CTA -->
  <section id="book" class="bg-charcoal-light py-[clamp(56px,8vw,88px)] px-6 border-t border-gold-metal/10">
    <div class="max-w-[680px] mx-auto text-center">
      <span class="kicker">Questions</span>
      <h2 class="font-serif text-[clamp(28px,5vw,44px)] text-ink leading-tight mb-4">
        Want to see what the 12 weeks include?
      </h2>
      <p class="text-muted text-[15px] max-w-[450px] mx-auto mb-10 leading-relaxed">
        Read the complete program details, or call House of Rose with a question about the consultation, visit schedule, or price.
      </p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="/packages/face-reality-12-week-program/" class="btn-gold">
          Review Acne Bootcamp
        </a>
        <a href="tel:+18449417673" class="btn-outline-gold">
          (844) 941-7673
        </a>
      </div>
      <p class="text-muted text-[11px] tracking-[0.26em] uppercase mt-8 leading-relaxed">
        525 E Olympia Ave, Unit 9<br />Punta Gorda, FL 33950
      </p>
    </div>
  </section>
</BaseLayout>
