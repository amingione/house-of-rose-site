---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import TreatmentPackageCard from '@/components/TreatmentPackageCard.astro';
import { sanityFetch } from '@/lib/sanity';
import { ALL_TREATMENT_PACKAGES_QUERY, type TreatmentPackage } from '@/lib/queries';
import { FACE_REALITY_PROGRAM } from '@/lib/faceRealityEducation';

// Visual Editor: inline click-to-edit is delegated to <TreatmentPackageCard>, which
// emits the sbObjectId / sbFieldPath annotations when passed `objectId={pkg._id}`.

const packages = await sanityFetch<TreatmentPackage[]>(ALL_TREATMENT_PACKAGES_QUERY);
const heroImage = '/images/optimized/actual-welcome-1400.webp';
---

<BaseLayout
  title="Treatment Packages in Punta Gorda, FL"
  description="House of Rose's Face Reality Acne Bootcamp begins with a $99 consultation; the complete 12-week program is $899 with in-studio visits every two weeks."
  preloadImage={heroImage}
>
  <Hero
    title="Treatment Packages"
    kicker="House of Rose Aesthetics"
    description="See the Face Reality consultation, 12-week schedule, program price, and home-care purchase in one place."
    size="small"
    backgroundImage={heroImage}
    imageAlt="A treatment room at House of Rose Aesthetics"
  />

  <section class="bg-charcoal py-[clamp(48px,7vw,88px)] px-6">
    <div class="max-w-[1280px] mx-auto">
      <div class="max-w-[700px] mb-10">
        <span class="kicker">The current program</span>
        <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ink mt-2 mb-4">
          Acne Bootcamp follows the skin across 12 weeks.
        </h2>
        <div class="space-y-4 text-muted text-[15px] leading-[1.75]">
          <p>
            Acne can look different from one visit to the next. House of Rose's Face Reality Acne Bootcamp connects the consultation, in-studio appointments, and home-care review across 12 weeks.
          </p>
          <p>
            The $99, 60-minute Acne Bootcamp Consultation is the first appointment and can be booked directly. Visits take place every two weeks. The complete 12-week program is $899 and includes its in-studio visits; home-care products are purchased separately.
          </p>
          <a href="/services/face-reality-acne-program/" class="learn-more inline-flex items-center gap-1">
            See the Face Reality consultation and program <span>→</span>
          </a>
        </div>
      </div>

      <aside data-package-provider-safety class="mb-12 grid gap-px border border-gold-metal/10 bg-gold-metal/10 md:grid-cols-2" aria-label="Face Reality provider and medical boundary">
        <div class="bg-charcoal p-7 sm:p-8">
          <span class="kicker">Provider</span>
          <h3 class="mt-3 font-serif text-[24px] leading-tight text-ink">Who provides the program?</h3>
          <p class="mt-4 text-[14px] leading-[1.75] text-muted">
            Amber Mingione, Licensed Esthetician and Face Reality Certified Acne Specialist, provides the Acne Bootcamp Consultation and the complete 12-week program.
          </p>
        </div>
        <div class="bg-charcoal p-7 sm:p-8">
          <span class="kicker">When to seek medical care</span>
          <h3 class="mt-3 font-serif text-[24px] leading-tight text-ink">Some breakouts need medical evaluation first.</h3>
          <p class="mt-4 text-[14px] leading-[1.75] text-muted">
            {FACE_REALITY_PROGRAM.medicalBoundary}
          </p>
        </div>
      </aside>

      {packages.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {packages.map((pkg) => (
            <TreatmentPackageCard pkg={pkg} objectId={pkg._id} />
          ))}
        </div>
      ) : (
        <p class="text-muted text-[14px]">No treatment packages are currently published.</p>
      )}
    </div>
  </section>

  <!-- Booking CTA -->
  <section id="book" class="bg-charcoal-light py-[clamp(56px,8vw,88px)] px-6 border-t border-gold-metal/10">
    <div class="max-w-[680px] mx-auto text-center">
      <span class="kicker">First appointment</span>
      <h2 class="font-serif text-[clamp(28px,5vw,44px)] text-ink leading-tight mb-4">
        Begin with the $99 Acne Bootcamp Consultation.
      </h2>
      <p class="text-muted text-[15px] max-w-[450px] mx-auto mb-10 leading-relaxed">
        This 60-minute appointment can be booked directly. Call House of Rose if you want to ask about the visit schedule, program price, or home-care purchase before beginning.
      </p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="/packages/face-reality-12-week-program/" class="btn-gold">
          See the complete 12-week program
        </a>
        <a href="tel:+18449417673" class="btn-outline-gold">
          (844) 941-7673
        </a>
      </div>
      <p class="text-muted text-[11px] tracking-[0.26em] uppercase mt-8 leading-relaxed">
        525 E Olympia Ave, Unit 9<br />Punta Gorda, FL 33950
      </p>
    </div>
  </section>
</BaseLayout>
