---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import TreatmentPackageCard from '@/components/TreatmentPackageCard.astro';
import { sanityFetch } from '@/lib/sanity';
import { ALL_TREATMENT_PACKAGES_QUERY, type TreatmentPackage } from '@/lib/queries';

// Visual Editor: inline click-to-edit is delegated to <TreatmentPackageCard>, which
// emits the sbObjectId / sbFieldPath annotations when passed `objectId={pkg._id}`.

const packages = await sanityFetch<TreatmentPackage[]>(ALL_TREATMENT_PACKAGES_QUERY);
const heroImage = '/images/house-of-rose/space/luxury-reception-lobby-hero.webp';
---

<BaseLayout
  title="Treatment Series & Packages in Punta Gorda, FL"
  description="Explore verified treatment series and packages at House of Rose in Punta Gorda. Your provider confirms candidacy, sequencing, and current investment."
  preloadImage={heroImage}
>
  <Hero
    title="Treatment Series & Packages"
    kicker="Consultation-Led Planning"
    size="small"
    backgroundImage={heroImage}
  />

  <section class="bg-charcoal py-[clamp(48px,7vw,88px)] px-6">
    <div class="max-w-[1280px] mx-auto">
      <div class="max-w-[700px] mb-12">
        <span class="kicker">Planned With Intention</span>
        <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ink mt-2 mb-4">
          Treatments, thoughtfully combined.
        </h2>
        <p class="text-muted text-[15px] leading-[1.75]">
          Each published option follows a verified treatment protocol or combines compatible services around one clear goal. Your provider confirms candidacy, sequencing, and current investment before you begin.
        </p>
      </div>

      {packages.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {packages.map((pkg) => (
            <TreatmentPackageCard pkg={pkg} objectId={pkg._id} />
          ))}
        </div>
      ) : (
        <p class="text-muted text-[14px]">No treatment series are currently published. Begin with a consultation for an individualized treatment map.</p>
      )}
    </div>
  </section>

  <!-- Booking CTA -->
  <section id="book" class="bg-charcoal-light py-[clamp(56px,8vw,88px)] px-6 border-t border-gold-metal/10">
    <div class="max-w-[680px] mx-auto text-center">
      <span class="kicker">Begin With Clarity</span>
      <h2 class="font-serif text-[clamp(28px,5vw,44px)] text-ink leading-tight mb-4">
        Begin with a skin consultation.
      </h2>
      <p class="text-muted text-[15px] max-w-[450px] mx-auto mb-10 leading-relaxed">
        Meet with the appropriate provider to review your goals, candidacy, and the sequence that makes sense for you.
      </p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="tel:+18449417673" class="btn-outline-gold">
          (844) 941-7673
        </a>
        <a href="https://houseofrose.glossgenius.com/services" target="_blank" rel="noopener noreferrer" class="btn-gold">
          Book Online
        </a>
      </div>
      <p class="text-muted text-[11px] tracking-[0.26em] uppercase mt-8 leading-relaxed">
        525 E Olympia Ave, Unit 9<br />Punta Gorda, FL 33950
      </p>
    </div>
  </section>
</BaseLayout>
