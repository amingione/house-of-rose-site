---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import TreatmentPackageCard from '@/components/TreatmentPackageCard.astro';
import { sanityFetch } from '@/lib/sanity';
import { ALL_TREATMENT_PACKAGES_QUERY, type TreatmentPackage } from '@/lib/queries';
import { FACE_REALITY_PROGRAM } from '@/lib/faceRealityEducation';
import { breadcrumbList, itemListPage } from '@/lib/structuredData';
import { getPackageServiceSlugs, getPublicServiceRefs } from '@/lib/serviceCatalog';

// Visual Editor: inline click-to-edit is delegated to <TreatmentPackageCard>, which
// emits the sbObjectId / sbFieldPath annotations when passed `objectId={pkg._id}`.

const packageData = await sanityFetch<TreatmentPackage[]>(ALL_TREATMENT_PACKAGES_QUERY);
const packages: TreatmentPackage[] = packageData.map((pkg) => ({
  ...pkg,
  servicesIncluded: getPublicServiceRefs(
    pkg.serviceSlugs ?? getPackageServiceSlugs(pkg.slug),
  ),
}));
const heroImage = '/images/optimized/actual-welcome-1400.webp';
const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonical = new URL(Astro.url.pathname, site).toString();
const pageTitle = 'Treatment Packages in Punta Gorda, FL';
const pageDescription = "House of Rose's Face Reality Acne Bootcamp follows the skin across 12 weeks with in-studio care every two weeks and daily home care.";
const packagesSchema = itemListPage(
  {
    name: 'Treatment Packages',
    description: pageDescription,
    url: canonical,
    items: packages.map((pkg) => ({
      name: pkg.title,
      url: new URL(`/packages/${pkg.slug}/`, site).toString(),
    })),
  },
  site,
);
const breadcrumb = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'Treatment Packages', item: canonical },
]);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  preloadImage={heroImage}
  structuredPageType="CollectionPage"
  structuredPageMainEntityId={`${canonical}#itemlist`}
>
  <SchemaMarkup item={packagesSchema} slot="head" />
  <SchemaMarkup item={breadcrumb} slot="head" />

  <Hero
    title="Treatment Packages"
    kicker="House of Rose Aesthetics"
    description="Learn how the Face Reality 12-week program connects in-studio care, daily home care, and progress reviews."
    size="small"
    backgroundImage={heroImage}
    imageAlt="A treatment room at House of Rose Aesthetics"
  />

  <section class="bg-charcoal py-[clamp(48px,7vw,88px)] px-6">
    <div class="max-w-[1280px] mx-auto">
      <div class="max-w-[700px] mb-10">
        <span class="kicker">The current program</span>
        <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ink mt-2 mb-4">
          Acne Bootcamp follows the skin across 12 weeks.
        </h2>
        <div class="space-y-4 text-muted text-[15px] leading-[1.75]">
          <p>
            Acne can look different from one visit to the next. House of Rose's Face Reality Acne Bootcamp connects in-studio care, daily home care, and progress reviews across 12 weeks.
          </p>
          <p>
            The program begins with a review of what the skin is doing now. In-studio care takes place every two weeks, with daily home care between visits. Home-care products are purchased separately.
          </p>
          <a href="/services/face-reality-acne-program/" class="learn-more inline-flex items-center gap-1">
            See how the Face Reality program works <span>→</span>
          </a>
        </div>
      </div>

      <aside data-package-provider-safety class="mb-12 grid gap-px border border-gold-metal/10 bg-gold-metal/10 md:grid-cols-2" aria-label="Face Reality provider and medical boundary">
        <div class="bg-charcoal p-7 sm:p-8">
          <span class="kicker">Provider</span>
          <h3 class="mt-3 font-serif text-[24px] leading-tight text-ink">Who provides the program?</h3>
          <p class="mt-4 text-[14px] leading-[1.75] text-muted">
            Amber Mingione, Licensed Esthetician and Face Reality Certified Acne Specialist, provides the Acne Bootcamp Consultation and the complete 12-week program.
          </p>
        </div>
        <div class="bg-charcoal p-7 sm:p-8">
          <span class="kicker">When to seek medical care</span>
          <h3 class="mt-3 font-serif text-[24px] leading-tight text-ink">Some breakouts need medical evaluation first.</h3>
          <p class="mt-4 text-[14px] leading-[1.75] text-muted">
            {FACE_REALITY_PROGRAM.medicalBoundary}
          </p>
        </div>
      </aside>

      {packages.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {packages.map((pkg) => (
            <TreatmentPackageCard pkg={pkg} objectId={pkg._id} />
          ))}
        </div>
      ) : (
        <p class="text-muted text-[14px]">Call House of Rose to ask about multi-visit treatment programs.</p>
      )}
    </div>
  </section>

  <section id="contact" class="bg-charcoal-light py-[clamp(56px,8vw,88px)] px-6 border-t border-gold-metal/10">
    <div class="max-w-[680px] mx-auto text-center">
      <span class="kicker">Face Reality Acne Bootcamp</span>
      <h2 class="font-serif text-[clamp(28px,5vw,44px)] text-ink leading-tight mb-4">
        See what twelve weeks of consistent care involves.
      </h2>
      <p class="text-muted text-[15px] max-w-[450px] mx-auto mb-10 leading-relaxed">
        Face Reality Acne Bootcamp combines visits every two weeks with daily home care and progress reviews across 12 weeks.
      </p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="/packages/face-reality-12-week-program/" class="btn-gold">
          See the complete 12-week program
        </a>
        <a href="tel:+19414000165" class="btn-outline-gold">
          (941) 400-0165
        </a>
      </div>
      <p class="text-muted text-[11px] tracking-[0.26em] uppercase mt-8 leading-relaxed">
        525 E Olympia Ave, Unit 9<br />Punta Gorda, FL 33950
      </p>
    </div>
  </section>
</BaseLayout>
