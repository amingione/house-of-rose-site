---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sanityFetch } from '@/lib/sanity';
import { sbObjectId, sbFieldPath } from '@/lib/visualEditing';

// ─── Thank You content from Sanity (singleton) ──────────────────────────────────
// Falls back to the original copy if a field is empty, so there's no regression.
interface ThankYou {
  _id?: string;
  kicker?: string;
  heading?: string;
  paragraph1?: string;
  paragraph2?: string;
  ctaPrimaryText?: string;
  ctaSecondaryText?: string;
  seoTitle?: string;
  seoDescription?: string;
}

const data =
  (await sanityFetch<ThankYou | null>(
    `*[_type=="thankYou"][0]{ _id, kicker, heading, paragraph1, paragraph2, ctaPrimaryText, ctaSecondaryText, seoTitle, seoDescription }`,
  )) ?? ({} as ThankYou);
const paragraph2 = (data.paragraph2 ?? "In the meantime, you're welcome to review our current services.")
  .replace(/book directly online/gi, 'review our current services')
  .replace(/review the services menu/gi, 'review our current services');
const servicesCta = /book|schedule/i.test(data.ctaSecondaryText ?? '')
  ? 'View Services'
  : (data.ctaSecondaryText ?? 'View Services');
---

<BaseLayout
  title={data.seoTitle ?? 'Thank You | House of Rose Aesthetics'}
  description={data.seoDescription ?? "Thank you for reaching out to House of Rose. We'll be in touch shortly."}
  noindex
  nofollow
>

  <section class="bg-charcoal min-h-[70vh] flex items-center justify-center px-6 py-24">
    <div class="max-w-[560px] mx-auto text-center" {...(data._id ? sbObjectId(data._id) : {})}>

      <!-- Rose motif -->
      <div class="mb-8 flex justify-center">
        <div class="w-16 h-px bg-gold-metal/40 self-center"></div>
        <span class="mx-4 text-gold text-2xl leading-none">✦</span>
        <div class="w-16 h-px bg-gold-metal/40 self-center"></div>
      </div>

      <span class="block text-gold text-[11px] font-medium tracking-[0.26em] uppercase mb-6" {...sbFieldPath('kicker')}>
        {data.kicker ?? 'Message Received'}
      </span>

      <h1 class="font-serif text-[clamp(32px,5vw,48px)] text-ink font-normal leading-tight mb-6" {...sbFieldPath('heading')}>
        {data.heading ?? 'Thank you for reaching out.'}
      </h1>

      <p class="text-muted text-[16px] leading-relaxed mb-4" {...sbFieldPath('paragraph1')}>
        {data.paragraph1 ?? "We've received your message. Our team will follow up as soon as possible."}
      </p>

      <p class="text-muted text-[14px] leading-relaxed mb-12" {...sbFieldPath('paragraph2')}>
        {paragraph2}
      </p>

      <div class="flex gap-3 justify-center flex-wrap">
        <a href="/" class="btn-outline-gold" {...sbFieldPath('ctaPrimaryText')}>
          {data.ctaPrimaryText ?? 'Back to Home'}
        </a>
        <a
          href="https://houseofrose.glossgenius.com/services"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-gold"
          {...sbFieldPath('ctaSecondaryText')}
        >
          {servicesCta}
        </a>
      </div>

      <div class="mt-16 w-16 h-px bg-gold-metal/20 mx-auto"></div>

    </div>
  </section>

  <script>
    import { dispatchMeasurement, getConsent, updateOpenAIAdsUser } from '@/lib/measurement';

    const params = new URLSearchParams(window.location.search);
    const receipt = params.get('receipt');

    if (receipt) {
      // Remove the receipt before another same-origin request or navigation can
      // include it in a referrer. Verification keeps using the captured value.
      history.replaceState({}, '', '/thank-you/');
      const sourceUrl = window.location.href;
      void fetch('/.netlify/functions/verify-lead-conversion', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ receipt, sourceUrl }),
      }).then(async (response) => {
        if (!response.ok) return;
        const result = (await response.json()) as {
          event?: string;
          eventId?: string;
          emailSha256?: string;
        };
        if (result.event === 'generate_lead' && result.eventId) {
          await updateOpenAIAdsUser({ emailSha256: result.emailSha256 });
          dispatchMeasurement({ event: 'generate_lead', event_id: result.eventId });
          const consent = getConsent();
          if (
            consent.ad_storage === 'granted' &&
            consent.ad_personalization === 'granted' &&
            typeof window.fbq === 'function'
          ) {
            window.fbq('track', 'Lead');
          }
        }
      }).catch(() => {
        // The thank-you experience remains successful even if measurement is unavailable.
      });
    }

    declare global {
      interface Window {
        fbq?: (...args: unknown[]) => void;
      }
    }
  </script>
</BaseLayout>
