---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sanityFetch } from '@/lib/sanity';
import { sbObjectId } from '@/lib/visualEditing';

// ─── Thank You content from Sanity (singleton) ──────────────────────────────────
// Falls back to the original copy if a field is empty, so there's no regression.
interface ThankYou {
  _id?: string;
  kicker?: string;
  heading?: string;
  paragraph1?: string;
  paragraph2?: string;
  ctaPrimaryText?: string;
  ctaSecondaryText?: string;
  seoTitle?: string;
  seoDescription?: string;
}

const data =
  (await sanityFetch<ThankYou | null>(
    `*[_type=="thankYou"][0]{ _id, kicker, heading, paragraph1, paragraph2, ctaPrimaryText, ctaSecondaryText, seoTitle, seoDescription }`,
  )) ?? ({} as ThankYou);
---

<BaseLayout
  title="Message Received | House of Rose Aesthetics"
  description="Confirmation that House of Rose Aesthetics received your message."
  noindex
  nofollow
>

  <section class="bg-charcoal min-h-[70vh] flex items-center justify-center px-6 py-24">
    <div class="max-w-[560px] mx-auto text-center" {...(data._id ? sbObjectId(data._id) : {})}>

      <!-- Rose motif -->
      <div class="mb-8 flex justify-center">
        <div class="w-16 h-px bg-gold-metal/40 self-center"></div>
        <span class="mx-4 text-gold text-2xl leading-none">✦</span>
        <div class="w-16 h-px bg-gold-metal/40 self-center"></div>
      </div>

      <span class="block text-gold text-[11px] font-medium tracking-[0.26em] uppercase mb-6">
        Confirmation
      </span>

      <h1 class="font-serif text-[clamp(32px,5vw,48px)] text-ink font-normal leading-tight mb-6">
        Your message was sent.
      </h1>

      <div class="mb-12 space-y-4 text-muted text-[16px] leading-relaxed">
        <p>House of Rose typically replies within one business day, Monday through Friday.</p>
        <p>
          This confirmation means your form was received. It does not reserve an appointment, treatment time, or rental suite. House of Rose will contact you about the next step for your request.
        </p>
      </div>

      <aside class="mb-12 border-y border-gold-metal/20 py-6 text-left" aria-labelledby="time-sensitive-message-heading">
        <h2 id="time-sensitive-message-heading" class="font-serif text-[23px] text-ink">
          If your message is time-sensitive.
        </h2>
        <p class="mt-3 text-[14px] leading-[1.75] text-muted">
          For a same-day appointment change or an unexpected change after a House of Rose appointment, call <a href="tel:+18449417673" class="text-gold hover:underline">(844) 941-7673</a> Monday through Friday, 9 AM–5 PM ET, instead of waiting for the routine reply. If you believe you are having a medical emergency, call 911 or seek emergency care.
        </p>
      </aside>

      <div class="flex gap-3 justify-center flex-wrap">
        <a href="/" class="btn-outline-gold">
          Home
        </a>
        <a
          href="/services/"
          class="btn-gold"
        >
          Browse services
        </a>
      </div>

      <div class="mt-16 w-16 h-px bg-gold-metal/20 mx-auto"></div>

    </div>
  </section>

  <script>
    import { dispatchMeasurement, getConsent, updateOpenAIAdsUser } from '@/lib/measurement';

    const params = new URLSearchParams(window.location.search);
    const receipt = params.get('receipt');

    if (receipt) {
      // Remove the receipt before another same-origin request or navigation can
      // include it in a referrer. Verification keeps using the captured value.
      history.replaceState({}, '', '/thank-you/');
      const sourceUrl = window.location.href;
      void fetch('/.netlify/functions/verify-lead-conversion', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ receipt, sourceUrl }),
      }).then(async (response) => {
        if (!response.ok) return;
        const result = (await response.json()) as {
          event?: string;
          eventId?: string;
          emailSha256?: string;
        };
        if (result.event === 'generate_lead' && result.eventId) {
          await updateOpenAIAdsUser({ emailSha256: result.emailSha256 });
          dispatchMeasurement({ event: 'generate_lead', event_id: result.eventId });
          const consent = getConsent();
          if (
            consent.ad_storage === 'granted' &&
            consent.ad_personalization === 'granted' &&
            typeof window.fbq === 'function'
          ) {
            window.fbq('track', 'Lead');
          }
        }
      }).catch(() => {
        // The thank-you experience remains successful even if measurement is unavailable.
      });
    }

    declare global {
      interface Window {
        fbq?: (...args: unknown[]) => void;
      }
    }
  </script>
</BaseLayout>
