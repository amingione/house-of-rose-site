---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sanityFetch } from '@/lib/sanity';
import { sbObjectId, sbFieldPath } from '@/lib/visualEditing';

// ─── Thank You content from Sanity (singleton) ──────────────────────────────────
// Falls back to the original copy if a field is empty, so there's no regression.
interface ThankYou {
  _id?: string;
  kicker?: string;
  heading?: string;
  paragraph1?: string;
  paragraph2?: string;
  ctaPrimaryText?: string;
  ctaSecondaryText?: string;
  seoTitle?: string;
  seoDescription?: string;
}

const data =
  (await sanityFetch<ThankYou | null>(
    `*[_type=="thankYou"][0]{ _id, kicker, heading, paragraph1, paragraph2, ctaPrimaryText, ctaSecondaryText, seoTitle, seoDescription }`,
  )) ?? ({} as ThankYou);
---

<BaseLayout
  title={data.seoTitle ?? 'Thank You | House of Rose Aesthetics'}
  description={data.seoDescription ?? "Thank you for reaching out to House of Rose. We'll be in touch shortly."}
  noindex
  nofollow
>

  <section class="bg-charcoal min-h-[70vh] flex items-center justify-center px-6 py-24">
    <div class="max-w-[560px] mx-auto text-center" {...(data._id ? sbObjectId(data._id) : {})}>

      <!-- Rose motif -->
      <div class="mb-8 flex justify-center">
        <div class="w-16 h-px bg-gold-metal/40 self-center"></div>
        <span class="mx-4 text-gold text-2xl leading-none">✦</span>
        <div class="w-16 h-px bg-gold-metal/40 self-center"></div>
      </div>

      <span class="block text-gold text-[11px] font-medium tracking-[0.26em] uppercase mb-6" {...sbFieldPath('kicker')}>
        {data.kicker ?? 'Message Received'}
      </span>

      <h1 class="font-serif text-[clamp(32px,5vw,48px)] text-ink font-normal leading-tight mb-6" {...sbFieldPath('heading')}>
        {data.heading ?? 'Thank you for reaching out.'}
      </h1>

      <p class="text-muted text-[16px] leading-relaxed mb-4" {...sbFieldPath('paragraph1')}>
        {data.paragraph1 ?? "We've received your message. Our team will follow up as soon as possible."}
      </p>

      <p class="text-muted text-[14px] leading-relaxed mb-12" {...sbFieldPath('paragraph2')}>
        {data.paragraph2 ?? "In the meantime, you're welcome to browse our services or book directly online."}
      </p>

      <div class="flex gap-3 justify-center flex-wrap">
        <a href="/" class="btn-outline-gold" {...sbFieldPath('ctaPrimaryText')}>
          {data.ctaPrimaryText ?? 'Back to Home'}
        </a>
        <a
          href="https://houseofrose.glossgenius.com/book"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-gold"
          {...sbFieldPath('ctaSecondaryText')}
        >
          {data.ctaSecondaryText ?? 'Book Online'}
        </a>
      </div>

      <div class="mt-16 w-16 h-px bg-gold-metal/20 mx-auto"></div>

    </div>
  </section>
</BaseLayout>

<script>
  interface AnalyticsWindow extends Window {
    gtag?: (command: 'event', eventName: string, params?: Record<string, string>) => void;
  }

  const params = new URLSearchParams(window.location.search);
  const leadType = params.get('lead');
  const allowedLeadTypes = new Set(['contact', 'suiteRental', 'skinAnalysis']);

  if (leadType && allowedLeadTypes.has(leadType)) {
    const eventKey = `hor_generate_lead_${leadType}`;
    if (!sessionStorage.getItem(eventKey)) {
      (window as AnalyticsWindow).gtag?.('event', 'generate_lead', {
        lead_type: leadType,
        page_location: '/thank-you/',
      });
      sessionStorage.setItem(eventKey, '1');
    }
  }
</script>
