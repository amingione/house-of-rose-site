---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import ProductCard from '@/components/shop/ProductCard.astro';
import { sanityFetch, urlFor } from '@/lib/sanity';
import { sbObjectId, sbFieldPath } from '@/lib/visualEditing';
import { getProductPurchaseCta, getAddToCartCta } from '@/lib/shopCta';
import { DEFAULT_PRODUCT_IMAGE } from '@/lib/imageFallbacks';
import {
  ALL_PRODUCT_SLUGS_QUERY,
  PRODUCT_BY_SLUG_QUERY,
  type Product,
} from '@/lib/queries';
import { product as productJsonLd } from '@/lib/structuredData';
import { toCanonicalProduct } from '@/lib/productContract';

export async function getStaticPaths() {
  const slugs = await sanityFetch<{ slug: string }[]>(ALL_PRODUCT_SLUGS_QUERY);
  return slugs.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const product = await sanityFetch<Product>(PRODUCT_BY_SLUG_QUERY, { slug });

// Every slug here comes straight from getStaticPaths (i.e. from Sanity), so a miss is a
// data-integrity bug, not a runtime 404 — fail the build loudly instead of redirecting.
// NOTE: do NOT `return Astro.redirect()` from this page. Returning a Response from a
// prerendered route in `output: 'static'` prevents Astro from emitting the sibling
// /shop index chunk (dist/pages/shop.astro.mjs), which breaks the whole build.
if (!product) {
  throw new Error(`[shop/[slug]] No product found in Sanity for slug "${slug}"`);
}
const canonicalProduct = toCanonicalProduct(product);

const formatPrice = (cents?: number): string =>
  typeof cents === 'number' ? `$${(cents / 100).toFixed(cents % 100 === 0 ? 0 : 2)}` : '';

// CTA precedence:
//   1. priced + in stock            → native cart (Stripe checkout on our own site)
//   2. purchaseUrl                  → external link (brand storefront / gift card portal)
//   3. neither                      → call to order
// `purchaseUrl` is now the ESCAPE HATCH, not the default — see docs/CHECKOUT.md.
const canBuy = canonicalProduct.purchasable;
const hasCheckout = Boolean(product.purchaseUrl);
// Add-to-cart is an action → say what it does. purchaseUrl is a link → evocative is fine.
const ctaLabel = canBuy
  ? getAddToCartCta(product)
  : hasCheckout
    ? getProductPurchaseCta(product)
    : null;
const cartImage = product.image
  ? urlFor(product.image).width(144).height(144).fit('crop').url()
  : DEFAULT_PRODUCT_IMAGE;
const productImage = product.image
  ? urlFor(product.image).width(800).height(800).fit('crop').url()
  : DEFAULT_PRODUCT_IMAGE;

const BRAND_TITLES: Record<string, string> = {
  procell: 'Procell Therapies',
  glymed: 'GlyMed+',
  'skin-script': 'Skin Script',
  'face-reality': 'Face Reality',
  'house-of-rose': 'House of Rose',
};

const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonicalURL = new URL(Astro.url.pathname, site);

const productSchema = productJsonLd({
  name: product.title,
  description: product.description ?? product.tagline ?? undefined,
  url: canonicalURL.toString(),
  image: product.image ? urlFor(product.image).width(1200).height(1200).fit('crop').url() : undefined,
  additionalImages: product.additionalImages?.map((image) =>
    urlFor(image).width(1200).height(1200).fit('crop').url()),
  brand: product.brandName ?? (product.brand ? (BRAND_TITLES[product.brand] ?? product.brand) : undefined),
  sku: canonicalProduct.itemId,
  gtin: product.gtin,
  mpn: product.mpn,
  identifierExists: product.identifierExists,
  condition: product.condition,
  price: canonicalProduct.unitPriceCents !== undefined ? canonicalProduct.unitPriceCents / 100 : undefined,
  availability: canonicalProduct.availability,
  offerUrl: product.purchaseUrl ?? undefined,
});
const productMeasurement = {
  item_id: canonicalProduct.itemId,
  item_name: canonicalProduct.itemName,
  item_brand: canonicalProduct.brand,
  item_category: canonicalProduct.category,
  price: canonicalProduct.unitPriceCents !== undefined ? canonicalProduct.unitPriceCents / 100 : undefined,
  quantity: 1,
};
---

<BaseLayout
  title={`${product.title} | House of Rose Shop`}
  description={product.tagline ?? product.description?.slice(0, 155) ?? `${product.title} — available at House of Rose Aesthetics, Punta Gorda, FL.`}
  image={productImage}
  preloadImage={productImage}
>
  <Fragment slot="head">
    <SchemaMarkup item={productSchema} />
  </Fragment>

  <section class="bg-charcoal pt-[clamp(96px,12vw,140px)] pb-[clamp(48px,7vw,80px)] px-6">
    <div class="max-w-[1120px] mx-auto">
      <a href="/shop/" class="text-muted text-[12px] tracking-[0.14em] uppercase hover:text-gold transition-colors duration-200 mb-8 inline-block" data-reveal="left" data-speed="fast">
        ← Back to Shop
      </a>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start" {...sbObjectId(product._id)}>
        <div class="aspect-square overflow-hidden bg-charcoal-lighter relative" data-reveal="left">
            {product.badge && (
              <span class="absolute top-5 left-5 z-10 bg-gold-metal text-ink text-[10px] font-medium tracking-[0.14em] uppercase px-2.5 py-1" {...sbFieldPath('badge')}>
                {product.badge}
              </span>
            )}
            <img
              src={productImage}
              alt={product.image?.alt ?? product.title}
              width={800}
              height={800}
              class="w-full h-full object-cover"
            />
          </div>

        <div data-reveal="right">
          {product.brand && <span class="kicker">{BRAND_TITLES[product.brand] ?? product.brand}</span>}
          <h1 class="font-serif text-[clamp(28px,4vw,42px)] text-ink mt-2 mb-3" {...sbFieldPath('title')}>{product.title}</h1>
          {product.tagline && <p class="text-muted text-[16px] leading-[1.7] mb-6" {...sbFieldPath('tagline')}>{product.tagline}</p>}

          <p class="text-ink text-[18px] tracking-[0.1em] uppercase mb-8">
            <span {...sbFieldPath('price')}>{formatPrice(product.price)}</span>
            {product.size && <span class="text-muted normal-case tracking-normal text-[14px]"> · {product.size}</span>}
          </p>

          {product.description && (
            <p class="text-muted text-[15px] leading-[1.8] mb-8 whitespace-pre-line" {...sbFieldPath('description')}>
              {product.description}
            </p>
          )}

          {canBuy ? (
            <button
              type="button"
              class="btn-gold w-full sm:w-auto"
              data-add-to-cart
              data-product-id={product._id}
              data-sku={canonicalProduct.itemId}
              data-title={product.title}
              data-slug={product.slug}
              data-price={String(canonicalProduct.unitPriceCents)}
              data-image={cartImage}
              data-size={product.size ?? ''}
            >
              {ctaLabel}
            </button>
          ) : hasCheckout ? (
            <a href={product.purchaseUrl} target="_blank" rel="noopener noreferrer" class="btn-gold">
              {ctaLabel}
            </a>
          ) : (
            <a href="tel:+18449417673" class="btn-gold">Call to Order — (844) 941-7673</a>
          )}
          {product.inStock === false && (
            <p class="text-muted text-[12px] mt-4 uppercase tracking-[0.12em]">Currently out of stock — call to check availability.</p>
          )}
        </div>
      </div>
    </div>
  </section>

  {product.relatedProducts && product.relatedProducts.length > 0 && (
    <section class="bg-charcoal-light py-[clamp(40px,6vw,64px)] px-6 border-t border-gold-metal/10">
      <div class="max-w-[1120px] mx-auto">
        <div class="mb-10" data-reveal="bottom" data-speed="fast">
          <span class="kicker">More from {product.brand ? BRAND_TITLES[product.brand] ?? product.brand : 'the shop'}</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-px bg-gold-metal/10" data-stagger="80">
          {product.relatedProducts.map((related) => (
            <ProductCard product={related} reveal="bottom" />
          ))}
        </div>
      </div>
    </section>
  )}
  <script
    id="product-measurement-data"
    type="application/json"
    is:inline
    set:html={JSON.stringify(productMeasurement)}
  ></script>
  <script>
    import { dispatchMeasurement, type RetailItem } from '@/lib/measurement';

    const measurementData = document.getElementById('product-measurement-data');
    if (measurementData?.textContent) {
      const item = JSON.parse(measurementData.textContent) as RetailItem;
      dispatchMeasurement({
        event: 'view_item',
        ecommerce: {
          currency: 'USD',
          value: item.price,
          items: [item],
        },
      });
    }
  </script>
</BaseLayout>
