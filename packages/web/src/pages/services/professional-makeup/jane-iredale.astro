---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import { sanityFetch } from '@/lib/sanity';
import { sbObjectId, sbFieldPath, sbFieldPathParts } from '@/lib/visualEditing';
import {
  JANE_IREDALE_PAGE_QUERY,
  type JaneIredalePage,
  type JaneIredalePillar,
  type JaneIredaleSwap,
  type SignatureLook,
  type LinkRef,
  type FAQ,
} from '@/lib/queries';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import { brand, breadcrumbList, faqPage } from '@/lib/structuredData';

const PHONE_DISPLAY = '(844) 941-7673';
const PHONE_TEL = 'tel:+18449417673';

const data =
  (await sanityFetch<JaneIredalePage | null>(JANE_IREDALE_PAGE_QUERY)) ??
  ({} as JaneIredalePage);

// ── Fallbacks ────────────────────────────────────────────────────────────────
const FALLBACK_PILLARS: JaneIredalePillar[] = [
  {
    name: 'Makeup',
    body:
      'The heart of the line — mineral foundations, concealers, color, and lip that are formulated to benefit skin while they perfect it. Built on micronized minerals, made without talc, and buildable from a sheer veil to full, camera-ready coverage.',
    examples: ['PurePressed Base Mineral Foundation', 'Amazing Base Loose Mineral Powder', 'Glow Time Full Coverage BB Cream', 'HydroPure Hyaluronic Acid Lip Gloss'],
  },
  {
    name: 'Skincare',
    body:
      'The BeautyPrep range — cleanser, toner, hyaluronic serum, and moisturizer — plus mineral SPF, designed to prep and support the skin the makeup sits on.',
    examples: ['BeautyPrep Face Cleanser', 'BeautyPrep Hyaluronic Serum', 'BeautyPrep Face Moisturizer', 'Dream Tint Tinted Moisturizer SPF 15'],
  },
  {
    name: 'Supplements',
    body:
      'An ingestible "beauty from within" range (the Advanced Nutrition Programme, distributed by Jane Iredale) supporting skin from the inside as part of a daily routine.',
    examples: ['Skin Ultimate', 'Skin Omegas', 'Skin Youth Biome'],
  },
];

const FALLBACK_BENEFITS: string[] = [
  'Built on micronized minerals — made without talc, parabens, or synthetic fragrance',
  'Non-comedogenic and breathable — designed to let skin function normally',
  'Many base products carry broad-spectrum mineral (physical) SPF',
  'Buildable coverage that photographs cleanly, with no harsh flashback from a mineral base',
  'Cruelty-free — Leaping Bunny and PETA certified',
  'Comfortable, long-wearing finish for full-day and event wear',
];

const FALLBACK_SWAPS: JaneIredaleSwap[] = [
  { category: 'Primer', conventional: 'Silicone blurring primer', swap: 'Smooth Affair Facial Primer & Brightener', note: 'Smooths and preps so makeup lasts.' },
  { category: 'Foundation (pressed)', conventional: 'Pressed powder foundation', swap: 'PurePressed Base Mineral Foundation SPF 20/15', note: 'One step: foundation, concealer, mineral SPF.' },
  { category: 'Foundation (loose)', conventional: 'Loose mineral / bare powder', swap: 'Amazing Base Loose Mineral Powder SPF 20', note: 'Airy, luminous, minimal-ingredient base.' },
  { category: 'Foundation (liquid)', conventional: 'Liquid foundation', swap: 'Skintuition SPF 30 Radiance-Boosting Liquid Foundation', note: 'Skin-like finish with physical SPF 30.' },
  { category: 'Concealer', conventional: 'Under-eye concealer', swap: 'Enlighten Plus Under-Eye Concealer', note: 'Buildable, no caking or creasing.' },
  { category: 'Color correct', conventional: 'Correcting palette', swap: 'Circle\\Delete Under-Eye Concealer', note: 'Neutralizes redness and discoloration.' },
  { category: 'Setting powder', conventional: 'Translucent setting powder', swap: 'Amazing Matte Loose Finish Powder', note: 'Controls shine, sets makeup.' },
  { category: 'Setting spray', conventional: 'Setting / finishing spray', swap: 'POMMISST Hydration Spray', note: 'Antioxidant mist that sets makeup.' },
  { category: 'Bronzer / contour', conventional: 'Powder bronzer', swap: 'PureBronze Matte Bronzer', note: 'Warmth and soft contour.' },
  { category: 'Blush', conventional: 'Powder / cream blush', swap: 'ColorLuxe Liquid Blush', note: 'Brings life back to the complexion.' },
  { category: 'Highlighter', conventional: 'Cream / stick highlighter', swap: 'Glow Time Highlighter Stick', note: 'Buildable radiant finish.' },
  { category: 'Brows', conventional: 'Brow pencil + gel', swap: 'PureBrow Precision Pencil + PureBrow Brow Gel', note: 'Define and set naturally.' },
  { category: 'Eyeshadow', conventional: 'Pressed eyeshadow palette', swap: 'PurePressed Eye Shadow', note: 'Mineral mattes and shimmers.' },
  { category: 'Mascara', conventional: 'Volumizing mascara', swap: 'Longest Lash or Lash Fixation Tubing Mascara', note: 'Length and definition.' },
  { category: 'Lip', conventional: 'Liner + lipstick + gloss', swap: 'Lip Pencil + ColorLuxe Cream Lipstick + HydroPure Gloss', note: 'Hydrating, buildable lip.' },
];

// Anonymized signature looks (no client names/photos — before/after photos are
// gated on written consent; see build plan). Product breakdowns are educational.
const FALLBACK_LOOKS: SignatureLook[] = [
  {
    name: 'A Soft Radiant Everyday Look',
    summary:
      'Skin that looks like skin: light-to-medium radiant coverage, warm bronzer instead of flat contour, a peachy blush, soft brown eyes, and a rosy nude lip. Enhancement, not alteration.',
    steps: [
      { step: 'Prime', product: 'Smooth Affair Brightening Face Primer', shade: 'Brightening' },
      { step: 'Foundation', product: 'PurePressed Base Mineral Foundation', shade: 'Matched to undertone' },
      { step: 'Conceal', product: 'Enlighten Plus + Circle\\Delete', shade: 'No. 1 / No. 2' },
      { step: 'Set', product: 'Amazing Matte Loose Finish Powder', shade: 'T-zone only' },
      { step: 'Bronze & blush', product: 'Glow Time Bronzer Stick + ColorLuxe Liquid Blush', shade: 'Warm / soft rose' },
      { step: 'Eyes', product: 'PurePressed Eye Shadow (neutral trio) + Eye Pencil', shade: 'Soft brown' },
      { step: 'Lips', product: 'Lip Pencil + ColorLuxe Lipstick + HydroPure Gloss', shade: 'Rosy nude' },
    ],
  },
  {
    name: 'A Natural Event & Photography Look',
    summary:
      'Believable, camera-ready coverage that holds up through a long day. Light-to-medium radiant foundation, warm bronzer, satin finish, and slightly overlined nude lips for balance.',
    steps: [
      { step: 'Prime', product: 'Smooth Affair Brightening Face Primer', shade: 'Brightening' },
      { step: 'Foundation', product: 'Skintuition SPF 30 Liquid Foundation', shade: 'Neutral match' },
      { step: 'Conceal', product: 'Circle\\Delete + Enlighten Plus', shade: 'As needed' },
      { step: 'Bronze & contour', product: 'PureBronze Matte Bronzer', shade: 'Light / Medium' },
      { step: 'Cheeks', product: 'ColorLuxe Liquid Blush + Glow Time Highlighter Stick', shade: 'Warm peach / champagne' },
      { step: 'Eyes', product: 'PurePressed Eye Shadow + Lash Fixation Mascara', shade: 'Soft neutral, black lash' },
      { step: 'Lips', product: 'Lip Pencil + ColorLuxe Lipstick + HydroPure Gloss', shade: 'Nude, softly overlined' },
    ],
  },
];

const FALLBACK_LINKS: LinkRef[] = [
  { label: 'Professional Makeup', description: 'Our full makeup services and how to book.', href: '/services/professional-makeup/' },
  { label: 'Group & Event Bookings', description: 'Weddings and parties — in-studio or on location.', href: '/services/professional-makeup/events/' },
];

const FALLBACK_FAQS: FAQ[] = [
  {
    question: 'What is Jane Iredale makeup?',
    answer:
      'Jane Iredale is a professional mineral makeup brand known as "The Skincare Makeup." Founded in 1994, it is built on micronized minerals and formulated to benefit skin while it perfects it — makeup, skincare, and supplements in one line.',
  },
  {
    question: 'Why does House of Rose use Jane Iredale?',
    answer:
      'It is skin-first, non-comedogenic, and photographs beautifully — which makes it a favorite of professional artists for events and a comfortable choice for wear after a facial or skin treatment, confirmed with your provider.',
  },
  {
    question: 'Can I switch my everyday products to Jane Iredale?',
    answer:
      'Yes. Most steps in a conventional routine have a Jane Iredale equivalent — from primer and foundation to blush, brows, and lip. Our swap guide above maps the most common products to their Jane Iredale counterpart.',
  },
];

const pillars = data.pillars?.length ? data.pillars : FALLBACK_PILLARS;
const usingFallbackPillars = !data.pillars?.length;
const benefits = data.benefits?.length ? data.benefits : FALLBACK_BENEFITS;
const usingFallbackBenefits = !data.benefits?.length;
const swaps = data.swaps?.length ? data.swaps : FALLBACK_SWAPS;
const usingFallbackSwaps = !data.swaps?.length;
const looks = data.looks?.length ? data.looks : FALLBACK_LOOKS;
const usingFallbackLooks = !data.looks?.length;
const relatedLinks = data.relatedLinks?.length ? data.relatedLinks : FALLBACK_LINKS;
const usingFallbackLinks = !data.relatedLinks?.length;
const faqs = data.faqs?.length ? data.faqs : FALLBACK_FAQS;

const supplementDisclaimer =
  data.supplementDisclaimer ??
  'These statements have not been evaluated by the Food and Drug Administration. These products are not intended to diagnose, treat, cure, or prevent any disease.';

// ── SEO + JSON-LD ────────────────────────────────────────────────────────────
const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonical = new URL(Astro.url.pathname, site).toString();
const heroImg = data.image?.asset?.url;
const fallbackHeroImage = '/images/house-of-rose/space/professional-makeup-kit-square.webp';
const pageImage = heroImg ?? fallbackHeroImage;

const pageTitle = data.seoTitle ?? 'Jane Iredale Mineral Makeup | House of Rose Aesthetics, Punta Gorda FL';
const pageDescription =
  data.seoDescription ??
  'Jane Iredale — "The Skincare Makeup." Why House of Rose Aesthetics uses this professional mineral makeup for events and post-treatment wear, its benefits, and how to swap it into your daily routine.';

const breadcrumb = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'Services', item: `${site}services/` },
  { name: 'Professional Makeup', item: `${site}services/professional-makeup/` },
  { name: 'Jane Iredale', item: canonical },
]);

const brandLd = brand({
  name: 'jane iredale',
  description: 'Professional mineral makeup, skincare, and supplements — "The Skincare Makeup."',
  url: canonical,
  slogan: 'The Skincare Makeup',
  sameAs: 'https://janeiredale.com/',
});
const faqLd = faqPage(faqs);
---

<BaseLayout title={pageTitle} description={pageDescription} image={pageImage} preloadImage={pageImage}>
  <SchemaMarkup item={brandLd} slot="head" />
  <SchemaMarkup item={breadcrumb} slot="head" />
  {faqLd && <SchemaMarkup item={faqLd} slot="head" />}

  <div {...(data._id ? sbObjectId(data._id) : {})}>
    <Hero
      title={data.heroTitle ?? 'Jane Iredale'}
      kicker={data.heroKicker ?? 'The Skincare Makeup'}
      description={data.heroDescription ??
        'The professional mineral makeup we reach for — good for your skin, beautiful on camera, and the reason our looks feel like you at your best.'}
      size="small"
      showCTA={false}
      backgroundImage={pageImage}
      titleField="heroTitle"
      kickerField="heroKicker"
      descriptionField="heroDescription"
    />

    <!-- Who they are -->
    <section class="bg-charcoal py-[clamp(48px,7vw,96px)] px-6">
      <div class="max-w-[860px] mx-auto text-center">
        <span class="kicker" {...sbFieldPath('introKicker')}>{data.introKicker ?? 'Who They Are'}</span>
        <h2 class="font-serif text-[clamp(24px,3.6vw,40px)] text-ink leading-tight mt-2 mb-6" {...sbFieldPath('introHeading')}>
          {data.introHeading ?? 'Makeup that is good for your skin.'}
        </h2>
        <p class="text-muted text-[16px] leading-[1.85] max-w-[720px] mx-auto whitespace-pre-line" {...sbFieldPath('introBody')}>
          {data.introBody ??
            'Jane Iredale founded her line in 1994 on a simple question: why can’t makeup be good for the skin? The answer became "The Skincare Makeup" — a professional mineral line built on micronized minerals, made without talc or synthetic fragrance, and developed for the aesthetics world. Today it spans makeup, skincare, and supplements, and it is trusted by estheticians and artists who want coverage that lets healthy skin stay the focus.'}
        </p>
      </div>
    </section>

    <!-- Three pillars -->
    <section class="bg-charcoal-light py-[clamp(48px,7vw,96px)] px-6 border-t border-gold-metal/10">
      <div class="max-w-[1180px] mx-auto">
        <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ink mb-10 text-center" {...sbFieldPath('pillarsHeading')}>
          {data.pillarsHeading ?? 'Makeup · Skincare · Supplements'}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-gold-metal/15">
          {pillars.map((p, i) => (
            <article class="flex flex-col bg-breath p-8">
              <h3 class="font-serif text-[22px] text-ink mb-3" {...(usingFallbackPillars ? {} : sbFieldPathParts('pillars', i, 'name'))}>{p.name}</h3>
              {p.body && <p class="text-ink/75 text-[14px] leading-[1.7] mb-4" {...(usingFallbackPillars ? {} : sbFieldPathParts('pillars', i, 'body'))}>{p.body}</p>}
              {p.examples && p.examples.length > 0 && (
                <ul class="mt-auto space-y-1">
                  {p.examples.map((ex) => <li class="text-muted text-[12px]">· {ex}</li>)}
                </ul>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Benefits -->
    <section class="bg-charcoal py-[clamp(44px,6vw,80px)] px-6 border-t border-gold-metal/10">
      <div class="max-w-[960px] mx-auto">
        <h2 class="font-serif text-[clamp(22px,3.4vw,34px)] text-ink mb-8 text-center" {...sbFieldPath('benefitsHeading')}>
          {data.benefitsHeading ?? 'The benefits of a mineral makeup'}
        </h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-4">
          {benefits.map((b, i) => (
            <li class="flex gap-3 text-muted text-[14px] leading-[1.6]">
              <span class="text-gold mt-1">◆</span>
              <span {...(usingFallbackBenefits ? {} : sbFieldPathParts('benefits', i))}>{b}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Why we use it -->
    <section class="on-dark bg-walnut py-[clamp(48px,7vw,88px)] px-6 border-t border-gold-metal/10">
      <div class="max-w-[860px] mx-auto text-center">
        <span class="kicker" {...sbFieldPath('whyUsKicker')}>{data.whyUsKicker ?? 'Why We Use It'}</span>
        <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ivory mt-2 mb-6" {...sbFieldPath('whyUsHeading')}>
          {data.whyUsHeading ?? 'Safe after treatment. Chosen for events.'}
        </h2>
        <p class="text-ivory/75 text-[15px] leading-[1.85] max-w-[680px] mx-auto whitespace-pre-line" {...sbFieldPath('whyUsBody')}>
          {data.whyUsBody ??
            'Because Jane Iredale is non-comedogenic, mineral-based, and often carries physical SPF, it is a natural choice for the skin after a facial or treatment — applied when your skin is ready and your provider gives the go-ahead. For weddings, prom, and photography, professional artists reach for it because it builds beautifully, wears comfortably for hours, and photographs cleanly with no harsh flashback. It is the rare line that performs for a camera and loves your skin at the same time.'}
        </p>
      </div>
    </section>

    <!-- This-for-that swap guide -->
    <section class="bg-charcoal py-[clamp(48px,7vw,96px)] px-6 border-t border-gold-metal/10">
      <div class="max-w-[1080px] mx-auto">
        <div class="max-w-[720px] mb-10">
          <span class="kicker" {...sbFieldPath('swapsKicker')}>{data.swapsKicker ?? 'Make the Swap'}</span>
          <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ink mt-2 mb-4" {...sbFieldPath('swapsHeading')}>
            {data.swapsHeading ?? 'Swap your routine, one product at a time.'}
          </h2>
          <p class="text-muted text-[15px] leading-[1.8]" {...sbFieldPath('swapsIntro')}>
            {data.swapsIntro ??
              'You don’t have to change everything at once. Here’s a simple "this for that" guide to move your daily routine over to Jane Iredale — start with a foundation you love and build from there.'}
          </p>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-gold-metal/25">
                <th class="py-3 pr-4 text-gold text-[11px] tracking-[0.2em] uppercase font-normal">Step</th>
                <th class="py-3 pr-4 text-gold text-[11px] tracking-[0.2em] uppercase font-normal">Instead of</th>
                <th class="py-3 pr-4 text-gold text-[11px] tracking-[0.2em] uppercase font-normal">Try Jane Iredale</th>
              </tr>
            </thead>
            <tbody>
              {swaps.map((s, i) => (
                <tr class="border-b border-ink/8 align-top">
                  <td class="py-3 pr-4 text-ink/85 text-[13px] whitespace-nowrap" {...(usingFallbackSwaps ? {} : sbFieldPathParts('swaps', i, 'category'))}>{s.category}</td>
                  <td class="py-3 pr-4 text-muted text-[13px]" {...(usingFallbackSwaps ? {} : sbFieldPathParts('swaps', i, 'conventional'))}>{s.conventional}</td>
                  <td class="py-3 pr-4 text-ink/85 text-[13px]">
                    <span class="block" {...(usingFallbackSwaps ? {} : sbFieldPathParts('swaps', i, 'swap'))}>{s.swap}</span>
                    {s.note && <span class="block text-muted text-[12px] mt-0.5" {...(usingFallbackSwaps ? {} : sbFieldPathParts('swaps', i, 'note'))}>{s.note}</span>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Get the Look (anonymized) -->
    <section class="bg-charcoal-light py-[clamp(48px,7vw,96px)] px-6 border-t border-gold-metal/10">
      <div class="max-w-[1080px] mx-auto">
        <div class="max-w-[720px] mb-10">
          <span class="kicker" {...sbFieldPath('looksKicker')}>{data.looksKicker ?? 'Get the Look'}</span>
          <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ink mt-2 mb-4" {...sbFieldPath('looksHeading')}>
            {data.looksHeading ?? 'Two signature looks, built with Jane Iredale.'}
          </h2>
          <p class="text-muted text-[15px] leading-[1.8]" {...sbFieldPath('looksIntro')}>
            {data.looksIntro ??
              'Here is exactly how we build two of our most-requested finishes — the products and shades that create a healthy, believable result.'}
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-gold-metal/15">
          {looks.map((look, li) => (
            <article class="bg-breath p-8">
              <h3 class="font-serif text-[20px] text-ink mb-2" {...(usingFallbackLooks ? {} : sbFieldPathParts('looks', li, 'name'))}>{look.name}</h3>
              {look.summary && <p class="text-muted text-[13px] leading-[1.7] mb-5" {...(usingFallbackLooks ? {} : sbFieldPathParts('looks', li, 'summary'))}>{look.summary}</p>}
              {look.steps && look.steps.length > 0 && (
                <dl class="space-y-2.5">
                  {look.steps.map((st) => (
                    <div class="flex flex-col sm:flex-row sm:gap-3">
                      <dt class="text-gold text-[11px] tracking-[0.14em] uppercase sm:w-[92px] sm:shrink-0 pt-0.5">{st.step}</dt>
                      <dd class="text-ink/80 text-[13px]">
                        {st.product}{st.shade && <span class="text-muted"> — {st.shade}</span>}
                      </dd>
                    </div>
                  ))}
                </dl>
              )}
            </article>
          ))}
        </div>
        <p class="text-muted text-[12px] leading-relaxed pt-6 max-w-[720px]">
          Example looks for illustration. Client before-and-after photos are shared only with written consent; individual results vary.
        </p>
      </div>
    </section>

    <!-- FAQs -->
    {faqs.length > 0 && (
      <section class="bg-charcoal py-[clamp(48px,7vw,88px)] px-6 border-t border-gold-metal/10">
        <div class="max-w-[820px] mx-auto">
          <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ink mb-8 text-center">Common Questions</h2>
          <div class="space-y-6">
            {faqs.map((f, i) => (
              <div class="border-b border-ink/10 pb-6">
                <h3 class="font-serif text-[18px] text-ink mb-2" {...(data.faqs?.length ? sbFieldPathParts('faqs', i, 'question') : {})}>{f.question}</h3>
                <p class="text-muted text-[14px] leading-[1.8]" {...(data.faqs?.length ? sbFieldPathParts('faqs', i, 'answer') : {})}>{f.answer}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- CTA + links -->
    <section class="bg-charcoal-light py-[clamp(48px,7vw,88px)] px-6 border-t border-gold-metal/15">
      <div class="max-w-[860px] mx-auto text-center">
        <h2 class="font-serif text-[clamp(24px,4.2vw,38px)] text-ink leading-tight mb-4" {...sbFieldPath('ctaHeading')}>
          {data.ctaHeading ?? 'Want these products in your routine?'}
        </h2>
        <p class="text-muted text-[15px] max-w-[560px] mx-auto mb-8 leading-[1.8]" {...sbFieldPath('ctaBody')}>
          {data.ctaBody ??
            'Book a makeup application or a lesson and we’ll match you to the right Jane Iredale products for your skin, or ask us about a color match on your next visit.'}
        </p>
        <div class="flex gap-3 justify-center flex-wrap mb-10">
          <a href={PHONE_TEL} class="btn-gold">{PHONE_DISPLAY}</a>
          <a href="/services/professional-makeup/" class="btn-outline-gold">Makeup Services</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-gold-metal/15 text-left">
          {relatedLinks.map((l, i) => (
            <a href={l.href} class="group flex flex-col bg-breath p-6 transition-colors hover:bg-charcoal">
              <span class="font-serif text-[17px] text-ink mb-1" {...(usingFallbackLinks ? {} : sbFieldPathParts('relatedLinks', i, 'label'))}>{l.label}</span>
              {l.description && <span class="text-muted text-[13px] leading-[1.6]" {...(usingFallbackLinks ? {} : sbFieldPathParts('relatedLinks', i, 'description'))}>{l.description}</span>}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Supplement disclaimer (FDA/FTC) -->
    <section class="bg-charcoal py-8 px-6 border-t border-ink/10">
      <p class="max-w-[820px] mx-auto text-muted text-[11px] leading-relaxed text-center" {...sbFieldPath('supplementDisclaimer')}>
        {supplementDisclaimer}
      </p>
    </section>
  </div>
</BaseLayout>
