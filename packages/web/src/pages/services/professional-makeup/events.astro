---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import { sanityFetch } from '@/lib/sanity';
import { sbObjectId, sbFieldPath, sbFieldPathParts } from '@/lib/visualEditing';
import {
  MAKEUP_EVENTS_PAGE_QUERY,
  type MakeupEventsPage,
  type MakeupBookingOption,
  type LinkRef,
  type FAQ,
} from '@/lib/queries';
import { jsonLd, service as serviceSchema, breadcrumbList, faqPage } from '@/lib/structuredData';

const PHONE_DISPLAY = '(844) 941-7673';
const PHONE_TEL = 'tel:+18449417673';
const SMS_HREF = 'sms:+18449417673';

const data =
  (await sanityFetch<MakeupEventsPage | null>(MAKEUP_EVENTS_PAGE_QUERY)) ??
  ({} as MakeupEventsPage);

// ── Fallbacks ────────────────────────────────────────────────────────────────
const FALLBACK_OPTIONS: MakeupBookingOption[] = [
  {
    name: 'In-House — Individual Block Times',
    summary:
      'Each member of your party travels to our Punta Gorda studio at a set time to have their makeup done by the artist they scheduled with. Simple, private, one-at-a-time.',
    includes: ['A reserved block time per person', 'Application in-studio at House of Rose', 'Jane Iredale professional mineral makeup'],
    bestFor: 'Smaller groups and anyone who prefers a calm, one-on-one appointment.',
    priceLabel: 'From $150 per person',
  },
  {
    name: 'In-House — Spa Rental (The Pre-Party Package)',
    summary:
      'Your whole party — everyone getting makeup — rents the spa as a private hosted event. We take care of the atmosphere so the morning feels like part of the celebration.',
    includes: [
      'Private rental of the studio for your group',
      'Hors d’oeuvres / pastries & mimosas',
      'A complimentary "Party Planner Infusion" IV Hydration Therapy session for each attendee getting makeup',
      'Jane Iredale professional mineral makeup',
    ],
    bestFor: 'Bridal parties and celebrations that want to get ready together.',
    priceLabel: 'From $175 per person · 4-guest minimum',
  },
  {
    name: 'Travel — We Come to You',
    summary:
      'House of Rose Aesthetics travels to your venue and performs makeup application on your schedule, wherever the day is happening.',
    includes: ['On-location application at your venue', 'Scheduling built around your timeline', 'Jane Iredale professional mineral makeup'],
    bestFor: 'Weddings and events where the party is getting ready on site.',
    priceLabel: 'From $150 per person + travel fee · 4-guest minimum',
  },
];

const FALLBACK_LINKS: LinkRef[] = [
  { label: 'Professional Makeup', description: 'Our makeup services and skin-first approach.', href: '/services/professional-makeup/' },
  { label: 'Jane Iredale', description: 'The mineral makeup we use, and why.', href: '/services/professional-makeup/jane-iredale/' },
];

const FALLBACK_FAQS: FAQ[] = [
  {
    question: 'How do I book makeup for a wedding or group event?',
    answer:
      'Call or text (844) 941-7673 to start. Tell us your date, how many people need makeup, and whether you’d like block times in-studio, our private spa rental package, or on-location travel — and we’ll build the plan with you.',
  },
  {
    question: 'What is included in the Spa Rental (Pre-Party Package)?',
    answer:
      'Your party rents the studio privately, and we provide Hors d’oeuvres / pastries and mimosas plus a complimentary "Party Planner Infusion" IV Hydration Therapy session for each attendee getting makeup, alongside professional application.',
  },
  {
    question: 'Do you travel to venues?',
    answer:
      'Yes. We travel to your venue and work on your schedule; a travel fee applies based on location and is confirmed when you book.',
  },
  {
    question: 'Should everyone book a trial run?',
    answer:
      'Trial runs are booked separately at the same price as the event application and are strongly recommended — at minimum for the guest of honor — so we can coordinate colors and perfect the look before the day.',
  },
];

const bookingOptions = data.bookingOptions?.length ? data.bookingOptions : FALLBACK_OPTIONS;
const usingFallbackOptions = !data.bookingOptions?.length;
const relatedLinks = data.relatedLinks?.length ? data.relatedLinks : FALLBACK_LINKS;
const usingFallbackLinks = !data.relatedLinks?.length;
const faqs = data.faqs?.length ? data.faqs : FALLBACK_FAQS;

// ── SEO + JSON-LD ────────────────────────────────────────────────────────────
const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonical = new URL(Astro.url.pathname, site).toString();
const heroImg = data.image?.asset?.url;

const pageTitle = data.seoTitle ?? 'Wedding & Event Makeup | House of Rose Aesthetics, Punta Gorda FL';
const pageDescription =
  data.seoDescription ??
  'Group and event makeup at House of Rose Aesthetics — book individual block times in-studio, a private spa rental party package, or on-location travel to your venue in Punta Gorda and SW Florida.';

const breadcrumb = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'Services', item: `${site}services/` },
  { name: 'Professional Makeup', item: `${site}services/professional-makeup/` },
  { name: 'Events', item: canonical },
]);

const serviceLd = serviceSchema(
  {
    name: 'Wedding & Event Makeup',
    description:
      'Group and event makeup bookings — in-studio block times, private spa rental, or on-location travel.',
    url: canonical,
    image: heroImg,
    serviceType: 'Event makeup application',
  },
  site,
);
const faqLd = faqPage(faqs);
---

<BaseLayout title={pageTitle} description={pageDescription} image={heroImg}>
  <script is:inline type="application/ld+json" set:html={jsonLd(serviceLd)} slot="head" />
  <script is:inline type="application/ld+json" set:html={jsonLd(breadcrumb)} slot="head" />
  {faqLd && <script is:inline type="application/ld+json" set:html={jsonLd(faqLd)} slot="head" />}

  <div {...(data._id ? sbObjectId(data._id) : {})}>
    <Hero
      title={data.heroTitle ?? 'Wedding & Event Makeup'}
      kicker={data.heroKicker ?? 'Group Bookings'}
      description={data.heroDescription ??
        'For weddings and celebrations where the whole party is getting ready together — book block times in-studio, rent the spa for a private pre-party, or have us travel to your venue.'}
      size="small"
      showCTA={true}
      ctaPrimary={{ text: 'Call or Text to Plan', href: PHONE_TEL }}
      backgroundImage={heroImg ?? '/images/hor-lounge.jpg'}
      titleField="heroTitle"
      kickerField="heroKicker"
      descriptionField="heroDescription"
    />

    <!-- Intro -->
    <section class="bg-charcoal py-[clamp(48px,7vw,88px)] px-6">
      <div class="max-w-[820px] mx-auto text-center">
        <span class="kicker" {...sbFieldPath('introKicker')}>{data.introKicker ?? 'Event Makeup'}</span>
        <h2 class="font-serif text-[clamp(24px,3.6vw,38px)] text-ink leading-tight mt-2 mb-6" {...sbFieldPath('introHeading')}>
          {data.introHeading ?? 'Makeup for your whole party, done beautifully.'}
        </h2>
        <p class="text-[#9a8c78] text-[16px] leading-[1.85] max-w-[680px] mx-auto whitespace-pre-line" {...sbFieldPath('introBody')}>
          {data.introBody ??
            'When several people need to be camera-ready for the same occasion — a wedding, a milestone, a big event — we make it seamless. Choose the setting that fits your day, and we’ll handle the rest with the same skin-first Jane Iredale application we’re known for.'}
        </p>
      </div>
    </section>

    <!-- Booking Options -->
    <section class="bg-charcoal-light py-[clamp(48px,7vw,96px)] px-6 border-t border-gold/10">
      <div class="max-w-[1180px] mx-auto">
        <div class="max-w-[720px] mb-12">
          <span class="kicker" {...sbFieldPath('optionsKicker')}>{data.optionsKicker ?? 'Three Ways to Book'}</span>
          <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ink mt-2" {...sbFieldPath('optionsHeading')}>
            {data.optionsHeading ?? 'Choose how your party gets ready.'}
          </h2>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-px bg-gold/15">
          {bookingOptions.map((o, i) => (
            <article class="flex flex-col bg-breath p-8">
              <h3 class="font-serif text-[21px] text-ink leading-tight mb-3" {...(usingFallbackOptions ? {} : sbFieldPathParts('bookingOptions', i, 'name'))}>{o.name}</h3>
              {o.summary && <p class="text-ink/75 text-[14px] leading-[1.7] mb-5" {...(usingFallbackOptions ? {} : sbFieldPathParts('bookingOptions', i, 'summary'))}>{o.summary}</p>}
              {o.includes && o.includes.length > 0 && (
                <ul class="space-y-2 mb-5">
                  {o.includes.map((inc) => (
                    <li class="flex gap-2 text-[#9a8c78] text-[13px] leading-[1.5]"><span class="text-gold mt-0.5">◆</span><span>{inc}</span></li>
                  ))}
                </ul>
              )}
              {o.bestFor && (
                <p class="text-[#9a8c78] text-[12px] leading-[1.5] mb-3"><span class="text-gold">Best for:</span> {o.bestFor}</p>
              )}
              {o.priceLabel && (
                <p class="text-gold text-[13px] mt-auto pt-3 border-t border-ink/10" {...(usingFallbackOptions ? {} : sbFieldPathParts('bookingOptions', i, 'priceLabel'))}>{o.priceLabel}</p>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Trial Run -->
    <section class="bg-walnut py-[clamp(44px,6vw,80px)] px-6 border-t border-gold/10">
      <div class="max-w-[820px] mx-auto text-center">
        <span class="kicker">Recommended</span>
        <h2 class="font-serif text-[clamp(22px,3.4vw,34px)] text-ivory mt-2 mb-4" {...sbFieldPath('trialRunHeading')}>
          {data.trialRunHeading ?? 'Plan a trial run for the guest of honor.'}
        </h2>
        <p class="text-ivory/75 text-[15px] leading-[1.85] max-w-[640px] mx-auto" {...sbFieldPath('trialRunBody')}>
          {data.trialRunBody ??
            'A trial run is booked separately at the same price as the event application. For weddings especially, we recommend one for the guest of honor so we can coordinate colors, color-match and swatch-test foundation, and lock in the exact look ahead of the day.'}
        </p>
      </div>
    </section>

    <!-- FAQs -->
    {faqs.length > 0 && (
      <section class="bg-charcoal py-[clamp(48px,7vw,88px)] px-6 border-t border-gold/10">
        <div class="max-w-[820px] mx-auto">
          <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ink mb-8 text-center">Common Questions</h2>
          <div class="space-y-6">
            {faqs.map((f, i) => (
              <div class="border-b border-ink/10 pb-6">
                <h3 class="font-serif text-[18px] text-ink mb-2" {...(data.faqs?.length ? sbFieldPathParts('faqs', i, 'question') : {})}>{f.question}</h3>
                <p class="text-[#9a8c78] text-[14px] leading-[1.8]" {...(data.faqs?.length ? sbFieldPathParts('faqs', i, 'answer') : {})}>{f.answer}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Booking CTA -->
    <section class="bg-charcoal-light py-[clamp(48px,7vw,88px)] px-6 border-t border-gold/15">
      <div class="max-w-[640px] mx-auto text-center">
        <h2 class="font-serif text-[clamp(24px,4.2vw,40px)] text-ink leading-tight mb-4" {...sbFieldPath('bookingHeading')}>
          {data.bookingHeading ?? 'Let’s plan your event.'}
        </h2>
        <p class="text-[#9a8c78] text-[15px] max-w-[500px] mx-auto mb-8 leading-[1.8]" {...sbFieldPath('bookingBody')}>
          {data.bookingBody ??
            'Call or text with your date and party size and we’ll walk you through the options, timing, and everything included.'}
        </p>
        <div class="flex gap-3 justify-center flex-wrap mb-10">
          <a href={PHONE_TEL} class="btn-gold">{PHONE_DISPLAY}</a>
          <a href={SMS_HREF} class="btn-outline-gold">Text Us</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-gold/15 text-left">
          {relatedLinks.map((l, i) => (
            <a href={l.href} class="group flex flex-col bg-breath p-6 transition-colors hover:bg-charcoal">
              <span class="font-serif text-[17px] text-ink mb-1" {...(usingFallbackLinks ? {} : sbFieldPathParts('relatedLinks', i, 'label'))}>{l.label}</span>
              {l.description && <span class="text-[#9a8c78] text-[13px] leading-[1.6]" {...(usingFallbackLinks ? {} : sbFieldPathParts('relatedLinks', i, 'description'))}>{l.description}</span>}
            </a>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
