---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import TreatmentEvidence from '@/components/TreatmentEvidence.astro';
import BookingLink from '@/components/BookingLink.astro';
import { sanityFetch, urlFor } from '@/lib/sanity';
import {
  getCuratedServiceImage,
  getCuratedServiceImageAlt,
  getServiceFallbackImage,
  getServiceResultImages,
  serviceImageUsesContain,
} from '@/lib/imageFallbacks';
import { sbObjectId, sbFieldPath, sbFieldPathParts } from '@/lib/visualEditing';
import {
  ALL_SERVICE_SLUGS_QUERY,
  SERVICE_BY_SLUG_QUERY,
  type Service,
} from '@/lib/queries';
import { service as serviceJsonLd, breadcrumbList, faqPage } from '@/lib/structuredData';
import DowntimeBlock from '@/components/treatment/DowntimeBlock.astro';
import AftercareBlock from '@/components/treatment/AftercareBlock.astro';
import ProviderScopeBlock from '@/components/treatment/ProviderScopeBlock.astro';
import PriceRangeBlock from '@/components/treatment/PriceRangeBlock.astro';
import WhyHouseOfRose from '@/components/treatment/WhyHouseOfRose.astro';
import { medicalProcedure, treatmentOffer } from '@/lib/structuredData.treatment';
import { alignPublicContent } from '@/lib/publicCopy';
import { isVerifiedGlossGeniusBookingUrl } from '@/lib/booking';

export async function getStaticPaths() {
  const slugs = await sanityFetch<{ slug: string }[]>(ALL_SERVICE_SLUGS_QUERY);
  return slugs.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const serviceData = await sanityFetch<Service>(SERVICE_BY_SLUG_QUERY, { slug });

// Slugs come from getStaticPaths (Sanity), so a miss is a data-integrity bug, not a
// runtime 404. Fail the build loudly — never `return Astro.redirect()` from a prerendered
// route: returning a Response in `output: 'static'` stops Astro emitting the sibling index
// chunk and breaks the build (see shop/[slug].astro).
if (!serviceData) {
  throw new Error(`[services/[slug]] No service found in Sanity for slug "${slug}"`);
}

const service: Service = alignPublicContent(serviceData, {
  allowNoDowntime: slug === 'glo2facial',
});

// Build structured data for SEO
const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonicalURL = new URL(Astro.url.pathname, site);
const fallbackImage = slug ? getServiceFallbackImage(slug) : undefined;
const curatedImage = slug ? getCuratedServiceImage(slug) : undefined;
const curatedImageAlt = slug ? getCuratedServiceImageAlt(slug) : service.image?.alt ?? service.title;
const containHeroImage = slug ? serviceImageUsesContain(slug) : false;
const socialImage = curatedImage
  ? new URL(curatedImage, site).toString()
  : service.image?.asset
  ? urlFor(service.image).width(1200).height(630).fit('crop').auto('format').quality(82).url()
  : fallbackImage
    ? new URL(fallbackImage, site).toString()
    : undefined;
const heroImage = curatedImage ?? (service.image?.asset
  ? urlFor(service.image).width(1600).height(1200).fit('crop').auto('format').url()
  : fallbackImage ?? '/images/optimized/actual-reception-1400.webp');
const galleryImages = service.gallery?.filter((image) => image?.asset) ?? [];

// Approved brand or House of Rose result photography, populated only where documented.
const resultImages = slug ? getServiceResultImages(slug) : [];
const hasFaceRealityResults = ['acne-bootcamp', 'face-reality-acne-program', 'face-reality-acne-treatment'].includes(slug ?? '');

const priceMatch = service.price ? String(service.price).match(/\d[\d,]*(?:\.\d+)?/) : null;
const priceNumber: number | null = priceMatch ? Number(priceMatch[0].replace(/,/g, '')) : null;

const serviceSchema = serviceJsonLd(
  {
    name: service.title,
    description: service.description ?? service.tagline ?? undefined,
    url: canonicalURL.toString(),
    image: socialImage,
    serviceType: service.tagline ?? service.title,
    minPrice: priceNumber,
    offerUrl: isVerifiedGlossGeniusBookingUrl(service.bookingUrl) ? service.bookingUrl : undefined,
  },
  site,
);

const breadcrumbSchema = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'Services', item: new URL('/services/', site).toString() },
  ...(service.parentService
    ? [
        {
          name: service.parentService.title,
          item: new URL(`/services/${service.parentService.slug}/`, site).toString(),
        },
      ]
    : []),
  { name: service.title, item: canonicalURL.toString() },
]);

const faqSchema = faqPage(service.faqs ?? []);
// Treatment-specific structured data. Emitted alongside the generic Service node —
// MedicalProcedure is what local health-intent surfaces actually read.

const verifiedBookingUrl = isVerifiedGlossGeniusBookingUrl(service.bookingUrl)
  ? service.bookingUrl
  : undefined;

const procedureSchema = service.providerScope
  ? medicalProcedure(
      {
        name: service.title,
        description: service.description ?? service.tagline ?? undefined,
        url: canonicalURL.toString(),
        image: socialImage,
        procedureType: service.providerScope.medicalDirection
          ? 'PercutaneousProcedure'
          : 'NoninvasiveProcedure',
        bodyLocation: service.treatmentAreas?.map((a) => a.area),
        downtime: service.downtime,
        aftercare: service.aftercare,
        providerScope: service.providerScope,
        priceRange: service.priceRange,
        bookingUrl: verifiedBookingUrl,
      },
      site,
    )
  : null;

const offerSchema = service.priceRange
  ? treatmentOffer({
      url: canonicalURL.toString(),
      name: service.title,
      priceRange: service.priceRange,
      bookingUrl: verifiedBookingUrl,
    })
  : null;


const pageTitle = service.seo?.metaTitle ?? `${service.title} in Punta Gorda, FL | House of Rose`;
const pageDescription = service.seo?.metaDescription ?? service.tagline ?? service.description ?? '';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={socialImage}
  preloadImage={heroImage}
>
  <!-- Structured Data for SEO -->
  <SchemaMarkup item={serviceSchema} slot="head" />
  <SchemaMarkup item={breadcrumbSchema} slot="head" />
  {faqSchema && <SchemaMarkup item={faqSchema} slot="head" />}
  {procedureSchema && <SchemaMarkup item={procedureSchema} slot="head" />}
  {offerSchema && <SchemaMarkup item={offerSchema} slot="head" />}

  <script
    slot="head"
    is:inline
    set:html={`window.fbq && fbq('track', 'ViewContent', ${JSON.stringify({
      content_name: service.title,
      content_category: 'service',
      content_ids: [slug],
      content_type: 'product',
      ...(priceNumber != null ? { value: priceNumber, currency: 'USD' } : {}),
    })});`}
  />
  {/* Visual Editor: all editable copy below belongs to this service document */}
  <div {...sbObjectId(service._id)}>
  <!-- Answer-first service hero: the image is semantic and immediately discoverable for LCP. -->
  <section class="service-detail-hero bg-bone pt-20 lg:pt-24">
    <div class="mx-auto grid max-w-[1440px] grid-cols-1 lg:min-h-[680px] lg:grid-cols-[minmax(0,0.9fr)_minmax(520px,1.1fr)]">
      <div class="flex flex-col justify-center px-5 py-9 sm:px-10 sm:py-12 lg:px-[clamp(48px,7vw,104px)] lg:py-20">
        <a href={service.parentService ? `/services/${service.parentService.slug}/` : '/services/'} class="mb-6 inline-flex items-center gap-2 text-[12px] font-medium text-gold underline-offset-4 hover:underline sm:mb-8">
          <span aria-hidden="true">←</span> {service.parentService ? service.parentService.title : 'All services'}
        </a>
        <span class="kicker">Medical Aesthetics Practice</span>
        <h1 class="max-w-[720px] font-serif text-[clamp(36px,10vw,68px)] leading-[1.04] text-ink" {...sbFieldPath('title')}>
          {service.title}
        </h1>
        {service.tagline && (
          <p class="mt-6 max-w-[620px] text-[clamp(17px,2vw,20px)] leading-[1.65] text-muted-strong" {...sbFieldPath('tagline')}>
            {service.tagline}
          </p>
        )}
        {(service.price || service.duration) && (
          <p class="mt-5 text-[13px] font-medium tracking-[0.08em] text-muted">
            {service.price && <span {...sbFieldPath('price')}>{service.price}</span>}{service.price && service.duration && <span class="mx-2 text-gold">·</span>}{service.duration && <span {...sbFieldPath('duration')}>{service.duration}</span>}
          </p>
        )}
        <div class="mt-7 grid gap-3 sm:flex sm:flex-wrap">
          <BookingLink
            slug={service.slug}
            bookingMode={service.bookingMode}
            bookingUrl={service.bookingUrl}
            location="service-hero"
          />
          <a href="/consultation/" class="btn-outline-gold">Talk through my options</a>
        </div>
        <p class="mt-5 max-w-[560px] text-[13px] leading-relaxed text-muted">
          A consultation confirms candidacy, timing, and the treatment plan that fits your goals.
        </p>
      </div>
      <figure class="relative min-h-[300px] overflow-hidden bg-limestone sm:min-h-[420px] lg:min-h-full">
        <img
          src={heroImage}
          alt={curatedImage ? curatedImageAlt : service.image?.alt ?? `${service.title} at House of Rose Aesthetics`}
          width="1600"
          height="1200"
          fetchpriority="high"
          decoding="async"
          class:list={[
            'absolute inset-0 h-full w-full',
            containHeroImage ? 'object-contain p-8 sm:p-12' : 'object-cover',
          ]}
        />
      </figure>
    </div>
  </section>

  <!-- Answer-first treatment overview -->
  <section class="bg-charcoal px-5 py-12 sm:px-6 sm:py-16">
    <div class="max-w-[960px] mx-auto">
      <span class="kicker">Treatment Overview</span>
      <h2 class="font-serif text-[clamp(26px,4vw,38px)] text-ink mt-2 mb-5">
        What is {service.title}?
      </h2>
      <p class="text-ink/80 text-[16px] leading-[1.8]" {...sbFieldPath('description')}>
        {service.description ?? service.tagline ?? ''}
      </p>
    </div>
  </section>

  <TreatmentEvidence
    serviceTitle={service.title}
    media={service.evidenceMedia}
    research={service.researchReferences}
  />

  <!-- Concern-to-treatment paths -->
  {service.concerns && service.concerns.length > 0 && (
    <section class="bg-charcoal-light py-[clamp(48px,7vw,80px)] px-6 border-t border-gold-metal/10">
      <div class="max-w-[1280px] mx-auto">
        <span class="kicker">Start With What You See</span>
        <h2 class="font-serif text-[clamp(26px,4vw,38px)] text-ink mt-2 mb-4">
          Could {service.title} be right for your concerns?
        </h2>
        <p class="text-muted text-[15px] leading-relaxed max-w-[720px] mb-10">
          This treatment may be considered when one or more of these visible concerns match your goals. A consultation confirms whether the technology, timing, and treatment area are appropriate for you.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-gold-metal/10">
          {service.concerns.map((concern) => (
            <a
              href={`/concerns/${concern.slug}/`}
              class="bg-charcoal p-7 group block transition-colors hover:bg-charcoal-lighter"
              {...sbObjectId(concern._id)}
            >
              <h3 class="font-serif text-[21px] text-ink mb-3 group-hover:text-gold transition-colors" {...sbFieldPath('title')}>
                {concern.title}
              </h3>
              {concern.intro && <p class="text-muted text-[14px] leading-relaxed">{concern.intro}</p>}
              <span class="learn-more group-hover:text-gold mt-4 inline-block">Explore This Concern</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Benefits and treatment areas -->
  {(service.benefits?.length || service.treatmentAreas?.length) && (
    <section class="bg-charcoal py-[clamp(48px,7vw,80px)] px-6 border-t border-gold-metal/10">
      <div class="max-w-[1280px] mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
        {service.benefits && service.benefits.length > 0 && (
          <div>
            <span class="kicker">Why Clients Choose It</span>
            <h2 class="font-serif text-[clamp(25px,3.6vw,36px)] text-ink mt-2 mb-7">
              What benefits can {service.title} support?
            </h2>
            <ul class="space-y-3">
              {service.benefits.map((benefit, i) => (
                <li class="flex gap-3 text-muted text-[15px] leading-relaxed" {...sbFieldPathParts('benefits', i)}>
                  <span class="text-gold mt-0.5" aria-hidden="true">✦</span>
                  <span>{benefit}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
        {service.treatmentAreas && service.treatmentAreas.length > 0 && (
          <div>
            <span class="kicker">Treatment Areas</span>
            <h2 class="font-serif text-[clamp(25px,3.6vw,36px)] text-ink mt-2 mb-7">
              Where can {service.title} be used?
            </h2>
            <div class="space-y-4">
              {service.treatmentAreas.map((item, i) => (
                <div class="border-l border-gold-metal/40 pl-5 py-1">
                  <h3 class="text-ink text-[16px] font-medium mb-1" {...sbFieldPathParts('treatmentAreas', i, 'area')}>
                    {item.area}
                  </h3>
                  <p class="text-muted text-[14px] leading-relaxed" {...sbFieldPathParts('treatmentAreas', i, 'focus')}>
                    {item.focus}
                  </p>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Experience and candidacy -->
  {(service.process?.length || service.whoItsFor) && (
    <section class="bg-charcoal-light py-[clamp(48px,7vw,80px)] px-6 border-t border-gold-metal/10">
      <div class="max-w-[1280px] mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
        {service.process && service.process.length > 0 && (
          <div>
            <span class="kicker">Your Visit</span>
            <h2 class="font-serif text-[clamp(25px,3.6vw,36px)] text-ink mt-2 mb-7">
              What should you expect from {service.title}?
            </h2>
            <ol class="space-y-4">
              {service.process.map((step, i) => (
                <li class="grid grid-cols-[32px_1fr] gap-3 text-muted text-[14px] leading-relaxed" {...sbFieldPathParts('process', i)}>
                  <span class="font-serif text-gold text-[18px]">{String(i + 1).padStart(2, '0')}</span>
                  <span>{step}</span>
                </li>
              ))}
            </ol>
          </div>
        )}
        {service.whoItsFor && (
          <div>
            <span class="kicker">Candidacy</span>
            <h2 class="font-serif text-[clamp(25px,3.6vw,36px)] text-ink mt-2 mb-7">
              Who is a candidate for {service.title}?
            </h2>
            <p class="text-muted text-[15px] leading-[1.8]" {...sbFieldPath('whoItsFor')}>{service.whoItsFor}</p>
            <p class="text-muted/80 text-[13px] leading-relaxed mt-6 border-t border-gold-metal/20 pt-5">
              Not every client is a candidate for every service. Final treatment combinations and candidacy are confirmed by your licensed provider based on candidacy, contraindications, and local regulations. Outcomes are individual and depend on your skin, candidacy, and consistency.
            </p>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Downtime and investment -->
  {(service.downtime || service.priceRange) && (
    <section class="bg-charcoal py-[clamp(48px,7vw,80px)] px-6 border-t border-gold-metal/10">
      <div class="max-w-[1280px] mx-auto grid grid-cols-1 lg:grid-cols-[1.3fr_1fr] gap-12 lg:gap-20">
        {service.downtime && (
          <DowntimeBlock downtime={service.downtime} treatmentName={service.title} />
        )}
        {service.priceRange && (
          <PriceRangeBlock
            priceRange={service.priceRange}
            slug={service.slug}
            bookingMode={service.bookingMode}
            bookingUrl={service.bookingUrl}
          />
        )}
      </div>
    </section>
  )}
  <!-- Gallery: real, service-specific photos (moved here now that the hero uses the shared banner) -->
  {galleryImages.length > 0 && (
    <section class="bg-charcoal-light py-[clamp(48px,7vw,80px)] px-6 border-t border-gold-metal/10">
      <div class="max-w-[1280px] mx-auto">
        <span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-8">Gallery</span>
        <div
          class:list={[
            'grid gap-4',
            galleryImages.length === 1
              ? 'grid-cols-1 max-w-[480px]'
              : galleryImages.length === 2
                ? 'grid-cols-1 sm:grid-cols-2 max-w-[820px]'
                : 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3',
          ]}
        >
          {galleryImages.map((img) => (
            <figure class="bg-charcoal border border-gold-metal/10 overflow-hidden">
              <img
                src={urlFor(img).width(900).height(1200).auto('format').quality(82).url()}
                alt={img.alt ?? service.title}
                width="900"
                height="1200"
                loading="lazy"
                decoding="async"
                class="w-full h-auto object-cover"
              />
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Approved brand or House of Rose result photography -->
  {resultImages.length > 0 && (
    <section class="bg-charcoal-light py-[clamp(48px,7vw,80px)] px-6 border-t border-gold-metal/10">
      <div class="max-w-[1280px] mx-auto">
        <span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-2">Results</span>
        <h2 class="font-serif text-[clamp(24px,4vw,36px)] text-ink mb-3">
          {hasFaceRealityResults ? 'The Face Reality Clear Skin Method' : `${service.title} before and after`}
        </h2>
        <p class="text-muted text-[14px] leading-relaxed max-w-[680px] mb-10">
          {hasFaceRealityResults
            ? 'Unretouched Week 1 to Week 16 results from the Face Reality clinical study. Individual results vary with adherence to protocol.'
            : 'House of Rose before-and-after photography. Lighting, angle, timing, skin condition, and individual response can affect visible change.'}
        </p>
        <div class:list={[
          resultImages.length === 1
            ? 'mx-auto w-full max-w-[960px]'
            : 'grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3',
        ]}>
          {resultImages.map((img) => (
            <figure class="bg-charcoal-light border border-gold-metal/20 overflow-hidden">
              <img
                src={img.src}
                alt={img.alt}
                width={img.width ?? 1080}
                height={img.height ?? 1350}
                loading="lazy"
                decoding="async"
                class="w-full h-auto"
              />
            </figure>
          ))}
        </div>
        {hasFaceRealityResults && (
          <p class="text-muted/70 text-[11px] tracking-[0.14em] uppercase mt-6">
            Images © Face Reality Skincare · Clear Skin Method™ clinical study
          </p>
        )}
      </div>
    </section>
  )}

  <!-- Treatments under this service (hub pages) -->
  {service.treatments && service.treatments.length > 0 && (
    <section class="bg-charcoal-light py-[clamp(48px,7vw,80px)] px-6">
      <div class="max-w-[1280px] mx-auto">
        <span class="kicker">Treatments</span>
        <h2 class="font-serif text-[clamp(24px,4vw,36px)] text-ink mt-2 mb-10">
          Ways to approach {service.title}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-px bg-gold-metal/10">
          {service.treatments.map((t) => (
            <article class="bg-charcoal p-7" {...sbObjectId(t._id)}>
              <h3 class="font-serif text-[22px] text-ink mb-2" {...sbFieldPath('title')}>
                <a href={`/services/${t.slug}/`} class="hover:text-gold transition-colors">{t.title}</a>
              </h3>
              {t.tagline && <p class="text-muted text-[14px] leading-[1.65] mb-4" {...sbFieldPath('tagline')}>{t.tagline}</p>}
              <p class="text-ink/70 text-[12px] tracking-[0.08em]">
                {t.price}{t.price && t.duration && <span class="text-gold mx-2">·</span>}{t.duration}
              </p>
              <div class="mt-5 flex flex-wrap gap-4 items-center">
                <a href={`/services/${t.slug}/`} class="learn-more inline-flex mt-0">Learn about {t.title}</a>
                <BookingLink
                  slug={t.slug}
                  bookingMode={t.bookingMode}
                  bookingUrl={t.bookingUrl}
                  location="service-treatment-card"
                  class="service-booking-link"
                />
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Decision-stage links only appear when this service is part of a comparison. -->
  {service.comparisons && service.comparisons.length > 0 && (
    <section class="bg-charcoal py-16 px-6">
      <div class="max-w-[1280px] mx-auto">
        <span class="kicker">Compare Your Options</span>
        <h2 class="font-serif text-[clamp(24px,4vw,36px)] text-ink mt-2 mb-4">
          See how this treatment fits your goals
        </h2>
        <p class="text-muted text-[15px] leading-relaxed max-w-[680px] mb-10">
          When more than one approach may fit, these clear comparisons can help you prepare for a more informed consultation.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-gold-metal/10">
          {service.comparisons.map((comparison) => (
            <a href={`/compare/${comparison.slug}/`} class="bg-charcoal-light p-7 group block transition-colors hover:bg-charcoal-lighter" {...sbObjectId(comparison._id)}>
              <h3 class="font-serif text-[21px] text-ink mb-3 group-hover:text-gold transition-colors">{comparison.title}</h3>
              <p class="text-muted text-[14px] leading-relaxed">{comparison.intro}</p>
              <span class="learn-more group-hover:text-gold mt-4 inline-block">Read the Comparison</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {service.whyQualified && service.whyQualified.length > 0 && (
    <WhyHouseOfRose
      whyQualified={service.whyQualified}
      treatmentName={service.title}
    />
  )}

  <!-- FAQs -->
  {service.faqs && service.faqs.length > 0 && (
    <section class="bg-charcoal-light py-16 px-6">
      <div class="max-w-[960px] mx-auto">
        <span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-8 text-center">
          Common Questions
        </span>
        <div class="space-y-6">
          {service.faqs.map((faq, i) => (
            <div class="border-b border-ink/5 pb-6">
              <h3 class="text-ink text-[17px] font-medium mb-3" {...sbFieldPathParts('faqs', i, 'question')}>{faq.question}</h3>
              <p class="text-muted text-[14px] leading-relaxed" {...sbFieldPathParts('faqs', i, 'answer')}>{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Aftercare and provider qualifications -->
  {(service.aftercare || service.providerScope) && (
    <section class="bg-charcoal py-[clamp(48px,7vw,80px)] px-6 border-t border-gold-metal/10">
      <div class="max-w-[1280px] mx-auto grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-12 lg:gap-20">
        {service.aftercare && (
          <AftercareBlock aftercare={service.aftercare} treatmentName={service.title} />
        )}
        {service.providerScope && (
          <ProviderScopeBlock providerScope={service.providerScope} treatmentName={service.title} />
        )}
      </div>
    </section>
  )}

  <!-- Related Services -->
  {service.relatedServices && service.relatedServices.filter(Boolean).length > 0 && (
    <section class="bg-charcoal py-16 px-6">
      <span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-8 max-w-[1280px] mx-auto">
        Related Services
      </span>
      <div class="max-w-[1280px] mx-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-px bg-gold-metal/10">
        {service.relatedServices.filter(Boolean).map((related) => (
          <article class="service-card group" {...sbObjectId(related._id)}>
            <a href={`/services/${related.slug}/`} class="block" aria-label={`Learn about ${related.title}`}>
              {related.image?.asset && (
                <div class="aspect-square overflow-hidden bg-charcoal-lighter mb-4">
                  <img
                    src={urlFor(related.image).width(400).height(400).fit('crop').auto('format').quality(80).url()}
                    alt={related.image.alt ?? related.title}
                    width={400}
                    height={400}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                </div>
              )}
              <span class="service-name" {...sbFieldPath('title')}>{related.title}</span>
              {related.tagline && <p class="service-desc mt-1" {...sbFieldPath('tagline')}>{related.tagline}</p>}
              <span class="learn-more group-hover:text-gold">Learn more</span>
            </a>
            <BookingLink
              slug={related.slug}
              bookingMode={related.bookingMode}
              bookingUrl={related.bookingUrl}
              location="related-service-card"
              class="service-booking-link"
            />
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- Consultation CTA -->
  <section id="book" class="bg-charcoal-light py-[clamp(56px,8vw,88px)] px-6 border-t border-gold-metal/10">
    <div class="max-w-[840px] mx-auto text-center">
      <span class="kicker">Questions Before You Book?</span>
      <h2 class="font-serif text-[clamp(28px,5vw,44px)] text-ink leading-tight mb-4">
        Is {service.title} the right next step?
      </h2>
      <p class="text-muted text-[15px] max-w-[560px] mx-auto mb-10 leading-relaxed">
        Call to discuss your goals and arrange a consultation, or review the current services menu before choosing your next step.
      </p>
      <div class="grid gap-3 sm:flex sm:flex-wrap sm:justify-center">
        <BookingLink
          slug={service.slug}
          bookingMode={service.bookingMode}
          bookingUrl={service.bookingUrl}
          location="service-final-cta"
        />
        <a href="/consultation/" class="btn-outline-gold">
          Talk Through My Options
        </a>
        <a href="/skin-analysis/" class="btn-outline-gold">Start With Skin Analysis</a>
      </div>
      <p class="text-muted text-[11px] tracking-[0.26em] uppercase mt-8 leading-relaxed">
        525 E Olympia Ave, Unit 9<br />Punta Gorda, FL 33950
      </p>
    </div>
  </section>
  </div>
</BaseLayout>
