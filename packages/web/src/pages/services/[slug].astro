---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import { sanityFetch, urlFor } from '@/lib/sanity';
import { getServiceFallbackImage } from '@/lib/imageFallbacks';
import { sbObjectId, sbFieldPath, sbFieldPathParts } from '@/lib/visualEditing';
import {
  ALL_SERVICE_SLUGS_QUERY,
  SERVICE_BY_SLUG_QUERY,
  type Service,
} from '@/lib/queries';
import { service as serviceJsonLd, breadcrumbList, faqPage } from '@/lib/structuredData';

export async function getStaticPaths() {
  const slugs = await sanityFetch<{ slug: string }[]>(ALL_SERVICE_SLUGS_QUERY);
  return slugs.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const service = await sanityFetch<Service>(SERVICE_BY_SLUG_QUERY, { slug });

// Slugs come from getStaticPaths (Sanity), so a miss is a data-integrity bug, not a
// runtime 404. Fail the build loudly — never `return Astro.redirect()` from a prerendered
// route: returning a Response in `output: 'static'` stops Astro emitting the sibling index
// chunk and breaks the build (see shop/[slug].astro).
if (!service) {
  throw new Error(`[services/[slug]] No service found in Sanity for slug "${slug}"`);
}

// Build structured data for SEO
const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonicalURL = new URL(Astro.url.pathname, site);
const fallbackImage = slug ? getServiceFallbackImage(slug) : undefined;
const socialImage = service.image
  ? urlFor(service.image).width(1200).height(630).fit('crop').url()
  : fallbackImage
    ? new URL(fallbackImage, site).toString()
    : undefined;
const heroImage = service.image
  ? urlFor(service.image).width(1920).height(1080).url()
  : fallbackImage;

const priceMatch = service.price ? String(service.price).match(/\d[\d,]*(?:\.\d+)?/) : null;
const priceNumber: number | null = priceMatch ? Number(priceMatch[0].replace(/,/g, '')) : null;

const serviceSchema = serviceJsonLd(
  {
    name: service.title,
    description: service.description ?? service.tagline ?? undefined,
    url: canonicalURL.toString(),
    image: socialImage,
    serviceType: service.tagline ?? service.title,
    minPrice: priceNumber,
  },
  site,
);

const breadcrumbSchema = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'Services', item: new URL('/services/', site).toString() },
  ...(service.parentService
    ? [
        {
          name: service.parentService.title,
          item: new URL(`/services/${service.parentService.slug}/`, site).toString(),
        },
      ]
    : []),
  { name: service.title, item: canonicalURL.toString() },
]);

const faqSchema = faqPage(service.faqs ?? []);

const pageTitle = service.seo?.metaTitle ?? `${service.title} in Punta Gorda, FL | House of Rose`;
const pageDescription = service.seo?.metaDescription ?? service.tagline ?? service.description ?? '';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={socialImage}
  preloadImage={heroImage}
>
  <!-- Structured Data for SEO -->
  <SchemaMarkup item={serviceSchema} slot="head" />
  <SchemaMarkup item={breadcrumbSchema} slot="head" />
  {faqSchema && <SchemaMarkup item={faqSchema} slot="head" />}
  {/* Visual Editor: all editable copy below belongs to this service document */}
  <div {...sbObjectId(service._id)}>
  <!-- Hero -->
  <section
    class="on-dark hero-dark hero relative w-full h-[55vh] min-h-[360px] flex items-end bg-walnut"
    style={heroImage ? `background-image: url(${heroImage}); background-size: cover; background-position: center;` : ''}
  >
    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-black/10"></div>
    <div class="relative z-10 max-w-[1280px] mx-auto px-6 pb-12 w-full">
      <a href={service.parentService ? `/services/${service.parentService.slug}/` : '/services/'} class="inline-flex items-center gap-2 text-ivory/75 text-[11px] tracking-[0.2em] uppercase mb-4 hover:text-gold transition-colors">
        <span class="text-lg">←</span> {service.parentService ? service.parentService.title : 'All Services'}
      </a>
      {service.tagline && (
        <span class="block text-[11px] font-medium tracking-[0.26em] uppercase text-gold mb-3" {...sbFieldPath('tagline')}>
          {service.tagline}
        </span>
      )}
      <h1 class="font-serif text-[clamp(32px,6vw,56px)] leading-tight font-normal text-ivory" {...sbFieldPath('title')}>
        {service.title}
      </h1>
      {(service.price || service.duration) && (
        <p class="mt-3 text-ivory/70 text-[13px] tracking-[0.18em] uppercase">
          {service.price && <span {...sbFieldPath('price')}>{service.price}</span>}{service.price && service.duration && <span class="text-gold mx-2">·</span>}{service.duration && <span {...sbFieldPath('duration')}>{service.duration}</span>}
        </p>
      )}
    </div>
  </section>

  <!-- Details Section -->
  <section class="bg-charcoal grid grid-cols-1 md:grid-cols-2 gap-12 py-16 px-6 md:px-12 max-w-[1280px] mx-auto">
    <!-- What It Is -->
    <div>
      <span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-4">What It Is</span>
      <p class="text-ink/80 text-[15px] leading-relaxed" {...sbFieldPath('description')}>
        {service.description ?? service.tagline ?? ''}
      </p>
    </div>

    <!-- Who It's For + Process -->
    <div class="space-y-8">
      {service.whoItsFor && (
        <div>
          <span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-4">Who It's For</span>
          <p class="text-muted text-[14px] leading-relaxed" {...sbFieldPath('whoItsFor')}>{service.whoItsFor}</p>
        </div>
      )}

      {service.process && service.process.length > 0 && (
        <div>
          <span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-4">The Process</span>
          <ol class="list-decimal list-inside space-y-2 text-muted text-[14px] leading-relaxed">
            {service.process.map((step, i) => (
              <li {...sbFieldPath(`process.${i}`)}>{step}</li>
            ))}
          </ol>
        </div>
      )}
    </div>
  </section>

  <!-- Provider attribution (when assigned in Sanity) -->
  {service.provider && (
    <section class="bg-charcoal-light py-10 px-6 border-y border-gold-metal/10">
      <div class="max-w-[960px] mx-auto" {...sbObjectId(service.provider._id)}>
        <span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-3">Your Provider</span>
        <h2 class="font-serif text-[clamp(22px,3vw,30px)] text-ink">
          {service.provider.fullName ?? service.provider.title}
          {service.provider.roleCredential && <span class="text-ink/65"> · {service.provider.roleCredential}</span>}
        </h2>
        {service.provider.scopeOfPractice && (
          <p class="text-muted text-[14px] leading-relaxed mt-3 max-w-[720px]">{service.provider.scopeOfPractice}</p>
        )}
      </div>
    </section>
  )}

  <!-- Treatments under this service (hub pages) -->
  {service.treatments && service.treatments.length > 0 && (
    <section class="bg-charcoal-light py-[clamp(48px,7vw,80px)] px-6">
      <div class="max-w-[1280px] mx-auto">
        <span class="kicker">Treatments</span>
        <h2 class="font-serif text-[clamp(24px,4vw,36px)] text-ink mt-2 mb-10">
          Choose your protocol
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-px bg-gold-metal/10">
          {service.treatments.map((t) => (
            <a href={`/services/${t.slug}/`} class="bg-charcoal p-7 group block transition-colors hover:bg-charcoal-lighter" {...sbObjectId(t._id)}>
              <h3 class="font-serif text-[20px] text-ink mb-2 group-hover:text-gold transition-colors" {...sbFieldPath('title')}>{t.title}</h3>
              {t.tagline && <p class="text-muted text-[13px] leading-[1.6] mb-4" {...sbFieldPath('tagline')}>{t.tagline}</p>}
              <p class="text-ink/70 text-[12px] tracking-[0.16em] uppercase">
                {t.price}{t.price && t.duration && <span class="text-gold mx-2">·</span>}{t.duration}
              </p>
              <span class="learn-more group-hover:text-gold mt-3 inline-block">View Treatment</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Decision-stage links only appear when this service is part of a comparison. -->
  {service.comparisons && service.comparisons.length > 0 && (
    <section class="bg-charcoal py-16 px-6">
      <div class="max-w-[1280px] mx-auto">
        <span class="kicker">Compare Your Options</span>
        <h2 class="font-serif text-[clamp(24px,4vw,36px)] text-ink mt-2 mb-4">
          See how this treatment fits your goals
        </h2>
        <p class="text-muted text-[15px] leading-relaxed max-w-[680px] mb-10">
          When more than one approach may fit, these clear comparisons can help you prepare for a more informed consultation.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-gold-metal/10">
          {service.comparisons.map((comparison) => (
            <a href={`/compare/${comparison.slug}/`} class="bg-charcoal-light p-7 group block transition-colors hover:bg-charcoal-lighter" {...sbObjectId(comparison._id)}>
              <h3 class="font-serif text-[21px] text-ink mb-3 group-hover:text-gold transition-colors">{comparison.title}</h3>
              <p class="text-muted text-[14px] leading-relaxed">{comparison.intro}</p>
              <span class="learn-more group-hover:text-gold mt-4 inline-block">Read the Comparison</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Contextual pricing guides surface only when this service has one. -->
  {service.costGuides && service.costGuides.length > 0 && (
    <section class="bg-charcoal-light py-16 px-6 border-y border-gold-metal/10">
      <div class="max-w-[960px] mx-auto">
        <span class="kicker">Plan Your Investment</span>
        <h2 class="font-serif text-[clamp(24px,4vw,36px)] text-ink mt-2 mb-4">
          Clear pricing for this treatment
        </h2>
        <div class="grid grid-cols-1 gap-px bg-gold-metal/10 mt-8">
          {service.costGuides.map((guide) => {
            const price = guide.priceLow != null && guide.priceHigh != null
              ? `$${guide.priceLow.toLocaleString()}–$${guide.priceHigh.toLocaleString()}`
              : guide.priceLow != null
                ? `From $${guide.priceLow.toLocaleString()}`
                : null;

            return (
              <a href={`/cost/${guide.slug}/`} class="bg-charcoal p-7 group block transition-colors hover:bg-charcoal-lighter" {...sbObjectId(guide._id)}>
                <div class="flex flex-wrap items-baseline justify-between gap-3 mb-3">
                  <h3 class="font-serif text-[21px] text-ink group-hover:text-gold transition-colors">{guide.title}</h3>
                  {price && <span class="text-gold text-[13px] tracking-[0.12em] uppercase">{price}{guide.priceUnit ? ` ${guide.priceUnit}` : ''}</span>}
                </div>
                <p class="text-muted text-[14px] leading-relaxed">{guide.answer}</p>
                <span class="learn-more group-hover:text-gold mt-4 inline-block">View Pricing Guide</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- FAQs -->
  {service.faqs && service.faqs.length > 0 && (
    <section class="bg-charcoal-light py-16 px-6">
      <div class="max-w-[960px] mx-auto">
        <span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-8 text-center">
          Common Questions
        </span>
        <div class="space-y-6">
          {service.faqs.map((faq, i) => (
            <div class="border-b border-ink/5 pb-6">
              <h3 class="text-ink text-[17px] font-medium mb-3" {...sbFieldPathParts('faqs', i, 'question')}>{faq.question}</h3>
              <p class="text-muted text-[14px] leading-relaxed" {...sbFieldPathParts('faqs', i, 'answer')}>{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Related Services -->
  {service.relatedServices && service.relatedServices.length > 0 && (
    <section class="bg-charcoal py-16 px-6">
      <span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-8 max-w-[1280px] mx-auto">
        Related Services
      </span>
      <div class="max-w-[1280px] mx-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-px bg-gold-metal/10">
        {service.relatedServices.map((related) => (
          <div class="bg-charcoal">
            <a href={`/services/${related.slug}/`} class="service-card group block" {...sbObjectId(related._id)}>
              {related.image && (
                <div class="aspect-square overflow-hidden bg-charcoal-lighter mb-4">
                  <img
                    src={urlFor(related.image).width(400).height(400).fit('crop').url()}
                    alt={related.image.alt ?? related.title}
                    width={400}
                    height={400}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                </div>
              )}
              <span class="service-name" {...sbFieldPath('title')}>{related.title}</span>
              {related.tagline && <p class="service-desc mt-1" {...sbFieldPath('tagline')}>{related.tagline}</p>}
              <span class="learn-more group-hover:text-gold">Learn More</span>
            </a>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Booking CTA -->
  <section id="book" class="bg-charcoal-light py-[clamp(56px,8vw,88px)] px-6 border-t border-gold-metal/10">
    <div class="max-w-[840px] mx-auto text-center">
      <span class="kicker">Reserve Your Experience</span>
      <h2 class="font-serif text-[clamp(28px,5vw,44px)] text-ink leading-tight mb-4">
        Ready to experience {service.title}?
      </h2>
      <p class="text-muted text-[15px] max-w-[450px] mx-auto mb-10 leading-relaxed">
        Begin with a private consultation. We will design your personal protocol.
      </p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="tel:+18449417673" class="btn-outline-gold">
          (844) 941-7673
        </a>
        <a href="https://houseofrose.glossgenius.com/services" target="_blank" rel="noopener noreferrer" class="btn-gold">
          Book Online
        </a>
      </div>
      <p class="text-muted text-[11px] tracking-[0.26em] uppercase mt-8 leading-relaxed">
        525 E Olympia Ave, Unit 9<br />Punta Gorda, FL 33950
      </p>
    </div>
  </section>
  </div>
</BaseLayout>
