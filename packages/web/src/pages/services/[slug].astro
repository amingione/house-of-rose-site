---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sanityFetch, urlFor } from '@/lib/sanity';
import {
  ALL_SERVICE_SLUGS_QUERY,
  SERVICE_BY_SLUG_QUERY,
  type Service,
} from '@/lib/queries';

export async function getStaticPaths() {
  const slugs = await sanityFetch<{ slug: string }[]>(ALL_SERVICE_SLUGS_QUERY);
  return slugs.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const service = await sanityFetch<Service>(SERVICE_BY_SLUG_QUERY, { slug });

if (!service) {
  return Astro.redirect('/services', 307);
}

// Build structured data for SEO
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.title,
  "description": service.description ?? service.tagline ?? '',
  "provider": {
    "@type": "MedicalBusiness",
    "name": "House of Rose",
    "url": Astro.site?.toString(),
    "telephone": "+18449417673",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "525 E Olympia Ave, Unit 9",
      "addressLocality": "Punta Gorda",
      "addressRegion": "FL",
      "postalCode": "33982",
      "addressCountry": "US"
    }
  },
  "url": canonicalURL.toString(),
  ...(service.image && {
    "image": urlFor(service.image).width(1200).height(630).fit('crop').url()
  }),
  "serviceType": service.tagline ?? service.title,
  "areaServed": {
    "@type": "GeoCircle",
    "geoMidpoint": {
      "@type": "GeoCoordinates",
      "latitude": "26.9298",
      "longitude": "-82.0454"
    },
    "geoRadius": "50000"
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": Astro.site?.toString() },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": `${Astro.site}services` },
    { "@type": "ListItem", "position": 3, "name": service.title, "item": canonicalURL.toString() }
  ]
};

const faqSchema = service.faqs && service.faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": service.faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
  }))
} : null;

const pageTitle = service.seo?.metaTitle ?? `${service.title} in Punta Gorda, FL | House of Rose`;
const pageDescription = service.seo?.metaDescription ?? service.tagline ?? service.description ?? '';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={service.image ? urlFor(service.image).width(1200).height(630).fit('crop').url() : undefined}
  preloadImage={service.image ? urlFor(service.image).width(1920).height(1080).url() : undefined}
>
  <!-- Structured Data for SEO -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  {faqSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />}
  <!-- Hero -->
  <section
    class="hero relative w-full h-[55vh] min-h-[360px] flex items-end bg-charcoal"
    style={service.image ? `background-image: url(${urlFor(service.image).width(1920).height(1080).url()}); background-size: cover; background-position: center;` : ''}
  >
    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-black/10"></div>
    <div class="relative z-10 max-w-[1280px] mx-auto px-6 pb-12 w-full">
      <a href="/services" class="inline-flex items-center gap-2 text-white/75 text-[11px] tracking-[0.2em] uppercase mb-4 hover:text-gold transition-colors">
        <span class="text-lg">←</span> All Services
      </a>
      {service.tagline && (
        <span class="block text-[10px] tracking-[0.4em] uppercase text-gold mb-3">
          {service.tagline}
        </span>
      )}
      <h1 class="font-serif text-[clamp(32px,6vw,56px)] leading-tight font-normal text-white">
        {service.title}
      </h1>
    </div>
  </section>

  <!-- Details Section -->
  <section class="bg-charcoal grid grid-cols-1 md:grid-cols-2 gap-12 py-16 px-6 md:px-12 max-w-[1280px] mx-auto">
    <!-- What It Is -->
    <div>
      <span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-4">What It Is</span>
      <p class="text-white/80 text-[15px] leading-relaxed">
        {service.description ?? 'Details coming soon.'}
      </p>
    </div>

    <!-- Who It's For + Process -->
    <div class="space-y-8">
      {service.whoItsFor && (
        <div>
          <span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-4">Who It's For</span>
          <p class="text-[#888] text-[14px] leading-relaxed">{service.whoItsFor}</p>
        </div>
      )}

      {service.process && service.process.length > 0 && (
        <div>
          <span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-4">The Process</span>
          <ol class="list-decimal list-inside space-y-2 text-[#888] text-[14px] leading-relaxed">
            {service.process.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
        </div>
      )}
    </div>
  </section>

  <!-- FAQs -->
  {service.faqs && service.faqs.length > 0 && (
    <section class="bg-charcoal-light py-16 px-6">
      <div class="max-w-[960px] mx-auto">
        <span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-8 text-center">
          Common Questions
        </span>
        <div class="space-y-6">
          {service.faqs.map((faq) => (
            <div class="border-b border-white/5 pb-6">
              <h3 class="text-white text-[17px] font-medium mb-3">{faq.question}</h3>
              <p class="text-[#777] text-[14px] leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Related Services -->
  {service.relatedServices && service.relatedServices.length > 0 && (
    <section class="bg-charcoal py-16 px-6">
      <span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-8 max-w-[1280px] mx-auto">
        Related Services
      </span>
      <div class="max-w-[1280px] mx-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-px bg-gold/10">
        {service.relatedServices.map((related) => (
          <div class="bg-charcoal">
            <a href={`/services/${related.slug}`} class="service-card group block">
              {related.image && (
                <div class="aspect-square overflow-hidden bg-charcoal-lighter mb-4">
                  <img
                    src={urlFor(related.image).width(400).height(400).fit('crop').url()}
                    alt={related.image.alt ?? related.title}
                    width={400}
                    height={400}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                </div>
              )}
              <span class="service-name">{related.title}</span>
              {related.tagline && <p class="service-desc mt-1">{related.tagline}</p>}
              <span class="learn-more group-hover:text-gold">Learn More</span>
            </a>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- CTA Section -->
  <section class="bg-charcoal-light py-16 px-6">
    <div class="max-w-[840px] mx-auto text-center">
      <h2 class="font-serif text-[clamp(28px,4vw,38px)] text-white mb-4">
        Ready to experience {service.title}?
      </h2>
      <p class="text-[#777] text-[15px] mb-8">
        Begin with a private consultation. We will design your personal protocol.
      </p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="tel:+18449417673" class="btn-outline-gold">
          (844) 941-7673
        </a>
        <a href="https://houseofrose.glossgenius.com/services" target="_blank" rel="noopener noreferrer" class="btn-gold">
          Book Online
        </a>
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section id="book" class="bg-charcoal py-[clamp(56px,8vw,88px)] px-6 border-t border-gold/10">
    <div class="max-w-[680px] mx-auto text-center">
      <span class="kicker">Reserve Your Experience</span>
      <h2 class="font-serif text-[clamp(28px,5vw,44px)] text-white leading-tight mb-4">
        Begin Your Transformation
      </h2>
      <p class="text-[#777] text-[15px] max-w-[450px] mx-auto mb-10 leading-relaxed">
        Every treatment begins with a private consultation.
      </p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="tel:+18449417673" class="btn-outline-gold">
          (844) 941-7673
        </a>
        <a href="https://houseofrose.glossgenius.com/services" target="_blank" rel="noopener noreferrer" class="btn-gold">
          Book Online
        </a>
      </div>
      <p class="text-[#444] text-[10px] tracking-[0.26em] uppercase mt-8 leading-relaxed">
        525 E Olympia Ave, Unit 9<br />Punta Gorda, FL 33982
      </p>
    </div>
  </section>
</BaseLayout>
