---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import { sanityFetch } from '@/lib/sanity';
import { ALL_COLLECTIONS_QUERY, ALL_SERVICES_QUERY, type ServiceCollection, type Service } from '@/lib/queries';
import { sbObjectField } from '@/lib/visualEditing';
import { GLOSSGENIUS_SERVICES_URL } from '@/lib/booking';

// ─── Grouped services index ───────────────────────────────────────────────────
// Collections come from Sanity (`serviceCollection`); this page rolls them up
// into a concise treatment index. The anchor ids are stable public links while
// the collection slugs mirror the current Sanity collection taxonomy.

interface GroupSection {
  /** Anchor id — must match GROUP_ANCHORS in pages/index.astro */
  id: string;
  title: string;
  description: string;
  /** serviceCollection slugs rolled into this umbrella, in display order */
  collectionSlugs: string[];
  contextualLink?: {
    context: string;
    href: string;
    label: string;
  };
}

const SERVICE_GROUP_SECTIONS: GroupSection[] = [
  {
    id: 'advanced-skin-treatments',
    title: 'Skin & Device Treatments',
    description: 'Morpheus8, Lumecca, and Forma use different technologies. Compare microneedling with radiofrequency, intense pulsed light, and radiofrequency treatment without needling.',
    collectionSlugs: ['inmode'],
  },
  {
    id: 'injectables-structural-enhancements',
    title: 'Injectables',
    description: 'The injectable menu includes neurotoxins for movement-related lines, hyaluronic-acid fillers for selected areas of lost volume, and injectable PRF services.',
    collectionSlugs: ['injectables-bio-fillers'],
    contextualLink: {
      context: 'Botox and Daxxify are each $14 per product-specific unit, but their units cannot be compared or converted.',
      href: '/compare/daxxify-vs-botox/',
      label: 'Compare Daxxify and Botox',
    },
  },
  {
    id: 'skin-health-corrective-care',
    title: 'Facials & Skin Care',
    description: 'Browse facials, peels, dermaplaning, microneedling, topical PRF, and the Face Reality Acne Program by the concern or appointment you want to understand.',
    collectionSlugs: ['facials'],
    contextualLink: {
      context: 'Surface appointments, Procell Microneedling with its topical PRF option, and the 12-week Face Reality program follow different paths.',
      href: '/services/collections/facials/',
      label: 'Use the Facials & Skin Care guide',
    },
  },
  {
    id: 'wellness-performance-support',
    title: 'IV Hydration & Weight Management',
    description: 'IV Hydration offers six base options: one 30-minute appointment and five 45-minute appointments, each with its own price. Weight Management begins with a $25, 40-minute consultation with Diana Morrison, RN; medication and ongoing program prices are confirmed with the practice.',
    collectionSlugs: ['iv-hydration-therapy'],
  },
  {
    id: 'beauty-grooming',
    title: 'Waxing',
    description: 'Facial waxing covers brows, upper lip, and chin. Body waxing includes underarms, bikini line, arms, legs, back, and chest.',
    collectionSlugs: ['waxing'],
  },
];

const [collections, allServices] = await Promise.all([
  sanityFetch<ServiceCollection[]>(ALL_COLLECTIONS_QUERY),
  sanityFetch<Service[]>(ALL_SERVICES_QUERY),
]);
const bySlug = new Map<string, ServiceCollection>(collections.map((c) => [c.slug, c]));

/**
 * Keep canonical decision hubs beside directly bookable services. A hub may not
 * book as one appointment, but it still explains a current service family and
 * gives clients a useful place to compare its verified options.
 */
const directoryServices = (services: Service[]): Service[] => services;

interface ResolvedSection extends GroupSection {
  collections: { collection: ServiceCollection; services: Service[] }[];
}

const sections: ResolvedSection[] = SERVICE_GROUP_SECTIONS.map((section) => ({
  ...section,
  collections: section.collectionSlugs
    .map((slug) => bySlug.get(slug))
    .filter((c): c is ServiceCollection => Boolean(c))
    .map((collection) => ({ collection, services: directoryServices(collection.services) }))
    .filter(({ services }) => services.length > 0),
})).filter((section) => section.collections.length > 0);

// Anything not mapped above still renders (future collections never silently vanish).
const mappedSlugs = new Set(SERVICE_GROUP_SECTIONS.flatMap((s) => s.collectionSlugs));
const collectionUnmappedServices = collections
  .filter((c) => !mappedSlugs.has(c.slug))
  .flatMap((collection) => directoryServices(collection.services));
const standaloneServices = allServices.filter((service) => service.slug === 'permanent-jewelry');
const unmappedServices = Array.from(
  new Map([...collectionUnmappedServices, ...standaloneServices].map((service) => [service.slug, service])).values(),
);

---

<BaseLayout
  title="Medical Aesthetic Services | House of Rose Punta Gorda, FL"
  description="Skin, injectable, facial, IV hydration, weight-management, waxing, and permanent-jewelry services at House of Rose Aesthetics in Punta Gorda."
  preloadImage="/images/optimized/actual-reception-800.webp"
  preloadImageSrcset="/images/optimized/actual-reception-800.webp 800w, /images/optimized/actual-reception-1400-light.webp 1400w"
  preloadImageSizes="100vw"
>
  <!-- Hero -->
  <Hero
    title="Services at House of Rose."
    kicker="Punta Gorda, Florida"
    description="Browse skin treatments, injectables, facials, IV hydration, weight management, waxing, and permanent jewelry."
    size="small"
    backgroundImage="/images/optimized/actual-reception-1400-light.webp"
    backgroundSrcset="/images/optimized/actual-reception-800.webp 800w, /images/optimized/actual-reception-1400-light.webp 1400w"
    backgroundSizes="100vw"
    imageAlt="The reception and waiting area inside House of Rose Aesthetics in Punta Gorda"
  />

  <!-- Compact treatment index -->
  <nav aria-label="Service groups" class="service-group-nav border-b border-gold-metal/10 bg-charcoal px-5 py-5 sm:px-6">
    <div class="mx-auto max-w-[1280px]">
      <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-muted">Services by category</p>
      <div class="service-group-nav-track flex gap-2 overflow-x-auto pb-1">
        {sections.map((section) => (
          <a
            href={`#${section.id}`}
            class="min-h-[44px] shrink-0 border border-ivory/15 bg-breath px-4 py-3 text-[12px] font-semibold text-ivory transition-colors hover:border-ivory/35 hover:bg-charcoal-light"
          >
            {section.title}
          </a>
        ))}
      </div>
    </div>
  </nav>

  <section data-service-index-guidance class="border-b border-gold-metal/10 bg-charcoal-light px-5 py-[clamp(40px,6vw,64px)] sm:px-6">
    <div class="mx-auto grid max-w-[1280px] gap-8 lg:grid-cols-[minmax(0,1.2fr)_minmax(280px,0.8fr)] lg:items-end lg:gap-16">
      <div class="max-w-[760px]">
        <p class="kicker mb-4">What you notice matters</p>
        <h2 class="font-serif text-[clamp(28px,5vw,44px)] leading-tight text-ink">
          Movement, lost volume, pigment, and texture are different questions.
        </h2>
        <p class="mt-5 max-w-[700px] text-[15px] leading-7 text-muted">
          A line that appears with expression is not the same question as a cheek that looks less full or a patch of uneven color. Each service page connects those differences to its appointment details and shows whether to book online, request a consultation, or call.
        </p>
      </div>
      <div class="border-l border-gold-metal/25 pl-6">
        <p class="text-[14px] leading-7 text-muted">
          Prefer to choose by practitioner? The provider directory names each person, their licence type, and the appointments they currently provide.
        </p>
        <a href="/about/providers/" class="learn-more mt-4 inline-flex">
          Meet the House of Rose team →
        </a>
      </div>
    </div>
  </section>

  <!-- Grouped services -->
  {sections.map((section, sectionIndex) => (
    <section
      id={section.id}
      class={`${sectionIndex % 2 === 0 ? 'bg-charcoal' : 'bg-charcoal-light'} scroll-mt-24 py-[clamp(32px,5vw,56px)]`}
    >
      <div class="mx-auto max-w-[1280px] px-5 sm:px-6">
        <div class="mb-6 grid gap-3 border-b border-gold-metal/20 pb-6 sm:mb-8 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end">
          <div class="max-w-[720px]">
            <h2 class="font-serif text-[clamp(28px,5vw,40px)] leading-tight text-ink">{section.title}</h2>
            <p class="mt-4 max-w-[690px] text-[15px] leading-7 text-muted">{section.description}</p>
            {section.contextualLink && (
              <p class="mt-4 max-w-[690px] text-[14px] leading-6 text-muted">
                {section.contextualLink.context}{' '}
                <a href={section.contextualLink.href} class="text-gold underline decoration-gold-metal/50 underline-offset-4 hover:text-ink">
                  {section.contextualLink.label}
                </a>
              </p>
            )}
          </div>
          <p class="text-[12px] font-semibold uppercase tracking-[0.12em] text-muted">
            {section.collections.reduce((count, entry) => count + entry.services.length, 0)}
            {' '}
            {section.collections.reduce((count, entry) => count + entry.services.length, 0) === 1 ? 'service' : 'services'}
          </p>
        </div>

        {section.collections.map(({ collection, services }) => (
          <div class="mb-10 last:mb-0">
            {section.collections.length > 1 && (
              <div class="mb-6 flex items-baseline gap-4 border-b border-gold-metal/15 pb-3">
                <h3 class="font-serif text-[clamp(19px,2.4vw,24px)] text-ink">
                  <a
                    href={`/services/collections/${collection.slug}/`}
                    class="hover:text-gold transition-colors"
                    {...sbObjectField(collection._id, 'title')}
                  >
                    {collection.title}
                  </a>
                </h3>
                <a
                  href={`/services/collections/${collection.slug}/`}
                  class="learn-more ml-auto whitespace-nowrap text-[11px]"
                >
                  View {collection.title} →
                </a>
              </div>
            )}
            {services.map((service) => (
              <ServiceCard
                title={service.title}
                slug={service.slug}
                image={service.image}
                bookingMode={service.bookingMode}
                bookingUrl={service.bookingUrl}
                variant="row"
                objectId={service._id}
              />
            ))}
          </div>
        ))}
      </div>
    </section>
  ))}

  {unmappedServices.length > 0 && (
    <section id="more" class="bg-charcoal-light py-[clamp(32px,5vw,56px)] scroll-mt-24">
      <div class="mx-auto max-w-[1280px] px-5 sm:px-6">
        <div class="mb-6 max-w-[720px] border-b border-gold-metal/20 pb-6 sm:mb-8">
          <h2 class="font-serif text-[clamp(26px,3.6vw,38px)] text-ink">Additional Services</h2>
        </div>
        {unmappedServices.map((service) => (
          <ServiceCard
            title={service.title}
            slug={service.slug}
            image={service.image}
            bookingMode={service.bookingMode}
            bookingUrl={service.bookingUrl}
            variant="row"
            objectId={service._id}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Contact CTA -->
  <section id="book" class="border-t border-gold-metal/10 bg-charcoal px-5 py-[clamp(48px,7vw,72px)] sm:px-6">
    <div class="max-w-[680px] mx-auto text-center">
      <span class="kicker">Questions</span>
      <h2 class="font-serif text-[clamp(28px,5vw,44px)] text-ink leading-tight mb-4">
        Book online or speak with House of Rose.
      </h2>
      <p class="text-muted text-[15px] max-w-[450px] mx-auto mb-10 leading-relaxed">
        Book online when you know the appointment you want. Call when two services still sound similar or you would rather talk it through before booking.
      </p>
      <div class="grid gap-3 sm:flex sm:flex-wrap sm:justify-center">
        <a href={GLOSSGENIUS_SERVICES_URL} target="_blank" rel="noopener noreferrer" class="btn-gold" data-global-booking data-cta-location="services-index-final">
          Book a service
        </a>
        <a href="tel:+18449417673" class="btn-outline-gold">
          Call (844) 941-7673
        </a>
      </div>
      <p class="text-muted text-[11px] tracking-[0.26em] uppercase mt-8 leading-relaxed">
        525 E Olympia Ave, Unit 9<br />Punta Gorda, FL 33950
      </p>
    </div>
  </section>
</BaseLayout>
