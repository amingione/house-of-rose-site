---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import { sanityFetch } from '@/lib/sanity';
import { ALL_COLLECTIONS_QUERY, type ServiceCollection, type Service } from '@/lib/queries';
import { sbObjectField } from '@/lib/visualEditing';

// ─── Grouped services index ───────────────────────────────────────────────────
// The homepage's four pillars (serviceGroups) deep-link here via anchor ids.
// Collections come from Sanity (`serviceCollection`); this page rolls them up
// into the marketing umbrellas so clicking "Injectables" never shows lashes.
// Mapping decided in docs/PRICING-RECONCILIATION-2026-07-23.md §4 (F1/F2).

interface GroupSection {
  /** Anchor id — must match GROUP_ANCHORS in pages/index.astro */
  id: string;
  kicker: string;
  title: string;
  /** serviceCollection slugs rolled into this umbrella, in display order */
  collectionSlugs: string[];
}

const SERVICE_GROUP_SECTIONS: GroupSection[] = [
  {
    id: 'advanced-skin-treatments',
    kicker: 'Amber · Advanced Aesthetics',
    title: 'Advanced Skin Treatments',
    collectionSlugs: ['advanced-facials', 'microchanneling-microneedling', 'skin-renewal'],
  },
  {
    id: 'injectables-structural-enhancements',
    kicker: 'Diana · Medical Aesthetics',
    title: 'Injectables & Structural Enhancements',
    collectionSlugs: ['injectables-bio-fillers'],
  },
  {
    id: 'skin-health-corrective-care',
    kicker: 'Skin Health',
    title: 'Skin Health & Corrective Care',
    collectionSlugs: ['facials', 'acne-bootcamp', 'enhancements-add-ons'],
  },
  {
    id: 'wellness-performance-support',
    kicker: 'Wellness',
    title: 'Wellness & Performance Support',
    collectionSlugs: ['wellness-restoration', 'permanent-jewelry'],
  },
  {
    id: 'beauty-grooming',
    kicker: 'Aundrea & Brandy · Beauty Studio',
    title: 'Beauty & Grooming',
    collectionSlugs: ['lash-services', 'makeup', 'waxing'],
  },
];

const collections = await sanityFetch<ServiceCollection[]>(ALL_COLLECTIONS_QUERY);
const bySlug = new Map<string, ServiceCollection>(collections.map((c) => [c.slug, c]));

/** Hub docs are landing pages, not bookable services — keep them out of the menu list. */
const bookable = (services: Service[]): Service[] => services.filter((s) => s.kind !== 'hub');

interface ResolvedSection extends GroupSection {
  collections: { collection: ServiceCollection; services: Service[] }[];
}

const sections: ResolvedSection[] = SERVICE_GROUP_SECTIONS.map((section) => ({
  ...section,
  collections: section.collectionSlugs
    .map((slug) => bySlug.get(slug))
    .filter((c): c is ServiceCollection => Boolean(c))
    .map((collection) => ({ collection, services: bookable(collection.services) }))
    .filter(({ services }) => services.length > 0),
})).filter((section) => section.collections.length > 0);

// Anything not mapped above still renders (future collections never silently vanish).
const mappedSlugs = new Set(SERVICE_GROUP_SECTIONS.flatMap((s) => s.collectionSlugs));
const unmapped = collections
  .filter((c) => !mappedSlugs.has(c.slug))
  .map((collection) => ({ collection, services: bookable(collection.services) }))
  .filter(({ services }) => services.length > 0);

let cardNumber = 0;
const nextNumber = (): string => String(++cardNumber).padStart(2, '0');
---

<BaseLayout
  title="Advanced Aesthetic Services | House of Rose Punta Gorda, FL"
  description="Browse all services at House of Rose — Procell microchanneling, PRF, injectables, BioRePeel, IV hydration & GLP-1 programs in Punta Gorda, FL."
  preloadImage="/images/hor-skin-studio.webp"
>
  <!-- Hero -->
  <Hero
    title="Our Services"
    kicker="What We Offer"
    size="small"
    backgroundImage="/images/banner/hr-br-7.webp"
  />

  <!-- Group index (jump nav) -->
  <nav aria-label="Service groups" class="bg-charcoal border-b border-gold-metal/10 py-6 px-6">
    <div class="max-w-[1280px] mx-auto flex flex-wrap gap-x-8 gap-y-3">
      {sections.map((section) => (
        <a
          href={`#${section.id}`}
          class="text-[11px] tracking-[0.2em] uppercase text-gold border-b border-transparent hover:border-gold pb-0.5 transition-colors"
        >
          {section.title}
        </a>
      ))}
    </div>
  </nav>

  <!-- Grouped services -->
  {sections.map((section, sectionIndex) => (
    <section
      id={section.id}
      class={`${sectionIndex % 2 === 0 ? 'bg-charcoal' : 'bg-charcoal-light'} py-[clamp(40px,6vw,80px)] scroll-mt-24`}
    >
      <div class="max-w-[1280px] mx-auto px-6">
        <div class="max-w-[720px] mb-10">
          <span class="kicker">{section.kicker}</span>
          <h2 class="font-serif text-[clamp(26px,3.6vw,38px)] text-ink mt-2">{section.title}</h2>
        </div>

        {section.collections.map(({ collection, services }) => (
          <div class="mb-12 last:mb-0">
            {section.collections.length > 1 && (
              <div class="flex items-baseline gap-4 mb-6 border-b border-gold-metal/15 pb-3">
                <h3 class="font-serif text-[clamp(19px,2.4vw,24px)] text-ink">
                  <a
                    href={`/services/collections/${collection.slug}/`}
                    class="hover:text-gold transition-colors"
                    {...sbObjectField(collection._id, 'title')}
                  >
                    {collection.title}
                  </a>
                </h3>
                <a
                  href={`/services/collections/${collection.slug}/`}
                  class="learn-more text-[11px] whitespace-nowrap ml-auto"
                >
                  View {collection.title} →
                </a>
              </div>
            )}
            {services.map((service) => (
              <ServiceCard
                title={service.title}
                slug={service.slug}
                tagline={service.tagline}
                image={service.image}
                variant="row"
                number={nextNumber()}
                objectId={service._id}
              />
            ))}
          </div>
        ))}
      </div>
    </section>
  ))}

  {unmapped.length > 0 && (
    <section id="more" class="bg-charcoal-light py-[clamp(40px,6vw,80px)] scroll-mt-24">
      <div class="max-w-[1280px] mx-auto px-6">
        <div class="max-w-[720px] mb-10">
          <span class="kicker">More at House of Rose</span>
          <h2 class="font-serif text-[clamp(26px,3.6vw,38px)] text-ink mt-2">Additional Services</h2>
        </div>
        {unmapped.map(({ collection, services }) => (
          <div class="mb-12 last:mb-0">
            <div class="flex items-baseline gap-4 mb-6 border-b border-gold-metal/15 pb-3">
              <h3
                class="font-serif text-[clamp(19px,2.4vw,24px)] text-ink"
                {...sbObjectField(collection._id, 'title')}
              >
                {collection.title}
              </h3>
            </div>
            {services.map((service) => (
              <ServiceCard
                title={service.title}
                slug={service.slug}
                tagline={service.tagline}
                image={service.image}
                variant="row"
                number={nextNumber()}
                objectId={service._id}
              />
            ))}
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Also at House of Rose — Professional Makeup (singleton hub, not a service doc) -->
  <section class="bg-charcoal-light py-[clamp(40px,6vw,72px)] px-6 border-t border-gold-metal/10">
    <div class="max-w-[1080px] mx-auto">
      <a
        href="/services/professional-makeup/"
        class="group grid grid-cols-1 md:grid-cols-[1fr_auto] items-center gap-6 bg-breath p-8 transition-colors hover:bg-charcoal"
      >
        <div>
          <span class="kicker">Also at House of Rose</span>
          <h2 class="font-serif text-[clamp(24px,3.4vw,34px)] text-ink mt-2 mb-2">Professional Makeup</h2>
          <p class="text-muted text-[15px] leading-[1.75] max-w-[640px]">
            Event, wedding, prom, and photography makeup applied with skin-first Jane Iredale mineral
            makeup — in-studio or on location. Explore our looks, the Jane Iredale line, and group event bookings.
          </p>
        </div>
        <span class="learn-more whitespace-nowrap">Explore Makeup →</span>
      </a>
    </div>
  </section>

  <!-- Learn before you choose — canonical needling hub -->
  <section class="bg-charcoal py-[clamp(40px,6vw,72px)] px-6 border-t border-gold-metal/10">
    <div class="max-w-[1080px] mx-auto">
      <a
        href="/services/microneedling/"
        class="group grid grid-cols-1 md:grid-cols-[1fr_auto] items-center gap-6 bg-breath p-8 transition-colors hover:bg-charcoal-light"
      >
        <div>
          <span class="kicker">Learn Before You Choose</span>
          <h2 class="font-serif text-[clamp(24px,3.4vw,34px)] text-ink mt-2 mb-2">Microneedling</h2>
          <p class="text-muted text-[15px] leading-[1.75] max-w-[640px]">
            An honest, plain-language guide to what microneedling does, the areas it can treat, realistic
            series, and how to choose your protocol — with links to every matching service.
          </p>
        </div>
        <span class="learn-more whitespace-nowrap">Explore the Guide →</span>
      </a>
    </div>
  </section>

  <!-- How to Choose Section -->
  <section class="bg-charcoal-light py-[clamp(56px,8vw,88px)] px-6">
    <div class="max-w-[960px] mx-auto text-center mb-16">
      <span class="kicker">Not Sure Where to Start?</span>
      <h2 class="font-serif text-[32px] text-ink mt-2">
        How to Choose
      </h2>
    </div>

    <div class="max-w-[1120px] mx-auto grid grid-cols-1 md:grid-cols-3 gap-12">
      <!-- Step 1 -->
      <div class="text-center">
        <p class="text-gold text-[48px] font-serif mb-4">01</p>
        <p class="text-ink text-[17px] font-medium mb-3 tracking-wide">
          Define Your Goal
        </p>
        <p class="text-muted text-[14px] leading-relaxed">
          Skin quality, body composition, energy, or wellness. Your goal determines your path.
        </p>
      </div>

      <!-- Step 2 -->
      <div class="text-center">
        <p class="text-gold text-[48px] font-serif mb-4">02</p>
        <p class="text-ink text-[17px] font-medium mb-3 tracking-wide">
          Book a Consultation
        </p>
        <p class="text-muted text-[14px] leading-relaxed">
          Every client begins with a private consultation. We assess, listen, and design a protocol.
        </p>
      </div>

      <!-- Step 3 -->
      <div class="text-center">
        <p class="text-gold text-[48px] font-serif mb-4">03</p>
        <p class="text-ink text-[17px] font-medium mb-3 tracking-wide">
          Begin Your Protocol
        </p>
        <p class="text-muted text-[14px] leading-relaxed">
          Your plan is staged over time for compounding, measurable results.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section id="book" class="bg-charcoal py-[clamp(56px,8vw,88px)] px-6 border-t border-gold-metal/10">
    <div class="max-w-[680px] mx-auto text-center">
      <span class="kicker">Reserve Your Experience</span>
      <h2 class="font-serif text-[clamp(28px,5vw,44px)] text-ink leading-tight mb-4">
        Begin Your Transformation
      </h2>
      <p class="text-muted text-[15px] max-w-[450px] mx-auto mb-10 leading-relaxed">
        Schedule a private consultation and let our team build a protocol around your goals.
      </p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="tel:+18449417673" class="btn-outline-gold">
          (844) 941-7673
        </a>
        <a href="https://houseofrose.glossgenius.com/book" target="_blank" rel="noopener noreferrer" class="btn-gold">
          Book Online
        </a>
      </div>
      <p class="text-muted text-[11px] tracking-[0.26em] uppercase mt-8 leading-relaxed">
        525 E Olympia Ave, Unit 9<br />Punta Gorda, FL 33950
      </p>
    </div>
  </section>
</BaseLayout>
