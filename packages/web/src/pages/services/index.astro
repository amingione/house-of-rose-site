---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import { sanityFetch } from '@/lib/sanity';
import { ALL_SERVICES_QUERY, type Service } from '@/lib/queries';

// Visual Editor: inline click-to-edit is delegated to <ServiceCard>, which emits
// the sbObjectId / sbFieldPath annotations when passed `objectId={service._id}`.

const services = await sanityFetch<Service[]>(ALL_SERVICES_QUERY);
---

<BaseLayout
  title="Advanced Aesthetic Services | House of Rose Punta Gorda, FL"
  description="Browse all services at House of Rose — ProCell microchanneling, PRF, injectables, BioRePeel, IV hydration & GLP-1 programs in Punta Gorda, FL."
  preloadImage="/images/hor-skin-studio.jpg"
>
  <!-- Hero -->
  <Hero
    title="Our Services"
    kicker="What We Offer"
    size="small"
    backgroundImage="/images/hor-skin-studio.jpg"
  />

  <!-- Services List -->
  <section class="bg-charcoal py-[clamp(36px,5vw,72px)]">
    <div class="max-w-[1280px] mx-auto px-6">
      {services.map((service, index) => (
        <ServiceCard
          title={service.title}
          slug={service.slug}
          tagline={service.tagline}
          image={service.image}
          variant="row"
          number={`${String(index + 1).padStart(2, '0')}`}
          objectId={service._id}
        />
      ))}
    </div>
  </section>

  <!-- Also at House of Rose — Professional Makeup (singleton hub, not a service doc) -->
  <section class="bg-charcoal-light py-[clamp(40px,6vw,72px)] px-6 border-t border-gold/10">
    <div class="max-w-[1080px] mx-auto">
      <a
        href="/services/professional-makeup/"
        class="group grid grid-cols-1 md:grid-cols-[1fr_auto] items-center gap-6 bg-breath p-8 transition-colors hover:bg-charcoal"
      >
        <div>
          <span class="kicker">Also at House of Rose</span>
          <h2 class="font-serif text-[clamp(24px,3.4vw,34px)] text-ink mt-2 mb-2">Professional Makeup</h2>
          <p class="text-[#9a8c78] text-[15px] leading-[1.75] max-w-[640px]">
            Event, wedding, prom, and photography makeup applied with skin-first Jane Iredale mineral
            makeup — in-studio or on location. Explore our looks, the Jane Iredale line, and group event bookings.
          </p>
        </div>
        <span class="learn-more whitespace-nowrap">Explore Makeup →</span>
      </a>
    </div>
  </section>

  <!-- Learn before you choose — microchanneling / PRF guide -->
  <section class="bg-charcoal py-[clamp(40px,6vw,72px)] px-6 border-t border-gold/10">
    <div class="max-w-[1080px] mx-auto">
      <a
        href="/guides/microchanneling-prf/"
        class="group grid grid-cols-1 md:grid-cols-[1fr_auto] items-center gap-6 bg-breath p-8 transition-colors hover:bg-charcoal-light"
      >
        <div>
          <span class="kicker">Learn Before You Choose</span>
          <h2 class="font-serif text-[clamp(24px,3.4vw,34px)] text-ink mt-2 mb-2">Microchanneling, Microneedling &amp; Topical PRF</h2>
          <p class="text-[#9a8c78] text-[15px] leading-[1.75] max-w-[640px]">
            An honest, plain-language guide to how these treatments differ, what each may help, realistic
            series, and how to choose — with links to every matching service.
          </p>
        </div>
        <span class="learn-more whitespace-nowrap">Read the Guide →</span>
      </a>
    </div>
  </section>

  <!-- How to Choose Section -->
  <section class="bg-charcoal-light py-[clamp(56px,8vw,88px)] px-6">
    <div class="max-w-[960px] mx-auto text-center mb-16">
      <span class="kicker">Not Sure Where to Start?</span>
      <h2 class="font-serif text-[32px] text-ink mt-2">
        How to Choose
      </h2>
    </div>

    <div class="max-w-[1120px] mx-auto grid grid-cols-1 md:grid-cols-3 gap-12">
      <!-- Step 1 -->
      <div class="text-center">
        <p class="text-gold/30 text-[48px] font-serif mb-4">01</p>
        <p class="text-ink text-[17px] font-medium mb-3 tracking-wide">
          Define Your Goal
        </p>
        <p class="text-[#7a6e5c] text-[14px] leading-relaxed">
          Skin quality, body composition, energy, or wellness. Your goal determines your path.
        </p>
      </div>

      <!-- Step 2 -->
      <div class="text-center">
        <p class="text-gold/30 text-[48px] font-serif mb-4">02</p>
        <p class="text-ink text-[17px] font-medium mb-3 tracking-wide">
          Book a Consultation
        </p>
        <p class="text-[#7a6e5c] text-[14px] leading-relaxed">
          Every client begins with a private consultation. We assess, listen, and design a protocol.
        </p>
      </div>

      <!-- Step 3 -->
      <div class="text-center">
        <p class="text-gold/30 text-[48px] font-serif mb-4">03</p>
        <p class="text-ink text-[17px] font-medium mb-3 tracking-wide">
          Begin Your Protocol
        </p>
        <p class="text-[#7a6e5c] text-[14px] leading-relaxed">
          Your plan is staged over time for compounding, measurable results.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section id="book" class="bg-charcoal py-[clamp(56px,8vw,88px)] px-6 border-t border-gold/10">
    <div class="max-w-[680px] mx-auto text-center">
      <span class="kicker">Reserve Your Experience</span>
      <h2 class="font-serif text-[clamp(28px,5vw,44px)] text-ink leading-tight mb-4">
        Begin Your Transformation
      </h2>
      <p class="text-[#777] text-[15px] max-w-[450px] mx-auto mb-10 leading-relaxed">
        Schedule a private consultation and let our team build a protocol around your goals.
      </p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="tel:+18449417673" class="btn-outline-gold">
          (844) 941-7673
        </a>
        <a href="https://houseofrose.glossgenius.com/services" target="_blank" rel="noopener noreferrer" class="btn-gold">
          Book Online
        </a>
      </div>
      <p class="text-[#8a7c66] text-[10px] tracking-[0.26em] uppercase mt-8 leading-relaxed">
        525 E Olympia Ave, Unit 9<br />Punta Gorda, FL 33950
      </p>
    </div>
  </section>
</BaseLayout>
