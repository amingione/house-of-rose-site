---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import { sanityFetch } from '@/lib/sanity';
import { ALL_COLLECTIONS_QUERY, type ServiceCollection, type Service } from '@/lib/queries';
import { sbObjectField } from '@/lib/visualEditing';
import { alignPublicContent } from '@/lib/publicCopy';

// ─── Grouped services index ───────────────────────────────────────────────────
// Collections come from Sanity (`serviceCollection`); this page rolls them up
// into a concise treatment index. The anchor ids are stable public links while
// the collection slugs mirror the current Sanity collection taxonomy.

interface GroupSection {
  /** Anchor id — must match GROUP_ANCHORS in pages/index.astro */
  id: string;
  kicker: string;
  title: string;
  /** serviceCollection slugs rolled into this umbrella, in display order */
  collectionSlugs: string[];
}

const SERVICE_GROUP_SECTIONS: GroupSection[] = [
  {
    id: 'advanced-skin-treatments',
    kicker: 'Treatment Technology',
    title: 'Skin Renewal & Device Treatments',
    collectionSlugs: ['inmode'],
  },
  {
    id: 'injectables-structural-enhancements',
    kicker: 'Medical Aesthetics',
    title: 'Injectables & Weight Management',
    collectionSlugs: ['injectables-bio-fillers'],
  },
  {
    id: 'skin-health-corrective-care',
    kicker: 'Facial Care',
    title: 'Facials & Skin Health',
    collectionSlugs: ['facials'],
  },
  {
    id: 'wellness-performance-support',
    kicker: 'Wellness',
    title: 'IV Hydration Therapy',
    collectionSlugs: ['iv-hydration-therapy'],
  },
  {
    id: 'beauty-grooming',
    kicker: 'Supporting Care',
    title: 'Facial Waxing',
    collectionSlugs: ['waxing'],
  },
];

const collections = alignPublicContent(await sanityFetch<ServiceCollection[]>(ALL_COLLECTIONS_QUERY));
const bySlug = new Map<string, ServiceCollection>(collections.map((c) => [c.slug, c]));

/** Hub docs are landing pages, not bookable services — keep them out of the menu list. */
const bookable = (services: Service[]): Service[] => services.filter((s) => s.kind !== 'hub');

interface ResolvedSection extends GroupSection {
  collections: { collection: ServiceCollection; services: Service[] }[];
}

const sections: ResolvedSection[] = SERVICE_GROUP_SECTIONS.map((section) => ({
  ...section,
  collections: section.collectionSlugs
    .map((slug) => bySlug.get(slug))
    .filter((c): c is ServiceCollection => Boolean(c))
    .map((collection) => ({ collection, services: bookable(collection.services) }))
    .filter(({ services }) => services.length > 0),
})).filter((section) => section.collections.length > 0);

// Anything not mapped above still renders (future collections never silently vanish).
const mappedSlugs = new Set(SERVICE_GROUP_SECTIONS.flatMap((s) => s.collectionSlugs));
const unmapped = collections
  .filter((c) => !mappedSlugs.has(c.slug))
  .map((collection) => ({ collection, services: bookable(collection.services) }))
  .filter(({ services }) => services.length > 0);

---

<BaseLayout
  title="Medical Aesthetic Services | House of Rose Punta Gorda, FL"
  description="Explore skin, injectable, facial, IV hydration, and wellness services at House of Rose Aesthetics, a medical aesthetics practice in Punta Gorda, Florida."
  preloadImage="/images/optimized/actual-reception-800.webp"
  preloadImageSrcset="/images/optimized/actual-reception-800.webp 800w, /images/optimized/actual-reception-1400.webp 1400w"
  preloadImageSizes="100vw"
>
  <!-- Hero -->
  <Hero
    title="Our Services"
    kicker="Medical Aesthetics. Thoughtfully Practiced."
    description="Learn what each service is designed to address, then book the exact service or matching consultation when you are ready."
    size="small"
    backgroundImage="/images/optimized/actual-reception-1400.webp"
    backgroundSrcset="/images/optimized/actual-reception-800.webp 800w, /images/optimized/actual-reception-1400.webp 1400w"
    backgroundSizes="100vw"
    imageAlt="The reception and waiting area inside House of Rose Aesthetics in Punta Gorda"
  />

  <!-- Compact treatment index -->
  <nav aria-label="Service groups" class="service-group-nav border-b border-gold-metal/10 bg-charcoal px-5 py-5 sm:px-6">
    <div class="mx-auto max-w-[1280px]">
      <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-muted">Browse by service type</p>
      <div class="service-group-nav-track flex gap-2 overflow-x-auto pb-1">
        {sections.map((section) => (
          <a
            href={`#${section.id}`}
            class="min-h-[44px] shrink-0 border border-ivory/15 bg-breath px-4 py-3 text-[12px] font-semibold text-ivory transition-colors hover:border-ivory/35 hover:bg-charcoal-light"
          >
            {section.title}
          </a>
        ))}
      </div>
    </div>
  </nav>

  <!-- Grouped services -->
  {sections.map((section, sectionIndex) => (
    <section
      id={section.id}
      class={`${sectionIndex % 2 === 0 ? 'bg-charcoal' : 'bg-charcoal-light'} scroll-mt-24 py-[clamp(40px,6vw,72px)]`}
    >
      <div class="mx-auto max-w-[1280px] px-5 sm:px-6">
        <div class="mb-6 grid gap-3 border-b border-gold-metal/20 pb-6 sm:mb-8 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end">
          <div class="max-w-[720px]">
            <span class="kicker">{section.kicker}</span>
            <h2 class="mt-2 font-serif text-[clamp(28px,5vw,40px)] leading-tight text-ink">{section.title}</h2>
          </div>
          <p class="text-[12px] font-semibold uppercase tracking-[0.12em] text-muted">
            {section.collections.reduce((count, entry) => count + entry.services.length, 0)}
            {' '}
            {section.collections.reduce((count, entry) => count + entry.services.length, 0) === 1 ? 'service' : 'services'}
          </p>
        </div>

        {section.collections.map(({ collection, services }) => (
          <div class="mb-10 last:mb-0">
            {section.collections.length > 1 && (
              <div class="flex items-baseline gap-4 mb-6 border-b border-gold-metal/15 pb-3">
                <h3 class="font-serif text-[clamp(19px,2.4vw,24px)] text-ink">
                  <a
                    href={`/services/collections/${collection.slug}/`}
                    class="hover:text-gold transition-colors"
                    {...sbObjectField(collection._id, 'title')}
                  >
                    {collection.title}
                  </a>
                </h3>
                <a
                  href={`/services/collections/${collection.slug}/`}
                  class="learn-more text-[11px] whitespace-nowrap ml-auto"
                >
                  View {collection.title} →
                </a>
              </div>
            )}
            {services.map((service) => (
              <ServiceCard
                title={service.title}
                slug={service.slug}
                tagline={service.tagline}
                image={service.image}
                bookingMode={service.bookingMode}
                bookingUrl={service.bookingUrl}
                variant="row"
                objectId={service._id}
              />
            ))}
          </div>
        ))}
      </div>
    </section>
  ))}

  {unmapped.length > 0 && (
    <section id="more" class="bg-charcoal-light py-[clamp(40px,6vw,80px)] scroll-mt-24">
      <div class="mx-auto max-w-[1280px] px-5 sm:px-6">
        <div class="mb-8 max-w-[720px] border-b border-gold-metal/20 pb-6">
          <span class="kicker">More at House of Rose</span>
          <h2 class="font-serif text-[clamp(26px,3.6vw,38px)] text-ink mt-2">Additional Services</h2>
        </div>
        {unmapped.map(({ collection, services }) => (
          <div class="mb-12 last:mb-0">
            <div class="flex items-baseline gap-4 mb-6 border-b border-gold-metal/15 pb-3">
              <h3
                class="font-serif text-[clamp(19px,2.4vw,24px)] text-ink"
                {...sbObjectField(collection._id, 'title')}
              >
                {collection.title}
              </h3>
            </div>
            {services.map((service) => (
              <ServiceCard
                title={service.title}
                slug={service.slug}
                tagline={service.tagline}
                image={service.image}
                bookingMode={service.bookingMode}
                bookingUrl={service.bookingUrl}
                variant="row"
                objectId={service._id}
              />
            ))}
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Learn before you choose — canonical needling hub -->
  <section class="bg-charcoal py-[clamp(40px,6vw,72px)] px-6 border-t border-gold-metal/10">
    <div class="max-w-[1080px] mx-auto">
      <a
        href="/services/microneedling/"
        class="group grid grid-cols-1 md:grid-cols-[1fr_auto] items-center gap-6 bg-breath p-8 transition-colors hover:bg-charcoal-light"
      >
        <div>
          <span class="kicker">Learn Before You Choose</span>
          <h2 class="font-serif text-[clamp(24px,3.4vw,34px)] text-ink mt-2 mb-2">Microneedling</h2>
          <p class="text-muted text-[15px] leading-[1.75] max-w-[640px]">
            An honest, plain-language guide to what microneedling does, the areas it can treat, realistic
            series, and how to choose your protocol — with links to every matching service.
          </p>
        </div>
        <span class="learn-more whitespace-nowrap">Explore the Guide →</span>
      </a>
    </div>
  </section>

  <!-- Contact CTA -->
  <section id="book" class="border-t border-gold-metal/10 bg-charcoal px-5 py-[clamp(56px,8vw,88px)] sm:px-6">
    <div class="max-w-[680px] mx-auto text-center">
      <span class="kicker">Still Deciding?</span>
      <h2 class="font-serif text-[clamp(28px,5vw,44px)] text-ink leading-tight mb-4">
        Talk through your options
      </h2>
      <p class="text-muted text-[15px] max-w-[450px] mx-auto mb-10 leading-relaxed">
        Tell us what you want to improve, and we will help you choose a sensible next step.
      </p>
      <div class="grid gap-3 sm:flex sm:flex-wrap sm:justify-center">
        <a href="tel:+18449417673" class="btn-outline-gold">
          Call (844) 941-7673
        </a>
        <a href="/consultation/" class="btn-gold">Request a Consultation</a>
      </div>
      <p class="text-muted text-[11px] tracking-[0.26em] uppercase mt-8 leading-relaxed">
        525 E Olympia Ave, Unit 9<br />Punta Gorda, FL 33950
      </p>
    </div>
  </section>
</BaseLayout>
