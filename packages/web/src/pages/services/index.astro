---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import {
  getServiceCardImage,
  getServiceCardImageAlt,
  serviceCardImageUsesContain,
} from '@/lib/imageFallbacks';
import {
  PUBLIC_DIRECTORY_SERVICES,
  getPublicCollections,
  type ServiceCollection,
} from '@/lib/serviceCatalog';
import { breadcrumbList, itemListPage } from '@/lib/structuredData';

// ─── Grouped services index ───────────────────────────────────────────────────
// Local collections roll the canonical service catalog into a concise treatment
// index. The anchor ids are stable public links.

interface GroupSection {
  /** Anchor id — must match GROUP_ANCHORS in pages/index.astro */
  id: string;
  title: string;
  description: string;
  /** Local collection slugs rolled into this umbrella, in display order */
  collectionSlugs: string[];
  contextualLink?: {
    context: string;
    href: string;
    label: string;
  };
}

const SERVICE_GROUP_SECTIONS: GroupSection[] = [
  {
    id: 'advanced-skin-treatments',
    title: 'Skin & Device Treatments',
    description: 'Morpheus8, Lumecca, and Forma use different technologies. Compare microneedling with radiofrequency, intense pulsed light, and radiofrequency treatment without needling.',
    collectionSlugs: ['inmode'],
  },
  {
    id: 'injectables-structural-enhancements',
    title: 'Injectables',
    description: 'Neurotoxins address movement-related lines. Hyaluronic-acid fillers address selected areas of lost volume. Injectable PRF uses material prepared from a small sample of your own blood.',
    collectionSlugs: ['injectables-bio-fillers'],
    contextualLink: {
      context: 'Botox and Daxxify are different formulations, and their units are not interchangeable.',
      href: '/compare/daxxify-vs-botox/',
      label: 'Compare Daxxify and Botox',
    },
  },
  {
    id: 'skin-health-corrective-care',
    title: 'Facials & Skin Care',
    description: 'Surface exfoliation, chemical peels, dermaplaning, microneedling, topical PRF, and structured acne care work at different depths and address different visible concerns.',
    collectionSlugs: ['facials'],
  },
  {
    id: 'wellness-performance-support',
    title: 'IV Hydration & Weight Management',
    description: 'IV hydration delivers fluid intravenously. GLP-1 weight management uses semaglutide or tirzepatide under medical direction. These are distinct services with different purposes.',
    collectionSlugs: ['iv-hydration-therapy'],
  },
  {
    id: 'beauty-grooming',
    title: 'Waxing',
    description: 'Facial waxing covers brows, upper lip, and chin. Body waxing includes underarms, bikini line, arms, legs, back, and chest.',
    collectionSlugs: ['waxing'],
  },
];

const collections = getPublicCollections();
const allServices = [...PUBLIC_DIRECTORY_SERVICES];
const bySlug = new Map<string, ServiceCollection>(collections.map((c) => [c.slug, c]));

interface CollectionDestination {
  collection: ServiceCollection;
  /** A collection with exactly one public service links straight to that page — no pointless extra click through an identical-looking collection page. */
  href: string;
  /**
   * Curated image for the umbrella card. Resolved from the collection slug, then
   * from the single service the card links to when the collection itself has no
   * curated asset. Undefined renders a text-only card rather than a generic room.
   */
  image?: string;
  imageAlt: string;
  imageContain: boolean;
}

interface ResolvedSection extends GroupSection {
  destinations: CollectionDestination[];
}

const sections: ResolvedSection[] = SERVICE_GROUP_SECTIONS.map((section) => ({
  ...section,
  destinations: section.collectionSlugs
    .map((slug) => bySlug.get(slug))
    .filter((c): c is ServiceCollection => Boolean(c))
    .filter((collection) => collection.services.length > 0)
    .map((collection) => {
      // The card can be keyed to the collection (e.g. `inmode`) or, when the
      // umbrella wraps a single service, to that service's own curated asset.
      const imageKey = getServiceCardImage(collection.slug)
        ? collection.slug
        : collection.services.length === 1
        ? collection.services[0].slug
        : collection.slug;
      return {
        collection,
        href: collection.slug === 'inmode'
          ? '/services/inmode/'
          : collection.services.length === 1
          ? `/services/${collection.services[0].slug}/`
          : `/services/collections/${collection.slug}/`,
        image: getServiceCardImage(imageKey),
        imageAlt: getServiceCardImageAlt(imageKey),
        imageContain: serviceCardImageUsesContain(imageKey),
      };
    }),
})).filter((section) => section.destinations.length > 0);

// Anything not mapped above still renders (future collections never silently vanish).
const mappedSlugs = new Set(SERVICE_GROUP_SECTIONS.flatMap((s) => s.collectionSlugs));
const collectionUnmappedServices = collections
  .filter((c) => !mappedSlugs.has(c.slug))
  .flatMap((collection) => collection.services);
// Non-medical services whose collections are not yet reviewed for a public
// collection page (see REVIEWED_PUBLIC_COLLECTION_SLUGS). Keep their treatment
// pages reachable from the public directory.
const FEATURED_SERVICE_SLUGS = new Set([
  'bridal-makeup',
  'event-makeup',
  'everyday-makeup',
]);
const featuredServices = allServices.filter((service) => FEATURED_SERVICE_SLUGS.has(service.slug));
const unmappedServices = Array.from(
  new Map([...collectionUnmappedServices, ...featuredServices].map((service) => [service.slug, service])).values(),
);

const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonical = new URL(Astro.url.pathname, site).toString();
const pageTitle = 'Medical Aesthetic Services | House of Rose Punta Gorda, FL';
const pageDescription = 'Skin, injectable, facial, IV hydration, weight-management, waxing, and makeup services at House of Rose Aesthetics in Punta Gorda.';
const directorySchema = itemListPage(
  {
    name: 'House of Rose Services',
    description: pageDescription,
    url: canonical,
    items: allServices.map((service) => ({
      name: service.title,
      url: new URL(`/services/${service.slug}/`, site).toString(),
    })),
  },
  site,
);
const breadcrumb = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'Services', item: canonical },
]);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredPageType="CollectionPage"
  structuredPageMainEntityId={`${canonical}#itemlist`}
>
  <SchemaMarkup item={directorySchema} slot="head" />
  <SchemaMarkup item={breadcrumb} slot="head" />

  <section class="bg-bone px-5 pb-[clamp(64px,8vw,104px)] pt-[clamp(112px,14vw,176px)] sm:px-8">
    <div class="mx-auto max-w-[1280px]">
      <p class="kicker">Punta Gorda, Florida</p>
      <h1 class="mt-4 max-w-[980px] font-display text-display leading-display text-ink">
        Services at House of Rose.
      </h1>
      <p class="mt-8 max-w-[650px] text-lede leading-body text-muted">
        Browse skin treatments, injectables, facials, IV hydration, weight management, waxing, and makeup.
      </p>
    </div>
  </section>

  <!-- Compact treatment index -->
  <nav aria-label="Service groups" class="service-group-nav border-y border-line bg-paper px-5 py-5 sm:px-8">
    <div class="mx-auto max-w-[1280px]">
      <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-muted">Services by category</p>
      <div class="service-group-nav-track flex gap-2 overflow-x-auto pb-2" tabindex="0" aria-label="Scroll to see all service categories">
        {sections.map((section) => (
          <a
            href={`#${section.id}`}
            class="min-h-[44px] shrink-0 border border-line bg-bone px-4 py-3 text-[11px] font-medium uppercase tracking-wide text-ink transition-colors hover:bg-breath"
          >
            {section.title}
          </a>
        ))}
      </div>
      <p class="service-group-nav-hint mt-2 text-[11px] text-muted sm:hidden" aria-hidden="true">Swipe to see every category <span>→</span></p>
    </div>
  </nav>

  <section data-service-index-guidance class="border-b border-line bg-paper px-5 py-[clamp(56px,8vw,88px)] sm:px-8">
    <div class="mx-auto grid max-w-[1280px] gap-8 lg:grid-cols-[minmax(0,1.2fr)_minmax(280px,0.8fr)] lg:items-end lg:gap-16">
      <div class="max-w-[760px]">
        <p class="kicker mb-4">Movement, volume, color, texture</p>
        <h2 class="font-display text-display-sm leading-display text-ink">
          Different concerns call for different treatments.
        </h2>
        <p class="mt-5 max-w-[700px] text-[15px] leading-7 text-muted">
          A line that appears with expression is a different concern than a cheek that looks less full or a patch of uneven color. Each category below explains which treatments address a given concern.
        </p>
      </div>
      <div class="border-l border-line-strong pl-6">
        <p class="text-[14px] leading-7 text-muted">
          Prefer to choose by provider? Every provider's license type and the services they perform are listed on the team page.
        </p>
        <a href="/about/providers/" class="learn-more mt-4 inline-flex">
          Meet the House of Rose team →
        </a>
      </div>
    </div>
  </section>

  <!-- Grouped services -->
  {sections.map((section, sectionIndex) => (
    <section
      id={section.id}
      class="scroll-mt-20 border-b border-line bg-bone"
    >
      {section.destinations.map(({ href, image, imageAlt, imageContain }, destinationIndex) => {
        const reverse = (sectionIndex + destinationIndex) % 2 === 1;
        return (
          <div class="group mx-auto grid max-w-[1280px] sm:grid-cols-12">
            <div class:list={[
              'relative min-h-80 overflow-hidden bg-limestone sm:col-span-5 sm:min-h-[460px]',
              reverse ? 'sm:order-2' : '',
            ]}>
              {image && (
                <img
                  src={image}
                  alt={imageAlt}
                  width="1400"
                  height="900"
                  loading="lazy"
                  decoding="async"
                  class:list={[
                    'absolute inset-0 h-full w-full transition-transform duration-slow ease-out-soft group-hover:scale-[1.03]',
                    imageContain ? 'object-contain p-8' : 'object-cover',
                  ]}
                />
              )}
            </div>
            <div class:list={[
              'flex flex-col justify-center px-5 py-12 sm:col-span-7 sm:px-12 lg:px-16',
              reverse ? 'sm:order-1' : '',
            ]}>
              <p class="kicker">Services</p>
              <h2 class="mt-3 max-w-[660px] font-display text-[clamp(38px,5.4vw,64px)] leading-display text-ink">{section.title}</h2>
              <p class="mt-6 max-w-[620px] text-body leading-body text-muted">{section.description}</p>
              {section.contextualLink && (
                <p class="mt-5 max-w-[620px] text-[14px] leading-6 text-muted">
                  {section.contextualLink.context}{' '}
                  <a href={section.contextualLink.href} class="text-ink underline decoration-line-strong underline-offset-4 hover:text-gold">{section.contextualLink.label}</a>
                </p>
              )}
              <a href={href} class="mt-8 inline-flex min-h-11 w-fit items-center text-kicker font-medium uppercase tracking-label text-ink">
                Explore {section.title}
                <span class="ml-3 transition-transform duration-fast group-hover:translate-x-1" aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        );
      })}
    </section>
  ))}

  {unmappedServices.length > 0 && (
    <section id="more" class="scroll-mt-20 border-b border-line bg-paper py-[clamp(48px,7vw,72px)]">
      <div class="mx-auto max-w-[1280px] px-5 sm:px-6">
        <div class="mb-6 max-w-[720px] border-b border-gold-metal/20 pb-6 sm:mb-8">
          <h2 class="font-display text-display-sm leading-display text-ink">Additional Services</h2>
        </div>
        {unmappedServices.map((service) => (
          <ServiceCard
            title={service.title}
            slug={service.slug}
            variant="row"
          />
        ))}
      </div>
    </section>
  )}

  <!-- One clear next step after the client has explored the treatment information. -->
  <section id="contact" class="border-t border-line bg-bone px-5 py-[clamp(72px,9vw,104px)] sm:px-8">
    <div class="max-w-[680px] mx-auto text-center">
      <span class="kicker">Ready to talk it through?</span>
      <h2 class="mb-4 font-display text-display-sm leading-display text-ink">
        Start with a consultation.
      </h2>
      <p class="text-muted text-[15px] max-w-[450px] mx-auto mb-10 leading-relaxed">
        Whether you have a specific treatment in mind or want guidance on the right approach for a concern — movement, volume, pigment, texture, breakouts, or unwanted hair — your consultation lets us evaluate your goals and recommend a plan.
      </p>
      <div class="grid gap-3 sm:flex sm:flex-wrap sm:justify-center">
        <a href="/contact/" class="btn-gold">
          Contact House of Rose
        </a>
        <a href="/about/providers/" class="btn-outline-ink">
          Meet the team
        </a>
      </div>
      <p class="text-muted text-[11px] tracking-[0.26em] uppercase mt-8 leading-relaxed">
        525 E Olympia Ave, Unit 9<br />Punta Gorda, FL 33950
      </p>
    </div>
  </section>
</BaseLayout>
