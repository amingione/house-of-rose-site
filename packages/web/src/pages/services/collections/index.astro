---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import { sanityFetch, urlFor } from '@/lib/sanity';
import { sbObjectId, sbFieldPath } from '@/lib/visualEditing';
import { breadcrumbList, itemList } from '@/lib/structuredData';
import { ALL_COLLECTIONS_QUERY, type ServiceCollection } from '@/lib/queries';
import { getCollectionFallbackImage } from '@/lib/imageFallbacks';
import ServiceCard from '@/components/ServiceCard.astro';
import { alignPublicContent } from '@/lib/publicCopy';

const collections = alignPublicContent(await sanityFetch<ServiceCollection[]>(ALL_COLLECTIONS_QUERY));

const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonical = new URL(Astro.url.pathname, site).toString();
const breadcrumb = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'Services', item: `${site}services/` },
  { name: 'Collections', item: canonical },
]);
const collectionsListSchema = collections.length
  ? itemList(
      collections.map((col) => ({
        name: col.title,
        url: new URL(`/services/collections/${col.slug}/`, site).toString(),
      })),
      'Service Collections',
    )
  : null;
---

<BaseLayout
  title="Service Collections | House of Rose Aesthetics, Punta Gorda FL"
  description="Browse House of Rose services by category, including skin renewal, injectables, wellness, facial waxing, and corrective facial care in Punta Gorda."
>
  <SchemaMarkup item={breadcrumb} slot="head" />
  {collectionsListSchema && <SchemaMarkup item={collectionsListSchema} slot="head" />}
  <section class="py-24 max-w-6xl mx-auto px-6">
    <div class="text-center mb-16">
      <p class="kicker mb-4">Browse by Category</p>
      <h1 class="font-serif text-5xl text-ink">Find the Right Place to Start</h1>
    </div>

    {collections.length === 0 ? (
      <p class="text-center text-muted">Collections coming soon.</p>
    ) : (
      <div class="space-y-24">
        {collections.map((col) => (
          <div {...sbObjectId(col._id)}>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center mb-12">
              <div class="aspect-[4/3] overflow-hidden bg-charcoal-lighter">
                  <img
                    src={col.image ? urlFor(col.image).width(800).height(600).fit('crop').url() : getCollectionFallbackImage(col.slug)}
                    alt={col.image?.alt ?? col.title}
                    width={800}
                    height={600}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover"
                  />
                </div>
              <div>
                <h2 class="font-serif text-4xl text-ink mb-4" {...sbFieldPath('title')}>{col.title}</h2>
                {col.description && (
                  <p class="text-muted leading-relaxed mb-6" {...sbFieldPath('description')}>{col.description}</p>
                )}
                <a href={`/services/collections/${col.slug}/`} class="btn-outline-gold">
                  View collection
                </a>
              </div>
            </div>
            {col.services.length > 0 && (
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {col.services.map((svc) => (
                  <ServiceCard
                    title={svc.title}
                    slug={svc.slug}
                    tagline={svc.tagline}
                    image={svc.image}
                    bookingMode={svc.bookingMode}
                    bookingUrl={svc.bookingUrl}
                    objectId={svc._id}
                  />
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
