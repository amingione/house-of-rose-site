---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import { breadcrumbList, itemList } from '@/lib/structuredData';
import { getPublicCollections } from '@/lib/serviceCatalog';
import { getServiceCardSummary } from '@/lib/serviceCardContent';

const collectionIntroductions: Readonly<Record<string, string>> = {
  inmode: 'Microneedling with radiofrequency, intense pulsed light, and radiofrequency without needling.',
  'injectables-bio-fillers': 'Neurotoxins for movement-related lines, fillers for selected lip, cheek, and fold volume, and injectable PRF.',
  'iv-hydration-therapy': 'IV hydration and medical weight-management treatments.',
  facials: 'Facials, exfoliation, microneedling, topical PRF, and structured acne care.',
  waxing: 'Facial and body waxing organized by treatment area.',
};

const collections = getPublicCollections();
const collectionHref = (slug: string): string =>
  slug === 'inmode' ? '/services/inmode/' : `/services/collections/${slug}/`;
const visibleCollectionServices = (collection: (typeof collections)[number]) =>
  collection.slug === 'inmode'
    ? collection.services.filter(({ slug }) => ['morpheus8', 'lumecca-peak-ipl', 'forma-rf-facial'].includes(slug))
    : collection.services;

const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonical = new URL(Astro.url.pathname, site).toString();
const breadcrumb = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'Services', item: `${site}services/` },
  { name: 'Categories', item: canonical },
]);
const collectionsListSchema = collections.length
  ? itemList(
      collections.map((collection) => ({
        name: collection.title,
        url: new URL(collectionHref(collection.slug), site).toString(),
      })),
      'Service Categories',
    )
  : null;
---

<BaseLayout
  title="Service Categories | House of Rose Aesthetics"
  description="House of Rose services grouped into facials and skin care, injectables, InMode treatments, IV hydration and weight management, and waxing."
  noindex
>
  <SchemaMarkup item={breadcrumb} slot="head" />
  {collectionsListSchema && <SchemaMarkup item={collectionsListSchema} slot="head" />}

  <section class="mx-auto max-w-6xl px-6 py-24">
    <header class="max-w-2xl">
      <p class="kicker mb-4">Services</p>
      <h1 class="font-serif text-5xl text-ink">Explore treatments by what they address.</h1>
      <p class="mt-5 leading-relaxed text-muted">
        Five groups make it easier to compare treatments that work differently. Open a treatment to understand its purpose, the concerns it may address, and what separates it from nearby options.
      </p>
    </header>

    {collections.length === 0 ? (
      <p class="mt-16 border-t border-walnut/15 pt-8 text-muted">No service categories are currently listed.</p>
    ) : (
      <ul class="mt-16 grid gap-px bg-walnut/15 md:grid-cols-2" aria-label="Service categories">
        {collections.map((collection) => (
          <li class="bg-bone p-8 sm:p-10">
            <h2 class="font-serif text-3xl text-ink">
              <a
                href={collectionHref(collection.slug)}
                class="transition-colors hover:text-olive"
              >
                {collection.title}
              </a>
            </h2>
            <p class="mt-4 text-[14px] leading-relaxed text-muted">
              {collectionIntroductions[collection.slug] ?? `Related ${collection.title} treatments at House of Rose.`}
            </p>

            {visibleCollectionServices(collection).length > 0 && (
              <ul class="mt-7 divide-y divide-walnut/10 border-t border-walnut/15" aria-label={`${collection.title} services`}>
                {visibleCollectionServices(collection).map((service) => {
                  const summary = getServiceCardSummary(service.slug);
                  return (
                    <li>
                      <a
                        href={`/services/${service.slug}/`}
                        class="group block py-4"
                      >
                        <span class="inline-flex items-baseline gap-2 text-[14px] font-medium leading-relaxed text-muted-strong transition-colors group-hover:text-olive">
                          <span>{service.title}</span>
                          <span aria-hidden="true">→</span>
                        </span>
                        {summary && <span class="mt-1 block text-[13px] leading-relaxed text-muted">{summary}</span>}
                      </a>
                    </li>
                  );
                })}
              </ul>
            )}
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
