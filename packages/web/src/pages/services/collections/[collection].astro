---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import { sanityFetch } from '@/lib/sanity';
import { sbObjectId, sbFieldPath } from '@/lib/visualEditing';
import { breadcrumbList, itemList } from '@/lib/structuredData';
import {
  ALL_COLLECTION_SLUGS_QUERY,
  COLLECTION_BY_SLUG_QUERY,
  type ServiceCollection,
} from '@/lib/queries';

export async function getStaticPaths() {
  const slugs = await sanityFetch<{ slug: string }[]>(ALL_COLLECTION_SLUGS_QUERY);
  return slugs.map(({ slug }) => ({ params: { collection: slug } }));
}

const { collection: slug } = Astro.params;
const collection = await sanityFetch<ServiceCollection>(COLLECTION_BY_SLUG_QUERY, { slug });

// Never `return Astro.redirect()` from a prerendered route — it breaks the static build.
// Slugs come from getStaticPaths, so a miss is a data bug: fail loudly.
if (!collection) {
  throw new Error(`[collections/[collection]] No collection found in Sanity for slug "${slug}"`);
}

const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonical = new URL(Astro.url.pathname, site).toString();
const breadcrumb = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'Services', item: `${site}services/` },
  { name: 'Categories', item: `${site}services/collections/` },
  { name: collection.title, item: canonical },
]);
const serviceListSchema = collection.services.length
  ? itemList(
      collection.services.map((service) => ({
        name: service.title,
        url: new URL(`/services/${service.slug}/`, site).toString(),
      })),
      `${collection.title} Services`,
    )
  : null;
const pageTitle = `${collection.title} Services | House of Rose Aesthetics`;
const pageDescription = `Directory of ${collection.title} services with links to individual service pages.`;
// Waxing has two supported standalone service pages. Keep this collection as a
// navigation directory without allowing it to compete with a future canonical
// service hub at /services/waxing/.
const noindex = slug === 'waxing';
---

<BaseLayout title={pageTitle} description={pageDescription} noindex={noindex}>
  <SchemaMarkup item={breadcrumb} slot="head" />
  {serviceListSchema && <SchemaMarkup item={serviceListSchema} slot="head" />}

  <section class="mx-auto max-w-4xl px-6 py-24" {...sbObjectId(collection._id)}>
    <a
      href="/services/collections/"
      class="text-xs uppercase tracking-widest text-gold hover:underline"
    >
      ← All categories
    </a>

    <header class="mt-12 max-w-2xl">
      <p class="kicker mb-4">Service category</p>
      <h1 class="font-serif text-5xl text-ink" {...sbFieldPath('title')}>{collection.title}</h1>
    </header>

    {collection.services.length === 0 ? (
      <div class="mt-14 border-t border-walnut/15 pt-8">
        <p class="text-muted">No individual service pages are currently linked to this category.</p>
        <a href="/services/" class="learn-more mt-5 inline-flex">View all services</a>
      </div>
    ) : (
      <ul class="mt-14 divide-y divide-walnut/15 border-y border-walnut/15" aria-label={`${collection.title} services`}>
        {collection.services.map((service) => (
          <li {...sbObjectId(service._id)}>
            <a
              href={`/services/${service.slug}/`}
              class="group flex items-center justify-between gap-8 py-6"
            >
              <span
                class="font-serif text-[clamp(22px,3vw,30px)] leading-tight text-ink transition-colors group-hover:text-olive"
                {...sbFieldPath('title')}
              >
                {service.title}
              </span>
              <span class="shrink-0 text-gold" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
