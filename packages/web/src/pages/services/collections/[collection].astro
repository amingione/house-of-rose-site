---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import { breadcrumbList, itemList } from '@/lib/structuredData';
import { getPublicCollectionBySlug, getPublicCollections } from '@/lib/serviceCatalog';
import { getServiceCardSummary } from '@/lib/serviceCardContent';

const collectionIntroductions: Readonly<Record<string, string>> = {
  inmode:
    'Morpheus8 delivers radiofrequency through microneedles, Lumecca Peak uses intense pulsed light, and Forma delivers radiofrequency through surface electrodes. The difference is the technology and the visible concern being addressed.',
  'injectables-bio-fillers':
    'Lines that appear with facial movement point toward neurotoxins. Lost volume in selected lips, cheeks, and folds points toward dermal filler. Injectable PRF uses material prepared from a small sample of your own blood.',
  'iv-hydration-therapy':
    'IV hydration delivers fluid intravenously. GLP-1 weight management uses semaglutide or tirzepatide under medical direction. They are different medical services with different purposes.',
  facials:
    'This group includes surface exfoliation, dermaplaning, Glo2Facial, Procell Microneedling, topical PRF, BioRePeel, and the 12-week Face Reality Acne Program.',
  waxing:
    'Facial and body waxing covers brows, upper lip, chin, underarms, bikini line, arms, legs, back, and chest.',
};

export async function getStaticPaths() {
  return getPublicCollections().map(({ slug }) => ({ params: { collection: slug } }));
}

const { collection: slug } = Astro.params;
const collection = slug ? getPublicCollectionBySlug(slug) : undefined;

// Never `return Astro.redirect()` from a prerendered route — it breaks the static build.
// Slugs come from getStaticPaths, so a miss is a data bug: fail loudly.
if (!collection) {
  throw new Error(`[collections/[collection]] No local collection found for slug "${slug}"`);
}

// The InMode umbrella page is the public entry point. Keep this legacy noindex
// category route limited to the three face-focused treatments in the new system.
const collectionServices = collection.slug === 'inmode'
  ? collection.services.filter(({ slug }) => ['morpheus8', 'lumecca-peak-ipl', 'forma-rf-facial'].includes(slug))
  : collection.services;

const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonical = new URL(Astro.url.pathname, site).toString();
const breadcrumb = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'Services', item: `${site}services/` },
  { name: 'Categories', item: `${site}services/collections/` },
  { name: collection.title, item: canonical },
]);
const serviceListSchema = collectionServices.length
  ? itemList(
      collectionServices.map((service) => ({
        name: service.title,
        url: new URL(`/services/${service.slug}/`, site).toString(),
      })),
      `${collection.title} Services`,
    )
  : null;
const pageTitle = `${collection.title} Services | House of Rose Aesthetics`;
const pageDescription = `${collection.title} treatments at House of Rose, with clear differences between the available approaches.`;
const collectionIntroduction = collectionIntroductions[collection.slug]
  ?? `Explore related ${collection.title} treatments at House of Rose.`;
const facialPathways = collection.slug === 'facials'
  ? [
      {
        heading: 'Surface treatments',
        body: 'Dermaplaning uses a specialized blade for fine vellus hair and surface buildup. Glo2Facial combines surface exfoliation, topical infusion, and oxygenation. BioRePeel is a topical TCA-based peel.',
        links: [
          { href: '/services/dermaplaning/', label: 'Dermaplaning' },
          { href: '/services/glo2facial/', label: 'Glo2Facial' },
          { href: '/services/biorepeel/', label: 'BioRePeel' },
        ],
      },
      {
        heading: 'Microneedling and topical PRF',
        body: 'House of Rose Microneedling uses the Procell Therapies device to create controlled microchannels. When PRF is paired with Microneedling, it is applied at the skin surface; injectable PRF follows a different route.',
        links: [
          { href: '/services/microneedling/', label: 'Microneedling' },
          { href: '/services/prf/', label: 'PRF overview' },
        ],
      },
      {
        heading: 'A 12-week acne program',
        body: 'Face Reality combines in-studio care every two weeks with daily home care across a complete 12-week program.',
        links: [
          { href: '/services/face-reality-acne-program/', label: 'Face Reality Acne Program' },
        ],
      },
    ]
  : [];
---

<BaseLayout title={pageTitle} description={pageDescription} noindex>
  <SchemaMarkup item={breadcrumb} slot="head" />
  {serviceListSchema && <SchemaMarkup item={serviceListSchema} slot="head" />}

  <section class="mx-auto max-w-4xl px-6 py-24">
    <a
      href="/services/collections/"
      class="text-xs uppercase tracking-widest text-gold hover:underline"
    >
      ← All categories
    </a>

    <header class="mt-12 max-w-2xl">
      <p class="kicker mb-4">Service category</p>
      <h1 class="font-serif text-5xl text-ink">{collection.title}</h1>
      <p class="mt-6 text-[16px] leading-[1.8] text-muted">{collectionIntroduction}</p>
      {collection.slug === 'inmode' && (
        <a href="/services/inmode/" class="btn-gold mt-8 inline-flex">Compare the three InMode treatments</a>
      )}
    </header>

    {facialPathways.length > 0 && (
      <aside class="mt-12 border-y border-walnut/15 py-10" aria-labelledby="facials-pathway-heading">
        <div class="max-w-2xl">
          <p class="kicker mb-3">Finding your starting point</p>
          <h2 id="facials-pathway-heading" class="font-serif text-[clamp(28px,4vw,38px)] text-ink">
            Surface services, Microneedling, and a 12-week program.
          </h2>
          <p class="mt-4 text-[15px] leading-7 text-muted">
            These approaches are not interchangeable. Surface treatments work at the outer surface, Procell Microneedling creates controlled microchannels, and Face Reality combines in-studio care with daily home care across a complete program.
          </p>
        </div>

        <div class="mt-8 grid gap-px bg-walnut/15 md:grid-cols-3">
          {facialPathways.map((pathway) => (
            <article class="bg-bone p-7 sm:p-8">
              <h3 class="font-serif text-[24px] leading-tight text-ink">{pathway.heading}</h3>
              <p class="mt-4 text-[14px] leading-7 text-muted">{pathway.body}</p>
              <div class="mt-6 flex flex-wrap gap-x-5 gap-y-3">
                {pathway.links.map((link) => (
                  <a href={link.href} class="learn-more text-[12px] hover:text-olive">{link.label}</a>
                ))}
              </div>
            </article>
          ))}
        </div>
      </aside>
    )}

    {collectionServices.length === 0 ? (
      <div class="mt-14 border-t border-walnut/15 pt-8">
        <p class="text-muted">Contact House of Rose to discuss treatments in this category.</p>
        <a href="/contact/" class="learn-more mt-5 inline-flex">Ask House of Rose</a>
      </div>
    ) : (
      <ul class="mt-14 divide-y divide-walnut/15 border-y border-walnut/15" aria-label={`${collection.title} services`}>
        {collectionServices.map((service) => {
          const summary = getServiceCardSummary(service.slug);
          return (
            <li>
              <a
                href={`/services/${service.slug}/`}
                class="group grid gap-3 py-7 sm:grid-cols-[1fr_auto] sm:items-center sm:gap-8"
              >
                <span>
                  <span
                    class="block font-serif text-[clamp(22px,3vw,30px)] leading-tight text-ink transition-colors group-hover:text-olive"
                  >
                    {service.title}
                  </span>
                  {summary && <span class="mt-2 block text-[14px] leading-relaxed text-muted">{summary}</span>}
                </span>
                <span class="shrink-0 text-gold" aria-hidden="true">→</span>
              </a>
            </li>
          );
        })}
      </ul>
    )}
  </section>
</BaseLayout>
