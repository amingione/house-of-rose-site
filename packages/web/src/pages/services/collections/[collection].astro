---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sanityFetch, urlFor } from '@/lib/sanity';
import { sbObjectId, sbFieldPath } from '@/lib/visualEditing';
import {
  ALL_COLLECTION_SLUGS_QUERY,
  COLLECTION_BY_SLUG_QUERY,
  type ServiceCollection,
} from '@/lib/queries';

export async function getStaticPaths() {
  const slugs = await sanityFetch<{ slug: string }[]>(ALL_COLLECTION_SLUGS_QUERY);
  return slugs.map(({ slug }) => ({ params: { collection: slug } }));
}

const { collection: slug } = Astro.params;
const collection = await sanityFetch<ServiceCollection>(COLLECTION_BY_SLUG_QUERY, { slug });

if (!collection) {
  return Astro.redirect('/services/collections', 307);
}
---

<BaseLayout
  title={collection.title}
  description={collection.description ?? ''}
  image={collection.image ? urlFor(collection.image).width(1200).height(630).fit('crop').url() : undefined}
>
  <section class="py-24 max-w-6xl mx-auto px-6" {...sbObjectId(collection._id)}>
    <div class="mb-4">
      <a href="/services/collections" class="text-xs tracking-widest uppercase text-rose-700 hover:underline">
        ← All Collections
      </a>
    </div>

    {collection.image && (
      <div class="aspect-[21/9] overflow-hidden bg-cream-200 mb-12">
        <img
          src={urlFor(collection.image).width(1600).height(685).fit('crop').url()}
          alt={collection.image.alt ?? collection.title}
          width={1600}
          height={685}
          class="w-full h-full object-cover"
        />
      </div>
    )}

    <div class="max-w-2xl mb-16">
      <h1 class="font-serif text-5xl text-charcoal mb-4" {...sbFieldPath('title')}>{collection.title}</h1>
      {collection.description && (
        <p class="text-xl text-charcoal/70 leading-relaxed" {...sbFieldPath('description')}>{collection.description}</p>
      )}
    </div>

    {collection.services.length === 0 ? (
      <p class="text-charcoal/50">Services coming soon.</p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {collection.services.map((svc) => (
          <a href={`/services/${svc.slug}`} class="group bg-cream-100 overflow-hidden hover:shadow-md transition-shadow duration-300" {...sbObjectId(svc._id)}>
            {svc.image && (
              <div class="aspect-[3/2] overflow-hidden bg-cream-200">
                <img
                  src={urlFor(svc.image).width(600).height(400).fit('crop').url()}
                  alt={svc.image.alt ?? svc.title}
                  width={600}
                  height={400}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </div>
            )}
            <div class="p-6">
              <p class="font-serif text-xl text-charcoal mb-2 group-hover:text-rose-700 transition-colors" {...sbFieldPath('title')}>{svc.title}</p>
              {svc.tagline && <p class="text-sm text-charcoal/60 leading-relaxed mb-4" {...sbFieldPath('tagline')}>{svc.tagline}</p>}
              <div class="flex items-center justify-between">
                {svc.duration && <span class="text-xs text-charcoal/50" {...sbFieldPath('duration')}>{svc.duration}</span>}
                {svc.price && <span class="text-sm font-medium text-rose-700" {...sbFieldPath('price')}>{svc.price}</span>}
              </div>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
