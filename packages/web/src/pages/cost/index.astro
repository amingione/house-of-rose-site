---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import { sanityFetch } from '@/lib/sanity';
import { sbObjectId, sbFieldPath } from '@/lib/visualEditing';
import { ALL_COST_GUIDES_QUERY, type CostGuide } from '@/lib/queries';
import { breadcrumbList, itemList } from '@/lib/structuredData';
import { getVerifiedCostFact } from '@/lib/costFacts';

const guides = await sanityFetch<CostGuide[]>(ALL_COST_GUIDES_QUERY);
const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonical = new URL(Astro.url.pathname, site).toString();

const breadcrumb = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'Pricing', item: canonical },
]);
const guidesListSchema = guides.length
  ? itemList(
      guides.map((g) => ({ name: g.title, url: new URL(`/cost/${g.slug}/`, site).toString() })),
      'Treatment Cost Guides',
    )
  : null;

---

<BaseLayout
  title="Treatment Cost Guides | House of Rose Aesthetics, Punta Gorda FL"
  description="Published treatment cost ranges and related House of Rose services in Punta Gorda, Florida."
>
  <SchemaMarkup item={breadcrumb} slot="head" />
  {guidesListSchema && <SchemaMarkup item={guidesListSchema} slot="head" />}

  <section class="bg-charcoal pt-32 pb-12 px-6">
    <div class="max-w-[1280px] mx-auto">
      <span class="kicker">Pricing</span>
      <h1 class="font-serif text-[clamp(30px,5vw,52px)] text-ink leading-tight mt-3 mb-5">What does it cost?</h1>
      <p class="text-ink/80 text-[16px] max-w-[680px] leading-relaxed">
        Current House of Rose prices, with the product, treatment-area, or series distinctions that explain the range. When the current menu does not publish a standalone price, the guide says so plainly.
      </p>
    </div>
  </section>

  <section class="bg-charcoal-light py-14 px-6">
    <div class="max-w-[1280px] mx-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-px bg-gold-metal/10">
      {guides.map((g) => {
        const fact = getVerifiedCostFact(g.slug);
        return (
          <article class="bg-charcoal transition-colors hover:bg-charcoal-lighter" {...sbObjectId(g._id)}>
            <a href={`/cost/${g.slug}/`} class="group block p-7 pb-5">
              <h2 class="font-serif text-[22px] text-ink mb-2 group-hover:text-gold transition-colors" {...sbFieldPath('title')}>{g.title}</h2>
              <p class="text-gold text-[12px] tracking-[0.16em] uppercase mb-3">
                {fact?.display ?? 'No verified price published'}
              </p>
              {fact?.summary && (
                <p class="mb-4 text-[14px] leading-[1.7] text-muted">{fact.summary}</p>
              )}
              <span class="learn-more group-hover:text-gold mt-4 inline-block">View cost guide</span>
            </a>
            {g.treatment && (
              <div class="mx-7 border-t border-gold-metal/10 pb-6 pt-4 text-[14px] leading-relaxed text-muted" {...sbObjectId(g.treatment._id)}>
                <span>Related service: </span>
                <a href={`/services/${g.treatment.slug}/`} class="text-ink underline decoration-gold-metal/40 underline-offset-4 hover:text-gold" {...sbFieldPath('title')}>
                  {g.treatment.title}
                </a>
              </div>
            )}
          </article>
        );
      })}
      {guides.length === 0 && (
        <p class="bg-charcoal p-7 text-muted text-[14px]">No cost guides are published.</p>
      )}
    </div>
  </section>

  <section class="bg-charcoal py-12 px-6 border-t border-gold-metal/10">
    <div class="max-w-[680px] mx-auto text-center">
      <p class="text-muted text-[15px] leading-[1.8] mb-6">
        For guides without a verified price, use the related service page or call House of Rose.
      </p>
      <a href="/services/" class="btn-outline-gold">View services</a>
    </div>
  </section>
</BaseLayout>
