---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sanityFetch } from '@/lib/sanity';
import { sbObjectId, sbFieldPath } from '@/lib/visualEditing';
import {
  ALL_COST_GUIDE_SLUGS_QUERY,
  COST_GUIDE_BY_SLUG_QUERY,
  type CostGuide,
} from '@/lib/queries';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import { breadcrumbList, faqPage, article } from '@/lib/structuredData';
import { getPublicComparisonContent } from '@/lib/publicComparisonContent';
import { getCostGuideServiceSlug, getPublicServiceBySlug } from '@/lib/serviceCatalog';

export async function getStaticPaths() {
  const slugs = await sanityFetch<{ slug: string }[]>(ALL_COST_GUIDE_SLUGS_QUERY);
  return slugs.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const guideData = await sanityFetch<CostGuide>(COST_GUIDE_BY_SLUG_QUERY, { slug });
// Never `return Astro.redirect()` from a prerendered route (breaks the static build). Slugs
// come from getStaticPaths, so a miss is a data bug — fail loudly.
if (!guideData) throw new Error(`[cost/[slug]] No cost guide found in Sanity for slug "${slug}"`);
const treatmentSlug = guideData.treatmentSlug ?? getCostGuideServiceSlug(guideData.slug);
const treatment = treatmentSlug
  ? getPublicServiceBySlug(treatmentSlug)
  : undefined;
const guide: CostGuide = {
  ...guideData,
  treatment,
  comparisons: treatment?.comparisons,
};

const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonical = new URL(Astro.url.pathname, site).toString();

const treatmentName = guide.treatment?.title ?? 'this treatment';
const publishedDescription = `Learn about ${treatmentName} at House of Rose and how to ask the practice about current cost.`;
const visiblePricingSummary = `Service pricing is not published on this website. Contact House of Rose with the treatment name for current cost information.`;
const dateModified = guide._updatedAt;
const publishedFaqs = [
  {
    question: `How can I ask about the current cost of ${treatmentName}?`,
    answer: `Call House of Rose at (941) 400-0165 or send a message with “${treatmentName}” as the topic.`,
  },
];
const primaryComparison = guide.comparisons?.[0];
const primaryComparisonContent = primaryComparison
  ? getPublicComparisonContent(primaryComparison.slug)
  : null;
const singleComparisonContent = guide.comparisons?.length === 1
  ? primaryComparisonContent
  : null;

const breadcrumb = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'Pricing', item: `${site}cost/` },
  { name: guide.title, item: canonical },
]);
const faq = faqPage(publishedFaqs);
const articleSchema = article(
  { headline: guide.title, description: publishedDescription, url: canonical, dateModified },
  site,
);

const pageTitle = guide.seo?.metaTitle ?? `${guide.title} | House of Rose`;
const pageDescription = publishedDescription;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <SchemaMarkup item={breadcrumb} slot="head" />
  <SchemaMarkup item={articleSchema} slot="head" />
  {faq && <SchemaMarkup item={faq} slot="head" />}

  <div {...sbObjectId(guide._id)}>
  <section class="bg-charcoal pt-32 pb-[clamp(56px,8vw,88px)] px-6">
    <div class="max-w-[860px] mx-auto">
      <span class="kicker">Treatment cost</span>
      <h1 class="font-serif text-[clamp(30px,5vw,52px)] text-ink leading-tight mt-3 mb-6" {...sbFieldPath('title')}>{guide.title}</h1>
      <p class="max-w-[760px] font-serif text-[clamp(23px,3.2vw,32px)] leading-[1.3] text-ink">
        {visiblePricingSummary}
      </p>
    </div>
  </section>

  <section class="border-t border-gold-metal/10 bg-charcoal px-6 py-[clamp(52px,7vw,76px)]" data-cost-faq>
    <div class="mx-auto max-w-[860px]">
      <span class="kicker">What to know</span>
      <h2 class="mt-3 font-serif text-[clamp(27px,4vw,40px)] leading-tight text-ink">
        About the cost of {treatmentName}.
      </h2>
      <div class="mt-8 divide-y divide-gold-metal/10 border-y border-gold-metal/10">
        {publishedFaqs.map((item) => (
          <article class="py-6 first:pt-0 last:pb-0">
            <h3 class="font-serif text-[21px] leading-snug text-ink" data-cost-faq-question>{item.question}</h3>
            <p class="mt-3 text-[15px] leading-[1.75] text-muted" data-cost-faq-answer>{item.answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {guide.treatment && (
    <section class="bg-charcoal-light py-14 px-6">
      <div class="max-w-[860px] mx-auto">
        <span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-4">About the service</span>
        <div {...sbObjectId(guide.treatment._id)}>
          <h2 class="font-serif text-[clamp(24px,4vw,36px)] text-ink leading-tight mb-4" {...sbFieldPath('title')}>
            {guide.treatment.title}
          </h2>
          <a href={`/services/${guide.treatment.slug}/`} class="learn-more">Understand {guide.treatment.title}</a>
        </div>
      </div>
    </section>
  )}

  {guide.comparisons && guide.comparisons.length > 0 && (
    <section class="border-t border-gold-metal/10 bg-charcoal px-6 py-14">
      <div class="mx-auto max-w-[860px]">
        <span class="kicker">Related comparison</span>
        <h2 class="mt-3 font-serif text-[clamp(25px,4vw,36px)] leading-tight text-ink">
          {singleComparisonContent ? singleComparisonContent.title : 'Compare related services.'}
        </h2>
        {singleComparisonContent && (
          <p class="mt-5 max-w-[760px] text-[15px] leading-[1.75] text-muted">
            {singleComparisonContent.lead}
          </p>
        )}
        <div class="mt-8 divide-y divide-gold-metal/10 border-y border-gold-metal/10">
          {guide.comparisons.map((comparison) => (
            <a href={`/compare/${comparison.slug}/`} class="group flex items-center justify-between gap-6 py-5" {...sbObjectId(comparison._id)}>
              <span class="font-serif text-[clamp(19px,3vw,25px)] text-ink group-hover:text-gold">
                {singleComparisonContent
                  ? 'Open the full comparison'
                  : getPublicComparisonContent(comparison.slug)!.title}
              </span>
              <span class="shrink-0 text-gold" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="bg-charcoal py-12 px-6 border-t border-gold-metal/10">
    <div class="max-w-[860px] mx-auto text-center">
      <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ink leading-tight mb-6">Have a question about this treatment?</h2>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="tel:+19414000165" class="btn-outline-gold">(941) 400-0165</a>
        <a href="/contact/" class="btn-gold">Contact House of Rose</a>
      </div>
    </div>
  </section>
  </div>
</BaseLayout>
