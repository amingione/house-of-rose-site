---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sanityFetch } from '@/lib/sanity';
import { sbObjectId, sbFieldPath } from '@/lib/visualEditing';
import {
  ALL_COST_GUIDE_SLUGS_QUERY,
  COST_GUIDE_BY_SLUG_QUERY,
  type CostGuide,
} from '@/lib/queries';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import BookingLink from '@/components/BookingLink.astro';
import { breadcrumbList, faqPage, article } from '@/lib/structuredData';
import { getVerifiedCostFact } from '@/lib/costFacts';

export async function getStaticPaths() {
  const slugs = await sanityFetch<{ slug: string }[]>(ALL_COST_GUIDE_SLUGS_QUERY);
  return slugs.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const guideData = await sanityFetch<CostGuide>(COST_GUIDE_BY_SLUG_QUERY, { slug });
// Never `return Astro.redirect()` from a prerendered route (breaks the static build). Slugs
// come from getStaticPaths, so a miss is a data bug — fail loudly.
if (!guideData) throw new Error(`[cost/[slug]] No cost guide found in Sanity for slug "${slug}"`);
const guide = guideData;

const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonical = new URL(Astro.url.pathname, site).toString();

const treatmentName = guide.treatment?.title ?? 'this treatment';
const verifiedFact = getVerifiedCostFact(guide.slug);
const pricingStatement = verifiedFact?.answer
  ?? `A verified price is not published for ${treatmentName} on this Punta Gorda cost guide.`;
const dateModified = verifiedFact && (!guide._updatedAt || guide._updatedAt < verifiedFact.verifiedAt)
  ? verifiedFact.verifiedAt
  : guide._updatedAt;

const breadcrumb = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'Pricing', item: `${site}cost/` },
  { name: guide.title, item: canonical },
]);
const faq = faqPage([
  {
    question: `What price is published for ${treatmentName}?`,
    answer: pricingStatement,
  },
]);
const articleSchema = article(
  { headline: guide.title, description: pricingStatement, url: canonical, dateModified },
  site,
);

const pageTitle = guide.seo?.metaTitle ?? `${guide.title} | House of Rose`;
const pageDescription = pricingStatement;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <SchemaMarkup item={breadcrumb} slot="head" />
  <SchemaMarkup item={articleSchema} slot="head" />
  {faq && <SchemaMarkup item={faq} slot="head" />}

  <div {...sbObjectId(guide._id)}>
  <section class="bg-charcoal pt-32 pb-12 px-6">
    <div class="max-w-[860px] mx-auto">
      <span class="kicker">Pricing Guide</span>
      <h1 class="font-serif text-[clamp(30px,5vw,52px)] text-ink leading-tight mt-3 mb-6" {...sbFieldPath('title')}>{guide.title}</h1>
      <div class="mt-6 inline-block border border-gold-metal/40 px-5 py-4">
        <span class="block text-gold text-[11px] tracking-[0.2em] uppercase mb-2">Verified price</span>
        <p class="text-ink text-[17px] font-medium">{verifiedFact?.display ?? 'No verified price published'}</p>
      </div>
      <p class="text-muted text-[14px] leading-relaxed mt-5 max-w-[640px]">{pricingStatement}</p>
    </div>
  </section>

  {guide.treatment && (
    <section class="bg-charcoal-light py-14 px-6">
      <div class="max-w-[860px] mx-auto">
        <span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-4">Related service</span>
        <div {...sbObjectId(guide.treatment._id)}>
          <h2 class="font-serif text-[clamp(24px,4vw,36px)] text-ink leading-tight mb-4" {...sbFieldPath('title')}>
            {guide.treatment.title}
          </h2>
          <a href={`/services/${guide.treatment.slug}/`} class="learn-more">View service</a>
        </div>
      </div>
    </section>
  )}

  <section class="bg-charcoal py-12 px-6 border-t border-gold-metal/10">
    <div class="max-w-[860px] mx-auto text-center">
      <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ink leading-tight mb-6">Questions about pricing?</h2>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="tel:+18449417673" class="btn-outline-gold">(844) 941-7673</a>
        {guide.treatment ? (
          <BookingLink
            slug={guide.treatment.slug}
            bookingMode={guide.treatment.bookingMode}
            bookingUrl={guide.treatment.bookingUrl}
            location="cost_guide_final"
            class="btn-gold"
          />
        ) : (
          <a href="/consultation/" class="btn-gold">Request a consultation</a>
        )}
      </div>
    </div>
  </section>
  </div>
</BaseLayout>
