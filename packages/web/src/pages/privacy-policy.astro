---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SchemaMarkup from "@/components/SchemaMarkup.astro";
import { sanityFetch } from "@/lib/sanity";
import { sbObjectId, sbFieldPath, sbFieldPathParts } from "@/lib/visualEditing";
import { breadcrumbList } from "@/lib/structuredData";
import { alignPublicChannelCopy } from "@/lib/publicCopy";

const privacySupportEmail = "support@updates.houseofrosefl.com";

// ─── Privacy Policy content from Sanity (singleton) ─────────────────────────────
// Falls back to the original hardcoded copy if a field is empty, so there's no
// regression and nothing is lost. Section bodies are plain text (rendered with
// whitespace-pre-line) — list bullets/numbers live inside the text.
interface PrivacySection {
	_key: string;
	heading: string;
	body: string;
}

interface PrivacyPolicy {
	_id?: string;
	seoTitle?: string;
	seoDescription?: string;
	pageTitle?: string;
	lastUpdated?: string;
	intro?: string;
	sections?: PrivacySection[];
}

const PRIVACY_POLICY_QUERY = /* groq */ `
	*[_type == "privacyPolicy"][0]{
		_id,
		seoTitle,
		seoDescription,
		pageTitle,
		lastUpdated,
		intro,
		sections[]{ _key, heading, body }
	}
`;

const data =
	(await sanityFetch<PrivacyPolicy | null>(PRIVACY_POLICY_QUERY)) ??
	({} as PrivacyPolicy);

const FALLBACK_SECTIONS: PrivacySection[] = [
	{
		_key: "s1",
		heading: "Information We Collect",
		body: "We may collect information you provide when you contact us, request services, book an appointment, subscribe to messaging, or communicate with House of Rose Aesthetics LLC. This may include your name, contact information, appointment details, preferences, and messages you send to us.",
	},
	{
		_key: "s2",
		heading: "How We Use Information",
		body: "We use customer information to answer questions, provide support, manage appointments, communicate about services, send requested messages, and operate our business.",
	},
	{
		_key: "s3",
		heading: "Data Sharing",
		body: "• Customer data is not shared with 3rd parties for promotional or marketing purposes.\n• Mobile opt-in and consent are never shared with anyone for any purpose. Any information sharing that may be mentioned elsewhere in this policy excludes mobile opt-in data.",
	},
	{
		_key: "s4",
		heading: "House of Rose Aesthetics LLC Messaging Terms and Conditions",
		body: "1. The messaging program consists of general conversational messaging to answer questions and provide support to customers, as well as promotional messages about our products/services when separately consented to.\n2. You can cancel the SMS service at any time. Just text 'STOP' to the phone number from which you received messages. After you send the SMS message 'STOP' to us, we will send you an SMS message to confirm that you have been unsubscribed. After this, you will no longer receive SMS messages from us. If you want to join again, just sign up as you did the first time and we will start sending SMS messages to you again.\n3. If you are experiencing issues with the messaging program you can reply with the keyword HELP for more assistance, or you can get help directly at info@houseofrosefl.com.\n4. Carriers are not liable for delayed or undelivered messages.\n5. As always, message and data rates may apply for any messages sent to you from us and to us from you. Message frequency will vary based on communication needs. If you have any questions about your text plan or data plan, it is best to contact your wireless provider.\n6. If you have any questions regarding privacy, please read our privacy policy contained in the rest of this document/page.",
	},
	{
		_key: "s5",
		heading: "Contact",
		body: `If you have questions about this privacy policy or House of Rose Aesthetics LLC messaging, use the privacy support form below. Messages are sent from ${privacySupportEmail}.`,
	},
];

const REQUIRED_MEASUREMENT_SECTIONS: PrivacySection[] = [
	{
		_key: "measurement",
		heading: "Website Measurement and Advertising",
		body: "We use Google Tag Manager to control measurement tags, Google Analytics 4 and Crazy Egg to understand consented website activity, and Google Ads, Meta Pixel, and OpenAI Ads measurement tools to measure advertising performance. With your permission, these services may use cookies or similar technologies and process device, browser, page, campaign, and interaction information. Google tags may also send limited consent-aware, cookieless signals when storage is denied. Crazy Egg, Meta Pixel, OpenAI Ads measurement, and Ahrefs Analytics do not activate until the applicable analytics or advertising permission is granted.",
	},
	{
		_key: "attribution",
		heading: "Click Identifiers, Conversions, and Retention",
		body: "We may capture Google click identifiers (gclid, gbraid, and wbraid), OpenAI-provided privacy-preserving ad reference identifiers, campaign parameters, landing page, referrer, and the consent setting in effect when you first arrive. Required attribution fields may be retained with a lead or order to prevent duplicate reporting and measure campaign results. For a completed retail purchase, we may send the order reference, value, tax, shipping, currency, and SKU-based items to Google, and the order reference, total value, currency, and SKU-based items to OpenAI Ads. For a submitted inquiry, we may report that a lead was created, but we do not send the form message or service interest. If advertising and user-data consent are both granted, conversion matching may use a one-way hash of an email address and limited browser, IP, and approximate location information available during the verified conversion. This matching information is not placed in our ordinary website data layer. We retain consent choices for up to 180 days, and operational records for the period needed to fulfill transactions, meet legal obligations, resolve disputes, and protect the business.",
	},
	{
		_key: "choices",
		heading: "Your Privacy Choices",
		body: "You may accept all optional measurement, reject nonessential processing, or choose analytics and advertising separately. Use the permanent “Privacy choices” link in the footer to review or withdraw consent. Withdrawing consent applies to future collection and does not undo processing that already occurred. If your browser sends a Global Privacy Control signal, advertising storage, advertising user data, and advertising personalization are forced off. Information required to process a request, booking, payment, shipment, fraud check, or legal obligation remains operational and is not treated as advertising consent.",
	},
];

const DIRECTIONS_PRIVACY_SECTION: PrivacySection = {
	_key: "directions-location",
	heading: "Directions and Location Access",
	body: "The directions tool on the Contact page uses Mapbox to display the map, search a starting address, and calculate driving time and distance. If you choose “Use my location,” your browser asks for permission; when granted, your coordinates are sent to Mapbox to calculate the route. You can decline location access and enter a starting address instead, or open Google Maps or Apple Maps without supplying a starting point. The directions tool does not add your starting address or current location to the contact form.",
};

const sourceSections =
	data.sections && data.sections.length ? data.sections : FALLBACK_SECTIONS;
const reservedHeadings = new Set([
	"data sharing",
	"website measurement and advertising",
	"click identifiers, retail conversions, and retention",
	"click identifiers, conversions, and retention",
	"your privacy choices",
	"directions and location access",
]);
const sections = [
	...sourceSections.filter((section) => {
		const heading = section.heading.trim().toLowerCase();
		return !reservedHeadings.has(heading) && !heading.endsWith("messaging terms and conditions");
	}),
	FALLBACK_SECTIONS[2],
	FALLBACK_SECTIONS[3],
	DIRECTIONS_PRIVACY_SECTION,
	...REQUIRED_MEASUREMENT_SECTIONS,
]
	.filter((section): section is PrivacySection => Boolean(section))
	.map((section) => ({
		...section,
		heading: alignPublicChannelCopy(section.heading),
		body: alignPublicChannelCopy(section.body),
	}));

const pageTitle = data.pageTitle ?? "Privacy Policy";
const lastUpdated = "Updated August 14, 2026";
const intro = alignPublicChannelCopy(
	(data.intro ??
		"House of Rose Aesthetics LLC respects your privacy. This policy explains how we handle customer information, including information connected to SMS messaging."),
);

const oid = data._id ? sbObjectId(data._id) : {};

const site = Astro.site?.toString() ?? "https://houseofrosefl.com/";
const canonical = new URL(Astro.url.pathname, site).toString();
const pageMetaTitle = data.seoTitle ?? "Privacy Policy | House of Rose Aesthetics";
const pageMetaDescription = alignPublicChannelCopy(
	data.seoDescription ??
	"House of Rose Aesthetics LLC privacy policy, data sharing practices, and messaging terms and conditions.",
);
const breadcrumb = breadcrumbList([
	{ name: "Home", item: site },
	{ name: "Privacy Policy", item: canonical },
]);
---

<BaseLayout title={pageMetaTitle} description={pageMetaDescription}>
	<SchemaMarkup item={breadcrumb} slot="head" />
	<section class="bg-charcoal py-24 max-w-4xl mx-auto px-6" {...oid}>
		<div class="text-center mb-16">
			<p class="text-xs tracking-[0.3em] uppercase text-gold mb-4">
				House of Rose Aesthetics LLC
			</p>
			<h1 class="font-serif text-5xl text-ink" {...sbFieldPath("pageTitle")}>{pageTitle}</h1>
			<p class="mt-4 text-sm text-ink/75">{lastUpdated}</p>
		</div>

		<div class="prose prose-lg max-w-none text-ink/80">
			<p class="lead text-xl text-ink/70 leading-relaxed" {...sbFieldPath("intro")}>
				{intro}
			</p>

			{sections.map((section, i) => (
				<>
					<h2 {...(section._key === DIRECTIONS_PRIVACY_SECTION._key ? {} : sbFieldPathParts("sections", i, "heading"))}>{section.heading}</h2>
					<p class="whitespace-pre-line" {...(section._key === DIRECTIONS_PRIVACY_SECTION._key ? {} : sbFieldPathParts("sections", i, "body"))}>{section.body}</p>
				</>
			))}
		</div>

		<form
			id="privacy-contact"
			method="post"
			action="/.netlify/functions/privacy-contact"
			class="mt-12 border border-gold-metal/20 bg-charcoal-light p-6 shadow-sm"
		>
			<div class="mb-6">
				<p class="text-xs tracking-[0.3em] uppercase text-gold mb-2">
					Privacy Support
				</p>
				<h2 class="font-serif text-3xl text-ink">
					Send a Privacy Request
				</h2>
				<p class="mt-3 text-sm leading-relaxed text-ink/70">
					Use this form for a privacy question or request that needs a reply. Sending it does not change your optional website measurement preferences.
				</p>
				<p class="mt-3 text-sm leading-relaxed text-ink/70">
					This mailbox is not monitored for appointment changes or questions after a visit. For those, call <a href="tel:+18449417673" class="text-gold hover:underline">(844) 941-7673</a> during practice hours or review the <a href="/support/" class="text-gold hover:underline">support options</a>. If you believe you are having a medical emergency, call 911 or seek emergency care.
				</p>
				<button id="privacy-form-choices" type="button" class="btn-outline-gold mt-5">
					Review privacy choices
				</button>
			</div>

			<div class="grid gap-5 md:grid-cols-2">
				<label class="block">
					<span class="text-xs tracking-widest uppercase text-gold">
						Name
					</span>
					<input
						type="text"
						name="name"
						required
						autocomplete="name"
						class="mt-2 w-full border border-ink/10 bg-charcoal px-4 py-3 text-ink outline-none focus:border-gold transition-colors"
					/>
				</label>

				<label class="block">
					<span class="text-xs tracking-widest uppercase text-gold">
						Email
					</span>
					<input
						type="email"
						name="email"
						required
						autocomplete="email"
						class="mt-2 w-full border border-ink/10 bg-charcoal px-4 py-3 text-ink outline-none focus:border-gold transition-colors"
					/>
				</label>
			</div>

			<label class="mt-5 block">
				<span class="text-xs tracking-widest uppercase text-gold">
					Subject
				</span>
				<input
					type="text"
					name="subject"
					required
					class="mt-2 w-full border border-ink/10 bg-charcoal px-4 py-3 text-ink outline-none focus:border-gold transition-colors"
				/>
			</label>

			<label class="mt-5 block">
				<span class="text-xs tracking-widest uppercase text-gold">
					Message
				</span>
				<textarea
					name="message"
					required
					rows="6"
					class="mt-2 w-full border border-ink/10 bg-charcoal px-4 py-3 text-ink outline-none focus:border-gold transition-colors"
				></textarea>
			</label>

			<label class="hidden" aria-hidden="true">
				<span>Website</span>
				<input type="text" name="website" tabindex="-1" autocomplete="off" />
			</label>

			<div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
				<p class="text-sm text-ink/75">
					Visible sender: {privacySupportEmail}
				</p>
				<button type="submit" class="btn-gold">Send Request</button>
			</div>
		</form>
	</section>
</BaseLayout>

<script>
	document.getElementById("privacy-form-choices")?.addEventListener("click", () => {
		window.dispatchEvent(new CustomEvent("hor:open-consent"));
	});
</script>

<style>
	/* Override prose heading colors to match brand */
	.prose h2 {
		@apply text-gold font-serif text-2xl mb-4 mt-8;
	}

	/* Ensure proper text contrast */
	.prose p,
	.prose li {
		@apply text-ink/80;
	}

	.prose strong {
		@apply text-ink;
	}

	/* List styling */
	.prose ul,
	.prose ol {
		@apply text-ink/80;
	}
</style>
