---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sanityFetch } from '@/lib/sanity';
import { sbObjectId, sbFieldPath } from '@/lib/visualEditing';
import {
  ALL_CASE_STUDY_SLUGS_QUERY,
  CASE_STUDY_BY_SLUG_QUERY,
  type CaseStudy,
} from '@/lib/queries';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import { breadcrumbList, imageObject } from '@/lib/structuredData';
import { getPublicServiceBySlug } from '@/lib/serviceCatalog';

export async function getStaticPaths() {
  const slugs = await sanityFetch<{ slug: string }[]>(ALL_CASE_STUDY_SLUGS_QUERY);
  return slugs.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const caseStudyData = await sanityFetch<CaseStudy>(CASE_STUDY_BY_SLUG_QUERY, { slug });
// Never `return Astro.redirect()` from a prerendered route (breaks the static build).
// getStaticPaths only emits consented slugs (ALL_CASE_STUDY_SLUGS_QUERY gates consentGiven),
// so reaching here without consent is a data-integrity bug — fail loudly.
if (!caseStudyData || caseStudyData.consentGiven !== true) {
  throw new Error(`[results/[slug]] Missing or non-consented case study for slug "${slug}"`);
}
const cs: CaseStudy = {
  ...caseStudyData,
  treatment: caseStudyData.treatmentSlug
    ? getPublicServiceBySlug(caseStudyData.treatmentSlug)
    : undefined,
};

const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonical = new URL(Astro.url.pathname, site).toString();
const beforeUrl = cs.beforeImage?.asset?.url;
const afterUrl = cs.afterImage?.asset?.url;

const breadcrumb = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'Results', item: `${site}results/` },
  { name: cs.title, item: canonical },
]);
const imageSchemas = [
  beforeUrl && imageObject({ contentUrl: beforeUrl, caption: `${cs.title} — before`, url: canonical }),
  afterUrl && imageObject({ contentUrl: afterUrl, caption: `${cs.title} — after`, url: canonical }),
].filter(Boolean) as Record<string, unknown>[];

const pageTitle = cs.seo?.metaTitle ?? `${cs.title} | Before & After | House of Rose`;
const pageDescription = cs.seo?.metaDescription ?? cs.outcome ?? `${cs.title} before and after results at House of Rose, Punta Gorda FL.`;
---

<BaseLayout title={pageTitle} description={pageDescription} image={afterUrl}>
  <SchemaMarkup item={breadcrumb} slot="head" />
  {imageSchemas.map((schema) => <SchemaMarkup item={schema} slot="head" />)}

  <div {...sbObjectId(cs._id)}>
  <section class="bg-charcoal pt-32 pb-10 px-6">
    <div class="max-w-[960px] mx-auto">
      <a href="/results/" class="learn-more inline-block mb-5">← All Results</a>
      <span class="kicker">Before &amp; After</span>
      <h1 class="font-serif text-[clamp(28px,5vw,48px)] text-ink leading-tight mt-3 mb-4" {...sbFieldPath('title')}>{cs.title}</h1>
      <p class="text-muted text-[13px] tracking-[0.14em] uppercase">
        {cs.treatment?.title}{cs.treatment && cs.timeframe && <span class="text-gold mx-2">·</span>}{cs.timeframe}
        {(cs.treatment || cs.timeframe) && cs.concern && <span class="text-gold mx-2">·</span>}
        {cs.concern && <a href={`/concerns/${cs.concern.slug}/`} class="hover:text-gold">{cs.concern.title}</a>}
      </p>
    </div>
  </section>

  <section class="bg-charcoal-light py-12 px-6">
    <div class="max-w-[960px] mx-auto grid grid-cols-1 sm:grid-cols-2 gap-px bg-gold-metal/10">
      {beforeUrl && (
        <figure class="bg-charcoal">
          <img src={beforeUrl} alt={cs.beforeImage?.alt ?? `${cs.title} before`} class="w-full h-auto object-cover" loading="lazy" {...sbFieldPath('beforeImage')} />
          <figcaption class="text-center text-muted text-[11px] tracking-[0.24em] uppercase py-3">Before</figcaption>
        </figure>
      )}
      {afterUrl && (
        <figure class="bg-charcoal">
          <img src={afterUrl} alt={cs.afterImage?.alt ?? `${cs.title} after`} class="w-full h-auto object-cover" loading="lazy" {...sbFieldPath('afterImage')} />
          <figcaption class="text-center text-gold text-[11px] tracking-[0.24em] uppercase py-3">After</figcaption>
        </figure>
      )}
    </div>
  </section>

  <section class="bg-charcoal py-14 px-6">
    <div class="max-w-[860px] mx-auto space-y-8">
      {cs.clientProfile && (
        <div><span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-2">Client</span><p class="text-ink/80 text-[15px]" {...sbFieldPath('clientProfile')}>{cs.clientProfile}</p></div>
      )}
      {cs.protocol && (
        <div><span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-2">Protocol</span><p class="text-ink/80 text-[15px] leading-relaxed whitespace-pre-line" {...sbFieldPath('protocol')}>{cs.protocol}</p></div>
      )}
      {cs.outcome && (
        <div><span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-2">Outcome</span><p class="text-ink/80 text-[15px] leading-relaxed whitespace-pre-line" {...sbFieldPath('outcome')}>{cs.outcome}</p></div>
      )}
      <p class="text-muted text-[12px] leading-relaxed pt-4 border-t border-ink/5">Shared with written client consent. Individual results vary; this is not a guarantee of outcome.</p>
    </div>
  </section>

  <section class="bg-charcoal-light py-12 px-6 border-t border-gold-metal/10">
    <div class="max-w-[860px] mx-auto text-center">
      {cs.treatment && (
        <a href={`/services/${cs.treatment.slug}/`} class="learn-more inline-block mb-8">← Explore {cs.treatment.title}</a>
      )}
      <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ink leading-tight mb-6">Learn more about this treatment.</h2>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="tel:+19414000165" class="btn-outline-gold">(941) 400-0165</a>
        <a href={cs.treatment ? `/services/${cs.treatment.slug}/` : '/contact/'} class="btn-gold">
          {cs.treatment ? `Learn about ${cs.treatment.title}` : 'Contact House of Rose'}
        </a>
      </div>
    </div>
  </section>
  </div>
</BaseLayout>
