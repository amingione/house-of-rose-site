---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sanityFetch } from '@/lib/sanity';
import { sbObjectId, sbFieldPath } from '@/lib/visualEditing';
import { ALL_CASE_STUDIES_QUERY, type CaseStudy } from '@/lib/queries';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import { breadcrumbList } from '@/lib/structuredData';
import { getPublicServiceBySlug } from '@/lib/serviceCatalog';

const studyData = await sanityFetch<CaseStudy[]>(ALL_CASE_STUDIES_QUERY);
const studies: CaseStudy[] = studyData.map((study) => ({
  ...study,
  treatment: study.treatmentSlug ? getPublicServiceBySlug(study.treatmentSlug) : undefined,
}));
const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonical = new URL(Astro.url.pathname, site).toString();
const resultsDescription = studies.length > 0
  ? 'Before-and-after treatment cases shared with written client permission by House of Rose Aesthetics in Punta Gorda, Florida. Individual outcomes vary.'
  : 'Learn how House of Rose Aesthetics documents treatment results and client-image consent in Punta Gorda, Florida.';

const breadcrumb = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'Results', item: canonical },
]);
---

<BaseLayout
  title="Before & After Results | House of Rose Aesthetics"
  description={resultsDescription}
  noindex={studies.length === 0}
>
  <SchemaMarkup item={breadcrumb} slot="head" />

  <section class="bg-charcoal pt-32 pb-12 px-6">
    <div class="max-w-[1280px] mx-auto">
      <span class="kicker">Before &amp; After</span>
      <h1 class="font-serif text-[clamp(30px,5vw,52px)] text-ink leading-tight mt-3 mb-5">Results, with context.</h1>
      <p class="text-ink/80 text-[16px] max-w-[640px] leading-relaxed">Client photographs are shared only with written permission. Individual outcomes vary.</p>
    </div>
  </section>

  {studies.length > 0 ? (
    <section class="bg-charcoal-light py-14 px-6">
      <div class="max-w-[1280px] mx-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-px bg-gold-metal/10">
        {studies.map((cs) => (
          <a href={`/results/${cs.slug}/`} class="bg-charcoal group block transition-colors hover:bg-charcoal-lighter" {...sbObjectId(cs._id)}>
            {cs.afterImage?.asset?.url && (
              <div class="aspect-square overflow-hidden bg-charcoal-lighter">
                <img
                  src={cs.afterImage.asset.url}
                  alt={cs.afterImage.alt ?? cs.title}
                  width={400}
                  height={400}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </div>
            )}
            <div class="p-6">
              <h2 class="font-serif text-[19px] text-ink mb-1 group-hover:text-gold transition-colors" {...sbFieldPath('title')}>{cs.title}</h2>
              {cs.treatment && <p class="text-gold text-[11px] tracking-[0.18em] uppercase">{cs.treatment.title}</p>}
              {cs.timeframe && <p class="text-muted text-[13px] mt-2">{cs.timeframe}</p>}
            </div>
          </a>
        ))}
      </div>
    </section>
  ) : (
    <section class="bg-charcoal-light py-16 px-6">
      <div data-results-empty-state class="max-w-[760px] mx-auto text-center">
        <span class="kicker">Before &amp; After</span>
        <h2 class="mt-3 font-serif text-[clamp(27px,4vw,40px)] leading-tight text-ink">
          No client cases are currently available to view.
        </h2>
        <p class="mx-auto mt-5 max-w-[620px] text-[15px] leading-[1.8] text-muted">
          House of Rose does not use stock photographs as client results. Individual outcomes vary.
        </p>
        <a href="/services/" class="btn-outline-gold mt-8">Explore treatments</a>
      </div>
    </section>
  )}

  {studies.length > 0 && (
  <section data-results-standard class="border-y border-gold-metal/10 bg-charcoal-light px-6 py-[clamp(52px,7vw,88px)]">
    <div class="mx-auto max-w-[1120px]">
      <div class="max-w-[760px]">
        <span class="kicker">How to read a result</span>
        <h2 class="mt-3 font-serif text-[clamp(28px,4vw,44px)] leading-tight text-ink">
          Two pictures can be persuasive before they are informative.
        </h2>
        <p class="mt-5 text-[16px] leading-[1.8] text-muted">
          A useful before-and-after makes the comparison—and its limits—easy to understand. Treatment details and timing provide essential context.
        </p>
      </div>

      <div class="mt-10 grid gap-px bg-gold-metal/10 sm:grid-cols-2">
        <article class="bg-charcoal p-7 sm:p-8">
          <h3 class="font-serif text-[22px] text-ink">Comparable photographs</h3>
          <p class="mt-3 text-[14px] leading-[1.75] text-muted">
            Before and after images use the same distance, crop, angle, lighting, and background. Retouching or editing must not change the apparent result.
          </p>
        </article>
        <article class="bg-charcoal p-7 sm:p-8">
          <h3 class="font-serif text-[22px] text-ink">What contributed</h3>
          <p class="mt-3 text-[14px] leading-[1.75] text-muted">
            The treatment is named, along with anything else used in the same series that contributed to the result. The details appear with the case instead of being left to assumption.
          </p>
        </article>
        <article class="bg-charcoal p-7 sm:p-8">
          <h3 class="font-serif text-[22px] text-ink">Time between images</h3>
          <p class="mt-3 text-[14px] leading-[1.75] text-muted">
            The elapsed timeframe—and the number of sessions when relevant—belongs beside the photographs. A result without timing is missing essential context.
          </p>
        </article>
        <article class="bg-charcoal p-7 sm:p-8">
          <h3 class="font-serif text-[22px] text-ink">Permission and limits</h3>
          <p class="mt-3 text-[14px] leading-[1.75] text-muted">
            Client photographs are shared only with written permission. One person’s outcome is not a promise or a statement of what is typical; individual results vary.
          </p>
        </article>
      </div>

      <aside data-results-publication-consent class="mt-10 border border-gold-metal/15 bg-charcoal px-7 py-8 sm:px-9">
        <span class="kicker">A direct answer</span>
        <h3 class="mt-3 font-serif text-[clamp(24px,3.5vw,34px)] leading-tight text-ink">
          Will my photographs be shared?
        </h3>
        <p class="mt-4 max-w-[780px] text-[15px] leading-[1.8] text-muted">
          Only if you give separate written permission. Receiving a treatment does not give House of Rose permission to share your photographs.
        </p>
      </aside>

      <aside data-results-client-guidance class="mt-5 border border-gold-metal/15 bg-charcoal px-7 py-8 sm:px-9">
        <span class="kicker">Using the gallery</span>
        <h3 class="mt-3 font-serif text-[clamp(24px,3.5vw,34px)] leading-tight text-ink">
          How should I use a before-and-after when deciding?
        </h3>
        <p class="mt-4 max-w-[780px] text-[15px] leading-[1.8] text-muted">
          Treat it as one person’s documented example, not a forecast for your own result. Look for the concern or treatment area, the service or series named with the case, the number of sessions when provided, and the time between photographs. That context gives you a specific question to bring to the practice; the photographs alone cannot tell you what your outcome would be.
        </p>
      </aside>
    </div>
  </section>

  <section data-results-next-step class="bg-charcoal py-[clamp(48px,7vw,72px)] px-6 border-t border-gold-metal/10">
    <div class="max-w-[760px] mx-auto text-center">
      <span class="kicker">What it cannot answer</span>
      <h2 class="mt-3 font-serif text-[clamp(27px,4vw,40px)] leading-tight text-ink">
        A photograph can start the conversation. It cannot finish it.
      </h2>
      <p class="mx-auto mt-5 max-w-[620px] text-muted text-[15px] leading-[1.8]">
        A before-and-after can help you point to the kind of change you mean. It cannot predict how your skin will respond, whether the same service is suitable for you, or what recovery would be like in your case. Bring the photograph if it helps you explain the question; the answer should still be about you, not a promise to recreate someone else’s result.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/services/" class="btn-gold">Browse services</a>
        <a href="/compare/" class="btn-outline-gold">Compare services</a>
      </div>
    </div>
  </section>
  )}
</BaseLayout>
