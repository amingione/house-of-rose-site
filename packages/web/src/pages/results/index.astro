---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sanityFetch } from '@/lib/sanity';
import { sbObjectId, sbFieldPath } from '@/lib/visualEditing';
import { ALL_CASE_STUDIES_QUERY, type CaseStudy } from '@/lib/queries';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import { breadcrumbList } from '@/lib/structuredData';

const studies = await sanityFetch<CaseStudy[]>(ALL_CASE_STUDIES_QUERY);
const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonical = new URL(Astro.url.pathname, site).toString();

const breadcrumb = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'Results', item: canonical },
]);
---

<BaseLayout
  title="Before & After Results | House of Rose Aesthetics"
  description="Consented before-and-after treatment cases from House of Rose Aesthetics in Punta Gorda, Florida. Individual outcomes vary."
  noindex={studies.length === 0}
>
  <SchemaMarkup item={breadcrumb} slot="head" />

  <section class="bg-charcoal pt-32 pb-12 px-6">
    <div class="max-w-[1280px] mx-auto">
      <span class="kicker">Before &amp; After</span>
      <h1 class="font-serif text-[clamp(30px,5vw,52px)] text-ink leading-tight mt-3 mb-5">Results, with context.</h1>
      <p class="text-ink/80 text-[16px] max-w-[640px] leading-relaxed">Only cases with written client consent are published. Individual outcomes vary.</p>
    </div>
  </section>

  {studies.length > 0 ? (
    <section class="bg-charcoal-light py-14 px-6">
      <div class="max-w-[1280px] mx-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-px bg-gold-metal/10">
        {studies.map((cs) => (
          <a href={`/results/${cs.slug}/`} class="bg-charcoal group block transition-colors hover:bg-charcoal-lighter" {...sbObjectId(cs._id)}>
            {cs.afterImage?.asset?.url && (
              <div class="aspect-square overflow-hidden bg-charcoal-lighter">
                <img
                  src={cs.afterImage.asset.url}
                  alt={cs.afterImage.alt ?? cs.title}
                  width={400}
                  height={400}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </div>
            )}
            <div class="p-6">
              <h2 class="font-serif text-[19px] text-ink mb-1 group-hover:text-gold transition-colors" {...sbFieldPath('title')}>{cs.title}</h2>
              {cs.treatment && <p class="text-gold text-[11px] tracking-[0.18em] uppercase">{cs.treatment.title}</p>}
              {cs.timeframe && <p class="text-muted text-[13px] mt-2">{cs.timeframe}</p>}
            </div>
          </a>
        ))}
      </div>
    </section>
  ) : (
    <section class="bg-charcoal-light py-16 px-6">
      <div class="max-w-[680px] mx-auto text-center">
        <p class="text-muted text-[15px] leading-[1.8] mb-8">
          No client cases are currently published.
        </p>
        <a href="/services/" class="btn-outline-gold">Browse services</a>
      </div>
    </section>
  )}

  <section class="bg-charcoal py-12 px-6 border-t border-gold-metal/10">
    <div class="max-w-[680px] mx-auto text-center">
      <p class="text-muted text-[15px] leading-[1.8]">
        Review <a href="/services/" class="text-gold hover:underline">service details</a> or browse the available <a href="/compare/" class="text-gold hover:underline">side-by-side comparisons</a>.
      </p>
    </div>
  </section>
</BaseLayout>
