---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import { sanityFetch } from '@/lib/sanity';
import { sbObjectId, sbFieldPath, sbFieldPathParts } from '@/lib/visualEditing';

const BOOKING_URL = 'https://houseofrose.glossgenius.com/services';
const SKIN_ANALYSIS_URL = '/skin-analysis';
const METHOD_URL = '/plans';

interface RosePhase {
  name: string;
  intent: string;
}

interface RoseCirclePage {
  _id?: string;
  seoTitle?: string;
  seoDescription?: string;
  heroKicker?: string;
  heroTitle?: string;
  heroDescription?: string;
  heroCtaPrimaryText?: string;
  ideaKicker?: string;
  ideaHeading?: string;
  ideaBody?: string;
  startKicker?: string;
  startHeading?: string;
  startBody?: string;
  phasesKicker?: string;
  phasesHeading?: string;
  phasesIntro?: string;
  phases?: RosePhase[];
  commitmentKicker?: string;
  commitmentHeading?: string;
  commitmentBody?: string;
  teaserKicker?: string;
  teaserHeading?: string;
  teaserBody?: string;
  teaserCtaText?: string;
  finalKicker?: string;
  finalHeading?: string;
  finalBody?: string;
  finalCtaPrimaryText?: string;
  finalCtaSecondaryText?: string;
}

const ROSE_CIRCLE_PAGE_QUERY = `*[_type == "roseCirclePage"][0]{
  _id,
  seoTitle,
  seoDescription,
  heroKicker,
  heroTitle,
  heroDescription,
  heroCtaPrimaryText,
  ideaKicker,
  ideaHeading,
  ideaBody,
  startKicker,
  startHeading,
  startBody,
  phasesKicker,
  phasesHeading,
  phasesIntro,
  phases[]{ _key, name, intent },
  commitmentKicker,
  commitmentHeading,
  commitmentBody,
  teaserKicker,
  teaserHeading,
  teaserBody,
  teaserCtaText,
  finalKicker,
  finalHeading,
  finalBody,
  finalCtaPrimaryText,
  finalCtaSecondaryText
}`;

const data = (await sanityFetch<RoseCirclePage | null>(ROSE_CIRCLE_PAGE_QUERY)) ?? ({} as RoseCirclePage);

const FALLBACK_PHASES: RosePhase[] = [
  {
    name: 'Reveal',
    intent: 'Clear, resurface, and prepare the canvas. Before anything else, your skin needs a healthy, even foundation — this phase clears congestion and buildup so later work can actually take hold.',
  },
  {
    name: 'Regenerate',
    intent: 'Stimulate collagen and tissue from within. This is where real, lasting change comes from your own biology — not something borrowed or applied on top.',
  },
  {
    name: 'Restore',
    intent: 'Replace what time has taken, naturally where possible. Once the foundation is rebuilt, this phase softens and refines — never chasing "done," only ever more like you.',
  },
  {
    name: 'Sustain',
    intent: 'Protect the investment. This is the ongoing work of the Rose Circle itself: keeping what you’ve built instead of watching it fade.',
  },
];

const phases = data.phases?.length ? data.phases : FALLBACK_PHASES;
const usingFallbackPhases = !data.phases?.length;
---

<BaseLayout
  title={data.seoTitle ?? 'The Rose Circle | House of Rose Aesthetics, Punta Gorda FL'}
  description={data.seoDescription ?? 'The Rose Circle is the guided relationship behind every House of Rose plan — four phases of care, sequenced around your skin, at member rates.'}
  preloadImage="/images/hor-lounge.jpg"
>
  <div {...(data._id ? sbObjectId(data._id) : {})}>
    <Hero
      title={data.heroTitle ?? 'The Rose Circle'}
      kicker={data.heroKicker ?? 'The Rose Circle'}
      description={data.heroDescription ?? 'The Rose Circle is your ongoing relationship with House of Rose — a guided path through four phases of care, built around your skin and paced by your provider, not a preset menu.'}
      size="small"
      showCTA={true}
      ctaPrimary={{ text: data.heroCtaPrimaryText ?? 'Book Your Skin Analysis', href: SKIN_ANALYSIS_URL }}
      backgroundImage="/images/hor-lounge.jpg"
      titleField="heroTitle"
      kickerField="heroKicker"
      descriptionField="heroDescription"
    />

    <section class="bg-charcoal py-[clamp(48px,7vw,96px)] px-6">
      <div class="max-w-[860px] mx-auto text-center">
        <span class="kicker" {...sbFieldPath('ideaKicker')}>{data.ideaKicker ?? 'The Philosophy'}</span>
        <h2 class="font-serif text-[clamp(24px,3.6vw,40px)] text-ink leading-tight mt-2 mb-6" {...sbFieldPath('ideaHeading')}>
          {data.ideaHeading ?? 'Skin does not transform in moments. It transforms through timing, consistency, and structure.'}
        </h2>
        <p class="text-[#7a6e5c] text-[16px] leading-[1.85] max-w-[680px] mx-auto" {...sbFieldPath('ideaBody')}>
          {data.ideaBody ?? 'Most aesthetic care happens in isolation — a facial here, an injectable there. The Rose Circle is different: it’s the relationship that carries you through a real sequence of care. Never everything at once. Always the right thing at the right time.'}
        </p>
      </div>
    </section>

    <section class="bg-charcoal-light py-[clamp(44px,6vw,80px)] px-6 border-t border-gold/10">
      <div class="max-w-[820px] mx-auto text-center">
        <span class="kicker" {...sbFieldPath('startKicker')}>{data.startKicker ?? 'How It Begins'}</span>
        <h2 class="font-serif text-[clamp(24px,3.6vw,38px)] text-ink leading-tight mt-2 mb-5" {...sbFieldPath('startHeading')}>
          {data.startHeading ?? 'It starts with a skin analysis and a consultation.'}
        </h2>
        <p class="text-[#7a6e5c] text-[15px] leading-[1.85] max-w-[620px] mx-auto mb-7" {...sbFieldPath('startBody')}>
          {data.startBody ?? 'Every Rose Circle path begins the same way: an AI-assisted skin analysis and a conversation with your provider. From there, we build your treatment plan using the Rose Method — sequencing the right care through each of the four phases below.'}
        </p>
        <a href={SKIN_ANALYSIS_URL} class="btn-outline-gold">Learn About Your Skin Analysis</a>
      </div>
    </section>

    <section class="bg-charcoal py-[clamp(48px,7vw,96px)] px-6 border-t border-gold/10" id="phases">
      <div class="max-w-[1280px] mx-auto">
        <div class="max-w-[760px] mb-12">
          <span class="kicker" {...sbFieldPath('phasesKicker')}>{data.phasesKicker ?? 'The Rose Method'}</span>
          <h2 class="font-serif text-[clamp(24px,4vw,40px)] text-ink mt-2 mb-4" {...sbFieldPath('phasesHeading')}>
            {data.phasesHeading ?? 'Every Rose Circle path moves through the same four phases.'}
          </h2>
          <p class="text-[#9a8c78] text-[15px] leading-[1.75]" {...sbFieldPath('phasesIntro')}>
            {data.phasesIntro ?? 'Your provider decides how much time each phase needs and which treatments belong in it. What stays constant is the order — because skin responds better to sequence than to a menu.'}
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-px bg-gold/15">
          {phases.map((phase, i) => (
            <article class="flex flex-col bg-breath p-8">
              <p class="font-serif text-gold/40 text-[36px] mb-3">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="font-serif text-[26px] text-ink leading-tight mb-4" {...(usingFallbackPhases ? {} : sbFieldPathParts('phases', i, 'name'))}>{phase.name}</h3>
              <p class="text-ink/75 text-[14px] leading-[1.65]" {...(usingFallbackPhases ? {} : sbFieldPathParts('phases', i, 'intent'))}>{phase.intent}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-charcoal-light py-[clamp(48px,7vw,88px)] px-6 border-t border-gold/10">
      <div class="max-w-[1080px] mx-auto grid grid-cols-1 md:grid-cols-[0.9fr_1.1fr] gap-[clamp(32px,5vw,72px)] items-center">
        <div>
          <span class="kicker" {...sbFieldPath('commitmentKicker')}>{data.commitmentKicker ?? 'Why It Takes Time'}</span>
          <h2 class="font-serif text-[clamp(24px,4vw,40px)] text-ink leading-tight mt-2 mb-5" {...sbFieldPath('commitmentHeading')}>
            {data.commitmentHeading ?? 'Real change needs a real timeline.'}
          </h2>
        </div>
        <p class="text-[#9a8c78] text-[15px] leading-[1.85]" {...sbFieldPath('commitmentBody')}>
          {data.commitmentBody ?? 'The Rose Circle is built around a minimum six-month commitment because skin doesn’t finish transforming in a single visit. Six months gives each phase enough room to work, gives your provider room to adjust as your skin responds, and gives you a plan instead of a string of appointments.'}
        </p>
      </div>
    </section>

    <section class="bg-walnut py-[clamp(48px,7vw,88px)] px-6 border-t border-gold/10">
      <div class="max-w-[820px] mx-auto text-center">
        <span class="kicker" {...sbFieldPath('teaserKicker')}>{data.teaserKicker ?? 'Go Deeper'}</span>
        <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ivory mt-2 mb-4" {...sbFieldPath('teaserHeading')}>{data.teaserHeading ?? 'See the full Rose Method, and the plans built on it.'}</h2>
        <p class="text-ivory/70 text-[15px] max-w-[620px] mx-auto mb-8 leading-[1.85]" {...sbFieldPath('teaserBody')}>
          {data.teaserBody ?? 'The four phases above are the spine of every structured plan we offer, from a single-season refresh to a full regenerative journey. If you want to see how they combine into an actual plan, start here.'}
        </p>
        <a href={METHOD_URL} class="btn-outline-white" {...sbFieldPath('teaserCtaText')}>{data.teaserCtaText ?? 'Explore the Rose Method'}</a>
      </div>
    </section>

    <section class="bg-charcoal-light py-[clamp(56px,8vw,96px)] px-6 border-t border-gold/15">
      <div class="max-w-[660px] mx-auto text-center">
        <span class="kicker" {...sbFieldPath('finalKicker')}>{data.finalKicker ?? 'Begin With Evidence'}</span>
        <h2 class="font-serif text-[clamp(26px,4.5vw,42px)] text-ink leading-tight mt-2 mb-5" {...sbFieldPath('finalHeading')}>{data.finalHeading ?? 'Book the scan. Then we build the plan.'}</h2>
        <p class="text-[#7a6e5c] text-[15px] max-w-[500px] mx-auto mb-9 leading-[1.8]" {...sbFieldPath('finalBody')}>
          {data.finalBody ?? 'The Rose Circle can’t be finalized from a public page. We need to see your skin, talk through your goals, and map the phases that make sense for you.'}
        </p>
        <div class="flex gap-3 justify-center flex-wrap">
          <a href={SKIN_ANALYSIS_URL} class="btn-gold" {...sbFieldPath('finalCtaPrimaryText')}>{data.finalCtaPrimaryText ?? 'Book Your Skin Analysis'}</a>
          <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn-outline-gold" {...sbFieldPath('finalCtaSecondaryText')}>{data.finalCtaSecondaryText ?? 'Schedule a Consultation'}</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
