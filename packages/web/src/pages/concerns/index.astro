---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sanityFetch } from '@/lib/sanity';
import { sbObjectId, sbFieldPath } from '@/lib/visualEditing';
import { ALL_CONCERNS_QUERY, type Concern } from '@/lib/queries';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import { breadcrumbList, itemList } from '@/lib/structuredData';
import { alignPublicContent } from '@/lib/publicCopy';
import { getConcernEducation } from '@/lib/concernEducation';

const concerns = alignPublicContent(await sanityFetch<Concern[]>(ALL_CONCERNS_QUERY));
const concernsBySlug = new Map(concerns.map((concern) => [concern.slug, concern]));
const concernCards = concerns.map((concern) => ({
  concern,
  education: getConcernEducation(concern.slug),
}));
const distinctionSpecs = [
  { slug: 'active-acne', relatedSlugs: ['acne-scarring'] },
  { slug: 'dark-circles', relatedSlugs: ['volume-loss'] },
  { slug: 'fine-lines-laxity', relatedSlugs: ['texture', 'volume-loss'] },
] as const;
const distinctions = distinctionSpecs.flatMap(({ slug, relatedSlugs }) => {
  const concern = concernsBySlug.get(slug);
  const education = getConcernEducation(slug);
  if (!concern || !education) return [];

  return [{
    concern,
    heading: education.heading,
    lead: education.lead,
    related: relatedSlugs.flatMap((relatedSlug) => {
      const relatedConcern = concernsBySlug.get(relatedSlug);
      return relatedConcern ? [relatedConcern] : [];
    }),
  }];
});
const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonical = new URL(Astro.url.pathname, site).toString();

const breadcrumb = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'Concern Guides', item: canonical },
]);
const concernsListSchema = concerns.length
  ? itemList(
      concerns.map((c) => ({ name: c.title, url: new URL(`/concerns/${c.slug}/`, site).toString() })),
      'Concern Guides from House of Rose Aesthetics',
    )
  : null;
---

<BaseLayout
  title="Concern Guides | House of Rose Aesthetics"
  description="Compare visible changes in pigment, texture, movement, and volume, then find related House of Rose concern guides and services in Punta Gorda."
>
  <SchemaMarkup item={breadcrumb} slot="head" />
  {concernsListSchema && <SchemaMarkup item={concernsListSchema} slot="head" />}

  <section class="bg-charcoal pt-32 pb-12 px-6">
    <div class="max-w-[1280px] mx-auto">
      <span class="kicker">Concern Guides</span>
      <h1 class="font-serif text-[clamp(30px,5vw,52px)] text-ink leading-tight mt-3 mb-5">Skin changes can look similar without being the same.</h1>
      <p class="text-ink/80 text-[16px] max-w-[760px] leading-relaxed">
        A shadow that stays in every light, a patch of uneven color, texture that catches makeup, and a line that appears with expression can come from pigment, texture, movement, or volume. The guides show how those visible patterns differ before you compare related services.
      </p>
    </div>
  </section>

  <section class="bg-charcoal-light py-14 px-6">
    <div class="max-w-[1280px] mx-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-px bg-gold-metal/10">
      {concernCards.map(({ concern, education }) => (
        <a
          href={`/concerns/${concern.slug}/`}
          class="bg-charcoal p-7 group flex min-h-[250px] flex-col transition-colors hover:bg-charcoal-lighter"
          data-concern-guide-card
          {...sbObjectId(concern._id)}
        >
          <h2 class="font-serif text-[22px] text-ink group-hover:text-gold transition-colors" {...sbFieldPath('title')}>{concern.title}</h2>
          {education && (
            <p class="mt-4 text-[14px] leading-[1.75] text-muted">{education.lead}</p>
          )}
          <span class="learn-more group-hover:text-gold mt-auto pt-7 inline-block">Read the guide</span>
        </a>
      ))}
      {concerns.length === 0 && (
        <p class="bg-charcoal p-7 text-muted text-[14px]">No concern guides are currently available.</p>
      )}
    </div>
  </section>

  {distinctions.length > 0 && (
    <section data-concern-index-guidance class="border-y border-gold-metal/10 bg-charcoal px-6 py-[clamp(48px,7vw,76px)]">
      <div class="mx-auto max-w-[1280px]">
        <div class="mb-10 max-w-[680px]">
          <span class="kicker">Useful distinctions</span>
          <h2 class="mt-2 font-serif text-[clamp(26px,4vw,40px)] leading-tight text-ink">Some concerns overlap in the mirror.</h2>
          <p class="mt-4 text-[15px] leading-[1.8] text-muted">
            These examples show what to notice before opening the related guides. They are observations, not a diagnosis.
          </p>
        </div>
        <div class="grid gap-px bg-gold-metal/10 md:grid-cols-3">
          {distinctions.map(({ concern, heading, lead, related }) => (
            <article class="bg-charcoal-light p-7">
              <h3 class="font-serif text-[22px] leading-snug text-ink">{heading}</h3>
              <p class="mt-4 text-[14px] leading-[1.75] text-muted">{lead}</p>
              <div class="mt-6 flex flex-wrap gap-x-4 gap-y-2">
                <a href={`/concerns/${concern.slug}/`} class="learn-more">{concern.title}</a>
                {related.map((relatedConcern) => (
                  <a href={`/concerns/${relatedConcern.slug}/`} class="learn-more">{relatedConcern.title}</a>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="bg-charcoal py-12 px-6 border-t border-gold-metal/10">
    <div class="max-w-[880px] mx-auto text-center">
      <span class="kicker">A clearer starting point</span>
      <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ink leading-tight mt-2 mb-5">Photographs or a conversation?</h2>
      <p class="text-muted text-[15px] max-w-[620px] mx-auto leading-[1.8]">
        Skin Analysis creates a multi-spectrum visual baseline. A conversation can help separate the treatment options that fit what you are noticing from the ones that do not.
      </p>
      <div class="mt-9 grid gap-px bg-gold-metal/10 text-left md:grid-cols-2">
        <article class="bg-charcoal-light p-7">
          <h3 class="font-serif text-[22px] text-ink">Skin analysis records three views.</h3>
          <p class="mt-4 text-[14px] leading-[1.75] text-muted">
            Standard, cross-polarized, and UV photographs can make visible patterns in pigment, pores, texture, fine lines, and sun exposure easier to examine. The images provide a baseline; they do not diagnose a skin condition.
          </p>
          <a href="/skin-analysis/" class="learn-more mt-6 inline-block">See how skin analysis works</a>
        </article>
        <article class="bg-charcoal-light p-7">
          <h3 class="font-serif text-[22px] text-ink">A conversation can narrow the options.</h3>
          <p class="mt-4 text-[14px] leading-[1.75] text-muted">
            Ask who provides a treatment, what distinguishes it from the alternatives, and what recovery may involve.
          </p>
          <a href="/contact/" class="learn-more mt-6 inline-block">Contact House of Rose</a>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
