---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sanityFetch } from '@/lib/sanity';
import { sbObjectId, sbFieldPath } from '@/lib/visualEditing';
import { ALL_CONCERNS_QUERY, type Concern } from '@/lib/queries';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import { breadcrumbList, itemList } from '@/lib/structuredData';
import { alignPublicContent } from '@/lib/publicCopy';

const concerns = alignPublicContent(await sanityFetch<Concern[]>(ALL_CONCERNS_QUERY));
const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonical = new URL(Astro.url.pathname, site).toString();

const breadcrumb = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'Concern Guides', item: canonical },
]);
const concernsListSchema = concerns.length
  ? itemList(
      concerns.map((c) => ({ name: c.title, url: new URL(`/concerns/${c.slug}/`, site).toString() })),
      'Concern Guides from House of Rose Aesthetics',
    )
  : null;
---

<BaseLayout
  title="Concern Guides | House of Rose Aesthetics"
  description="Choose a skin or aesthetic concern and review the House of Rose services currently associated with it in Punta Gorda, Florida."
>
  <SchemaMarkup item={breadcrumb} slot="head" />
  {concernsListSchema && <SchemaMarkup item={concernsListSchema} slot="head" />}

  <section class="bg-charcoal pt-32 pb-12 px-6">
    <div class="max-w-[1280px] mx-auto">
      <span class="kicker">Concern Guides</span>
      <h1 class="font-serif text-[clamp(30px,5vw,52px)] text-ink leading-tight mt-3 mb-5">Start with what you notice.</h1>
      <p class="text-ink/80 text-[16px] max-w-[660px] leading-relaxed">
        Choose the concern closest to what you see. Each guide shows the House of Rose services currently associated with it.
      </p>
    </div>
  </section>

  <section class="bg-charcoal-light py-14 px-6">
    <div class="max-w-[1280px] mx-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-px bg-gold-metal/10">
      {concerns.map((c) => (
        <a href={`/concerns/${c.slug}/`} class="bg-charcoal p-7 group block transition-colors hover:bg-charcoal-lighter" {...sbObjectId(c._id)}>
          <h2 class="font-serif text-[22px] text-ink mb-2 group-hover:text-gold transition-colors" {...sbFieldPath('title')}>{c.title}</h2>
          <span class="learn-more group-hover:text-gold mt-4 inline-block">View options</span>
        </a>
      ))}
      {concerns.length === 0 && (
        <p class="bg-charcoal p-7 text-muted text-[14px]">No concern guides are currently available.</p>
      )}
    </div>
  </section>

  <section class="bg-charcoal py-12 px-6 border-t border-gold-metal/10">
    <div class="max-w-[680px] mx-auto text-center">
      <span class="kicker">A Different Starting Point</span>
      <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ink leading-tight mt-2 mb-5">Not every concern is easy to name.</h2>
      <p class="text-muted text-[15px] max-w-[460px] mx-auto mb-8 leading-[1.8]">
        If the menu does not make the answer obvious, begin with a skin analysis or consultation.
      </p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="/skin-analysis/" class="btn-outline-gold">Review skin analysis</a>
        <a href="/consultation/" class="btn-gold">Start a consultation</a>
      </div>
    </div>
  </section>
</BaseLayout>
