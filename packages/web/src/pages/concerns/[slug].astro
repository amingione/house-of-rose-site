---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import ConcernEducation from '@/components/concerns/ConcernEducation.astro';
import { sanityFetch } from '@/lib/sanity';
import { sbObjectId, sbFieldPath } from '@/lib/visualEditing';
import { breadcrumbList, itemList } from '@/lib/structuredData';
import {
  ALL_CONCERN_SLUGS_QUERY,
  CONCERN_BY_SLUG_QUERY,
  type Concern,
} from '@/lib/queries';
import { getConcernEducation } from '@/lib/concernEducation';
import { getPublicComparisonContent } from '@/lib/publicComparisonContent';

export async function getStaticPaths() {
  const slugs = await sanityFetch<{ slug: string }[]>(ALL_CONCERN_SLUGS_QUERY);
  return slugs.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const concernData = await sanityFetch<Concern>(CONCERN_BY_SLUG_QUERY, { slug });

// Never `return Astro.redirect()` from a prerendered route — it breaks the static build.
// Slugs come from getStaticPaths, so a miss is a data bug: fail loudly.
if (!concernData) {
  throw new Error(`[concerns/[slug]] No concern found in Sanity for slug "${slug}"`);
}
const concern = concernData;
const concernEducation = slug ? getConcernEducation(slug) : undefined;

const pageTitle = `${concern.title} | House of Rose Aesthetics`;
const pageDescription = concernEducation
  ? concernEducation.metaDescription ?? concernEducation.lead
  : `See the House of Rose Aesthetics services currently associated with ${concern.title.toLowerCase()} in Punta Gorda, Florida.`;

const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonical = new URL(Astro.url.pathname, site).toString();
const breadcrumb = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'Concern Guides', item: `${site}concerns/` },
  { name: concern.title, item: canonical },
]);
const treatmentList = concern.treatments?.length
  ? itemList(
      concern.treatments.map((t) => ({
        name: t.title,
        url: new URL(`/services/${t.slug}/`, site).toString(),
      })),
      `Service options for ${concern.title}`,
    )
  : null;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <SchemaMarkup item={breadcrumb} slot="head" />
  {treatmentList && <SchemaMarkup item={treatmentList} slot="head" />}
  <div {...sbObjectId(concern._id)}>
  <!-- Hero -->
  <section class="bg-charcoal pt-36 pb-12 px-6">
    <div class="max-w-[1280px] mx-auto">
      <a href="/concerns/" class="inline-flex items-center gap-2 text-ink/75 text-[11px] tracking-[0.2em] uppercase mb-4 hover:text-gold transition-colors">
        <span class="text-lg">←</span> All Concern Guides
      </a>
      <span class="block text-[11px] font-medium tracking-[0.26em] uppercase text-gold mb-3">Concern Guide</span>
      <h1 class="font-serif text-[clamp(32px,6vw,56px)] leading-tight font-normal text-ink mb-6" {...sbFieldPath('title')}>
        {concern.title}
      </h1>
    </div>
  </section>

  {concernEducation && <ConcernEducation content={concernEducation} />}

  <!-- Matching treatments -->
  {concern.treatments && concern.treatments.length > 0 && (
    <section class="bg-charcoal-light py-[clamp(48px,7vw,80px)] px-6">
      <div class="max-w-[1280px] mx-auto">
        <span class="kicker">Services</span>
        <h2 class="font-serif text-[clamp(24px,4vw,36px)] text-ink mt-2 mb-10">
          Related to {concern.title.toLowerCase()}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-px bg-gold-metal/10">
          {concern.treatments.map((t) => (
            <ServiceCard
              title={t.title}
              slug={t.slug}
              image={t.image}
              bookingMode={t.bookingMode}
              bookingUrl={t.bookingUrl}
              objectId={t._id}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {concern.comparisons && concern.comparisons.length > 0 && (
    <section class="bg-charcoal px-6 py-[clamp(44px,6vw,68px)] border-t border-gold-metal/10">
      <div class="mx-auto max-w-[960px]">
        <span class="kicker">Compare</span>
        <h2 class="mt-2 font-serif text-[clamp(24px,4vw,36px)] text-ink">Related comparisons</h2>
        <ul class="mt-8 divide-y divide-gold-metal/10 border-y border-gold-metal/10">
          {concern.comparisons.map((comparison) => (
            <li {...sbObjectId(comparison._id)}>
              <a
                href={`/compare/${comparison.slug}/`}
                class="group flex items-center justify-between gap-6 py-5"
              >
                <span class="font-serif text-[clamp(19px,3vw,25px)] text-ink group-hover:text-gold">
                  {getPublicComparisonContent(comparison.slug)!.title}
                </span>
                <span class="shrink-0 text-gold" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="border-t border-gold-metal/10 bg-charcoal-light px-6 py-[clamp(48px,6vw,68px)]">
    <div class="mx-auto max-w-[760px] text-center">
      <span class="kicker">Questions</span>
      <h2 data-concern-consultation-heading class="mt-3 font-serif text-[clamp(26px,4vw,38px)] leading-tight text-ink">
        {concernEducation?.consultationHeading ?? `Ask about ${concern.title.toLowerCase()}.`}
      </h2>
      <p data-concern-consultation-prompt class="mx-auto mt-5 max-w-[590px] text-[15px] leading-[1.75] text-muted">
        {concernEducation?.consultationPrompt ?? `Call the practice, or send an inquiry about ${concern.title.toLowerCase()}.`}
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/consultation/" class="btn-gold">Send an inquiry</a>
        <a href="tel:+18449417673" class="btn-outline-gold">Call (844) 941-7673</a>
      </div>
    </div>
  </section>

  </div>
</BaseLayout>
