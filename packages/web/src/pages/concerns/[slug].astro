---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sanityFetch, urlFor } from '@/lib/sanity';
import {
  ALL_CONCERN_SLUGS_QUERY,
  CONCERN_BY_SLUG_QUERY,
  type Concern,
} from '@/lib/queries';

export async function getStaticPaths() {
  const slugs = await sanityFetch<{ slug: string }[]>(ALL_CONCERN_SLUGS_QUERY);
  return slugs.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const concern = await sanityFetch<Concern>(CONCERN_BY_SLUG_QUERY, { slug });

if (!concern) {
  return Astro.redirect('/services', 307);
}

const pageTitle = concern.seo?.metaTitle ?? `${concern.title} Treatments in Punta Gorda, FL | House of Rose`;
const pageDescription = concern.seo?.metaDescription ?? concern.intro ?? '';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Hero -->
  <section class="bg-charcoal pt-36 pb-12 px-6">
    <div class="max-w-[1280px] mx-auto">
      <a href="/services" class="inline-flex items-center gap-2 text-ink/75 text-[11px] tracking-[0.2em] uppercase mb-4 hover:text-gold transition-colors">
        <span class="text-lg">←</span> All Services
      </a>
      <span class="block text-[10px] tracking-[0.4em] uppercase text-gold mb-3">What We Treat</span>
      <h1 class="font-serif text-[clamp(32px,6vw,56px)] leading-tight font-normal text-ink mb-6">
        {concern.title}
      </h1>
      {concern.intro && (
        <p class="text-[#999] text-[15px] leading-[1.8] max-w-[680px]">{concern.intro}</p>
      )}
    </div>
  </section>

  <!-- Matching treatments -->
  {concern.treatments && concern.treatments.length > 0 && (
    <section class="bg-charcoal-light py-[clamp(48px,7vw,80px)] px-6">
      <div class="max-w-[1280px] mx-auto">
        <span class="kicker">Your Options</span>
        <h2 class="font-serif text-[clamp(24px,4vw,36px)] text-ink mt-2 mb-10">
          Treatments for {concern.title.toLowerCase()}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-px bg-gold/10">
          {concern.treatments.map((t) => (
            <a href={`/services/${t.slug}`} class="bg-charcoal p-7 group block transition-colors hover:bg-charcoal-lighter">
              {t.image && (
                <div class="aspect-[4/3] overflow-hidden bg-charcoal-lighter mb-5">
                  <img
                    src={urlFor(t.image).width(560).height(420).fit('crop').url()}
                    alt={t.image.alt ?? t.title}
                    width={560}
                    height={420}
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                </div>
              )}
              <h3 class="font-serif text-[20px] text-ink mb-2 group-hover:text-gold transition-colors">{t.title}</h3>
              {t.tagline && <p class="text-[#777] text-[13px] leading-[1.6] mb-4">{t.tagline}</p>}
              <p class="text-ink/70 text-[12px] tracking-[0.16em] uppercase">
                {t.price}{t.price && t.duration && <span class="text-gold mx-2">·</span>}{t.duration}
              </p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="bg-charcoal py-[clamp(56px,8vw,88px)] px-6 border-t border-gold/10">
    <div class="max-w-[680px] mx-auto text-center">
      <span class="kicker">Not Sure Which Is Right?</span>
      <h2 class="font-serif text-[clamp(26px,4.5vw,40px)] text-ink leading-tight mt-2 mb-5">
        Start with a consultation.
      </h2>
      <p class="text-[#9a8c78] text-[15px] max-w-[460px] mx-auto mb-9 leading-[1.8]">
        Every concern has more than one path — we will map yours at a private consultation.
      </p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="tel:+18449417673" class="btn-outline-gold">(844) 941-7673</a>
        <a href="https://houseofrose.glossgenius.com/services" target="_blank" rel="noopener noreferrer" class="btn-gold">Book Online</a>
      </div>
    </div>
  </section>
</BaseLayout>
