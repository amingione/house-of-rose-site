---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import { sanityFetch } from '@/lib/sanity';
import { sbObjectId, sbFieldPath } from '@/lib/visualEditing';
import { breadcrumbList, itemList } from '@/lib/structuredData';
import {
  ALL_CONCERN_SLUGS_QUERY,
  CONCERN_BY_SLUG_QUERY,
  type Concern,
} from '@/lib/queries';
import { alignPublicContent } from '@/lib/publicCopy';

export async function getStaticPaths() {
  const slugs = await sanityFetch<{ slug: string }[]>(ALL_CONCERN_SLUGS_QUERY);
  return slugs.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const concernData = await sanityFetch<Concern>(CONCERN_BY_SLUG_QUERY, { slug });

// Never `return Astro.redirect()` from a prerendered route — it breaks the static build.
// Slugs come from getStaticPaths, so a miss is a data bug: fail loudly.
if (!concernData) {
  throw new Error(`[concerns/[slug]] No concern found in Sanity for slug "${slug}"`);
}
const concern = alignPublicContent(concernData);

const pageTitle = concern.seo?.metaTitle ?? `${concern.title} Treatments in Punta Gorda, FL | House of Rose`;
const pageDescription = concern.seo?.metaDescription ?? concern.intro ?? '';

const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonical = new URL(Astro.url.pathname, site).toString();
const breadcrumb = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'Services', item: `${site}services/` },
  { name: concern.title, item: canonical },
]);
const treatmentList = concern.treatments?.length
  ? itemList(
      concern.treatments.map((t) => ({
        name: t.title,
        url: new URL(`/services/${t.slug}/`, site).toString(),
      })),
      `Treatments for ${concern.title}`,
    )
  : null;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <SchemaMarkup item={breadcrumb} slot="head" />
  {treatmentList && <SchemaMarkup item={treatmentList} slot="head" />}
  <div {...sbObjectId(concern._id)}>
  <!-- Hero -->
  <section class="bg-charcoal pt-36 pb-12 px-6">
    <div class="max-w-[1280px] mx-auto">
      <a href="/services/" class="inline-flex items-center gap-2 text-ink/75 text-[11px] tracking-[0.2em] uppercase mb-4 hover:text-gold transition-colors">
        <span class="text-lg">←</span> All Services
      </a>
      <span class="block text-[11px] font-medium tracking-[0.26em] uppercase text-gold mb-3">What We Treat</span>
      <h1 class="font-serif text-[clamp(32px,6vw,56px)] leading-tight font-normal text-ink mb-6" {...sbFieldPath('title')}>
        {concern.title}
      </h1>
      {concern.intro && (
        <p class="text-muted text-[15px] leading-[1.8] max-w-[680px]" {...sbFieldPath('intro')}>{concern.intro}</p>
      )}
    </div>
  </section>

  <!-- Matching treatments -->
  {concern.treatments && concern.treatments.length > 0 && (
    <section class="bg-charcoal-light py-[clamp(48px,7vw,80px)] px-6">
      <div class="max-w-[1280px] mx-auto">
        <span class="kicker">Your Options</span>
        <h2 class="font-serif text-[clamp(24px,4vw,36px)] text-ink mt-2 mb-10">
          Treatments for {concern.title.toLowerCase()}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-px bg-gold-metal/10">
          {concern.treatments.map((t) => (
            <ServiceCard
              title={t.title}
              slug={t.slug}
              tagline={t.tagline}
              image={t.image}
              bookingMode={t.bookingMode}
              bookingUrl={t.bookingUrl}
              objectId={t._id}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="bg-charcoal py-[clamp(56px,8vw,88px)] px-6 border-t border-gold-metal/10">
    <div class="max-w-[680px] mx-auto text-center">
      <span class="kicker">Not Sure Which Is Right?</span>
      <h2 class="font-serif text-[clamp(26px,4.5vw,40px)] text-ink leading-tight mt-2 mb-5">
        Start with a consultation.
      </h2>
      <p class="text-muted text-[15px] max-w-[460px] mx-auto mb-9 leading-[1.8]">
        More than one service may be considered. A consultation can help narrow the options around your goals, timing, and candidacy.
      </p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="tel:+18449417673" class="btn-outline-gold">(844) 941-7673</a>
        <a href="/consultation/" class="btn-gold">Start a consultation</a>
      </div>
    </div>
  </section>
  </div>
</BaseLayout>
