---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';

const BOOKING_URL = 'https://houseofrose.glossgenius.com/services';
const SKIN_ANALYSIS_URL = '/skin-analysis';
const MEMBERSHIPS_URL = '/memberships';

interface Phase {
  step: string;
  name: string;
  description: string;
}

interface MethodStep {
  label: string;
  heading: string;
  body: string;
}

const phases: Phase[] = [
  {
    step: '01',
    name: 'Analyze',
    description: 'AI-assisted imaging creates the baseline, then your provider examines your skin and goals in person.',
  },
  {
    step: '02',
    name: 'Prepare',
    description: 'Barrier, home care, hydration, and timing are considered before advanced treatments are layered in.',
  },
  {
    step: '03',
    name: 'Correct',
    description: 'Your provider sequences the right services for your skin, from advanced facials to regenerative options when appropriate.',
  },
  {
    step: '04',
    name: 'Track',
    description: 'Progress scans and provider check-ins guide adjustments across the full 6-month plan.',
  },
];

const methodSteps: MethodStep[] = [
  {
    label: 'The baseline',
    heading: 'We start with what your skin is actually showing.',
    body: 'The AI skin scanner helps document visible concerns such as texture, pores, pigmentation, hydration cues, and fine lines before a plan is built.',
  },
  {
    label: 'The evaluation',
    heading: 'A provider confirms what the scan cannot decide alone.',
    body: 'Your skin history, lifestyle, candidacy, tolerance, budget rhythm, and goals all shape the plan. The scan informs the work; it does not replace provider judgment.',
  },
  {
    label: 'The timeline',
    heading: 'Six months gives real change time to happen.',
    body: 'Healthy visible change does not happen overnight. The Rose Method is built around a 6-month minimum because skin needs time, consistency, and intelligent adjustment.',
  },
];
---

<BaseLayout
  title="The Rose Method in Punta Gorda, FL | House of Rose Aesthetics"
  description="The Rose Method is the science-led process behind custom House of Rose skin plans: AI skin analysis, provider evaluation, phased care, progress tracking, and a 6-month guided timeline."
  preloadImage="/images/hor-lobby.jpg"
>
  <Hero
    title="The Rose Method"
    kicker="Science-Led Skin Planning"
    description="The Rose Method is the process behind true custom skin change at House of Rose: AI skin analysis, provider examination, phased care, and progress tracking over time. We are not selling gimmicks or preset public packages. We are building working plans around your skin."
    size="small"
    showCTA={true}
    ctaPrimary={{ text: 'Book Your Skin Analysis', href: SKIN_ANALYSIS_URL }}
    ctaSecondary={{ text: 'Schedule a Consultation', href: BOOKING_URL }}
    backgroundImage="/images/hor-lobby.jpg"
  />

  <section class="bg-charcoal py-[clamp(48px,7vw,88px)] px-6">
    <div class="max-w-[1280px] mx-auto">
      <div class="max-w-[740px] mb-12">
        <span class="kicker">The Method</span>
        <h2 class="font-serif text-[clamp(24px,3.6vw,40px)] text-ink leading-tight mt-2 mb-4">
          Not a treatment menu. A clinical rhythm for change.
        </h2>
        <p class="text-[#9a8c78] text-[15px] leading-[1.75]">
          The Rose Method is how we decide what your skin needs, when it needs it, and how to track whether the plan is working. Every recommendation starts with analysis and provider evaluation because the right path cannot be chosen from a public preset.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px bg-gold/10">
        {phases.map((phase) => (
          <div class="bg-charcoal p-8">
            <span class="text-gold text-[12px] tracking-[0.22em] uppercase">{phase.step}</span>
            <h3 class="font-serif text-[22px] text-ink mt-3 mb-2">{phase.name}</h3>
            <p class="text-[#9a8c78] text-[14px] leading-[1.6]">{phase.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-charcoal-light py-[clamp(48px,7vw,96px)] px-6 border-t border-gold/10">
    <div class="max-w-[1080px] mx-auto grid grid-cols-1 lg:grid-cols-[0.9fr_1.1fr] gap-[clamp(36px,6vw,84px)] items-start">
      <div>
        <span class="kicker">Why Six Months</span>
        <h2 class="font-serif text-[clamp(25px,4vw,42px)] text-ink leading-tight mt-2 mb-5">
          Results do not happen overnight, and we are not building overnight promises.
        </h2>
        <p class="text-[#7a6e5c] text-[15px] leading-[1.85]">
          A 6-month minimum commitment gives the plan enough time to work: time for the skin barrier to respond, for corrective treatments to be sequenced safely, for home care to become consistent, and for progress to be measured instead of guessed.
        </p>
      </div>
      <div class="grid gap-px bg-gold/10">
        {methodSteps.map((item) => (
          <article class="bg-breath p-[clamp(24px,4vw,38px)]">
            <span class="text-gold text-[11px] tracking-[0.24em] uppercase">{item.label}</span>
            <h3 class="font-serif text-[24px] text-ink leading-tight mt-3 mb-3">{item.heading}</h3>
            <p class="text-[#5f5446] text-[14px] leading-[1.7]">{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-charcoal py-[clamp(48px,7vw,96px)] px-6 border-t border-gold/10">
    <div class="max-w-[960px] mx-auto text-center">
      <span class="kicker">Before We Recommend</span>
      <h2 class="font-serif text-[clamp(25px,4vw,42px)] text-ink leading-tight mt-2 mb-5">
        Your plan is built after skin analysis and provider evaluation.
      </h2>
      <p class="text-[#9a8c78] text-[15px] leading-[1.85] max-w-[720px] mx-auto mb-8">
        Renewal, regeneration, and restoration frameworks may help our providers think internally, but they are not public plans to choose from. The public promise is simpler and more honest: we examine your skin, map the right path, and guide you through it at the right pace.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href={SKIN_ANALYSIS_URL} class="btn-gold">Book Your Skin Analysis</a>
        <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn-outline-gold">Schedule a Consultation</a>
      </div>
    </div>
  </section>

  <section class="bg-charcoal-light py-[clamp(48px,7vw,88px)] px-6 border-t border-gold/10">
    <div class="max-w-[1080px] mx-auto grid grid-cols-1 md:grid-cols-[1fr_0.9fr] gap-[clamp(32px,5vw,72px)] items-center">
      <div>
        <span class="kicker">The Rose Circle</span>
        <h2 class="font-serif text-[clamp(25px,4vw,42px)] text-ink leading-tight mt-2 mb-5">
          The Rose Circle applies the method month by month.
        </h2>
        <p class="text-[#7a6e5c] text-[15px] leading-[1.85]">
          The Rose Circle is the guided 6-month membership path for clients who want the Rose Method applied consistently at member rates. Nothing is selected from a preset public package; the provider lane, services, cadence, and adjustments are built around the client after analysis.
        </p>
      </div>
      <div class="bg-charcoal p-[clamp(28px,5vw,44px)] border border-gold/10">
        <p class="text-gold text-[11px] tracking-[0.24em] uppercase mb-4">Member Path</p>
        <p class="font-serif text-[28px] text-ink leading-tight mb-5">Analysis, plan, commitment, progress.</p>
        <p class="text-[#9a8c78] text-[14px] leading-[1.7] mb-7">
          Rose Circle members receive provider-guided care, member-rate services, and AI skin scan comparisons throughout the plan.
        </p>
        <a href={MEMBERSHIPS_URL} class="btn-outline-gold w-full text-center">View The Rose Circle</a>
      </div>
    </div>
  </section>

  <section class="bg-charcoal py-[clamp(56px,8vw,96px)] px-6 border-t border-gold/10">
    <div class="max-w-[640px] mx-auto text-center">
      <span class="kicker">Begin</span>
      <h2 class="font-serif text-[clamp(26px,4.5vw,42px)] text-ink leading-tight mt-2 mb-5">
        Start with your skin.
      </h2>
      <p class="text-[#9a8c78] text-[15px] max-w-[460px] mx-auto mb-9 leading-[1.8]">
        The next step is not choosing a plan. It is letting us see what your skin needs and building from there.
      </p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href={SKIN_ANALYSIS_URL} class="btn-gold">Book Your Skin Analysis</a>
        <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn-outline-gold">Schedule a Consultation</a>
      </div>
    </div>
  </section>
</BaseLayout>
