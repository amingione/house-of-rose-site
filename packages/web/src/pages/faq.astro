---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import { breadcrumbList, faqPage } from '@/lib/structuredData';

interface FaqLink {
  readonly href: string;
  readonly label: string;
  readonly external?: boolean;
  readonly globalBooking?: boolean;
}

interface PublicFaq {
  readonly question: string;
  readonly answer: string;
  readonly links?: readonly FaqLink[];
}

// Temporary local reset layer. Published CMS FAQs remain suppressed until their
// claims and voice have been reviewed at the source.
const faqs: readonly PublicFaq[] = [
  {
    question: 'What is House of Rose Aesthetics?',
    answer: 'House of Rose Aesthetics is a medical aesthetics practice in Punta Gorda, Florida.',
  },
  {
    question: 'Where is House of Rose located?',
    answer: 'House of Rose has one practice location: 525 E Olympia Ave, Unit 9, Punta Gorda, FL 33950. The storefront and treatment rooms shown on this website are the actual spaces.',
  },
  {
    question: 'What services are offered?',
    answer: 'Services include skin treatments, injectables, body treatments, IV hydration, GLP-1 weight management, facial waxing, and professional home care.',
  },
  {
    question: 'How do I choose a service?',
    answer: 'Start with the change you notice rather than a product name. The concern guides explain common distinctions, and each treatment page shows what that service is designed to address and how it differs from nearby options.',
  },
  {
    question: 'What if I am comparing more than one treatment?',
    answer: 'Use the comparison pages when two treatments address similar-looking concerns in different ways. If the distinction is still unclear, contact House of Rose and describe what you notice, what you want to change, and how much recovery fits your schedule.',
  },
  {
    question: 'What is the difference between skin analysis and a consultation?',
    answer: 'Skin analysis uses multi-spectrum photographs to make visible patterns easier to examine and create a visual baseline; it is not a medical diagnosis. A consultation is a conversation about a treatment, a concern, or a short list of options, including questions about the provider, price, timing, and recovery. Choose skin analysis when the photographs would help you see the skin more clearly. Choose a consultation when the main need is to talk through options.',
    links: [
      { href: '/skin-analysis/', label: 'See skin analysis' },
      { href: '/consultation/', label: 'See consultation' },
    ],
  },
  {
    question: 'How can I tell who provides a service?',
    answer: 'Diana Morrison, RN provides Botox and Daxxify, dermal fillers, injectable PRF and PRF Bio-Filler, IV hydration, and GLP-1 weight management. Amber Mingione, Licensed Esthetician provides Procell Microneedling, topical PRF, Glo2Facial, dermaplaning, and BioRePeel as an add-on. Brandy, Licensed Esthetician provides facials, BioRePeel, and facial waxing. Aundrea Pedigo, Licensed Esthetician provides bridal, event, and everyday makeup; makeup artistry is a non-medical service. Medical Director: Joshua Shaw, MD · FL Lic. ME136232. Dr. Shaw provides medical direction and does not perform treatments at House of Rose.',
  },
  {
    question: 'What is the medical director’s role?',
    answer: 'Joshua Shaw, MD provides medical direction and protocol supervision. He does not perform treatments at House of Rose. The practitioner named for a treatment is the person who provides it.',
  },
  {
    question: 'How can I ask about current pricing?',
    answer: 'Call House of Rose at (941) 400-0165 or send a message with the treatment name. Service pricing is not published on this website.',
    links: [{ href: '/contact/', label: 'Contact House of Rose' }],
  },
  {
    question: 'What payment methods does House of Rose accept?',
    answer: 'House of Rose accepts American Express, Discover, Mastercard, Visa, debit cards, and checks.',
  },
  {
    question: 'Do you accept walk-ins?',
    answer: 'Yes. Walk-ins are always accepted for waxing and facials. For other services, walk-ins are accepted when the schedule allows. Appointments reserve a specific time; call (941) 400-0165 to check current availability.',
  },
];
const faqGroups = [
  {
    kicker: 'The practice',
    heading: 'Location and people',
    questions: [faqs[0], faqs[1], faqs[6], faqs[7]],
  },
  {
    kicker: 'Treatments',
    heading: 'Choosing where to begin',
    questions: [faqs[2], faqs[3], faqs[4], faqs[5], faqs[8], faqs[9], faqs[10]],
  },
] as const;
const orderedFaqs = faqGroups.flatMap((group) => group.questions);
const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonical = new URL(Astro.url.pathname, site).toString();

const faq = faqPage(orderedFaqs);
const breadcrumb = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'FAQ', item: canonical },
]);

---

<BaseLayout
  title="Frequently Asked Questions | House of Rose Aesthetics"
  description="Answers to common questions about treatments, pricing, and visits at House of Rose Aesthetics in Punta Gorda, FL."
>
  {faq && <SchemaMarkup item={faq} slot="head" />}
  <SchemaMarkup item={breadcrumb} slot="head" />

  <section class="bg-charcoal pt-32 pb-12 px-6">
    <div class="max-w-[860px] mx-auto">
      <span class="kicker">Answers</span>
      <h1 class="font-serif text-[clamp(30px,5vw,52px)] text-ink leading-tight mt-3 mb-5">Frequently asked questions</h1>
      <p class="text-ink/80 text-[16px] leading-relaxed">Direct answers about the practice, treatment choices, providers, and visiting House of Rose.</p>
    </div>
  </section>

  <section class="bg-charcoal-light py-14 px-6">
    <div class="max-w-[860px] mx-auto space-y-16">
      {faqGroups.map((group) => (
        <div>
          <div class="mb-6 border-b border-gold-metal/15 pb-3">
            <span class="kicker">{group.kicker}</span>
            <h2 class="font-serif text-[clamp(24px,4vw,34px)] text-gold mt-2">{group.heading}</h2>
          </div>
          <div class="space-y-5">
            {group.questions.map((f) => (
              <div class="border-b border-ink/5 pb-5">
                <h3 data-visit-faq-question class="text-ink text-[16px] font-medium mb-2">{f.question}</h3>
                <p data-visit-faq-answer class="text-muted text-[14px] leading-relaxed">{f.answer}</p>
                {f.links && (
                  <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
                    {f.links.map((link) => (
                      <a
                        href={link.href}
                        target={link.external ? '_blank' : undefined}
                        rel={link.external ? 'noopener noreferrer' : undefined}
                        data-global-booking={link.globalBooking ? '' : undefined}
                        class="learn-more"
                      >
                        {link.label}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-charcoal py-12 px-6 border-t border-gold-metal/10">
    <div class="max-w-[860px] mx-auto text-center">
      <span class="kicker">The question you still have</span>
      <h2 class="mt-2 font-serif text-[clamp(24px,4vw,38px)] text-ink leading-tight">Call, send a message, or request a consultation.</h2>
      <p class="mx-auto mt-5 max-w-[660px] text-[15px] leading-[1.8] text-muted">
        Call for an answer during practice hours, or send a message with a non-urgent question about a concern, treatment, or provider.
      </p>
      <div class="mt-8 flex gap-3 justify-center flex-wrap">
        <a href="tel:+19414000165" class="btn-outline-gold">Call House of Rose</a>
        <a href="/contact/" class="btn-outline-gold">Send a message</a>
        <a href="/services/" class="btn-gold">Explore treatments</a>
      </div>
    </div>
  </section>
</BaseLayout>
