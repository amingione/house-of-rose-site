---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sanityFetch } from '@/lib/sanity';
import { sbObjectId, sbFieldPath, sbFieldPathParts } from '@/lib/visualEditing';
import {
  AI_SEARCH_FAQ_QUERY,
  FAQ_AGGREGATE_QUERY,
  type AiSearchFaqSection,
  type FaqGroup,
  type FAQ,
} from '@/lib/queries';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import { breadcrumbList, faqPage } from '@/lib/structuredData';

const [aiSearchFaq, groups] = await Promise.all([
  sanityFetch<AiSearchFaqSection | null>(AI_SEARCH_FAQ_QUERY),
  sanityFetch<FaqGroup[]>(FAQ_AGGREGATE_QUERY),
]);
const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonical = new URL(Astro.url.pathname, site).toString();

// Flatten every FAQ across content into one FAQPage schema.
const aiSearchFaqs = aiSearchFaq?.faqs ?? [];
const allFaqs: FAQ[] = [...aiSearchFaqs, ...groups.flatMap((g) => g.faqs ?? [])];
const faq = faqPage(allFaqs);
const breadcrumb = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'FAQ', item: canonical },
]);

const routeFor = (g: FaqGroup): string => {
  switch (g.type) {
    case 'costGuide': return `/cost/${g.slug}/`;
    case 'comparison': return `/compare/${g.slug}/`;
    case 'localArea': return `/areas/${g.slug}/`;
    default: return `/services/${g.slug}/`;
  }
};
---

<BaseLayout
  title="Frequently Asked Questions | House of Rose Aesthetics"
  description="Answers to common questions about treatments, pricing, and visits at House of Rose Aesthetics in Punta Gorda, FL."
>
  {faq && <SchemaMarkup item={faq} slot="head" />}
  <SchemaMarkup item={breadcrumb} slot="head" />

  <section class="bg-charcoal pt-32 pb-12 px-6">
    <div class="max-w-[860px] mx-auto">
      <span class="kicker">Answers</span>
      <h1 class="font-serif text-[clamp(30px,5vw,52px)] text-ink leading-tight mt-3 mb-5">Frequently asked questions</h1>
      <p class="text-ink/80 text-[16px] leading-relaxed">Everything clients ask about treatments, pricing, and what to expect.</p>
    </div>
  </section>

  <section class="bg-charcoal-light py-14 px-6">
    <div class="max-w-[860px] mx-auto space-y-12">
      {aiSearchFaq && aiSearchFaqs.length > 0 && (
        <div {...sbObjectId(aiSearchFaq._id)}>
          <div class="mb-6 border-b border-gold-metal/15 pb-3">
            <span class="kicker">House of Rose at a glance</span>
            <h2 class="font-serif text-[clamp(24px,4vw,34px)] text-gold mt-2" {...sbFieldPath('aiSearchFaqHeading')}>
              {aiSearchFaq.heading ?? 'AI Search FAQ'}
            </h2>
            {aiSearchFaq.intro && (
              <p class="text-muted text-[14px] leading-relaxed mt-3 max-w-[720px]" {...sbFieldPath('aiSearchFaqIntro')}>
                {aiSearchFaq.intro}
              </p>
            )}
          </div>
          <div class="space-y-5">
            {aiSearchFaqs.map((f, i) => (
              <div class="border-b border-ink/5 pb-5">
                <h3 class="text-ink text-[16px] font-medium mb-2" {...sbFieldPathParts('aiSearchFaqs', i, 'question')}>{f.question}</h3>
                <p class="text-muted text-[14px] leading-relaxed" {...sbFieldPathParts('aiSearchFaqs', i, 'answer')}>{f.answer}</p>
              </div>
            ))}
          </div>
        </div>
      )}
      {groups.map((g) => (
        <div {...sbObjectId(g._id)}>
          <div class="flex items-baseline justify-between mb-6 border-b border-gold-metal/15 pb-3">
            <h2 class="font-serif text-[22px] text-gold" {...sbFieldPath('title')}>{g.source}</h2>
            <a href={routeFor(g)} class="learn-more">View page →</a>
          </div>
          <div class="space-y-5">
            {(g.faqs ?? []).map((f, i) => (
              <div class="border-b border-ink/5 pb-5">
                <h3 class="text-ink text-[16px] font-medium mb-2" {...sbFieldPathParts('faqs', i, 'question')}>{f.question}</h3>
                <p class="text-muted text-[14px] leading-relaxed" {...sbFieldPathParts('faqs', i, 'answer')}>{f.answer}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
      {aiSearchFaqs.length === 0 && groups.length === 0 && (
        <p class="text-muted text-[14px]">FAQs will appear here as content is added.</p>
      )}
    </div>
  </section>

  <section class="bg-charcoal py-12 px-6 border-t border-gold-metal/10">
    <div class="max-w-[860px] mx-auto text-center">
      <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ink leading-tight mb-6">Still have a question?</h2>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="tel:+18449417673" class="btn-outline-gold">(844) 941-7673</a>
        <a href="https://houseofrose.glossgenius.com/services" target="_blank" rel="noopener noreferrer" class="btn-gold">Book a Consult</a>
      </div>
    </div>
  </section>
</BaseLayout>
