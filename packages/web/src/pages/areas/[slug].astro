---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sanityFetch, urlFor } from '@/lib/sanity';
import { sbObjectId, sbFieldPath } from '@/lib/visualEditing';
import {
  ALL_LOCAL_AREA_SLUGS_QUERY,
  LOCAL_AREA_BY_SLUG_QUERY,
  SITE_SETTINGS_QUERY,
  type LocalArea,
  type SiteSettings,
} from '@/lib/queries';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import {
  breadcrumbList,
  faqPage,
  localBusiness,
  structuredTelephone,
} from '@/lib/structuredData';
import { DEFAULT_AREA_IMAGE } from '@/lib/imageFallbacks';
import { SEO_TITLE_LIMIT } from '@/lib/seo';
import { resolvePublicSiteFacts } from '@/lib/publicSiteFacts';
import { getLocalAreaServiceSlugs, getPublicServiceRefs } from '@/lib/serviceCatalog';
import { getAreaHeroBanner } from '@/lib/heroBanners';

export async function getStaticPaths() {
  const slugs = await sanityFetch<{ slug: string }[]>(ALL_LOCAL_AREA_SLUGS_QUERY);
  return slugs.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const [areaData, settings] = await Promise.all([
  sanityFetch<LocalArea>(LOCAL_AREA_BY_SLUG_QUERY, { slug }),
  sanityFetch<SiteSettings | null>(SITE_SETTINGS_QUERY),
]);
// Never `return Astro.redirect()` from a prerendered route (breaks the static build). Slugs
// come from getStaticPaths, so a miss is a data bug — fail loudly.
if (!areaData) throw new Error(`[areas/[slug]] No local area found in Sanity for slug "${slug}"`);

const area: LocalArea = {
  ...areaData,
  servedServices: getPublicServiceRefs(
    areaData.servedServiceSlugs ?? getLocalAreaServiceSlugs(areaData.slug),
  ),
};
const siteFacts = resolvePublicSiteFacts(settings);
const phoneHref = `tel:${structuredTelephone(siteFacts)}`;

const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonical = new URL(Astro.url.pathname, site).toString();
const heroBanner = getAreaHeroBanner(areaData.slug);
const heroImage = area.image
  ? urlFor(area.image).width(1400).height(778).fit('crop').format('webp').quality(82).url()
  : DEFAULT_AREA_IMAGE;
const heroImageSrcset = area.image
  ? `${urlFor(area.image).width(800).height(444).fit('crop').format('webp').quality(82).url()} 800w, ${heroImage} 1400w`
  : undefined;
const socialImage = area.image
  ? urlFor(area.image).width(1200).height(630).fit('crop').format('webp').quality(82).url()
  : DEFAULT_AREA_IMAGE;
const socialImageWidth = area.image ? 1200 : 1000;
const socialImageHeight = area.image ? 630 : 1333;
const heroImageWidth = area.image ? 1400 : 1000;
const heroImageHeight = area.image ? 778 : 1333;
const heroImageAlt = area.image?.alt?.trim()
  || (area.image
    ? 'House of Rose Aesthetics in Punta Gorda, Florida'
    : 'House of Rose Aesthetics storefront at 525 E Olympia Avenue in Punta Gorda');
const practiceAddress = siteFacts.address;
const isPuntaGorda = area.city.toLowerCase() === 'punta gorda';
const localHeading = isPuntaGorda
  ? 'Medical aesthetics in Punta Gorda.'
  : `Medical aesthetics near ${area.city}.`;
const localIntro = isPuntaGorda
  ? `${siteFacts.siteName} is a medical aesthetics practice located at ${practiceAddress}.`
  : `${siteFacts.siteName} serves ${area.city} from its practice at ${practiceAddress}.`;
const localFaqs = [
  {
    question: isPuntaGorda
      ? `Is this the ${siteFacts.shortName} practice location?`
      : `Is there a ${siteFacts.shortName} location in ${area.city}?`,
    answer: isPuntaGorda
      ? `Yes. This is our one ${siteFacts.shortName} practice at ${practiceAddress}. Look for the House of Rose Aesthetics sign at Unit 9.`
      : `No. ${siteFacts.shortName} has one practice, at ${practiceAddress}. Clients coming from ${area.city} visit the Punta Gorda location.`,
  },
  {
    question: 'How can I contact the practice before traveling?',
    answer: `Call ${siteFacts.phone} with questions about a treatment, the location, or current availability.`,
  },
  {
    question: 'Is parking available?',
    answer: 'Yes. Free parking is available at the Punta Gorda practice.',
  },
  {
    question: 'Where can I get directions from my starting address?',
    answer: `The practice is at ${practiceAddress}. The directions tool accepts a starting address or your current location, shows estimated driving time and distance, and can open the route in Google Maps or Apple Maps.`,
  },
];

const breadcrumb = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'Areas We Serve', item: `${site}areas/` },
  { name: area.city, item: canonical },
]);
const business = localBusiness({
  url: canonical,
  areaName: `${area.city}, ${area.region ?? 'FL'}`,
  image: socialImage,
  siteFacts,
});
const faq = faqPage(localFaqs);

// `Near <City>, FL` overflows the SERP budget for the longest community names, and the
// shared formatter would truncate mid-name ("Burnt Store…"). The state is already carried
// by the region kicker, the description, and the LocalBusiness JSON-LD, so drop it from the
// title only on the pages where the full form will not fit.
const nearTitleWithState = `Medical Aesthetics Near ${area.city}, FL | ${siteFacts.shortName}`;
const pageTitle = isPuntaGorda
  ? `Medical Aesthetics in Punta Gorda, FL | ${siteFacts.shortName}`
  : nearTitleWithState.length <= SEO_TITLE_LIMIT
    ? nearTitleWithState
    : `Medical Aesthetics Near ${area.city} | ${siteFacts.shortName}`;
const pageDescription = localIntro;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={socialImage}
  imageAlt={heroImageAlt}
  imageWidth={socialImageWidth}
  imageHeight={socialImageHeight}
  preloadImage={heroBanner.src}
  preloadImageSizes="100vw"
  structuredPageMainEntityId={`${canonical}#localbusiness`}
>
  <SchemaMarkup item={business} slot="head" />
  <SchemaMarkup item={breadcrumb} slot="head" />
  {faq && <SchemaMarkup item={faq} slot="head" />}

  <div {...sbObjectId(area._id)}>
  <section class="on-dark hero-dark relative w-full min-h-[44vh] flex items-end overflow-hidden bg-walnut pt-32 pb-12 px-6">
    <img
      src={heroBanner.src}
      sizes="100vw"
      alt={heroBanner.alt}
      width={heroBanner.width}
      height={heroBanner.height}
      loading="eager"
      decoding="async"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-[#1C1E22]/95 via-[#1C1E22]/65 to-[#1C1E22]/25" aria-hidden="true"></div>
    <div class="relative z-10 max-w-[960px] mx-auto w-full">
      <span class="kicker"><span {...sbFieldPath('city')}>{area.city}</span>{area.region ? ' · ' : ''}{area.region && <span {...sbFieldPath('region')}>{area.region}</span>}</span>
      <h1 class="font-serif text-[clamp(30px,5vw,52px)] text-ivory leading-tight mt-3 mb-5">{localHeading}</h1>
      <p class="text-ivory/85 text-[17px] max-w-[640px] leading-relaxed">{localIntro}</p>
    </div>
  </section>

  {area.servedServices && area.servedServices.length > 0 && (
    <section class="bg-charcoal py-14 px-6">
      <div class="max-w-[1280px] mx-auto">
        <span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-8">Services to review</span>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-px bg-gold-metal/10">
          {area.servedServices.map((s) => (
            <article class="bg-charcoal p-7 group transition-colors hover:bg-charcoal-lighter" {...sbObjectId(s._id)}>
              <h2 class="font-serif text-[20px] text-ink mb-2 group-hover:text-gold transition-colors" {...sbFieldPath('title')}>{s.title}</h2>
              <a href={`/services/${s.slug}/`} class="learn-more mt-5 inline-flex group-hover:text-gold">Learn about {s.title}</a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {area.neighborhoods && area.neighborhoods.length > 0 && (
    <section class="bg-charcoal-light py-12 px-6">
      <div class="max-w-[860px] mx-auto">
        <span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-4">Nearby communities</span>
        <p class="text-muted text-[14px] leading-relaxed">{area.neighborhoods.join(' · ')}</p>
      </div>
    </section>
  )}

  <section class="bg-charcoal py-14 px-6">
    <div class="max-w-[860px] mx-auto">
      <span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-8 text-center">Local information</span>
      <div class="space-y-6">
        {localFaqs.map((f) => (
          <div class="border-b border-ink/5 pb-6">
            <h2 class="text-ink text-[17px] font-medium mb-3">{f.question}</h2>
            <p class="text-muted text-[14px] leading-relaxed">{f.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section data-area-visit-planning class="bg-charcoal-light py-12 px-6 border-t border-gold-metal/10">
    <div class="max-w-[1060px] mx-auto grid gap-10 md:grid-cols-[0.9fr_1.1fr] md:items-center">
      <figure class="overflow-hidden bg-charcoal">
        <img
          src={heroImage}
          srcset={heroImageSrcset}
          sizes="(max-width: 767px) 100vw, 44vw"
          alt={heroImageAlt}
          width={heroImageWidth}
          height={heroImageHeight}
          loading="lazy"
          decoding="async"
          class="aspect-[4/3] h-auto w-full object-cover"
          {...sbFieldPath('image')}
        />
      </figure>
      <div>
        <span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-3">Plan the visit</span>
        <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ink leading-tight mb-4">
          {isPuntaGorda ? `${siteFacts.shortName} is in Unit 9.` : `House of Rose is in Punta Gorda.`}
        </h2>
        <p class="text-muted text-[15px] leading-relaxed max-w-[590px]">
          The storefront photograph shows the entrance at {practiceAddress}. Free parking is available. Call before leaving if you need help with directions or current availability.
        </p>
        <div class="mt-7 flex gap-3 flex-wrap">
          <a href="/contact/" class="btn-outline-gold">Get directions</a>
          <a href="/services/" class="btn-outline-gold">Review services</a>
          <a href={phoneHref} class="btn-gold">Call {siteFacts.phone}</a>
        </div>
      </div>
    </div>
  </section>
  </div>
</BaseLayout>
