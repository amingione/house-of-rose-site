---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sanityFetch } from '@/lib/sanity';
import { sbObjectId, sbFieldPath } from '@/lib/visualEditing';
import { ALL_LOCAL_AREAS_QUERY, type LocalArea } from '@/lib/queries';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import { breadcrumbList } from '@/lib/structuredData';

const areas = await sanityFetch<LocalArea[]>(ALL_LOCAL_AREAS_QUERY);
const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonical = new URL(Astro.url.pathname, site).toString();

const breadcrumb = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'Areas We Serve', item: canonical },
]);
---

<BaseLayout
  title="Areas We Serve | House of Rose Aesthetics, Punta Gorda FL"
  description="House of Rose Aesthetics is located in Punta Gorda and serves Punta Gorda, Port Charlotte, Charlotte Harbor, Babcock Ranch, Burnt Store Marina, and Punta Gorda Isles."
>
  <SchemaMarkup item={breadcrumb} slot="head" />

  <section class="bg-charcoal pt-32 pb-12 px-6">
    <div class="max-w-[1280px] mx-auto">
      <span class="kicker">Areas We Serve</span>
      <h1 class="font-serif text-[clamp(30px,5vw,52px)] text-ink leading-tight mt-3 mb-5">One practice in Punta Gorda.</h1>
      <p class="text-ink/80 text-[16px] max-w-[720px] leading-relaxed">House of Rose Aesthetics serves Punta Gorda, Port Charlotte, Charlotte Harbor, Babcock Ranch, Burnt Store Marina, and Punta Gorda Isles from 525 E Olympia Ave, Unit 9.</p>
    </div>
  </section>

  <section data-area-index-practice class="border-y border-gold-metal/10 bg-charcoal-light">
    <div class="mx-auto grid max-w-[1280px] lg:grid-cols-[0.92fr_1.08fr]">
      <div class="min-h-[360px] overflow-hidden bg-charcoal-lighter lg:min-h-[520px]">
        <img
          src="/images/optimized/house-of-rose-storefront-700.webp"
          srcset="/images/optimized/house-of-rose-storefront-700.webp 700w, /images/optimized/house-of-rose-storefront-1000.webp 1000w"
          sizes="(max-width: 1023px) 100vw, 46vw"
          alt="The House of Rose Aesthetics storefront at 525 E Olympia Avenue in Punta Gorda"
          width="1000"
          height="1250"
          loading="lazy"
          class="h-full w-full object-cover"
        />
      </div>
      <div class="flex items-center px-6 py-[clamp(48px,7vw,88px)] sm:px-10 lg:px-[clamp(48px,6vw,84px)]">
        <div class="max-w-[620px]">
          <span class="kicker">One place to arrive</span>
          <h2 class="mt-3 font-serif text-[clamp(28px,4vw,44px)] leading-tight text-ink">
            Every appointment is at the Punta Gorda practice.
          </h2>
          <div class="mt-6 space-y-4 text-[15px] leading-[1.8] text-muted">
            <p>
              House of Rose Aesthetics serves Punta Gorda, Port Charlotte, Charlotte Harbor, Babcock Ranch, Burnt Store Marina, and Punta Gorda Isles from 525 E Olympia Ave, Unit 9. The photograph shows the actual storefront.
            </p>
            <p>
              There are no separate House of Rose locations in those communities. When it is time for your appointment, look for Unit 9; free parking is available.
            </p>
          </div>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/contact/" class="btn-gold">Get directions</a>
            <a href="/services/" class="btn-outline-gold">Review services</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-charcoal-light py-14 px-6">
    <div class="max-w-[1280px] mx-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-px bg-gold-metal/10">
      {areas.map((area) => (
        <a href={`/areas/${area.slug}/`} class="bg-charcoal p-7 group block transition-colors hover:bg-charcoal-lighter" {...sbObjectId(area._id)}>
          <h2 class="font-serif text-[22px] text-ink mb-2 group-hover:text-gold transition-colors" {...sbFieldPath('city')}>{area.city}</h2>
          {area.region && <p class="text-gold text-[11px] tracking-[0.2em] uppercase mb-3" {...sbFieldPath('region')}>{area.region}</p>}
          <span class="learn-more group-hover:text-gold mt-4 inline-block">View area</span>
        </a>
      ))}
      {areas.length === 0 && (
        <p class="bg-charcoal p-7 text-muted text-[14px]">No area guides are currently available.</p>
      )}
    </div>
  </section>
</BaseLayout>
