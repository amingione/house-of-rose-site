---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sanityFetch } from '@/lib/sanity';
import { ALL_LOCAL_AREAS_QUERY, type LocalArea } from '@/lib/queries';
import { jsonLd, breadcrumbList } from '@/lib/structuredData';

const areas = await sanityFetch<LocalArea[]>(ALL_LOCAL_AREAS_QUERY);
const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const breadcrumb = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'Areas We Serve', item: canonical },
]);
---

<BaseLayout
  title="Areas We Serve | House of Rose Aesthetics, Punta Gorda FL"
  description="Advanced aesthetics and wellness for Punta Gorda, Port Charlotte, and Southwest Florida. Explore the areas House of Rose serves."
>
  <script is:inline type="application/ld+json" set:html={jsonLd(breadcrumb)} slot="head" />

  <section class="bg-charcoal pt-32 pb-12 px-6">
    <div class="max-w-[1280px] mx-auto">
      <span class="kicker">Areas We Serve</span>
      <h1 class="font-serif text-[clamp(30px,5vw,52px)] text-ink leading-tight mt-3 mb-5">Advanced aesthetics across Southwest Florida</h1>
      <p class="text-ink/80 text-[16px] max-w-[640px] leading-relaxed">From our Punta Gorda studio, House of Rose serves clients throughout Charlotte County and SW Florida.</p>
    </div>
  </section>

  <section class="bg-charcoal-light py-14 px-6">
    <div class="max-w-[1280px] mx-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-px bg-gold/10">
      {areas.map((area) => (
        <a href={`/areas/${area.slug}`} class="bg-charcoal p-7 group block transition-colors hover:bg-charcoal-lighter">
          <h2 class="font-serif text-[22px] text-ink mb-2 group-hover:text-gold transition-colors">{area.title}</h2>
          {area.city && <p class="text-gold text-[11px] tracking-[0.2em] uppercase mb-3">{area.city}{area.region ? ` · ${area.region}` : ''}</p>}
          {area.intro && <p class="text-[#9a8c78] text-[14px] leading-relaxed">{area.intro}</p>}
          <span class="learn-more group-hover:text-gold mt-4 inline-block">Explore</span>
        </a>
      ))}
      {areas.length === 0 && (
        <p class="bg-charcoal p-7 text-[#777] text-[14px]">Area pages are coming soon.</p>
      )}
    </div>
  </section>
</BaseLayout>
