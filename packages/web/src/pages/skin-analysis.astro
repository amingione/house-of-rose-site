---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import { breadcrumbList, faqPage, service } from '@/lib/structuredData';
import BookingLink from '@/components/BookingLink.astro';
import { SKIN_ANALYSIS_BOOKING_URL } from '@/lib/booking';

const siteUrl = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

interface SkinAnalysisStep {
  n: string;
  title: string;
  body: string;
}
interface SkinAnalysisConcern {
  title: string;
  slug: string;
}
interface SkinAnalysisFaq {
  q: string;
  a: string;
}
const pageTitle = 'Skin Imaging & Analysis in Punta Gorda | House of Rose';
const pageDescription =
  'Multi-spectrum skin imaging in Punta Gorda offers a closer look at pigmentation, pores, texture, hydration cues, fine lines, and visible sun exposure.';

const steps: SkinAnalysisStep[] = [
  {
    n: '01',
    title: 'Take the images',
    body: 'We photograph your skin in consistent, controlled lighting, including views that can reveal patterns that are easy to miss in an ordinary mirror.',
  },
  {
    n: '02',
    title: 'Look closely',
    body: 'Imaging under standard, cross-polarized, and UV light helps us look more closely at pigmentation, pores, texture, fine lines, hydration cues, and visible signs of sun exposure.',
  },
  {
    n: '03',
    title: 'Review the findings',
    body: 'We review the photographs with you and answer your questions about the visible patterns.',
  },
];

const concernLinks: SkinAnalysisConcern[] = [
  { title: 'Fine Lines & Laxity', slug: 'fine-lines-laxity' },
  { title: 'Acne Scarring', slug: 'acne-scarring' },
  { title: 'Sun Damage', slug: 'sun-damage' },
  { title: 'Dark Circles & Under-Eyes', slug: 'dark-circles' },
  { title: 'Stretch Marks', slug: 'stretch-marks' },
  { title: 'Texture', slug: 'texture' },
];

const faqs: SkinAnalysisFaq[] = [
  {
    q: 'Do I need a skin analysis before treatment?',
    a: 'No. It is not required for every appointment. The analysis can be helpful when you are unsure where to begin or want a clearer baseline before choosing a skin treatment.',
  },
  {
    q: 'How long does it take?',
    a: 'Taking the images takes a few minutes. The rest of the visit is used to review what appears in them and answer your questions.',
  },
  {
    q: 'Is skin imaging uncomfortable?',
    a: 'No. It is non-invasive and does not use needles. We take the images and review them with you.',
  },
  {
    q: 'What happens to my photos?',
    a: 'Your images are kept private and are not shared or published without your explicit permission.',
  },
];

const faqSchema = faqPage(faqs.map((faq) => ({ question: faq.q, answer: faq.a })));
const breadcrumb = breadcrumbList([
  { name: 'Home', item: siteUrl },
  { name: 'Advanced Skin Imaging & Analysis', item: canonicalURL.toString() },
]);
const serviceSchema = service(
  {
    name: 'Advanced Skin Imaging & Analysis',
    description: pageDescription,
    url: canonicalURL.toString(),
    image: new URL('/images/editorial/skin-analysis/skin-texture-study-v1-1536.webp', siteUrl).toString(),
    serviceType: 'Multi-spectrum skin imaging',
    offerUrl: SKIN_ANALYSIS_BOOKING_URL,
  },
  siteUrl,
);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  preloadImage="/images/editorial/skin-analysis/skin-texture-study-v1-1536.webp"
  preloadImageSrcset="/images/editorial/skin-analysis/skin-texture-study-v1-800.webp 800w, /images/editorial/skin-analysis/skin-texture-study-v1-1536.webp 1536w"
  preloadImageSizes="100vw"
>
  <SchemaMarkup item={serviceSchema} slot="head" />
  <SchemaMarkup item={breadcrumb} slot="head" />
  {faqSchema && <SchemaMarkup item={faqSchema} slot="head" />}

  <!-- ── HERO ─────────────────────────────────────────────────────── -->
  <Hero
    title="See more than the mirror shows."
    kicker="Skin Imaging · Punta Gorda"
    description="Multi-spectrum photographs make pigmentation, texture, pores, fine lines, hydration cues, and visible sun exposure easier to examine before you choose a skin service."
    size="small"
    showCTA={true}
    ctaPrimary={{ text: 'Book a Skin Analysis', href: SKIN_ANALYSIS_BOOKING_URL }}
    ctaSecondary={{ text: 'View Services', href: '/services/' }}
    backgroundImage="/images/editorial/skin-analysis/skin-texture-study-v1-1536.webp"
    backgroundSrcset="/images/editorial/skin-analysis/skin-texture-study-v1-800.webp 800w, /images/editorial/skin-analysis/skin-texture-study-v1-1536.webp 1536w"
    backgroundSizes="100vw"
    imageAlt="Editorial close-up showing natural skin texture, fine lines, pores, and pigmentation"
  />

  <!-- ── WHAT IT IS ───────────────────────────────────────────────── -->
  <section class="bg-charcoal grid grid-cols-1 md:grid-cols-2">
    <div class="p-[clamp(38px,6vw,76px)] flex flex-col justify-center">
      <span class="kicker">What it shows</span>
      <h2 class="font-serif text-[clamp(24px,3.4vw,38px)] text-ink leading-tight mt-2 mb-6">
        What the mirror cannot show clearly.
      </h2>
      <p class="text-muted text-[15px] leading-[1.75] max-w-[560px] mb-4">
        Controlled lighting gives us another way to examine pigmentation, texture, pores, hydration cues, fine lines, and visible sun exposure.
      </p>
      <p class="text-muted text-[15px] leading-[1.75] max-w-[560px]">
        The photographs provide a visual baseline. They are not a medical diagnosis.
      </p>
    </div>
    <div class="relative min-h-[340px] bg-charcoal-lighter">
      <img
        src="/images/optimized/actual-facial-suite-1400.webp"
        srcset="/images/optimized/actual-facial-suite-800.webp 800w, /images/optimized/actual-facial-suite-1400.webp 1400w"
        sizes="(max-width: 767px) 100vw, 50vw"
        alt="A treatment suite inside House of Rose Aesthetics in Punta Gorda"
        loading="lazy"
        class="w-full h-full object-cover"
        width="1200"
        height="900"
      />
    </div>
  </section>

  <!-- ── HOW IT WORKS ─────────────────────────────────────────────── -->
  <section class="bg-charcoal-light py-[clamp(48px,7vw,96px)] px-6">
    <div class="max-w-[1280px] mx-auto">
      <div class="max-w-[640px] mb-12">
        <span class="kicker">The visit</span>
        <h2 class="font-serif text-[clamp(24px,4vw,40px)] text-ink mt-2">
          Three clear steps.
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-gold-metal/10">
        {steps.map((step) => (
          <div class="bg-charcoal-light p-8">
            <span class="font-serif text-gold text-[28px]">{step.n}</span>
            <h3 class="font-serif text-[21px] text-ink mt-2 mb-3">{step.title}</h3>
            <p class="text-muted text-[14px] leading-[1.7]">{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── WHAT WE LOOK AT ──────────────────────────────────────────── -->
  <!-- ── WHY IT MATTERS ───────────────────────────────────────────── -->
  <section
    class="on-dark relative py-[clamp(72px,10vw,140px)] px-6 bg-cover bg-center"
    style="background-image: url('/images/optimized/actual-reception-1400-light.webp');"
  >
    <!-- Warm walnut gradient scrim — same AA-verified treatment as the homepage photo
         bands. Inline style so it can't be Tailwind-purged; every stop clears AA for
         ivory text + the gold.300 kicker over a worst-case bright photo pixel. -->
    <div
      class="absolute inset-0"
      style="background:linear-gradient(180deg,rgba(44,31,22,0.86) 0%,rgba(44,31,22,0.92) 50%,rgba(44,31,22,0.88) 100%);"
    ></div>
    <div class="relative z-10 max-w-[680px] mx-auto text-center">
      <span class="kicker text-gold">Why it matters</span>
      <h2 class="font-serif text-[clamp(24px,3.6vw,40px)] text-ivory leading-tight mt-2 mb-6">
        A clearer visual record.
      </h2>
      <p class="text-ivory text-[15px] leading-[1.8] max-w-[600px] mx-auto">
        Imaging provides a consistent point of comparison for future photographs and makes subtle patterns easier to examine.
      </p>
    </div>
  </section>

  <!-- ── FROM ANALYSIS TO PLAN ────────────────────────────────────── -->
  <section class="bg-charcoal-light py-[clamp(48px,7vw,88px)] px-6">
    <div class="max-w-[960px] mx-auto text-center">
      <span class="kicker">Explore by concern</span>
      <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ink mt-2 mb-5">
        Continue by concern.
      </h2>
      <p class="text-muted text-[15px] leading-[1.8] max-w-[620px] mx-auto mb-10">
        Read about the concern you notice, or bring your photographs and questions to the appointment.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        {concernLinks.map((c) => (
          <a href={`/concerns/${c.slug}/`} class="border border-gold-metal/30 text-ink/85 text-[12px] tracking-[0.16em] uppercase px-5 py-3 hover:border-gold hover:text-gold transition-colors">
            {c.title}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── FAQ ──────────────────────────────────────────────────────── -->
  <section class="bg-charcoal py-[clamp(48px,7vw,96px)] px-6">
    <div class="max-w-[760px] mx-auto">
      <span class="kicker">Questions</span>
      <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ink mt-2 mb-10">
        Before you book.
      </h2>
      <div class="divide-y divide-white/8 border-t border-ink/8">
        {faqs.map((faq) => (
          <div class="py-7">
            <h3 class="text-ink text-[16px] mb-2.5">{faq.q}</h3>
            <p class="text-muted text-[14px] leading-[1.75]">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ──────────────────────────────────────────────────────── -->
  <section id="consultation" class="bg-charcoal-light py-[clamp(56px,8vw,96px)] px-6 border-t border-gold-metal/10 scroll-mt-24">
    <div class="max-w-[640px] mx-auto text-center">
      <span class="kicker">Skin analysis</span>
      <h2 id="skin-analysis-form-heading" class="font-serif text-[clamp(26px,4.5vw,42px)] text-ink leading-tight mt-2 mb-5">
        Request a skin imaging appointment.
      </h2>
      <p class="text-muted text-[15px] max-w-[460px] mx-auto mb-9 leading-[1.8]">
        Send your contact details, or reserve a time online.
      </p>
      <p class="text-gold text-[11px] font-medium tracking-[0.2em] uppercase -mt-5 mb-8">
        In studio · Punta Gorda
      </p>
      <form
        name="skin-analysis"
        method="POST"
        action="/.netlify/functions/lead-submit"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="max-w-[440px] mx-auto text-left flex flex-col gap-4"
        aria-labelledby="skin-analysis-form-heading"
      >
        <input type="hidden" name="form-name" value="skin-analysis" />
        <input type="hidden" name="source-page" value="/skin-analysis/" />
        <p class="hidden" aria-hidden="true">
          <label>Don't fill this out if you're human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>
        <p class="text-muted text-[12px]">Name and email are required.</p>
        <label for="sa-name" class="text-gold text-[11px] tracking-[0.2em] uppercase">Name</label>
        <input id="sa-name" name="name" type="text" required autocomplete="name" placeholder="Your name"
          class="w-full bg-transparent border border-ink/25 text-ink px-4 py-3 text-[15px] placeholder:text-ink/70 focus:border-gold focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold transition-colors" />
        <label for="sa-email" class="text-gold text-[11px] tracking-[0.2em] uppercase">Email</label>
        <input id="sa-email" name="email" type="email" required autocomplete="email" inputmode="email" placeholder="Email address"
          class="w-full bg-transparent border border-ink/25 text-ink px-4 py-3 text-[15px] placeholder:text-ink/70 focus:border-gold focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold transition-colors" />
        <label for="sa-phone" class="text-gold text-[11px] tracking-[0.2em] uppercase">Phone <span class="normal-case tracking-normal text-muted">(optional)</span></label>
        <input id="sa-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="Phone number"
          class="w-full bg-transparent border border-ink/25 text-ink px-4 py-3 text-[15px] placeholder:text-ink/70 focus:border-gold focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold transition-colors" />
        <input type="hidden" name="service-interest" value="Advanced Skin Imaging & Analysis" />
        <button type="submit" class="btn-gold w-full">Request a Skin Analysis</button>
        <p class="text-muted text-[12px] text-center leading-[1.6]">
          Prefer to reserve online?
          <BookingLink
            slug="skin-analysis"
            bookingMode="direct"
            bookingUrl={SKIN_ANALYSIS_BOOKING_URL}
            location="skin_analysis_form"
            class="text-gold hover:underline"
            label="Book a skin analysis"
          />.
          We only use your details to arrange your analysis. Read our
          <a href="/privacy-policy/" class="text-gold hover:underline">privacy policy</a>.
        </p>
      </form>
    </div>
  </section>
</BaseLayout>
