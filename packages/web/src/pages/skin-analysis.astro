---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import SchemaMarkup from '@/components/SchemaMarkup.astro';
import { breadcrumbList, faqPage, service } from '@/lib/structuredData';
import { getHeroBanner } from '@/lib/heroBanners';

const siteUrl = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

interface SkinAnalysisStep {
  n: string;
  title: string;
  body: string;
}
interface SkinAnalysisConcern {
  title: string;
  slug: string;
}
interface SkinAnalysisFaq {
  q: string;
  a: string;
}
const pageTitle = 'Skin Imaging & Analysis in Punta Gorda | House of Rose';
const pageDescription =
  'Multi-spectrum skin imaging in Punta Gorda offers a closer look at pigmentation, pores, texture, fine lines, and visible sun exposure.';
const heroBanner = getHeroBanner('/skin-analysis/');

const steps: SkinAnalysisStep[] = [
  {
    n: '01',
    title: 'Take the photographs',
    body: 'We photograph your skin in consistent, controlled lighting. Taking the images takes a few minutes.',
  },
  {
    n: '02',
    title: 'Review them together',
    body: 'We compare the photographs with you, point out what appears in each view, and answer your questions.',
  },
];

const concernLinks: SkinAnalysisConcern[] = [
  { title: 'Fine Lines & Laxity', slug: 'fine-lines-laxity' },
  { title: 'Acne Scarring', slug: 'acne-scarring' },
  { title: 'Sun Damage', slug: 'sun-damage' },
  { title: 'Dark Circles & Under-Eyes', slug: 'dark-circles' },
  { title: 'Stretch Marks', slug: 'stretch-marks' },
  { title: 'Texture', slug: 'texture' },
];

const faqs: SkinAnalysisFaq[] = [
  {
    q: 'How can I ask about skin analysis pricing?',
    a: 'Call House of Rose or send a message with “Skin Analysis” as the topic for current pricing.',
  },
  {
    q: 'Do I need a skin analysis before treatment?',
    a: 'No. It is not required before every treatment. The analysis can be helpful when you are unsure where to begin or want a clearer visual baseline.',
  },
  {
    q: 'How long does it take?',
    a: 'Taking the images takes a few minutes. The rest of the visit is used to review what appears in them and answer your questions.',
  },
  {
    q: 'Is skin imaging uncomfortable?',
    a: 'No. It is non-invasive and does not use needles. We take the images and review them with you.',
  },
  {
    q: 'Can skin imaging diagnose a skin condition or screen for skin cancer?',
    a: 'No. The images document visible patterns but do not determine their medical cause, diagnose a condition, or screen for skin cancer. A changing spot, unexplained symptom, or other medical skin concern needs evaluation by an appropriately licensed medical provider.',
  },
  {
    q: 'Can makeup or sunscreen affect the images?',
    a: 'Yes. Makeup, sunscreen residue, and other material on the skin can affect what appears in a UV image. We review the photographs together rather than treating any one image as a diagnosis.',
  },
  {
    q: 'What happens to my photos?',
    a: 'Your images remain private unless you give separate written permission for them to be shared.',
  },
];

const faqSchema = faqPage(faqs.map((faq) => ({ question: faq.q, answer: faq.a })));
const breadcrumb = breadcrumbList([
  { name: 'Home', item: siteUrl },
  { name: 'Advanced Skin Imaging & Analysis', item: canonicalURL.toString() },
]);
const serviceSchema = service(
  {
    name: 'Advanced Skin Imaging & Analysis',
    description: pageDescription,
    url: canonicalURL.toString(),
    image: new URL(heroBanner.src, siteUrl).toString(),
    serviceType: 'Multi-spectrum skin imaging',
  },
  siteUrl,
);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  preloadImage={heroBanner.src}
  preloadImageSizes="100vw"
>
  <SchemaMarkup item={serviceSchema} slot="head" />
  <SchemaMarkup item={breadcrumb} slot="head" />
  {faqSchema && <SchemaMarkup item={faqSchema} slot="head" />}

  <!-- ── HERO ─────────────────────────────────────────────────────── -->
  <Hero
    title="A closer look at your skin, in three lights."
    kicker="Skin Imaging · Punta Gorda"
    description="Multi-spectrum photographs make pigmentation, texture, pores, fine lines, and visible sun exposure easier to examine before you choose a skin service."
    size="small"
    showCTA={true}
    ctaPrimary={{ text: 'Ask about Skin Analysis', href: '#consultation' }}
    ctaSecondary={{ text: 'View Services', href: '/services/' }}
    backgroundImage={heroBanner.src}
    backgroundSizes="100vw"
    backgroundWidth={924}
    backgroundHeight={610}
    backgroundPosition={heroBanner.position}
    imageAlt={heroBanner.alt}
  />

  <!-- ── WHAT IT IS ───────────────────────────────────────────────── -->
  <section data-skin-analysis-overview class="bg-charcoal px-6 py-[clamp(52px,8vw,108px)]">
    <div class="mx-auto grid max-w-[1120px] gap-8 md:grid-cols-[minmax(220px,.72fr)_minmax(0,1.28fr)] md:gap-[clamp(52px,8vw,112px)]">
      <div>
        <span class="kicker">The analysis</span>
        <h2 class="mt-2 font-serif text-[clamp(28px,4vw,46px)] leading-tight text-ink">
          Three views of the skin.
        </h2>
      </div>
      <div class="border-t border-ivory/15 pt-6 md:pt-8">
        <p class="mb-4 max-w-[660px] text-[15px] leading-[1.8] text-muted">
          Skin Analysis captures standard, cross-polarized, and UV photographs. Taking the images takes a few minutes; the rest of the time is used to review what appears in them.
        </p>
        <p class="max-w-[660px] text-[15px] leading-[1.8] text-muted">
          Skin imaging is optional and is not required before another service. The photographs provide a consistent visual baseline, not a medical diagnosis.
        </p>
      </div>
    </div>
  </section>

  <!-- ── THE THREE VIEWS ─────────────────────────────────────────── -->
  <section data-skin-imaging-views class="bg-charcoal-light py-[clamp(48px,7vw,96px)] px-6">
    <div class="max-w-[1120px] mx-auto">
      <div class="max-w-[720px] mb-10">
        <span class="kicker">Reading the images</span>
        <h2 class="font-serif text-[clamp(24px,4vw,40px)] text-ink leading-tight mt-2 mb-5">
          What each light mode shows, and what it doesn't decide.
        </h2>
        <p class="text-muted text-[15px] leading-[1.8]">
          Each light mode records the skin differently. We compare the views with one another because no single photograph explains the cause of a visible pattern.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-gold-metal/10">
        <article class="bg-charcoal-light p-7 md:p-8">
          <h3 class="font-serif text-[21px] text-ink mb-3">Standard light</h3>
          <p class="text-muted text-[14px] leading-[1.75]">
            Records the visible surface, including texture, pores, fine lines, and spots that can be seen in ordinary light.
          </p>
        </article>
        <article class="bg-charcoal-light p-7 md:p-8">
          <h3 class="font-serif text-[21px] text-ink mb-3">Cross-polarized light</h3>
          <p class="text-muted text-[14px] leading-[1.75]">
            Reduces surface reflection so pigment and redness patterns are easier to examine alongside the standard photograph.
          </p>
        </article>
        <article class="bg-charcoal-light p-7 md:p-8">
          <h3 class="font-serif text-[21px] text-ink mb-3">UV light</h3>
          <p class="text-muted text-[14px] leading-[1.75]">
            Adds a fluorescence-based view. Concentrated pigment may appear darker, and fluorescence associated with some porphyrins may be visible.
          </p>
        </article>
      </div>

      <aside class="mt-8 border-l-2 border-gold/60 pl-6 max-w-[840px]" aria-label="Skin imaging limitations">
        <h3 class="text-ink text-[16px] mb-2">A photograph is not a diagnosis.</h3>
        <p class="text-muted text-[14px] leading-[1.75] mb-3">
          These views document patterns. They do not determine their medical cause, diagnose a skin condition, or screen for skin cancer.
        </p>
        <p class="text-muted text-[14px] leading-[1.75]">
          Hair, facial expression, makeup, sunscreen residue, and other material on the skin can affect an image. A changing spot, unexplained symptom, or other medical skin concern needs evaluation by an appropriately licensed medical provider.
        </p>
      </aside>
    </div>
  </section>

  <!-- ── HOW IT WORKS ─────────────────────────────────────────────── -->
  <section data-skin-analysis-steps class="bg-charcoal-light py-[clamp(48px,7vw,96px)] px-6">
    <div class="max-w-[1280px] mx-auto">
      <div class="max-w-[640px] mb-12">
        <span class="kicker">During the analysis</span>
        <h2 class="font-serif text-[clamp(24px,4vw,40px)] text-ink mt-2">
          What happens while we take and review the images.
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-gold-metal/10">
        {steps.map((step) => (
          <div data-skin-analysis-step class="bg-charcoal-light p-8">
            <span class="font-serif text-gold text-[28px]">{step.n}</span>
            <h3 class="font-serif text-[21px] text-ink mt-2 mb-3">{step.title}</h3>
            <p class="text-muted text-[14px] leading-[1.7]">{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── FROM ANALYSIS TO PLAN ────────────────────────────────────── -->
  <section class="bg-charcoal-light py-[clamp(48px,7vw,88px)] px-6">
    <div class="max-w-[960px] mx-auto text-center">
      <span class="kicker">Explore by concern</span>
      <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ink mt-2 mb-5">
        Continue by concern.
      </h2>
      <p class="text-muted text-[15px] leading-[1.8] max-w-[620px] mx-auto mb-10">
        Read about your specific concern, or use the photographs as a starting point for your questions.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        {concernLinks.map((c) => (
          <a href={`/concerns/${c.slug}/`} class="border border-gold-metal/30 text-ink/85 text-[12px] tracking-[0.16em] uppercase px-5 py-3 hover:border-gold hover:text-gold transition-colors">
            {c.title}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── FAQ ──────────────────────────────────────────────────────── -->
  <section class="bg-charcoal py-[clamp(48px,7vw,96px)] px-6">
    <div class="max-w-[760px] mx-auto">
      <span class="kicker">Questions</span>
      <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ink mt-2 mb-10">
        What to know.
      </h2>
      <div class="divide-y divide-white/8 border-t border-ink/8">
        {faqs.map((faq) => (
          <div class="py-7">
            <h3 data-skin-analysis-faq-question class="text-ink text-[16px] mb-2.5">{faq.q}</h3>
            <p data-skin-analysis-faq-answer class="text-muted text-[14px] leading-[1.75]">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ──────────────────────────────────────────────────────── -->
  <section id="consultation" class="bg-charcoal-light py-[clamp(56px,8vw,96px)] px-6 border-t border-gold-metal/10 scroll-mt-24">
    <div class="max-w-[640px] mx-auto text-center">
      <span class="kicker">Skin analysis</span>
      <h2 id="skin-analysis-form-heading" class="font-serif text-[clamp(26px,4.5vw,42px)] text-ink leading-tight mt-2 mb-5">
        Ask about skin imaging.
      </h2>
      <p class="text-muted text-[15px] max-w-[460px] mx-auto mb-9 leading-[1.8]">
        Send a brief request if you want to know whether Skin Analysis is a useful starting point for your concern.
      </p>
      <p class="text-gold text-[11px] font-medium tracking-[0.2em] uppercase -mt-5 mb-8">
        In studio · Punta Gorda
      </p>
      <form
        name="skin-analysis"
        method="POST"
        action="/.netlify/functions/lead-submit"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="max-w-[440px] mx-auto text-left flex flex-col gap-4"
        aria-labelledby="skin-analysis-form-heading"
      >
        <input type="hidden" name="form-name" value="skin-analysis" />
        <input type="hidden" name="source-page" value="/skin-analysis/" />
        <p class="hidden" aria-hidden="true">
          <label>Don't fill this out if you're human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>
        <p class="text-muted text-[12px]">Name and email are required.</p>
        <label for="sa-name" class="text-gold text-[11px] tracking-[0.2em] uppercase">Name</label>
        <input id="sa-name" name="name" type="text" required autocomplete="name" placeholder="Your name"
          class="w-full bg-transparent border border-ink/25 text-ink px-4 py-3 text-[15px] placeholder:text-ink/70 focus:border-gold focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold transition-colors" />
        <label for="sa-email" class="text-gold text-[11px] tracking-[0.2em] uppercase">Email</label>
        <input id="sa-email" name="email" type="email" required autocomplete="email" inputmode="email" placeholder="Email address"
          class="w-full bg-transparent border border-ink/25 text-ink px-4 py-3 text-[15px] placeholder:text-ink/70 focus:border-gold focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold transition-colors" />
        <label for="sa-phone" class="text-gold text-[11px] tracking-[0.2em] uppercase">Phone <span class="normal-case tracking-normal text-muted">(optional)</span></label>
        <input id="sa-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="Phone number"
          class="w-full bg-transparent border border-ink/25 text-ink px-4 py-3 text-[15px] placeholder:text-ink/70 focus:border-gold focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold transition-colors" />
        <input type="hidden" name="service-interest" value="Advanced Skin Imaging & Analysis" />
        <button type="submit" class="btn-gold w-full">Send a Skin Analysis Request</button>
        <p class="text-muted text-[12px] text-center leading-[1.6]">
          We only use your details to respond to your request. Read our
          <a href="/privacy-policy/" class="text-gold underline underline-offset-2">privacy policy</a>.
        </p>
      </form>
    </div>
  </section>
</BaseLayout>
