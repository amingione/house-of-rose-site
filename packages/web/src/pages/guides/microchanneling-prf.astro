---
/**
 * Educational guide — "Microchanneling, Microneedling & Topical PRF: An Honest Guide".
 *
 * Client-education page built from docs/services/microchanneling/procell-prf-delivery-research-report.md.
 * Fully static (no Sanity fetch) — this is copy-development content, provider-approved wording only.
 *
 * Purpose: the "learn more" hub. Every treatment named in prose links out to its real page, and a
 * cross-link grid + CTAs funnel readers to the comparison, service, cost, concern, FAQ, and area pages.
 *
 * COMPLIANCE (binding — from the research report + FL Board of Medicine + FDA):
 *  - Topical PRF is applied TOPICALLY ONLY. Never "injects", "delivers into the skin", or
 *    "FDA-approved PRF microneedling".
 *  - Use "the appearance of". Never "erases", "removes", "reverses aging", "heals", "treats acne",
 *    or a guaranteed downtime / result.
 *  - ProCell tiers (confirmed with the manufacturer/rep): Pro = professional growth-factor serum for
 *    maintenance/prevention; MD = ~2x the growth factors, marketed as the go-to for 40+. Tier is still
 *    confirmed per client at consultation. Never say "stem cell" or that growth factors are delivered deep.
 *  - Individual results vary; the licensed provider confirms candidacy. Injectable PRF is Diana's lane.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import { jsonLd, article, breadcrumbList, faqPage } from '@/lib/structuredData';
import type { FAQ } from '@/lib/queries';

const PHONE_DISPLAY = '(844) 941-7673';
const PHONE_TEL = 'tel:+18449417673';
const SMS_HREF = 'sms:+18449417673';
const BOOKING_URL = 'https://houseofrose.glossgenius.com/services';
const HERO_IMG = '/images/new-microchanneling.webp';

// Shared inline-link style so cross-links read consistently inside prose.
const link = 'text-gold underline decoration-gold/40 underline-offset-4 hover:decoration-gold transition-colors';

// ── Website-ready FAQ copy (report §6) — also emitted as FAQPage JSON-LD ───────
const faqs: FAQ[] = [
  {
    question: 'Is ProCell microchanneling the same as microneedling?',
    answer:
      'ProCell microchanneling is a branded needling protocol within the broader microneedling category. Both use tiny needles to create controlled punctures in the skin, but the device, settings, topical protocol, and candidacy review matter more than the label alone.',
  },
  {
    question: 'Is topical PRF the same as PRF injections?',
    answer:
      "No. Topical PRF is applied on the surface during the needling protocol. PRF injections are a separate procedure. At House of Rose, Amber's PRF treatment is topical only; injectable PRF is evaluated and performed separately by the appropriate licensed provider.",
  },
  {
    question: 'Does topical PRF get injected through the microchannels?',
    answer:
      'No. We describe PRF accurately as a topical adjunct applied during the protocol. The FDA states that microneedling devices are not authorized for delivery of blood products or topical products into the skin.',
  },
  {
    question: 'How many sessions will I need for scars or stretch marks?',
    answer:
      'Most corrective concerns are planned as a series, often three to six sessions about four to six weeks apart. Your plan depends on the type and age of the concern, treatment area, skin history, recovery response, and candidacy. Individual results vary.',
  },
  {
    question: 'Can microchanneling remove wrinkles, scars, or stretch marks?',
    answer:
      'No treatment should promise removal. Needling-based treatments may help improve the appearance of texture, fine lines, selected scars, and stretch marks over time, but outcomes vary and some concerns need a different approach.',
  },
];

// Concern → matching pages (real /concerns and /services slugs).
const concerns = [
  {
    title: 'Fine lines & crepey texture',
    body: 'May support smoother-looking texture and a more refined appearance as collagen remodeling occurs. Results develop over weeks to months — there is no guarantee of wrinkle removal.',
    href: '/concerns/fine-lines-laxity/',
    hrefLabel: 'Fine Lines & Laxity',
  },
  {
    title: 'Enlarged-looking pores & dullness',
    body: 'May help improve the appearance of texture and luminosity. We start with a skin analysis and an SPF/skincare review, and choose a conservative first protocol when appropriate. Pore size is not permanently changed.',
    href: '/concerns/sun-damage/',
    hrefLabel: 'Sun Damage & Dullness',
  },
  {
    title: 'Atrophic acne-scar appearance',
    body: 'May improve the appearance of selected shallow or rolling scars as part of a personalized plan. It does not treat active acne. Deep ice-pick, tethered, or keloid-prone scars need a clinician’s assessment and may need a different approach.',
    href: '/concerns/acne-scarring/',
    hrefLabel: 'Acne Scarring',
  },
  {
    title: 'Stretch marks',
    body: 'May help improve the visible texture and color variation of mature stretch marks on appropriate body areas. Stretch marks are not “removed,” and response varies by age, color, location, and skin biology — a body zone is assessed separately.',
    href: '/concerns/stretch-marks/',
    hrefLabel: 'Stretch Marks',
  },
];

// "Explore more" funnel — the cross-link grid.
const exploreLinks = [
  {
    label: 'PRF Microchanneling vs Microneedling',
    description: 'The side-by-side comparison — which is right for you, and why.',
    href: '/compare/prf-microchanneling-vs-microneedling/',
  },
  {
    label: 'ProCell Microchanneling',
    description: 'The structured, provider-selected microchanneling protocol for overall skin quality.',
    href: '/services/microchanneling/',
  },
  {
    label: 'Microchanneling & Microneedling',
    description: 'The broader needling service — device, depth, and pattern dialed to your concern.',
    href: '/services/microchanneling-microneedling/',
  },
  {
    label: 'PRF — Platelet-Rich Fibrin',
    description: 'What topical PRF is, how it is prepared from your own blood, and where it fits.',
    href: '/services/prf/',
  },
  {
    label: 'What does PRF microneedling cost?',
    description: 'Honest pricing for Punta Gorda, and what changes the number.',
    href: '/cost/prf-microneedling-cost-punta-gorda/',
  },
  {
    label: 'Questions & Answers',
    description: 'The full FAQ hub for treatments at House of Rose.',
    href: '/faq/',
  },
];

// ── SEO + JSON-LD ──────────────────────────────────────────────────────────────
const site = Astro.site?.toString() ?? 'https://houseofrosefl.com/';
const canonical = new URL(Astro.url.pathname, site).toString();

const pageTitle =
  'Microchanneling, Microneedling & Topical PRF: An Honest Guide | Punta Gorda, FL';
const pageDescription =
  'A plain-language guide to microchanneling, microneedling, and topically applied PRF at House of Rose Aesthetics in Punta Gorda, FL — how they differ, what each may help, realistic series, and how to choose.';

const breadcrumb = breadcrumbList([
  { name: 'Home', item: site },
  { name: 'Guides', item: `${site}guides/` },
  { name: 'Microchanneling, Microneedling & Topical PRF', item: canonical },
]);
const articleSchema = article(
  { headline: 'Microchanneling, Microneedling & Topical PRF: An Honest Guide', description: pageDescription, url: canonical, image: new URL(HERO_IMG, site).toString() },
  site,
);
const faqLd = faqPage(faqs);
---

<BaseLayout title={pageTitle} description={pageDescription} image={HERO_IMG} preloadImage={HERO_IMG}>
  <script is:inline type="application/ld+json" set:html={jsonLd(breadcrumb)} slot="head" />
  <script is:inline type="application/ld+json" set:html={jsonLd(articleSchema)} slot="head" />
  {faqLd && <script is:inline type="application/ld+json" set:html={jsonLd(faqLd)} slot="head" />}

  <Hero
    title={'Microchanneling, Microneedling\n& Topical PRF'}
    kicker="An Honest Guide"
    description="What they actually are, how they differ, what each may help — and how we help you choose. No hype, no promises we can’t keep."
    size="small"
    showCTA={true}
    ctaPrimary={{ text: `Call or Text ${PHONE_DISPLAY}`, href: PHONE_TEL }}
    ctaSecondary={{ text: 'Compare the two →', href: '/compare/prf-microchanneling-vs-microneedling/' }}
    backgroundImage={HERO_IMG}
  />

  <!-- The short answer (executive summary, answer-first) -->
  <section class="bg-charcoal py-[clamp(48px,7vw,96px)] px-6">
    <div class="max-w-[820px] mx-auto">
      <span class="kicker">The Short Answer</span>
      <h2 class="font-serif text-[clamp(24px,3.6vw,40px)] text-ink leading-tight mt-2 mb-6">
        It’s not “stronger vs. gentler.” It’s the right tool for your skin.
      </h2>
      <div class="space-y-5 text-[#9a8c78] text-[16px] leading-[1.85]">
        <p>
          <a href="/services/microchanneling/" class={link}>Microchanneling</a> and
          <a href="/services/microchanneling-microneedling/" class={link}>microneedling</a> are both
          controlled-needling treatments designed to support the <em>appearance</em> of skin texture,
          fine lines, certain scars, and stretch marks over time. The best choice isn’t simply the
          more aggressive one — it depends on your concern, the treatment area, your skin history,
          your tolerance for downtime, and the device and protocol your licensed provider selects.
        </p>
        <p>
          <a href="/services/prf/" class={link}>Topical PRF</a> is an optional, autologous add-on made
          from your <strong>own blood</strong> and applied on the surface during a needling treatment.
          It’s different from PRF injections and from ProCell’s own topical products. It may suit a
          client who values an autologous approach, but it adds a blood draw, cost, and clinical
          screening — and it is <strong>topical only</strong>: it is never injected or delivered into
          the skin.
        </p>
        <p class="text-ink/80">
          Results are individual. A series is common, and improvement develops gradually as the skin
          remodels — so no treatment here promises a specific degree of improvement or a permanent
          result. Want the side-by-side?
          <a href="/compare/prf-microchanneling-vs-microneedling/" class={link}>See PRF microchanneling vs. microneedling →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Microchanneling vs microneedling -->
  <section class="bg-charcoal-light py-[clamp(48px,7vw,96px)] px-6 border-t border-gold/10">
    <div class="max-w-[1080px] mx-auto">
      <div class="max-w-[760px] mb-12">
        <span class="kicker">The Useful Distinction</span>
        <h2 class="font-serif text-[clamp(24px,4vw,40px)] text-ink mt-2 mb-4">
          Microchanneling vs. microneedling
        </h2>
        <p class="text-[#9a8c78] text-[15px] leading-[1.8]">
          Both use many tiny needles to create controlled punctures in the skin. “Microchanneling”
          is often a brand/protocol term for a precise, stamping-style system; “microneedling” is the
          broader category, which can include pen, stamp, or roller devices. The words alone don’t tell
          you the depth, sterility practice, topical ingredients, or expected result — the protocol does.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-gold/15">
        <article class="flex flex-col bg-breath p-8">
          <h3 class="font-serif text-[22px] text-ink leading-tight mb-3">
            <a href="/services/microchanneling/" class="hover:text-gold transition-colors">When microchanneling is the better start</a>
          </h3>
          <p class="text-ink/75 text-[14px] leading-[1.75]">
            A structured, provider-selected <a href="/services/microchanneling/" class={link}>ProCell protocol</a>
            suits visible texture, fine lines, dull-looking skin, enlarged-looking pores, or mild unevenness —
            with a recovery plan that fits your schedule. It’s a reasonable choice when the goal is a
            carefully controlled facial or approved body-area protocol rather than an aggressive one-off.
          </p>
        </article>
        <article class="flex flex-col bg-breath p-8">
          <h3 class="font-serif text-[22px] text-ink leading-tight mb-3">
            <a href="/services/microchanneling-microneedling/" class="hover:text-gold transition-colors">When microneedling is the better term</a>
          </h3>
          <p class="text-ink/75 text-[14px] leading-[1.75]">
            When the <a href="/services/microchanneling-microneedling/" class={link}>exact device and protocol</a> —
            not the brand — are the basis of the recommendation. Your provider may choose a different
            device or setting for a specific concern, area, scar pattern, or skin history. The term
            shouldn’t imply that every device or body area has the same FDA-reviewed use.
          </p>
        </article>
      </div>
      <div class="mt-8 max-w-[760px]">
        <p class="text-[#7a6e5c] text-[13px] leading-[1.8]">
          <span class="text-gold">Neither term should imply</span> a cure for acne, rosacea, eczema, or
          hair loss; erasure of scars or stretch marks; a safe protocol for every skin tone or medication
          history; or that an at-home roller can replace a professionally screened treatment.
        </p>
      </div>
    </div>
  </section>

  <!-- ProCell protocol vs topical PRF -->
  <section class="bg-charcoal py-[clamp(48px,7vw,96px)] px-6 border-t border-gold/10">
    <div class="max-w-[960px] mx-auto">
      <div class="max-w-[760px] mb-10">
        <span class="kicker">What’s Delivered</span>
        <h2 class="font-serif text-[clamp(24px,4vw,40px)] text-ink mt-2 mb-4">
          The ProCell topical protocol vs. topical PRF
        </h2>
        <p class="text-[#9a8c78] text-[15px] leading-[1.8]">
          These are the “what’s applied” layer during a needling treatment — not treatments of their own.
          Your <a href="/services/microchanneling/" class={link}>ProCell protocol</a> is selected after a
          skin and candidacy review; the exact device setting, topical product, and expected recovery are
          explained before treatment. <a href="/services/prf/" class={link}>Topical PRF</a> is an
          alternative, autologous add-on.
        </p>
        <p class="text-[#9a8c78] text-[15px] leading-[1.8] mt-4">
          The ProCell topical comes in two tiers: <strong class="text-ink/80">ProCell Pro</strong>, the
          professional growth-factor serum for maintenance and prevention, and
          <strong class="text-ink/80">ProCell MD</strong>, which carries roughly twice the growth factors and
          is the go-to for age-related concerns (often 40+). Which tier fits your skin is confirmed at your
          consultation.
        </p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-left">
          <thead>
            <tr class="border-b border-gold/20">
              <th class="py-4 pr-4 text-[11px] tracking-[0.2em] uppercase text-ink/50 font-normal"></th>
              <th class="py-4 px-4 text-[13px] tracking-[0.08em] text-gold font-medium">ProCell topical protocol</th>
              <th class="py-4 px-4 text-[13px] tracking-[0.08em] text-gold font-medium">Topical PRF adjunct</th>
            </tr>
          </thead>
          <tbody class="align-top">
            <tr class="border-b border-ink/5">
              <td class="py-4 pr-4 text-ink/70 text-[14px] font-medium">What it is</td>
              <td class="py-4 px-4 text-[#999] text-[14px]">A manufacturer-specified professional topical used as part of a ProCell protocol.</td>
              <td class="py-4 px-4 text-[#999] text-[14px]">A preparation made from your own blood sample, applied topically during the visit.</td>
            </tr>
            <tr class="border-b border-ink/5">
              <td class="py-4 pr-4 text-ink/70 text-[14px] font-medium">What the visit adds</td>
              <td class="py-4 px-4 text-[#999] text-[14px]">Product selection and ingredient screening.</td>
              <td class="py-4 px-4 text-[#999] text-[14px]">A blood draw, preparation, extra clinical screening, and time.</td>
            </tr>
            <tr class="border-b border-ink/5">
              <td class="py-4 pr-4 text-ink/70 text-[14px] font-medium">Best conversation for</td>
              <td class="py-4 px-4 text-[#999] text-[14px]">A streamlined branded protocol when your ingredient history fits the product.</td>
              <td class="py-4 px-4 text-[#999] text-[14px]">Clients drawn to an autologous add-on who are appropriate for the blood draw and needling protocol.</td>
            </tr>
            <tr class="border-b border-ink/5">
              <td class="py-4 pr-4 text-ink/70 text-[14px] font-medium">What we won’t promise</td>
              <td class="py-4 px-4 text-[#999] text-[14px]">That a proprietary topical will outperform every option for every client.</td>
              <td class="py-4 px-4 text-[#999] text-[14px]">That PRF is delivered to a set skin layer, replaces injections, or guarantees a result.</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="mt-8 border-l-2 border-gold/30 pl-6 max-w-[760px]">
        <p class="text-[#9a8c78] text-[14px] leading-[1.85]">
          <span class="text-gold">An important distinction:</span> the FDA states that microneedling
          devices are not authorized to deliver blood products into the skin. So at House of Rose, PRF is
          prepared from your own blood and <strong>applied topically</strong> during the protocol —
          Amber’s PRF offering is topical only. Injectable PRF is a separate, RN-led service:
          see <a href="/services/prf-injections/" class={link}>PRF under-eye &amp; facial rejuvenation</a>
          and <a href="/services/prf-body-treatments/" class={link}>PRF body treatments</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- By concern -->
  <section class="bg-charcoal-light py-[clamp(48px,7vw,96px)] px-6 border-t border-gold/10">
    <div class="max-w-[1080px] mx-auto">
      <div class="max-w-[760px] mb-10">
        <span class="kicker">What It May Help</span>
        <h2 class="font-serif text-[clamp(24px,4vw,40px)] text-ink mt-2 mb-4">
          Realistic outcomes, by concern
        </h2>
        <p class="text-[#9a8c78] text-[15px] leading-[1.8]">
          What needling-based treatment may help with — and where its limits are. Tap any concern to
          see every matching option, or add a <a href="/services/glo2facial/" class={link}>Glo2Facial</a>
          or <a href="/services/biorepeel/" class={link}>BioRePeel</a> finish where it fits.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-gold/15">
        {concerns.map((c) => (
          <a href={c.href} class="group flex flex-col bg-breath p-8 transition-colors hover:bg-charcoal">
            <h3 class="font-serif text-[20px] text-ink leading-tight mb-3 group-hover:text-gold transition-colors">{c.title}</h3>
            <p class="text-ink/75 text-[14px] leading-[1.75] mb-5">{c.body}</p>
            <span class="learn-more mt-auto">See {c.hrefLabel} →</span>
          </a>
        ))}
      </div>
      <p class="text-[#7a6e5c] text-[12px] leading-[1.8] mt-8 max-w-[760px]">
        Surgical or traumatic scars, and reactive areas like the neck and décolleté, are considered only
        after the treating clinician approves the area and setting. We never needle open, infected,
        irritated, sunburned, or poorly healed skin.
      </p>
    </div>
  </section>

  <!-- Cadence / how many -->
  <section class="bg-walnut py-[clamp(44px,6vw,88px)] px-6 border-t border-gold/10">
    <div class="max-w-[820px] mx-auto">
      <span class="block text-gold text-[11px] tracking-[0.3em] uppercase mb-4">How Many Treatments?</span>
      <h2 class="font-serif text-[clamp(22px,3.6vw,36px)] text-ivory leading-tight mb-6">
        Most corrective goals are a series — not a single visit.
      </h2>
      <div class="space-y-5 text-ivory/75 text-[16px] leading-[1.85]">
        <p>
          Most corrective goals call for a series, often <strong>three to six visits about four to six
          weeks apart</strong>, then individualized maintenance. Your provider may recommend fewer, more,
          or a different option after reviewing the concern, your skin history, and how you recover.
          Body skin is thicker, so a longer series is realistic there.
        </p>
        <p class="text-ivory/70">
          We don’t publish a universal session count, depth, or PRF recommendation as a rule — those are
          the provider’s call. Curious about the numbers?
          <a href="/cost/prf-microneedling-cost-punta-gorda/" class="text-gold underline decoration-gold/40 underline-offset-4 hover:decoration-gold transition-colors">See what PRF microneedling costs in Punta Gorda →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Candidacy / recovery / safety -->
  <section class="bg-charcoal py-[clamp(48px,7vw,96px)] px-6 border-t border-gold/10">
    <div class="max-w-[960px] mx-auto">
      <div class="max-w-[760px] mb-10">
        <span class="kicker">Candidacy, Recovery &amp; Safety</span>
        <h2 class="font-serif text-[clamp(24px,4vw,40px)] text-ink mt-2 mb-4">
          What to expect — and when to wait
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        <div class="border-l-2 border-gold/30 pl-6">
          <h3 class="font-serif text-[20px] text-ink mb-3">Normal short-term recovery</h3>
          <p class="text-[#9a8c78] text-[14px] leading-[1.8]">
            Redness, tightness, dryness, roughness, itching, peeling, tenderness, bruising, pinpoint
            bleeding, or crusting can occur. The window varies with the device, depth, area, and your
            skin — so we give written aftercare rather than promising a fixed 24- or 72-hour timeline.
            An <a href="/services/lightstim-led-therapy/" class={link}>LED therapy</a> add-on may be used
            to calm and support the skin afterward.
          </p>
        </div>
        <div class="border-l-2 border-gold/30 pl-6">
          <h3 class="font-serif text-[20px] text-ink mb-3">When to postpone or check with us</h3>
          <p class="text-[#9a8c78] text-[14px] leading-[1.8]">
            Active skin infection or rash, a current cold-sore outbreak, uncontrolled diabetes, immune
            suppression, bleeding/clotting disorders or anticoagulants, recent isotretinoin, a history of
            keloid scarring, certain autoimmune conditions, pregnancy or breastfeeding, planned sun
            exposure, or material/topical allergies all warrant provider review. This is a screening
            guide, not a full list — your provider makes the actual candidacy decision.
          </p>
        </div>
      </div>
      <div class="mt-10 max-w-[760px]">
        <p class="text-[#9a8c78] text-[14px] leading-[1.85]">
          Our house standard: a new single-use cartridge for every client and every session, and a
          trained, licensed provider who confirms candidacy, area, device setting, topical choice, and
          aftercare. The best place to start is a
          <a href="/skin-analysis/" class={link}>skin analysis &amp; consultation</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-charcoal-light py-[clamp(48px,7vw,96px)] px-6 border-t border-gold/10">
    <div class="max-w-[820px] mx-auto">
      <h2 class="font-serif text-[clamp(24px,4vw,38px)] text-ink mb-8 text-center">Common Questions</h2>
      <div class="space-y-6">
        {faqs.map((f) => (
          <div class="border-b border-ink/10 pb-6">
            <h3 class="font-serif text-[18px] text-ink mb-2">{f.question}</h3>
            <p class="text-[#9a8c78] text-[14px] leading-[1.8]">{f.answer}</p>
          </div>
        ))}
      </div>
      <p class="text-center text-[13px] mt-8">
        <a href="/faq/" class={link}>Browse all questions &amp; answers →</a>
      </p>
    </div>
  </section>

  <!-- Explore more / cross-link funnel -->
  <section class="bg-charcoal py-[clamp(48px,7vw,88px)] px-6 border-t border-gold/10">
    <div class="max-w-[1080px] mx-auto">
      <h2 class="font-serif text-[clamp(22px,3.4vw,32px)] text-ink mb-8 text-center">Keep Exploring</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-gold/15">
        {exploreLinks.map((l) => (
          <a href={l.href} class="group flex flex-col bg-breath p-8 transition-colors hover:bg-charcoal-light">
            <h3 class="font-serif text-[19px] text-ink mb-2 group-hover:text-gold transition-colors">{l.label}</h3>
            <p class="text-[#9a8c78] text-[13.5px] leading-[1.7] mb-4">{l.description}</p>
            <span class="learn-more mt-auto">Learn more →</span>
          </a>
        ))}
      </div>
      <p class="text-center text-[#7a6e5c] text-[13px] mt-8">
        Serving <a href="/areas/punta-gorda/" class={link}>Punta Gorda &amp; Charlotte County</a>, SW Florida.
      </p>
    </div>
  </section>

  <!-- Booking CTA -->
  <section class="bg-charcoal-light py-[clamp(48px,7vw,88px)] px-6 border-t border-gold/15">
    <div class="max-w-[640px] mx-auto text-center">
      <span class="kicker">Start With a Conversation</span>
