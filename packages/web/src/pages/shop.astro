---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import PromoBanner from '@/components/shop/PromoBanner.astro';
import TopSellers from '@/components/shop/TopSellers.astro';
import CategoryNav from '@/components/shop/CategoryNav.astro';
import BrandSpotlight from '@/components/shop/BrandSpotlight.astro';
import { sanityFetch } from '@/lib/sanity';
import {
  ALL_PRODUCTS_QUERY,
  ALL_PROMOTIONS_QUERY,
  ALL_SHOP_BRANDS_QUERY,
  type Product,
  type Promotion,
  type ShopBrand,
  type ProductBrand,
} from '@/lib/queries';
import { toCanonicalProduct } from '@/lib/productContract';

const [products, promotions, shopBrands] = await Promise.all([
  sanityFetch<Product[]>(ALL_PRODUCTS_QUERY),
  sanityFetch<Promotion[]>(ALL_PROMOTIONS_QUERY),
  sanityFetch<ShopBrand[]>(ALL_SHOP_BRANDS_QUERY),
]);

// Fallback copy for any carried brand that doesn't have a shopBrand document
// yet in Sanity — keeps the page from looking empty while editors backfill
// real brand story content in the Studio.
const FALLBACK_BRAND_COPY: Record<ProductBrand, string> = {
  procell:
    'The aftercare system behind our microchanneling results. Growth-factor serums in two strengths — MD for clients in active treatment series, PRO for maintenance — because what you apply at home determines how far your in-studio results go.',
  glymed:
    'Professional pharmaceutical-grade skincare we prescribe around treatment cycles: barrier repair after peels, glycolic renewal between visits, recovery care, and the daily SPF that protects everything else.',
  'skin-script':
    'Approachable, results-driven daily care — clean formulations at honest prices. Where most clients start, and what most routines are built on.',
  'face-reality':
    'The #1 professional acne line, and the backbone of our Face Reality 12-Week Program. Mandelic and glycolic serums, benzoyl peroxide treatments, gentle cleansers, and barrier care — matched to your acne type and adjusted as your skin responds.',
  'house-of-rose':
    'House of Rose exclusives — the pieces we couldn\'t find anywhere else, so we made them ourselves.',
};

const BRAND_ORDER: ProductBrand[] = ['procell', 'glymed', 'skin-script', 'face-reality', 'house-of-rose'];
const BRAND_TITLES: Record<ProductBrand, string> = {
  procell: 'Procell Therapies',
  glymed: 'GlyMed+',
  'skin-script': 'Skin Script',
  'face-reality': 'Face Reality',
  'house-of-rose': 'House of Rose',
};

const byBrand = (id: ProductBrand): Product[] => products.filter((p) => p.brand === id);

const resolveShopBrand = (id: ProductBrand): ShopBrand => {
  const fromSanity = shopBrands.find((b) => b.brandKey === id);
  if (fromSanity) return fromSanity;
  return {
    _id: `fallback-${id}`,
    title: BRAND_TITLES[id],
    brandKey: id,
    story: FALLBACK_BRAND_COPY[id],
  };
};

const orderingOptions = [
  {
    title: 'In Studio',
    body: 'Browse the shelf at your next visit — your provider will match products to your active treatment plan.',
  },
  {
    title: 'Reserve & Pick Up',
    body: 'Call and we\'ll confirm when your products can be wrapped and ready at the front desk.',
  },
  {
    title: 'We\'ll Ship It',
    body: 'Out of town or out of product? We ship anywhere in the U.S. — call us and it\'s on its way.',
  },
];

const heroImage = '/images/welcome-house-of-rose.webp';
const measurementItems = products.map((product, index) => {
  const canonical = toCanonicalProduct(product);
  return {
    item_id: canonical.itemId,
    item_name: canonical.itemName,
    item_brand: canonical.brand,
    item_category: canonical.category,
    price: canonical.unitPriceCents !== undefined ? canonical.unitPriceCents / 100 : undefined,
    index,
    item_list_id: 'shop',
    item_list_name: 'House of Rose Shop',
  };
});
---

<BaseLayout
  title="Shop | House of Rose Punta Gorda, FL"
  description="Shop professional skincare selected by House of Rose, including procell aftercare, GlyMed+, Skin Script, Face Reality, and gift cards."
  image={heroImage}
  preloadImage={heroImage}
>
  <Hero
    title="Professional skincare for real routines."
    kicker="The Shop"
    description="We carry products that support the treatments we perform, help with aftercare, or make sense in a daily routine. If you're unsure what fits, ask us before you buy."
    size="small"
    showCTA={false}
    backgroundImage={heroImage}
  />

  <PromoBanner promotions={promotions} />

  <script
    is:inline
    id="shop-product-measurement"
    type="application/json"
    set:html={JSON.stringify(measurementItems)}
  ></script>

  <TopSellers products={products} />

  <CategoryNav products={products} />

  {BRAND_ORDER.map((id) => (
    <BrandSpotlight brand={resolveShopBrand(id)} products={byBrand(id)} />
  ))}

  <!-- Jane Iredale remains available as a product line while its product catalog is backfilled. -->
  <section class="bg-charcoal-light py-[clamp(44px,6vw,72px)] px-6 border-t border-gold-metal/10">
    <a
      href="/shop/jane-iredale/"
      class="group grid max-w-[1080px] grid-cols-1 items-center gap-6 bg-breath p-8 transition-colors hover:bg-charcoal md:grid-cols-[1fr_auto] mx-auto"
    >
      <div>
        <span class="kicker">Mineral Makeup & Home Care</span>
        <h2 class="font-serif text-[clamp(24px,3.4vw,34px)] text-ink mt-2 mb-2">Jane Iredale</h2>
        <p class="text-muted text-[15px] leading-[1.75] max-w-[640px]">
          Explore Jane Iredale mineral makeup, skincare, supplements, product benefits, and routine swaps.
        </p>
      </div>
      <span class="learn-more whitespace-nowrap">Explore Jane Iredale →</span>
    </a>
  </section>

  <!-- Face Reality — Face Reality 12-Week Program guidance -->
  <section class="bg-charcoal-light py-[clamp(28px,4vw,44px)] px-6">
    <div class="max-w-[840px] mx-auto text-center" data-reveal="bottom">
      <p class="text-muted text-[14px] leading-[1.8] max-w-[640px] mx-auto">
        New to Face Reality? These are prescribed by acne type and adjusted as your skin responds — so if you're unsure where to start,
        <a href="/services/face-reality-acne-program/" class="text-gold hover:underline">begin with the Face Reality 12-Week Program</a> and we'll build your routine.
      </p>
    </div>
  </section>

  <!-- Ordering -->
  <section class="bg-charcoal py-[clamp(48px,7vw,80px)] px-6 border-t border-gold-metal/10">
    <div class="max-w-[1120px] mx-auto">
      <div class="text-center mb-12" data-reveal="bottom" data-speed="fast">
        <span class="kicker">How to Order</span>
        <h2 class="font-serif text-[clamp(24px,4vw,36px)] text-ink mt-2">
          Three ways, all of them easy.
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12" data-stagger="100">
        {orderingOptions.map((opt, i) => (
          <div class="text-center" data-reveal="bottom">
            <p class="text-gold text-[40px] font-serif mb-3">{`0${i + 1}`}</p>
            <p class="text-ink text-[16px] font-medium mb-2 tracking-wide">{opt.title}</p>
            <p class="text-muted text-[14px] leading-relaxed max-w-[300px] mx-auto">{opt.body}</p>
          </div>
        ))}
      </div>
      <div class="text-center" data-reveal="scale" data-speed="fast">
        <a href="tel:+18449417673" class="btn-gold">Call to Order — (844) 941-7673</a>
        <p class="text-muted text-[12px] mt-5">Bundle clients receive preferred pricing on full-size products — mention it when you order.</p>
      </div>
    </div>
  </section>

  <script>
    import { dispatchMeasurement, type RetailItem } from '@/lib/measurement';

    const measureProductList = (): void => {
      const data = document.getElementById('shop-product-measurement');
      if (!data || data.dataset.measured === 'true') return;
      data.dataset.measured = 'true';
      try {
        const items = JSON.parse(data.textContent ?? '[]') as RetailItem[];
        dispatchMeasurement({
          event: 'view_item_list',
          ecommerce: {
            currency: 'USD',
            value: items.reduce(
              (sum, item) => sum + (item.price ?? 0) * (item.quantity ?? 1),
              0,
            ),
            items,
          },
        });
      } catch {
        // Invalid embedded product data should not affect the shop experience.
      }
    };

    measureProductList();
  </script>
</BaseLayout>
