# ─── House of Rose — Environment Variables ────────────────────────────────────
# Copy to .env.local for local development.
# NEVER commit .env.local — it is gitignored.

# Sanity
# PUBLIC_ values are browser-safe config only.
PUBLIC_SANITY_PROJECT_ID=4e7axyi7
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2025-04-26

# Server-only. Required for Netlify Functions that save form submissions to Sanity.
# Do not rename this to PUBLIC_SANITY_API_WRITE_TOKEN.
SANITY_API_WRITE_TOKEN=      # sk... token with create permissions for leadSubmission

# Site
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_BOOKING_EMAIL=book@houseofrose.com

# Resend privacy support form (server-only)
# Domain: updates.houseofrosefl.com
# Tracking subdomain configured in Resend: links.updates.houseofrosefl.com
RESEND_API_KEY=              # re_... token (server-only, never expose publicly)
PRIVACY_SUPPORT_FROM="House of Rose Privacy Support <support@updates.houseofrosefl.com>"
PRIVACY_SUPPORT_TO=info@houseofrosefl.com

# Lead-submission notifications → Gmail via Zapier (server-only).
# The lead-submit function POSTs each new lead to this Zapier Catch Hook; a
# 2-step Zap (Webhooks "Catch Hook" → Gmail "Send Email") sends the alert.
# Reuses the Gmail account already connected in Zapier — no Gmail creds here.
# If LEAD_NOTIFY_ZAP_HOOK_URL is unset, notifications are simply skipped.
LEAD_NOTIFY_ZAP_HOOK_URL=        # https://hooks.zapier.com/hooks/catch/XXXX/YYYY/
LEAD_NOTIFY_TO=info@houseofrosefl.com   # passed in payload as notifyTo (optional)
