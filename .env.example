# ─── House of Rose — Environment Variables ────────────────────────────────────
# Copy to packages/web/.env.local for local development.
# NEVER commit .env.local — it is gitignored.

# Sanity (packages/web — prefix with PUBLIC_ to expose to browser)
PUBLIC_SANITY_PROJECT_ID=4e7axyi7
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2025-04-26
SANITY_API_READ_TOKEN=       # sk... token (server-only, never expose publicly)

# Site
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_BOOKING_EMAIL=book@houseofrose.com
