# ─── House of Rose — Environment Variables ────────────────────────────────────
# Copy to .env.local for local development.
# NEVER commit .env.local — it is gitignored.

# Sanity
# PUBLIC_ values are browser-safe config only.
PUBLIC_SANITY_PROJECT_ID=4e7axyi7
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2025-04-26

# Server-only. Required for Netlify Functions that save form submissions to Sanity.
# Do not rename this to PUBLIC_SANITY_API_WRITE_TOKEN.
SANITY_API_WRITE_TOKEN=      # sk... token with create permissions for leadSubmission

# Site
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_BOOKING_EMAIL=info@houseofrosefl.com
# Set true to show the full-screen coming-soon gate on every public page.
PUBLIC_COMING_SOON=false

# Google measurement (browser-safe identifier only)
# Used by both the Astro loader and Netlify's first-party /metrics/ gateway.
PUBLIC_GTM_ID=GTM-NSDKJFP9

# Mapbox GL JS, Search Box autocomplete, and driving directions on /contact/.
# Browser-safe public token only (starts with pk.). Use a domain-restricted token
# in production and a separate development token locally. Never expose an sk. token.
PUBLIC_MAPBOX_ACCESS_TOKEN=

# ─── Netlify Visual Editor (Stackbit) — DEV ONLY ──────────────────────────────
# Read by stackbit.config.ts to let the visual editor read/write the SAME Sanity
# project (no second CMS). stackbit.config.ts auto-loads .env.local, so these can
# live alongside the vars above. In the Visual Editor cloud container, set these
# in the project's env settings instead.
SANITY_PROJECT_ID=4e7axyi7
SANITY_DATASET=production
SANITY_STUDIO_URL=https://studio.houseofrosefl.com
# Editor (Robot) token with read+write — create at sanity.io/manage → API → Tokens.
# Needs write for two-way sync. Never commit the real value.
SANITY_ACCESS_TOKEN=         # sk... Sanity token with Editor permissions

# Resend privacy support form (server-only)
# Domain: updates.houseofrosefl.com
# Tracking subdomain configured in Resend: links.updates.houseofrosefl.com
RESEND_API_KEY=              # re_... token (server-only, never expose publicly)
PRIVACY_SUPPORT_FROM="House of Rose Privacy Support <support@updates.houseofrosefl.com>"
PRIVACY_SUPPORT_TO=info@houseofrosefl.com

# Consent-aware conversion verification
# Generate a long random value for signed, one-use lead measurement receipts.
LEAD_MEASUREMENT_SECRET=

# Commerce (server-only values remain in Netlify/local environment settings)
PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_ENABLED=false
# Optional Stripe tax code for shipping charges.
STRIPE_SHIPPING_TAX_CODE=
SHIPPO_API_KEY=
SANITY_WEBHOOK_SECRET=
# Netlify build hook used only by the signed eligible-product rebuild webhook.
NETLIFY_COMMERCE_BUILD_HOOK_URL=

# Google Data Manager offline service goals.
# Keep imports disabled until browser measurement, webhook signing, and a
# validation-only reconciliation have passed.
GOOGLE_ADS_CUSTOMER_ID=492-149-3013
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_QUALIFIED_LEAD_ACTION_ID=
GOOGLE_ADS_CONSULTATION_BOOKED_ACTION_ID=
GOOGLE_ADS_COMPLETED_BOOKING_ACTION_ID=
GOOGLE_ADS_QUALIFIED_LEAD_ACTION_NAME=
GOOGLE_ADS_CONSULTATION_BOOKED_ACTION_NAME=
GOOGLE_ADS_COMPLETED_BOOKING_ACTION_NAME=
GOOGLE_OFFLINE_IMPORTS_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
