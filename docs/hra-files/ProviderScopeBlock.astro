---
import { sbFieldPath, sbFieldPathParts } from '@/lib/visualEditing';
import { performedByLabel, type TreatmentProviderScope } from '@/lib/treatmentQueries';

interface Props {
  providerScope: TreatmentProviderScope;
  treatmentName: string;
}

const { providerScope, treatmentName } = Astro.props;

/**
 * Two statutory requirements are met here, not one.
 *
 * 1. § 456.072(1)(t) — wherever a practitioner is named, the LICENSE TYPE must
 *    appear. "Injector", "Provider", and "Skin Specialist" satisfy nothing.
 *    `performedByLabel` returns RN / licensed esthetician for that reason.
 *
 * 2. The medical director attribution line is canonical and fixed. It lives in
 *    CLAUDE.md and is deliberately not editable per-service — a typo in a licence
 *    number is a § 456.072 problem, not a copy problem.
 *
 * Never imply the medical director performs treatments, is on site, or holds a
 * dermatology specialty. R. 64B8-11.001(2)(a) and (2)(k) are violated by
 * implication alone; his NPI taxonomy is Surgery.
 */
const MEDICAL_DIRECTOR = 'Medical Director: Joshua Shaw, MD · FL Lic. ME136232';

const scopeLine = providerScope.medicalDirection
  ? `${performedByLabel(providerScope.performedBy)}, under written physician protocol and medical direction`
  : performedByLabel(providerScope.performedBy);
---

<div>
  <span class="kicker">Who Performs It</span>
  <h2 class="font-serif text-[clamp(25px,3.6vw,36px)] text-ink mt-2 mb-5">
    Who performs {treatmentName} at House of Rose?
  </h2>

  <p class="text-ink text-[17px] leading-[1.7] mb-7" {...sbFieldPath('providerScope.performedBy')}>
    {scopeLine}.
  </p>

  <ul class="space-y-3 mb-8">
    {providerScope.credentialPoints.map((point, i) => (
      <li class="flex gap-3 text-muted text-[15px] leading-relaxed">
        <span class="text-gold mt-0.5 shrink-0" aria-hidden="true">✦</span>
        <span {...sbFieldPathParts('providerScope.credentialPoints', i)}>{point}</span>
      </li>
    ))}
  </ul>

  {providerScope.consultRequired !== false && (
    <p class="text-muted text-[14px] leading-relaxed mb-7 border-l border-gold-metal/40 pl-5 py-1">
      A consultation is completed before treatment to confirm you are a candidate.
    </p>
  )}

  {providerScope.medicalDirection && (
    <p class="text-muted text-[13px] leading-relaxed mb-5">{MEDICAL_DIRECTOR}</p>
  )}

  <p
    class="text-muted/70 text-[12px] leading-[1.7] pt-6 border-t border-gold-metal/10"
    {...sbFieldPath('providerScope.disclaimer')}
  >
    {providerScope.disclaimer}
  </p>
</div>
