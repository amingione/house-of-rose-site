---
// src/pages/areas/port-charlotte.astro — location page for Port Charlotte (Charlotte County, minutes from your studio).
// You're in Punta Gorda; Port Charlotte is your immediate neighbor — strongest, easiest local market to own.
// ⚕️ Medical director should review clinical references.
import Layout from "../../layouts/Layout.astro"; // TODO: your real layout
import SchemaFAQ from "../../components/seo/SchemaFAQ.astro";
import SchemaBreadcrumb from "../../components/seo/SchemaBreadcrumb.astro";

const title = "Med Spa Serving Port Charlotte, FL | House of Rose Aesthetics";
const description =
  "House of Rose Aesthetics is a boutique medical spa serving Port Charlotte, FL — Morpheus8, microneedling, PRF/PRP, injectables, lip fillers, IV hydration therapy and more, minutes away in Punta Gorda. Book a consultation.";

const services = [
  { name: "Morpheus8 (skin tightening)", url: "/services/morpheus8/" },
  { name: "Microneedling", url: "/services/microneedling/" },
  { name: "PRP Microneedling", url: "/services/prp-microneedling/" },
  { name: "PRF (under-eye, skin & hair)", url: "/services/prf/" },
  { name: "Microchanneling", url: "/services/microchanneling/" },
  { name: "BioRePeel", url: "/services/biorepeel/" },
  { name: "Botox & Injectables", url: "/services/botox/" },
  { name: "Dermal Fillers", url: "/services/dermal-fillers/" },
  { name: "Lip Fillers", url: "/services/lip-fillers/" },
  { name: "IV Hydration Therapy", url: "/services/iv-hydration-therapy/" },
  { name: "Facials", url: "/services/facials/" },
  { name: "Skin Analysis", url: "/services/skin-analysis/" },
];

const faqItems = [
  { q: "Does House of Rose Aesthetics serve Port Charlotte?", a: "Absolutely. Our boutique medical spa is located right next door in Punta Gorda, just minutes from Port Charlotte, and many of our clients come from the Port Charlotte area. We're your neighborhood med spa for advanced skincare and injectables." },
  { q: "How far is House of Rose from Port Charlotte?", a: "We're only a short drive away in Punta Gorda — typically about 10 to 15 minutes from most of Port Charlotte. Exact address and directions are on our contact page." },
  { q: "What treatments do you offer Port Charlotte clients?", a: "Everything from Morpheus8 RF skin tightening, microneedling, PRP microneedling and PRF, to Botox and injectables, dermal and lip fillers, microchanneling, BioRePeel, IV hydration therapy, facials and skin analysis." },
  { q: "How do I book an appointment?", a: "Request a complimentary consultation online or call us. We'll recommend the right treatment plan and find a convenient time." },
];
---
<Layout title={title} description={description}>
  <SchemaFAQ items={faqItems} />
  <SchemaBreadcrumb items={[{ name: "Areas We Serve", url: "/areas/" }, { name: "Port Charlotte", url: "/areas/port-charlotte/" }]} />

  <article class="area-page">
    <header class="area-hero">
      <p class="eyebrow">Areas We Serve</p>
      <h1>Your Med Spa Near Port Charlotte, FL</h1>
      <p class="subhead">Boutique, personalized aesthetics minutes from Port Charlotte — Morpheus8, microneedling, PRF/PRP, injectables, fillers, IV therapy and more, right next door in Punta Gorda.</p>
      <a class="cta" href="/contact/">Book your complimentary consultation</a>
    </header>

    <section>
      <h2>Hello, Port Charlotte neighbors</h2>
      <p>House of Rose Aesthetics is proud to be a trusted medical spa for the <strong>Port Charlotte</strong> community. Located just minutes away in Punta Gorda, we offer advanced treatments with the unhurried, one-on-one care of a boutique practice — the same expert team every time you visit.</p>
    </section>

    <section>
      <h2>Treatments we offer</h2>
      <ul class="service-grid">
        {services.map((s) => (<li><a href={s.url}>{s.name}</a></li>))}
      </ul>
    </section>

    <section>
      <h2>Why Port Charlotte chooses House of Rose</h2>
      <ul class="benefit-list">
        <li>Minutes from Port Charlotte — a convenient local option</li>
        <li>Boutique, personalized care from a team you'll get to know</li>
        <li>Advanced technology (Morpheus8, PRF/PRP, microchanneling) in one place</li>
        <li>Natural-looking results and a consult-first approach</li>
      </ul>
    </section>

    <section>
      <h2>Visit us</h2>
      <p>We're located in Punta Gorda, a short drive from Port Charlotte. For our exact address, directions and hours, see our <a href="/contact/">contact page</a>.</p>
      <a class="cta" href="/contact/">Plan your visit</a>
    </section>

    <section class="faq">
      <h2>Port Charlotte FAQs</h2>
      {faqItems.map((item) => (<details><summary>{item.q}</summary><p>{item.a}</p></details>))}
    </section>
  </article>
</Layout>

<style>
  .area-page { max-width: 760px; margin: 0 auto; padding: 2rem 1.25rem 4rem; line-height: 1.65; }
  .area-hero { margin-bottom: 2.5rem; }
  .eyebrow { text-transform: uppercase; letter-spacing: .16em; font-size: .78rem; font-weight: 600; opacity: .7; margin: 0 0 .5rem; }
  h1 { font-size: clamp(1.9rem, 5vw, 2.75rem); line-height: 1.1; margin: 0 0 .8rem; text-wrap: balance; }
  .subhead { font-size: 1.1rem; opacity: .85; margin: 0 0 1.5rem; }
  section { margin-bottom: 2.25rem; }
  h2 { font-size: 1.5rem; margin: 0 0 .6rem; }
  .benefit-list { padding-left: 1.2rem; } .benefit-list li { margin-bottom: .4rem; }
  .service-grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: .5rem; }
  .service-grid a { display: block; padding: .7rem .9rem; border: 1px solid rgba(0,0,0,.12); border-radius: 10px; text-decoration: none; color: inherit; font-weight: 600; }
  .service-grid a:hover { border-color: #a23b57; color: #a23b57; }
  .cta { display: inline-block; padding: .8rem 1.4rem; border-radius: 999px; background: #a23b57; color: #fff; text-decoration: none; font-weight: 600; }
  .cta:hover { background: #7d2b41; }
  a { color: #a23b57; }
  .faq details { border-bottom: 1px solid rgba(0,0,0,.1); padding: .9rem 0; }
  .faq summary { font-weight: 600; cursor: pointer; font-size: 1.02rem; }
  .faq details p { margin: .7rem 0 0; opacity: .85; }
</style>
