---
// src/pages/areas/cape-coral.astro — location page targeting "med spa cape coral" (80/mo, KD 30).
// HONESTY: House of Rose is in Punta Gorda. Do NOT claim a Cape Coral address.
// Positions you as a Punta Gorda med spa serving Cape Coral clients a short drive away.
// ⚕️ Medical director should review clinical references.
import Layout from "../../layouts/Layout.astro"; // TODO: your real layout
import SchemaFAQ from "../../components/seo/SchemaFAQ.astro";
import SchemaBreadcrumb from "../../components/seo/SchemaBreadcrumb.astro";

const title = "Med Spa Serving Cape Coral, FL | House of Rose Aesthetics";
const description =
  "House of Rose Aesthetics is a boutique medical spa serving Cape Coral, FL — Morpheus8, microneedling, PRF/PRP, injectables, lip fillers, IV hydration therapy and more, a short drive away in Punta Gorda. Book a consultation.";

const services = [
  { name: "Morpheus8 (skin tightening)", url: "/services/morpheus8/" },
  { name: "Microneedling", url: "/services/microneedling/" },
  { name: "PRP Microneedling", url: "/services/prp-microneedling/" },
  { name: "PRF (under-eye, skin & hair)", url: "/services/prf/" },
  { name: "Microchanneling", url: "/services/microchanneling/" },
  { name: "BioRePeel", url: "/services/biorepeel/" },
  { name: "Botox & Injectables", url: "/services/botox/" },
  { name: "Dermal Fillers", url: "/services/dermal-fillers/" },
  { name: "Lip Fillers", url: "/services/lip-fillers/" },
  { name: "IV Hydration Therapy", url: "/services/iv-hydration-therapy/" },
  { name: "Facials", url: "/services/facials/" },
  { name: "Skin Analysis", url: "/services/skin-analysis/" },
];

const faqItems = [
  { q: "Does House of Rose Aesthetics serve Cape Coral?", a: "Yes. Our boutique medical spa is in Punta Gorda, and we welcome clients from Cape Coral and across Lee County. Many Cape Coral clients find the personalized, consult-first care worth the short drive north." },
  { q: "How far is House of Rose from Cape Coral?", a: "We're located in Punta Gorda, roughly a 40 to 55 minute drive from most of Cape Coral via US-41 or I-75. Our exact address and directions are on our contact page." },
  { q: "What treatments do you offer Cape Coral clients?", a: "Morpheus8 RF skin tightening, microneedling, PRP microneedling, PRF for under-eyes and hair, microchanneling, BioRePeel, Botox and injectables, dermal and lip fillers, IV hydration therapy, facials and skin analysis — all under one roof." },
  { q: "How do I book from Cape Coral?", a: "Request a complimentary consultation online or call us, and we'll match you with the right plan and a convenient time around your drive." },
];
---
<Layout title={title} description={description}>
  <SchemaFAQ items={faqItems} />
  <SchemaBreadcrumb items={[{ name: "Areas We Serve", url: "/areas/" }, { name: "Cape Coral", url: "/areas/cape-coral/" }]} />

  <article class="area-page">
    <header class="area-hero">
      <p class="eyebrow">Areas We Serve</p>
      <h1>A Medical Spa Serving Cape Coral, FL</h1>
      <p class="subhead">Boutique, personalized aesthetics for Cape Coral &amp; Lee County — Morpheus8, microneedling, PRF/PRP, injectables, fillers, IV therapy and more, a short drive north in Punta Gorda.</p>
      <a class="cta" href="/contact/">Book your complimentary consultation</a>
    </header>

    <section>
      <h2>Welcome, Cape Coral</h2>
      <p>House of Rose Aesthetics offers advanced, results-driven treatments with the attentive care of a boutique practice — and clients from <strong>Cape Coral</strong> are always welcome. From our studio in Punta Gorda, you'll get the same expert team every visit and honest, natural-looking results, without the high-volume feel of a chain.</p>
    </section>

    <section>
      <h2>Treatments we offer</h2>
      <ul class="service-grid">
        {services.map((s) => (<li><a href={s.url}>{s.name}</a></li>))}
      </ul>
    </section>

    <section>
      <h2>Why Cape Coral clients choose House of Rose</h2>
      <ul class="benefit-list">
        <li>Boutique, one-on-one care — not a high-volume chain</li>
        <li>Advanced technology (Morpheus8, PRF/PRP, microchanneling) in one place</li>
        <li>Honest, natural-looking results and a consult-first approach</li>
        <li>A straightforward drive north from Cape Coral</li>
      </ul>
    </section>

    <section>
      <h2>Getting here from Cape Coral</h2>
      <p>We're in Punta Gorda, about 40 to 55 minutes from most of Cape Coral. For our exact address, directions and hours, visit our <a href="/contact/">contact page</a>.</p>
      <a class="cta" href="/contact/">Plan your visit</a>
    </section>

    <section class="faq">
      <h2>Cape Coral FAQs</h2>
      {faqItems.map((item) => (<details><summary>{item.q}</summary><p>{item.a}</p></details>))}
    </section>
  </article>
</Layout>

<style>
  .area-page { max-width: 760px; margin: 0 auto; padding: 2rem 1.25rem 4rem; line-height: 1.65; }
  .area-hero { margin-bottom: 2.5rem; }
  .eyebrow { text-transform: uppercase; letter-spacing: .16em; font-size: .78rem; font-weight: 600; opacity: .7; margin: 0 0 .5rem; }
  h1 { font-size: clamp(1.9rem, 5vw, 2.75rem); line-height: 1.1; margin: 0 0 .8rem; text-wrap: balance; }
  .subhead { font-size: 1.1rem; opacity: .85; margin: 0 0 1.5rem; }
  section { margin-bottom: 2.25rem; }
  h2 { font-size: 1.5rem; margin: 0 0 .6rem; }
  .benefit-list { padding-left: 1.2rem; } .benefit-list li { margin-bottom: .4rem; }
  .service-grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: .5rem; }
  .service-grid a { display: block; padding: .7rem .9rem; border: 1px solid rgba(0,0,0,.12); border-radius: 10px; text-decoration: none; color: inherit; font-weight: 600; }
  .service-grid a:hover { border-color: #a23b57; color: #a23b57; }
  .cta { display: inline-block; padding: .8rem 1.4rem; border-radius: 999px; background: #a23b57; color: #fff; text-decoration: none; font-weight: 600; }
  .cta:hover { background: #7d2b41; }
  a { color: #a23b57; }
  .faq details { border-bottom: 1px solid rgba(0,0,0,.1); padding: .9rem 0; }
  .faq summary { font-weight: 600; cursor: pointer; font-size: 1.02rem; }
  .faq details p { margin: .7rem 0 0; opacity: .85; }
</style>
