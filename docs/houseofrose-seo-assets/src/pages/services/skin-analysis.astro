---
// src/pages/services/skin-analysis.astro — skin analysis / consultation (3,100/mo, KD 35). Funnel entry point.
// ⚕️ Medical director should review clinical claims.
import Layout from "../../layouts/Layout.astro"; // TODO: your real layout
import SchemaService from "../../components/seo/SchemaService.astro";
import SchemaFAQ from "../../components/seo/SchemaFAQ.astro";
import SchemaBreadcrumb from "../../components/seo/SchemaBreadcrumb.astro";

const title = "Skin Analysis & Consultation in Punta Gorda & Fort Myers, FL | House of Rose Aesthetics";
const description =
  "Start with a professional skin analysis at House of Rose Aesthetics — we assess your skin and build a personalized treatment plan for real, lasting results. Serving Punta Gorda, Port Charlotte, Fort Myers & Cape Coral.";

const faqItems = [
  { q: "What is a skin analysis?", a: "A skin analysis is a professional assessment of your skin's condition — hydration, texture, tone, pigmentation, pores, signs of aging and specific concerns like acne or sun damage. We use what we find to recommend the treatments and products that will actually move the needle for you, rather than guessing." },
  { q: "How much does a skin analysis cost?", a: "At House of Rose, your initial consultation and skin analysis is complimentary — it's how we get to know your skin and goals before recommending any treatment. If a specialized diagnostic add-on applies, we'll let you know in advance." },
  { q: "What happens during the appointment?", a: "We'll talk through your goals and skincare history, examine your skin, and discuss options. You'll leave with a clear, prioritized plan — which treatments, in what order, and a realistic sense of timeline and cost. There's no pressure and no obligation." },
  { q: "How should I prepare for a skin analysis?", a: "Come with clean skin if you can (or we'll cleanse for you), and bring a list of the products you currently use and any concerns or goals. If you're considering a specific treatment, jot down your questions so we can cover them." },
  { q: "Do I need a skin analysis before a treatment?", a: "For most treatments, yes — a quick assessment ensures the treatment is safe and right for your skin, and lets us customize it. It's the foundation of the natural, effective results we aim for." },
];
---
<Layout title={title} description={description}>
  <SchemaService name="Skin Analysis & Consultation" description={description} url={Astro.url.href}
    procedureType="Professional skin analysis and treatment consultation" bodyLocations={["Face", "Skin"]} />
  <SchemaFAQ items={faqItems} />
  <SchemaBreadcrumb items={[{ name: "Services", url: "/services/" }, { name: "Skin Analysis", url: "/services/skin-analysis/" }]} />

  <article class="service-page">
    <header class="service-hero">
      <p class="eyebrow">Start Here</p>
      <h1>Skin Analysis &amp; Consultation in Punta Gorda &amp; Fort Myers, FL</h1>
      <p class="subhead">Great results start with truly understanding your skin. Our complimentary skin analysis gives you a clear, personalized plan — no guesswork, no pressure.</p>
      <a class="cta" href="/contact/">Book your complimentary consultation</a>
    </header>

    <section>
      <h2>Why start with a skin analysis?</h2>
      <p>Before recommending any treatment, we take the time to understand your skin — its hydration, texture, tone, pigmentation and specific concerns — and your goals. That's how we build a plan that actually works for you, and why our clients get natural, lasting results instead of one-size-fits-all treatments.</p>
    </section>

    <section>
      <h2>What we assess</h2>
      <ul class="benefit-list">
        <li>Hydration and skin barrier health</li>
        <li>Texture, pores and overall tone</li>
        <li>Pigmentation, redness and sun damage</li>
        <li>Fine lines, laxity and early signs of aging</li>
        <li>Acne, congestion and breakout patterns</li>
        <li>Your goals, lifestyle and current skincare routine</li>
      </ul>
    </section>

    <section>
      <h2>Your personalized plan</h2>
      <p>You'll leave with a prioritized roadmap — which treatments (for example, <a href="/services/morpheus8/">Morpheus8</a>, <a href="/services/microneedling/">microneedling</a>, <a href="/services/facials/">facials</a> or <a href="/services/biorepeel/">BioRePeel</a>), in what order, and a realistic sense of timeline and investment. No pressure, no obligation — just expert guidance.</p>
      <a class="cta" href="/contact/">Schedule your consultation</a>
    </section>

    <section>
      <h2>Serving Charlotte &amp; Lee County</h2>
      <p>House of Rose Aesthetics welcomes clients from <strong>Punta Gorda</strong>, <strong>Port Charlotte</strong>, <strong>Fort Myers</strong> and <strong>Cape Coral</strong>. Book your complimentary skin analysis and let's map your best skin.</p>
    </section>

    <section class="faq">
      <h2>Skin Analysis FAQs</h2>
      {faqItems.map((item) => (<details><summary>{item.q}</summary><p>{item.a}</p></details>))}
    </section>
  </article>
</Layout>

<style>
  .service-page { max-width: 760px; margin: 0 auto; padding: 2rem 1.25rem 4rem; line-height: 1.65; }
  .service-hero { margin-bottom: 2.5rem; }
  .eyebrow { text-transform: uppercase; letter-spacing: .16em; font-size: .78rem; font-weight: 600; opacity: .7; margin: 0 0 .5rem; }
  h1 { font-size: clamp(1.9rem, 5vw, 2.75rem); line-height: 1.1; margin: 0 0 .8rem; text-wrap: balance; }
  .subhead { font-size: 1.1rem; opacity: .85; margin: 0 0 1.5rem; }
  section { margin-bottom: 2.25rem; }
  h2 { font-size: 1.5rem; margin: 0 0 .6rem; }
  .benefit-list { padding-left: 1.2rem; } .benefit-list li { margin-bottom: .4rem; }
  .cta { display: inline-block; padding: .8rem 1.4rem; border-radius: 999px; background: #a23b57; color: #fff; text-decoration: none; font-weight: 600; }
  .cta:hover { background: #7d2b41; }
  a { color: #a23b57; }
  .faq details { border-bottom: 1px solid rgba(0,0,0,.1); padding: .9rem 0; }
  .faq summary { font-weight: 600; cursor: pointer; font-size: 1.02rem; }
  .faq details p { margin: .7rem 0 0; opacity: .85; }
</style>
