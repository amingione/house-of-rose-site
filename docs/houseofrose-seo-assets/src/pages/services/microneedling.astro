---
// src/pages/services/microneedling.astro — microneedling (national 223k/KD 61; win local "microneedling fort myers" KD 0)
// ⚕️ Medical director should review clinical claims. Replace illustrative pricing.
import Layout from "../../layouts/Layout.astro"; // TODO: your real layout
import SchemaService from "../../components/seo/SchemaService.astro";
import SchemaFAQ from "../../components/seo/SchemaFAQ.astro";
import SchemaBreadcrumb from "../../components/seo/SchemaBreadcrumb.astro";

const title = "Microneedling in Punta Gorda & Fort Myers, FL | House of Rose Aesthetics";
const description =
  "Microneedling at House of Rose Aesthetics — a collagen-induction treatment that smooths texture, softens scars and brightens tone. Serving Punta Gorda, Port Charlotte, Fort Myers & Cape Coral. Book a consultation.";

const faqItems = [
  { q: "How much does microneedling cost in Southwest Florida?", a: "A single microneedling session in the Punta Gorda and Fort Myers area typically ranges from about $250 to $450, and most people are advised to do a series of three to six sessions for the best results. Adding PRP (a 'vampire facial') costs more. We confirm your plan and pricing at a complimentary consultation." },
  { q: "What does microneedling do?", a: "Microneedling uses fine needles to create tiny, controlled micro-channels in the skin. Your body heals them by producing new collagen and elastin, which smooths texture, refines pores, softens scars and brightens overall tone for healthier, more radiant skin." },
  { q: "How many microneedling sessions will I need?", a: "Most clients see the best improvement from a series of three to six sessions spaced about four weeks apart, followed by occasional maintenance. The exact number depends on your skin and goals." },
  { q: "What is the downtime after microneedling?", a: "Expect redness similar to a mild sunburn for about 24 hours, and sometimes slight dryness or flaking as the skin renews. Most people return to normal activities the next day and can wear makeup after about 24 hours." },
  { q: "Does microneedling hurt?", a: "We apply a topical numbing cream first, so most clients feel only light pressure or a mild prickling sensation. The treatment is well tolerated and takes roughly 30 to 60 minutes." },
  { q: "Is microneedling or Morpheus8 right for me?", a: "Microneedling is ideal for surface texture, tone, pores and mild scarring. If your main concern is skin laxity or firming, Morpheus8 — which adds radiofrequency heat for deeper remodeling — may be the better fit. See our Morpheus8 vs microneedling guide, or ask us at your consultation." },
  { q: "Who is a good candidate for microneedling?", a: "It's safe for all skin tones and suits most adults wanting smoother, brighter, more even skin. It isn't recommended during pregnancy or with active acne breakouts, infections or certain skin conditions. A consultation and skin analysis confirm it's right for you." },
];
---
<Layout title={title} description={description}>
  <SchemaService name="Microneedling" description={description} url={Astro.url.href}
    procedureType="Microneedling collagen-induction therapy" bodyLocations={["Face", "Neck", "Décolletage"]} />
  <SchemaFAQ items={faqItems} />
  <SchemaBreadcrumb items={[{ name: "Services", url: "/services/" }, { name: "Microneedling", url: "/services/microneedling/" }]} />

  <article class="service-page">
    <header class="service-hero">
      <p class="eyebrow">Skin Rejuvenation</p>
      <h1>Microneedling in Punta Gorda &amp; Fort Myers, FL</h1>
      <p class="subhead">Smoother texture, softer scars and a brighter, more even glow — microneedling stimulates your skin's own collagen for natural, lasting renewal.</p>
      <a class="cta" href="/contact/">Book your complimentary consultation</a>
    </header>

    <section>
      <h2>What is microneedling?</h2>
      <p>Microneedling — also called collagen-induction therapy — uses a device with fine needles to create thousands of tiny, controlled micro-channels in the skin. Your body responds by producing fresh <strong>collagen and elastin</strong>, the proteins that keep skin firm and smooth. The result is refined texture, smaller-looking pores and a healthier, more radiant complexion. It can be enhanced with targeted serums or your own platelet-rich plasma (PRP).</p>
    </section>

    <section>
      <h2>What microneedling treats</h2>
      <ul class="benefit-list">
        <li>Uneven or rough texture</li>
        <li>Enlarged pores</li>
        <li>Acne scarring and other mild scars</li>
        <li>Fine lines and early signs of aging</li>
        <li>Dull, tired-looking skin</li>
        <li>Uneven tone and mild discoloration</li>
      </ul>
    </section>

    <section>
      <h2>What to expect at House of Rose</h2>
      <p>We begin with a skin analysis and apply a topical numbing cream for comfort. The treatment takes about 30 to 60 minutes. Afterward, expect redness like a mild sunburn for about a day. Results build gradually over a series of three to six sessions as new collagen forms.</p>
      <p style="opacity:.85;">Comparing options? Read our guide: <a href="/blog/morpheus8-vs-microneedling/">Morpheus8 vs Microneedling →</a></p>
    </section>

    <section>
      <h2>Microneedling for Charlotte &amp; Lee County</h2>
      <p>House of Rose Aesthetics offers microneedling throughout Southwest Florida — <strong>Punta Gorda</strong>, <strong>Port Charlotte</strong>, <strong>Fort Myers</strong> and <strong>Cape Coral</strong>. Book a consultation to build your personalized plan.</p>
      <a class="cta" href="/contact/">Schedule your consultation</a>
    </section>

    <section class="faq">
      <h2>Microneedling FAQs</h2>
      {faqItems.map((item) => (<details><summary>{item.q}</summary><p>{item.a}</p></details>))}
    </section>
  </article>
</Layout>

<style>
  .service-page { max-width: 760px; margin: 0 auto; padding: 2rem 1.25rem 4rem; line-height: 1.65; }
  .service-hero { margin-bottom: 2.5rem; }
  .eyebrow { text-transform: uppercase; letter-spacing: .16em; font-size: .78rem; font-weight: 600; opacity: .7; margin: 0 0 .5rem; }
  h1 { font-size: clamp(1.9rem, 5vw, 2.75rem); line-height: 1.1; margin: 0 0 .8rem; text-wrap: balance; }
  .subhead { font-size: 1.1rem; opacity: .85; margin: 0 0 1.5rem; }
  section { margin-bottom: 2.25rem; }
  h2 { font-size: 1.5rem; margin: 0 0 .6rem; }
  .benefit-list { padding-left: 1.2rem; } .benefit-list li { margin-bottom: .4rem; }
  .cta { display: inline-block; padding: .8rem 1.4rem; border-radius: 999px; background: #a23b57; color: #fff; text-decoration: none; font-weight: 600; }
  .cta:hover { background: #7d2b41; }
  a { color: #a23b57; }
  .faq details { border-bottom: 1px solid rgba(0,0,0,.1); padding: .9rem 0; }
  .faq summary { font-weight: 600; cursor: pointer; font-size: 1.02rem; }
  .faq details p { margin: .7rem 0 0; opacity: .85; }
</style>
