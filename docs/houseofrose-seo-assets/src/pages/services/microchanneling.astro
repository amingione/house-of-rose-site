---
// src/pages/services/microchanneling.astro — microchanneling (6,100/mo, KD 0)
// ⚕️ Medical director should review clinical claims. Replace illustrative pricing.
import Layout from "../../layouts/Layout.astro"; // TODO: your real layout
import SchemaService from "../../components/seo/SchemaService.astro";
import SchemaFAQ from "../../components/seo/SchemaFAQ.astro";
import SchemaBreadcrumb from "../../components/seo/SchemaBreadcrumb.astro";

const title = "Microchanneling in Punta Gorda & Fort Myers, FL | House of Rose Aesthetics";
const description =
  "Microchanneling at House of Rose Aesthetics — a precise collagen-induction treatment with targeted serums for smoother texture, even tone and a refreshed glow. Serving Punta Gorda, Port Charlotte, Fort Myers & Cape Coral.";

const faqItems = [
  { q: "How much does microchanneling cost?", a: "A single microchanneling session in our area typically ranges from about $250 to $450 depending on the serums used, and a series of three to six sessions is usually recommended for the best results. We confirm your plan and pricing at your consultation." },
  { q: "What is the difference between microchanneling and microneedling?", a: "Both create tiny micro-injuries that trigger collagen production. Microchanneling uses a precise stamping device with fine, evenly spaced needles and typically pairs each pass with targeted serums or growth factors delivered into the channels — which tends to mean a controlled treatment with minimal downtime. Traditional microneedling uses a rolling or gliding pen. Results are similar; microchanneling is often chosen for its precision and quick recovery." },
  { q: "How much downtime is there?", a: "Very little. Most people have mild redness — similar to a light sunburn — for a few hours up to a day. Many clients return to normal activities the same day and can wear makeup the next morning." },
  { q: "How many sessions will I need?", a: "Most clients see the best improvement from a series of three to six sessions spaced about four weeks apart, then occasional maintenance. Your plan depends on your skin and goals." },
  { q: "Does microchanneling hurt?", a: "We apply a topical numbing cream beforehand, so most people feel only light pressure or a mild prickling sensation. The treatment is well tolerated." },
  { q: "What does microchanneling treat, and am I a candidate?", a: "It improves fine lines, uneven texture, enlarged pores, dullness, tone and mild scarring, and it's safe for most skin tones. It isn't recommended during pregnancy or with active breakouts, infections or certain skin conditions. A consultation and skin analysis confirm it's right for you." },
];
---
<Layout title={title} description={description}>
  <SchemaService name="Microchanneling" description={description} url={Astro.url.href}
    procedureType="Microchanneling collagen-induction therapy" bodyLocations={["Face", "Neck", "Décolletage"]} />
  <SchemaFAQ items={faqItems} />
  <SchemaBreadcrumb items={[{ name: "Services", url: "/services/" }, { name: "Microchanneling", url: "/services/microchanneling/" }]} />

  <article class="service-page">
    <header class="service-hero">
      <p class="eyebrow">Skin Rejuvenation</p>
      <h1>Microchanneling in Punta Gorda &amp; Fort Myers, FL</h1>
      <p class="subhead">A precise collagen-induction treatment that refines texture, evens tone and delivers targeted serums for a smooth, refreshed glow — with minimal downtime.</p>
      <a class="cta" href="/contact/">Book your complimentary consultation</a>
    </header>

    <section>
      <h2>What is microchanneling?</h2>
      <p>Microchanneling is an advanced form of <strong>collagen-induction therapy</strong>. A precision device creates thousands of tiny, evenly spaced micro-channels in the skin that stimulate natural collagen and elastin, while allowing <strong>targeted serums and growth factors</strong> to absorb deeply. The result is smoother, healthier, more radiant skin — with less downtime than many resurfacing treatments.</p>
    </section>

    <section>
      <h2>What microchanneling treats</h2>
      <ul class="benefit-list">
        <li>Fine lines and early signs of aging</li>
        <li>Uneven or rough texture</li>
        <li>Enlarged pores</li>
        <li>Dull, tired-looking skin</li>
        <li>Uneven tone and mild discoloration</li>
        <li>Mild acne scarring</li>
      </ul>
    </section>

    <section>
      <h2>What to expect at House of Rose</h2>
      <p>We begin with a skin analysis to choose the right serums for your goals, apply a topical numbing cream, then perform the treatment in about 45 to 60 minutes. Afterward you may have mild redness for a few hours to a day. A series of three to six sessions delivers the fullest results.</p>
    </section>

    <section>
      <h2>Microchanneling for Charlotte &amp; Lee County</h2>
      <p>House of Rose Aesthetics offers microchanneling throughout Southwest Florida — <strong>Punta Gorda</strong>, <strong>Port Charlotte</strong>, <strong>Fort Myers</strong> and <strong>Cape Coral</strong>. Book a consultation to build your personalized plan.</p>
      <a class="cta" href="/contact/">Schedule your consultation</a>
    </section>

    <section class="faq">
      <h2>Microchanneling FAQs</h2>
      {faqItems.map((item) => (<details><summary>{item.q}</summary><p>{item.a}</p></details>))}
    </section>
  </article>
</Layout>

<style>
  .service-page { max-width: 760px; margin: 0 auto; padding: 2rem 1.25rem 4rem; line-height: 1.65; }
  .service-hero { margin-bottom: 2.5rem; }
  .eyebrow { text-transform: uppercase; letter-spacing: .16em; font-size: .78rem; font-weight: 600; opacity: .7; margin: 0 0 .5rem; }
  h1 { font-size: clamp(1.9rem, 5vw, 2.75rem); line-height: 1.1; margin: 0 0 .8rem; text-wrap: balance; }
  .subhead { font-size: 1.1rem; opacity: .85; margin: 0 0 1.5rem; }
  section { margin-bottom: 2.25rem; }
  h2 { font-size: 1.5rem; margin: 0 0 .6rem; }
  .benefit-list { padding-left: 1.2rem; } .benefit-list li { margin-bottom: .4rem; }
  .cta { display: inline-block; padding: .8rem 1.4rem; border-radius: 999px; background: #a23b57; color: #fff; text-decoration: none; font-weight: 600; }
  .cta:hover { background: #7d2b41; }
  .faq details { border-bottom: 1px solid rgba(0,0,0,.1); padding: .9rem 0; }
  .faq summary { font-weight: 600; cursor: pointer; font-size: 1.02rem; }
  .faq details p { margin: .7rem 0 0; opacity: .85; }
</style>
