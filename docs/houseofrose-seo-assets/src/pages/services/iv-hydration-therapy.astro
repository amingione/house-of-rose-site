---
// src/pages/services/iv-hydration-therapy.astro — IV hydration therapy ("iv therapy near me" 47,000/mo, KD 3)
// ⚕️ Medical director should review all wellness claims (avoid disease-treatment language). Replace pricing.
import Layout from "../../layouts/Layout.astro"; // TODO: your real layout
import SchemaService from "../../components/seo/SchemaService.astro";
import SchemaFAQ from "../../components/seo/SchemaFAQ.astro";
import SchemaBreadcrumb from "../../components/seo/SchemaBreadcrumb.astro";

const title = "IV Hydration Therapy in Punta Gorda & Fort Myers, FL | House of Rose Aesthetics";
const description =
  "IV hydration therapy at House of Rose Aesthetics — replenish fluids, vitamins and antioxidants for energy, recovery, immune support and a healthy glow. Serving Punta Gorda, Port Charlotte, Fort Myers & Cape Coral.";

const faqItems = [
  { q: "How much does IV hydration therapy cost?", a: "IV drips at House of Rose typically range from about $100 to $250 per session depending on the formula and any add-ons like extra vitamins or antioxidants. We'll walk you through the menu and pricing at your visit." },
  { q: "What are the benefits of IV therapy?", a: "By delivering fluids, vitamins, minerals and antioxidants directly into your bloodstream, IV therapy supports hydration, energy, immune wellness, athletic recovery and general well-being. Because it bypasses the digestive system, your body can use the nutrients right away. IV therapy is a wellness service and is not a treatment for any medical condition." },
  { q: "How long does an IV drip take?", a: "Most sessions take about 30 to 60 minutes. You'll relax in a comfortable chair while the drip runs — many clients read, scroll or simply unwind." },
  { q: "Does IV therapy hurt?", a: "You'll feel a quick pinch when the IV is placed, similar to a routine blood draw. After that, most people feel nothing but relaxed for the rest of the session." },
  { q: "How often should I get IV therapy?", a: "It depends on your goals. Some clients come for a one-time boost before travel or an event; others schedule regular sessions (for example, monthly) as part of their wellness routine. We'll suggest a cadence based on what you're looking for." },
  { q: "Is IV therapy safe, and who administers it?", a: "At House of Rose, IV therapy is administered by trained, licensed medical professionals after a health screening to make sure it's appropriate for you. IV therapy is generally well tolerated; we review your history and any medications first." },
  { q: "Who is a good candidate for IV hydration?", a: "Healthy adults looking for hydration, an energy or immune boost, recovery support or a wellness reset are typically good candidates. It may not be appropriate for people with certain heart, kidney or other medical conditions — which is why we screen beforehand." },
];
---
<Layout title={title} description={description}>
  <SchemaService name="IV Hydration Therapy" description={description} url={Astro.url.href}
    procedureType="Intravenous vitamin and hydration therapy" />
  <SchemaFAQ items={faqItems} />
  <SchemaBreadcrumb items={[{ name: "Services", url: "/services/" }, { name: "IV Hydration Therapy", url: "/services/iv-hydration-therapy/" }]} />

  <article class="service-page">
    <header class="service-hero">
      <p class="eyebrow">Wellness</p>
      <h1>IV Hydration Therapy in Punta Gorda &amp; Fort Myers, FL</h1>
      <p class="subhead">Rehydrate and recharge from the inside out. Custom IV drips deliver fluids, vitamins and antioxidants straight to your bloodstream for energy, recovery and a healthy glow.</p>
      <a class="cta" href="/contact/">Book your IV session</a>
    </header>

    <section>
      <h2>What is IV hydration therapy?</h2>
      <p>IV hydration therapy delivers a customized blend of <strong>fluids, electrolytes, vitamins, minerals and antioxidants</strong> directly into your bloodstream through an IV. Because it bypasses digestion, your body absorbs the nutrients immediately — a fast, efficient way to rehydrate and support how you feel.</p>
    </section>

    <section>
      <h2>Why clients choose IV therapy</h2>
      <ul class="benefit-list">
        <li>Rapid rehydration and replenished electrolytes</li>
        <li>An energy boost (B-complex, B12)</li>
        <li>Immune-wellness support (vitamin C, zinc)</li>
        <li>Athletic and post-workout recovery</li>
        <li>A "beauty" glow with antioxidants like glutathione</li>
        <li>A feel-better reset after travel or a big weekend</li>
      </ul>
      <p style="opacity:.75;font-size:.92rem;">IV therapy is a wellness service and is not intended to diagnose, treat or cure any medical condition.</p>
    </section>

    <section>
      <h2>What to expect at House of Rose</h2>
      <p>After a quick health screening, one of our licensed medical professionals places the IV and starts your chosen drip. You'll relax comfortably for about 30 to 60 minutes. Most clients feel refreshed right away and return to their day immediately.</p>
    </section>

    <section>
      <h2>IV therapy for Charlotte &amp; Lee County</h2>
      <p>House of Rose Aesthetics offers IV hydration therapy across Southwest Florida — <strong>Punta Gorda</strong>, <strong>Port Charlotte</strong>, <strong>Fort Myers</strong> and <strong>Cape Coral</strong>. Book your drip and pick the formula that fits your goals.</p>
      <a class="cta" href="/contact/">Schedule your session</a>
    </section>

    <section class="faq">
      <h2>IV Therapy FAQs</h2>
      {faqItems.map((item) => (<details><summary>{item.q}</summary><p>{item.a}</p></details>))}
    </section>
  </article>
</Layout>

<style>
  .service-page { max-width: 760px; margin: 0 auto; padding: 2rem 1.25rem 4rem; line-height: 1.65; }
  .service-hero { margin-bottom: 2.5rem; }
  .eyebrow { text-transform: uppercase; letter-spacing: .16em; font-size: .78rem; font-weight: 600; opacity: .7; margin: 0 0 .5rem; }
  h1 { font-size: clamp(1.9rem, 5vw, 2.75rem); line-height: 1.1; margin: 0 0 .8rem; text-wrap: balance; }
  .subhead { font-size: 1.1rem; opacity: .85; margin: 0 0 1.5rem; }
  section { margin-bottom: 2.25rem; }
  h2 { font-size: 1.5rem; margin: 0 0 .6rem; }
  .benefit-list { padding-left: 1.2rem; } .benefit-list li { margin-bottom: .4rem; }
  .cta { display: inline-block; padding: .8rem 1.4rem; border-radius: 999px; background: #a23b57; color: #fff; text-decoration: none; font-weight: 600; }
  .cta:hover { background: #7d2b41; }
  .faq details { border-bottom: 1px solid rgba(0,0,0,.1); padding: .9rem 0; }
  .faq summary { font-weight: 600; cursor: pointer; font-size: 1.02rem; }
  .faq details p { margin: .7rem 0 0; opacity: .85; }
</style>
