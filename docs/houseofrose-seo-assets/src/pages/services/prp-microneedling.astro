---
// src/pages/services/prp-microneedling.astro — PRP microneedling (4,000/mo, KD 4)
// ⚕️ Medical director should review clinical claims. Replace illustrative pricing.
import Layout from "../../layouts/Layout.astro"; // TODO: your real layout
import SchemaService from "../../components/seo/SchemaService.astro";
import SchemaFAQ from "../../components/seo/SchemaFAQ.astro";
import SchemaBreadcrumb from "../../components/seo/SchemaBreadcrumb.astro";

const title = "PRP Microneedling (Vampire Facial) in Punta Gorda & Fort Myers, FL | House of Rose Aesthetics";
const description =
  "PRP microneedling at House of Rose Aesthetics — combine collagen-inducing microneedling with your own platelet-rich plasma for smoother texture, softened scars and a natural glow. Serving Punta Gorda, Port Charlotte, Fort Myers & Cape Coral.";

const faqItems = [
  { q: "How much does PRP microneedling cost?", a: "PRP microneedling in our area typically ranges from about $400 to $700 per session because it includes a blood draw and processing of your platelet-rich plasma. A series of three sessions is commonly recommended. We confirm pricing at your consultation." },
  { q: "What is PRP microneedling, and is it the 'vampire facial'?", a: "Yes — it's often called a 'vampire facial.' We draw a small amount of your blood, spin it in a centrifuge to concentrate the platelet-rich plasma (PRP), then apply that PRP during microneedling. The micro-channels let your own growth factors absorb deeply to enhance collagen production, healing and glow." },
  { q: "What is the downtime?", a: "Expect redness and a feeling like a mild sunburn for one to two days, and possibly slight flaking as skin renews. Most people return to normal activities the next day and can wear makeup after about 24 hours." },
  { q: "How many sessions will I need?", a: "Most clients get the best results from a series of three sessions spaced about four weeks apart, with occasional maintenance. Your plan depends on your skin goals — texture, scarring or overall rejuvenation." },
  { q: "Does PRP microneedling hurt?", a: "We apply a topical numbing cream first, so most people feel only light pressure or mild prickling. There's a quick pinch for the blood draw, similar to routine bloodwork." },
  { q: "What is the difference between PRP and PRF?", a: "Both use your own blood. PRP (platelet-rich plasma) is spun faster and delivers a concentrated burst of growth factors. PRF (platelet-rich fibrin) is spun more gently with no additives, forming a fibrin scaffold that releases growth factors more slowly over time. We can help you choose — and we also offer PRF." },
  { q: "Who is a good candidate?", a: "Adults wanting to improve texture, acne scarring, tone or overall radiance are typically great candidates, and PRP is safe for all skin tones. It isn't recommended during pregnancy or with certain blood or skin conditions. A consultation confirms it's right for you." },
];
---
<Layout title={title} description={description}>
  <SchemaService name="PRP Microneedling" description={description} url={Astro.url.href}
    procedureType="Microneedling with platelet-rich plasma (PRP)" bodyLocations={["Face", "Neck", "Décolletage"]} />
  <SchemaFAQ items={faqItems} />
  <SchemaBreadcrumb items={[{ name: "Services", url: "/services/" }, { name: "PRP Microneedling", url: "/services/prp-microneedling/" }]} />

  <article class="service-page">
    <header class="service-hero">
      <p class="eyebrow">Regenerative Skin</p>
      <h1>PRP Microneedling in Punta Gorda &amp; Fort Myers, FL</h1>
      <p class="subhead">The "vampire facial" — collagen-inducing microneedling supercharged with your own platelet-rich plasma for smoother texture, softened scars and a natural, lit-from-within glow.</p>
      <a class="cta" href="/contact/">Book your complimentary consultation</a>
    </header>

    <section>
      <h2>What is PRP microneedling?</h2>
      <p>PRP microneedling pairs <strong>microneedling</strong> — which creates micro-channels to stimulate collagen — with <strong>platelet-rich plasma (PRP)</strong> drawn from your own blood. Your PRP is rich in growth factors; applied into those fresh channels, it amplifies healing, collagen production and skin renewal for results beyond microneedling alone. Because it uses your own biology, it's a natural approach to rejuvenation.</p>
    </section>

    <section>
      <h2>What PRP microneedling treats</h2>
      <ul class="benefit-list">
        <li>Uneven texture and rough skin</li>
        <li>Acne scarring and other mild scars</li>
        <li>Fine lines and early aging</li>
        <li>Enlarged pores</li>
        <li>Dull tone and lackluster skin</li>
        <li>Overall radiance and skin quality</li>
      </ul>
    </section>

    <section>
      <h2>What to expect at House of Rose</h2>
      <p>We start with a quick blood draw, then process your PRP while your skin is numbed. During treatment we microneedle and apply your PRP. Expect redness for one to two days as your skin renews. A series of three sessions gives the fullest improvement.</p>
    </section>

    <section>
      <h2>PRP microneedling for Charlotte &amp; Lee County</h2>
      <p>House of Rose Aesthetics offers PRP microneedling throughout Southwest Florida — <strong>Punta Gorda</strong>, <strong>Port Charlotte</strong>, <strong>Fort Myers</strong> and <strong>Cape Coral</strong>. Book a consultation to build your plan.</p>
      <a class="cta" href="/contact/">Schedule your consultation</a>
    </section>

    <section class="faq">
      <h2>PRP Microneedling FAQs</h2>
      {faqItems.map((item) => (<details><summary>{item.q}</summary><p>{item.a}</p></details>))}
    </section>
  </article>
</Layout>

<style>
  .service-page { max-width: 760px; margin: 0 auto; padding: 2rem 1.25rem 4rem; line-height: 1.65; }
  .service-hero { margin-bottom: 2.5rem; }
  .eyebrow { text-transform: uppercase; letter-spacing: .16em; font-size: .78rem; font-weight: 600; opacity: .7; margin: 0 0 .5rem; }
  h1 { font-size: clamp(1.9rem, 5vw, 2.75rem); line-height: 1.1; margin: 0 0 .8rem; text-wrap: balance; }
  .subhead { font-size: 1.1rem; opacity: .85; margin: 0 0 1.5rem; }
  section { margin-bottom: 2.25rem; }
  h2 { font-size: 1.5rem; margin: 0 0 .6rem; }
  .benefit-list { padding-left: 1.2rem; } .benefit-list li { margin-bottom: .4rem; }
  .cta { display: inline-block; padding: .8rem 1.4rem; border-radius: 999px; background: #a23b57; color: #fff; text-decoration: none; font-weight: 600; }
  .cta:hover { background: #7d2b41; }
  .faq details { border-bottom: 1px solid rgba(0,0,0,.1); padding: .9rem 0; }
  .faq summary { font-weight: 600; cursor: pointer; font-size: 1.02rem; }
  .faq details p { margin: .7rem 0 0; opacity: .85; }
</style>
