---
// src/pages/services/lip-fillers.astro — lip fillers (27,000/mo, KD 0)
// ⚕️ Medical director should review all clinical claims. Replace illustrative pricing.
import Layout from "../../layouts/Layout.astro"; // TODO: your real layout
import SchemaService from "../../components/seo/SchemaService.astro";
import SchemaFAQ from "../../components/seo/SchemaFAQ.astro";
import SchemaBreadcrumb from "../../components/seo/SchemaBreadcrumb.astro";

const title = "Lip Fillers in Punta Gorda & Fort Myers, FL | House of Rose Aesthetics";
const description =
  "Natural-looking lip fillers at House of Rose Aesthetics — add volume, shape and definition with hyaluronic-acid dermal fillers. Serving Punta Gorda, Port Charlotte, Fort Myers & Cape Coral. Book a consultation.";

const faqItems = [
  { q: "How much do lip fillers cost in Southwest Florida?", a: "Lip filler in the Punta Gorda and Fort Myers area typically runs about $550 to $900 per syringe of hyaluronic-acid filler, and most people start with one syringe. Your exact price depends on the product and how much volume you want, which we confirm at your complimentary consultation." },
  { q: "Do lip fillers hurt?", a: "Most patients find it very tolerable. We apply a topical numbing cream first, and the fillers we use contain lidocaine to keep you comfortable during the treatment. You may feel small pinches and pressure, but the whole appointment takes only about 30 to 45 minutes." },
  { q: "How long do lip fillers last?", a: "Hyaluronic-acid lip fillers generally last about 6 to 12 months. Results vary with your metabolism and the product used. Many clients schedule a touch-up once or twice a year to maintain their look." },
  { q: "What is the downtime and swelling like?", a: "Expect some swelling, tenderness and occasional bruising for one to three days — this is normal. Lips can look fuller than the final result at first; they settle into their true shape over one to two weeks. Most people return to normal activities right away." },
  { q: "Can lip fillers look natural?", a: "Yes. Our approach is to enhance your natural lip shape and balance, not overfill. We tailor the amount and technique to your anatomy and goals, so results look like a better version of your own lips." },
  { q: "Can lip filler be dissolved if I don't like it?", a: "Yes. Hyaluronic-acid fillers can be dissolved with an enzyme called hyaluronidase if you're unhappy or in the rare case of a complication — one of the safety advantages of HA fillers." },
  { q: "Am I a good candidate for lip fillers?", a: "Healthy adults 18 and older who want more volume, definition or symmetry are typically good candidates. Lip fillers aren't recommended during pregnancy or breastfeeding, or with active cold sores or certain conditions. A consultation confirms it's right for you." },
];
---
<Layout title={title} description={description}>
  <SchemaService name="Lip Fillers (Dermal Filler)" description={description} url={Astro.url.href}
    procedureType="Lip augmentation with hyaluronic-acid dermal filler" bodyLocations={["Lips"]} />
  <SchemaFAQ items={faqItems} />
  <SchemaBreadcrumb items={[{ name: "Services", url: "/services/" }, { name: "Lip Fillers", url: "/services/lip-fillers/" }]} />

  <article class="service-page">
    <header class="service-hero">
      <p class="eyebrow">Injectables</p>
      <h1>Lip Fillers in Punta Gorda &amp; Fort Myers, FL</h1>
      <p class="subhead">Soft, natural volume and beautiful definition with hyaluronic-acid dermal fillers — customized to your lips, never overdone.</p>
      <a class="cta" href="/contact/">Book your complimentary consultation</a>
    </header>

    <section>
      <h2>What are lip fillers?</h2>
      <p>Lip fillers are gel-like <strong>hyaluronic-acid (HA) dermal fillers</strong> — the same hydrating molecule your body makes naturally — injected to add volume, shape and definition to the lips. Because they're HA-based, results look and feel natural, and they can be adjusted or even dissolved if needed.</p>
    </section>

    <section>
      <h2>What lip fillers can do</h2>
      <ul class="benefit-list">
        <li>Add fullness to naturally thin lips</li>
        <li>Define the lip border and Cupid's bow</li>
        <li>Balance asymmetry between the upper and lower lip</li>
        <li>Soften fine "lipstick lines" around the mouth</li>
        <li>Restore volume lost with age</li>
        <li>Hydrate and refresh the overall look of the lips</li>
      </ul>
    </section>

    <section>
      <h2>What to expect at House of Rose</h2>
      <p>Your appointment starts with a consultation to understand your goals and map your ideal shape. We apply a topical numbing cream, then place the filler precisely — the treatment itself takes about 30 to 45 minutes. You'll see added volume immediately. Expect mild swelling, tenderness and possible bruising for one to three days; your lips settle into their final shape over one to two weeks.</p>
    </section>

    <section>
      <h2>Lip fillers for Charlotte &amp; Lee County</h2>
      <p>House of Rose Aesthetics offers lip fillers to clients throughout Southwest Florida — <strong>Punta Gorda</strong>, <strong>Port Charlotte</strong>, <strong>Fort Myers</strong> and <strong>Cape Coral</strong>. Book a consultation and we'll design a natural, balanced look just for you.</p>
      <a class="cta" href="/contact/">Schedule your consultation</a>
    </section>

    <section class="faq">
      <h2>Lip Filler FAQs</h2>
      {faqItems.map((item) => (<details><summary>{item.q}</summary><p>{item.a}</p></details>))}
    </section>
  </article>
</Layout>

<style>
  .service-page { max-width: 760px; margin: 0 auto; padding: 2rem 1.25rem 4rem; line-height: 1.65; }
  .service-hero { margin-bottom: 2.5rem; }
  .eyebrow { text-transform: uppercase; letter-spacing: .16em; font-size: .78rem; font-weight: 600; opacity: .7; margin: 0 0 .5rem; }
  h1 { font-size: clamp(1.9rem, 5vw, 2.75rem); line-height: 1.1; margin: 0 0 .8rem; text-wrap: balance; }
  .subhead { font-size: 1.1rem; opacity: .85; margin: 0 0 1.5rem; }
  section { margin-bottom: 2.25rem; }
  h2 { font-size: 1.5rem; margin: 0 0 .6rem; }
  .benefit-list { padding-left: 1.2rem; } .benefit-list li { margin-bottom: .4rem; }
  .cta { display: inline-block; padding: .8rem 1.4rem; border-radius: 999px; background: #a23b57; color: #fff; text-decoration: none; font-weight: 600; }
  .cta:hover { background: #7d2b41; }
  .faq details { border-bottom: 1px solid rgba(0,0,0,.1); padding: .9rem 0; }
  .faq summary { font-weight: 600; cursor: pointer; font-size: 1.02rem; }
  .faq details p { margin: .7rem 0 0; opacity: .85; }
</style>
