---
// src/components/seo/SchemaFAQ.astro
// FAQPage JSON-LD — the single highest-ROI move for AI Overviews & People-Also-Ask.
// Pass the SAME questions you render visibly on the page (Google requires visible parity).
//
// <SchemaFAQ items={[{ q: "How much does Morpheus8 cost?", a: "..." }, ...]} />
interface FaqItem { q: string; a: string; }
interface Props { items: FaqItem[]; }
const { items } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((it) => ({
    "@type": "Question",
    name: it.q,
    acceptedAnswer: { "@type": "Answer", text: it.a },
  })),
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
